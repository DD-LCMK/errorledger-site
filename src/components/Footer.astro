---
const currentYear = new Date().getFullYear();
---

<footer class="arcade-footer">
  <div class="footer-inner">
    <div class="footer-brand-col">
      <div class="footer-logo">
        <span class="brand-icon">🕹️</span>
        <span class="brand-text-main">Aether</span><span class="brand-text-accent">Arcade</span>
      </div>
      <p class="footer-desc">
        AetherArcade is an independent, 100% client-side web gaming platform. Play tactical card battlers, tile puzzles, word hunts, and physics drop games instantly with zero downloads.
      </p>
      <div class="footer-badge">
        <span>⚡ 100% Client-Side • $0 Paywalls • Zero Installs</span>
      </div>
    </div>

    <div class="footer-links-col">
      <h4>Popular Games</h4>
      <ul>
        <li><a href="/games/god-duel">⚔️ God Duel (Card Battle)</a></li>
        <li><a href="/games/gem-2048">💎 GemMerge 2048</a></li>
        <li><a href="/games/word-sprint">🔤 Word Sprint</a></li>
        <li><a href="/games/cosmic-drop">🪐 Cosmic Drop</a></li>
      </ul>
    </div>

    <div class="footer-links-col">
      <h4>Legal & Policies</h4>
      <ul>
        <li><a href="/privacy">Privacy Policy</a></li>
        <li><a href="/terms">Terms of Service</a></li>
        <li><a href="/about">About Us</a></li>
        <li><a href="/contact">Contact Support</a></li>
      </ul>
    </div>
  </div>

  <div class="footer-bottom">
    <p>&copy; {currentYear} AetherArcade. All rights reserved. Free browser games for desktop and mobile.</p>
  </div>
</footer>

<style>
  .arcade-footer {
    background: #090d16;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
    color: #94a3b8;
    padding: 3rem 1.5rem 1.5rem;
    margin-top: auto;
  }

  .footer-inner {
    max-width: 1200px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 2fr 1fr 1fr;
    gap: 3rem;
  }

  .footer-logo {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 1.3rem;
    font-weight: 800;
    margin-bottom: 0.75rem;
  }

  .brand-icon {
    font-size: 1.3rem;
  }

  .brand-text-main {
    color: #f8fafc;
  }

  .brand-text-accent {
    background: linear-gradient(135deg, #a855f7 0%, #38bdf8 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .footer-desc {
    font-size: 0.88rem;
    line-height: 1.6;
    color: #64748b;
    margin-bottom: 1rem;
    max-width: 440px;
  }

  .footer-badge span {
    display: inline-block;
    font-size: 0.75rem;
    color: #38bdf8;
    background: rgba(56, 189, 248, 0.1);
    border: 1px solid rgba(56, 189, 248, 0.2);
    padding: 0.25rem 0.6rem;
    border-radius: 999px;
    font-weight: 600;
  }

  .footer-links-col h4 {
    color: #f1f5f9;
    font-size: 0.95rem;
    font-weight: 700;
    margin: 0 0 1rem;
    letter-spacing: 0.02em;
  }

  .footer-links-col ul {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .footer-links-col li {
    margin-bottom: 0.6rem;
  }

  .footer-links-col a {
    color: #94a3b8;
    text-decoration: none;
    font-size: 0.88rem;
    transition: color 0.15s ease;
  }

  .footer-links-col a:hover {
    color: #38bdf8;
  }

  .footer-bottom {
    max-width: 1200px;
    margin: 2.5rem auto 0;
    padding-top: 1.5rem;
    border-top: 1px solid rgba(255, 255, 255, 0.05);
    text-align: center;
    font-size: 0.8rem;
    color: #475569;
  }

  @media (max-width: 768px) {
    .footer-inner {
      grid-template-columns: 1fr;
      gap: 2rem;
    }
  }
</style>