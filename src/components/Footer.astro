---
import { getLang, t } from '../i18n';

const lang = getLang(Astro.url);
const isEn = lang === 'en';
const prefix = isEn ? '/en' : '';
const currentYear = new Date().getFullYear();
---

<footer class="arcade-footer">
  <div class="footer-inner">
    <div class="footer-brand-col">
      <div class="footer-logo">
        <span class="brand-icon">🔴</span>
        {isEn ? (
          <span class="brand-text-main">Stream</span><span class="brand-text-accent">Arcade</span>
        ) : (
          <span class="brand-text-main">스트림</span><span class="brand-text-accent">아케이드</span>
        )}
      </div>
      <p class="footer-desc">
        {t(lang, 'footer.desc')}
      </p>
      <div class="footer-badge">
        <span>{t(lang, 'footer.badge')}</span>
      </div>
      {/* Donation link reserved for user's PayPal: e.g. <a href="https://paypal.me/..." class="footer-support-link">☕ {isEn ? 'Support StreamArcade' : '후원하기'}</a> */}
    </div>

    <div class="footer-links-col">
      <h4>{t(lang, 'footer.tools.title')}</h4>
      <ul>
        <li><a href={`${prefix}/schedule`}>{t(lang, 'footer.tools.schedule')}</a></li>
        <li><a href={`${prefix}/games/drinking-marble`}>{t(lang, 'footer.tools.drinking_marble')}</a></li>
        <li><a href={`${prefix}/games/roulette`}>{t(lang, 'footer.tools.roulette')}</a></li>
        <li><a href={`${prefix}/games/marble-roulette`}>{t(lang, 'footer.tools.marble')}</a></li>
        <li><a href={`${prefix}/games/ladder`}>{t(lang, 'footer.tools.ladder')}</a></li>
        <li><a href={`${prefix}/fortune`}>{t(lang, 'footer.tools.fortune')}</a></li>
        <li><a href={`${prefix}/mbti`}>{t(lang, 'footer.tools.mbti')}</a></li>
        <li><a href={`${prefix}/bzzk`}>{t(lang, 'footer.tools.bzzk')}</a></li>
      </ul>
    </div>

    <div class="footer-links-col">
      <h4>{t(lang, 'footer.support.title')}</h4>
      <ul>
        <li><a href={`${prefix}/privacy`}>{t(lang, 'footer.support.privacy')}</a></li>
        <li><a href={`${prefix}/terms`}>{t(lang, 'footer.support.terms')}</a></li>
        <li><a href={`${prefix}/about`}>{t(lang, 'footer.support.about')}</a></li>
        <li><a href={`${prefix}/contact`}>{t(lang, 'footer.support.contact')}</a></li>
      </ul>
    </div>
  </div>

  <div class="footer-bottom">
    <p>&copy; {currentYear} {t(lang, 'footer.copyright')}</p>
  </div>
</footer>

<style>
  .arcade-footer {
    background: #090d16;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
    color: #94a3b8;
    padding: 3rem 1.5rem 1.5rem;
    margin-top: auto;
  }

  .footer-inner {
    max-width: 1200px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 2fr 1fr 1fr;
    gap: 3rem;
  }

  .footer-logo {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 1.3rem;
    font-weight: 800;
    margin-bottom: 0.75rem;
  }

  .brand-icon {
    font-size: 1.3rem;
  }

  .brand-text-main {
    color: #f8fafc;
  }

  .brand-text-accent {
    background: linear-gradient(135deg, #a855f7 0%, #38bdf8 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .footer-desc {
    font-size: 0.88rem;
    line-height: 1.6;
    color: #64748b;
    margin-bottom: 1rem;
    max-width: 440px;
  }

  .footer-badge span {
    display: inline-block;
    font-size: 0.75rem;
    color: #38bdf8;
    background: rgba(56, 189, 248, 0.1);
    border: 1px solid rgba(56, 189, 248, 0.2);
    padding: 0.25rem 0.6rem;
    border-radius: 999px;
    font-weight: 600;
  }

  .footer-support-link {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    margin-top: 0.85rem;
    font-size: 0.78rem;
    font-weight: 700;
    color: #f59e0b;
    background: rgba(245, 158, 11, 0.08);
    border: 1px solid rgba(245, 158, 11, 0.2);
    padding: 0.3rem 0.7rem;
    border-radius: 999px;
    text-decoration: none;
    transition: all 0.15s ease;
    width: fit-content;
  }

  .footer-support-link:hover {
    background: rgba(245, 158, 11, 0.16);
    border-color: rgba(245, 158, 11, 0.4);
    color: #fbbf24;
  }

  .footer-links-col h4 {
    color: #f1f5f9;
    font-size: 0.95rem;
    font-weight: 700;
    margin: 0 0 1rem;
    letter-spacing: 0.02em;
  }

  .footer-links-col ul {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .footer-links-col li {
    margin-bottom: 0.6rem;
  }

  .footer-links-col a {
    color: #94a3b8;
    text-decoration: none;
    font-size: 0.88rem;
    transition: color 0.15s ease;
  }

  .footer-links-col a:hover {
    color: #38bdf8;
  }

  .footer-bottom {
    max-width: 1200px;
    margin: 2.5rem auto 0;
    padding-top: 1.5rem;
    border-top: 1px solid rgba(255, 255, 255, 0.05);
    text-align: center;
    font-size: 0.8rem;
    color: #475569;
  }

  @media (max-width: 768px) {
    .footer-inner {
      grid-template-columns: 1fr;
      gap: 2rem;
    }
  }
</style>