---
import { getLang, t } from '../i18n';

const lang = getLang(Astro.url);
const isEn = lang === 'en';
const prefix = isEn ? '/en' : '';
const currentYear = new Date().getFullYear();
---

<footer class="arcade-footer">
  <div class="footer-inner">
    <div class="footer-brand-col">
      <div class="footer-logo">
        <span class="brand-icon">🔴</span>
        {isEn ? (
          <span class="brand-text-main">Error</span><span class="brand-text-accent">Ledger</span>
        ) : (
          <span class="brand-text-main">에러</span><span class="brand-text-accent">레저</span>
        )}
      </div>
      <p class="footer-desc">
        {t(lang, 'footer.desc')}
      </p>
      <div class="footer-badge">
        <span>{t(lang, 'footer.badge')}</span>
      </div>
      {/* Donation link reserved for user's PayPal: e.g. <a href="https://paypal.me/..." class="footer-support-link">☕ {isEn ? 'Support ErrorLedger' : '후원하기'}</a> */}
    </div>

    <!-- 1. Games -->
    <div class="footer-links-col">
      <h4>🎮 {t(lang, 'footer.category.games')}</h4>
      <ul>
        <li><a href={`${prefix}/games/marble-roulette`}>{t(lang, 'footer.tools.marble')}</a></li>
        <li><a href={`${prefix}/games/roulette`}>{t(lang, 'footer.tools.roulette')}</a></li>
        <li><a href={`${prefix}/games/ladder`}>{t(lang, 'footer.tools.ladder')}</a></li>
        <li><a href={`${prefix}/games/drinking-marble`}>{t(lang, 'footer.tools.drinking_marble')}</a></li>
        <li><a href={`${prefix}/games/stream-doodle`}>{t(lang, 'footer.tools.stream_doodle')}</a></li>
        <li><a href={`${prefix}/games/stream-emoji`}>{t(lang, 'footer.tools.stream_emoji')}</a></li>
        <li><a href={`${prefix}/games/ai-music-quiz`}>{t(lang, 'footer.tools.ai_music_quiz')}</a></li>
      </ul>
    </div>

    <!-- 2. Tests & Fortune -->
    <div class="footer-links-col">
      <h4>🧪 {t(lang, 'footer.category.tests')}</h4>
      <ul>
        <li><a href={`${prefix}/mbti`}>{t(lang, 'footer.tools.mbti')}</a></li>
        <li><a href={`${prefix}/fortune`}>{t(lang, 'footer.tools.fortune')}</a></li>
      </ul>
    </div>

    <!-- 3. Stream Utilities -->
    <div class="footer-links-col">
      <h4>🛠️ {t(lang, 'footer.category.tools')}</h4>
      <ul>
        <li><a href={`${prefix}/schedule`}>{t(lang, 'footer.tools.schedule')}</a></li>
        <li><a href={`${prefix}/bzzk`}>{t(lang, 'footer.tools.bzzk')}</a></li>
      </ul>
    </div>

    <!-- 4. Support & Info -->
    <div class="footer-links-col">
      <h4>ℹ️ {t(lang, 'footer.category.support')}</h4>
      <ul>
        <li><a href={`${prefix}/about`}>{t(lang, 'footer.support.about')}</a></li>
        <li><a href={`${prefix}/contact`}>{t(lang, 'footer.support.contact')}</a></li>
        <li><a href={`${prefix}/privacy`}>{t(lang, 'footer.support.privacy')}</a></li>
        <li><a href={`${prefix}/terms`}>{t(lang, 'footer.support.terms')}</a></li>
      </ul>
    </div>
  </div>

  <div class="footer-bottom">
    <p>&copy; {currentYear} {t(lang, 'footer.copyright')}</p>
  </div>
</footer>

<style>
  .arcade-footer {
    background: #090d16;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
    color: #94a3b8;
    padding: 2.25rem 1.5rem 1.5rem;
    margin-top: auto;
  }

  .footer-inner {
    max-width: 1280px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1.5fr 1fr 1fr 1fr 1fr;
    gap: 1.5rem;
  }

  .footer-logo {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    font-size: 1.2rem;
    font-weight: 800;
    margin-bottom: 0.6rem;
  }

  .brand-icon {
    font-size: 1.2rem;
  }

  .brand-text-main {
    color: #f8fafc;
  }

  .brand-text-accent {
    background: linear-gradient(135deg, #a855f7 0%, #38bdf8 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .footer-desc {
    font-size: 0.8rem;
    line-height: 1.55;
    color: #64748b;
    margin-bottom: 0.85rem;
    max-width: 380px;
  }

  .footer-badge span {
    display: inline-block;
    font-size: 0.725rem;
    color: #38bdf8;
    background: rgba(56, 189, 248, 0.1);
    border: 1px solid rgba(56, 189, 248, 0.2);
    padding: 0.2rem 0.55rem;
    border-radius: 999px;
    font-weight: 600;
  }

  .footer-links-col h4 {
    color: #f1f5f9;
    font-size: 0.825rem;
    font-weight: 700;
    margin: 0 0 0.75rem;
    letter-spacing: 0.03em;
  }

  .footer-links-col ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
  }

  .footer-links-col a {
    color: #94a3b8;
    text-decoration: none;
    font-size: 0.8rem;
    transition: color 0.15s ease;
    white-space: nowrap;
  }

  .footer-links-col a:hover {
    color: #38bdf8;
  }

  .footer-bottom {
    max-width: 1280px;
    margin: 1.75rem auto 0;
    padding-top: 1.25rem;
    border-top: 1px solid rgba(255, 255, 255, 0.05);
    text-align: center;
    font-size: 0.75rem;
    color: #475569;
  }

  @media (max-width: 1120px) {
    .footer-inner {
      grid-template-columns: repeat(2, 1fr);
      gap: 2rem;
    }
    .footer-brand-col {
      grid-column: 1 / -1;
    }
  }

  @media (max-width: 580px) {
    .footer-inner {
      grid-template-columns: 1fr;
      gap: 1.5rem;
    }
  }
</style>