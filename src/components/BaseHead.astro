---
import '../styles/global.css';
import type { ImageMetadata } from 'astro';
import FallbackImage from '../assets/blog-placeholder-1.jpg';
import { SITE_TITLE, SITE_TAGLINE, SITE_DESCRIPTION, SITE_KEYWORDS, SITE_AUTHOR, SITE_EMAIL } from '../consts';
import { Font } from 'astro:assets';
import { getKoUrl, getEnUrl } from '../i18n';

interface Props {
	title: string;
	description: string;
	// ALLOWS BOTH: Astro image objects (for static pages) OR raw string paths (from blog frontmatter)
	image?: string | ImageMetadata;
	// ADDS DYNAMIC TYPE: Enables us to switch between "website" and "article"
	type?: string;
	// DYNAMIC BREADCRUMB: Array of {name, url} items. Last item is current page (no url needed).
	breadcrumb?: { name: string; url?: string }[];
	lang?: string;
	keywords?: string;
	// hreflang: if omitted, auto-derived from current URL
	hreflangKo?: string;
	hreflangEn?: string;
}

// Strip `.html` and trailing slashes so canonical URLs are always clean
const rawPath = Astro.url.pathname.replace(/\.html$/, '').replace(/\/$/, '');
const siteBase = Astro.site || 'https://errorledger.com';

const {
	title,
	description,
	image = FallbackImage,
	type = 'website',
	breadcrumb,
	lang = 'ko',
	keywords = SITE_KEYWORDS,
	hreflangKo,
	hreflangEn,
} = Astro.props;

const canonicalURL = new URL(rawPath || '/', siteBase);

// Auto-derive hreflang URLs if not passed explicitly
const koUrl = hreflangKo ?? getKoUrl(siteBase.toString(), rawPath || '/');
const enUrl = hreflangEn ?? getEnUrl(siteBase.toString(), rawPath || '/');

const ogLocale = lang === 'en' ? 'en_US' : 'ko_KR';
const ogLocaleAlternate = lang === 'en' ? 'ko_KR' : 'en_US';

// Truncate title to 70 characters for SEO (Google supports up to ~70 before truncating)
const truncatedTitle = title && title.length > 70 ? title.substring(0, 67) + '...' : title;

// Truncate description to 160 characters for SEO snippets
const truncatedDescription = description && description.length > 160 ? description.substring(0, 157) + '...' : description;

// RESOLVES P1 ISSUE: Safely process both string paths (from our pipeline) and Astro ImageMetadata fallbacks
const ogImage = typeof image === 'string'
	? new URL(image, siteBase).href
	: (image.src.includes('blog-placeholder-1') 
		? 'https://images.unsplash.com/photo-1618401471353-b98afee0b2eb?w=1200&h=630&fit=crop&q=80' 
		: new URL(image.src, siteBase).href);

// Builds a dynamic BreadcrumbList for rich results.
const breadcrumbItems = breadcrumb && breadcrumb.length > 0
	? breadcrumb
	: (rawPath === '' || rawPath === '/'
		? [{ name: '홈 (Home)', url: siteBase.toString() }]
		: [
			{ name: '홈 (Home)', url: siteBase.toString() },
			{ name: title.replace(` - ${SITE_TITLE}`, '').replace(` | ${SITE_TITLE}`, ''), url: canonicalURL.href }
		  ]);

const breadcrumbSchema = JSON.stringify({
	"@context": "https://schema.org",
	"@type": "BreadcrumbList",
	"itemListElement": breadcrumbItems.map((item, index) => ({
		"@type": "ListItem",
		"position": index + 1,
		"name": item.name,
		"item": item.url ? (item.url.startsWith('http') ? item.url : new URL(item.url, siteBase).href) : canonicalURL.href
	}))
});

// Rich WebSite Schema for Search Engines (Google, Naver Yeti, Bing)
const websiteSchema = JSON.stringify({
	"@context": "https://schema.org",
	"@type": "WebSite",
	"name": "스트림아케이드",
	"alternateName": ["StreamArcade", "Stream Arcade", "스트림 아케이드"],
	"url": siteBase.toString(),
	"description": SITE_DESCRIPTION,
	"inLanguage": ["ko-KR", "en-US"],
	"publisher": {
		"@type": "Organization",
		"name": SITE_AUTHOR,
		"url": siteBase.toString(),
		"logo": {
			"@type": "ImageObject",
			"url": new URL('/favicon.svg', siteBase).href
		}
	},
	"potentialAction": {
		"@type": "SearchAction",
		"target": {
			"@type": "EntryPoint",
			"urlTemplate": `${new URL('/search', siteBase).href}?q={search_term_string}`
		},
		"query-input": "required name=search_term_string"
	}
});

// Organization Schema
const organizationSchema = JSON.stringify({
	"@context": "https://schema.org",
	"@type": "Organization",
	"name": "스트림아케이드 (StreamArcade)",
	"alternateName": "StreamArcade",
	"url": siteBase.toString(),
	"logo": new URL('/favicon.svg', siteBase).href,
	"description": "치지직, 유튜브, SOOP 생방송을 위한 무료 인터랙티브 웹게임 및 추첨 도구 플랫폼",
	"email": SITE_EMAIL
});
---

<!-- Global Metadata -->
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="sitemap" href="/sitemap-index.xml" />
<link
	rel="alternate"
	type="application/rss+xml"
	title={SITE_TITLE}
	href={new URL('rss.xml', Astro.site)}
/>
<meta name="generator" content={Astro.generator} />

<!-- Preconnect for performance -->
<link rel="preconnect" href="https://fonts.googleapis.com" crossorigin />

<Font cssVariable="--font-atkinson" preload />

<!-- Canonical URL -->
<link rel="canonical" href={canonicalURL.href} />

<!-- hreflang — bilingual alternate links -->
<link rel="alternate" hreflang="ko" href={koUrl} />
<link rel="alternate" hreflang="en" href={enUrl} />
<link rel="alternate" hreflang="x-default" href={koUrl} />

<!-- Primary Meta Tags -->
<title>{truncatedTitle}</title>
<meta name="description" content={truncatedDescription} />
<meta name="keywords" content={keywords} />
<meta name="author" content={SITE_AUTHOR} />
<meta name="application-name" content="스트림아케이드 (StreamArcade)" />
<meta name="theme-color" content="#0f172a" />
<meta name="robots" content="index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1" />

<!-- Structured Data Schemas (JSON-LD) -->
<script type="application/ld+json" set:html={breadcrumbSchema}></script>
<script type="application/ld+json" set:html={websiteSchema}></script>
<script type="application/ld+json" set:html={organizationSchema}></script>

<!-- Open Graph / Facebook -->
<meta property="og:type" content={type} />
<meta property="og:url" content={canonicalURL.href} />
<meta property="og:title" content={truncatedTitle} />
<meta property="og:description" content={truncatedDescription} />
<meta property="og:image" content={ogImage} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={truncatedTitle} />
<meta property="og:site_name" content={SITE_TITLE} />
<meta property="og:locale" content={ogLocale} />
<meta property="og:locale:alternate" content={ogLocaleAlternate} />

<!-- Twitter -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:url" content={canonicalURL.href} />
<meta name="twitter:title" content={truncatedTitle} />
<meta name="twitter:description" content={truncatedDescription} />
<meta name="twitter:image" content={ogImage} />
<meta name="twitter:image:alt" content={truncatedTitle} />

<!-- Google AdSense (active when account is approved) -->
<link rel="preconnect" href="https://pagead2.googlesyndication.com" />
<script async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-9920262252083841"
     crossorigin="anonymous"></script>

<!-- Enforce Dark Mode (Site is Dark Mode Only) -->
<script is:inline>
  document.documentElement.classList.add('dark');
  if (typeof localStorage !== 'undefined') {
    localStorage.setItem('theme', 'dark');
  }
</script>

<!-- Comprehensive Dark Mode Global Overrides -->
<style is:global>
  html.dark {
    background: #0f172a !important;
    background-image: none !important;
    color: #e2e8f0 !important;
  }
  html.dark body, 
  html.dark main, 
  html.dark article, 
  html.dark .prose {
    background: #0f172a !important;
    background-image: none !important;
    color: #e2e8f0 !important;
  }
  html.dark header {
    background-color: #1e293b !important;
    background-image: none !important;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.4) !important;
  }
  
  /* Formats headers, labels, and grid headings to high contrast white */
  html.dark h1, html.dark h2, html.dark h3, html.dark h4, html.dark h5, html.dark h6,
  html.dark th, html.dark dt, html.dark strong {
    color: #f8fafc !important;
  }
  
  /* Sets body text, code explanations, and grid text fields to light grey */
  html.dark p, html.dark li, html.dark time, html.dark td, html.dark dd, html.dark div:not([style*="color"]) {
    color: #cbd5e1 !important;
  }
  
  /* Specific styling resets for lists and navigation items */
  html.dark .internal-links a {
    color: #cbd5e1 !important;
  }
  html.dark .internal-links a.active {
    color: #f8fafc !important;
  }
  html.dark ul li a h4 {
    color: #f8fafc !important;
  }

  /* Inline styles component override fallback */
  html.dark [style*="color: #1e293b"], 
  html.dark [style*="color: rgb(var(--black))"] {
    color: #cbd5e1 !important;
  }

  /* Inline syntax block handling */
  html.dark pre, html.dark code {
    background-color: #1e293b !important;
    color: #f1f5f9 !important;
  }
  html.dark footer {
    background-color: #0f172a !important;
    color: #94a3b8 !important;
    background-image: none !important;
  }
  html.dark .prose a {
    color: #38bdf8 !important;
  }
</style>