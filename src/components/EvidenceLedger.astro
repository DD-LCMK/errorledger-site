---
interface Props {
  tier?: number;
  source?: string;
  label?: string;
  lang?: string;
}

const {
  tier = 1,
  source = "Court Dockets, Regulatory Orders & Technical Disclosures",
  label = "Documented Incident",
  lang = "en"
} = Astro.props;

const isKorean = lang === 'ko';
---

<div class="evidence-ledger-card">
  <div class="evidence-ledger-header">
    <div class="evidence-header-left">
      <span class="evidence-icon">🏛️</span>
      <div>
        <h4 class="evidence-title">
          {isKorean ? "증거 보관소 & 팩트체크 출처" : "The Evidence Ledger & Source Audit"}
        </h4>
        <span class="evidence-subtitle">
          {isKorean ? "ErrorLedger 검증 표준 및 공공 증거 기록" : "ErrorLedger Epistemic Standard & Public Receipts"}
        </span>
      </div>
    </div>
    <span class="tier-pill tier-{tier}">
      {isKorean ? `Tier ${tier} 증거 검증` : `Tier ${tier} Provenance`}
    </span>
  </div>

  <div class="evidence-body-grid">
    <div class="evidence-block">
      <span class="evidence-block-label">
        {isKorean ? "📌 1차 검증 기록 (Primary Records)" : "📌 Primary Source Manifest"}
      </span>
      <p class="evidence-block-content">
        {source}
      </p>
    </div>

    <div class="evidence-block">
      <span class="evidence-block-label">
        {isKorean ? "⚖️ 인식론적 분류 기준 (Epistemic Firewall)" : "⚖️ Epistemic Claim Firewall"}
      </span>
      <div class="epistemic-badges">
        <span class="ep-badge ep-fact">
          <strong>FACT</strong> {isKorean ? "공문서·판결문 검증" : "Direct Public Record"}
        </span>
        <span class="ep-badge ep-inf">
          <strong>INFERENCE</strong> {isKorean ? "행동 순서 기반 연역" : "Chronological Deduction"}
        </span>
        <span class="ep-badge ep-arch">
          <strong>ARCHIVIST</strong> {isKorean ? "시스템·구조적 판결" : "Systemic Diagnosis"}
        </span>
      </div>
    </div>
  </div>

  <div class="evidence-footer">
    <span class="evidence-footnote">
      {isKorean 
        ? "🛡️ 편집 원칙: 아키비스트 페르소나는 서사적 표현과 시스템 분석을 통제하지만, 결코 사실을 날조하지 않습니다. 기록되지 않은 사적 심리나 대화는 '알 수 없음(UNKNOWN)'으로 엄격히 분리됩니다."
        : "🛡️ Editorial Axiom: The Archivist persona controls rhetorical framing and systemic analysis, but never evidence. Unrecorded psychology and private dialogue are strictly preserved as UNKNOWN."}
    </span>
  </div>
</div>

<style>
  .evidence-ledger-card {
    background: #121212;
    border: 1px solid #262626;
    border-left: 3px solid #f43f5e;
    border-radius: 12px;
    padding: 1.5rem;
    margin: 2.5rem 0;
    box-sizing: border-box;
  }

  .evidence-ledger-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding-bottom: 1rem;
    border-bottom: 1px solid #262626;
    margin-bottom: 1.25rem;
    flex-wrap: wrap;
  }

  .evidence-header-left {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .evidence-icon {
    font-size: 1.5rem;
  }

  .evidence-title {
    font-size: 1.05rem;
    font-weight: 800;
    color: #f5f5f5;
    margin: 0;
    line-height: 1.3;
  }

  .evidence-subtitle {
    font-size: 0.75rem;
    font-family: ui-monospace, monospace;
    color: #a3a3a3;
  }

  .tier-pill {
    padding: 0.25rem 0.65rem;
    border-radius: 999px;
    font-size: 0.72rem;
    font-family: ui-monospace, monospace;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    background: rgba(16, 185, 129, 0.12);
    color: #10b981;
    border: 1px solid rgba(16, 185, 129, 0.3);
  }

  .evidence-body-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.25rem;
    margin-bottom: 1rem;
  }

  @media (min-width: 640px) {
    .evidence-body-grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  .evidence-block {
    background: #171717;
    border: 1px solid #222222;
    border-radius: 8px;
    padding: 1rem;
  }

  .evidence-block-label {
    display: block;
    font-size: 0.75rem;
    font-family: ui-monospace, monospace;
    font-weight: 700;
    color: #fb7185;
    margin-bottom: 0.5rem;
    text-transform: uppercase;
    letter-spacing: 0.03em;
  }

  .evidence-block-content {
    font-size: 0.85rem;
    color: #d4d4d4;
    line-height: 1.5;
    margin: 0;
  }

  .epistemic-badges {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .ep-badge {
    font-size: 0.75rem;
    font-family: ui-monospace, monospace;
    color: #a3a3a3;
    background: #0d0d0d;
    padding: 0.25rem 0.5rem;
    border-radius: 4px;
    border: 1px solid #262626;
  }

  .ep-badge strong {
    color: #f5f5f5;
    margin-right: 0.3rem;
  }

  .evidence-footer {
    padding-top: 0.85rem;
    border-top: 1px dashed #262626;
  }

  .evidence-footnote {
    font-size: 0.78rem;
    color: #888888;
    line-height: 1.45;
  }

  :global(html:not(.dark)) .evidence-ledger-card {
    background: #f8fafc;
    border-color: #e2e8f0;
  }
  :global(html:not(.dark)) .evidence-title { color: #0f172a; }
  :global(html:not(.dark)) .evidence-subtitle { color: #64748b; }
  :global(html:not(.dark)) .evidence-block { background: #ffffff; border-color: #e2e8f0; }
  :global(html:not(.dark)) .evidence-block-content { color: #334155; }
  :global(html:not(.dark)) .ep-badge { background: #f1f5f9; border-color: #e2e8f0; color: #475569; }
</style>
