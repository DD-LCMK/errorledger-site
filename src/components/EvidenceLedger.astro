---
interface Props {
  tier?: number;
  source?: string;
  label?: string;
  lang?: string;
  primary_sources?: Array<{
    title: string;
    url: string;
    type?: string;
    institution?: string;
  }>;
}

const {
  tier = 1,
  source = "Court Dockets, Regulatory Orders & Technical Disclosures",
  label = "Documented Incident",
  lang = "en",
  primary_sources = []
} = Astro.props;

const isKorean = lang === 'ko';
---

<div class="evidence-ledger-card">
  <div class="evidence-ledger-header">
    <div class="evidence-header-left">
      <span class="evidence-icon">🏛️</span>
      <div>
        <h4 class="evidence-title">
          {isKorean ? "증거 보관소 & 팩트체크 출처" : "The Evidence Ledger & Source Audit"}
        </h4>
        <span class="evidence-subtitle">
          {isKorean ? "ErrorLedger 인식론적 검증 표준 및 공공 증거 기록" : "ErrorLedger Epistemic Standard & Public Receipts"}
        </span>
      </div>
    </div>
    <span class="tier-pill tier-{tier}">
      {isKorean ? `Tier ${tier} 공공 기록 검증` : `Tier ${tier} Provenance`}
    </span>
  </div>

  <div class="evidence-body-grid">
    <div class="evidence-block">
      <span class="evidence-block-label">
        {isKorean ? "📌 1차 검증 기록 (Primary Records)" : "📌 Primary Source Manifest"}
      </span>
      <p class="evidence-block-content">
        {source}
      </p>
    </div>

    <div class="evidence-block">
      <span class="evidence-block-label">
        {isKorean ? "⚖️ 인식론적 분류 기준 (Epistemic Firewall)" : "⚖️ Epistemic Claim Firewall"}
      </span>
      <div class="epistemic-badges">
        <span class="ep-badge ep-fact">
          <strong>FACT</strong> {isKorean ? "공문서·판결문 검증" : "Direct Public Record"}
        </span>
        <span class="ep-badge ep-inf">
          <strong>INFERENCE</strong> {isKorean ? "행동 순서 기반 연역" : "Chronological Deduction"}
        </span>
        <span class="ep-badge ep-arch">
          <strong>ARCHIVIST</strong> {isKorean ? "시스템·구조적 판결" : "Systemic Diagnosis"}
        </span>
      </div>
    </div>
  </div>

  {primary_sources && primary_sources.length > 0 && (
    <div class="evidence-sources-section">
      <span class="evidence-block-label">
        {isKorean ? "🔗 검증된 공공 1차 출처 및 법원·규제기관 링크 (Verified Outbound Receipts)" : "🔗 Verified Primary Source Links & Judicial Dockets"}
      </span>
      <div class="sources-links-grid">
        {primary_sources.map((src) => (
          <a href={src.url} target="_blank" rel="noopener noreferrer" class="source-link-card">
            <span class="source-inst">{src.institution || (isKorean ? "공식 기록" : "Official")}</span>
            <span class="source-title">{src.title}</span>
            <span class="source-ext-icon">↗</span>
          </a>
        ))}
      </div>
    </div>
  )}

  <div class="evidence-footer">
    <span class="evidence-footnote">
      {isKorean 
        ? "🛡️ 편집 원칙: 아키비스트 페르소나는 서사적 표현과 시스템 분석을 통제하지만, 결코 사실을 날조하지 않습니다. 모든 법적 판결과 재무적 수치는 공공 1차 기록에 100% 앵커링됩니다."
        : "🛡️ Editorial Axiom: The Archivist persona controls rhetorical framing and systemic analysis, but never evidence. All legal rulings, financial figures, and technical errors are anchored directly to verified primary records."}
    </span>
  </div>
</div>

<style>
  .evidence-ledger-card {
    background: #121212;
    border: 1px solid #262626;
    border-left: 3px solid #f43f5e;
    border-radius: 12px;
    padding: 1.5rem;
    margin: 2.5rem 0;
    box-sizing: border-box;
    width: 100%;
    max-width: 100%;
    overflow: hidden;
  }

  .evidence-ledger-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding-bottom: 1rem;
    border-bottom: 1px solid #262626;
    margin-bottom: 1.25rem;
    flex-wrap: wrap;
  }

  .evidence-header-left {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    min-width: 0;
  }

  .evidence-icon {
    font-size: 1.5rem;
    flex-shrink: 0;
  }

  .evidence-title {
    font-size: 1.05rem;
    font-weight: 800;
    color: #f5f5f5;
    margin: 0;
    line-height: 1.3;
  }

  .evidence-subtitle {
    font-size: 0.75rem;
    font-family: ui-monospace, monospace;
    color: #a3a3a3;
  }

  .tier-pill {
    padding: 0.25rem 0.65rem;
    border-radius: 999px;
    font-size: 0.72rem;
    font-family: ui-monospace, monospace;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    background: rgba(16, 185, 129, 0.12);
    color: #10b981;
    border: 1px solid rgba(16, 185, 129, 0.3);
    flex-shrink: 0;
  }

  .evidence-body-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.25rem;
    margin-bottom: 1.25rem;
    width: 100%;
    min-width: 0;
  }

  @media (min-width: 640px) {
    .evidence-body-grid {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    }
  }

  .evidence-block {
    background: #171717;
    border: 1px solid #222222;
    border-radius: 8px;
    padding: 1rem;
    min-width: 0;
    box-sizing: border-box;
    overflow-wrap: break-word;
    word-break: break-word;
  }

  .evidence-block-label {
    display: block;
    font-size: 0.72rem;
    font-family: ui-monospace, monospace;
    font-weight: 700;
    color: #a3a3a3;
    text-transform: uppercase;
    margin-bottom: 0.5rem;
    letter-spacing: 0.03em;
  }

  .evidence-block-content {
    font-size: 0.85rem;
    color: #d4d4d4;
    line-height: 1.5;
    margin: 0;
    overflow-wrap: break-word;
    word-break: break-word;
  }

  .epistemic-badges {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .ep-badge {
    font-size: 0.75rem;
    color: #a3a3a3;
    background: #111111;
    padding: 0.2rem 0.5rem;
    border-radius: 4px;
    border: 1px solid #222222;
    overflow-wrap: break-word;
    word-break: break-word;
  }

  .ep-badge strong {
    font-family: ui-monospace, monospace;
    margin-right: 0.35rem;
  }

  .ep-fact strong { color: #10b981; }
  .ep-inf strong { color: #38bdf8; }
  .ep-arch strong { color: #f43f5e; }

  /* Sources section */
  .evidence-sources-section {
    background: #151515;
    border: 1px solid #262626;
    border-radius: 8px;
    padding: 1rem;
    margin-bottom: 1.25rem;
    width: 100%;
    min-width: 0;
    box-sizing: border-box;
    overflow: hidden;
  }

  .sources-links-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0.65rem;
    margin-top: 0.5rem;
    width: 100%;
    min-width: 0;
  }

  @media (min-width: 768px) {
    .sources-links-grid {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    }
  }

  .source-link-card {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.65rem;
    background: #1a1a1a;
    border: 1px solid #2a2a2a;
    border-radius: 6px;
    padding: 0.6rem 0.85rem;
    text-decoration: none;
    transition: all 0.15s ease;
    min-width: 0;
    width: 100%;
    box-sizing: border-box;
    overflow: hidden;
  }

  .source-link-card:hover {
    background: #222222;
    border-color: #f43f5e;
    transform: translateY(-1px);
  }

  .source-inst {
    font-family: ui-monospace, monospace;
    font-size: 0.65rem;
    font-weight: 700;
    color: #fb7185;
    background: rgba(244, 63, 94, 0.1);
    padding: 0.15rem 0.4rem;
    border-radius: 4px;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    max-width: 38%;
    flex-shrink: 0;
  }

  .source-title {
    font-size: 0.8rem;
    color: #e5e5e5;
    font-weight: 500;
    line-height: 1.3;
    flex: 1 1 0%;
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .source-link-card:hover .source-title {
    color: #ffffff;
  }

  .source-ext-icon {
    font-size: 0.85rem;
    color: #737373;
    flex-shrink: 0;
  }

  .evidence-footer {
    padding-top: 0.85rem;
    border-top: 1px solid #1f1f1f;
  }

  .evidence-footnote {
    font-size: 0.72rem;
    color: #737373;
    line-height: 1.4;
    display: block;
    overflow-wrap: break-word;
    word-break: break-word;
  }
</style>
