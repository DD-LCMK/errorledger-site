---
import { MBTI_QUESTIONS } from '../data/mbtiQuestions';
import { MBTI_PROFILES } from '../data/mbtiProfiles';
import { getMbtiCompatibility } from '../data/mbtiCompatibility';

interface Props {
  lang?: 'ko' | 'en';
}

const { lang = 'ko' } = Astro.props;
const isEn = lang === 'en';

// Serialize data safely into the page for client-side evaluation
const questionsJson = JSON.stringify(MBTI_QUESTIONS);
const profilesJson = JSON.stringify(MBTI_PROFILES);
---

<div class="mbti-widget-root" id="mbti-widget" data-lang={lang}>
  <!-- Inject Static JSON Data for Instant Reactive Rendering -->
  <script is:inline id="mbti-data-questions" type="application/json" set:html={questionsJson} />
  <script is:inline id="mbti-data-profiles" type="application/json" set:html={profilesJson} />

  <!-- 1. INTRO / HERO STAGE -->
  <div class="mbti-stage mbti-stage-intro" id="stage-intro">
    <div class="intro-backdrop"></div>
    <div class="intro-content">
      <div class="intro-badge">
        <span class="sparkle">🧠</span>
        <span>{isEn ? 'Empirical 60-Question Jungian Cognitive Function Assessment' : '정통 60문항 융(Jung) 인지기능 기반 정밀 검사'}</span>
      </div>
      <h1 class="intro-title">
        {isEn ? 'Scientific MBTI & Cognitive Function Test' : '심층 정밀 MBTI & 인지기능 검사'}
      </h1>
      <p class="intro-desc">
        {isEn 
          ? 'Beyond superficial 4-letter labels. Discover your complete psychological blueprint, 8 cognitive function hierarchies, career strengths, love compatibility, and creator persona with scientific precision.'
          : '단순한 16가지 알파벳 딱지를 넘어, 4대 성향 축의 정밀 백분율과 8대 인지기능 위계(주/부/3차/열등기능), 5대 강점, 스트레스 루프, 직업, 연애 및 크리에이터 성향까지 완벽하게 분석합니다.'}
      </p>

      <!-- Key Scientific Features Grid -->
      <div class="intro-features-grid">
        <div class="feature-item">
          <span class="feat-icon">🎯</span>
          <div class="feat-text">
            <strong>{isEn ? '60 Balanced Items' : '60개 균형 문항'}</strong>
            <span>{isEn ? '15 items per axis across 3 sub-facets' : '축당 15문항 & 3대 세부 하위 척도 정밀 측정'}</span>
          </div>
        </div>
        <div class="feature-item">
          <span class="feat-icon">⚖️</span>
          <div class="feat-text">
            <strong>{isEn ? 'Acquiescence Bias Free' : '역채점 편향 제거'}</strong>
            <span>{isEn ? 'Equally balanced reverse-keyed questions' : '동의 편향을 수학적으로 상쇄하는 균형 역채점'}</span>
          </div>
        </div>
        <div class="feature-item">
          <span class="feat-icon">🔬</span>
          <div class="feat-text">
            <strong>{isEn ? 'Cognitive Function Stack' : '8대 인지기능 위계'}</strong>
            <span>{isEn ? 'Dominant, Auxiliary, Tertiary, Inferior' : '두뇌 정보 처리 엔진(주/부/3차/열등기능) 분석'}</span>
          </div>
        </div>
        <div class="feature-item">
          <span class="feat-icon">⏱️</span>
          <div class="feat-text">
            <strong>{isEn ? 'Fast & Seamless' : '약 6~8분 소요'}</strong>
            <span>{isEn ? 'Fast card pagination & keyboard shortcuts' : '카드형 UI 및 데스크톱 1~7번 단축키 지원'}</span>
          </div>
        </div>
      </div>

      <!-- Action Button -->
      <div class="intro-cta-wrap">
        <button type="button" class="btn-start-test" id="btn-start-test">
          <span>{isEn ? 'Begin Deep Assessment →' : '정밀 검사 시작하기 →'}</span>
        </button>
        <span class="time-estimate-note">
          {isEn ? '⚡ 100% Free • No registration or email required • Instant results' : '⚡ 100% 무료 • 로그인/회원가입 없음 • 즉시 결과 확인'}
        </span>
      </div>
    </div>
  </div>

  <!-- 2. TEST RUNNER STAGE -->
  <div class="mbti-stage mbti-stage-runner" id="stage-runner" style="display: none;">
    <!-- Sticky Progress Header -->
    <div class="runner-header">
      <div class="runner-header-inner">
        <div class="progress-meta">
          <span class="progress-step-text" id="progress-step-text">문항 1 / 60</span>
          <span class="current-facet-badge" id="current-facet-badge">외향 vs 내향</span>
        </div>
        <div class="progress-track">
          <div class="progress-fill" id="progress-fill" style="width: 1.6%;"></div>
        </div>
        <div class="runner-controls-top">
          <span class="keyboard-tip-tag">{isEn ? '⌨️ Press 1-7 on keyboard' : '⌨️ 키보드 1~7번으로 빠른 선택 가능'}</span>
        </div>
      </div>
    </div>

    <!-- Question Container (Smooth card animation) -->
    <div class="question-deck-container">
      <div class="question-card" id="active-question-card">
        <div class="question-card-header">
          <span class="q-number-pill" id="q-number-pill">Q.01</span>
          <span class="q-dimension-pill" id="q-dimension-pill">사회적 에너지 충전</span>
        </div>

        <h2 class="question-text" id="question-text">
          많은 사람들과 교류하고 대화할수록 활력과 생기가 샘솟는 것을 느낀다.
        </h2>

        <!-- 7-Point Likert Scale Buttons -->
        <div class="likert-scale-wrap">
          <div class="likert-labels-row">
            <span class="label-disagree">{isEn ? 'Disagree' : '동의하지 않음'}</span>
            <span class="label-neutral">{isEn ? 'Neutral' : '보통'}</span>
            <span class="label-agree">{isEn ? 'Agree' : '동의함'}</span>
          </div>

          <div class="likert-buttons-row" role="radiogroup" aria-label="Rating scale 1 to 7">
            <button type="button" class="likert-btn btn-score-1" data-score="1" aria-label={isEn ? "1 - Strongly Disagree" : "1 - 매우 비동의"}>
              <span class="btn-circle"></span>
              <span class="btn-tag">{isEn ? 'Strongly Disagree' : '매우 비동의'}</span>
            </button>
            <button type="button" class="likert-btn btn-score-2" data-score="2" aria-label={isEn ? "2 - Disagree" : "2 - 비동의"}>
              <span class="btn-circle"></span>
              <span class="btn-tag">{isEn ? 'Disagree' : '비동의'}</span>
            </button>
            <button type="button" class="likert-btn btn-score-3" data-score="3" aria-label={isEn ? "3 - Slightly Disagree" : "3 - 약간 비동의"}>
              <span class="btn-circle"></span>
              <span class="btn-tag">{isEn ? 'Slightly Disagree' : '약간 비동의'}</span>
            </button>
            <button type="button" class="likert-btn btn-score-4" data-score="4" aria-label={isEn ? "4 - Neutral" : "4 - 보통"}>
              <span class="btn-circle"></span>
              <span class="btn-tag">{isEn ? 'Neutral' : '보통'}</span>
            </button>
            <button type="button" class="likert-btn btn-score-5" data-score="5" aria-label={isEn ? "5 - Slightly Agree" : "5 - 약간 동의"}>
              <span class="btn-circle"></span>
              <span class="btn-tag">{isEn ? 'Slightly Agree' : '약간 동의'}</span>
            </button>
            <button type="button" class="likert-btn btn-score-6" data-score="6" aria-label={isEn ? "6 - Agree" : "6 - 동의"}>
              <span class="btn-circle"></span>
              <span class="btn-tag">{isEn ? 'Agree' : '동의'}</span>
            </button>
            <button type="button" class="likert-btn btn-score-7" data-score="7" aria-label={isEn ? "7 - Strongly Agree" : "7 - 매우 동의"}>
              <span class="btn-circle"></span>
              <span class="btn-tag">{isEn ? 'Strongly Agree' : '매우 동의'}</span>
            </button>
          </div>
        </div>

        <!-- Navigation Buttons -->
        <div class="question-nav-row">
          <button type="button" class="btn-nav-prev" id="btn-nav-prev" disabled>
            <span>{isEn ? '← Previous' : '← 이전 문항'}</span>
          </button>
          <span class="answered-counter" id="answered-counter">0 / 60 완료</span>
          <button type="button" class="btn-nav-next" id="btn-nav-next">
            <span>{isEn ? 'Next →' : '다음 문항 →'}</span>
          </button>
        </div>
      </div>
    </div>
  </div>

  <!-- 3. ANALYZING / LOADING STAGE -->
  <div class="mbti-stage mbti-stage-analyzing" id="stage-analyzing" style="display: none;">
    <div class="analyzing-box">
      <div class="analyzing-spinner">
        <div class="spinner-ring"></div>
        <div class="spinner-core">🧠</div>
      </div>
      <h2 class="analyzing-title">{isEn ? 'Synthesizing Your Psychological Blueprint...' : '심층 심리 인지 모델 분석 중...'}</h2>
      <div class="analyzing-steps">
        <div class="step-item done" id="ana-step-1">
          <span class="check">✓</span>
          <span>{isEn ? 'Raw dimensional score deviations calculated' : '4대 성향 축 원점수 및 중심화 편차 계산'}</span>
        </div>
        <div class="step-item" id="ana-step-2">
          <span class="check">✓</span>
          <span>{isEn ? 'Mapping 8-layer Jungian cognitive function stack' : '융(Jung) 8대 인지기능 위계 스택 매핑'}</span>
        </div>
        <div class="step-item" id="ana-step-3">
          <span class="check">✓</span>
          <span>{isEn ? 'Generating detailed 16-type behavioral blueprint' : '16대 심층 다층 리포트 데이터 생성 완료'}</span>
        </div>
      </div>
    </div>
  </div>

  <!-- 4. DETAILED RESULT DASHBOARD STAGE -->
  <div class="mbti-stage mbti-stage-result" id="stage-result" style="display: none;">
    <!-- Result Top Banner Card -->
    <div class="result-hero-card">
      <div class="result-hero-backdrop"></div>
      
      <div class="result-header-row">
        <div class="result-title-badge-box">
          <span class="result-badge-pill" id="res-badge-pill">🏛️ 전략과 통찰의 마스터</span>
          <h1 class="result-type-code" id="res-type-code">INTJ</h1>
          <h2 class="result-type-name" id="res-type-name">용의주도한 전략가</h2>
        </div>

        <div class="result-actions-top">
          <button type="button" class="btn-share-result" id="btn-share-result">
            <span>🔗 {isEn ? 'Share My Result' : '결과 공유 / 링크 복사'}</span>
          </button>
          <button type="button" class="btn-retake-test" id="btn-retake-test">
            <span>🔄 {isEn ? 'Retake Test' : '다시 검사하기'}</span>
          </button>
        </div>
      </div>

      <div class="result-keywords-row" id="res-keywords-row">
        <!-- Injected via JS -->
      </div>

      <blockquote class="result-motto" id="res-motto">
        "모든 문제는 치밀한 시스템과 통찰력으로 해결할 수 있다."
      </blockquote>

      <!-- Dimension Percentages Breakdown Grid -->
      <div class="dimensions-breakdown-card">
        <h3 class="dimensions-title">{isEn ? '4-Dimensional Spectrum & Preference Intensity' : '4대 심리 축 성향 스펙트럼 및 강도 지수'}</h3>
        
        <div class="dim-meters-grid">
          <!-- EI Meter -->
          <div class="dim-meter-row">
            <div class="dim-labels">
              <span class="dim-side left"><strong>E</strong> {isEn ? 'Extravert' : '외향형'}</span>
              <span class="dim-score-badge" id="dim-badge-ei">76% 내향 (확고형)</span>
              <span class="dim-side right"><strong>I</strong> {isEn ? 'Introvert' : '내향형'}</span>
            </div>
            <div class="dim-bar-track">
              <div class="dim-bar-fill left" id="dim-fill-ei-left" style="width: 24%;"></div>
              <div class="dim-bar-divider"></div>
              <div class="dim-bar-fill right" id="dim-fill-ei-right" style="width: 76%;"></div>
            </div>
          </div>

          <!-- SN Meter -->
          <div class="dim-meter-row">
            <div class="dim-labels">
              <span class="dim-side left"><strong>S</strong> {isEn ? 'Sensing' : '감각형'}</span>
              <span class="dim-score-badge" id="dim-badge-sn">82% 직관 (확고형)</span>
              <span class="dim-side right"><strong>N</strong> {isEn ? 'Intuition' : '직관형'}</span>
            </div>
            <div class="dim-bar-track">
              <div class="dim-bar-fill left" id="dim-fill-sn-left" style="width: 18%;"></div>
              <div class="dim-bar-divider"></div>
              <div class="dim-bar-fill right" id="dim-fill-sn-right" style="width: 82%;"></div>
            </div>
          </div>

          <!-- TF Meter -->
          <div class="dim-meter-row">
            <div class="dim-labels">
              <span class="dim-side left"><strong>T</strong> {isEn ? 'Thinking' : '사고형'}</span>
              <span class="dim-score-badge" id="dim-badge-tf">72% 사고 (완만형)</span>
              <span class="dim-side right"><strong>F</strong> {isEn ? 'Feeling' : '감정형'}</span>
            </div>
            <div class="dim-bar-track">
              <div class="dim-bar-fill left" id="dim-fill-tf-left" style="width: 72%;"></div>
              <div class="dim-bar-divider"></div>
              <div class="dim-bar-fill right" id="dim-fill-tf-right" style="width: 28%;"></div>
            </div>
          </div>

          <!-- JP Meter -->
          <div class="dim-meter-row">
            <div class="dim-labels">
              <span class="dim-side left"><strong>J</strong> {isEn ? 'Judging' : '판단형'}</span>
              <span class="dim-score-badge" id="dim-badge-jp">85% 판단 (확고형)</span>
              <span class="dim-side right"><strong>P</strong> {isEn ? 'Perceiving' : '인식형'}</span>
            </div>
            <div class="dim-bar-track">
              <div class="dim-bar-fill left" id="dim-fill-jp-left" style="width: 85%;"></div>
              <div class="dim-bar-divider"></div>
              <div class="dim-bar-fill right" id="dim-fill-jp-right" style="width: 15%;"></div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Continuous Comprehensive Personality Report -->
    <div class="result-details-container">
      <!-- Sticky Quick Jump TOC Bar -->
      <div class="result-sticky-nav-wrap" id="result-sticky-nav-wrap">
        <nav class="result-jump-nav" id="result-jump-nav" aria-label="Report Quick Navigation">
          <button type="button" class="jump-chip active" data-target="section-overview">
            <span>📋 {isEn ? 'Overview' : '심층 총평'}</span>
          </button>
          <button type="button" class="jump-chip" data-target="section-cognition">
            <span>🧠 {isEn ? 'Cognitive Stack' : '8대 인지기능'}</span>
          </button>
          <button type="button" class="jump-chip" data-target="section-strengths">
            <span>💎 {isEn ? 'Strengths & Flaws' : '강점과 약점'}</span>
          </button>
          <button type="button" class="jump-chip" data-target="section-stress">
            <span>🌪️ {isEn ? 'Stress Loop' : '스트레스 루프'}</span>
          </button>
          <button type="button" class="jump-chip" data-target="section-career">
            <span>💼 {isEn ? 'Career Blueprint' : '직업 & 커리어'}</span>
          </button>
          <button type="button" class="jump-chip" data-target="section-relationship">
            <span>💖 {isEn ? 'Love & Match' : '연애 & 궁합'}</span>
          </button>
          <button type="button" class="jump-chip" data-target="section-streamer">
            <span>🎮 {isEn ? 'Creator Style' : '방송/크리에이터'}</span>
          </button>
        </nav>
      </div>

      <!-- All 7 Report Sections in Seamless Continuous Flow -->
      <div class="result-sections-stream">
        <!-- SECTION 1: OVERVIEW -->
        <section class="result-report-section" id="section-overview">
          <div class="detail-card">
            <div class="section-badge-tag"><span class="badge-num">01</span><span>{isEn ? 'Executive Psychological Blueprint' : '성격 심층 분석 & 대표 인물'}</span></div>
            <h3 class="pane-headline">
              <span>🌌</span>
              <span>{isEn ? 'Psychological Essence & Blueprint' : '정신적 청사진과 성격 심층 분석'}</span>
            </h3>
            <p class="overview-paragraph" id="res-overview-p"></p>

            <div class="famous-figures-box">
              <h4>🌟 {isEn ? 'Famous Figures & Icons of this Type' : '이 유형의 대표적 인물 및 캐릭터'}</h4>
              <div class="figures-list" id="res-figures-list"></div>
            </div>
          </div>
        </section>

        <!-- SECTION 2: COGNITIVE FUNCTIONS -->
        <section class="result-report-section" id="section-cognition">
          <div class="detail-card">
            <div class="section-badge-tag"><span class="badge-num">02</span><span>{isEn ? 'Jungian Cognitive Functions' : '융(Jung) 8대 인지기능 두뇌 메커니즘'}</span></div>
            <h3 class="pane-headline">
              <span>🧠</span>
              <span>{isEn ? 'Jungian 4-Layer Cognitive Function Architecture' : '융(Jung)의 4계층 인지기능 두뇌 메커니즘'}</span>
            </h3>
            <p class="pane-subtext">
              {isEn 
                ? 'Your personality is driven by a subconscious hierarchy of cognitive functions that determine how your mind processes data and makes executive choices.'
                : 'MBTI의 4글자는 단순한 라벨이 아닙니다. 두뇌가 정보를 지각하고 판단하는 4대 인지기능의 작동 순서(위계)를 나타냅니다.'}
            </p>

            <div class="cognitive-cards-grid">
              <div class="cog-card dominant">
                <div class="cog-card-header">
                  <span class="cog-badge dominant">{isEn ? '1. Dominant (Hero)' : '1차 주기능 (히어로)'}</span>
                  <span class="cog-code" id="cog-dom-code">Ni</span>
                </div>
                <h4 id="cog-dom-name">내향 직관</h4>
                <p id="cog-dom-desc"></p>
              </div>

              <div class="cog-card auxiliary">
                <div class="cog-card-header">
                  <span class="cog-badge auxiliary">{isEn ? '2. Auxiliary (Wing)' : '2차 부기능 (날개)'}</span>
                  <span class="cog-code" id="cog-aux-code">Te</span>
                </div>
                <h4 id="cog-aux-name">외향 사고</h4>
                <p id="cog-aux-desc"></p>
              </div>

              <div class="cog-card tertiary">
                <div class="cog-card-header">
                  <span class="cog-badge tertiary">{isEn ? '3. Tertiary (Relief)' : '3차 3차기능 (힐링/유희)'}</span>
                  <span class="cog-code" id="cog-tert-code">Fi</span>
                </div>
                <h4 id="cog-tert-name">내향 감정</h4>
                <p id="cog-tert-desc"></p>
              </div>

              <div class="cog-card inferior">
                <div class="cog-card-header">
                  <span class="cog-badge inferior">{isEn ? '4. Inferior (Achilles)' : '4차 열등기능 (아킬레스건)'}</span>
                  <span class="cog-code" id="cog-inf-code">Se</span>
                </div>
                <h4 id="cog-inf-name">외향 감각</h4>
                <p id="cog-inf-desc"></p>
              </div>
            </div>
          </div>
        </section>

        <!-- SECTION 3: STRENGTHS & FLAWS -->
        <section class="result-report-section" id="section-strengths">
          <div class="detail-card">
            <div class="section-badge-tag"><span class="badge-num">03</span><span>{isEn ? 'Core Superpowers & Blind Spots' : '5대 핵심 슈퍼파워 & 5대 주의 맹점'}</span></div>
            <div class="strengths-weaknesses-grid">
              <div class="sw-column strengths">
                <h3 class="sw-title strengths">
                  <span>💎</span>
                  <span>{isEn ? 'Top 5 Superpowers (Strengths)' : '5대 핵심 슈퍼파워 (강점)'}</span>
                </h3>
                <ul class="sw-list" id="res-strengths-list"></ul>
              </div>

              <div class="sw-column weaknesses">
                <h3 class="sw-title weaknesses">
                  <span>⚠️</span>
                  <span>{isEn ? 'Top 5 Blind Spots (Pitfalls)' : '주의해야 할 5대 맹점 (약점)'}</span>
                </h3>
                <ul class="sw-list" id="res-weaknesses-list"></ul>
              </div>
            </div>
          </div>
        </section>

        <!-- SECTION 4: STRESS LOOP & RECOVERY -->
        <section class="result-report-section" id="section-stress">
          <div class="detail-card">
            <div class="section-badge-tag"><span class="badge-num">04</span><span>{isEn ? 'Stress Loop & Psychological Maturity' : '스트레스 루프 & 자아실현 가이드'}</span></div>
            <h3 class="pane-headline">
              <span>🌪️</span>
              <span>{isEn ? 'Cognitive Stress Loop & Grip Dynamics' : '극심한 스트레스 시 인지 루프 및 폭주(Grip) 반응'}</span>
            </h3>
            <p class="pane-subtext">
              {isEn 
