  .cog-badge.auxiliary { background: rgba(56, 189, 248, 0.2); color: #7dd3fc; }
  .cog-badge.tertiary { background: rgba(245, 158, 11, 0.2); color: #fde68a; }
  .cog-badge.inferior { background: rgba(239, 68, 68, 0.2); color: #fca5a5; }

