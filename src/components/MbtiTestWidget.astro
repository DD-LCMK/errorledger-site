    box-shadow: 0 6px 18px rgba(16, 185, 129, 0.4);
  }

  .answered-counter {
    font-size: 0.88rem;
    color: #94a3b8;
    font-weight: 600;
  }

  /* STAGE 3: ANALYZING */
  .mbti-stage-analyzing {
    display: flex;
    justify-content: center;
    align-items: center;
    padding: 100px 20px;
  }

  .analyzing-box {
    background: #111422;
    border: 1px solid rgba(99, 102, 241, 0.3);
    border-radius: 24px;
    padding: 50px 40px;
    text-align: center;
    max-width: 540px;
    box-shadow: 0 20px 50px rgba(0, 0, 0, 0.7);
  }

  .analyzing-spinner {
    position: relative;
    width: 90px;
    height: 90px;
    margin: 0 auto 30px;
  }

  .spinner-ring {
    position: absolute;
    inset: 0;
    border-radius: 50%;
    border: 4px solid rgba(99, 102, 241, 0.15);
    border-top-color: #6366f1;
    animation: spin 1.2s cubic-bezier(0.68, -0.55, 0.27, 1.55) infinite;
  }

  .spinner-core {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 2.2rem;
  }

  @keyframes spin {
    to { transform: rotate(360deg); }
  }

  .analyzing-title {
    font-size: 1.5rem;
    font-weight: 800;
    color: #f8fafc;
    margin: 0 0 24px;
  }

  .analyzing-steps {
    display: flex;
    flex-direction: column;
    gap: 12px;
    text-align: left;
  }

  .step-item {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 0.92rem;
    color: #64748b;
  }

  .step-item .check {
    opacity: 0.2;
    font-weight: 900;
  }

  .step-item.done {
    color: #cbd5e1;
  }
  .step-item.done .check {
    color: #10b981;
    opacity: 1;
  }

  /* STAGE 4: DETAILED RESULT DASHBOARD */
  .result-hero-card {
    position: relative;
    background: linear-gradient(135deg, rgba(26, 32, 54, 0.95) 0%, rgba(35, 25, 66, 0.85) 100%);
    border: 1px solid rgba(99, 102, 241, 0.35);
    border-radius: 28px;
    padding: 44px 36px;
    margin-bottom: 32px;
    overflow: hidden;
    box-shadow: 0 20px 40px -15px rgba(0, 0, 0, 0.6), 0 0 0 1px rgba(99, 102, 241, 0.15);
  }

  .result-hero-backdrop {
    position: absolute;
    top: -50%;
    right: -20%;
    width: 600px;
    height: 400px;
    background: radial-gradient(circle, rgba(99, 102, 241, 0.3) 0%, transparent 70%);
    filter: blur(60px);
    pointer-events: none;
  }

  .result-header-row {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    flex-wrap: wrap;
    gap: 20px;
    margin-bottom: 20px;
  }

  .result-badge-pill {
    display: inline-block;
    background: rgba(99, 102, 241, 0.2);
    border: 1px solid rgba(99, 102, 241, 0.4);
    color: #c7d2fe;
    font-size: 0.85rem;
    font-weight: 700;
    padding: 5px 16px;
    border-radius: 9999px;
    margin-bottom: 12px;
  }

  .result-type-code {
    font-size: 4.2rem;
    font-weight: 900;
    line-height: 1;
    letter-spacing: -0.04em;
    margin: 0 0 8px;
    background: linear-gradient(135deg, #ffffff 30%, #a5b4fc 100%);
