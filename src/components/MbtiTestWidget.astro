          desc = isEn
            ? 'Judging (' + jPct + '%) and Perceiving (' + pPct + '%) are in equilibrium. You are an <strong>Agile & Adaptive Planner</strong>. You establish essential timelines and structured goals (J), yet welcome spontaneous twists, new creative opportunities, and sudden changes with fluid grace (P).'
            : '판단(' + jPct + '%)과 인식(' + pPct + '%)이 조화를 이룬 <strong>유연한 계획형 (애자일 스타일)</strong>입니다! 전체적인 마감 기한과 핵심 뼈대(J)는 든든하게 세워두되, 진행 과정에서 돌발 변수나 새로운 영감이 찾아오면 스트레스 없이 유연하게 계획을 수정하고 즐기는(P) 뛰어난 상황 적응력을 자랑합니다. 계획에 갇혀 질식하지도, 무계획으로 표류하지도 않는 최적의 라이프스타일 밸런스입니다.';
        } else if (isModerate) {
          desc = isEn
            ? 'Leaning toward ' + (primary === 'J' ? 'structured predictability (J)' : 'spontaneous freedom (P)') + ' (' + percent + '%), while possessing easy adaptability when schedules shift.'
            : (primary === 'J' ? '체계적인 계획과 정돈(J)' : '자유로운 탐색과 유연성(P)') + '(' + percent + '%)을 선호하지만, 상황이 바뀌었을 때 당황하지 않고 대처하는 유연함을 보유하고 있습니다.';
        } else {
          desc = isEn
            ? 'Uncompromising ' + (primary === 'J' ? 'Judging' : 'Perceiving') + ' orientation (' + percent + '%). You thrive at your highest potential when ' + (primary === 'J' ? 'everything is neatly organized, scheduled, and systematically executed according to plan' : 'all possibilities remain open, giving you maximum freedom to improvise and strike spontaneously in the flow of the moment') + '.'
            : (primary === 'J' ? '판단(J)' : '인식(P)') + ' 성향(' + percent + '%)이 절대적입니다. 일상을 살아갈 때 ' + (primary === 'J' ? '예측 불가능한 무질서를 극도로 기피하며, 모든 일정과 단계가 명확하게 정돈되고 통제될 때 최고의 심리적 안정감을 누립니다' : '엄격한 규칙이나 닫힌 일정에 갇히는 것을 극도로 답답해하며, 자유로운 탐색과 닥쳐오는 순간의 직관적 몰입에서 최고의 잠재력이 폭발합니다') + '.';
        }
      }

      return {
        strengthLabel: strengthLabel,
        strengthIcon: strengthIcon,
        isBalanced: isBalanced,
