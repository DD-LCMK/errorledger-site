<script is:inline>
(function() {
  // Parse static datasets
  var rawQuestionsEl = document.getElementById('mbti-data-questions');
  var rawProfilesEl = document.getElementById('mbti-data-profiles');
  if (!rawQuestionsEl || !rawProfilesEl) return;

  var questions = JSON.parse(rawQuestionsEl.textContent || '[]');
  var profiles = JSON.parse(rawProfilesEl.textContent || '{}');
  var lang = document.getElementById('mbti-widget')?.getAttribute('data-lang') || 'ko';
  var isEn = lang === 'en';

  // State
  var currentIndex = 0;
  var maxReachedIndex = 0;
  var answers = new Array(questions.length).fill(null);
  var currentResultType = 'INTJ';
  var isAdvancing = false;
  var advanceTimer = null;

  // DOM Elements
  var stageIntro = document.getElementById('stage-intro');
  var stageRunner = document.getElementById('stage-runner');
  var stageAnalyzing = document.getElementById('stage-analyzing');
  var stageResult = document.getElementById('stage-result');

  var btnStartTest = document.getElementById('btn-start-test');
  var progressStepText = document.getElementById('progress-step-text');
  var currentFacetBadge = document.getElementById('current-facet-badge');
  var progressFill = document.getElementById('progress-fill');
  var qNumberPill = document.getElementById('q-number-pill');
  var qDimensionPill = document.getElementById('q-dimension-pill');
  var questionText = document.getElementById('question-text');
  var btnNavPrev = document.getElementById('btn-nav-prev');
  var btnNavNext = document.getElementById('btn-nav-next');
  var answeredCounter = document.getElementById('answered-counter');
  var likertBtns = document.querySelectorAll('.likert-btn');

  // Return to Latest Question Elements
  var returnLatestBar = document.getElementById('return-latest-bar');
  var latestQNum = document.getElementById('latest-q-num');
  var btnReturnLatest = document.getElementById('btn-return-latest');
  var btnNavReturnPill = document.getElementById('btn-nav-return-pill');
  var navLatestNum = document.getElementById('nav-latest-num');

  // Matrix Modal Elements
  var questionMatrixModal = document.getElementById('question-matrix-modal');
  var matrixModalBackdrop = document.getElementById('matrix-modal-backdrop');
  var btnCloseMatrix = document.getElementById('btn-close-matrix');
  var btnToggleGrid = document.getElementById('btn-toggle-grid');
  var btnOpenMatrix = document.getElementById('btn-open-matrix');
  var matrixFarthestWrap = document.getElementById('matrix-farthest-wrap');
  var matrixLatestQNum = document.getElementById('matrix-latest-q-num');
  var btnMatrixReturnLatest = document.getElementById('btn-matrix-return-latest');

  var matrixGroupEI = document.getElementById('matrix-group-ei');
  var matrixGroupSN = document.getElementById('matrix-group-sn');
  var matrixGroupTF = document.getElementById('matrix-group-tf');
  var matrixGroupJP = document.getElementById('matrix-group-jp');

  // Check URL params for direct shared result: ?type=INTJ&ei=76&sn=82&tf=72&jp=85
  var urlParams = new URLSearchParams(window.location.search);
  var paramType = urlParams.get('type')?.toUpperCase();
  if (paramType && profiles[paramType]) {
    currentResultType = paramType;
    showResultDashboard({
      code: paramType,
      percentages: {
        EI: { primary: paramType[0], percent: parseInt(urlParams.get('ei') || urlParams.get('i') || '75', 10) },
        SN: { primary: paramType[1], percent: parseInt(urlParams.get('sn') || urlParams.get('n') || '75', 10) },
        TF: { primary: paramType[2], percent: parseInt(urlParams.get('tf') || urlParams.get('t') || '75', 10) },
        JP: { primary: paramType[3], percent: parseInt(urlParams.get('jp') || urlParams.get('j') || '75', 10) },
      }
    });
  }

  // 1. Start Test Button
  if (btnStartTest) {
    btnStartTest.addEventListener('click', function() {
      stageIntro.style.display = 'none';
      stageRunner.style.display = 'block';
      renderQuestion(0);
      window.scrollTo({ top: stageRunner.offsetTop - 40, behavior: 'smooth' });
    });
  }

  // Question Matrix Setup (60 Chips)
  function initMatrixChips() {
    if (!matrixGroupEI) return;
    matrixGroupEI.innerHTML = '';
    matrixGroupSN.innerHTML = '';
    matrixGroupTF.innerHTML = '';
    matrixGroupJP.innerHTML = '';

    for (var i = 0; i < questions.length; i++) {
      var btn = document.createElement('button');
      btn.type = 'button';
      btn.className = 'q-chip-btn';
      btn.setAttribute('data-idx', String(i));
      btn.textContent = String(i + 1);
      btn.addEventListener('click', function() {
        var targetIdx = parseInt(this.getAttribute('data-idx') || '0', 10);
        renderQuestion(targetIdx);
        closeMatrixModal();
      });

      if (i < 15) matrixGroupEI.appendChild(btn);
      else if (i < 30) matrixGroupSN.appendChild(btn);
      else if (i < 45) matrixGroupTF.appendChild(btn);
      else matrixGroupJP.appendChild(btn);
    }
  }
  initMatrixChips();

  function updateMatrixChips() {
    var allChips = document.querySelectorAll('.q-chip-btn');
    allChips.forEach(function(chip) {
      var idx = parseInt(chip.getAttribute('data-idx') || '0', 10);
      chip.classList.toggle('current', idx === currentIndex);
      chip.classList.toggle('answered', answers[idx] !== null);
      chip.classList.toggle('unanswered', answers[idx] === null);
    });
  }

  function openMatrixModal() {
    if (questionMatrixModal) {
      updateMatrixChips();
      questionMatrixModal.style.display = 'flex';
    }
  }

  function closeMatrixModal() {
    if (questionMatrixModal) {
      questionMatrixModal.style.display = 'none';
    }
  }

  function jumpToLatest() {
    if (advanceTimer) {
      clearTimeout(advanceTimer);
      advanceTimer = null;
    }
    isAdvancing = false;
    renderQuestion(maxReachedIndex);
    closeMatrixModal();
  }

  if (btnToggleGrid) btnToggleGrid.addEventListener('click', openMatrixModal);
  if (btnOpenMatrix) btnOpenMatrix.addEventListener('click', openMatrixModal);
  if (btnCloseMatrix) btnCloseMatrix.addEventListener('click', closeMatrixModal);
  if (matrixModalBackdrop) matrixModalBackdrop.addEventListener('click', closeMatrixModal);

  if (btnReturnLatest) btnReturnLatest.addEventListener('click', jumpToLatest);
  if (btnNavReturnPill) btnNavReturnPill.addEventListener('click', jumpToLatest);
  if (btnMatrixReturnLatest) btnMatrixReturnLatest.addEventListener('click', jumpToLatest);

  // 2. Render Question Card
  function renderQuestion(index) {
    if (index < 0 || index >= questions.length) return;
    if (advanceTimer) {
      clearTimeout(advanceTimer);
      advanceTimer = null;
    }
    isAdvancing = false;

    currentIndex = index;
    maxReachedIndex = Math.max(maxReachedIndex, index);
    var q = questions[index];

    progressStepText.textContent = (isEn ? 'Question ' : '문항 ') + (index + 1) + ' / ' + questions.length;
    var facetName = isEn ? q.facetNameEn : q.facetNameKo;
    currentFacetBadge.textContent = facetName;
    progressFill.style.width = (((index + 1) / questions.length) * 100) + '%';

    qNumberPill.textContent = 'Q.' + (index + 1 < 10 ? '0' : '') + (index + 1);
    qDimensionPill.textContent = facetName;
    questionText.textContent = isEn ? q.textEn : q.textKo;

    // Reviewing past question indicator & return buttons
    var isReviewingPast = (currentIndex < maxReachedIndex);
    if (returnLatestBar) {
      returnLatestBar.style.display = isReviewingPast ? 'flex' : 'none';
      if (latestQNum) latestQNum.textContent = String(maxReachedIndex + 1);
    }
    if (btnNavReturnPill) {
      btnNavReturnPill.style.display = isReviewingPast ? 'inline-flex' : 'none';
      if (navLatestNum) navLatestNum.textContent = String(maxReachedIndex + 1);
    }
    if (matrixFarthestWrap) {
      matrixFarthestWrap.style.display = isReviewingPast ? 'block' : 'none';
      if (matrixLatestQNum) matrixLatestQNum.textContent = String(maxReachedIndex + 1);
    }

    // Likert button states
    var curVal = answers[index];
    likertBtns.forEach(function(btn) {
      var score = parseInt(btn.getAttribute('data-score') || '0', 10);
      if (curVal === score) {
        btn.classList.add('selected');
      } else {
        btn.classList.remove('selected');
      }
    });

    btnNavPrev.disabled = (index === 0);
    
    // Count answered
    var totalAnswered = answers.filter(function(v) { return v !== null; }).length;
    answeredCounter.textContent = totalAnswered + ' / ' + questions.length + (isEn ? ' answered' : ' 완료');

    // Next button label
    if (index === questions.length - 1) {
      btnNavNext.innerHTML = '<span>' + (isEn ? 'Complete Assessment ✨' : '검사 결과 분석하기 ✨') + '</span>';
      btnNavNext.classList.add('finish-mode');
    } else {
      btnNavNext.innerHTML = '<span>' + (isEn ? 'Next →' : '다음 문항 →') + '</span>';
      btnNavNext.classList.remove('finish-mode');
    }

    updateMatrixChips();
  }

  // 3. Select Score (Throttled to prevent skips on rapid clicking)
  function selectScore(score) {
    if (isAdvancing) return; // Prevent accidental double-clicks from skipping questions
    if (advanceTimer) {
      clearTimeout(advanceTimer);
      advanceTimer = null;
    }

    answers[currentIndex] = score;

    // Update button visual state immediately
    likertBtns.forEach(function(btn) {
      var s = parseInt(btn.getAttribute('data-score') || '0', 10);
      if (s === score) {
        btn.classList.add('selected');
      } else {
        btn.classList.remove('selected');
      }
    });

    var totalAnswered = answers.filter(function(v) { return v !== null; }).length;
    answeredCounter.textContent = totalAnswered + ' / ' + questions.length + (isEn ? ' answered' : ' 완료');
    updateMatrixChips();

    // Auto-advance with smooth transition after 240ms
    isAdvancing = true;
    advanceTimer = setTimeout(function() {
      isAdvancing = false;
      if (currentIndex < questions.length - 1) {
        renderQuestion(currentIndex + 1);
      } else {
        // Check if all answered
        var unansIdx = answers.findIndex(function(v) { return v === null; });
        if (unansIdx !== -1) {
          alert(isEn ? 'Please answer question ' + (unansIdx + 1) + ' before completing.' : (unansIdx + 1) + '번 문항을 입력해 주세요.');
          renderQuestion(unansIdx);
        } else {
          runCalculation();
        }
      }
    }, 240);
  }

  // Bind click to Likert buttons
  likertBtns.forEach(function(btn) {
    btn.addEventListener('click', function() {
      var score = parseInt(this.getAttribute('data-score') || '4', 10);
      selectScore(score);
    });
  });

  // Prev / Next buttons
  if (btnNavPrev) {
    btnNavPrev.addEventListener('click', function() {
      if (advanceTimer) { clearTimeout(advanceTimer); advanceTimer = null; }
      isAdvancing = false;
      if (currentIndex > 0) renderQuestion(currentIndex - 1);
    });
  }

  if (btnNavNext) {
    btnNavNext.addEventListener('click', function() {
      if (advanceTimer) { clearTimeout(advanceTimer); advanceTimer = null; }
      isAdvancing = false;
      if (currentIndex === questions.length - 1) {
        var unansIdx = answers.findIndex(function(v) { return v === null; });
        if (unansIdx !== -1) {
          alert(isEn ? 'Please complete question ' + (unansIdx + 1) : (unansIdx + 1) + '번 문항을 입력해 주세요.');
          renderQuestion(unansIdx);
        } else {
          runCalculation();
        }
      } else {
        renderQuestion(currentIndex + 1);
      }
    });
  }

  // 4. Keyboard Shortcuts: 1-7 for scores, Arrow keys for navigation, Esc to close matrix
  window.addEventListener('keydown', function(e) {
    if (stageRunner.style.display === 'none') return;
    var key = e.key;
    if (key === 'Escape') {
      closeMatrixModal();
    } else if (key >= '1' && key <= '7') {
      selectScore(parseInt(key, 10));
    } else if (key === 'ArrowLeft') {
      if (advanceTimer) { clearTimeout(advanceTimer); advanceTimer = null; }
      isAdvancing = false;
      if (currentIndex > 0) renderQuestion(currentIndex - 1);
    } else if (key === 'ArrowRight') {
      if (advanceTimer) { clearTimeout(advanceTimer); advanceTimer = null; }
      isAdvancing = false;
      if (currentIndex < questions.length - 1) renderQuestion(currentIndex + 1);
    }
  });

  // 5. Rigorous Psychometric Scoring Formula Engine
  function runCalculation() {
    stageRunner.style.display = 'none';
    stageAnalyzing.style.display = 'flex';
    window.scrollTo({ top: stageAnalyzing.offsetTop - 40, behavior: 'smooth' });

    var step1 = document.getElementById('ana-step-1');
    var step2 = document.getElementById('ana-step-2');
    var step3 = document.getElementById('ana-step-3');

    setTimeout(function() { if (step1) step1.classList.add('done'); }, 500);
    setTimeout(function() { if (step2) step2.classList.add('done'); }, 1200);
    setTimeout(function() { if (step3) step3.classList.add('done'); }, 1900);

    setTimeout(function() {
      var sumEI = 0;
      var sumSN = 0;
      var sumTF = 0;
      var sumJP = 0;

      for (var i = 0; i < questions.length; i++) {
        var q = questions[i];
        var response = answers[i] || 4;
        var deviation = response - 4; // -3 to +3
        var score = q.polarity * deviation;

        if (q.dimension === 'EI') sumEI += score;
        else if (q.dimension === 'SN') sumSN += score;
        else if (q.dimension === 'TF') sumTF += score;
        else if (q.dimension === 'JP') sumJP += score;
      }

      function calcDim(sum, posLetter, negLetter) {
        if (sum >= 0) {
          var pct = Math.round(50 + (sum / 45) * 50);
          return { primary: posLetter, secondary: negLetter, percent: Math.min(100, pct) };
        } else {
          var pct = Math.round(50 + (Math.abs(sum) / 45) * 50);
          return { primary: negLetter, secondary: posLetter, percent: Math.min(100, pct) };
        }
      }

      var resEI = calcDim(sumEI, 'E', 'I');
      var resSN = calcDim(sumSN, 'N', 'S');
      var resTF = calcDim(sumTF, 'F', 'T');
      var resJP = calcDim(sumJP, 'P', 'J');

      var finalType = resEI.primary + resSN.primary + resTF.primary + resJP.primary;
      currentResultType = finalType;

      stageAnalyzing.style.display = 'none';
      showResultDashboard({
        code: finalType,
        percentages: { EI: resEI, SN: resSN, TF: resTF, JP: resJP }
      });
    }, 2400);
  }

