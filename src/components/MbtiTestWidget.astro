            : '사고(' + tPct + '%)와 감정(' + fPct + '%)이 50:50에 가깝게 조화를 이루는 <strong>상황적 양면 공감형 (하이브리드)</strong>입니다! 당신은 피도 눈물도 없는 냉혈한도, 감정에 휘둘려 일을 망치는 사람도 아닙니다. <strong>공적인 업무나 문제 해결 시에는 팩트와 논리(T)로 명확하게 결단하지만, 인간관계나 누군가 위로를 구할 때는 따뜻한 감정(F)으로 깊이 공감합니다.</strong> 상황과 맥락에 따라 T와 F가 자연스럽게 전환되어 주변인들로부터 "일할 때는 똑 부러지고 예리한데, 사석에서는 따뜻하고 배려심 넘친다"는 높은 신뢰를 받습니다.';
        } else if (isModerate) {
          desc = isEn
            ? 'While anchored in ' + (primary === 'T' ? 'objective principles (T)' : 'human empathy and core values (F)') + ' (' + percent + '%), you maturely factor the impact on people and circumstances into your choices.'
            : (primary === 'T' ? '논리적 타당성과 원칙(T)' : '사람의 마음과 정서적 조화(F)') + '(' + percent + '%)을 우선시하되, ' + (primary === 'T' ? '상대방의 감정적 상태와 관계의 지속성도 신중히 배려합니다' : '현실적인 효율성과 인과관계도 함께 고려하는 균형감을 보입니다') + '.';
        } else {
          desc = isEn
            ? 'Powerful ' + (primary === 'T' ? 'Thinking' : 'Feeling') + ' preference (' + percent + '%). In any dilemma, you anchor your choices on ' + (primary === 'T' ? 'objective truth, causal logic, and unbiased merit, regardless of emotional pressure' : 'compassion, interpersonal harmony, and profound emotional authenticity, refusing cold expediency') + '.'
            : (primary === 'T' ? '사고(T)' : '감정(F)') + ' 성향(' + percent + '%)이 매우 확고합니다. 어떤 상황에서도 ' + (primary === 'T' ? '사적인 정이나 감정적 호소에 흔들리지 않고 오직 진실과 원칙, 효율성만을 기준으로 칼 같은 결단을 내립니다' : '숫자나 냉정한 규칙보다 사람의 마음과 가치, 관계의 온기를 절대적으로 소중히 여기며 타인의 아픔에 진심으로 반응합니다') + '.';
        }
      } else if (dimKey === 'JP') {
        var jPct = primary === 'J' ? percent : (100 - percent);
        var pPct = 100 - jPct;
