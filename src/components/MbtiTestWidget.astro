          desc = isEn
            ? 'Uncompromising ' + (primary === 'J' ? 'Judging' : 'Perceiving') + ' orientation (' + percent + '%). You thrive at your highest potential when ' + (primary === 'J' ? 'everything is neatly organized, scheduled, and systematically executed according to plan' : 'all possibilities remain open, giving you maximum freedom to improvise and strike spontaneously in the flow of the moment') + '.'
            : (primary === 'J' ? '판단(J)' : '인식(P)') + ' 성향(' + percent + '%)이 절대적입니다. 일상을 살아갈 때 ' + (primary === 'J' ? '예측 불가능한 무질서를 극도로 기피하며, 모든 일정과 단계가 명확하게 정돈되고 통제될 때 최고의 심리적 안정감을 누립니다' : '엄격한 규칙이나 닫힌 일정에 갇히는 것을 극도로 답답해하며, 자유로운 탐색과 닥쳐오는 순간의 직관적 몰입에서 최고의 잠재력이 폭발합니다') + '.';
        }
      }

      return {
        strengthLabel: strengthLabel,
        strengthIcon: strengthIcon,
        isBalanced: isBalanced,
        desc: desc
      };
    }

    function updateDimensionUI(dimKey, primary, percent, leftLetter, rightLetter, leftName, rightName) {
      var isLeft = primary === leftLetter;
      var leftVal = isLeft ? percent : (100 - percent);
      var rightVal = 100 - leftVal;

      var sideLeft = document.getElementById('dim-side-' + leftLetter.toLowerCase());
      var sideRight = document.getElementById('dim-side-' + rightLetter.toLowerCase());
      var pctLeft = document.getElementById('dim-pct-' + leftLetter.toLowerCase());
      var pctRight = document.getElementById('dim-pct-' + rightLetter.toLowerCase());
      var fillL = document.getElementById('dim-fill-' + dimKey.toLowerCase() + '-left');
      var fillR = document.getElementById('dim-fill-' + dimKey.toLowerCase() + '-right');
      var badge = document.getElementById('dim-badge-' + dimKey.toLowerCase());
      var descBox = document.getElementById('dim-desc-' + dimKey.toLowerCase());

      if (pctLeft) pctLeft.textContent = leftVal + '%';
      if (pctRight) pctRight.textContent = rightVal + '%';
      if (fillL) fillL.style.width = leftVal + '%';
      if (fillR) fillR.style.width = rightVal + '%';

      if (sideLeft) {
        if (isLeft) sideLeft.classList.add('dominant');
        else sideLeft.classList.remove('dominant');
      }
      if (sideRight) {
        if (!isLeft) sideRight.classList.add('dominant');
        else sideRight.classList.remove('dominant');
      }

      var info = getDimDetail(dimKey, primary, percent, isEn);
      var primaryName = isLeft ? leftName : rightName;
      if (badge) {
        badge.textContent = info.strengthIcon + ' ' + percent + '% ' + primaryName + ' (' + info.strengthLabel + ')';
        if (info.isBalanced) {
          badge.classList.add('badge-balanced');
        } else {
          badge.classList.remove('badge-balanced');
        }
      }

      if (descBox) {
        descBox.innerHTML = '<div class="sit-desc-header"><span class="sit-tag">💡 ' + (isEn ? 'Situational Behavior Insight' : '상황별 행동 양식 및 유연성 분석') + '</span></div><p class="sit-desc-text">' + info.desc + '</p>';
      }
    }

    updateDimensionUI('EI', ei.primary, ei.percent, 'E', 'I', isEn ? 'Extravert' : '외향', isEn ? 'Introvert' : '내향');
    updateDimensionUI('SN', sn.primary, sn.percent, 'S', 'N', isEn ? 'Sensing' : '감각', isEn ? 'Intuition' : '직관');
    updateDimensionUI('TF', tf.primary, tf.percent, 'T', 'F', isEn ? 'Thinking' : '사고', isEn ? 'Feeling' : '감정');
    updateDimensionUI('JP', jp.primary, jp.percent, 'J', 'P', isEn ? 'Judging' : '판단', isEn ? 'Perceiving' : '인식');

    // Section 1: Overview & Figures
    var overP = document.getElementById('res-overview-p');
    if (overP) overP.textContent = (isEn ? p.overviewEn : p.overviewKo) || '';
    var figList = document.getElementById('res-figures-list');
    if (figList) {
      figList.innerHTML = '';
      (p.famousFigures || []).forEach(function(fig) {
        var item = document.createElement('span');
        item.className = 'figure-pill';
        item.textContent = fig;
        figList.appendChild(item);
      });
    }

    // Section 2: Cognitive functions
    var c = p.cognitiveFunctions || {};
    if (c.dominant) {
      var domCode = document.getElementById('cog-dom-code');
      if (domCode) domCode.textContent = c.dominant.code || '';
      var domName = document.getElementById('cog-dom-name');
      if (domName) domName.textContent = (isEn ? c.dominant.nameEn : c.dominant.nameKo) || '';
      var domDesc = document.getElementById('cog-dom-desc');
      if (domDesc) domDesc.textContent = (isEn ? c.dominant.descEn : c.dominant.descKo) || '';
    }
    if (c.auxiliary) {
      var auxCode = document.getElementById('cog-aux-code');
      if (auxCode) auxCode.textContent = c.auxiliary.code || '';
      var auxName = document.getElementById('cog-aux-name');
      if (auxName) auxName.textContent = (isEn ? c.auxiliary.nameEn : c.auxiliary.nameKo) || '';
      var auxDesc = document.getElementById('cog-aux-desc');
      if (auxDesc) auxDesc.textContent = (isEn ? c.auxiliary.descEn : c.auxiliary.descKo) || '';
    }
    if (c.tertiary) {
      var tertCode = document.getElementById('cog-tert-code');
      if (tertCode) tertCode.textContent = c.tertiary.code || '';
      var tertName = document.getElementById('cog-tert-name');
      if (tertName) tertName.textContent = (isEn ? c.tertiary.nameEn : c.tertiary.nameKo) || '';
      var tertDesc = document.getElementById('cog-tert-desc');
      if (tertDesc) tertDesc.textContent = (isEn ? c.tertiary.descEn : c.tertiary.descKo) || '';
    }
    if (c.inferior) {
      var infCode = document.getElementById('cog-inf-code');
      if (infCode) infCode.textContent = c.inferior.code || '';
      var infName = document.getElementById('cog-inf-name');
      if (infName) infName.textContent = (isEn ? c.inferior.nameEn : c.inferior.nameKo) || '';
      var infDesc = document.getElementById('cog-inf-desc');
      if (infDesc) infDesc.textContent = (isEn ? c.inferior.descEn : c.inferior.descKo) || '';
    }

    // Section 3: Strengths & Weaknesses
    var strList = document.getElementById('res-strengths-list');
    if (strList) {
      strList.innerHTML = '';
      var sArr = isEn ? (p.strengthsEn || []) : (p.strengthsKo || []);
      sArr.forEach(function(s) {
        var li = document.createElement('li');
        li.textContent = s;
        strList.appendChild(li);
      });
    }

    var weakList = document.getElementById('res-weaknesses-list');
    if (weakList) {
      weakList.innerHTML = '';
      var wArr = isEn ? (p.weaknessesEn || []) : (p.weaknessesKo || []);
      wArr.forEach(function(w) {
        var li = document.createElement('li');
        li.textContent = w;
        weakList.appendChild(li);
      });
    }

    // Section 4: Stress Loop & Growth
    var stressBox = document.getElementById('res-stress-box');
    if (stressBox) stressBox.textContent = (isEn ? p.stressLoopEn : p.stressLoopKo) || '';
    var growthBox = document.getElementById('res-growth-text');
    if (growthBox) growthBox.textContent = (isEn ? p.growthAdviceEn : p.growthAdviceKo) || '';

    // Section 5: Career
    var cEnv = document.getElementById('res-career-env');
    if (cEnv) cEnv.textContent = (isEn ? p.career?.bestEnvironmentEn : p.career?.bestEnvironmentKo) || '';
    var jobsGrid = document.getElementById('res-jobs-grid');
    if (jobsGrid) {
      jobsGrid.innerHTML = '';
      (p.career?.recommendedCareers || []).forEach(function(job) {
        var tag = document.createElement('span');
        tag.className = 'job-tag';
        tag.textContent = '💼 ' + job;
        jobsGrid.appendChild(tag);
      });
    }
    var cWork = document.getElementById('res-career-workstyle');
    if (cWork) cWork.textContent = (isEn ? p.career?.workStyleEn : p.career?.workStyleKo) || '';

    // Section 6: Relationship & Compatibility
    var lStyle = document.getElementById('res-love-style');
    if (lStyle) lStyle.textContent = (isEn ? p.relationship?.loveStyleEn : p.relationship?.loveStyleKo) || '';
    
    var bestMatchesPills = document.getElementById('res-best-matches-pills');
    if (bestMatchesPills) {
      bestMatchesPills.innerHTML = '';
      (p.relationship?.bestMatches || []).forEach(function(m) {
        var pill = document.createElement('span');
        pill.className = 'match-pill golden';
        pill.textContent = '💖 ' + m;
        bestMatchesPills.appendChild(pill);
      });
    }
    var bDesc = document.getElementById('res-best-match-desc');
    if (bDesc) bDesc.textContent = (isEn ? p.relationship?.bestMatchReasonEn : p.relationship?.bestMatchReasonKo) || '';

    var chalMatchesPills = document.getElementById('res-challenging-matches-pills');
    if (chalMatchesPills) {
      chalMatchesPills.innerHTML = '';
      (p.relationship?.challengingMatches || []).forEach(function(m) {
        var pill = document.createElement('span');
        pill.className = 'match-pill challenging';
        pill.textContent = '💡 ' + m;
        chalMatchesPills.appendChild(pill);
      });
    }
    var cDesc = document.getElementById('res-challenging-match-desc');
    if (cDesc) cDesc.textContent = (isEn ? p.relationship?.challengingMatchReasonEn : p.relationship?.challengingMatchReasonKo) || '';

    // Interactive compatibility checker
    var compatSelect = document.getElementById('compat-target-select');
    if (compatSelect) {
      var defaultCompare = (p.relationship?.bestMatches && p.relationship.bestMatches[0]) || 'ENFP';
      compatSelect.value = defaultCompare;
      updateCompatibilityView(p.code, compatSelect.value);
      compatSelect.onchange = function() {
        updateCompatibilityView(p.code, this.value);
      };
    }

    // Section 7: Streamer style
    var sPersona = document.getElementById('res-streamer-persona');
    if (sPersona) sPersona.textContent = (isEn ? p.streamerStyle?.personaEn : p.streamerStyle?.personaKo) || '';
    var sChat = document.getElementById('res-streamer-chat');
    if (sChat) sChat.textContent = (isEn ? p.streamerStyle?.viewerDynamicEn : p.streamerStyle?.viewerDynamicKo) || '';
    var gamesList = document.getElementById('res-streamer-games');
    if (gamesList) {
      gamesList.innerHTML = '';
      (p.streamerStyle?.recommendedContent || []).forEach(function(g) {
        var tag = document.createElement('span');
        tag.className = 'game-tag';
        tag.textContent = '🕹️ ' + g;
        gamesList.appendChild(tag);
      });
    }

    // Update browser URL query without reload for direct shareability
    var shareUrl = new URL(window.location.href);
    shareUrl.searchParams.set('type', resultData.code);
    shareUrl.searchParams.set('ei', ei.percent);
    shareUrl.searchParams.set('sn', sn.percent);
    shareUrl.searchParams.set('tf', tf.percent);
    shareUrl.searchParams.set('jp', jp.percent);
    window.history.replaceState({}, '', shareUrl.toString());

    window.scrollTo({ top: stageResult.offsetTop - 30, behavior: 'smooth' });
  }

  // 7. Compatibility Calculator Helper (Full Jungian Dynamics)
  function updateCompatibilityView(type1, type2) {
    var goldenPairs = {
      INTJ: ['ENFP', 'ENTP'], INTP: ['ENTJ', 'ENFJ'], ENTJ: ['INTP', 'INFP'], ENTP: ['INFJ', 'INTJ'],
      INFJ: ['ENTP', 'ENFP'], INFP: ['ENFJ', 'ENTJ'], ENFJ: ['INFP', 'ISFP'], ENFP: ['INTJ', 'INFJ'],
      ISTJ: ['ESFP', 'ESTP'], ISFJ: ['ESTP', 'ESFP'], ESTJ: ['ISFP', 'ISTP'], ESFJ: ['ISTP', 'ISFP'],
      ISTP: ['ESFJ', 'ESTJ'], ISFP: ['ESTJ', 'ESFJ'], ESTP: ['ISFJ', 'ISTJ'], ESFP: ['ISTJ', 'ISFJ']
    };

    var t1 = (type1 || 'INTJ').toUpperCase();
    var t2 = (type2 || 'ENFP').toUpperCase();

    var score = 72;
    var badge = '🌿 ' + (isEn ? 'Harmonious Balance (Solid Foundation)' : '조화로운 보완 관계 (Harmonious Balance)');
    var desc = isEn 
      ? 'A healthy balance of similarities and differences. With honest communication, you offer complementary perspectives that broaden each other’s life experience and wisdom.'
      : '서로 다른 장점과 관점을 지니고 있어 배울 점이 많은 관계입니다. 일상적인 대화와 솔직한 감정 교류를 통해 차이를 좁혀나간다면 세상 어떤 인연보다도 깊고 풍요로운 유대를 맺을 수 있습니다.';

    if (t1 === t2) {
      score = 85;
      badge = '🪞 ' + (isEn ? 'Soul Mirror (High Resonance)' : '영혼의 거울 (Soul Mirror)');
      desc = isEn
        ? 'You share identical cognitive wiring, enabling deep mutual understanding with zero explanation. However, sharing identical blind spots means stagnation or negative loops can amplify unless fresh external perspectives are welcomed.'
        : '말하지 않아도 상대방의 생각과 기분을 훤히 꿰뚫어 볼 수 있는 깊은 공감대를 형성합니다. 다만 단점과 맹점까지 똑같아서 한 번 갈등이나 침체에 빠지면 함께 헤어나오기 힘들 수 있으므로 외부의 자극이 필요합니다.';
    } else if (goldenPairs[t1]?.includes(t2)) {
      score = 98;
      badge = '💖 ' + (isEn ? 'Ideal Match (Transcendent Chemistry)' : '천생연분 환상의 궁합 (Ideal Match)');
      desc = isEn
        ? 'An exceptional psychological pairing where each partner’s primary strengths effortlessly cover the other’s blind spots. Conversations spark spontaneous fireworks and mutual growth feels exhilarating and effortless.'
        : '서로의 강점이 상대방의 아킬레스건을 자연스럽게 보완해 주는 완벽한 파트너십입니다. 대화가 끊이지 않으며, 함께 있을 때 서로가 더 지혜롭고 매력적인 사람으로 성장하도록 영감을 줍니다.';
    } else {
      var isSameIntuition = (t1[1] === t2[1]);
      var isSameThinking = (t1[2] === t2[2]);
      var isOppositeIntrovert = (t1[0] !== t2[0]);

      if (isSameIntuition && isOppositeIntrovert) {
        score = 88;
        badge = '✨ ' + (isEn ? 'Great Synergy (Strong Alignment)' : '매우 좋은 인연 (Great Synergy)');
        desc = isEn
          ? 'Sharing the same perceptual wavelength allows intuitive alignment on core values and humor. Extrovert-introvert complementarity ensures both adventure and quiet emotional restoration.'
          : '세상을 바라보는 렌즈(인식 기능)가 같아 공통의 관심사와 가치관을 쉽게 공유합니다. 한쪽의 외향성이 다른 쪽의 내향적 안식처와 조화를 이루어 오랫동안 편안하게 지속되는 관계입니다.';
      } else if (isSameIntuition && isSameThinking) {
        score = 80;
        badge = '🤝 ' + (isEn ? 'Intellectual Allies (High Respect)' : '지적 파트너 (Intellectual Allies)');
        desc = isEn
          ? 'Similar cognitive processing styles make you brilliant co-creators and strategic comrades. As long as intellectual rivalries are kept playful, you form an unshakeable team.'
          : '목표와 사고방식이 비슷하여 비즈니스, 스터디, 창작 프로젝트를 함께할 때 최상의 추진력을 발휘합니다. 사소한 자존심 대결만 주의한다면 평생을 함께할 든든한 동지가 됩니다.';
      } else if (!isSameIntuition && !isSameThinking && !isOppositeIntrovert) {
        score = 55;
        badge = '💡 ' + (isEn ? 'Opposites Attract (Requires Curiosity)' : '서로 다른 매력 (Opposites Attract)');
        desc = isEn
          ? 'Operating on completely different psychological frequencies, you offer each other views of an alien universe. Mutual respect and patient translation of motives are vital for lasting harmony.'
          : '세상을 인식하고 판단하는 방식이 완전히 달라 처음에는 신기하고 호기심이 발동합니다. 다만 깊은 관계로 발전하려면 상대방의 방식이 "틀린 것"이 아니라 "다른 것"임을 인정하는 열린 마음이 필수적입니다.';
      }
    }

    var badgeTag = document.getElementById('compat-badge-tag');
    if (badgeTag) badgeTag.textContent = badge;
    var scoreNum = document.getElementById('compat-score-num');
    if (scoreNum) scoreNum.textContent = score;
    var expl = document.getElementById('compat-explanation');
    if (expl) expl.textContent = desc;
  }

  // 8. Sticky Quick-Jump Navigation & Smooth Scrolling
  var jumpChips = document.querySelectorAll('.jump-chip');
  jumpChips.forEach(function(chip) {
    chip.addEventListener('click', function() {
      var targetId = this.getAttribute('data-target');
      var target = document.getElementById(targetId);
      if (target) {
        var offset = 80;
        var bodyRect = document.body.getBoundingClientRect().top;
        var elementRect = target.getBoundingClientRect().top;
        var offsetPosition = (elementRect - bodyRect) - offset;
        window.scrollTo({ top: offsetPosition, behavior: 'smooth' });
      }
    });
  });

  // Scroll Spy for TOC Chips
  window.addEventListener('scroll', function() {
    if (stageResult.style.display === 'none') return;
    var sections = document.querySelectorAll('.result-report-section');
    var scrollPos = window.scrollY + 140;
    sections.forEach(function(sec) {
      var top = sec.offsetTop;
      var height = sec.offsetHeight;
      var id = sec.getAttribute('id');
      if (scrollPos >= top && scrollPos < top + height) {
        jumpChips.forEach(function(c) {
          if (c.getAttribute('data-target') === id) {
            c.classList.add('active');
          } else {
            c.classList.remove('active');
          }
        });
      }
    });
  });

  // 9. Share Link Buttons
  function copyLinkAction() {
    if (navigator.clipboard) {
      navigator.clipboard.writeText(window.location.href).then(function() {
        alert(isEn ? 'Link copied to clipboard! Share it with friends or stream chat.' : '결과 링크가 클립보드에 복사되었습니다! 친구나 방송 채팅창에 공유해 보세요.');
      });
    } else {
      alert(window.location.href);
    }
  }

  var btnShare = document.getElementById('btn-share-result');
  if (btnShare) btnShare.addEventListener('click', copyLinkAction);

  var btnShareBottom = document.getElementById('btn-share-bottom');
  if (btnShareBottom) btnShareBottom.addEventListener('click', copyLinkAction);

  // 10. Retake Test Buttons
  function retakeAction() {
    answers = new Array(questions.length).fill(null);
    stageResult.style.display = 'none';
    stageIntro.style.display = 'none';
    stageRunner.style.display = 'block';
    renderQuestion(0);
    window.scrollTo({ top: stageRunner.offsetTop - 40, behavior: 'smooth' });
  }

  var btnRetake = document.getElementById('btn-retake-test');
  if (btnRetake) btnRetake.addEventListener('click', retakeAction);

  var btnRetakeBottom = document.getElementById('btn-retake-bottom');
  if (btnRetakeBottom) btnRetakeBottom.addEventListener('click', retakeAction);

  // 11. Scroll to Top Button
  var btnScrollTop = document.getElementById('btn-scroll-top');
  if (btnScrollTop) {
    btnScrollTop.addEventListener('click', function() {
      window.scrollTo({ top: stageResult.offsetTop - 20, behavior: 'smooth' });
    });
  }

})();
</script>

<style>
  .mbti-widget-root {
    width: 100%;
    max-width: 1100px;
    margin: 0 auto;
    color: #f1f5f9;
    font-family: -apple-system, BlinkMacSystemFont, 'Pretendard', 'Segoe UI', Roboto, sans-serif;
  }

  /* STAGE 1: INTRO */
  .mbti-stage-intro {
    position: relative;
    padding: 60px 24px 70px;
    text-align: center;
    overflow: hidden;
  }

  .intro-backdrop {
    position: absolute;
    top: -30%;
    left: 50%;
    transform: translateX(-50%);
    width: 800px;
    height: 500px;
    background: radial-gradient(circle, rgba(99, 102, 241, 0.25) 0%, rgba(236, 72, 153, 0.12) 45%, transparent 75%);
    filter: blur(70px);
    pointer-events: none;
  }

  .intro-content {
    position: relative;
    z-index: 1;
    max-width: 880px;
    margin: 0 auto;
  }

  .intro-badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: rgba(99, 102, 241, 0.15);
    border: 1px solid rgba(99, 102, 241, 0.35);
    color: #c7d2fe;
    font-size: 0.85rem;
    font-weight: 700;
    padding: 6px 18px;
    border-radius: 9999px;
    margin-bottom: 22px;
  }

  .intro-title {
    font-size: 3rem;
    font-weight: 900;
    letter-spacing: -0.03em;
    margin: 0 0 20px;
    background: linear-gradient(135deg, #ffffff 30%, #a5b4fc 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .intro-desc {
    font-size: 1.15rem;
    color: #94a3b8;
    line-height: 1.7;
    margin: 0 0 40px;
  }

  .intro-features-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 16px;
    margin-bottom: 45px;
    text-align: left;
  }

  .feature-item {
    display: flex;
    align-items: flex-start;
    gap: 12px;
    background: rgba(30, 41, 59, 0.6);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 14px;
    padding: 18px;
  }

  .feat-icon {
    font-size: 1.6rem;
    flex-shrink: 0;
  }

  .feat-text strong {
    display: block;
    color: #f8fafc;
    font-size: 0.95rem;
    margin-bottom: 4px;
  }

  .feat-text span {
    display: block;
    color: #94a3b8;
    font-size: 0.82rem;
    line-height: 1.45;
  }

  .intro-cta-wrap {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 12px;
  }

  .btn-start-test {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    background: linear-gradient(135deg, #6366f1 0%, #a855f7 50%, #ec4899 100%);
    color: #ffffff;
    font-size: 1.2rem;
    font-weight: 800;
    padding: 18px 48px;
    border-radius: 16px;
    border: none;
    cursor: pointer;
    box-shadow: 0 10px 28px -6px rgba(99, 102, 241, 0.6);
    transition: transform 0.2s, box-shadow 0.2s;
  }

  .btn-start-test:hover {
    transform: translateY(-2px);
    box-shadow: 0 16px 36px -6px rgba(99, 102, 241, 0.8);
  }

  .time-estimate-note {
    font-size: 0.85rem;
    color: #64748b;
  }

  /* STAGE 2: TEST RUNNER */
  .mbti-stage-runner {
    padding: 20px 0 60px;
  }

  .runner-header {
    background: rgba(17, 24, 39, 0.95);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 16px;
    padding: 16px 22px;
    margin-bottom: 24px;
    backdrop-filter: blur(12px);
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.4);
  }

  .progress-meta {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 10px;
  }

  .progress-step-text {
    font-size: 1rem;
    font-weight: 800;
    color: #a5b4fc;
  }

  .current-facet-badge {
    font-size: 0.82rem;
    font-weight: 700;
    background: rgba(99, 102, 241, 0.15);
    border: 1px solid rgba(99, 102, 241, 0.3);
    color: #cbd5e1;
    padding: 4px 12px;
    border-radius: 999px;
  }

  .progress-track {
    width: 100%;
    height: 8px;
    background: rgba(255, 255, 255, 0.08);
    border-radius: 999px;
    overflow: hidden;
  }

  .progress-fill {
    height: 100%;
    background: linear-gradient(90deg, #6366f1, #ec4899);
    border-radius: 999px;
    transition: width 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .runner-controls-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-top: 10px;
  }

  .btn-toggle-grid {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    background: rgba(99, 102, 241, 0.15);
    border: 1px solid rgba(99, 102, 241, 0.35);
    color: #c7d2fe;
    font-size: 0.82rem;
    font-weight: 700;
    padding: 6px 14px;
    border-radius: 999px;
    cursor: pointer;
    transition: all 0.2s;
  }

  .btn-toggle-grid:hover {
    background: rgba(99, 102, 241, 0.28);
    color: #ffffff;
    border-color: rgba(99, 102, 241, 0.6);
  }

  .keyboard-tip-tag {
    font-size: 0.78rem;
    color: #64748b;
  }

  /* Return to Latest Question Bar */
  .return-latest-bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 12px;
    background: linear-gradient(135deg, rgba(99, 102, 241, 0.18) 0%, rgba(236, 72, 153, 0.14) 100%);
    border: 1px solid rgba(99, 102, 241, 0.4);
    border-radius: 14px;
    padding: 10px 16px;
    margin-bottom: 22px;
    animation: pulseGlow 2.5s infinite alternate;
  }

  @keyframes pulseGlow {
    0% { box-shadow: 0 0 0 rgba(99, 102, 241, 0); }
    100% { box-shadow: 0 0 16px rgba(99, 102, 241, 0.35); }
  }

  .return-bar-content {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .return-icon {
    font-size: 1.1rem;
  }

  .return-msg {
    font-size: 0.88rem;
    font-weight: 700;
    color: #cbd5e1;
  }

  .btn-return-latest {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    background: linear-gradient(135deg, #6366f1 0%, #a855f7 100%);
    border: none;
    color: #ffffff;
    font-size: 0.85rem;
    font-weight: 800;
    padding: 8px 16px;
    border-radius: 10px;
    cursor: pointer;
    box-shadow: 0 4px 12px rgba(99, 102, 241, 0.4);
    transition: transform 0.15s, box-shadow 0.15s;
    white-space: nowrap;
  }

  .btn-return-latest:hover {
    transform: translateY(-1px);
    box-shadow: 0 6px 16px rgba(99, 102, 241, 0.6);
  }

  /* Question Card */
  .question-deck-container {
    perspective: 1000px;
  }

  .question-card {
    background: #111422;
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 24px;
    padding: 48px 36px 40px;
    box-shadow: 0 20px 45px -15px rgba(0, 0, 0, 0.6), 0 0 0 1px rgba(99, 102, 241, 0.12);
  }

  .question-card-header {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 24px;
  }

  .q-number-pill {
    font-size: 0.85rem;
    font-weight: 900;
    color: #6366f1;
    background: rgba(99, 102, 241, 0.12);
    border: 1px solid rgba(99, 102, 241, 0.3);
    padding: 4px 12px;
    border-radius: 8px;
  }

  .q-dimension-pill {
    font-size: 0.85rem;
    color: #94a3b8;
    font-weight: 600;
  }

  .question-text {
    font-size: 1.7rem;
    font-weight: 800;
    color: #f8fafc;
    line-height: 1.5;
    margin: 0 0 48px;
    min-height: 80px;
  }

  /* Likert Scale UI */
  .likert-scale-wrap {
    background: rgba(17, 24, 39, 0.7);
    border: 1px solid rgba(255, 255, 255, 0.06);
    border-radius: 20px;
    padding: 24px 20px;
    margin-bottom: 40px;
  }

  .likert-labels-row {
    display: flex;
    justify-content: space-between;
    margin-bottom: 16px;
    font-size: 0.88rem;
    font-weight: 700;
  }

  .label-disagree { color: #f87171; }
  .label-neutral { color: #94a3b8; }
  .label-agree { color: #34d399; }

  .likert-buttons-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 10px;
  }

  .likert-btn {
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
    background: transparent;
    border: none;
    cursor: pointer;
    padding: 8px 4px;
    transition: transform 0.15s;
  }

  .likert-btn:hover {
    transform: scale(1.08);
  }

  .btn-circle {
    width: 44px;
    height: 44px;
    border-radius: 50%;
    border: 2px solid rgba(255, 255, 255, 0.2);
    background: rgba(255, 255, 255, 0.04);
    transition: all 0.2s;
  }

  /* Color themes by scale score */
  .btn-score-1 .btn-circle { width: 56px; height: 56px; border-color: #ef4444; background: rgba(239, 68, 68, 0.1); }
  .btn-score-2 .btn-circle { width: 48px; height: 48px; border-color: #f87171; background: rgba(248, 113, 113, 0.08); }
  .btn-score-3 .btn-circle { width: 42px; height: 42px; border-color: #fb923c; background: rgba(251, 146, 60, 0.08); }
  .btn-score-4 .btn-circle { width: 36px; height: 36px; border-color: #94a3b8; background: rgba(148, 163, 184, 0.06); }
  .btn-score-5 .btn-circle { width: 42px; height: 42px; border-color: #a7f3d0; background: rgba(52, 211, 153, 0.08); }
  .btn-score-6 .btn-circle { width: 48px; height: 48px; border-color: #34d399; background: rgba(52, 211, 153, 0.12); }
  .btn-score-7 .btn-circle { width: 56px; height: 56px; border-color: #10b981; background: rgba(16, 185, 129, 0.18); }

  /* Selected States */
  .btn-score-1.selected .btn-circle { background: #ef4444; box-shadow: 0 0 18px rgba(239, 68, 68, 0.7); }
  .btn-score-2.selected .btn-circle { background: #f87171; box-shadow: 0 0 16px rgba(248, 113, 113, 0.6); }
  .btn-score-3.selected .btn-circle { background: #fb923c; box-shadow: 0 0 14px rgba(251, 146, 60, 0.6); }
  .btn-score-4.selected .btn-circle { background: #94a3b8; box-shadow: 0 0 12px rgba(148, 163, 184, 0.6); }
  .btn-score-5.selected .btn-circle { background: #34d399; box-shadow: 0 0 14px rgba(52, 211, 153, 0.6); }
  .btn-score-6.selected .btn-circle { background: #10b981; box-shadow: 0 0 16px rgba(16, 185, 129, 0.7); }
  .btn-score-7.selected .btn-circle { background: #059669; box-shadow: 0 0 20px rgba(5, 150, 105, 0.8); }

  .btn-tag {
    font-size: 0.72rem;
    color: #64748b;
    text-align: center;
  }

  .likert-btn.selected .btn-tag {
    color: #f8fafc;
    font-weight: 800;
  }

  /* Nav Row */
  .question-nav-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 12px;
  }

  .nav-center-group {
    display: flex;
    align-items: center;
    gap: 8px;
    flex-wrap: wrap;
    justify-content: center;
  }

  .btn-open-matrix {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: rgba(30, 41, 59, 0.7);
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 12px;
    padding: 8px 14px;
    color: #cbd5e1;
    font-size: 0.85rem;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.2s;
  }

  .btn-open-matrix:hover {
    background: rgba(45, 55, 75, 0.85);
    color: #ffffff;
    border-color: rgba(99, 102, 241, 0.5);
  }

  .matrix-pill-tag {
    font-size: 0.75rem;
    background: rgba(99, 102, 241, 0.25);
    color: #a5b4fc;
    padding: 2px 8px;
    border-radius: 6px;
    font-weight: 700;
  }

  .btn-nav-return-pill {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    background: linear-gradient(135deg, #4f46e5 0%, #7c3aed 100%);
    color: #ffffff;
    border: none;
    font-size: 0.82rem;
    font-weight: 800;
    padding: 8px 14px;
    border-radius: 12px;
    cursor: pointer;
    box-shadow: 0 4px 12px rgba(79, 70, 229, 0.4);
    transition: all 0.2s;
    white-space: nowrap;
  }

  .btn-nav-return-pill:hover {
    transform: translateY(-1px);
    box-shadow: 0 6px 16px rgba(79, 70, 229, 0.6);
  }

  .btn-nav-prev, .btn-nav-next {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: rgba(30, 41, 59, 0.8);
    border: 1px solid rgba(255, 255, 255, 0.1);
    color: #e2e8f0;
    font-size: 0.95rem;
    font-weight: 700;
    padding: 12px 24px;
    border-radius: 12px;
    cursor: pointer;
    transition: all 0.2s;
    white-space: nowrap;
  }

  .btn-nav-prev:disabled {
    opacity: 0.3;
    cursor: not-allowed;
  }

  .btn-nav-next.finish-mode {
    background: linear-gradient(135deg, #10b981 0%, #3b82f6 100%);
    color: #ffffff;
    box-shadow: 0 6px 18px rgba(16, 185, 129, 0.4);
  }

  .answered-counter {
    font-size: 0.88rem;
    color: #94a3b8;
    font-weight: 600;
  }

  /* Question Matrix / Navigator Modal Drawer */
  .question-matrix-modal {
    position: fixed;
    top: 0;
    left: 0;
    width: 100vw;
    height: 100vh;
    z-index: 1000;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 20px;
  }

  .matrix-modal-backdrop {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: rgba(5, 8, 16, 0.85);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
  }

  .matrix-modal-card {
    position: relative;
    z-index: 1;
    background: #0f1424;
    border: 1px solid rgba(99, 102, 241, 0.35);
    border-radius: 24px;
    max-width: 820px;
    width: 100%;
    max-height: 85vh;
    display: flex;
    flex-direction: column;
    box-shadow: 0 25px 60px rgba(0, 0, 0, 0.8);
    padding: 28px 24px;
    overflow: hidden;
  }

  .matrix-modal-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    margin-bottom: 16px;
    gap: 12px;
  }

  .matrix-title-group h3 {
    font-size: 1.25rem;
    font-weight: 800;
    color: #f8fafc;
    margin: 0 0 4px;
  }

  .matrix-title-group p {
    font-size: 0.85rem;
    color: #94a3b8;
    margin: 0;
  }

  .btn-close-matrix {
    background: rgba(255, 255, 255, 0.08);
    border: none;
    color: #94a3b8;
    font-size: 1.1rem;
    width: 34px;
    height: 34px;
    border-radius: 50%;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all 0.2s;
    flex-shrink: 0;
  }

  .btn-close-matrix:hover {
    background: rgba(239, 68, 68, 0.2);
    color: #f87171;
  }

  .matrix-legend-row {
    display: flex;
    gap: 18px;
    align-items: center;
    margin-bottom: 14px;
    font-size: 0.8rem;
    color: #cbd5e1;
    flex-wrap: wrap;
  }

  .legend-item {
    display: flex;
    align-items: center;
    gap: 6px;
  }

  .legend-dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
  }

  .legend-dot.answered { background: #10b981; }
  .legend-dot.current { background: #818cf8; box-shadow: 0 0 6px #818cf8; }
  .legend-dot.unanswered { background: #475569; }

  .matrix-farthest-action {
    margin-bottom: 14px;
  }

  .btn-matrix-return-latest {
    width: 100%;
    background: linear-gradient(135deg, rgba(99, 102, 241, 0.2) 0%, rgba(236, 72, 153, 0.2) 100%);
    border: 1px solid rgba(99, 102, 241, 0.4);
    color: #ffffff;
    font-size: 0.88rem;
    font-weight: 800;
    padding: 10px 18px;
    border-radius: 12px;
    cursor: pointer;
    transition: all 0.2s;
  }

  .btn-matrix-return-latest:hover {
    background: linear-gradient(135deg, rgba(99, 102, 241, 0.35) 0%, rgba(236, 72, 153, 0.35) 100%);
    border-color: #818cf8;
  }

  .matrix-grid-scroll {
    overflow-y: auto;
    display: flex;
    flex-direction: column;
    gap: 16px;
    padding-right: 4px;
  }

  .matrix-dimension-group {
    background: rgba(15, 23, 42, 0.5);
    border: 1px solid rgba(255, 255, 255, 0.05);
    border-radius: 14px;
    padding: 14px 16px;
  }

  .dim-group-title {
    display: block;
    font-size: 0.8rem;
    font-weight: 700;
    color: #a5b4fc;
    margin-bottom: 10px;
  }

  .matrix-chips-row {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(44px, 1fr));
    gap: 8px;
  }

  :global(.q-chip-btn) {
    aspect-ratio: 1;
    border-radius: 10px;
    border: 1px solid rgba(255, 255, 255, 0.08);
    background: rgba(255, 255, 255, 0.03);
    color: #94a3b8;
    font-size: 0.82rem;
    font-weight: 700;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: all 0.15s ease;
  }

  :global(.q-chip-btn:hover) {
    transform: scale(1.08);
    border-color: rgba(99, 102, 241, 0.5);
    color: #ffffff;
  }

  :global(.q-chip-btn.answered) {
    background: rgba(16, 185, 129, 0.15);
    border-color: rgba(16, 185, 129, 0.4);
    color: #6ee7b7;
  }

  :global(.q-chip-btn.current) {
    background: rgba(99, 102, 241, 0.35);
    border: 2px solid #818cf8;
    color: #ffffff;
    box-shadow: 0 0 12px rgba(99, 102, 241, 0.6);
    font-weight: 900;
  }

  .answered-counter {
    font-size: 0.88rem;
    color: #94a3b8;
    font-weight: 600;
  }

  /* STAGE 3: ANALYZING */
  .mbti-stage-analyzing {
    display: flex;
    justify-content: center;
    align-items: center;
    padding: 100px 20px;
  }

  .analyzing-box {
    background: #111422;
    border: 1px solid rgba(99, 102, 241, 0.3);
    border-radius: 24px;
    padding: 50px 40px;
    text-align: center;
    max-width: 540px;
    box-shadow: 0 20px 50px rgba(0, 0, 0, 0.7);
  }

  .analyzing-spinner {
    position: relative;
    width: 90px;
    height: 90px;
    margin: 0 auto 30px;
  }

  .spinner-ring {
    position: absolute;
    inset: 0;
    border-radius: 50%;
    border: 4px solid rgba(99, 102, 241, 0.15);
    border-top-color: #6366f1;
    animation: spin 1.2s cubic-bezier(0.68, -0.55, 0.27, 1.55) infinite;
  }

  .spinner-core {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 2.2rem;
  }

  @keyframes spin {
    to { transform: rotate(360deg); }
  }

  .analyzing-title {
    font-size: 1.5rem;
    font-weight: 800;
    color: #f8fafc;
    margin: 0 0 24px;
  }

  .analyzing-steps {
    display: flex;
    flex-direction: column;
    gap: 12px;
    text-align: left;
  }

  .step-item {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 0.92rem;
    color: #64748b;
  }

  .step-item .check {
    opacity: 0.2;
    font-weight: 900;
  }

  .step-item.done {
    color: #cbd5e1;
  }
  .step-item.done .check {
    color: #10b981;
    opacity: 1;
  }

  /* STAGE 4: DETAILED RESULT DASHBOARD */
  .result-hero-card {
    position: relative;
    background: linear-gradient(135deg, rgba(26, 32, 54, 0.95) 0%, rgba(35, 25, 66, 0.85) 100%);
    border: 1px solid rgba(99, 102, 241, 0.35);
    border-radius: 28px;
    padding: 44px 36px;
    margin-bottom: 32px;
    overflow: hidden;
    box-shadow: 0 20px 40px -15px rgba(0, 0, 0, 0.6), 0 0 0 1px rgba(99, 102, 241, 0.15);
  }

  .result-hero-backdrop {
    position: absolute;
    top: -50%;
    right: -20%;
    width: 600px;
    height: 400px;
    background: radial-gradient(circle, rgba(99, 102, 241, 0.3) 0%, transparent 70%);
    filter: blur(60px);
    pointer-events: none;
  }

  .result-header-row {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    flex-wrap: wrap;
    gap: 20px;
    margin-bottom: 20px;
  }

  .result-badge-pill {
    display: inline-block;
    background: rgba(99, 102, 241, 0.2);
    border: 1px solid rgba(99, 102, 241, 0.4);
    color: #c7d2fe;
    font-size: 0.85rem;
    font-weight: 700;
    padding: 5px 16px;
    border-radius: 9999px;
    margin-bottom: 12px;
  }

  .result-type-code {
    font-size: 4.2rem;
    font-weight: 900;
    line-height: 1;
    letter-spacing: -0.04em;
    margin: 0 0 8px;
    background: linear-gradient(135deg, #ffffff 30%, #a5b4fc 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .result-type-name {
    font-size: 1.8rem;
    font-weight: 800;
    color: #f8fafc;
    margin: 0;
  }

  .result-actions-top {
    display: flex;
    gap: 12px;
  }

  .btn-share-result, .btn-retake-test {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 0.92rem;
    font-weight: 800;
    padding: 12px 22px;
    border-radius: 12px;
    border: none;
    cursor: pointer;
    transition: transform 0.15s, box-shadow 0.15s;
  }

  .btn-share-result {
    background: linear-gradient(135deg, #6366f1 0%, #a855f7 100%);
    color: #ffffff;
    box-shadow: 0 6px 18px rgba(99, 102, 241, 0.5);
  }

  .btn-retake-test {
    background: rgba(30, 41, 59, 0.8);
    border: 1px solid rgba(255, 255, 255, 0.12);
    color: #e2e8f0;
  }

  .result-keywords-row {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-bottom: 20px;
  }

  :global(.keyword-pill) {
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid rgba(255, 255, 255, 0.08);
    color: #93c5fd;
    font-size: 0.82rem;
    font-weight: 700;
    padding: 4px 12px;
    border-radius: 8px;
  }

  .result-motto {
    font-size: 1.15rem;
    font-style: italic;
    color: #cbd5e1;
    margin: 0 0 36px;
    padding-left: 18px;
    border-left: 4px solid #6366f1;
    line-height: 1.6;
  }

  /* Dimension Breakdown Meters & Situational Flexibility */
  .dimensions-breakdown-card {
    background: rgba(15, 23, 42, 0.75);
    border: 1px solid rgba(99, 102, 241, 0.28);
    border-radius: 22px;
    padding: 28px 24px;
    box-shadow: 0 16px 40px rgba(0, 0, 0, 0.4);
  }

  .dimensions-header-group {
    margin-bottom: 22px;
  }

  .dimensions-title {
    font-size: 1.25rem;
    font-weight: 800;
    color: #f8fafc;
    margin: 0 0 8px;
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .dimensions-subtitle {
    font-size: 0.88rem;
    color: #94a3b8;
    margin: 0;
    line-height: 1.55;
  }

  .dim-meters-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    gap: 22px;
  }

  .dim-meter-row {
    display: flex;
    flex-direction: column;
    gap: 12px;
    background: rgba(30, 41, 59, 0.5);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 18px;
    padding: 18px;
    transition: all 0.2s ease;
  }

