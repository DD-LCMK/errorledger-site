  }

  /* Color themes by scale score */
  .btn-score-1 .btn-circle { width: 56px; height: 56px; border-color: #ef4444; background: rgba(239, 68, 68, 0.1); }
  .btn-score-2 .btn-circle { width: 48px; height: 48px; border-color: #f87171; background: rgba(248, 113, 113, 0.08); }
  .btn-score-3 .btn-circle { width: 42px; height: 42px; border-color: #fb923c; background: rgba(251, 146, 60, 0.08); }
  .btn-score-4 .btn-circle { width: 36px; height: 36px; border-color: #94a3b8; background: rgba(148, 163, 184, 0.06); }
  .btn-score-5 .btn-circle { width: 42px; height: 42px; border-color: #a7f3d0; background: rgba(52, 211, 153, 0.08); }
  .btn-score-6 .btn-circle { width: 48px; height: 48px; border-color: #34d399; background: rgba(52, 211, 153, 0.12); }
  .btn-score-7 .btn-circle { width: 56px; height: 56px; border-color: #10b981; background: rgba(16, 185, 129, 0.18); }

  /* Selected States */
  .btn-score-1.selected .btn-circle { background: #ef4444; box-shadow: 0 0 18px rgba(239, 68, 68, 0.7); }
  .btn-score-2.selected .btn-circle { background: #f87171; box-shadow: 0 0 16px rgba(248, 113, 113, 0.6); }
  .btn-score-3.selected .btn-circle { background: #fb923c; box-shadow: 0 0 14px rgba(251, 146, 60, 0.6); }
  .btn-score-4.selected .btn-circle { background: #94a3b8; box-shadow: 0 0 12px rgba(148, 163, 184, 0.6); }
  .btn-score-5.selected .btn-circle { background: #34d399; box-shadow: 0 0 14px rgba(52, 211, 153, 0.6); }
  .btn-score-6.selected .btn-circle { background: #10b981; box-shadow: 0 0 16px rgba(16, 185, 129, 0.7); }
  .btn-score-7.selected .btn-circle { background: #059669; box-shadow: 0 0 20px rgba(5, 150, 105, 0.8); }

  .btn-tag {
