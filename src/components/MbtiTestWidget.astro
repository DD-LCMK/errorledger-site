</div>

<script is:inline>
(function() {
  // Parse static datasets
  var rawQuestionsEl = document.getElementById('mbti-data-questions');
  var rawProfilesEl = document.getElementById('mbti-data-profiles');
  if (!rawQuestionsEl || !rawProfilesEl) return;

  var questions = JSON.parse(rawQuestionsEl.textContent || '[]');
  var profiles = JSON.parse(rawProfilesEl.textContent || '{}');
  var lang = document.getElementById('mbti-widget')?.getAttribute('data-lang') || 'ko';
  var isEn = lang === 'en';

  // State
  var currentIndex = 0;
  var answers = new Array(questions.length).fill(null);
  var currentResultType = 'INTJ';

  // DOM Elements
  var stageIntro = document.getElementById('stage-intro');
  var stageRunner = document.getElementById('stage-runner');
  var stageAnalyzing = document.getElementById('stage-analyzing');
  var stageResult = document.getElementById('stage-result');

  var btnStartTest = document.getElementById('btn-start-test');
  var progressStepText = document.getElementById('progress-step-text');
  var currentFacetBadge = document.getElementById('current-facet-badge');
  var progressFill = document.getElementById('progress-fill');
  var qNumberPill = document.getElementById('q-number-pill');
  var qDimensionPill = document.getElementById('q-dimension-pill');
  var questionText = document.getElementById('question-text');
  var btnNavPrev = document.getElementById('btn-nav-prev');
  var btnNavNext = document.getElementById('btn-nav-next');
  var answeredCounter = document.getElementById('answered-counter');
  var likertBtns = document.querySelectorAll('.likert-btn');

  // Check URL params for direct shared result: ?type=INTJ&ei=76&sn=82&tf=72&jp=85
  var urlParams = new URLSearchParams(window.location.search);
  var paramType = urlParams.get('type')?.toUpperCase();
  if (paramType && profiles[paramType]) {
    currentResultType = paramType;
    showResultDashboard({
      code: paramType,
      percentages: {
        EI: { primary: paramType[0], percent: parseInt(urlParams.get('ei') || urlParams.get('i') || '75', 10) },
        SN: { primary: paramType[1], percent: parseInt(urlParams.get('sn') || urlParams.get('n') || '75', 10) },
        TF: { primary: paramType[2], percent: parseInt(urlParams.get('tf') || urlParams.get('t') || '75', 10) },
        JP: { primary: paramType[3], percent: parseInt(urlParams.get('jp') || urlParams.get('j') || '75', 10) },
      }
    });
  }

  // 1. Start Test Button
  if (btnStartTest) {
    btnStartTest.addEventListener('click', function() {
      stageIntro.style.display = 'none';
      stageRunner.style.display = 'block';
      renderQuestion(0);
      window.scrollTo({ top: stageRunner.offsetTop - 40, behavior: 'smooth' });
    });
  }

  // 2. Render Question Card
  function renderQuestion(index) {
    if (index < 0 || index >= questions.length) return;
    currentIndex = index;
    var q = questions[index];

    progressStepText.textContent = (isEn ? 'Question ' : '문항 ') + (index + 1) + ' / ' + questions.length;
    var facetName = isEn ? q.facetNameEn : q.facetNameKo;
    currentFacetBadge.textContent = facetName;
    progressFill.style.width = (((index + 1) / questions.length) * 100) + '%';

    qNumberPill.textContent = 'Q.' + (index + 1 < 10 ? '0' : '') + (index + 1);
    qDimensionPill.textContent = facetName;
    questionText.textContent = isEn ? q.textEn : q.textKo;

    // Likert button states
    var curVal = answers[index];
    likertBtns.forEach(function(btn) {
      var score = parseInt(btn.getAttribute('data-score') || '0', 10);
      if (curVal === score) {
        btn.classList.add('selected');
      } else {
        btn.classList.remove('selected');
      }
    });

    btnNavPrev.disabled = (index === 0);
    
    // Count answered
    var totalAnswered = answers.filter(function(v) { return v !== null; }).length;
    answeredCounter.textContent = totalAnswered + ' / ' + questions.length + (isEn ? ' answered' : ' 완료');

    // Next button label
    if (index === questions.length - 1) {
      btnNavNext.innerHTML = '<span>' + (isEn ? 'Complete Assessment ✨' : '검사 결과 분석하기 ✨') + '</span>';
      btnNavNext.classList.add('finish-mode');
    } else {
      btnNavNext.innerHTML = '<span>' + (isEn ? 'Next →' : '다음 문항 →') + '</span>';
      btnNavNext.classList.remove('finish-mode');
    }
  }

  // 3. Select Score
  function selectScore(score) {
    answers[currentIndex] = score;
    renderQuestion(currentIndex);

    // Auto-advance with smooth transition after 220ms
    setTimeout(function() {
      if (currentIndex < questions.length - 1) {
        renderQuestion(currentIndex + 1);
      } else {
        // Check if all answered
        var unansIdx = answers.findIndex(function(v) { return v === null; });
        if (unansIdx !== -1) {
          alert(isEn ? 'Please answer question ' + (unansIdx + 1) + ' before completing.' : (unansIdx + 1) + '번 문항을 입력해 주세요.');
          renderQuestion(unansIdx);
        } else {
          runCalculation();
        }
      }
    }, 220);
  }

  // Bind click to Likert buttons
  likertBtns.forEach(function(btn) {
    btn.addEventListener('click', function() {
      var score = parseInt(this.getAttribute('data-score') || '4', 10);
      selectScore(score);
    });
  });

  // Prev / Next buttons
  if (btnNavPrev) {
    btnNavPrev.addEventListener('click', function() {
      if (currentIndex > 0) renderQuestion(currentIndex - 1);
    });
  }

  if (btnNavNext) {
    btnNavNext.addEventListener('click', function() {
      if (currentIndex === questions.length - 1) {
        var unansIdx = answers.findIndex(function(v) { return v === null; });
        if (unansIdx !== -1) {
          alert(isEn ? 'Please complete question ' + (unansIdx + 1) : (unansIdx + 1) + '번 문항을 입력해 주세요.');
          renderQuestion(unansIdx);
        } else {
          runCalculation();
        }
      } else {
        renderQuestion(currentIndex + 1);
      }
    });
  }

  // 4. Keyboard Shortcuts: 1-7 for scores, Arrow keys for navigation
  window.addEventListener('keydown', function(e) {
    if (stageRunner.style.display === 'none') return;
    var key = e.key;
    if (key >= '1' && key <= '7') {
      selectScore(parseInt(key, 10));
    } else if (key === 'ArrowLeft') {
      if (currentIndex > 0) renderQuestion(currentIndex - 1);
    } else if (key === 'ArrowRight') {
      if (currentIndex < questions.length - 1) renderQuestion(currentIndex + 1);
    }
  });

  // 5. Rigorous Psychometric Scoring Formula Engine
  function runCalculation() {
    stageRunner.style.display = 'none';
    stageAnalyzing.style.display = 'flex';
    window.scrollTo({ top: stageAnalyzing.offsetTop - 40, behavior: 'smooth' });

    var step1 = document.getElementById('ana-step-1');
    var step2 = document.getElementById('ana-step-2');
    var step3 = document.getElementById('ana-step-3');

    setTimeout(function() { if (step1) step1.classList.add('done'); }, 500);
    setTimeout(function() { if (step2) step2.classList.add('done'); }, 1200);
    setTimeout(function() { if (step3) step3.classList.add('done'); }, 1900);

    setTimeout(function() {
      var sumEI = 0;
      var sumSN = 0;
      var sumTF = 0;
      var sumJP = 0;

      for (var i = 0; i < questions.length; i++) {
        var q = questions[i];
        var response = answers[i] || 4;
        var deviation = response - 4; // -3 to +3
        var score = q.polarity * deviation;

        if (q.dimension === 'EI') sumEI += score;
        else if (q.dimension === 'SN') sumSN += score;
        else if (q.dimension === 'TF') sumTF += score;
        else if (q.dimension === 'JP') sumJP += score;
      }

      function calcDim(sum, posLetter, negLetter) {
        if (sum >= 0) {
          var pct = Math.round(50 + (sum / 45) * 50);
          return { primary: posLetter, secondary: negLetter, percent: Math.min(100, pct) };
        } else {
          var pct = Math.round(50 + (Math.abs(sum) / 45) * 50);
          return { primary: negLetter, secondary: posLetter, percent: Math.min(100, pct) };
        }
      }

      var resEI = calcDim(sumEI, 'E', 'I');
      var resSN = calcDim(sumSN, 'N', 'S');
      var resTF = calcDim(sumTF, 'F', 'T');
      var resJP = calcDim(sumJP, 'P', 'J');

      var finalType = resEI.primary + resSN.primary + resTF.primary + resJP.primary;
      currentResultType = finalType;

      stageAnalyzing.style.display = 'none';
      showResultDashboard({
        code: finalType,
        percentages: { EI: resEI, SN: resSN, TF: resTF, JP: resJP }
      });
    }, 2400);
  }

  // 6. Show Full Detailed Result Dashboard
  function showResultDashboard(resultData) {
    stageIntro.style.display = 'none';
    stageRunner.style.display = 'none';
    stageAnalyzing.style.display = 'none';
    stageResult.style.display = 'block';

    var p = profiles[resultData.code] || profiles['INTJ'];
    currentResultType = resultData.code;

    // Header identity
    var bPill = document.getElementById('res-badge-pill');
    if (bPill) bPill.textContent = p.badge || '';
    var tCode = document.getElementById('res-type-code');
    if (tCode) tCode.textContent = p.code || '';
    var tName = document.getElementById('res-type-name');
    if (tName) tName.textContent = (isEn ? p.nameEn : p.nameKo) || '';
    var rMotto = document.getElementById('res-motto');
    if (rMotto) rMotto.textContent = (isEn ? p.mottoEn : p.mottoKo) || '';

    // Keywords
    var kwRow = document.getElementById('res-keywords-row');
    if (kwRow) {
      kwRow.innerHTML = '';
      (p.keywords || []).forEach(function(kw) {
        var pill = document.createElement('span');
        pill.className = 'keyword-pill';
        pill.textContent = '#' + kw;
        kwRow.appendChild(pill);
      });
    }

    // Dimension percentage meters
    var ei = resultData.percentages.EI;
    var sn = resultData.percentages.SN;
    var tf = resultData.percentages.TF;
    var jp = resultData.percentages.JP;

    function formatStrength(pct) {
      if (pct >= 90) return isEn ? 'Very Strong' : '극단적 확고형';
      if (pct >= 75) return isEn ? 'Clear Preference' : '확고형';
      if (pct >= 60) return isEn ? 'Moderate' : '완만형';
      return isEn ? 'Flexible / Balanced' : '균형형';
    }

    // EI Meter
    var isE = ei.primary === 'E';
    var eVal = isE ? ei.percent : (100 - ei.percent);
    var iVal = 100 - eVal;
    var dimBadgeEi = document.getElementById('dim-badge-ei');
    if (dimBadgeEi) dimBadgeEi.textContent = (isE ? (ei.percent + '% 외향') : (ei.percent + '% 내향')) + ' (' + formatStrength(ei.percent) + ')';
    var fillEiL = document.getElementById('dim-fill-ei-left');
    if (fillEiL) fillEiL.style.width = eVal + '%';
    var fillEiR = document.getElementById('dim-fill-ei-right');
    if (fillEiR) fillEiR.style.width = iVal + '%';

    // SN Meter
    var isN = sn.primary === 'N';
    var nVal = isN ? sn.percent : (100 - sn.percent);
    var sVal = 100 - nVal;
    var dimBadgeSn = document.getElementById('dim-badge-sn');
    if (dimBadgeSn) dimBadgeSn.textContent = (isN ? (sn.percent + '% 직관') : (sn.percent + '% 감각')) + ' (' + formatStrength(sn.percent) + ')';
    var fillSnL = document.getElementById('dim-fill-sn-left');
    if (fillSnL) fillSnL.style.width = sVal + '%';
    var fillSnR = document.getElementById('dim-fill-sn-right');
    if (fillSnR) fillSnR.style.width = nVal + '%';

    // TF Meter
    var isF = tf.primary === 'F';
    var fVal = isF ? tf.percent : (100 - tf.percent);
    var tVal = 100 - fVal;
    var dimBadgeTf = document.getElementById('dim-badge-tf');
    if (dimBadgeTf) dimBadgeTf.textContent = (isF ? (tf.percent + '% 감정') : (tf.percent + '% 사고')) + ' (' + formatStrength(tf.percent) + ')';
    var fillTfL = document.getElementById('dim-fill-tf-left');
    if (fillTfL) fillTfL.style.width = tVal + '%';
    var fillTfR = document.getElementById('dim-fill-tf-right');
    if (fillTfR) fillTfR.style.width = fVal + '%';

    // JP Meter
    var isP = jp.primary === 'P';
    var pVal = isP ? jp.percent : (100 - jp.percent);
    var jVal = 100 - pVal;
    var dimBadgeJp = document.getElementById('dim-badge-jp');
    if (dimBadgeJp) dimBadgeJp.textContent = (isP ? (jp.percent + '% 인식') : (jp.percent + '% 판단')) + ' (' + formatStrength(jp.percent) + ')';
    var fillJpL = document.getElementById('dim-fill-jp-left');
    if (fillJpL) fillJpL.style.width = jVal + '%';
    var fillJpR = document.getElementById('dim-fill-jp-right');
    if (fillJpR) fillJpR.style.width = pVal + '%';

    // Section 1: Overview & Figures
    var overP = document.getElementById('res-overview-p');
    if (overP) overP.textContent = (isEn ? p.overviewEn : p.overviewKo) || '';
    var figList = document.getElementById('res-figures-list');
    if (figList) {
      figList.innerHTML = '';
      (p.famousFigures || []).forEach(function(fig) {
        var item = document.createElement('span');
        item.className = 'figure-pill';
        item.textContent = fig;
        figList.appendChild(item);
      });
    }

    // Section 2: Cognitive functions
    var c = p.cognitiveFunctions || {};
    if (c.dominant) {
      var domCode = document.getElementById('cog-dom-code');
      if (domCode) domCode.textContent = c.dominant.code || '';
      var domName = document.getElementById('cog-dom-name');
      if (domName) domName.textContent = (isEn ? c.dominant.nameEn : c.dominant.nameKo) || '';
      var domDesc = document.getElementById('cog-dom-desc');
      if (domDesc) domDesc.textContent = (isEn ? c.dominant.descEn : c.dominant.descKo) || '';
    }
    if (c.auxiliary) {
      var auxCode = document.getElementById('cog-aux-code');
      if (auxCode) auxCode.textContent = c.auxiliary.code || '';
      var auxName = document.getElementById('cog-aux-name');
      if (auxName) auxName.textContent = (isEn ? c.auxiliary.nameEn : c.auxiliary.nameKo) || '';
      var auxDesc = document.getElementById('cog-aux-desc');
      if (auxDesc) auxDesc.textContent = (isEn ? c.auxiliary.descEn : c.auxiliary.descKo) || '';
    }
    if (c.tertiary) {
      var tertCode = document.getElementById('cog-tert-code');
      if (tertCode) tertCode.textContent = c.tertiary.code || '';
      var tertName = document.getElementById('cog-tert-name');
      if (tertName) tertName.textContent = (isEn ? c.tertiary.nameEn : c.tertiary.nameKo) || '';
      var tertDesc = document.getElementById('cog-tert-desc');
      if (tertDesc) tertDesc.textContent = (isEn ? c.tertiary.descEn : c.tertiary.descKo) || '';
    }
    if (c.inferior) {
      var infCode = document.getElementById('cog-inf-code');
      if (infCode) infCode.textContent = c.inferior.code || '';
      var infName = document.getElementById('cog-inf-name');
      if (infName) infName.textContent = (isEn ? c.inferior.nameEn : c.inferior.nameKo) || '';
      var infDesc = document.getElementById('cog-inf-desc');
      if (infDesc) infDesc.textContent = (isEn ? c.inferior.descEn : c.inferior.descKo) || '';
    }

    // Section 3: Strengths & Weaknesses
    var strList = document.getElementById('res-strengths-list');
    if (strList) {
      strList.innerHTML = '';
      var sArr = isEn ? (p.strengthsEn || []) : (p.strengthsKo || []);
      sArr.forEach(function(s) {
        var li = document.createElement('li');
        li.textContent = s;
        strList.appendChild(li);
      });
    }

    var weakList = document.getElementById('res-weaknesses-list');
    if (weakList) {
      weakList.innerHTML = '';
      var wArr = isEn ? (p.weaknessesEn || []) : (p.weaknessesKo || []);
      wArr.forEach(function(w) {
        var li = document.createElement('li');
        li.textContent = w;
        weakList.appendChild(li);
      });
    }

    // Section 4: Stress Loop & Growth
    var stressBox = document.getElementById('res-stress-box');
    if (stressBox) stressBox.textContent = (isEn ? p.stressLoopEn : p.stressLoopKo) || '';
    var growthBox = document.getElementById('res-growth-text');
    if (growthBox) growthBox.textContent = (isEn ? p.growthAdviceEn : p.growthAdviceKo) || '';

    // Section 5: Career
    var cEnv = document.getElementById('res-career-env');
    if (cEnv) cEnv.textContent = (isEn ? p.career?.bestEnvironmentEn : p.career?.bestEnvironmentKo) || '';
    var jobsGrid = document.getElementById('res-jobs-grid');
    if (jobsGrid) {
      jobsGrid.innerHTML = '';
      (p.career?.recommendedCareers || []).forEach(function(job) {
        var tag = document.createElement('span');
        tag.className = 'job-tag';
        tag.textContent = '💼 ' + job;
        jobsGrid.appendChild(tag);
      });
    }
    var cWork = document.getElementById('res-career-workstyle');
    if (cWork) cWork.textContent = (isEn ? p.career?.workStyleEn : p.career?.workStyleKo) || '';

    // Section 6: Relationship & Compatibility
    var lStyle = document.getElementById('res-love-style');
    if (lStyle) lStyle.textContent = (isEn ? p.relationship?.loveStyleEn : p.relationship?.loveStyleKo) || '';
    
    var bestMatchesPills = document.getElementById('res-best-matches-pills');
    if (bestMatchesPills) {
      bestMatchesPills.innerHTML = '';
      (p.relationship?.bestMatches || []).forEach(function(m) {
        var pill = document.createElement('span');
        pill.className = 'match-pill golden';
        pill.textContent = '💖 ' + m;
        bestMatchesPills.appendChild(pill);
      });
    }
    var bDesc = document.getElementById('res-best-match-desc');
    if (bDesc) bDesc.textContent = (isEn ? p.relationship?.bestMatchReasonEn : p.relationship?.bestMatchReasonKo) || '';

    var chalMatchesPills = document.getElementById('res-challenging-matches-pills');
    if (chalMatchesPills) {
      chalMatchesPills.innerHTML = '';
      (p.relationship?.challengingMatches || []).forEach(function(m) {
        var pill = document.createElement('span');
        pill.className = 'match-pill challenging';
        pill.textContent = '💡 ' + m;
        chalMatchesPills.appendChild(pill);
      });
    }
    var cDesc = document.getElementById('res-challenging-match-desc');
    if (cDesc) cDesc.textContent = (isEn ? p.relationship?.challengingMatchReasonEn : p.relationship?.challengingMatchReasonKo) || '';

    // Interactive compatibility checker
    var compatSelect = document.getElementById('compat-target-select');
    if (compatSelect) {
      var defaultCompare = (p.relationship?.bestMatches && p.relationship.bestMatches[0]) || 'ENFP';
      compatSelect.value = defaultCompare;
      updateCompatibilityView(p.code, compatSelect.value);
      compatSelect.onchange = function() {
        updateCompatibilityView(p.code, this.value);
      };
    }

    // Section 7: Streamer style
    var sPersona = document.getElementById('res-streamer-persona');
    if (sPersona) sPersona.textContent = (isEn ? p.streamerStyle?.personaEn : p.streamerStyle?.personaKo) || '';
    var sChat = document.getElementById('res-streamer-chat');
    if (sChat) sChat.textContent = (isEn ? p.streamerStyle?.viewerDynamicEn : p.streamerStyle?.viewerDynamicKo) || '';
    var gamesList = document.getElementById('res-streamer-games');
    if (gamesList) {
      gamesList.innerHTML = '';
      (p.streamerStyle?.recommendedContent || []).forEach(function(g) {
        var tag = document.createElement('span');
        tag.className = 'game-tag';
        tag.textContent = '🕹️ ' + g;
        gamesList.appendChild(tag);
      });
    }

    // Update browser URL query without reload for direct shareability
    var shareUrl = new URL(window.location.href);
    shareUrl.searchParams.set('type', resultData.code);
    shareUrl.searchParams.set('ei', ei.percent);
    shareUrl.searchParams.set('sn', sn.percent);
    shareUrl.searchParams.set('tf', tf.percent);
    shareUrl.searchParams.set('jp', jp.percent);
    window.history.replaceState({}, '', shareUrl.toString());

    window.scrollTo({ top: stageResult.offsetTop - 30, behavior: 'smooth' });
  }

  // 7. Compatibility Calculator Helper
  function updateCompatibilityView(type1, type2) {
    var goldenPairs = {
      INTJ: ['ENFP', 'ENTP'], INTP: ['ENTJ', 'ENFJ'], ENTJ: ['INTP', 'INFP'], ENTP: ['INFJ', 'INTJ'],
      INFJ: ['ENTP', 'ENFP'], INFP: ['ENFJ', 'ENTJ'], ENFJ: ['INFP', 'ISFP'], ENFP: ['INTJ', 'INFJ'],
      ISTJ: ['ESFP', 'ESTP'], ISFJ: ['ESTP', 'ESFP'], ESTJ: ['ISFP', 'ISTP'], ESFJ: ['ISTP', 'ISFP'],
      ISTP: ['ESFJ', 'ESTJ'], ISFP: ['ESTJ', 'ESFJ'], ESTP: ['ISFJ', 'ISTJ'], ESFP: ['ISTJ', 'ISFJ']
    };

    var score = 75;
    var badge = '🌿 ' + (isEn ? 'Harmonious Balance' : '조화로운 보완 관계');
    var desc = isEn 
      ? 'A healthy balance of similarities and differences. You offer complementary perspectives that broaden each other’s horizons.'
      : '서로 다른 장점과 관점을 지니고 있어 배울 점이 많은 관계입니다. 솔직한 대화로 차이를 좁혀가면 누구보다 깊은 유대를 맺습니다.';

    if (type1 === type2) {
      score = 85;
      badge = '🪞 ' + (isEn ? 'Soul Mirror' : '영혼의 거울 같은 관계');
      desc = isEn
        ? 'Identical cognitive wiring enables effortless communication and mutual understanding, though you must navigate identical blind spots together.'
        : '말하지 않아도 상대방의 생각과 기분을 훤히 꿰뚫어 보는 깊은 공감대를 형성합니다. 단점까지 같을 수 있어 배려가 필요합니다.';
    } else if (goldenPairs[type1]?.includes(type2)) {
      score = 98;
      badge = '💖 ' + (isEn ? 'Ideal Match (Transcendent Synergy)' : '천생연분 환상의 궁합');
      desc = isEn
        ? 'Exceptional psychological pairing where each partner’s primary strengths effortlessly cover the other’s blind spots. Effortless fireworks and deep mutual growth.'
        : '서로의 장점이 상대방의 약점을 마법처럼 보완해 주는 최고의 케미스트리입니다. 대화가 끊이지 않으며 함께 성장하는 환상의 짝꿍입니다.';
    }

    var badgeTag = document.getElementById('compat-badge-tag');
    if (badgeTag) badgeTag.textContent = badge;
    var scoreNum = document.getElementById('compat-score-num');
    if (scoreNum) scoreNum.textContent = score;
    var expl = document.getElementById('compat-explanation');
    if (expl) expl.textContent = desc;
  }

  // 8. Sticky Quick-Jump Navigation & Smooth Scrolling
  var jumpChips = document.querySelectorAll('.jump-chip');
  jumpChips.forEach(function(chip) {
    chip.addEventListener('click', function() {
      var targetId = this.getAttribute('data-target');
      var target = document.getElementById(targetId);
      if (target) {
        var offset = 80;
        var bodyRect = document.body.getBoundingClientRect().top;
        var elementRect = target.getBoundingClientRect().top;
        var offsetPosition = (elementRect - bodyRect) - offset;
        window.scrollTo({ top: offsetPosition, behavior: 'smooth' });
      }
    });
  });

  // Scroll Spy for TOC Chips
  window.addEventListener('scroll', function() {
    if (stageResult.style.display === 'none') return;
    var sections = document.querySelectorAll('.result-report-section');
    var scrollPos = window.scrollY + 140;
    sections.forEach(function(sec) {
      var top = sec.offsetTop;
      var height = sec.offsetHeight;
      var id = sec.getAttribute('id');
      if (scrollPos >= top && scrollPos < top + height) {
        jumpChips.forEach(function(c) {
          if (c.getAttribute('data-target') === id) {
            c.classList.add('active');
          } else {
            c.classList.remove('active');
          }
        });
      }
    });
  });

  // 9. Share Link Buttons
  function copyLinkAction() {
    if (navigator.clipboard) {
      navigator.clipboard.writeText(window.location.href).then(function() {
        alert(isEn ? 'Link copied to clipboard! Share it with friends or stream chat.' : '결과 링크가 클립보드에 복사되었습니다! 친구나 방송 채팅창에 공유해 보세요.');
      });
    } else {
      alert(window.location.href);
    }
  }

  var btnShare = document.getElementById('btn-share-result');
  if (btnShare) btnShare.addEventListener('click', copyLinkAction);

  var btnShareBottom = document.getElementById('btn-share-bottom');
  if (btnShareBottom) btnShareBottom.addEventListener('click', copyLinkAction);

  // 10. Retake Test Buttons
  function retakeAction() {
    answers = new Array(questions.length).fill(null);
    stageResult.style.display = 'none';
    stageIntro.style.display = 'none';
    stageRunner.style.display = 'block';
    renderQuestion(0);
    window.scrollTo({ top: stageRunner.offsetTop - 40, behavior: 'smooth' });
  }

  var btnRetake = document.getElementById('btn-retake-test');
  if (btnRetake) btnRetake.addEventListener('click', retakeAction);

  var btnRetakeBottom = document.getElementById('btn-retake-bottom');
  if (btnRetakeBottom) btnRetakeBottom.addEventListener('click', retakeAction);

  // 11. Scroll to Top Button
  var btnScrollTop = document.getElementById('btn-scroll-top');
  if (btnScrollTop) {
    btnScrollTop.addEventListener('click', function() {
      window.scrollTo({ top: stageResult.offsetTop - 20, behavior: 'smooth' });
    });
  }

})();
</script>

<style>
  .mbti-widget-root {
    width: 100%;
    max-width: 1100px;
    margin: 0 auto;
    color: #f1f5f9;
    font-family: -apple-system, BlinkMacSystemFont, 'Pretendard', 'Segoe UI', Roboto, sans-serif;
  }

  /* STAGE 1: INTRO */
  .mbti-stage-intro {
    position: relative;
    padding: 60px 24px 70px;
    text-align: center;
    overflow: hidden;
  }

  .intro-backdrop {
    position: absolute;
    top: -30%;
    left: 50%;
    transform: translateX(-50%);
    width: 800px;
    height: 500px;
    background: radial-gradient(circle, rgba(99, 102, 241, 0.25) 0%, rgba(236, 72, 153, 0.12) 45%, transparent 75%);
    filter: blur(70px);
    pointer-events: none;
  }

  .intro-content {
    position: relative;
    z-index: 1;
    max-width: 880px;
    margin: 0 auto;
  }

  .intro-badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: rgba(99, 102, 241, 0.15);
    border: 1px solid rgba(99, 102, 241, 0.35);
