        <!-- SECTION 7: STREAMER & CREATOR STYLE -->
        <section class="result-report-section" id="section-streamer">
          <div class="detail-card">
            <div class="section-badge-tag"><span class="badge-num">07</span><span>{isEn ? 'StreamArcade Creator Persona' : '스트림아케이드 특화: 방송 및 크리에이터 성향'}</span></div>
            <h3 class="pane-headline">
              <span>🎮</span>
              <span>{isEn ? 'StreamArcade Creator & Streaming Persona' : '스트림아케이드 특화: 방송 및 크리에이터 성향 분석'}</span>
