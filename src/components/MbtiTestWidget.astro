      var dRTitle = document.getElementById('demo-rarity-title');
      if (dRTitle) dRTitle.textContent = (isEn ? (fact.demographics?.rankEn || fact.demographics?.rarityRankEn) : (fact.demographics?.rankKo || fact.demographics?.rarityRankKo)) || '';
      var dRDesc = document.getElementById('demo-rarity-desc');
      if (dRDesc) dRDesc.textContent = (isEn ? (fact.demographics?.rarityEn || fact.demographics?.rarityDescEn) : (fact.demographics?.rarityKo || fact.demographics?.rarityDescKo)) || '';
