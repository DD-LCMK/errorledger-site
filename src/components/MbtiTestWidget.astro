      var dTempShadow = document.getElementById('demo-temp-shadow');
      if (dTempShadow) dTempShadow.textContent = (isEn ? fact.temperament?.shadowSideEn : fact.temperament?.shadowSideKo) || '';
    }

    // Section 2: Cognitive functions
    var c = p.cognitiveFunctions || {};
