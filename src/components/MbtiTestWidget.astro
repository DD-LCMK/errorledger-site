  }

  .demo-card.rarity {
    border-color: rgba(245, 158, 11, 0.3);
    background: linear-gradient(145deg, rgba(245, 158, 11, 0.05) 0%, rgba(20, 24, 40, 0.95) 100%);
  }

  .demo-card.temperament {
    border-color: rgba(168, 85, 247, 0.3);
