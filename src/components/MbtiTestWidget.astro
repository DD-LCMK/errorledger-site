                <!-- Real-time Conversation Vibe Box -->
                <div class="compat-vibe-box">
                  <div class="vibe-title">🗨️ {isEn ? 'Conversation Vibe & Banter Mood' : '대화 무드 & 티키타카 스타일'}</div>
                  <p class="vibe-content" id="compat-talk-vibe"></p>
