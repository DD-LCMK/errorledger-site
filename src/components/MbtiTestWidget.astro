                <!-- 3-Column Deep Insights Grid -->
                <div class="compat-insights-grid">
                  <div class="compat-insight-col synergy">
                    <div class="insight-header">
                      <span class="in-icon">⚡</span>
                      <h5>{isEn ? 'Core Synergy (Why They Click)' : '핵심 시너지 (끌리는 이유)'}</h5>
                    </div>
                    <p id="compat-synergy"></p>
                  </div>

                  <div class="compat-insight-col friction">
                    <div class="insight-header">
                      <span class="in-icon">⚠️</span>
                      <h5>{isEn ? 'Friction Triggers & Caution' : '갈등 유발 요인 & 주의점'}</h5>
                    </div>
                    <p id="compat-friction"></p>
                  </div>

                  <div class="compat-insight-col advice">
                    <div class="insight-header">
                      <span class="in-icon">💡</span>
                      <h5>{isEn ? 'Actionable Communication Tip' : '오래가는 실전 소통 팁'}</h5>
