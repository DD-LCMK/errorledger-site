        li.textContent = w;
        weakList.appendChild(li);
      });
    }

    // Section 3.5: Psychological Behavior Facts & Intimacy Iceberg
    if (fact) {
      var bf = fact.behaviorFacts || fact.behavioralFacts || {};
      var fConflict = document.getElementById('fact-conflict-text');
      if (fConflict) fConflict.textContent = (isEn ? (bf.conflictReactionEn || bf.conflictReactionKo) : bf.conflictReactionKo) || '';
      var fRecharge = document.getElementById('fact-recharge-text');
      if (fRecharge) fRecharge.textContent = (isEn ? (bf.rechargeRoutineEn || bf.dopamineRechargeEn) : (bf.rechargeRoutineKo || bf.dopamineRechargeKo)) || '';
      var fPetpeeve = document.getElementById('fact-petpeeve-text');
      if (fPetpeeve) fPetpeeve.textContent = (isEn ? (bf.petPeeveEn || bf.petPeeveKo) : bf.petPeeveKo) || '';

      var stages = bf.intimacyStages || bf.intimacyIceberg || {};
      var iStep1 = document.getElementById('intimacy-step-1');
      if (iStep1) iStep1.textContent = (isEn ? (stages.stage1En || stages.stage1_strangerEn) : (stages.stage1Ko || stages.stage1_strangerKo)) || '';
      var iStep2 = document.getElementById('intimacy-step-2');
      if (iStep2) iStep2.textContent = (isEn ? (stages.stage2En || stages.stage2_acquaintanceEn) : (stages.stage2Ko || stages.stage2_acquaintanceKo)) || '';
      var iStep3 = document.getElementById('intimacy-step-3');
      if (iStep3) iStep3.textContent = (isEn ? (stages.stage3En || stages.stage3_innerSanctuaryEn) : (stages.stage3Ko || stages.stage3_innerSanctuaryKo)) || '';
    }

    // Section 4: Stress Loop & Growth
