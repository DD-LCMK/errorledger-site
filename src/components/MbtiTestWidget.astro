  }

  .btn-start-test:hover {
    transform: translateY(-2px);
    box-shadow: 0 16px 36px -6px rgba(99, 102, 241, 0.8);
  }

  .time-estimate-note {
    font-size: 0.85rem;
    color: #64748b;
  }

  /* STAGE 2: TEST RUNNER */
  .mbti-stage-runner {
    padding: 20px 0 60px;
  }

  .runner-header {
    background: rgba(17, 24, 39, 0.95);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 16px;
    padding: 16px 22px;
    margin-bottom: 24px;
    backdrop-filter: blur(12px);
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.4);
  }

  .progress-meta {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 10px;
  }

  .progress-step-text {
    font-size: 1rem;
    font-weight: 800;
    color: #a5b4fc;
  }

  .current-facet-badge {
    font-size: 0.82rem;
    font-weight: 700;
    background: rgba(99, 102, 241, 0.15);
    border: 1px solid rgba(99, 102, 241, 0.3);
    color: #cbd5e1;
    padding: 4px 12px;
    border-radius: 999px;
  }

  .progress-track {
    width: 100%;
    height: 8px;
    background: rgba(255, 255, 255, 0.08);
    border-radius: 999px;
    overflow: hidden;
  }

  .progress-fill {
    height: 100%;
    background: linear-gradient(90deg, #6366f1, #ec4899);
    border-radius: 999px;
    transition: width 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .runner-controls-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-top: 10px;
  }

  .btn-toggle-grid {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    background: rgba(99, 102, 241, 0.15);
    border: 1px solid rgba(99, 102, 241, 0.35);
    color: #c7d2fe;
    font-size: 0.82rem;
    font-weight: 700;
    padding: 6px 14px;
    border-radius: 999px;
    cursor: pointer;
    transition: all 0.2s;
  }

  .btn-toggle-grid:hover {
    background: rgba(99, 102, 241, 0.28);
    color: #ffffff;
    border-color: rgba(99, 102, 241, 0.6);
  }

  .keyboard-tip-tag {
    font-size: 0.78rem;
    color: #64748b;
  }

  /* Return to Latest Question Bar */
  .return-latest-bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 12px;
    background: linear-gradient(135deg, rgba(99, 102, 241, 0.18) 0%, rgba(236, 72, 153, 0.14) 100%);
    border: 1px solid rgba(99, 102, 241, 0.4);
    border-radius: 14px;
    padding: 10px 16px;
    margin-bottom: 22px;
    animation: pulseGlow 2.5s infinite alternate;
  }

  @keyframes pulseGlow {
    0% { box-shadow: 0 0 0 rgba(99, 102, 241, 0); }
    100% { box-shadow: 0 0 16px rgba(99, 102, 241, 0.35); }
  }

  .return-bar-content {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .return-icon {
    font-size: 1.1rem;
  }

  .return-msg {
    font-size: 0.88rem;
    font-weight: 700;
    color: #cbd5e1;
  }

  .btn-return-latest {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    background: linear-gradient(135deg, #6366f1 0%, #a855f7 100%);
    border: none;
    color: #ffffff;
    font-size: 0.85rem;
    font-weight: 800;
    padding: 8px 16px;
    border-radius: 10px;
    cursor: pointer;
    box-shadow: 0 4px 12px rgba(99, 102, 241, 0.4);
    transition: transform 0.15s, box-shadow 0.15s;
    white-space: nowrap;
  }

  .btn-return-latest:hover {
    transform: translateY(-1px);
    box-shadow: 0 6px 16px rgba(99, 102, 241, 0.6);
  }

  /* Question Card */
  .question-deck-container {
    perspective: 1000px;
  }

  .question-card {
    background: #111422;
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 24px;
    padding: 48px 36px 40px;
    box-shadow: 0 20px 45px -15px rgba(0, 0, 0, 0.6), 0 0 0 1px rgba(99, 102, 241, 0.12);
  }

  .question-card-header {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 24px;
  }

  .q-number-pill {
    font-size: 0.85rem;
    font-weight: 900;
    color: #6366f1;
    background: rgba(99, 102, 241, 0.12);
    border: 1px solid rgba(99, 102, 241, 0.3);
    padding: 4px 12px;
    border-radius: 8px;
  }

  .q-dimension-pill {
    font-size: 0.85rem;
    color: #94a3b8;
    font-weight: 600;
  }

  .question-text {
    font-size: 1.7rem;
    font-weight: 800;
    color: #f8fafc;
    line-height: 1.5;
    margin: 0 0 48px;
    min-height: 80px;
  }

  /* Likert Scale UI */
  .likert-scale-wrap {
    background: rgba(17, 24, 39, 0.7);
    border: 1px solid rgba(255, 255, 255, 0.06);
    border-radius: 20px;
    padding: 24px 20px;
    margin-bottom: 40px;
  }

  .likert-labels-row {
    display: flex;
    justify-content: space-between;
    margin-bottom: 16px;
    font-size: 0.88rem;
    font-weight: 700;
  }

  .label-disagree { color: #f87171; }
  .label-neutral { color: #94a3b8; }
  .label-agree { color: #34d399; }

  .likert-buttons-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 10px;
  }

  .likert-btn {
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
    background: transparent;
    border: none;
    cursor: pointer;
    padding: 8px 4px;
    transition: transform 0.15s;
  }

  .likert-btn:hover {
    transform: scale(1.08);
  }

  .btn-circle {
    width: 44px;
    height: 44px;
    border-radius: 50%;
    border: 2px solid rgba(255, 255, 255, 0.2);
    background: rgba(255, 255, 255, 0.04);
    transition: all 0.2s;
  }

  /* Color themes by scale score */
  .btn-score-1 .btn-circle { width: 56px; height: 56px; border-color: #ef4444; background: rgba(239, 68, 68, 0.1); }
  .btn-score-2 .btn-circle { width: 48px; height: 48px; border-color: #f87171; background: rgba(248, 113, 113, 0.08); }
  .btn-score-3 .btn-circle { width: 42px; height: 42px; border-color: #fb923c; background: rgba(251, 146, 60, 0.08); }
  .btn-score-4 .btn-circle { width: 36px; height: 36px; border-color: #94a3b8; background: rgba(148, 163, 184, 0.06); }
  .btn-score-5 .btn-circle { width: 42px; height: 42px; border-color: #a7f3d0; background: rgba(52, 211, 153, 0.08); }
  .btn-score-6 .btn-circle { width: 48px; height: 48px; border-color: #34d399; background: rgba(52, 211, 153, 0.12); }
  .btn-score-7 .btn-circle { width: 56px; height: 56px; border-color: #10b981; background: rgba(16, 185, 129, 0.18); }

  /* Selected States */
  .btn-score-1.selected .btn-circle { background: #ef4444; box-shadow: 0 0 18px rgba(239, 68, 68, 0.7); }
  .btn-score-2.selected .btn-circle { background: #f87171; box-shadow: 0 0 16px rgba(248, 113, 113, 0.6); }
  .btn-score-3.selected .btn-circle { background: #fb923c; box-shadow: 0 0 14px rgba(251, 146, 60, 0.6); }
  .btn-score-4.selected .btn-circle { background: #94a3b8; box-shadow: 0 0 12px rgba(148, 163, 184, 0.6); }
  .btn-score-5.selected .btn-circle { background: #34d399; box-shadow: 0 0 14px rgba(52, 211, 153, 0.6); }
  .btn-score-6.selected .btn-circle { background: #10b981; box-shadow: 0 0 16px rgba(16, 185, 129, 0.7); }
  .btn-score-7.selected .btn-circle { background: #059669; box-shadow: 0 0 20px rgba(5, 150, 105, 0.8); }

  .btn-tag {
    font-size: 0.72rem;
    color: #64748b;
    text-align: center;
  }

  .likert-btn.selected .btn-tag {
    color: #f8fafc;
    font-weight: 800;
  }

  /* Nav Row */
  .question-nav-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 12px;
  }

  .nav-center-group {
    display: flex;
    align-items: center;
    gap: 8px;
    flex-wrap: wrap;
    justify-content: center;
  }

  .btn-open-matrix {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: rgba(30, 41, 59, 0.7);
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 12px;
    padding: 8px 14px;
    color: #cbd5e1;
    font-size: 0.85rem;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.2s;
  }

  .btn-open-matrix:hover {
    background: rgba(45, 55, 75, 0.85);
    color: #ffffff;
    border-color: rgba(99, 102, 241, 0.5);
  }

  .matrix-pill-tag {
    font-size: 0.75rem;
    background: rgba(99, 102, 241, 0.25);
    color: #a5b4fc;
    padding: 2px 8px;
    border-radius: 6px;
    font-weight: 700;
  }

  .btn-nav-return-pill {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    background: linear-gradient(135deg, #4f46e5 0%, #7c3aed 100%);
    color: #ffffff;
    border: none;
    font-size: 0.82rem;
    font-weight: 800;
    padding: 8px 14px;
    border-radius: 12px;
    cursor: pointer;
    box-shadow: 0 4px 12px rgba(79, 70, 229, 0.4);
    transition: all 0.2s;
    white-space: nowrap;
  }

  .btn-nav-return-pill:hover {
    transform: translateY(-1px);
    box-shadow: 0 6px 16px rgba(79, 70, 229, 0.6);
  }

  .btn-nav-prev, .btn-nav-next {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: rgba(30, 41, 59, 0.8);
    border: 1px solid rgba(255, 255, 255, 0.1);
    color: #e2e8f0;
    font-size: 0.95rem;
    font-weight: 700;
    padding: 12px 24px;
    border-radius: 12px;
    cursor: pointer;
    transition: all 0.2s;
    white-space: nowrap;
  }

  .btn-nav-prev:disabled {
    opacity: 0.3;
    cursor: not-allowed;
  }

  .btn-nav-next.finish-mode {
    background: linear-gradient(135deg, #10b981 0%, #3b82f6 100%);
    color: #ffffff;
    box-shadow: 0 6px 18px rgba(16, 185, 129, 0.4);
  }

  .answered-counter {
    font-size: 0.88rem;
    color: #94a3b8;
    font-weight: 600;
  }

  /* Question Matrix / Navigator Modal Drawer */
  .question-matrix-modal {
    position: fixed;
    top: 0;
    left: 0;
    width: 100vw;
    height: 100vh;
    z-index: 1000;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 20px;
  }

  .matrix-modal-backdrop {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: rgba(5, 8, 16, 0.85);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
  }

  .matrix-modal-card {
    position: relative;
    z-index: 1;
    background: #0f1424;
    border: 1px solid rgba(99, 102, 241, 0.35);
    border-radius: 24px;
    max-width: 820px;
    width: 100%;
    max-height: 85vh;
    display: flex;
    flex-direction: column;
    box-shadow: 0 25px 60px rgba(0, 0, 0, 0.8);
    padding: 28px 24px;
    overflow: hidden;
  }

  .matrix-modal-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    margin-bottom: 16px;
    gap: 12px;
  }

  .matrix-title-group h3 {
    font-size: 1.25rem;
    font-weight: 800;
    color: #f8fafc;
    margin: 0 0 4px;
  }

  .matrix-title-group p {
    font-size: 0.85rem;
    color: #94a3b8;
    margin: 0;
  }

  .btn-close-matrix {
    background: rgba(255, 255, 255, 0.08);
    border: none;
    color: #94a3b8;
    font-size: 1.1rem;
    width: 34px;
    height: 34px;
    border-radius: 50%;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all 0.2s;
    flex-shrink: 0;
  }

  .btn-close-matrix:hover {
    background: rgba(239, 68, 68, 0.2);
    color: #f87171;
  }

  .matrix-legend-row {
    display: flex;
    gap: 18px;
    align-items: center;
    margin-bottom: 14px;
    font-size: 0.8rem;
    color: #cbd5e1;
    flex-wrap: wrap;
  }

  .legend-item {
    display: flex;
    align-items: center;
    gap: 6px;
  }

  .legend-dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
  }

  .legend-dot.answered { background: #10b981; }
  .legend-dot.current { background: #818cf8; box-shadow: 0 0 6px #818cf8; }
  .legend-dot.unanswered { background: #475569; }

  .matrix-farthest-action {
    margin-bottom: 14px;
  }

  .btn-matrix-return-latest {
    width: 100%;
    background: linear-gradient(135deg, rgba(99, 102, 241, 0.2) 0%, rgba(236, 72, 153, 0.2) 100%);
    border: 1px solid rgba(99, 102, 241, 0.4);
    color: #ffffff;
    font-size: 0.88rem;
    font-weight: 800;
    padding: 10px 18px;
    border-radius: 12px;
    cursor: pointer;
    transition: all 0.2s;
  }

  .btn-matrix-return-latest:hover {
    background: linear-gradient(135deg, rgba(99, 102, 241, 0.35) 0%, rgba(236, 72, 153, 0.35) 100%);
    border-color: #818cf8;
  }

  .matrix-grid-scroll {
    overflow-y: auto;
    display: flex;
    flex-direction: column;
    gap: 16px;
    padding-right: 4px;
  }

  .matrix-dimension-group {
    background: rgba(15, 23, 42, 0.5);
    border: 1px solid rgba(255, 255, 255, 0.05);
    border-radius: 14px;
    padding: 14px 16px;
  }

  .dim-group-title {
    display: block;
    font-size: 0.8rem;
    font-weight: 700;
    color: #a5b4fc;
    margin-bottom: 10px;
  }

  .matrix-chips-row {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(44px, 1fr));
    gap: 8px;
  }

  :global(.q-chip-btn) {
    aspect-ratio: 1;
    border-radius: 10px;
    border: 1px solid rgba(255, 255, 255, 0.08);
    background: rgba(255, 255, 255, 0.03);
    color: #94a3b8;
    font-size: 0.82rem;
    font-weight: 700;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: all 0.15s ease;
  }

  :global(.q-chip-btn:hover) {
    transform: scale(1.08);
    border-color: rgba(99, 102, 241, 0.5);
    color: #ffffff;
  }

  :global(.q-chip-btn.answered) {
    background: rgba(16, 185, 129, 0.15);
    border-color: rgba(16, 185, 129, 0.4);
    color: #6ee7b7;
  }

  :global(.q-chip-btn.current) {
    background: rgba(99, 102, 241, 0.35);
    border: 2px solid #818cf8;
    color: #ffffff;
    box-shadow: 0 0 12px rgba(99, 102, 241, 0.6);
    font-weight: 900;
  }

  .answered-counter {
    font-size: 0.88rem;
    color: #94a3b8;
    font-weight: 600;
  }

  /* STAGE 3: ANALYZING */
  .mbti-stage-analyzing {
    display: flex;
    justify-content: center;
    align-items: center;
    padding: 100px 20px;
  }

  .analyzing-box {
    background: #111422;
    border: 1px solid rgba(99, 102, 241, 0.3);
    border-radius: 24px;
    padding: 50px 40px;
    text-align: center;
    max-width: 540px;
    box-shadow: 0 20px 50px rgba(0, 0, 0, 0.7);
  }

  .analyzing-spinner {
    position: relative;
    width: 90px;
    height: 90px;
    margin: 0 auto 30px;
  }

  .spinner-ring {
    position: absolute;
    inset: 0;
    border-radius: 50%;
    border: 4px solid rgba(99, 102, 241, 0.15);
    border-top-color: #6366f1;
    animation: spin 1.2s cubic-bezier(0.68, -0.55, 0.27, 1.55) infinite;
  }

  .spinner-core {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 2.2rem;
  }

  @keyframes spin {
    to { transform: rotate(360deg); }
  }

  .analyzing-title {
    font-size: 1.5rem;
    font-weight: 800;
    color: #f8fafc;
    margin: 0 0 24px;
  }

  .analyzing-steps {
    display: flex;
    flex-direction: column;
    gap: 12px;
    text-align: left;
  }

  .step-item {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 0.92rem;
    color: #64748b;
  }

  .step-item .check {
    opacity: 0.2;
    font-weight: 900;
  }

  .step-item.done {
    color: #cbd5e1;
  }
  .step-item.done .check {
    color: #10b981;
    opacity: 1;
  }

  /* STAGE 4: DETAILED RESULT DASHBOARD */
  .result-hero-card {
    position: relative;
    background: linear-gradient(135deg, rgba(26, 32, 54, 0.95) 0%, rgba(35, 25, 66, 0.85) 100%);
    border: 1px solid rgba(99, 102, 241, 0.35);
    border-radius: 28px;
    padding: 44px 36px;
    margin-bottom: 32px;
    overflow: hidden;
    box-shadow: 0 20px 40px -15px rgba(0, 0, 0, 0.6), 0 0 0 1px rgba(99, 102, 241, 0.15);
  }

  .result-hero-backdrop {
    position: absolute;
    top: -50%;
    right: -20%;
    width: 600px;
    height: 400px;
    background: radial-gradient(circle, rgba(99, 102, 241, 0.3) 0%, transparent 70%);
    filter: blur(60px);
    pointer-events: none;
  }

  .result-header-row {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    flex-wrap: wrap;
    gap: 20px;
    margin-bottom: 20px;
  }

  .result-badge-pill {
    display: inline-block;
    background: rgba(99, 102, 241, 0.2);
    border: 1px solid rgba(99, 102, 241, 0.4);
    color: #c7d2fe;
    font-size: 0.85rem;
    font-weight: 700;
    padding: 5px 16px;
    border-radius: 9999px;
    margin-bottom: 12px;
  }

  .result-type-code {
    font-size: 4.2rem;
    font-weight: 900;
    line-height: 1;
    letter-spacing: -0.04em;
    margin: 0 0 8px;
    background: linear-gradient(135deg, #ffffff 30%, #a5b4fc 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .result-type-name {
    font-size: 1.8rem;
    font-weight: 800;
    color: #f8fafc;
    margin: 0;
  }

  .result-actions-top {
    display: flex;
    gap: 12px;
  }

  .btn-share-result, .btn-retake-test {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 0.92rem;
    font-weight: 800;
    padding: 12px 22px;
    border-radius: 12px;
    border: none;
    cursor: pointer;
    transition: transform 0.15s, box-shadow 0.15s;
  }

  .btn-share-result {
    background: linear-gradient(135deg, #6366f1 0%, #a855f7 100%);
    color: #ffffff;
    box-shadow: 0 6px 18px rgba(99, 102, 241, 0.5);
  }

  .btn-retake-test {
    background: rgba(30, 41, 59, 0.8);
    border: 1px solid rgba(255, 255, 255, 0.12);
    color: #e2e8f0;
  }

  .result-keywords-row {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-bottom: 20px;
  }

  :global(.keyword-pill) {
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid rgba(255, 255, 255, 0.08);
    color: #93c5fd;
    font-size: 0.82rem;
    font-weight: 700;
    padding: 4px 12px;
    border-radius: 8px;
  }

  .result-motto {
    font-size: 1.15rem;
    font-style: italic;
    color: #cbd5e1;
    margin: 0 0 36px;
    padding-left: 18px;
    border-left: 4px solid #6366f1;
    line-height: 1.6;
  }

  /* Dimension Breakdown Meters & Situational Flexibility */
  .dimensions-breakdown-card {
    background: rgba(15, 23, 42, 0.75);
    border: 1px solid rgba(99, 102, 241, 0.28);
    border-radius: 22px;
    padding: 28px 24px;
    box-shadow: 0 16px 40px rgba(0, 0, 0, 0.4);
  }

  .dimensions-header-group {
    margin-bottom: 22px;
  }

  .dimensions-title {
    font-size: 1.25rem;
    font-weight: 800;
    color: #f8fafc;
    margin: 0 0 8px;
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .dimensions-subtitle {
    font-size: 0.88rem;
    color: #94a3b8;
    margin: 0;
    line-height: 1.55;
  }

  .dim-meters-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    gap: 22px;
  }

  .dim-meter-row {
    display: flex;
    flex-direction: column;
    gap: 12px;
    background: rgba(30, 41, 59, 0.5);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 18px;
    padding: 18px;
    transition: all 0.2s ease;
  }

  .dim-meter-row:hover {
    border-color: rgba(99, 102, 241, 0.4);
    background: rgba(30, 41, 59, 0.7);
  }

  .dim-labels {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 0.85rem;
    color: #94a3b8;
    gap: 8px;
  }

  .dim-side {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    transition: all 0.2s;
  }

  .dim-side.dominant {
    color: #ffffff;
    font-weight: 800;
  }

  .dim-side.left.dominant .dim-code-letter {
    color: #38bdf8;
    text-shadow: 0 0 10px rgba(56, 189, 248, 0.6);
  }

  .dim-side.right.dominant .dim-code-letter {
    color: #f43f5e;
    text-shadow: 0 0 10px rgba(244, 63, 94, 0.6);
  }

  .dim-code-letter {
    font-size: 1rem;
    font-weight: 900;
  }

  .dim-name-text {
    font-size: 0.82rem;
  }

  .dim-pct-val {
    font-size: 0.8rem;
    font-weight: 800;
    padding: 2px 7px;
    border-radius: 6px;
    background: rgba(255, 255, 255, 0.06);
    color: #94a3b8;
  }

  .dim-side.dominant .dim-pct-val {
    background: rgba(99, 102, 241, 0.25);
    color: #e2e8f0;
    font-weight: 900;
    border: 1px solid rgba(99, 102, 241, 0.4);
  }

  .dim-score-badge {
    font-size: 0.75rem;
    font-weight: 800;
    color: #c7d2fe;
    background: rgba(99, 102, 241, 0.2);
    border: 1px solid rgba(99, 102, 241, 0.35);
    padding: 3px 10px;
    border-radius: 999px;
    white-space: nowrap;
    text-align: center;
  }

  .dim-score-badge.badge-balanced {
    background: linear-gradient(135deg, rgba(16, 185, 129, 0.25) 0%, rgba(99, 102, 241, 0.25) 100%);
    border-color: rgba(16, 185, 129, 0.5);
    color: #6ee7b7;
    box-shadow: 0 0 12px rgba(16, 185, 129, 0.25);
  }

  .dim-bar-track {
    position: relative;
    display: flex;
    height: 12px;
    background: rgba(255, 255, 255, 0.08);
    border-radius: 999px;
    overflow: hidden;
  }

  .dim-bar-divider {
    width: 2px;
    background: #0f172a;
    z-index: 1;
  }

  .dim-bar-fill.left {
    background: linear-gradient(90deg, #0284c7, #38bdf8);
    transition: width 0.6s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .dim-bar-fill.right {
    background: linear-gradient(90deg, #f43f5e, #e11d48);
    transition: width 0.6s cubic-bezier(0.16, 1, 0.3, 1);
  }

  /* Situational Insight Box */
  .dim-situational-desc {
    background: rgba(15, 23, 42, 0.7);
    border-left: 3px solid #6366f1;
    border-radius: 0 12px 12px 0;
    padding: 12px 14px;
    margin-top: 2px;
  }

  .sit-desc-header {
    display: flex;
    align-items: center;
    gap: 6px;
    margin-bottom: 6px;
  }

  .sit-tag {
    font-size: 0.74rem;
    font-weight: 800;
    color: #a5b4fc;
    letter-spacing: 0.3px;
  }

  .sit-desc-text {
    font-size: 0.82rem;
    color: #cbd5e1;
    margin: 0;
    line-height: 1.6;
    word-break: keep-all;
  }

