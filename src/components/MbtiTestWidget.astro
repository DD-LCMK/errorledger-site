---
import { MBTI_QUESTIONS } from '../data/mbtiQuestions';
import { MBTI_PROFILES } from '../data/mbtiProfiles';
import { MBTI_PSYCHOLOGY_FACTS } from '../data/mbtiPsychologyFacts';
import { getMbtiCompatibility } from '../data/mbtiCompatibility';

interface Props {
  lang?: 'ko' | 'en';
}

const { lang = 'ko' } = Astro.props;
const isEn = lang === 'en';

// Serialize data safely into the page for client-side evaluation
const questionsJson = JSON.stringify(MBTI_QUESTIONS);
const profilesJson = JSON.stringify(MBTI_PROFILES);
const factsJson = JSON.stringify(MBTI_PSYCHOLOGY_FACTS);
---

<div class="mbti-widget-root" id="mbti-widget" data-lang={lang}>
  <!-- Inject Static JSON Data for Instant Reactive Rendering -->
  <script is:inline id="mbti-data-questions" type="application/json" set:html={questionsJson} />
  <script is:inline id="mbti-data-profiles" type="application/json" set:html={profilesJson} />
  <script is:inline id="mbti-data-facts" type="application/json" set:html={factsJson} />

  <!-- 1. INTRO / HERO STAGE -->
  <div class="mbti-stage mbti-stage-intro" id="stage-intro">
    <div class="intro-backdrop"></div>
    <div class="intro-content">
      <div class="intro-badge">
        <span class="sparkle">🧠</span>
        <span>{isEn ? 'Empirical 60-Question Jungian Cognitive Function Assessment' : '정통 60문항 융(Jung) 인지기능 기반 정밀 검사'}</span>
      </div>
      <h1 class="intro-title">
        {isEn ? 'Scientific MBTI & Cognitive Function Test' : '심층 정밀 MBTI & 인지기능 검사'}
      </h1>
      <p class="intro-desc">
        {isEn 
          ? 'Beyond superficial 4-letter labels. Discover your complete psychological blueprint, 8 cognitive function hierarchies, career strengths, love compatibility, and creator persona with scientific precision.'
          : '단순한 16가지 알파벳 딱지를 넘어, 4대 성향 축의 정밀 백분율과 8대 인지기능 위계(주/부/3차/열등기능), 5대 강점, 스트레스 루프, 직업, 연애 및 크리에이터 성향까지 완벽하게 분석합니다.'}
      </p>

      <!-- Key Scientific Features Grid -->
      <div class="intro-features-grid">
        <div class="feature-item">
          <span class="feat-icon">🎯</span>
          <div class="feat-text">
            <strong>{isEn ? '60 Balanced Items' : '60개 균형 문항'}</strong>
            <span>{isEn ? '15 items per axis across 3 sub-facets' : '축당 15문항 & 3대 세부 하위 척도 정밀 측정'}</span>
          </div>
        </div>
        <div class="feature-item">
          <span class="feat-icon">⚖️</span>
          <div class="feat-text">
            <strong>{isEn ? 'Acquiescence Bias Free' : '역채점 편향 제거'}</strong>
            <span>{isEn ? 'Equally balanced reverse-keyed questions' : '동의 편향을 수학적으로 상쇄하는 균형 역채점'}</span>
          </div>
        </div>
        <div class="feature-item">
          <span class="feat-icon">🔬</span>
          <div class="feat-text">
            <strong>{isEn ? 'Cognitive Function Stack' : '8대 인지기능 위계'}</strong>
            <span>{isEn ? 'Dominant, Auxiliary, Tertiary, Inferior' : '두뇌 정보 처리 엔진(주/부/3차/열등기능) 분석'}</span>
          </div>
        </div>
        <div class="feature-item">
          <span class="feat-icon">⏱️</span>
          <div class="feat-text">
            <strong>{isEn ? 'Fast & Seamless' : '약 6~8분 소요'}</strong>
            <span>{isEn ? 'Fast card pagination & keyboard shortcuts' : '카드형 UI 및 데스크톱 1~7번 단축키 지원'}</span>
          </div>
        </div>
      </div>

      <!-- Action Button -->
      <div class="intro-cta-wrap">
        <button type="button" class="btn-start-test" id="btn-start-test">
          <span>{isEn ? 'Begin Deep Assessment →' : '정밀 검사 시작하기 →'}</span>
        </button>
        <span class="time-estimate-note">
          {isEn ? '⚡ 100% Free • No registration or email required • Instant results' : '⚡ 100% 무료 • 로그인/회원가입 없음 • 즉시 결과 확인'}
        </span>
      </div>
    </div>
  </div>

  <!-- 2. TEST RUNNER STAGE -->
  <div class="mbti-stage mbti-stage-runner" id="stage-runner" style="display: none;">
    <!-- Sticky Progress Header -->
    <div class="runner-header">
      <div class="runner-header-inner">
        <div class="progress-meta">
          <span class="progress-step-text" id="progress-step-text">문항 1 / 60</span>
          <span class="current-facet-badge" id="current-facet-badge">외향 vs 내향</span>
        </div>
        <div class="progress-track">
          <div class="progress-fill" id="progress-fill" style="width: 1.6%;"></div>
        </div>
        <div class="runner-controls-top">
          <button type="button" class="btn-toggle-grid" id="btn-toggle-grid" title={isEn ? "Open Question Map (1-60)" : "전체 문항 지도 (1~60)"}>
            <span class="grid-icon">📋</span>
            <span class="grid-label">{isEn ? 'Question Map' : '전체 문항 (1~60)'}</span>
          </button>
          <span class="keyboard-tip-tag">{isEn ? '⌨️ Press 1-7' : '⌨️ 키보드 1~7번'}</span>
        </div>
      </div>
    </div>

    <!-- Question Container (Smooth card animation) -->
    <div class="question-deck-container">
      <div class="question-card" id="active-question-card">
        <!-- Return to Latest Question Banner (Visible when reviewing earlier question) -->
        <div class="return-latest-bar" id="return-latest-bar" style="display: none;">
          <div class="return-bar-content">
            <span class="return-icon">📍</span>
            <span class="return-msg">{isEn ? 'Reviewing previous question' : '이전 문항 검토/수정 중'}</span>
          </div>
          <button type="button" class="btn-return-latest" id="btn-return-latest">
            <span>{isEn ? '🚀 Return to Q.' : '🚀 마지막 진행 문항으로 복귀 (Q.'}<span id="latest-q-num">59</span>{isEn ? '' : ')'}</span>
          </button>
        </div>

        <div class="question-card-header">
          <span class="q-number-pill" id="q-number-pill">Q.01</span>
          <span class="q-dimension-pill" id="q-dimension-pill">사회적 에너지 충전</span>
        </div>

        <h2 class="question-text" id="question-text">
          많은 사람들과 교류하고 대화할수록 활력과 생기가 샘솟는 것을 느낀다.
        </h2>

        <!-- 7-Point Likert Scale Buttons -->
        <div class="likert-scale-wrap">
          <div class="likert-labels-row">
            <span class="label-disagree">{isEn ? 'Disagree' : '동의하지 않음'}</span>
            <span class="label-neutral">{isEn ? 'Neutral' : '보통'}</span>
            <span class="label-agree">{isEn ? 'Agree' : '동의함'}</span>
          </div>

          <div class="likert-buttons-row" role="radiogroup" aria-label="Rating scale 1 to 7">
            <button type="button" class="likert-btn btn-score-1" data-score="1" aria-label={isEn ? "1 - Strongly Disagree" : "1 - 매우 비동의"}>
              <span class="btn-circle"></span>
              <span class="btn-tag">{isEn ? 'Strongly Disagree' : '매우 비동의'}</span>
            </button>
            <button type="button" class="likert-btn btn-score-2" data-score="2" aria-label={isEn ? "2 - Disagree" : "2 - 비동의"}>
              <span class="btn-circle"></span>
              <span class="btn-tag">{isEn ? 'Disagree' : '비동의'}</span>
            </button>
            <button type="button" class="likert-btn btn-score-3" data-score="3" aria-label={isEn ? "3 - Slightly Disagree" : "3 - 약간 비동의"}>
              <span class="btn-circle"></span>
              <span class="btn-tag">{isEn ? 'Slightly Disagree' : '약간 비동의'}</span>
            </button>
            <button type="button" class="likert-btn btn-score-4" data-score="4" aria-label={isEn ? "4 - Neutral" : "4 - 보통"}>
              <span class="btn-circle"></span>
              <span class="btn-tag">{isEn ? 'Neutral' : '보통'}</span>
            </button>
            <button type="button" class="likert-btn btn-score-5" data-score="5" aria-label={isEn ? "5 - Slightly Agree" : "5 - 약간 동의"}>
              <span class="btn-circle"></span>
              <span class="btn-tag">{isEn ? 'Slightly Agree' : '약간 동의'}</span>
            </button>
            <button type="button" class="likert-btn btn-score-6" data-score="6" aria-label={isEn ? "6 - Agree" : "6 - 동의"}>
              <span class="btn-circle"></span>
              <span class="btn-tag">{isEn ? 'Agree' : '동의'}</span>
            </button>
            <button type="button" class="likert-btn btn-score-7" data-score="7" aria-label={isEn ? "7 - Strongly Agree" : "7 - 매우 동의"}>
              <span class="btn-circle"></span>
              <span class="btn-tag">{isEn ? 'Strongly Agree' : '매우 동의'}</span>
            </button>
          </div>
        </div>

        <!-- Navigation Buttons -->
        <div class="question-nav-row">
          <button type="button" class="btn-nav-prev" id="btn-nav-prev" disabled>
            <span>{isEn ? '← Previous' : '← 이전 문항'}</span>
          </button>
          
          <div class="nav-center-group">
            <button type="button" class="btn-open-matrix" id="btn-open-matrix" title={isEn ? "Open full question list" : "전체 문항 목록 열기"}>
              <span id="answered-counter">0 / 60 완료</span>
              <span class="matrix-pill-tag">📋 {isEn ? 'Jump' : '문항 이동'}</span>
            </button>
            <button type="button" class="btn-nav-return-pill" id="btn-nav-return-pill" style="display: none;">
              <span>🚀 Q.<span id="nav-latest-num">59</span> {isEn ? 'Return' : '복귀'}</span>
            </button>
          </div>

          <button type="button" class="btn-nav-next" id="btn-nav-next">
            <span>{isEn ? 'Next →' : '다음 문항 →'}</span>
          </button>
        </div>
      </div>
    </div>

    <!-- Question Matrix / Navigator Modal Drawer -->
    <div class="question-matrix-modal" id="question-matrix-modal" style="display: none;">
      <div class="matrix-modal-backdrop" id="matrix-modal-backdrop"></div>
      <div class="matrix-modal-card">
        <div class="matrix-modal-header">
          <div class="matrix-title-group">
            <h3>📋 {isEn ? 'Question Navigator (1 to 60)' : '전체 60문항 바로가기 & 응답 현황'}</h3>
            <p>{isEn ? 'Click any question to jump directly and review or edit your response.' : '원하는 문항 번호를 클릭하면 즉시 해당 문항으로 이동하여 답변을 확인 및 수정할 수 있습니다.'}</p>
          </div>
          <button type="button" class="btn-close-matrix" id="btn-close-matrix" aria-label="Close">✕</button>
        </div>

        <div class="matrix-legend-row">
          <span class="legend-item"><span class="legend-dot answered"></span>{isEn ? 'Answered' : '답변 완료'}</span>
          <span class="legend-item"><span class="legend-dot current"></span>{isEn ? 'Current' : '현재 문항'}</span>
          <span class="legend-item"><span class="legend-dot unanswered"></span>{isEn ? 'Unanswered' : '미답변'}</span>
        </div>

        <div class="matrix-farthest-action" id="matrix-farthest-wrap" style="display: none;">
          <button type="button" class="btn-matrix-return-latest" id="btn-matrix-return-latest">
            <span>🚀 {isEn ? 'Jump to Farthest Progress (Q.' : '마지막 진행 문항으로 바로 이동 (Q.'}<span id="matrix-latest-q-num">59</span>{isEn ? ')' : ')'}</span>
          </button>
        </div>

        <div class="matrix-grid-scroll">
          <div class="matrix-dimension-group">
            <span class="dim-group-title">E vs I ({isEn ? 'Extraversion vs Introversion' : '외향 vs 내향'}) — Q.01 ~ Q.15</span>
            <div class="matrix-chips-row" id="matrix-group-ei"></div>
          </div>
          <div class="matrix-dimension-group">
            <span class="dim-group-title">S vs N ({isEn ? 'Sensing vs Intuition' : '감각 vs 직관'}) — Q.16 ~ Q.30</span>
            <div class="matrix-chips-row" id="matrix-group-sn"></div>
          </div>
          <div class="matrix-dimension-group">
            <span class="dim-group-title">T vs F ({isEn ? 'Thinking vs Feeling' : '사고 vs 감정'}) — Q.31 ~ Q.45</span>
            <div class="matrix-chips-row" id="matrix-group-tf"></div>
          </div>
          <div class="matrix-dimension-group">
            <span class="dim-group-title">J vs P ({isEn ? 'Judging vs Perceiving' : '판단 vs 인식'}) — Q.46 ~ Q.60</span>
            <div class="matrix-chips-row" id="matrix-group-jp"></div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- 3. ANALYZING / LOADING STAGE -->
  <div class="mbti-stage mbti-stage-analyzing" id="stage-analyzing" style="display: none;">
    <div class="analyzing-box">
      <div class="analyzing-spinner">
        <div class="spinner-ring"></div>
        <div class="spinner-core">🧠</div>
      </div>
      <h2 class="analyzing-title">{isEn ? 'Synthesizing Your Psychological Blueprint...' : '심층 심리 인지 모델 분석 중...'}</h2>
      <div class="analyzing-steps">
        <div class="step-item done" id="ana-step-1">
          <span class="check">✓</span>
          <span>{isEn ? 'Raw dimensional score deviations calculated' : '4대 성향 축 원점수 및 중심화 편차 계산'}</span>
        </div>
        <div class="step-item" id="ana-step-2">
          <span class="check">✓</span>
          <span>{isEn ? 'Mapping 8-layer Jungian cognitive function stack' : '융(Jung) 8대 인지기능 위계 스택 매핑'}</span>
        </div>
        <div class="step-item" id="ana-step-3">
          <span class="check">✓</span>
          <span>{isEn ? 'Generating detailed 16-type behavioral blueprint' : '16대 심층 다층 리포트 데이터 생성 완료'}</span>
        </div>
      </div>
    </div>
  </div>

  <!-- 4. DETAILED RESULT DASHBOARD STAGE -->
  <div class="mbti-stage mbti-stage-result" id="stage-result" style="display: none;">
    <!-- Result Top Banner Card -->
    <div class="result-hero-card">
      <div class="result-hero-backdrop"></div>
      
      <div class="result-header-row">
        <div class="result-title-badge-box">
          <span class="result-badge-pill" id="res-badge-pill">🏛️ 전략과 통찰의 마스터</span>
          <h1 class="result-type-code" id="res-type-code">INTJ</h1>
          <h2 class="result-type-name" id="res-type-name">용의주도한 전략가</h2>
        </div>

        <div class="result-actions-top">
          <button type="button" class="btn-share-result" id="btn-share-result">
            <span>🔗 {isEn ? 'Share My Result' : '결과 공유 / 링크 복사'}</span>
          </button>
          <button type="button" class="btn-retake-test" id="btn-retake-test">
            <span>🔄 {isEn ? 'Retake Test' : '다시 검사하기'}</span>
          </button>
        </div>
      </div>

      <div class="result-keywords-row" id="res-keywords-row">
        <!-- Injected via JS -->
      </div>

      <blockquote class="result-motto" id="res-motto">
        "모든 문제는 치밀한 시스템과 통찰력으로 해결할 수 있다."
      </blockquote>

      <!-- Dimension Percentages Breakdown Grid -->
      <div class="dimensions-breakdown-card">
        <div class="dimensions-header-group">
          <div class="dim-title-wrap">
            <h3 class="dimensions-title">
              <span>📊</span>
              <span>{isEn ? '4-Dimensional Spectrum & Situational Flexibility Analysis' : '4대 심리 축 성향 스펙트럼 & 상황별 유연성 분석'}</span>
            </h3>
            <p class="dimensions-subtitle">
              {isEn 
                ? '💡 The meaning of percentages: Scores near 100% mean high behavioral consistency in any context, while scores near 50% indicate situational flexibility—adapting between traits depending on your role, context, and environment.'
                : '💡 성향 백분율(%)의 비밀: 100%에 가까울수록 어떤 환경에서도 일관된 성향을 고수하며, 50%에 가까울수록 고정된 성격이 아니라 상황·맥락·상대방에 따라 두 성향을 유연하게 넘나드는 입체적 행동 양식을 가집니다.'}
            </p>
          </div>
        </div>
        
        <div class="dim-meters-grid">
          <!-- EI Meter -->
          <div class="dim-meter-row" id="dim-row-ei">
            <div class="dim-labels">
              <span class="dim-side left" id="dim-side-e">
                <strong class="dim-code-letter">E</strong>
                <span class="dim-name-text">{isEn ? 'Extravert' : '외향형'}</span>
                <span class="dim-pct-val" id="dim-pct-e">50%</span>
              </span>
              <span class="dim-score-badge" id="dim-badge-ei">50% 내향 (균형형)</span>
              <span class="dim-side right" id="dim-side-i">
                <span class="dim-pct-val" id="dim-pct-i">50%</span>
                <span class="dim-name-text">{isEn ? 'Introvert' : '내향형'}</span>
                <strong class="dim-code-letter">I</strong>
              </span>
            </div>
            <div class="dim-bar-track">
              <div class="dim-bar-fill left" id="dim-fill-ei-left" style="width: 50%;"></div>
              <div class="dim-bar-divider"></div>
              <div class="dim-bar-fill right" id="dim-fill-ei-right" style="width: 50%;"></div>
            </div>
            <div class="dim-situational-desc" id="dim-desc-ei"></div>
          </div>

          <!-- SN Meter -->
          <div class="dim-meter-row" id="dim-row-sn">
            <div class="dim-labels">
              <span class="dim-side left" id="dim-side-s">
                <strong class="dim-code-letter">S</strong>
                <span class="dim-name-text">{isEn ? 'Sensing' : '감각형'}</span>
                <span class="dim-pct-val" id="dim-pct-s">50%</span>
              </span>
              <span class="dim-score-badge" id="dim-badge-sn">50% 직관 (균형형)</span>
              <span class="dim-side right" id="dim-side-n">
                <span class="dim-pct-val" id="dim-pct-n">50%</span>
                <span class="dim-name-text">{isEn ? 'Intuition' : '직관형'}</span>
                <strong class="dim-code-letter">N</strong>
              </span>
            </div>
            <div class="dim-bar-track">
              <div class="dim-bar-fill left" id="dim-fill-sn-left" style="width: 50%;"></div>
              <div class="dim-bar-divider"></div>
              <div class="dim-bar-fill right" id="dim-fill-sn-right" style="width: 50%;"></div>
            </div>
            <div class="dim-situational-desc" id="dim-desc-sn"></div>
          </div>

          <!-- TF Meter -->
          <div class="dim-meter-row" id="dim-row-tf">
            <div class="dim-labels">
              <span class="dim-side left" id="dim-side-t">
                <strong class="dim-code-letter">T</strong>
                <span class="dim-name-text">{isEn ? 'Thinking' : '사고형'}</span>
                <span class="dim-pct-val" id="dim-pct-t">50%</span>
              </span>
              <span class="dim-score-badge" id="dim-badge-tf">50% 사고 (균형형)</span>
              <span class="dim-side right" id="dim-side-f">
                <span class="dim-pct-val" id="dim-pct-f">50%</span>
                <span class="dim-name-text">{isEn ? 'Feeling' : '감정형'}</span>
                <strong class="dim-code-letter">F</strong>
              </span>
            </div>
            <div class="dim-bar-track">
              <div class="dim-bar-fill left" id="dim-fill-tf-left" style="width: 50%;"></div>
              <div class="dim-bar-divider"></div>
              <div class="dim-bar-fill right" id="dim-fill-tf-right" style="width: 50%;"></div>
            </div>
            <div class="dim-situational-desc" id="dim-desc-tf"></div>
          </div>

          <!-- JP Meter -->
          <div class="dim-meter-row" id="dim-row-jp">
            <div class="dim-labels">
              <span class="dim-side left" id="dim-side-j">
                <strong class="dim-code-letter">J</strong>
                <span class="dim-name-text">{isEn ? 'Judging' : '판단형'}</span>
                <span class="dim-pct-val" id="dim-pct-j">50%</span>
              </span>
              <span class="dim-score-badge" id="dim-badge-jp">50% 판단 (균형형)</span>
              <span class="dim-side right" id="dim-side-p">
                <span class="dim-pct-val" id="dim-pct-p">50%</span>
                <span class="dim-name-text">{isEn ? 'Perceiving' : '인식형'}</span>
                <strong class="dim-code-letter">P</strong>
              </span>
            </div>
            <div class="dim-bar-track">
              <div class="dim-bar-fill left" id="dim-fill-jp-left" style="width: 50%;"></div>
              <div class="dim-bar-divider"></div>
              <div class="dim-bar-fill right" id="dim-fill-jp-right" style="width: 50%;"></div>
            </div>
            <div class="dim-situational-desc" id="dim-desc-jp"></div>
          </div>
        </div>
