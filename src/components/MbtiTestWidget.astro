                        <div class="subscore-fill work" id="compat-bar-work" style="width: 95%;"></div>
                      </div>
                    </div>
                    <div class="subscore-item">
                      <div class="subscore-info">
                        <span class="sub-label">🛡️ {isEn ? 'Conflict Recovery' : '갈등 회복 & 안정성'}</span>
                        <span class="sub-val" id="compat-sub-recovery">92%</span>
                      </div>
                      <div class="subscore-track">
