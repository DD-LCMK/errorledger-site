  /* Question Card */
  .question-deck-container {
    perspective: 1000px;
  }

  .question-card {
    background: #111422;
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 24px;
    padding: 48px 36px 40px;
    box-shadow: 0 20px 45px -15px rgba(0, 0, 0, 0.6), 0 0 0 1px rgba(99, 102, 241, 0.12);
  }

  .question-card-header {
    display: flex;
    align-items: center;
    gap: 12px;
