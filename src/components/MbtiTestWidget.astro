  }

  .time-estimate-note {
    font-size: 0.85rem;
    color: #64748b;
  }

  /* STAGE 2: TEST RUNNER */
  .mbti-stage-runner {
    padding: 20px 0 60px;
  }

  .runner-header {
    background: rgba(17, 24, 39, 0.95);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 16px;
    padding: 16px 22px;
    margin-bottom: 24px;
    backdrop-filter: blur(12px);
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.4);
  }

  .progress-meta {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 10px;
  }

  .progress-step-text {
    font-size: 1rem;
    font-weight: 800;
    color: #a5b4fc;
  }

  .current-facet-badge {
    font-size: 0.82rem;
    font-weight: 700;
