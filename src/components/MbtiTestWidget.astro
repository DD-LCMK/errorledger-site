              <div class="persona-icon-box">💬</div>
              <div class="persona-text-box">
                <h4>{isEn ? 'Viewer Interaction & Chatroom Dynamics' : '시청자 소통 및 채팅창 분위기'}</h4>
                <p id="res-streamer-chat"></p>
