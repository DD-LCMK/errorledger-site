  .cog-card.auxiliary { border-color: rgba(56, 189, 248, 0.4); }
  .cog-card.tertiary { border-color: rgba(245, 158, 11, 0.4); }
  .cog-card.inferior { border-color: rgba(239, 68, 68, 0.4); }

