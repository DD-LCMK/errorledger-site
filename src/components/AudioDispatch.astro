---
interface Props {
  duration?: string;
  title?: string;
  lang?: string;
  slug?: string;
  audioUrl?: string;
}

const {
  duration = "2:30",
  title = "Incident Dispatch Overview",
  lang = "en",
  slug = "",
  audioUrl = `/audio/${lang}/${slug}.mp3`
} = Astro.props;

const isKorean = lang === 'ko';
---

<div class="audio-dispatch-player" data-lang={lang} data-audio-src={audioUrl}>
  <!-- Native Audio Tag for Studio Neural Quality -->
  <audio id="neural-audio-elem" src={audioUrl} preload="metadata"></audio>

  <div class="dispatch-left">
    <button id="dispatch-play-btn" class="dispatch-play-circle" aria-label={isKorean ? "오디오 브리핑 재생" : "Play dispatch audio"}>
      <svg id="play-icon" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><polygon points="5 3 19 12 5 21 5 3"></polygon></svg>
      <svg id="pause-icon" class="hidden" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><rect x="6" y="4" width="4" height="16"></rect><rect x="14" y="4" width="4" height="16"></rect></svg>
    </button>
    <div class="dispatch-meta">
      <div class="dispatch-tag-row">
        <span class="dispatch-tag">{isKorean ? "아키비스트의 오디오 브리핑" : "The Archivist's Audio Dispatch"}</span>
        <span class="dispatch-voice-tag" id="dispatch-quality-badge">{isKorean ? "🎙️ 스튜디오 AI 보이스" : "🎙️ Studio Neural Voice"}</span>
      </div>
      <div class="dispatch-title">{title}</div>
    </div>
  </div>

  <div class="dispatch-right">
    <!-- Waveform Visualizer Bars -->
    <div class="waveform-container">
      <span class="wave-bar bar-1"></span>
      <span class="wave-bar bar-2"></span>
      <span class="wave-bar bar-3"></span>
      <span class="wave-bar bar-4"></span>
      <span class="wave-bar bar-5"></span>
      <span class="wave-bar bar-6"></span>
    </div>

    <span id="dispatch-timer" class="dispatch-timer-text">{duration}</span>

    <button id="dispatch-speed-btn" class="speed-toggle-btn" title={isKorean ? "재생 속도 조절" : "Toggle narration speed"}>
      1.0x
    </button>
  </div>
</div>

<script is:inline>
  (function() {
    const playerEl = document.querySelector('.audio-dispatch-player');
    const audioElem = document.getElementById('neural-audio-elem');
    const pageLang = playerEl?.getAttribute('data-lang') || document.documentElement.lang || 'en';
    const isKo = pageLang === 'ko';

    const playBtn = document.getElementById('dispatch-play-btn');
    const playIcon = document.getElementById('play-icon');
    const pauseIcon = document.getElementById('pause-icon');
    const waveBars = document.querySelectorAll('.wave-bar');
    const speedBtn = document.getElementById('dispatch-speed-btn');
    const timer = document.getElementById('dispatch-timer');
    const qualityBadge = document.getElementById('dispatch-quality-badge');

    let isPlaying = false;
    let speed = 1.0;
    let useNeuralAudio = true;
    let currentUtterance = null;

    // Set initial audio volume
    if (audioElem) {
      audioElem.volume = 0.70; // Comfortable volume
    }

    // Check if neural MP3 is loaded
    audioElem?.addEventListener('loadedmetadata', () => {
      if (audioElem.duration && !isNaN(audioElem.duration)) {
        const mins = Math.floor(audioElem.duration / 60);
        const secs = Math.floor(audioElem.duration % 60);
        if (timer) timer.innerText = `${mins}:${secs < 10 ? '0' : ''}${secs}`;
      }
    });

    audioElem?.addEventListener('timeupdate', () => {
      if (audioElem.currentTime && timer) {
        const mins = Math.floor(audioElem.currentTime / 60);
        const secs = Math.floor(audioElem.currentTime % 60);
        timer.innerText = `${mins}:${secs < 10 ? '0' : ''}${secs}`;
      }
    });

    audioElem?.addEventListener('ended', () => {
      stopPlaying();
      if (audioElem.duration) {
        const mins = Math.floor(audioElem.duration / 60);
        const secs = Math.floor(audioElem.duration % 60);
        if (timer) timer.innerText = `${mins}:${secs < 10 ? '0' : ''}${secs}`;
      }
    });

    audioElem?.addEventListener('error', () => {
      // Fallback to Web Speech Synthesis if MP3 is missing
      useNeuralAudio = false;
      if (qualityBadge) {
        qualityBadge.innerText = isKo ? "AI 음성 내레이션" : "Device TTS Narration";
      }
    });

    function getArticleText() {
      const article = document.querySelector('article .prose');
      if (!article) return '';
      const elements = Array.from(article.querySelectorAll('h1, h2, p:not(.article-subtitle)'))
        .filter(el => !el.closest('#verdict-anchor') && !el.closest('.provenance-badge-box'))
        .slice(0, 7);
      return elements.map(el => el.innerText.trim()).filter(Boolean).join('. ');
    }

    function startSpeakingFallback() {
      if ('speechSynthesis' in window) {
        window.speechSynthesis.cancel();
        const text = getArticleText();
        currentUtterance = new SpeechSynthesisUtterance(text);
        currentUtterance.rate = speed;
        currentUtterance.volume = 0.65;

        const voices = window.speechSynthesis.getVoices();
        if (isKo) {
          currentUtterance.lang = 'ko-KR';
          const koVoice = voices.find(v => v.lang.includes('ko') || v.name.includes('Korean') || v.name.includes('Yuna') || v.name.includes('Heami'));
          if (koVoice) currentUtterance.voice = koVoice;
        } else {
          currentUtterance.lang = 'en-US';
          const enVoice = voices.find(v => v.lang.startsWith('en') && (v.name.includes('Natural') || v.name.includes('Google') || v.name.includes('Daniel')));
          if (enVoice) currentUtterance.voice = enVoice;
        }

        currentUtterance.onend = stopPlaying;
        currentUtterance.onerror = stopPlaying;
        window.speechSynthesis.speak(currentUtterance);
      }
    }

    function startPlaying() {
      isPlaying = true;
      playIcon?.classList.add('hidden');
      pauseIcon?.classList.remove('hidden');
      waveBars.forEach(bar => bar.classList.add('playing'));

      if (useNeuralAudio && audioElem && audioElem.src) {
        audioElem.playbackRate = speed;
        audioElem.play().catch(() => {
          useNeuralAudio = false;
          startSpeakingFallback();
        });
      } else {
        startSpeakingFallback();
      }
    }

    function stopPlaying() {
      isPlaying = false;
      playIcon?.classList.remove('hidden');
      pauseIcon?.classList.add('hidden');
      waveBars.forEach(bar => bar.classList.remove('playing'));

      if (audioElem) {
        audioElem.pause();
      }
      if ('speechSynthesis' in window) {
        window.speechSynthesis.cancel();
      }
    }

    playBtn?.addEventListener('click', () => {
      if (isPlaying) {
        stopPlaying();
      } else {
        startPlaying();
      }
    });

    speedBtn?.addEventListener('click', () => {
      speed = speed === 1.0 ? 1.25 : speed === 1.25 ? 1.5 : 1.0;
      if (speedBtn) speedBtn.innerText = `${speed.toFixed(2).replace(/\.?0+$/, '')}x`;
      if (audioElem) audioElem.playbackRate = speed;
      if (!useNeuralAudio && isPlaying) {
        window.speechSynthesis.cancel();
        startSpeakingFallback();
      }
    });

    window.addEventListener('beforeunload', () => {
      stopPlaying();
    });
  })();
</script>

<style>
  .audio-dispatch-player {
    margin: 1.75rem 0;
    padding: 1rem 1.25rem;
    border-radius: 12px;
    background: #171717;
    border: 1px solid #262626;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    color: #e5e5e5;
  }

  .dispatch-left {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    min-width: 0;
  }

  .dispatch-play-circle {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: #f43f5e;
    border: none;
    color: #ffffff;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    cursor: pointer;
    box-shadow: 0 4px 12px rgba(244, 63, 94, 0.3);
    transition: background 0.15s ease, transform 0.15s ease;
  }
  .dispatch-play-circle:hover {
    background: #fb7185;
    transform: scale(1.05);
  }

  .dispatch-meta {
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }
  .dispatch-tag-row {
    display: flex;
    align-items: center;
    gap: 0.4rem;
  }
  .dispatch-tag {
    font-size: 0.72rem;
    font-family: ui-monospace, monospace;
    font-weight: 700;
    text-transform: uppercase;
    color: #fb7185;
  }
  .dispatch-voice-tag {
    font-size: 0.65rem;
    font-family: ui-monospace, monospace;
    background: rgba(244, 63, 94, 0.12);
    border: 1px solid rgba(244, 63, 94, 0.25);
    color: #fb7185;
    padding: 0.1rem 0.35rem;
    border-radius: 4px;
    font-weight: 600;
  }
  .dispatch-title {
    font-size: 0.9rem;
    font-weight: 600;
    color: #f5f5f5;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .dispatch-right {
    display: flex;
    align-items: center;
    gap: 1rem;
    flex-shrink: 0;
  }

  .waveform-container {
    display: flex;
    align-items: center;
    gap: 3px;
    height: 20px;
  }
  @media (max-width: 600px) {
    .waveform-container {
      display: none;
    }
  }

  .wave-bar {
    width: 3px;
    background-color: #404040;
    border-radius: 9999px;
    transition: background-color 0.2s ease;
  }
  .bar-1 { height: 8px; }
  .bar-2 { height: 16px; }
  .bar-3 { height: 20px; }
  .bar-4 { height: 12px; }
  .bar-5 { height: 18px; }
  .bar-6 { height: 10px; }

  .wave-bar.playing {
    background-color: #f43f5e;
    animation: wavePulse 0.8s ease-in-out infinite alternate;
  }
  .bar-1.playing { animation-delay: 0.1s; }
  .bar-2.playing { animation-delay: 0.3s; }
  .bar-3.playing { animation-delay: 0.2s; }
  .bar-4.playing { animation-delay: 0.4s; }
  .bar-5.playing { animation-delay: 0.15s; }
  .bar-6.playing { animation-delay: 0.35s; }

  @keyframes wavePulse {
    0% { transform: scaleY(0.4); }
    100% { transform: scaleY(1.2); }
  }

  .dispatch-timer-text {
    font-size: 0.8rem;
    font-family: ui-monospace, monospace;
    color: #a3a3a3;
  }

  .speed-toggle-btn {
    font-size: 0.75rem;
    font-family: ui-monospace, monospace;
    font-weight: 700;
    padding: 0.25rem 0.5rem;
    border-radius: 6px;
    background: #262626;
    border: 1px solid #333333;
    color: #e5e5e5;
    cursor: pointer;
    transition: background 0.15s ease;
  }
  .speed-toggle-btn:hover {
    background: #333333;
    color: #ffffff;
  }

  .hidden {
    display: none !important;
  }

  /* Light mode styles */
  :global(html:not(.dark)) .audio-dispatch-player {
    background: #f8fafc;
    border-color: #e2e8f0;
    color: #0f172a;
  }
  :global(html:not(.dark)) .dispatch-title { color: #0f172a; }
  :global(html:not(.dark)) .dispatch-voice-tag { background: #fee2e2; border-color: #fca5a5; color: #e11d48; }
  :global(html:not(.dark)) .speed-toggle-btn { background: #e2e8f0; border-color: #cbd5e1; color: #0f172a; }
</style>
