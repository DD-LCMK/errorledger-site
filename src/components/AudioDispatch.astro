---
interface Props {
  duration?: string;
  title?: string;
}

const {
  duration = "3:45",
  title = "Incident Dispatch Overview"
} = Astro.props;
---

<div class="audio-dispatch-player">
  <div class="dispatch-left">
    <button id="dispatch-play-btn" class="dispatch-play-circle" aria-label="Play dispatch audio">
      <svg id="play-icon" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><polygon points="5 3 19 12 5 21 5 3"></polygon></svg>
      <svg id="pause-icon" class="hidden" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><rect x="6" y="4" width="4" height="16"></rect><rect x="14" y="4" width="4" height="16"></rect></svg>
    </button>
    <div class="dispatch-meta">
      <div class="dispatch-tag-row">
        <span class="dispatch-tag">The Archivist's Audio Dispatch</span>
        <span class="dispatch-voice-tag">AI Voice Narration</span>
      </div>
      <div class="dispatch-title">{title}</div>
    </div>
  </div>

  <div class="dispatch-right">
    <!-- Waveform Visualizer Bars -->
    <div class="waveform-container">
      <span class="wave-bar bar-1"></span>
      <span class="wave-bar bar-2"></span>
      <span class="wave-bar bar-3"></span>
      <span class="wave-bar bar-4"></span>
      <span class="wave-bar bar-5"></span>
      <span class="wave-bar bar-6"></span>
    </div>

    <span id="dispatch-timer" class="dispatch-timer-text">{duration}</span>

    <button id="dispatch-speed-btn" class="speed-toggle-btn" title="Toggle narration speed">
      1.0x
    </button>
  </div>
</div>

<script is:inline>
  (function() {
    const playBtn = document.getElementById('dispatch-play-btn');
    const playIcon = document.getElementById('play-icon');
    const pauseIcon = document.getElementById('pause-icon');
    const waveBars = document.querySelectorAll('.wave-bar');
    const speedBtn = document.getElementById('dispatch-speed-btn');
    const timer = document.getElementById('dispatch-timer');

    let isPlaying = false;
    let currentSeconds = 0;
    let timerInterval = null;
    let speed = 1.0;
    let currentUtterance = null;

    function getArticleText() {
      const article = document.querySelector('article .prose');
      if (!article) return '';
      // Get title and first few paragraphs
      const paragraphs = Array.from(article.querySelectorAll('p, h2, h3'))
        .slice(0, 8)
        .map(p => p.innerText)
        .join('. ');
      return paragraphs;
    }

    function startSpeaking() {
      if ('speechSynthesis' in window) {
        window.speechSynthesis.cancel(); // Stop any ongoing speech
        const text = getArticleText();
        currentUtterance = new SpeechSynthesisUtterance(text);
        currentUtterance.rate = speed;
        currentUtterance.pitch = 0.95; // Slightly deeper, archival tone

        // Pick a natural English voice if available
        const voices = window.speechSynthesis.getVoices();
        const preferredVoice = voices.find(v => v.lang.startsWith('en') && (v.name.includes('Natural') || v.name.includes('Google') || v.name.includes('Daniel') || v.name.includes('Arthur')));
        if (preferredVoice) {
          currentUtterance.voice = preferredVoice;
        }

        currentUtterance.onend = function() {
          stopPlaying();
        };
        currentUtterance.onerror = function() {
          stopPlaying();
        };

        window.speechSynthesis.speak(currentUtterance);
      }
    }

    function stopSpeaking() {
      if ('speechSynthesis' in window) {
        window.speechSynthesis.cancel();
      }
    }

    function startPlaying() {
      isPlaying = true;
      playIcon?.classList.add('hidden');
      pauseIcon?.classList.remove('hidden');
      waveBars.forEach(bar => bar.classList.add('playing'));
      
      timerInterval = setInterval(() => {
        currentSeconds++;
        const mins = Math.floor(currentSeconds / 60);
        const secs = currentSeconds % 60;
        if (timer) timer.innerText = `${mins}:${secs < 10 ? '0' : ''}${secs}`;
      }, 1000);

      startSpeaking();
    }

    function stopPlaying() {
      isPlaying = false;
      playIcon?.classList.remove('hidden');
      pauseIcon?.classList.add('hidden');
      waveBars.forEach(bar => bar.classList.remove('playing'));
      if (timerInterval) clearInterval(timerInterval);
      stopSpeaking();
    }

    playBtn?.addEventListener('click', () => {
      if (isPlaying) {
        stopPlaying();
      } else {
        startPlaying();
      }
    });

    speedBtn?.addEventListener('click', () => {
      speed = speed === 1.0 ? 1.5 : speed === 1.5 ? 2.0 : 1.0;
      if (speedBtn) speedBtn.innerText = `${speed.toFixed(1)}x`;
      if (isPlaying) {
        stopSpeaking();
        startSpeaking();
      }
    });

    // Cleanup when leaving page
    window.addEventListener('beforeunload', () => {
      stopSpeaking();
    });
  })();
</script>

<style>
  .audio-dispatch-player {
    margin: 1.75rem 0;
    padding: 1rem 1.25rem;
    border-radius: 12px;
    background: #171717;
    border: 1px solid #262626;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    color: #e5e5e5;
  }

  .dispatch-left {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    min-width: 0;
  }

  .dispatch-play-circle {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: #f43f5e;
    border: none;
    color: #ffffff;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    cursor: pointer;
    box-shadow: 0 4px 12px rgba(244, 63, 94, 0.3);
    transition: background 0.15s ease, transform 0.15s ease;
  }
  .dispatch-play-circle:hover {
    background: #fb7185;
    transform: scale(1.05);
  }

  .dispatch-meta {
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }
  .dispatch-tag-row {
    display: flex;
    align-items: center;
    gap: 0.4rem;
  }
  .dispatch-tag {
    font-size: 0.72rem;
    font-family: ui-monospace, monospace;
    font-weight: 700;
    text-transform: uppercase;
    color: #fb7185;
  }
  .dispatch-voice-tag {
    font-size: 0.65rem;
    font-family: ui-monospace, monospace;
    background: #262626;
    color: #a3a3a3;
    padding: 0.1rem 0.35rem;
    border-radius: 4px;
  }
  .dispatch-title {
    font-size: 0.9rem;
    font-weight: 600;
    color: #f5f5f5;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .dispatch-right {
    display: flex;
    align-items: center;
    gap: 1rem;
    flex-shrink: 0;
  }

  .waveform-container {
    display: flex;
    align-items: center;
    gap: 3px;
    height: 20px;
  }
  @media (max-width: 600px) {
    .waveform-container {
      display: none;
    }
  }

  .wave-bar {
    width: 3px;
    background-color: #404040;
    border-radius: 9999px;
    transition: background-color 0.2s ease;
  }
  .bar-1 { height: 8px; }
  .bar-2 { height: 16px; }
  .bar-3 { height: 20px; }
  .bar-4 { height: 12px; }
  .bar-5 { height: 18px; }
  .bar-6 { height: 10px; }

  .wave-bar.playing {
    background-color: #f43f5e;
    animation: wavePulse 0.8s ease-in-out infinite alternate;
  }
  .bar-1.playing { animation-delay: 0.1s; }
  .bar-2.playing { animation-delay: 0.3s; }
  .bar-3.playing { animation-delay: 0.2s; }
  .bar-4.playing { animation-delay: 0.4s; }
  .bar-5.playing { animation-delay: 0.15s; }
  .bar-6.playing { animation-delay: 0.35s; }

  @keyframes wavePulse {
    0% { transform: scaleY(0.4); }
    100% { transform: scaleY(1.2); }
  }

  .dispatch-timer-text {
    font-size: 0.8rem;
    font-family: ui-monospace, monospace;
    color: #a3a3a3;
  }

  .speed-toggle-btn {
    font-size: 0.75rem;
    font-family: ui-monospace, monospace;
    font-weight: 700;
    padding: 0.25rem 0.5rem;
    border-radius: 6px;
    background: #262626;
    border: 1px solid #333333;
    color: #e5e5e5;
    cursor: pointer;
    transition: background 0.15s ease;
  }
  .speed-toggle-btn:hover {
    background: #333333;
    color: #ffffff;
  }

  .hidden {
    display: none !important;
  }

  /* Light mode styles */
  :global(html:not(.dark)) .audio-dispatch-player {
    background: #f8fafc;
    border-color: #e2e8f0;
    color: #0f172a;
  }
  :global(html:not(.dark)) .dispatch-title { color: #0f172a; }
  :global(html:not(.dark)) .dispatch-voice-tag { background: #e2e8f0; color: #475569; }
  :global(html:not(.dark)) .speed-toggle-btn { background: #e2e8f0; border-color: #cbd5e1; color: #0f172a; }
</style>
