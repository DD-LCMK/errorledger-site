---
interface Props {
  duration?: string;
  title?: string;
}

const {
  duration = "3:45",
  title = "Incident Dispatch Overview"
} = Astro.props;
---

<div class="audio-dispatch-player my-6 p-4 rounded-xl bg-neutral-900 border border-neutral-800 flex items-center justify-between gap-4 text-neutral-200">
  <div class="flex items-center gap-3.5 min-w-0">
    <button id="dispatch-play-btn" class="w-10 h-10 rounded-full bg-rose-500 hover:bg-rose-600 text-white flex items-center justify-center flex-shrink-0 shadow-lg shadow-rose-500/20 transition-all cursor-pointer">
      <svg id="play-icon" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><polygon points="5 3 19 12 5 21 5 3"></polygon></svg>
      <svg id="pause-icon" class="hidden" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><rect x="6" y="4" width="4" height="16"></rect><rect x="14" y="4" width="4" height="16"></rect></svg>
    </button>
    <div class="min-w-0">
      <div class="flex items-center gap-2">
        <span class="text-xs font-mono font-bold uppercase text-rose-400">The Archivist's Audio Dispatch</span>
        <span class="text-[10px] font-mono bg-neutral-800 text-neutral-400 px-1.5 py-0.2 rounded">AI Voice</span>
      </div>
      <div class="text-sm font-medium text-neutral-100 truncate">{title}</div>
    </div>
  </div>

  <div class="flex items-center gap-4 flex-shrink-0">
    <!-- Waveform Visualizer Bars -->
    <div class="waveform-container hidden sm:flex items-center gap-1 h-5">
      <span class="wave-bar h-2 w-1 bg-neutral-700 rounded-full"></span>
      <span class="wave-bar h-4 w-1 bg-neutral-700 rounded-full"></span>
      <span class="wave-bar h-5 w-1 bg-neutral-700 rounded-full"></span>
      <span class="wave-bar h-3 w-1 bg-neutral-700 rounded-full"></span>
      <span class="wave-bar h-4 w-1 bg-neutral-700 rounded-full"></span>
      <span class="wave-bar h-2 w-1 bg-neutral-700 rounded-full"></span>
    </div>

    <span id="dispatch-timer" class="text-xs font-mono text-neutral-400">{duration}</span>

    <button id="dispatch-speed-btn" class="text-xs font-mono font-bold px-2 py-1 rounded bg-neutral-800 hover:bg-neutral-700 text-neutral-300 transition-colors">
      1.0x
    </button>
  </div>
</div>

<script is:inline>
  (function() {
    const playBtn = document.getElementById('dispatch-play-btn');
    const playIcon = document.getElementById('play-icon');
    const pauseIcon = document.getElementById('pause-icon');
    const waveBars = document.querySelectorAll('.wave-bar');
    const speedBtn = document.getElementById('dispatch-speed-btn');
    const timer = document.getElementById('dispatch-timer');

    let isPlaying = false;
    let currentSeconds = 0;
    let timerInterval = null;
    let speed = 1.0;

    playBtn?.addEventListener('click', () => {
      isPlaying = !isPlaying;
      if (isPlaying) {
        playIcon?.classList.add('hidden');
        pauseIcon?.classList.remove('hidden');
        waveBars.forEach(bar => {
          bar.classList.add('animate-pulse');
          bar.style.backgroundColor = '#f43f5e';
        });
        timerInterval = setInterval(() => {
          currentSeconds++;
          const mins = Math.floor(currentSeconds / 60);
          const secs = currentSeconds % 60;
          if (timer) timer.innerText = `${mins}:${secs < 10 ? '0' : ''}${secs}`;
        }, 1000 / speed);
      } else {
        playIcon?.classList.remove('hidden');
        pauseIcon?.classList.add('hidden');
        waveBars.forEach(bar => {
          bar.classList.remove('animate-pulse');
          bar.style.backgroundColor = '#404040';
        });
        clearInterval(timerInterval);
      }
    });

    speedBtn?.addEventListener('click', () => {
      speed = speed === 1.0 ? 1.5 : speed === 1.5 ? 2.0 : 1.0;
      if (speedBtn) speedBtn.innerText = `${speed.toFixed(1)}x`;
      if (isPlaying) {
        clearInterval(timerInterval);
        timerInterval = setInterval(() => {
          currentSeconds++;
          const mins = Math.floor(currentSeconds / 60);
          const secs = currentSeconds % 60;
          if (timer) timer.innerText = `${mins}:${secs < 10 ? '0' : ''}${secs}`;
        }, 1000 / speed);
      }
    });
  })();
</script>
