---
/**
 * StickyBannerAd — Adsterra fixed bottom sticky banner (728x90).
 * - Streamer Mode: renders nothing when streamerMode=true (?stream / ?obs)
 */
interface Props {
  streamerMode?: boolean;
}
const { streamerMode = false } = Astro.props;
---

{!streamerMode && (
  <div class="sticky-banner-ad-wrap" id="sticky-banner-ad">
    <script is:inline>
      if (typeof window !== 'undefined') {
        var sp = new URLSearchParams(window.location.search);
        if (sp.has('stream') || sp.has('obs')) {
          var adWrap = document.getElementById('sticky-banner-ad');
          if (adWrap) adWrap.style.display = 'none';
          var s = document.createElement('style');
          s.textContent = '.sticky-banner-ad-wrap { display: none !important; }';
          document.head.appendChild(s);
        }
      }
    </script>
    <button class="ad-close-btn" id="sticky-close-btn" aria-label="Close ad">✕</button>
    <div class="ad-inner">
      <!-- Adsterra 728x90 sticky banner -->
      <script is:inline>
        atOptions = {
          'key' : '9da075030ba65a883d58c24eb903807c',
          'format' : 'iframe',
          'height' : 90,
          'width' : 728,
          'params' : {}
        };
      </script>
      <script is:inline src="https://russiaexternalknew.com/9da075030ba65a883d58c24eb903807c/invoke.js"></script>
    </div>
  </div>
)}

<style>
  .sticky-banner-ad-wrap {
    position: fixed;
    bottom: 0;
    left: 50%;
    transform: translateX(-50%);
    z-index: 999;
    background: rgba(9, 13, 22, 0.92);
    border-top: 1px solid rgba(255, 255, 255, 0.08);
    padding: 6px 8px 4px;
    border-radius: 8px 8px 0 0;
    box-shadow: 0 -4px 20px rgba(0,0,0,0.4);
    max-width: 100vw;
    overflow: hidden;
  }

  .ad-inner {
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ad-close-btn {
    position: absolute;
    top: 2px;
    right: 4px;
    background: none;
    border: none;
    color: #64748b;
    font-size: 0.7rem;
    cursor: pointer;
    line-height: 1;
    padding: 2px 4px;
    z-index: 1;
  }

  .ad-close-btn:hover {
    color: #e2e8f0;
  }

  /* Scale down on smaller screens so it doesn't overflow */
  @media (max-width: 740px) {
    .ad-inner {
      transform: scale(0.9);
      transform-origin: center bottom;
    }
  }
</style>

<script>
  const closeBtn = document.getElementById('sticky-close-btn');
  const wrap = document.getElementById('sticky-banner-ad');
  if (closeBtn && wrap) {
    closeBtn.addEventListener('click', () => {
      wrap.style.display = 'none';
    });
  }
</script>
