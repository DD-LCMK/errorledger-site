---
/**
 * NativeAd — Adsterra native/recommendation widget.
 * Renders the async invoke.js + container div for the native unit.
 * Hidden when streamerMode=true.
 */
interface Props {
  streamerMode?: boolean;
}
const { streamerMode = false } = Astro.props;
---

{!streamerMode && (
  <div class="native-ad-wrap">
    <script is:inline>
      if (typeof window !== 'undefined') {
        var sp = new URLSearchParams(window.location.search);
        if (sp.has('stream') || sp.has('obs')) {
          var s = document.createElement('style');
          s.textContent = '.native-ad-wrap { display: none !important; }';
          document.head.appendChild(s);
        }
      }
    </script>
    <script async data-cfasync="false" is:inline
      src="https://russiaexternalknew.com/b7dc3adf1eee8de5f60eb73f9ef808a1/invoke.js">
    </script>
    <div id="container-b7dc3adf1eee8de5f60eb73f9ef808a1"></div>
  </div>
)}

<style>
  .native-ad-wrap {
    width: 100%;
    margin: 1.5rem 0;
    overflow: hidden;
  }
</style>
