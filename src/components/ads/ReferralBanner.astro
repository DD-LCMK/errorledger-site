---
/**
 * ReferralBanner — Adsterra Publisher Network referral banner (720x90).
 * Promotes publisher sign-up (5% lifetime revenue share).
 * Hidden when streamerMode=true or ?stream / ?obs / ?noads is in URL.
 */
interface Props {
  streamerMode?: boolean;
  class?: string;
}
const { streamerMode = false, class: className = '' } = Astro.props;
---

{!streamerMode && (
  <aside class={`referral-banner-container ${className}`} aria-label="Adsterra Partner Referral">
    <script is:inline>
      if (typeof window !== 'undefined') {
        var sp = new URLSearchParams(window.location.search);
        if (sp.has('stream') || sp.has('obs') || sp.has('noads')) {
          var el = document.currentScript?.parentElement;
          if (el) el.style.display = 'none';
        }
      }
    </script>
    <div class="referral-banner-card">
      <a
        href="https://beta.publishers.adsterra.com/referral/CJPTUFLGha"
        target="_blank"
        rel="nofollow noopener noreferrer"
        title="Adsterra Publisher Network - Monetize your site traffic"
        class="referral-banner-link"
      >
        <img
          alt="Adsterra Publisher Referral Banner"
          src="https://landings-cdn.adsterratech.com/referralBanners/gif/720x90_adsterra_reff.gif"
          width="720"
          height="90"
          loading="lazy"
          decoding="async"
        />
      </a>
    </div>
  </aside>
)}

<style>
  .referral-banner-container {
    width: 100%;
    margin: 2.5rem 0 1rem;
    display: flex;
    justify-content: center;
    align-items: center;
  }

  .referral-banner-card {
    display: inline-flex;
    justify-content: center;
    align-items: center;
    max-width: 100%;
    border-radius: 12px;
    overflow: hidden;
    background: rgba(15, 23, 42, 0.6);
    border: 1px solid rgba(255, 255, 255, 0.08);
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.35);
    transition: transform 0.2s ease, border-color 0.2s ease, box-shadow 0.2s ease;
  }

  .referral-banner-card:hover {
    transform: translateY(-2px);
    border-color: rgba(56, 189, 248, 0.4);
    box-shadow: 0 8px 25px rgba(56, 189, 248, 0.15);
  }

  .referral-banner-link {
    display: block;
    line-height: 0;
    max-width: 100%;
  }

  .referral-banner-link img {
    max-width: 100%;
    height: auto;
    display: block;
    border: none;
  }
</style>
