---
/**
 * DesktopWingAd — Desktop-only vertical fixed wing/gutter ad.
 * - Strictly visible ONLY on viewports >= 1720px (ultrawide / wide 1080p desktop).
 * - Positioned in the outer margin outside the centered 1440px game container.
 * - Zero obstruction on laptops, tablets, or mobile devices (display: none).
 * - Suppressed in Streamer / OBS mode (?stream / ?obs).
 */
interface Props {
  side?: 'left' | 'right';
  streamerMode?: boolean;
  adKey?: string;
}

const {
  side = 'left',
  streamerMode = false,
  adKey = '491dd9dd2fa88cc7f03b2fcab1f83062',
} = Astro.props;
---

{!streamerMode && (
  <aside
    class={`desktop-wing-ad side-${side}`}
    id={`desktop-wing-ad-${side}`}
    aria-label="Sponsored Advertisement"
  >
    <!-- Streamer/OBS mode client-side suppression fallback -->
    <script is:inline>
      if (typeof window !== 'undefined') {
        var sp = new URLSearchParams(window.location.search);
        if (sp.has('stream') || sp.has('obs')) {
          var el = document.currentScript?.parentElement;
          if (el) el.style.display = 'none';
        }
      }
    </script>

    <div class="wing-ad-header">
      <span class="wing-ad-label">AD</span>
      <button class="wing-ad-close" aria-label="Dismiss ad">✕</button>
    </div>

    <div class="wing-ad-inner">
      <script is:inline define:vars={{ adKey }}>
        atOptions = {
          'key' : adKey,
          'format' : 'iframe',
          'height' : 600,
          'width' : 160,
          'params' : {}
        };
      </script>
      <script is:inline src={'https://russiaexternalknew.com/' + adKey + '/invoke.js'}></script>
    </div>
  </aside>
)}

<style>
  /* Hidden by default on mobile, tablet, and standard laptops (< 1720px) */
  .desktop-wing-ad {
    display: none;
  }

  /* Only display on wide desktop monitors where gutters exist outside 1440px */
  @media (min-width: 1720px) {
    .desktop-wing-ad {
      display: flex;
      flex-direction: column;
      position: fixed;
      top: 80px;
      z-index: 90;
      width: 160px;
      min-height: 620px;
      background: rgba(15, 23, 42, 0.7);
      border: 1px solid rgba(255, 255, 255, 0.08);
      border-radius: 8px;
      box-shadow: 0 8px 32px rgba(0, 0, 0, 0.35);
      backdrop-filter: blur(8px);
      -webkit-backdrop-filter: blur(8px);
      padding: 4px;
      overflow: hidden;
      transition: opacity 0.2s ease;
    }

    /* Fixed in the outer left gutter outside the 1440px game container */
    .desktop-wing-ad.side-left {
      left: calc(50vw - 720px - 160px - 16px);
    }

    /* Fixed in the outer right gutter outside the 1440px game container */
    .desktop-wing-ad.side-right {
      left: calc(50vw + 720px + 16px);
    }

    .wing-ad-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 2px 4px 4px;
      line-height: 1;
    }

    .wing-ad-label {
      font-size: 0.62rem;
      font-weight: 700;
      letter-spacing: 0.08em;
      color: #64748b;
      text-transform: uppercase;
    }

    .wing-ad-close {
      background: none;
      border: none;
      color: #64748b;
      font-size: 0.7rem;
      cursor: pointer;
      line-height: 1;
      padding: 2px 4px;
      border-radius: 4px;
      transition: color 0.15s ease, background 0.15s ease;
    }

    .wing-ad-close:hover {
      color: #e2e8f0;
      background: rgba(255, 255, 255, 0.1);
    }

    .wing-ad-inner {
      display: flex;
      align-items: center;
      justify-content: center;
      width: 160px;
      min-height: 600px;
      overflow: hidden;
    }
  }
</style>

<script>
  // Close button functionality for wing ads
  document.querySelectorAll('.desktop-wing-ad').forEach(ad => {
    const closeBtn = ad.querySelector('.wing-ad-close');
    if (closeBtn) {
      closeBtn.addEventListener('click', () => {
        (ad as HTMLElement).style.display = 'none';
      });
    }
  });
</script>
