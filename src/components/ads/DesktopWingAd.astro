---
/**
 * DesktopWingAd — Sandboxed Desktop-only vertical fixed wing/gutter ad.
 * - Strictly visible ONLY on viewports >= 1720px (ultrawide / wide 1080p desktop).
 * - Positioned in the outer margin outside the centered 1440px game container.
 * - Zero obstruction on laptops, tablets, or mobile devices (display: none).
 * - Confined in an isolated iframe with sandbox="allow-scripts allow-popups allow-popups-to-escape-sandbox"
 * - STRICTLY NO allow-top-navigation (prevents any external parent redirect).
 * - Anti-Tabnabbing: window.open and link clicks are forced with rel="noopener noreferrer" and opener=null.
 * - Suppressed in Streamer / OBS mode (?stream / ?obs / ?noads).
 */
interface Props {
  side?: 'left' | 'right';
  streamerMode?: boolean;
  adKey?: string;
}

const {
  side = 'left',
  streamerMode = false,
  adKey = '491dd9dd2fa88cc7f03b2fcab1f83062',
} = Astro.props;

const wingHtml = `<!DOCTYPE html>
<html>
<head>
  <meta charset="utf-8">
  <style>
    body { margin: 0; padding: 0; overflow: hidden; background: transparent; display: flex; justify-content: center; align-items: center; }
  </style>
</head>
<body>
  <script>
    try {
      var _open = window.open;
      window.open = function(url, target, features) {
        var cleanFeatures = (features ? features + ',' : '') + 'noopener,noreferrer';
        var w = _open.call(window, url, target || '_blank', cleanFeatures);
        if (w) try { w.opener = null; } catch(err) {}
        return w;
      };
      document.addEventListener('click', function(e) {
        var a = e.target && e.target.closest ? e.target.closest('a, area') : null;
        if (a) {
          a.rel = 'noopener noreferrer';
          a.target = '_blank';
        }
      }, true);
      document.addEventListener('submit', function(e) {
        var form = e.target;
        if (form) {
          form.target = '_blank';
          form.rel = 'noopener noreferrer';
        }
      }, true);
    } catch(e) {}
  <\/script>
  <script>
    atOptions = {
      'key' : '${adKey}',
      'format' : 'iframe',
      'height' : 600,
      'width' : 160,
      'params' : {}
    };
  <\/script>
  <script src="https://russiaexternalknew.com/${adKey}/invoke.js"><\/script>
</body>
</html>`;
---

{!streamerMode && (
  <aside
    class={`desktop-wing-ad side-${side}`}
    id={`desktop-wing-ad-${side}`}
    aria-label="Sponsored Advertisement"
  >
    <!-- Streamer/OBS mode client-side suppression fallback -->
    <script is:inline>
      if (typeof window !== 'undefined') {
        var sp = new URLSearchParams(window.location.search);
        if (sp.has('stream') || sp.has('obs') || sp.has('noads')) {
          var el = document.currentScript?.parentElement;
          if (el) el.style.display = 'none';
        }
      }
    </script>

    <div class="wing-ad-header">
      <span class="wing-ad-label">AD</span>
      <button class="wing-ad-close" aria-label="Dismiss ad">✕</button>
    </div>

    <div class="wing-ad-inner">
      <iframe
        srcdoc={wingHtml}
        width="160"
        height="600"
        title="Sponsored Advertisement"
        style="border:none;overflow:hidden;"
        scrolling="no"
        sandbox="allow-scripts allow-same-origin allow-popups allow-popups-to-escape-sandbox"
        loading="lazy"
      ></iframe>
    </div>
  </aside>
)}

<style>
  /* Hidden by default on mobile, tablet, and standard laptops (< 1720px) */
  .desktop-wing-ad {
    display: none;
  }

  /* Only display on wide desktop monitors where gutters exist outside 1440px */
  @media (min-width: 1720px) {
    .desktop-wing-ad {
      display: flex;
      flex-direction: column;
      position: fixed;
      top: 80px;
      z-index: 90;
      width: 160px;
      min-height: 620px;
      background: rgba(15, 23, 42, 0.7);
      border: 1px solid rgba(255, 255, 255, 0.08);
      border-radius: 8px;
      box-shadow: 0 8px 32px rgba(0, 0, 0, 0.35);
      backdrop-filter: blur(8px);
      -webkit-backdrop-filter: blur(8px);
      padding: 4px;
      overflow: hidden;
      transition: opacity 0.2s ease;
    }

    /* Fixed in the outer left gutter outside the 1440px game container */
    .desktop-wing-ad.side-left {
      left: calc(50vw - 720px - 160px - 16px);
    }

    /* Fixed in the outer right gutter outside the 1440px game container */
    .desktop-wing-ad.side-right {
      left: calc(50vw + 720px + 16px);
    }

    .wing-ad-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 2px 4px 4px;
      line-height: 1;
    }

    .wing-ad-label {
      font-size: 0.62rem;
      font-weight: 700;
      letter-spacing: 0.08em;
      color: #64748b;
      text-transform: uppercase;
    }

    .wing-ad-close {
      background: none;
      border: none;
      color: #64748b;
      font-size: 0.7rem;
      cursor: pointer;
      line-height: 1;
      padding: 2px 4px;
      border-radius: 4px;
      transition: color 0.15s ease, background 0.15s ease;
    }

    .wing-ad-close:hover {
      color: #e2e8f0;
      background: rgba(255, 255, 255, 0.1);
    }

    .wing-ad-inner {
      display: flex;
      align-items: center;
      justify-content: center;
      width: 160px;
      min-height: 600px;
      overflow: hidden;
    }
  }
</style>

<script>
  // Close button functionality for wing ads
  document.querySelectorAll('.desktop-wing-ad').forEach(ad => {
    const closeBtn = ad.querySelector('.wing-ad-close');
    if (closeBtn) {
      closeBtn.addEventListener('click', () => {
        (ad as HTMLElement).style.display = 'none';
      });
    }
  });
</script>
