---
interface Props {
  tier?: number;
  label?: string;
  source?: string;
  lang?: string;
}

const {
  tier = 1,
  label,
  source = "Public Records & Technical Disclosures",
  lang = "en"
} = Astro.props;

const isKorean = lang === 'ko';

const tierConfigEn: Record<number, { color: string; badge: string; desc: string }> = {
  1: {
    color: "#10b981",
    badge: "Tier 1 — Documented Incident",
    desc: "Verified through official records, public filings, primary post-mortems, or corroborated journalism. Zero invented facts."
  },
  2: {
    color: "#f59e0b",
    badge: "Tier 2 — Direct Submission",
    desc: "First-person account submitted by a participant. Identifying details scrubbed; underlying core events unverified independently."
  },
  3: {
    color: "#6366f1",
    badge: "Tier 3 — Editorial Reconstruction",
    desc: "Synthesized from multiple verified accounts. Transitions and non-essential dialogue reconstructed for narrative clarity."
  },
  4: {
    color: "#f43f5e",
    badge: "Tier 4 — The Fiction Ledger",
    desc: "Speculative dramatization exploring psychological and systemic failure modes in a fictional setting."
  }
};

const tierConfigKo: Record<number, { color: string; badge: string; desc: string }> = {
  1: {
    color: "#10b981",
    badge: "Tier 1 — 공식 문서 검증 사건",
    desc: "공식 법원 기록, 공시, 1차 사후 분석 보고서(RCA), 복수의 언론 보도로 검증된 사건입니다. 허구적 사실 날조 0%."
  },
  2: {
    color: "#f59e0b",
    badge: "Tier 2 — 당사자 직접 제보",
    desc: "사건 당사자의 직접 제보. 민감한 개인/기업 식별 정보는 가명 처리되었으며, 핵심 사건 전개를 보존합니다."
  },
  3: {
    color: "#6366f1",
    badge: "Tier 3 — 편집진 서사적 재구성",
    desc: "다수의 검증된 기록을 종합한 서사. 사건의 핵심 사실은 검증되었으며 연결 대화는 이해를 돕기 위해 재구성되었습니다."
  },
  4: {
    color: "#f43f5e",
    badge: "Tier 4 — 픽션 레저",
    desc: "가상의 설정에서 인간의 심리와 조직의 실패 메커니즘을 탐구하는 드라마입니다."
  }
};

const tierConfig = isKorean ? tierConfigKo : tierConfigEn;
const current = tierConfig[tier] || tierConfig[1];
---

<div class="provenance-badge-box">
  <div class="provenance-header-row">
    <div class="provenance-left">
      <span class="provenance-indicator" style={`background-color: ${current.color};`}></span>
      <span class="provenance-title-text">
        {label || current.badge}
      </span>
    </div>
    {source && (
      <span class="provenance-source-tag">
        {isKorean ? "출처: " : "Source: "}{source}
      </span>
    )}
  </div>
  <p class="provenance-desc">
    {current.desc}
  </p>
</div>

<style>
  .provenance-badge-box {
    margin: 1.5rem 0 2rem 0;
    padding: 1rem 1.25rem;
    border-radius: 12px;
    background: #171717;
    border: 1px solid #262626;
  }

  .provenance-header-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    margin-bottom: 0.5rem;
    flex-wrap: wrap;
  }

  .provenance-left {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .provenance-indicator {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    display: inline-block;
  }

  .provenance-title-text {
    font-family: ui-monospace, monospace;
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    color: #e5e5e5;
    letter-spacing: 0.05em;
  }

  .provenance-source-tag {
    font-family: ui-monospace, monospace;
    font-size: 0.72rem;
    color: #a3a3a3;
    background: #0a0a0a;
    padding: 0.2rem 0.5rem;
    border-radius: 4px;
    border: 1px solid #262626;
  }

  .provenance-desc {
    font-size: 0.82rem;
    color: #a3a3a3;
    margin: 0;
    line-height: 1.5;
  }

  /* Light mode styles */
  :global(html:not(.dark)) .provenance-badge-box {
    background: #f8fafc;
    border-color: #e2e8f0;
  }
  :global(html:not(.dark)) .provenance-title-text {
    color: #0f172a;
  }
  :global(html:not(.dark)) .provenance-source-tag {
    background: #ffffff;
    border-color: #cbd5e1;
    color: #475569;
  }
  :global(html:not(.dark)) .provenance-desc {
    color: #475569;
  }
</style>
