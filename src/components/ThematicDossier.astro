---
interface Props {
  dossierName?: string;
  items?: Array<{
    title: string;
    slug: string;
    read_time: number;
    hook: string;
  }>;
}

const {
  dossierName = "The Corporate Scapegoat & Cloud Monoculture Dossier",
  items = [
    {
      title: "The $440 Million Trading Glitch That Killed Knight Capital in 45 Minutes",
      slug: "knight-capital-trading-glitch-45-minutes",
      read_time: 5,
      hook: "How a forgotten server running 8-year-old test code bankrupted a Wall Street titan before the opening bell."
    },
    {
      title: "The Junior Admin Who Deleted AWS Us-East-1 S3 with a Typo",
      slug: "junior-admin-deleted-aws-us-east-1-s3-typo",
      read_time: 4,
      hook: "One incorrect command parameter removed more servers than intended, taking down half the global internet."
    }
  ]
} = Astro.props;
---

<div class="thematic-dossier-box">
  <div class="dossier-header-row">
    <span class="dossier-badge">
      🗂️ Thematic Dossier
    </span>
    <span class="dossier-subtag">Bingeable Investigation Trail</span>
  </div>

  <h4 class="dossier-title">{dossierName}</h4>

  <div class="dossier-items-list">
    {items.map((item) => (
      <a href={`/blog/${item.slug}`} class="dossier-card">
        <div class="dossier-card-meta">
          <span class="dossier-next-label">Next Case File</span>
          <span>⏱️ {item.read_time} min read</span>
        </div>
        <div class="dossier-item-title">
          {item.title}
        </div>
        <div class="dossier-item-hook">
          {item.hook}
        </div>
      </a>
    ))}
  </div>
</div>

<style>
  .thematic-dossier-box {
    margin: 3rem 0;
    padding: 1.75rem;
    border-radius: 16px;
    background: #171717;
    border: 1px solid #262626;
    color: #f5f5f5;
  }

  .dossier-header-row {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 0.75rem;
  }
  .dossier-badge {
    font-size: 0.72rem;
    font-family: ui-monospace, monospace;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: #f59e0b;
    background: rgba(245, 158, 11, 0.12);
    padding: 0.2rem 0.55rem;
    border-radius: 6px;
    border: 1px solid rgba(245, 158, 11, 0.25);
  }
  .dossier-subtag {
    font-size: 0.75rem;
    color: #737373;
    font-family: ui-monospace, monospace;
  }

  .dossier-title {
    font-size: 1.15rem;
    font-weight: 800;
    color: #ffffff;
    margin: 0 0 1.25rem 0;
  }

  .dossier-items-list {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .dossier-card {
    display: block;
    padding: 1rem 1.25rem;
    border-radius: 12px;
    background: #0a0a0a;
    border: 1px solid #262626;
    text-decoration: none;
    transition: all 0.15s ease;
  }
  .dossier-card:hover {
    border-color: #f43f5e;
    background: #1e1e1e;
    transform: translateY(-1px);
  }

  .dossier-card-meta {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 0.75rem;
    font-family: ui-monospace, monospace;
    color: #737373;
    margin-bottom: 0.35rem;
  }
  .dossier-next-label {
    color: #fb7185;
    font-weight: 700;
  }

  .dossier-item-title {
    font-size: 0.95rem;
    font-weight: 700;
    color: #e5e5e5;
    margin-bottom: 0.25rem;
    line-height: 1.35;
  }
  .dossier-card:hover .dossier-item-title {
    color: #ffffff;
  }

  .dossier-item-hook {
    font-size: 0.82rem;
    color: #a3a3a3;
    line-height: 1.45;
  }
</style>
