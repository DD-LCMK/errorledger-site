---
interface Props {
  id: string;
  lang?: 'ko' | 'en';
}

const { id, lang = 'ko' } = Astro.props;
const isEn = lang === 'en';
---

<div class={`gthumb gthumb-${id}`} aria-hidden="true">
  <div class="gthumb-grid-bg"></div>

  {id === 'three-sec-quiz' && (
    <svg viewBox="0 0 320 140" class="gthumb-svg" fill="none">
      <defs>
        <linearGradient id="tsq-bar" x1="0" y1="0" x2="1" y2="0">
          <stop offset="0%" stop-color="#f59e0b" />
          <stop offset="100%" stop-color="#ef4444" />
        </linearGradient>
      </defs>
      <!-- Timer bar -->
      <rect x="28" y="20" width="264" height="8" rx="4" fill="#1e293b" />
      <rect x="28" y="20" width="186" height="8" rx="4" fill="url(#tsq-bar)" />
      <text x="292" y="15" text-anchor="end" fill="#fbbf24" font-size="11" font-weight="800" font-family="monospace">2.14s</text>
      <!-- Prompt card -->
      <rect x="34" y="42" width="112" height="58" rx="12" fill="#131926" stroke="#f59e0b" stroke-width="1.6" />
      <text x="90" y="78" text-anchor="middle" fill="#f8fafc" font-size="24" font-weight="900">{isEn ? '3 SEC' : '동문'}</text>
      <!-- Arrow -->
      <path d="M154 71H170M165 65L171 71L165 77" stroke="#fbbf24" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" />
      <!-- Answer hidden box -->
      <rect x="178" y="42" width="108" height="58" rx="12" fill="rgba(239,68,68,0.12)" stroke="#ef4444" stroke-width="1.6" stroke-dasharray="5 4" />
      <text x="232" y="78" text-anchor="middle" fill="#f87171" font-size="24" font-weight="900">{isEn ? 'QUIZ!' : '??'}</text>
      <!-- Bottom pills -->
      <rect x="34" y="110" width="58" height="16" rx="5" fill="#1e293b" />
      <text x="63" y="121" text-anchor="middle" fill="#94a3b8" font-size="9" font-weight="700">{isEn ? '1. A' : '1. 서답'}</text>
      <rect x="100" y="110" width="58" height="16" rx="5" fill="#1e293b" />
      <text x="129" y="121" text-anchor="middle" fill="#94a3b8" font-size="9" font-weight="700">{isEn ? '2. B' : '2. 수학'}</text>
      <rect x="166" y="110" width="58" height="16" rx="5" fill="#1e293b" />
      <text x="195" y="121" text-anchor="middle" fill="#94a3b8" font-size="9" font-weight="700">{isEn ? '3. C' : '3. 시장'}</text>
      <rect x="232" y="110" width="54" height="16" rx="5" fill="rgba(245,158,11,0.2)" stroke="#f59e0b" stroke-width="0.8" />
      <text x="259" y="121" text-anchor="middle" fill="#fde047" font-size="9" font-weight="800">BUZZ!</text>
    </svg>
  )}

  {id === 'spot-odd' && (
    <svg viewBox="0 0 320 140" class="gthumb-svg" fill="none">
      <!-- Coordinate labels -->
      <text x="86" y="20" text-anchor="middle" fill="#64748b" font-size="9" font-weight="800" font-family="monospace">A</text>
      <text x="135" y="20" text-anchor="middle" fill="#64748b" font-size="9" font-weight="800" font-family="monospace">B</text>
      <text x="184" y="20" text-anchor="middle" fill="#00ffa3" font-size="9" font-weight="900" font-family="monospace">C</text>
      <text x="233" y="20" text-anchor="middle" fill="#64748b" font-size="9" font-weight="800" font-family="monospace">D</text>
      <!-- 4x3 Grid -->
      {[0, 1, 2].map((r) =>
        [0, 1, 2, 3].map((c) => {
          const isOdd = r === 1 && c === 2;
          const x = 64 + c * 49;
          const y = 28 + r * 34;
          return (
            <g>
              <rect
                x={x}
                y={y}
                width="44"
                height="29"
                rx="7"
                fill={isOdd ? 'rgba(0,255,163,0.18)' : '#131b2b'}
                stroke={isOdd ? '#00ffa3' : 'rgba(148,163,184,0.2)'}
                stroke-width={isOdd ? '1.8' : '1'}
              />
              <text
                x={x + 22}
                y={y + 19}
                text-anchor="middle"
                fill={isOdd ? '#00ffa3' : '#94a3b8'}
                font-size="14"
                font-weight="800"
              >
                {isOdd ? (isEn ? 'Q' : '또') : (isEn ? 'O' : '뚀')}
              </text>
            </g>
          );
        })
      )}
      <!-- Magnifier ring over C2 -->
      <circle cx="184" cy="76" r="22" stroke="#fbbf24" stroke-width="2" stroke-dasharray="4 3" opacity="0.9" />
      <rect x="256" y="64" width="44" height="22" rx="6" fill="rgba(251,191,36,0.16)" stroke="#fbbf24" stroke-width="1" />
      <text x="278" y="79" text-anchor="middle" fill="#fde047" font-size="10" font-weight="900" font-family="monospace">C2!</text>
    </svg>
  )}

  {id === 'blind-timer' && (
    <svg viewBox="0 0 320 140" class="gthumb-svg" fill="none">
      <!-- Outer digital housing -->
      <rect x="34" y="24" width="252" height="76" rx="14" fill="#090d16" stroke="rgba(56,189,248,0.45)" stroke-width="1.5" />
      <rect x="42" y="32" width="236" height="60" rx="9" fill="#050810" />
      <!-- Target tag -->
      <rect x="52" y="38" width="70" height="16" rx="4" fill="rgba(0,255,163,0.14)" />
      <text x="87" y="49" text-anchor="middle" fill="#00ffa3" font-size="9" font-weight="800" font-family="monospace">TARGET 7.77</text>
      <rect x="208" y="38" width="60" height="16" rx="4" fill="rgba(239,68,68,0.18)" />
      <text x="238" y="49" text-anchor="middle" fill="#f87171" font-size="9" font-weight="800" font-family="monospace">BLIND</text>
      <!-- Main LED readout -->
      <text x="160" y="82" text-anchor="middle" fill="#f8fafc" font-size="34" font-weight="900" font-family="monospace" letter-spacing="2">07.770</text>
      <!-- Precision badge -->
      <rect x="96" y="108" width="128" height="20" rx="10" fill="rgba(251,191,36,0.14)" stroke="rgba(251,191,36,0.45)" stroke-width="1" />
      <text x="160" y="121" text-anchor="middle" fill="#fde047" font-size="10" font-weight="800" font-family="monospace">±0.000s JACKPOT</text>
    </svg>
  )}

  {id === 'mine-gems' && (
    <svg viewBox="0 0 320 140" class="gthumb-svg" fill="none">
      <!-- 4x3 Tile Board -->
      {[0, 1, 2].map((r) =>
        [0, 1, 2, 3].map((c) => {
          const x = 44 + c * 38;
          const y = 20 + r * 35;
          const isGem = (r === 0 && c === 1) || (r === 1 && c === 0) || (r === 1 && c === 2) || (r === 2 && c === 1);
          const isBomb = r === 2 && c === 3;
          return (
            <g>
              <rect
                x={x}
                y={y}
                width="33"
                height="30"
                rx="7"
                fill={isGem ? 'rgba(0,255,163,0.15)' : isBomb ? 'rgba(239,68,68,0.2)' : '#131b2b'}
                stroke={isGem ? '#00ffa3' : isBomb ? '#ef4444' : 'rgba(148,163,184,0.2)'}
                stroke-width={isGem || isBomb ? '1.5' : '1'}
              />
              {isGem && (
                <polygon points={`${x + 16.5},${y + 7} ${x + 24},${y + 15} ${x + 16.5},${y + 23} ${x + 9},${y + 15}`} fill="#00ffa3" />
              )}
              {isBomb && (
                <g>
                  <circle cx={x + 16.5} cy={y + 16.5} r="6.5" fill="#ef4444" />
                  <path d={`M${x + 16.5} ${y + 9}L${x + 20} ${y + 6}`} stroke="#fde047" stroke-width="1.8" stroke-linecap="round" />
                </g>
              )}
            </g>
          );
        })
      )}
      <!-- Multiplier panel -->
      <rect x="208" y="24" width="82" height="92" rx="12" fill="#0b101d" stroke="rgba(0,255,163,0.3)" stroke-width="1.2" />
      <text x="249" y="45" text-anchor="middle" fill="#94a3b8" font-size="9" font-weight="800">NEXT</text>
      <text x="249" y="72" text-anchor="middle" fill="#00ffa3" font-size="22" font-weight="900" font-family="monospace">x4.82</text>
      <rect x="220" y="86" width="58" height="20" rx="6" fill="#00ffa3" />
      <text x="249" y="99" text-anchor="middle" fill="#04120c" font-size="9" font-weight="900">CASH OUT</text>
    </svg>
  )}

  {id === 'reaction-test' && (
    <svg viewBox="0 0 320 140" class="gthumb-svg" fill="none">
      <!-- Pulse waveform -->
      <path d="M20 92H88L104 42L122 108L138 72L152 92H300" stroke="#00ffa3" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" opacity="0.85" />
      <!-- Target crosshair -->
      <circle cx="228" cy="58" r="24" stroke="#38bdf8" stroke-width="1.8" opacity="0.7" />
      <circle cx="228" cy="58" r="11" fill="rgba(56,189,248,0.22)" stroke="#38bdf8" stroke-width="1.5" />
      <circle cx="228" cy="58" r="3" fill="#00ffa3" />
      <path d="M228 26V36M228 80V90M196 58H206M250 58H260" stroke="#38bdf8" stroke-width="1.6" stroke-linecap="round" />
      <!-- Readout chip -->
      <rect x="30" y="24" width="114" height="34" rx="9" fill="#0d1322" stroke="rgba(0,255,163,0.4)" stroke-width="1.2" />
      <text x="87" y="45" text-anchor="middle" fill="#00ffa3" font-size="16" font-weight="900" font-family="monospace">178 ms</text>
      <text x="87" y="122" text-anchor="middle" fill="#94a3b8" font-size="10" font-weight="700" font-family="monospace">AIM · REFLEX · CPS</text>
    </svg>
  )}

  {id === 'sword-enhance' && (
    <svg viewBox="0 0 320 140" class="gthumb-svg" fill="none">
      <defs>
        <linearGradient id="blade-grad" x1="0" y1="0" x2="1" y2="1">
          <stop offset="0%" stop-color="#fde047" />
          <stop offset="55%" stop-color="#f59e0b" />
          <stop offset="100%" stop-color="#ef4444" />
        </linearGradient>
      </defs>
      <!-- Glow aura -->
      <circle cx="132" cy="68" r="46" fill="rgba(245,158,11,0.16)" />
      <!-- Diagonal legendary blade -->
      <path d="M88 106L100 94L110 104L98 116Z" fill="#78350f" />
      <path d="M96 84L120 108L114 114L90 90Z" fill="#fbbf24" />
      <path d="M106 94L174 26L184 20L178 30L110 98Z" fill="url(#blade-grad)" />
      <!-- Sparks -->
      <circle cx="152" cy="30" r="2.5" fill="#fde047" />
      <circle cx="188" cy="48" r="2" fill="#f97316" />
      <circle cx="122" cy="40" r="2" fill="#fde047" />
      <!-- +20 Tier badge -->
      <rect x="200" y="34" width="90" height="44" rx="11" fill="#14110b" stroke="#fbbf24" stroke-width="1.6" />
      <text x="245" y="63" text-anchor="middle" fill="#fde047" font-size="24" font-weight="900" font-family="monospace">+20</text>
      <!-- Star catch bar -->
      <rect x="200" y="92" width="90" height="10" rx="5" fill="#1e293b" />
      <rect x="234" y="92" width="22" height="10" rx="3" fill="#00ffa3" />
      <rect x="243" y="88" width="4" height="18" rx="2" fill="#ffffff" />
    </svg>
  )}

  {id === 'block-blast' && (
    <svg viewBox="0 0 320 140" class="gthumb-svg" fill="none">
      <!-- 6x4 Block Grid -->
      {[0, 1, 2, 3].map((r) =>
        [0, 1, 2, 3, 4, 5].map((c) => {
          const x = 68 + c * 30;
          const y = 18 + r * 27;
          const isLine = r === 2;
          const colors = ['#38bdf8', '#a855f7', '#00ffa3', '#f59e0b', '#ec4899'];
          const filled = isLine || (r === 0 && (c === 1 || c === 2)) || (r === 1 && (c === 1 || c === 4 || c === 5)) || (r === 3 && (c === 0 || c === 3 || c === 4));
          const col = isLine ? '#00ffa3' : colors[(r * 3 + c) % colors.length];
          return (
            <rect
              x={x}
              y={y}
              width="25"
              height="22"
              rx="5"
              fill={filled ? col : '#121826'}
              fill-opacity={filled ? (isLine ? '0.92' : '0.82') : '1'}
              stroke={isLine ? '#ffffff' : 'rgba(255,255,255,0.08)'}
              stroke-width={isLine ? '1.2' : '1'}
            />
          );
        })
      )}
      <!-- Combo beam -->
      <rect x="52" y="78" width="216" height="10" rx="5" fill="rgba(0,255,163,0.35)" />
      <text x="160" y="133" text-anchor="middle" fill="#00ffa3" font-size="10" font-weight="900" font-family="monospace">COMBO x6 LINE BLAST!</text>
    </svg>
  )}

  {id === 'arrow-jump' && (
    <svg viewBox="0 0 320 140" class="gthumb-svg" fill="none">
      <!-- Platforms -->
      <rect x="50" y="108" width="68" height="10" rx="5" fill="#334155" />
      <rect x="134" y="78" width="64" height="10" rx="5" fill="#38bdf8" />
      <rect x="206" y="42" width="66" height="10" rx="5" fill="#00ffa3" />
      <!-- Trajectory arc -->
      <path d="M84 104 Q112 40 162 72" stroke="#94a3b8" stroke-width="2" stroke-dasharray="4 4" />
      <path d="M166 72 Q196 14 236 36" stroke="#00ffa3" stroke-width="2.2" stroke-dasharray="4 4" />
      <!-- Arrow -->
      <path d="M220 50L242 28M242 28H229M242 28V41" stroke="#fde047" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" />
      <text x="54" y="34" fill="#38bdf8" font-size="14" font-weight="900" font-family="monospace">300m</text>
      <text x="54" y="48" fill="#64748b" font-size="9" font-weight="700" font-family="monospace">CLIMB PEAK</text>
    </svg>
  )}

  {id === 'sand-drop' && (
    <svg viewBox="0 0 320 140" class="gthumb-svg" fill="none">
      <!-- Flowing sand dune layers -->
      <path d="M0 140V108Q60 88 125 106T245 98T320 108V140Z" fill="#f59e0b" opacity="0.85" />
      <path d="M0 140V118Q75 102 150 116T320 112V140Z" fill="#ec4899" opacity="0.85" />
      <path d="M0 140V128Q90 118 180 128T320 124V140Z" fill="#00ffa3" opacity="0.9" />
      <!-- Falling sand block -->
      <rect x="142" y="24" width="36" height="24" rx="6" fill="#38bdf8" stroke="#bae6fd" stroke-width="1.2" />
      <!-- Falling grains -->
      <circle cx="152" cy="58" r="2.5" fill="#38bdf8" />
      <circle cx="164" cy="66" r="2.5" fill="#38bdf8" />
      <circle cx="156" cy="76" r="2.5" fill="#38bdf8" />
      <circle cx="168" cy="84" r="2" fill="#00ffa3" />
      <circle cx="148" cy="88" r="2" fill="#f59e0b" />
    </svg>
  )}

  {id === 'marble-roulette' && (
    <svg viewBox="0 0 320 140" class="gthumb-svg" fill="none">
      <!-- Angled race ramps -->
      <path d="M24 38L142 62" stroke="#475569" stroke-width="6" stroke-linecap="round" />
      <path d="M296 58L164 84" stroke="#475569" stroke-width="6" stroke-linecap="round" />
      <path d="M40 96L210 122" stroke="#334155" stroke-width="6" stroke-linecap="round" />
      <!-- Pins -->
      <circle cx="176" cy="34" r="4" fill="#64748b" />
      <circle cx="210" cy="40" r="4" fill="#64748b" />
      <circle cx="122" cy="92" r="4" fill="#64748b" />
      <circle cx="152" cy="98" r="4" fill="#64748b" />
      <!-- Racing marbles -->
      <circle cx="88" cy="41" r="10" fill="#a855f7" stroke="#f3e8ff" stroke-width="1.5" />
      <circle cx="116" cy="47" r="10" fill="#00ffa3" stroke="#d1fae5" stroke-width="1.5" />
      <circle cx="222" cy="64" r="10" fill="#f59e0b" stroke="#fef3c7" stroke-width="1.5" />
      <circle cx="186" cy="72" r="10" fill="#38bdf8" stroke="#e0f2fe" stroke-width="1.5" />
      <circle cx="238" cy="118" r="11" fill="#ec4899" stroke="#ffffff" stroke-width="1.8" />
      <!-- Finish flag badge -->
      <rect x="256" y="104" width="44" height="22" rx="6" fill="rgba(0,255,163,0.16)" stroke="#00ffa3" stroke-width="1.2" />
      <text x="278" y="119" text-anchor="middle" fill="#00ffa3" font-size="9" font-weight="900" font-family="monospace">GOAL</text>
    </svg>
  )}

  {id === 'roulette' && (
    <svg viewBox="0 0 320 140" class="gthumb-svg" fill="none">
      <!-- Wheel segments -->
      <circle cx="160" cy="74" r="50" fill="#131b2b" stroke="#334155" stroke-width="3" />
      <path d="M160 74L160 24A50 50 0 0 1 203.3 49Z" fill="#00ffa3" opacity="0.88" />
      <path d="M160 74L203.3 49A50 50 0 0 1 203.3 99Z" fill="#38bdf8" opacity="0.82" />
      <path d="M160 74L203.3 99A50 50 0 0 1 160 124Z" fill="#a855f7" opacity="0.85" />
      <path d="M160 74L160 124A50 50 0 0 1 116.7 99Z" fill="#f59e0b" opacity="0.85" />
      <path d="M160 74L116.7 99A50 50 0 0 1 116.7 49Z" fill="#ec4899" opacity="0.85" />
      <path d="M160 74L116.7 49A50 50 0 0 1 160 24Z" fill="#6366f1" opacity="0.85" />
      <circle cx="160" cy="74" r="12" fill="#07090f" stroke="#ffffff" stroke-width="2" />
      <!-- Pointer needle -->
      <polygon points="160,30 153,12 167,12" fill="#fde047" />
    </svg>
  )}

  {id === 'ladder' && (
    <svg viewBox="0 0 320 140" class="gthumb-svg" fill="none">
      <!-- Vertical rails -->
      <line x1="76" y1="22" x2="76" y2="118" stroke="#334155" stroke-width="3.5" stroke-linecap="round" />
      <line x1="132" y1="22" x2="132" y2="118" stroke="#334155" stroke-width="3.5" stroke-linecap="round" />
      <line x1="188" y1="22" x2="188" y2="118" stroke="#334155" stroke-width="3.5" stroke-linecap="round" />
      <line x1="244" y1="22" x2="244" y2="118" stroke="#334155" stroke-width="3.5" stroke-linecap="round" />
      <!-- Rungs -->
      <line x1="76" y1="44" x2="132" y2="44" stroke="#475569" stroke-width="3" />
      <line x1="132" y1="70" x2="188" y2="70" stroke="#475569" stroke-width="3" />
      <line x1="188" y1="94" x2="244" y2="94" stroke="#475569" stroke-width="3" />
      <line x1="76" y1="98" x2="132" y2="98" stroke="#475569" stroke-width="3" />
      <line x1="188" y1="40" x2="244" y2="40" stroke="#475569" stroke-width="3" />
      <!-- Highlighted winning trace -->
      <path d="M76 22V44H132V70H188V94H244V118" stroke="#00ffa3" stroke-width="4" stroke-linecap="round" stroke-linejoin="round" />
      <circle cx="76" cy="20" r="6" fill="#00ffa3" />
      <rect x="226" y="114" width="36" height="18" rx="5" fill="#00ffa3" />
      <text x="244" y="126" text-anchor="middle" fill="#04120c" font-size="9" font-weight="900">WIN!</text>
    </svg>
  )}

  {id === 'drinking-marble' && (
    <svg viewBox="0 0 320 140" class="gthumb-svg" fill="none">
      <!-- Board perimeter tiles -->
      <rect x="52" y="20" width="216" height="100" rx="14" fill="#111625" stroke="rgba(236,72,153,0.45)" stroke-width="1.6" />
      <rect x="86" y="42" width="148" height="56" rx="8" fill="#090d16" stroke="rgba(255,255,255,0.08)" stroke-width="1" />
      <!-- Colored corner tiles -->
      <rect x="56" y="24" width="26" height="22" rx="5" fill="rgba(236,72,153,0.35)" />
      <rect x="238" y="24" width="26" height="22" rx="5" fill="rgba(245,158,11,0.35)" />
      <rect x="56" y="94" width="26" height="22" rx="5" fill="rgba(56,189,248,0.35)" />
      <rect x="238" y="94" width="26" height="22" rx="5" fill="rgba(0,255,163,0.35)" />
      <!-- Dice in center -->
      <rect x="138" y="50" width="44" height="40" rx="9" fill="#f8fafc" />
      <circle cx="150" cy="60" r="3.2" fill="#0f172a" />
      <circle cx="170" cy="60" r="3.2" fill="#0f172a" />
      <circle cx="160" cy="70" r="3.2" fill="#ec4899" />
      <circle cx="150" cy="80" r="3.2" fill="#0f172a" />
      <circle cx="170" cy="80" r="3.2" fill="#0f172a" />
    </svg>
  )}

  {id === 'ai-music-quiz' && (
    <svg viewBox="0 0 320 140" class="gthumb-svg" fill="none">
      <!-- Vinyl record -->
      <circle cx="96" cy="70" r="38" fill="#0b101d" stroke="#a855f7" stroke-width="2" />
      <circle cx="96" cy="70" r="24" stroke="rgba(168,85,247,0.35)" stroke-width="1.2" />
      <circle cx="96" cy="70" r="11" fill="#a855f7" />
      <circle cx="96" cy="70" r="3" fill="#07090f" />
      <!-- Audio bars -->
      {[28, 52, 74, 42, 66, 84, 48, 34].map((h, i) => (
        <rect
          x={156 + i * 16}
          y={70 - h / 2}
          width="9"
          height={h}
          rx="4.5"
          fill={i % 2 === 0 ? '#00ffa3' : '#38bdf8'}
          opacity="0.9"
        />
      ))}
    </svg>
  )}

  {id === 'soundboard' && (
    <svg viewBox="0 0 320 140" class="gthumb-svg" fill="none">
      {[0, 1, 2].map((r) =>
        [0, 1, 2].map((c) => {
          const x = 86 + c * 52;
          const y = 18 + r * 36;
          const active = (r === 0 && c === 1) || (r === 1 && c === 2) || (r === 2 && c === 0);
          const col = r === 0 ? '#00ffa3' : r === 1 ? '#38bdf8' : '#f59e0b';
          const num = r * 3 + c + 1;
          return (
            <g>
              <rect
                x={x}
                y={y}
                width="44"
                height="29"
                rx="7"
                fill={active ? col : '#131b2b'}
                fill-opacity={active ? '0.22' : '1'}
                stroke={active ? col : 'rgba(148,163,184,0.22)'}
                stroke-width={active ? '1.6' : '1'}
              />
