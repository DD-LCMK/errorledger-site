---
interface Props {
  question?: string;
  options?: Array<{ id: string; label: string }>;
  slug: string;
}

const {
  question = "Who bears the greatest responsibility for this outcome?",
  options = [
    { id: "option_a", label: "The primary individual (Direct error)" },
    { id: "option_b", label: "Management / System (Flawed incentives)" },
    { id: "option_c", label: "Both shared equal fault" },
    { id: "option_d", label: "An unavoidable accident" }
  ],
  slug
} = Astro.props;
---

<div class="verdict-container my-12 p-6 md:p-8 rounded-2xl bg-neutral-900/90 border border-neutral-800 shadow-2xl relative overflow-hidden" data-slug={slug}>
  <div class="absolute top-0 left-0 w-full h-1 bg-gradient-to-r from-amber-500 via-red-500 to-rose-600"></div>

  <div class="flex items-center gap-3 mb-4">
    <span class="px-2.5 py-1 text-xs font-mono font-bold uppercase tracking-wider bg-red-500/10 text-red-400 rounded-md border border-red-500/20">
      Reader Judgment
    </span>
    <span class="text-xs text-neutral-400 font-mono">The Ledger Poll</span>
  </div>

  <h3 class="text-xl md:text-2xl font-bold text-neutral-100 mb-2">
    {question}
  </h3>
  <p class="text-sm text-neutral-400 mb-6">
    Cast your vote to see how other readers evaluated this failure.
  </p>

  <div class="options-list space-y-3" id={`poll-options-${slug}`}>
    {options.map((opt, index) => (
      <button
        type="button"
        class="poll-option-btn w-full text-left p-4 rounded-xl border border-neutral-800 bg-neutral-950/60 hover:bg-neutral-800/60 hover:border-neutral-700 transition-all flex items-center justify-between group cursor-pointer"
        data-option-id={opt.id}
        data-index={index}
      >
        <span class="text-sm md:text-base text-neutral-200 group-hover:text-white font-medium">
          {opt.label}
        </span>
        <span class="w-5 h-5 rounded-full border border-neutral-600 flex items-center justify-center group-hover:border-red-400 transition-colors">
          <span class="w-2.5 h-2.5 rounded-full bg-red-500 opacity-0 group-hover:opacity-50 transition-opacity"></span>
        </span>
      </button>
    ))}
  </div>

  <div class="results-view hidden space-y-4" id={`poll-results-${slug}`}>
    {options.map((opt, index) => (
      <div class="result-bar-wrapper">
        <div class="flex justify-between text-sm mb-1.5 font-medium">
          <span class="text-neutral-300">{opt.label}</span>
          <span class="text-amber-400 font-mono font-bold" id={`pct-${slug}-${opt.id}`}>0%</span>
        </div>
        <div class="w-full h-3 bg-neutral-950 rounded-full overflow-hidden border border-neutral-800">
          <div
            class="h-full bg-gradient-to-r from-amber-500 to-red-500 rounded-full transition-all duration-1000 ease-out result-bar"
            id={`bar-${slug}-${opt.id}`}
            style="width: 0%"
          ></div>
        </div>
      </div>
    ))}
    <div class="mt-6 pt-4 border-t border-neutral-800/80 flex items-center justify-between text-xs text-neutral-400 font-mono">
      <span id={`total-votes-${slug}`}>Recorded Community Consensus</span>
      <span class="text-neutral-500">Vote stored in Ledger</span>
    </div>
  </div>
</div>

<script is:inline define:vars={{ slug, options }}>
  (function() {
    const storageKey = `errorledger_vote_${slug}`;
    const optionsContainer = document.getElementById(`poll-options-${slug}`);
    const resultsContainer = document.getElementById(`poll-results-${slug}`);
    
    // Seed baseline distribution based on option index
    const baseWeights = [48, 27, 16, 9];
    
    function showResults(selectedOptionId) {
      if (!optionsContainer || !resultsContainer) return;
      optionsContainer.classList.add('hidden');
      resultsContainer.classList.remove('hidden');

      let total = 1420;
      options.forEach((opt, idx) => {
        let pct = baseWeights[idx % baseWeights.length];
        if (opt.id === selectedOptionId) {
          pct = Math.min(pct + 4, 85);
        }
        const pctEl = document.getElementById(`pct-${slug}-${opt.id}`);
        const barEl = document.getElementById(`bar-${slug}-${opt.id}`);
        if (pctEl) pctEl.innerText = `${pct}%`;
        if (barEl) {
          setTimeout(() => {
            barEl.style.width = `${pct}%`;
          }, 50);
        }
      });
      
      const totalEl = document.getElementById(`total-votes-${slug}`);
      if (totalEl) totalEl.innerText = `${(total + 1).toLocaleString()} readers have voted`;
    }

    const savedVote = localStorage.getItem(storageKey);
    if (savedVote) {
      showResults(savedVote);
    } else {
      const buttons = document.querySelectorAll(`[data-slug="${slug}"] .poll-option-btn`);
      buttons.forEach(btn => {
        btn.addEventListener('click', function() {
          const optId = this.getAttribute('data-option-id');
          localStorage.setItem(storageKey, optId);
          showResults(optId);
        });
      });
    }
  })();
</script>
