---
interface Props {
  question?: string;
  options?: Array<{ id: string; label: string; votes?: number }>;
  slug: string;
  lang?: string;
  source?: string;
}

const {
  question = "Who bears the greatest responsibility for this outcome?",
  options = [
    { id: "option_a", label: "The primary individual (Direct error)" },
    { id: "option_b", label: "Management / System (Flawed incentives)" },
    { id: "option_c", label: "Both shared equal fault" },
    { id: "option_d", label: "An unavoidable systemic failure" }
  ],
  slug,
  lang = "en",
  source = ""
} = Astro.props;

const isKorean = lang === 'ko';
---

<div class="verdict-container" id={`verdict-box-${slug}`} data-slug={slug} data-lang={lang} data-options={JSON.stringify(options)}>
  <div class="verdict-top-accent"></div>

  <div class="verdict-header">
    <div class="verdict-badge-row">
      <span class="verdict-badge">⚖️ {isKorean ? "독자 참여 판결" : "Reader Verdict"}</span>
      <span class="verdict-badge-sub">{isKorean ? "실시간 독자 투표" : "LIVE READER DEBATE"}</span>
    </div>

    <h3 class="verdict-heading">
      {question}
    </h3>
    <p class="verdict-subtext">
      {isKorean 
        ? "이 사건의 근본 원인과 책임에 대한 당신의 판단을 기록하세요. 투표 즉시 전체 독자 판결 통계가 공개됩니다." 
        : "Cast your verdict on the primary systemic responsibility. Results update in real-time upon voting."}
    </p>
  </div>

  <!-- Voting Form View (Default when not voted) -->
  <div class="verdict-voting-view" id={`voting-view-${slug}`}>
    <div class="verdict-options-grid">
      {options.map((opt, index) => (
        <label class="verdict-option-card" for={`opt-${slug}-${opt.id}`}>
          <input 
            type="radio" 
            name={`verdict-choice-${slug}`} 
            id={`opt-${slug}-${opt.id}`} 
            value={opt.id} 
            class="verdict-radio" 
          />
          <div class="option-content-wrap">
            <span class="option-letter">{String.fromCharCode(65 + index)}</span>
            <span class="option-text">{opt.label}</span>
          </div>
        </label>
      ))}
    </div>

    <div class="verdict-action-row">
      <button type="button" class="cast-verdict-btn" id={`btn-cast-${slug}`}>
        {isKorean ? "⚖️ 판결 투표하기" : "⚖️ Record Your Verdict"}
      </button>
      <button type="button" class="view-results-text-btn" id={`btn-view-${slug}`}>
        {isKorean ? "결과 먼저 보기 →" : "View Results →"}
      </button>
    </div>
  </div>

  <!-- Results View (Revealed after voting or clicking view results) -->
  <div class="verdict-results-view hidden" id={`results-view-${slug}`}>
    <div class="consensus-breakdown-list" id={`results-list-${slug}`}>
      <!-- Populated dynamically via client-side script -->
    </div>

    <div class="verdict-footer">
      <div class="footer-stat-group">
        <span class="footer-stat-item" id={`footer-count-${slug}`}>
          {isKorean ? "✅ 판결이 기록되었습니다." : "✅ Verdict recorded."}
        </span>
      </div>
      <div class="footer-source-note">
        <span>📌 {isKorean ? "ErrorLedger 독자 참여 아카이브" : "ErrorLedger Interactive Reader Archive"}</span>
      </div>
    </div>
  </div>
</div>

<script is:inline define:vars={{ slug, isKorean }}>
  (function() {
    const container = document.getElementById(`verdict-box-${slug}`);
    if (!container) return;

    const rawOptions = JSON.parse(container.getAttribute('data-options') || '[]');
    const storageKey = `errorledger_verdict_${slug}`;
    const countsKey = `errorledger_counts_${slug}`;

    // Helper: get current stored counts
    function getStoredCounts() {
      const stored = localStorage.getItem(countsKey);
      if (stored) {
        try { return JSON.parse(stored); } catch (e) {}
      }
      // Seed default initial base counts so percentages can render realistically
      const initial = {};
      rawOptions.forEach((opt, idx) => {
        initial[opt.id] = (idx === 0 ? 14 : idx === 1 ? 9 : idx === 2 ? 4 : 2);
      });
      return initial;
    }

    function renderResults(selectedId) {
      const counts = getStoredCounts();
      let total = 0;
      rawOptions.forEach(opt => {
        total += (counts[opt.id] || 0);
      });

      const listEl = document.getElementById(`results-list-${slug}`);
      if (!listEl) return;

      listEl.innerHTML = '';

      // Sort by count descending
      const sorted = [...rawOptions].map(opt => {
        const count = counts[opt.id] || 0;
        const pct = total > 0 ? Math.round((count / total) * 100) : 0;
        return { ...opt, count, pct, isUserChoice: opt.id === selectedId };
      }).sort((a, b) => b.count - a.count);

      const topId = sorted[0]?.id;

      sorted.forEach((opt, index) => {
        const isTop = opt.id === topId;
        const card = document.createElement('div');
        card.className = isTop ? 'consensus-bar-card is-top-rank' : 'consensus-bar-card';
        if (opt.isUserChoice) card.classList.add('is-user-choice');

        card.innerHTML = `
          <div class="consensus-label-row">
            <div class="consensus-name-group">
              <span class="consensus-rank-badge">#${index + 1}</span>
              <span class="consensus-name">${opt.label}</span>
              ${opt.isUserChoice ? `<span class="user-choice-tag">${isKorean ? '나의 선택' : 'Your Choice'}</span>` : ''}
              ${isTop && !opt.isUserChoice ? `<span class="top-consensus-tag">${isKorean ? '최다 지목' : 'Majority'}</span>` : ''}
            </div>
            <div class="consensus-pct-group">
              <span class="consensus-pct-value">${opt.pct}%</span>
              <span class="consensus-count-label">(${opt.count.toLocaleString()}${isKorean ? '표' : ' votes'})</span>
            </div>
          </div>
          <div class="consensus-track">
            <div class="${isTop ? 'consensus-fill is-top-fill' : 'consensus-fill'}" style="width: ${opt.pct}%"></div>
          </div>
        `;
        listEl.appendChild(card);
      });

      const votingView = document.getElementById(`voting-view-${slug}`);
      const resultsView = document.getElementById(`results-view-${slug}`);
      if (votingView) votingView.classList.add('hidden');
      if (resultsView) resultsView.classList.remove('hidden');
    }

    // Check if user already voted
    const existingVote = localStorage.getItem(storageKey);
    if (existingVote) {
      renderResults(existingVote);
    }

    // Cast button handler
    const castBtn = document.getElementById(`btn-cast-${slug}`);
    if (castBtn) {
      castBtn.addEventListener('click', function() {
        const selectedRadio = container.querySelector(`input[name="verdict-choice-${slug}"]:checked`);
        if (!selectedRadio) {
          alert(isKorean ? '판결 항목을 하나 선택해 주세요.' : 'Please select an option to cast your verdict.');
          return;
        }
        const chosenId = selectedRadio.value;
        localStorage.setItem(storageKey, chosenId);

        // Increment count
        const counts = getStoredCounts();
        counts[chosenId] = (counts[chosenId] || 0) + 1;
        localStorage.setItem(countsKey, JSON.stringify(counts));

        renderResults(chosenId);
      });
    }

    // View results without voting
    const viewBtn = document.getElementById(`btn-view-${slug}`);
    if (viewBtn) {
      viewBtn.addEventListener('click', function() {
        renderResults(null);
      });
    }
  })();
</script>

<style>
  .verdict-container {
    background: #141414;
    border: 1px solid #262626;
    border-radius: 16px;
    padding: 2rem;
    margin: 3rem 0;
    position: relative;
    overflow: hidden;
    box-shadow: 0 12px 35px rgba(0, 0, 0, 0.45);
    box-sizing: border-box;
    min-width: 0;
  }

  .verdict-top-accent {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 3px;
    background: linear-gradient(90deg, #f43f5e, #e11d48, #fb7185);
  }

  .verdict-header {
    margin-bottom: 1.75rem;
  }

  .verdict-badge-row {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 0.75rem;
  }

  .verdict-badge {
    font-family: ui-monospace, monospace;
    font-size: 0.75rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: #fb7185;
    background: rgba(244, 63, 94, 0.12);
    border: 1px solid rgba(244, 63, 94, 0.25);
    padding: 0.2rem 0.6rem;
    border-radius: 4px;
  }

  .verdict-badge-sub {
    font-family: ui-monospace, monospace;
    font-size: 0.7rem;
    font-weight: 700;
    color: #a3a3a3;
    letter-spacing: 0.08em;
  }

  .verdict-heading {
    font-size: 1.35rem;
    font-weight: 800;
    color: #ffffff;
    line-height: 1.35;
    margin: 0 0 0.5rem 0;
    letter-spacing: -0.01em;
  }

  .verdict-subtext {
    font-size: 0.9rem;
    color: #a3a3a3;
    line-height: 1.5;
    margin: 0;
  }

  .verdict-options-grid {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    margin-bottom: 1.5rem;
  }

  .verdict-option-card {
    display: flex;
    align-items: center;
    background: #1a1a1a;
    border: 1px solid #2a2a2a;
    border-radius: 10px;
    padding: 0.9rem 1.15rem;
    cursor: pointer;
    transition: border-color 0.15s ease, background 0.15s ease;
  }

  .verdict-option-card:hover {
    background: #222222;
    border-color: #404040;
  }

  .verdict-radio {
    accent-color: #f43f5e;
    width: 18px;
    height: 18px;
    margin-right: 0.85rem;
    cursor: pointer;
  }

  .option-content-wrap {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    flex: 1;
  }

  .option-letter {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 22px;
    height: 22px;
    border-radius: 4px;
    background: #262626;
    color: #d4d4d4;
    font-family: ui-monospace, monospace;
    font-size: 0.75rem;
    font-weight: 800;
  }

  .option-text {
    font-size: 0.95rem;
    color: #e5e5e5;
    font-weight: 500;
    line-height: 1.4;
  }

  .verdict-action-row {
    display: flex;
    align-items: center;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .cast-verdict-btn {
    background: linear-gradient(135deg, #f43f5e, #e11d48);
    color: #ffffff;
    border: none;
    border-radius: 8px;
    padding: 0.75rem 1.4rem;
    font-size: 0.9rem;
    font-weight: 700;
    cursor: pointer;
    box-shadow: 0 4px 14px rgba(244, 63, 94, 0.35);
    transition: transform 0.15s ease, background 0.15s ease;
  }

  .cast-verdict-btn:hover {
    transform: translateY(-1px);
    background: linear-gradient(135deg, #fb7185, #f43f5e);
  }

  .view-results-text-btn {
    background: transparent;
    border: none;
    color: #a3a3a3;
    font-size: 0.85rem;
    font-weight: 600;
    cursor: pointer;
    text-decoration: underline;
  }

  .view-results-text-btn:hover {
    color: #f43f5e;
  }

  .consensus-breakdown-list {
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
    margin-bottom: 1.5rem;
  }

  .consensus-bar-card {
    background: #1a1a1a;
    border: 1px solid #2a2a2a;
    border-radius: 10px;
    padding: 0.9rem 1.15rem;
    transition: transform 0.15s ease, border-color 0.15s ease;
  }

  .consensus-bar-card.is-top-rank {
    background: rgba(244, 63, 94, 0.04);
    border-color: rgba(244, 63, 94, 0.35);
  }

  .consensus-bar-card.is-user-choice {
    border-color: #3b82f6;
    background: rgba(59, 130, 246, 0.05);
  }

  .consensus-label-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 0.65rem;
    flex-wrap: wrap;
  }

  .consensus-name-group {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex: 1;
    min-width: 200px;
  }

  .consensus-rank-badge {
    font-family: ui-monospace, monospace;
    font-size: 0.75rem;
    font-weight: 800;
    color: #737373;
    background: #262626;
    padding: 0.15rem 0.4rem;
    border-radius: 4px;
  }

  .consensus-name {
    font-size: 0.9rem;
    font-weight: 600;
    color: #e5e5e5;
    line-height: 1.35;
  }

  .top-consensus-tag {
    font-family: ui-monospace, monospace;
    font-size: 0.65rem;
    font-weight: 800;
    color: #f43f5e;
    background: rgba(244, 63, 94, 0.15);
    padding: 0.15rem 0.45rem;
    border-radius: 4px;
    letter-spacing: 0.04em;
  }

  .user-choice-tag {
    font-family: ui-monospace, monospace;
    font-size: 0.65rem;
    font-weight: 800;
    color: #3b82f6;
    background: rgba(59, 130, 246, 0.15);
    padding: 0.15rem 0.45rem;
    border-radius: 4px;
    letter-spacing: 0.04em;
  }

  .consensus-pct-group {
    display: flex;
    align-items: baseline;
    gap: 0.4rem;
  }

  .consensus-pct-value {
    font-family: ui-monospace, monospace;
    font-size: 1.15rem;
    font-weight: 800;
    color: #ffffff;
  }

  .consensus-count-label {
    font-family: ui-monospace, monospace;
    font-size: 0.75rem;
    color: #737373;
  }

  .consensus-track {
    width: 100%;
    height: 8px;
    background: #262626;
    border-radius: 999px;
    overflow: hidden;
  }

  .consensus-fill {
    height: 100%;
    background: #737373;
    border-radius: 999px;
    transition: width 0.6s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .consensus-fill.is-top-fill {
    background: linear-gradient(90deg, #f43f5e, #fb7185);
  }

  .verdict-footer {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    padding-top: 1rem;
    border-top: 1px solid #262626;
    flex-wrap: wrap;
  }

  .footer-stat-item {
    font-size: 0.8rem;
    color: #10b981;
    font-weight: 700;
  }

  .footer-source-note {
    font-size: 0.75rem;
    color: #737373;
    font-family: ui-monospace, monospace;
  }

  .hidden {
    display: none !important;
  }

  /* Light mode styles */
  :global(html:not(.dark)) .verdict-container {
    background: #ffffff;
    border-color: #e2e8f0;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.05);
  }
  :global(html:not(.dark)) .verdict-heading { color: #0f172a; }
  :global(html:not(.dark)) .verdict-subtext { color: #64748b; }
  :global(html:not(.dark)) .verdict-option-card {
    background: #f8fafc;
    border-color: #e2e8f0;
  }
  :global(html:not(.dark)) .verdict-option-card:hover {
    background: #f1f5f9;
    border-color: #cbd5e1;
  }
  :global(html:not(.dark)) .option-text { color: #1e293b; }
  :global(html:not(.dark)) .consensus-bar-card {
    background: #f8fafc;
    border-color: #e2e8f0;
  }
  :global(html:not(.dark)) .consensus-name { color: #1e293b; }
  :global(html:not(.dark)) .consensus-pct-value { color: #0f172a; }
  :global(html:not(.dark)) .consensus-track { background: #e2e8f0; }
  :global(html:not(.dark)) .verdict-footer { border-color: #e2e8f0; }
</style>
