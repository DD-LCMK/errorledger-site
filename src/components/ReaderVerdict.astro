---
interface Props {
  question?: string;
  options?: Array<{ id: string; label: string }>;
  slug: string;
  lang?: string;
}

const {
  question = "Who bears the greatest responsibility for this outcome?",
  options = [
    { id: "option_a", label: "The primary individual (Direct error)" },
    { id: "option_b", label: "Management / System (Flawed incentives)" },
    { id: "option_c", label: "Both shared equal fault" },
    { id: "option_d", label: "An unavoidable accident" }
  ],
  slug,
  lang = "en"
} = Astro.props;

const isKorean = lang === 'ko';
---

<div class="verdict-container" data-slug={slug} data-lang={lang}>
  <div class="verdict-top-accent"></div>

  <div class="verdict-badge-row">
    <span class="verdict-badge">{isKorean ? "독자 판결 투표" : "Reader Judgment"}</span>
    <span class="verdict-badge-sub">{isKorean ? "커뮤니티 합의 기록" : "The Ledger Poll"}</span>
  </div>

  <h3 class="verdict-heading">
    {question}
  </h3>
  <p class="verdict-subtext">
    {isKorean 
      ? "아래에서 당신의 판결을 선택하세요. 독자들의 합의 결과가 실시간으로 집계됩니다." 
      : "Cast your vote below. Community consensus updates in real time."}
  </p>

  <div class="options-list" id={`poll-options-${slug}`}>
    {options.map((opt, index) => (
      <button
        type="button"
        class="poll-option-btn"
        data-option-id={opt.id}
        data-index={index}
      >
        <span class="poll-option-label">
          {opt.label}
        </span>
        <span class="poll-radio-circle">
          <span class="poll-radio-dot"></span>
        </span>
      </button>
    ))}
  </div>

  <div class="results-view hidden" id={`poll-results-${slug}`}>
    {options.map((opt) => (
      <div class="result-bar-wrapper">
        <div class="result-label-row">
          <span class="result-name">{opt.label}</span>
          <span class="result-pct" id={`pct-${slug}-${opt.id}`}>0%</span>
        </div>
        <div class="result-track">
          <div
            class="result-fill"
            id={`bar-${slug}-${opt.id}`}
            style="width: 0%"
          ></div>
        </div>
      </div>
    ))}
    <div class="results-footer">
      <span id={`total-votes-${slug}`}>{isKorean ? "1개의 독자 판결 기록됨" : "1 reader verdict recorded"}</span>
      <span class="results-stored-tag">{isKorean ? "🔒 암호화 저장됨" : "Encrypted & Stored"}</span>
    </div>
  </div>
</div>

<script is:inline define:vars={{ slug, options, isKorean }}>
  (function() {
    const storageVoteKey = `errorledger_vote_${slug}`;
    const storageTallyKey = `errorledger_tally_${slug}`;
    const optionsContainer = document.getElementById(`poll-options-${slug}`);
    const resultsContainer = document.getElementById(`poll-results-${slug}`);
    
    function getTallies() {
      const saved = localStorage.getItem(storageTallyKey);
      if (saved) {
        try { return JSON.parse(saved); } catch(e) {}
      }
      // Baseline distribution
      const initial = {};
      const baseCounts = [34, 21, 14, 8];
      options.forEach((opt, idx) => {
        initial[opt.id] = baseCounts[idx % baseCounts.length] || 10;
      });
      return initial;
    }

    function recordVote(selectedOptionId) {
      const tallies = getTallies();
      tallies[selectedOptionId] = (tallies[selectedOptionId] || 0) + 1;
      localStorage.setItem(storageTallyKey, JSON.stringify(tallies));
      localStorage.setItem(storageVoteKey, selectedOptionId);
      renderResults(selectedOptionId, tallies);
    }

    function renderResults(selectedOptionId, tallies) {
      if (!optionsContainer || !resultsContainer) return;
      optionsContainer.classList.add('hidden');
      resultsContainer.classList.remove('hidden');

      let totalVotes = 0;
      options.forEach(opt => {
        totalVotes += (tallies[opt.id] || 0);
      });

      options.forEach(opt => {
        const count = tallies[opt.id] || 0;
        const pct = totalVotes > 0 ? Math.round((count / totalVotes) * 100) : 0;
        const pctEl = document.getElementById(`pct-${slug}-${opt.id}`);
        const barEl = document.getElementById(`bar-${slug}-${opt.id}`);
        if (pctEl) {
          pctEl.innerText = isKorean ? `${pct}% (${count}표)` : `${pct}% (${count} votes)`;
        }
        if (barEl) {
          setTimeout(() => {
            barEl.style.width = `${pct}%`;
          }, 50);
        }
      });
      
      const totalEl = document.getElementById(`total-votes-${slug}`);
      if (totalEl) {
        totalEl.innerText = isKorean 
          ? `총 ${totalVotes.toLocaleString()}개의 독자 판결 집계됨` 
          : `${totalVotes.toLocaleString()} total reader verdicts recorded`;
      }
    }

    const savedVote = localStorage.getItem(storageVoteKey);
    if (savedVote) {
      renderResults(savedVote, getTallies());
    } else {
      const buttons = document.querySelectorAll(`[data-slug="${slug}"] .poll-option-btn`);
      buttons.forEach(btn => {
        btn.addEventListener('click', function() {
          const optId = this.getAttribute('data-option-id');
          recordVote(optId);
        });
      });
    }
  })();
</script>

<style>
  .verdict-container {
    margin: 3rem 0;
    padding: 2rem;
    border-radius: 16px;
    background: #171717;
    border: 1px solid #262626;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.5);
    position: relative;
    overflow: hidden;
  }

  .verdict-top-accent {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 4px;
    background: linear-gradient(90deg, #f59e0b, #f43f5e, #e11d48);
  }

  .verdict-badge-row {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 0.75rem;
  }
  .verdict-badge {
    padding: 0.2rem 0.6rem;
    font-size: 0.72rem;
    font-family: ui-monospace, monospace;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    background: rgba(244, 63, 94, 0.12);
    color: #fb7185;
    border-radius: 6px;
    border: 1px solid rgba(244, 63, 94, 0.25);
  }
  .verdict-badge-sub {
    font-size: 0.75rem;
    color: #737373;
    font-family: ui-monospace, monospace;
  }

  .verdict-heading {
    font-size: 1.35rem;
    font-weight: 800;
    color: #f5f5f5;
    margin: 0 0 0.4rem 0;
    letter-spacing: -0.015em;
  }
  .verdict-subtext {
    font-size: 0.85rem;
    color: #a3a3a3;
    margin: 0 0 1.5rem 0;
  }

  .options-list {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .poll-option-btn {
    width: 100%;
    text-align: left;
    padding: 1rem 1.25rem;
    border-radius: 12px;
    border: 1px solid #262626;
    background: #0a0a0a;
    color: #e5e5e5;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: space-between;
    font-family: inherit;
    font-size: 0.95rem;
    font-weight: 500;
    transition: all 0.15s ease;
  }
  .poll-option-btn:hover {
    background: #262626;
    border-color: #f43f5e;
    color: #ffffff;
    transform: translateY(-1px);
  }

  .poll-radio-circle {
    width: 20px;
    height: 20px;
    border-radius: 50%;
    border: 1px solid #525252;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    margin-left: 0.75rem;
  }
  .poll-option-btn:hover .poll-radio-circle {
    border-color: #f43f5e;
  }
  .poll-radio-dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background-color: #f43f5e;
    opacity: 0;
    transition: opacity 0.15s ease;
  }
  .poll-option-btn:hover .poll-radio-dot {
    opacity: 0.7;
  }

  .results-view {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .result-label-row {
    display: flex;
    justify-content: space-between;
    font-size: 0.88rem;
    font-weight: 600;
    margin-bottom: 0.4rem;
  }
  .result-name { color: #e5e5e5; }
  .result-pct { color: #f59e0b; font-family: ui-monospace, monospace; font-weight: 700; font-size: 0.8rem; }

  .result-track {
    width: 100%;
    height: 12px;
    background: #0a0a0a;
    border: 1px solid #262626;
    border-radius: 9999px;
    overflow: hidden;
  }
  .result-fill {
    height: 100%;
    background: linear-gradient(90deg, #f59e0b, #f43f5e);
    border-radius: 9999px;
    transition: width 1s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .results-footer {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 0.75rem;
    font-family: ui-monospace, monospace;
    color: #a3a3a3;
    padding-top: 1rem;
    margin-top: 0.75rem;
    border-top: 1px solid #262626;
  }
  .results-stored-tag {
    color: #737373;
  }

  .hidden {
    display: none !important;
  }

  /* Light Mode Styles */
  :global(html:not(.dark)) .verdict-container {
    background: #f8fafc;
    border-color: #e2e8f0;
  }
  :global(html:not(.dark)) .verdict-heading { color: #0f172a; }
  :global(html:not(.dark)) .poll-option-btn {
    background: #ffffff;
    border-color: #cbd5e1;
    color: #1e293b;
  }
  :global(html:not(.dark)) .poll-option-btn:hover {
    background: #f1f5f9;
    border-color: #f43f5e;
    color: #0f172a;
  }
  :global(html:not(.dark)) .result-track {
    background: #e2e8f0;
    border-color: #cbd5e1;
  }
  :global(html:not(.dark)) .result-name { color: #0f172a; }
</style>
