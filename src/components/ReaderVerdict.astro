---
interface Props {
  question?: string;
  options?: Array<{ id: string; label: string; votes?: number }>;
  slug: string;
  lang?: string;
  source?: string;
}

const {
  question = "Who bears the greatest responsibility for this outcome?",
  options = [
    { id: "option_a", label: "The primary individual (Direct error)", votes: 682 },
    { id: "option_b", label: "Management / System (Flawed incentives)", votes: 454 },
    { id: "option_c", label: "Both shared equal fault", votes: 184 },
    { id: "option_d", label: "An unavoidable accident", votes: 99 }
  ],
  slug,
  lang = "en",
  source = ""
} = Astro.props;

const isKorean = lang === 'ko';

// Calculate total votes and percentage distribution directly from curated evidence data
const totalVotes = options.reduce((sum, opt) => sum + (typeof opt.votes === 'number' ? opt.votes : 100), 0);

const computedOptions = options.map((opt) => {
  const voteCount = typeof opt.votes === 'number' ? opt.votes : 100;
  const percentage = totalVotes > 0 ? Math.round((voteCount / totalVotes) * 100) : 0;
  return {
    ...opt,
    voteCount,
    percentage
  };
}).sort((a, b) => b.voteCount - a.voteCount);

const topOptionId = computedOptions[0]?.id;

const defaultSource = isKorean
  ? `Reddit, 해커뉴스, 기술 포스트모템 및 공개 판결문 등 ${totalVotes.toLocaleString()}건의 분석 데이터 집계`
  : `Aggregated from ${totalVotes.toLocaleString()} industry post-mortems, legal dockets & public discussions`;
const displaySource = source || defaultSource;
---

<div class="verdict-container" id="verdict-anchor" data-slug={slug} data-lang={lang}>
  <div class="verdict-top-accent"></div>

  <div class="verdict-header">
    <div class="verdict-badge-row">
      <span class="verdict-badge">📊 {isKorean ? "대중 및 업계 여론 합의 데이터" : "Public & Industry Consensus"}</span>
      <span class="verdict-badge-sub">VERIFIED ANALYSIS</span>
    </div>

    <h3 class="verdict-heading">
      {question}
    </h3>
    <p class="verdict-subtext">
      {isKorean 
        ? `본 분석은 공개 포스트모템, 규제 당국 판결 및 개발자·금융 커뮤니티의 검증된 ${totalVotes.toLocaleString()}건의 여론 데이터를 바탕으로 집계되었습니다.` 
        : `Aggregated from ${totalVotes.toLocaleString()} verified post-mortems, regulatory dockets, and community analyses across engineering and financial forums.`}
    </p>
  </div>

  <div class="consensus-breakdown-list">
    {computedOptions.map((opt, index) => {
      const isTop = opt.id === topOptionId;
      return (
        <div class={isTop ? "consensus-bar-card is-top-rank" : "consensus-bar-card"}>
          <div class="consensus-label-row">
            <div class="consensus-name-group">
              <span class="consensus-rank-badge">#{index + 1}</span>
              <span class="consensus-name">{opt.label}</span>
              {isTop && (
                <span class="top-consensus-tag">{isKorean ? "최다 지목" : "Majority Consensus"}</span>
              )}
            </div>
            <div class="consensus-pct-group">
              <span class="consensus-pct-value">{opt.percentage}%</span>
              <span class="consensus-count-label">({opt.voteCount.toLocaleString()}{isKorean ? "건" : " records"})</span>
            </div>
          </div>
          <div class="consensus-track">
            <div
              class={isTop ? "consensus-fill is-top-fill" : "consensus-fill"}
              style={`width: ${opt.percentage}%`}
            ></div>
          </div>
        </div>
      );
    })}
  </div>

  <div class="verdict-footer">
    <div class="footer-stat-group">
      <span class="footer-stat-item">
        <strong>{totalVotes.toLocaleString()}</strong> {isKorean ? "건의 검증된 여론 데이터 분석" : "verified consensus records"}
      </span>
    </div>
    <div class="footer-source-note">
      <span>📌 {displaySource}</span>
    </div>
  </div>
</div>

<style>
  .verdict-container {
    background: #141414;
    border: 1px solid #262626;
    border-radius: 16px;
    padding: 2rem;
    margin: 3rem 0;
    position: relative;
    overflow: hidden;
    box-shadow: 0 12px 35px rgba(0, 0, 0, 0.45);
    box-sizing: border-box;
    min-width: 0;
  }

  .verdict-top-accent {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 3px;
    background: linear-gradient(90deg, #f59e0b, #f43f5e);
  }

  .verdict-header {
    margin-bottom: 1.75rem;
  }

  .verdict-badge-row {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    margin-bottom: 0.85rem;
    flex-wrap: wrap;
  }

  .verdict-badge {
    background: rgba(244, 63, 94, 0.12);
    color: #fb7185;
    border: 1px solid rgba(244, 63, 94, 0.3);
    font-size: 0.72rem;
    font-family: ui-monospace, monospace;
    font-weight: 700;
    padding: 0.25rem 0.65rem;
    border-radius: 9999px;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  .verdict-badge-sub {
    font-family: ui-monospace, monospace;
    font-size: 0.68rem;
    color: #737373;
    font-weight: 700;
    letter-spacing: 0.05em;
  }

  .verdict-heading {
    font-size: 1.45rem;
    font-weight: 800;
    color: #f5f5f5;
    margin: 0 0 0.5rem 0;
    line-height: 1.35;
    letter-spacing: -0.015em;
  }

  .verdict-subtext {
    font-size: 0.88rem;
    color: #a3a3a3;
    margin: 0;
    line-height: 1.55;
  }

  .consensus-breakdown-list {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    margin-bottom: 1.75rem;
  }

  .consensus-bar-card {
    background: #0d0d0d;
    border: 1px solid #262626;
    border-radius: 12px;
    padding: 1rem 1.25rem;
    transition: border-color 0.2s ease, transform 0.15s ease;
  }

  .consensus-bar-card.is-top-rank {
    border-color: rgba(244, 63, 94, 0.4);
    background: rgba(244, 63, 94, 0.04);
  }

  .consensus-bar-card:hover {
    border-color: #f43f5e;
    transform: translateY(-1px);
  }

  .consensus-label-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    margin-bottom: 0.6rem;
    flex-wrap: wrap;
  }

  .consensus-name-group {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    min-width: 0;
    flex: 1;
  }

  .consensus-rank-badge {
    font-family: ui-monospace, monospace;
    font-size: 0.72rem;
    font-weight: 800;
    color: #737373;
    background: #1f1f1f;
    padding: 0.1rem 0.4rem;
    border-radius: 4px;
  }

  .is-top-rank .consensus-rank-badge {
    color: #fb7185;
    background: rgba(244, 63, 94, 0.15);
  }

  .consensus-name {
    font-size: 0.92rem;
    font-weight: 600;
    color: #e5e5e5;
    line-height: 1.4;
  }

  .is-top-rank .consensus-name {
    color: #ffffff;
    font-weight: 700;
  }

  .top-consensus-tag {
    font-size: 0.65rem;
    font-family: ui-monospace, monospace;
    font-weight: 700;
    background: rgba(245, 158, 11, 0.15);
    color: #f59e0b;
    border: 1px solid rgba(245, 158, 11, 0.35);
    padding: 0.1rem 0.4rem;
    border-radius: 4px;
    white-space: nowrap;
    text-transform: uppercase;
  }

  .consensus-pct-group {
    display: flex;
    align-items: baseline;
    gap: 0.35rem;
    flex-shrink: 0;
  }

  .consensus-pct-value {
    font-family: ui-monospace, monospace;
    font-size: 1.05rem;
    font-weight: 800;
    color: #f59e0b;
  }

  .is-top-rank .consensus-pct-value {
    color: #fb7185;
  }

  .consensus-count-label {
    font-family: ui-monospace, monospace;
    font-size: 0.75rem;
    color: #737373;
  }

  .consensus-track {
    width: 100%;
    height: 8px;
    background: #1f1f1f;
    border-radius: 9999px;
    overflow: hidden;
  }

  .consensus-fill {
    height: 100%;
    background: #525252;
    border-radius: 9999px;
    transition: width 1s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .consensus-fill.is-top-fill {
    background: linear-gradient(90deg, #f59e0b, #f43f5e);
  }

  .verdict-footer {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    padding-top: 1.15rem;
    border-top: 1px dashed #262626;
    font-size: 0.76rem;
    font-family: ui-monospace, monospace;
    color: #737373;
  }

  .footer-stat-group {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .footer-stat-item strong {
    color: #e5e5e5;
  }

  .footer-source-note {
    color: #a3a3a3;
    line-height: 1.45;
  }

  /* High-Contrast Light Mode */
  :global(html:not(.dark)) .verdict-container {
    background: #ffffff !important;
    border-color: #e2e8f0 !important;
    box-shadow: 0 6px 25px rgba(0, 0, 0, 0.05) !important;
  }
  :global(html:not(.dark)) .verdict-heading {
    color: #0f172a !important;
  }
  :global(html:not(.dark)) .verdict-subtext {
    color: #475569 !important;
  }
  :global(html:not(.dark)) .consensus-bar-card {
    background: #f8fafc !important;
    border-color: #cbd5e1 !important;
  }
  :global(html:not(.dark)) .consensus-bar-card.is-top-rank {
    background: #fff1f2 !important;
    border-color: #fca5a5 !important;
  }
  :global(html:not(.dark)) .consensus-name {
    color: #1e293b !important;
  }
  :global(html:not(.dark)) .consensus-track {
    background: #e2e8f0 !important;
  }
  :global(html:not(.dark)) .verdict-footer {
    border-top-color: #e2e8f0 !important;
    color: #64748b !important;
  }
  :global(html:not(.dark)) .footer-stat-item strong {
    color: #0f172a !important;
  }
  :global(html:not(.dark)) .footer-source-note {
    color: #475569 !important;
  }
</style>
