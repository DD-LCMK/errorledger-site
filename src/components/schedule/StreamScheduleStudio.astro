            <button type="button" class="btn-quick-end" data-time={isEn ? 'TBD' : '방종시'}>{isEn ? 'TBD' : '방종시'}</button>
            <button type="button" class="btn-quick-end" data-time={isEn ? 'Late' : '새벽'}>{isEn ? 'Late' : '새벽'}</button>
          </div>
          <span class="field-hint">{isEn ? "Entering both start & end times will automatically format as '20:00 ~ 23:30'." : "시작/종료 시간을 모두 입력하면 '20:00 ~ 23:30' 형태로 자동 표기됩니다."}</span>
        </div>

        <div class="modal-form-group">
          <label>{isEn ? 'Broadcast Title / Keyword' : '방송 콘텐츠 제목 / 키워드'}</label>
          <input type="text" id="modalTitleInput" class="modal-input" placeholder={isEn ? 'e.g. Just Chatting / Variety Games / Mukbang / Ranked' : '예: 저챗 / 종합 게임 / 먹방 / 롤 랭크'} maxlength="40" />
          <span class="field-hint">{isEn ? 'Main title prominently displayed on ticket.' : '티켓 상단에 크게 들어갈 메인 제목입니다.'}</span>
        </div>

        <div class="modal-form-group">
          <label>{isEn ? 'Details / Subtitle (Optional)' : '상세 안내 / 부제목 (선택)'}</label>
          <input type="text" id="modalMemoInput" class="modal-input" placeholder={isEn ? 'e.g. Community Giveaway Matches / New Indie Game' : '예: 치킨 시참 내기전 / 신작 인디게임 켠왕'} maxlength="45" />
          <span class="field-hint">{isEn ? 'Secondary description in the middle of ticket.' : '티켓 중앙에 들어갈 보조 설명 문구입니다.'}</span>
