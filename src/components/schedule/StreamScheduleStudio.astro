  // ─── Multi-Format Text Copy for Fan Cafe / Chzzk / Discord / SOOP / X ──────
  function buildFormattedScheduleText(formatType: string): string {
    var weeks = computeMonthWeeks(state.monthly.year, state.monthly.month);
    var currentWeek = weeks[state.selectedWeekIndex] || weeks[0];
    var chName = state.channel.name || (isEn ? 'Streamer' : '스트리머');
    var weeklyNotice = state.channel.noticeWeekly || state.channel.notice || '';
    var tagline = state.channel.tagline || '';
    var defaultDayTitle = isEn ? 'Live Stream' : '방송 예정';

    if (formatType === 'discord') {
      var md = '## 📢 [' + chName + '] ' + state.monthly.year + '.' + state.monthly.month + ' ' + currentWeek.label + '\n';
      if (weeklyNotice) {
        md += '> 💬 **' + weeklyNotice + '**\n';
      }
      md += '\n';
      currentWeek.days.forEach(function (d: any) {
        var entry = d.entry || {};
        var badge = STATUS_BADGES[entry.status] || STATUS_BADGES.live;
        var dayTag = isEn ? d.dayEn : d.dayKo;
        var isOff = entry.status === 'off' || entry.title === 'OFFLINE';
        var timeStr = isOff ? (isEn ? 'OFF' : '휴방') : (formatDisplayTime(entry, isEn ? 'en' : 'ko') || entry.time || (isEn ? 'Flexible' : '자율'));
        var titleStr = isOff ? (isEn ? 'OFFLINE (Rest Day)' : '정규 휴방 (재충전)') : (entry.title || defaultDayTitle);
        var memoSuffix = (!isOff && entry.memo) ? (' — *' + entry.memo + '*') : '';
        md += '- **`' + d.dateStr + ' (' + dayTag + ')`** ' + badge.icon + ' `' + timeStr + '` ｜ **' + titleStr + '**' + memoSuffix + '\n';
      });
      if (tagline) {
        md += '\n📺 *' + tagline + '*';
      }
      return md;
    }

    if (formatType === 'soop') {
      var sp = '━━━━━━━━━━━━━━━━━━━━━━\n';
      sp += '📅 [' + chName + '] ' + state.monthly.year + '년 ' + state.monthly.month + '월 ' + currentWeek.shortLabel + ' 방송 일정 안내\n';
      sp += '━━━━━━━━━━━━━━━━━━━━━━\n';
      if (weeklyNotice) {
        sp += '📌 ' + weeklyNotice + '\n\n';
      }
      currentWeek.days.forEach(function (d: any) {
        var entry = d.entry || {};
        var badge = STATUS_BADGES[entry.status] || STATUS_BADGES.live;
        var dayTag = isEn ? d.dayEn : d.dayKo;
        var isOff = entry.status === 'off' || entry.title === 'OFFLINE';
        var timeStr = isOff ? (isEn ? 'OFF' : '휴방') : (formatDisplayTime(entry, isEn ? 'en' : 'ko') || entry.time || (isEn ? 'Flexible' : '자율'));
        var titleStr = isOff ? (isEn ? 'OFFLINE' : '휴방') : (entry.title || defaultDayTitle);
        var memoStr = (!isOff && entry.memo) ? (' (' + entry.memo + ')') : '';
        sp += '[' + d.dateStr + ' ' + dayTag + '] ' + badge.icon + ' ' + timeStr + ' ▶ ' + titleStr + memoStr + '\n';
      });
      sp += '━━━━━━━━━━━━━━━━━━━━━━\n';
      if (tagline) {
        sp += '✨ ' + tagline;
      }
      return sp;
    }

    if (formatType === 'sns') {
      var sns = '📅 [' + chName + '] ' + currentWeek.rangeStr + ' 주간 방송 일정\n\n';
      currentWeek.days.forEach(function (d: any) {
        var entry = d.entry || {};
        var dayTag = isEn ? d.dayEn : d.dayKo;
        var isOff = entry.status === 'off' || entry.title === 'OFFLINE';
        var timeStr = isOff ? '💤휴방' : ('⏰' + (entry.startTime || entry.time || '20:00'));
        var titleStr = isOff ? '' : (' ' + (entry.title || defaultDayTitle));
        sns += dayTag + '(' + d.dateStr + ') ' + timeStr + titleStr + '\n';
      });
      sns += '\n#치지직 #방송일정 #스트리머 #' + chName.replace(/\s+/g, '');
      return sns;
    }

    // Default: 'cafe' (Naver Fan Cafe / Chzzk Lounge)
    var text = '┌─────────────────────────────────┐\n';
    text += '  📢 [' + chName + '] ' + state.monthly.year + '.' + state.monthly.month + ' ' + currentWeek.label + '\n';
    text += '└─────────────────────────────────┘\n';
    if (weeklyNotice) {
      text += '💡 이번 주 공지: ' + weeklyNotice + '\n';
    }
    text += '\n';
    currentWeek.days.forEach(function (d: any) {
      var entry = d.entry || {};
      var badge = STATUS_BADGES[entry.status] || STATUS_BADGES.live;
      var dayTag = isEn ? d.dayEn : d.dayKo;
      var isOff = entry.status === 'off' || entry.title === 'OFFLINE';
      var timeStr = isOff ? (isEn ? 'OFF' : '휴방') : (formatDisplayTime(entry, isEn ? 'en' : 'ko') || entry.time || (isEn ? 'Flexible' : '자율'));
      var titleStr = isOff ? (isEn ? 'Rest Day (OFFLINE)' : '정규 휴방일') : (entry.title || defaultDayTitle);
      var memoSuffix = (!isOff && entry.memo) ? (' (' + entry.memo + ')') : '';
      text += '• ' + d.dateStr + ' (' + dayTag + ') : ' + badge.icon + ' ' + timeStr + ' | ' + titleStr + memoSuffix + '\n';
    });
    if (tagline) {
      text += '\n📺 ' + tagline;
    }
    text += '\n🔗 편성표 제작: https://errorledger.com/' + (isEn ? 'en/' : '') + 'schedule';
    return text;
  }

  btnCopyText.addEventListener('click', function () {
    var formatType = (selectTextFormat && selectTextFormat.value) ? selectTextFormat.value : 'cafe';
    var text = buildFormattedScheduleText(formatType);

    if (navigator.clipboard) {
      navigator.clipboard.writeText(text).then(function () {
        if (btnCopyTextLabel) {
          var prev = btnCopyTextLabel.textContent;
          btnCopyTextLabel.textContent = isEn ? 'Copied! ✓' : '복사 완료! ✓';
          setTimeout(function () {
            if (btnCopyTextLabel) btnCopyTextLabel.textContent = prev;
          }, 2000);
        } else {
          alert(isEn ? '📋 Text copied to clipboard!' : '📋 선택한 양식으로 공지 텍스트가 복사되었습니다!');
        }
      });
    }
  });

  // ─── OBS Source URL Copy ──────────────────────────────────────────────────
  var btnCopyObsSchedule = document.getElementById('btnCopyObsSchedule');
  if (btnCopyObsSchedule) {
    btnCopyObsSchedule.addEventListener('click', function () {
      var url = new URL(window.location.href);
      url.searchParams.set('stream', 'true');
      if (navigator.clipboard) {
        navigator.clipboard.writeText(url.href).then(function () {
          alert(isEn ? '🎥 OBS Browser Source URL copied! (1920x1080 recommended)' : '🎥 OBS 브라우저 소스 URL이 복사되었습니다! (1920x1080 권장)');
        });
      } else {
        prompt('OBS URL:', url.href);
      }
    });
  }

  // Check URL params for stream/obs mode
  var params = new URLSearchParams(window.location.search);
  if (params.has('obs') || params.has('stream')) {
    root.classList.add('streamer-clean-mode');
  }

  // Initial Render
  renderAll();
})();
</script>
