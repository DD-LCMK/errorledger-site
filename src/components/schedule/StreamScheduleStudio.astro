            '<span class="bp-rivet bl"></span><span class="bp-rivet br"></span>' +
          '</div>' +
        '</div>';
    } else {
      innerContentHtml =
        '<div class="bp-ticket-body-content">' +
          '<div class="bp-ticket-title">' + escapeHtml(entry.title || defaultDayTitle) + '</div>' +
          '<div class="bp-ticket-memo">' + escapeHtml(entry.memo || '') + '</div>' +
          '<div class="bp-ticket-time">' + escapeHtml(displayTime) + '</div>' +
        '</div>';
    }

    card.innerHTML =
      '<div class="bp-ticket-ribbon-wrap">' +
        '<div class="bp-folded-ribbon">' +
          '<span class="bp-ribbon-fold-l"></span>' +
          '<span class="bp-ribbon-label">' + d.dayEn + ' · ' + d.dateStr + '</span>' +
          '<span class="bp-ribbon-fold-r"></span>' +
        '</div>' +
      '</div>' +
      '<div class="bp-ticket-inner-frame">' +
        innerContentHtml +
