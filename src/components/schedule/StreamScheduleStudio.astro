---
/**
 * StreamScheduleStudio.astro
 * Compact Single-Page Stream Broadcast Schedule Studio.
 * 
 * Features:
 * 1. Single-Page Fit: Entire board fits on screen at once without vertical scrolling.
 * 2. Unified Monthly Calendar: Plan the month once, extract any week with 1-click.
 * 3. Compact Stream Format: Clear sections for Day/Date, Status Badge, Time, and Short Title/Keyword.
 * 4. Local PC Save & Load (.json): Download template file to PC and re-upload anytime.
 * 5. One-Click Formatted Text Copy for Discord, Fan Cafe, and Social Announcements.
 * 6. OBS Clean Mode (?obs=1 / ?stream=1).
 */
import { SCHEDULE_THEMES, STATUS_BADGES, SAMPLE_PRESETS, SAMPLE_PRESETS_EN } from './scheduleTemplates';

interface Props {
  streamerMode?: boolean;
  lang?: 'ko' | 'en';
}
const { streamerMode = false, lang = 'ko' } = Astro.props;
const isEn = lang === 'en';
---

<div class={`schedule-studio-wrapper ${streamerMode ? 'streamer-clean-mode' : ''}`} id="scheduleStudioRoot" data-lang={lang}>
  <!-- Top Editor Controls Bar (Hidden in streamer/OBS clean mode) -->
  <div class="studio-controls-bar">
    <div class="controls-container">
      <!-- Row 1: Studio Title & File Export Actions -->
      <div class="controls-top-row">
        <div class="studio-title-badge">
          <span class="pulse-dot-schedule"></span>
          <span>📅 {isEn ? 'Stream Schedule Studio' : '방송 편성표 스튜디오'}</span>
          <span class="badge-single-page">{isEn ? 'Single-Page View' : '한 페이지 뷰'}</span>
        </div>
        <div class="quick-export-actions">
          <button type="button" class="btn-action btn-export-png" id="btnExportPng" title={isEn ? 'Download High-Resolution PNG Image' : '워터마크 없는 고화질 PNG 이미지로 저장'}>
            <span class="btn-icon">🖼️</span>
            <span id="btnExportPngLabel">{isEn ? 'Export PNG' : 'PNG 이미지 저장'}</span>
          </button>
          <button type="button" class="btn-action btn-save-json" id="btnSaveJson" title={isEn ? 'Save template file (.json) to your PC' : '내 PC에 템플릿 파일(.json) 저장'}>
            <span class="btn-icon">💾</span>
            <span>{isEn ? 'Save to PC' : '내 PC에 저장'}</span>
          </button>
          <label class="btn-action btn-load-json" title={isEn ? 'Load template file (.json) from PC' : '내 PC에서 템플릿 파일(.json) 불러오기'}>
            <span class="btn-icon">📂</span>
            <span>{isEn ? 'Load from PC' : 'PC에서 불러오기'}</span>
            <input type="file" id="inputLoadJson" accept=".json,application/json" style="display: none;" />
          </label>
          <div class="copy-text-group">
            <select id="selectTextFormat" class="select-text-format" aria-label={isEn ? 'Announcement Text Format' : '공지 텍스트 양식 선택'} title={isEn ? 'Choose Community Format' : '복사할 커뮤니티 공지 양식 선택'}>
              <option value="cafe">{isEn ? '📌 Community / Cafe' : '📌 팬카페·치지직 라운지'}</option>
              <option value="discord">{isEn ? '💬 Discord Markdown' : '💬 디스코드 마크다운'}</option>
              <option value="soop">{isEn ? '📺 YouTube / Station' : '📺 SOOP 방송국·유튜브'}</option>
              <option value="sns">{isEn ? '🐦 X (Twitter) Short' : '🐦 X(트위터) 요약+태그'}</option>
            </select>
            <button type="button" class="btn-action btn-copy-text" id="btnCopyText" title={isEn ? 'Copy formatted announcement text' : '선택한 양식으로 방송 공지 텍스트 복사'}>
              <span class="btn-icon">📋</span>
              <span id="btnCopyTextLabel">{isEn ? 'Copy Text' : '텍스트 복사'}</span>
            </button>
          </div>
          <button type="button" class="btn-action btn-copy-obs" id="btnCopyObsSchedule" title={isEn ? 'Copy OBS Browser Source URL' : 'OBS 브라우저 소스 URL 복사'}>
            <span class="btn-icon">🎥</span>
            <span>{isEn ? 'Copy OBS' : 'OBS 복사'}</span>
          </button>
        </div>
      </div>

      <!-- Row 2: View Mode, Layout Style Switcher, Week Extractor & Theme Picker -->
      <div class="controls-toolbar-row">
        <!-- View Mode & Layout Style Switcher -->
        <div class="toolbar-group">
          <label class="toolbar-label">{isEn ? 'View & Layout' : '보기 및 레이아웃'}</label>
          <div class="btn-group-mode" id="layoutStyleGroup">
            <button type="button" class="btn-mode active" data-mode="weekly" data-layout="bento" id="btnLayoutBento" title={isEn ? 'Modern 4x2 Bento Card Grid (Recommended)' : '모던 4x2 벤토 카드 그리드 (추천)'}>
              <span>🎴 {isEn ? 'Bento Grid' : '벤토 카드형'}</span>
            </button>
            <button type="button" class="btn-mode" data-mode="weekly" data-layout="timeline" id="btnLayoutTimeline" title={isEn ? 'Streamer Profile + 7-Day Timeline Poster' : '프로필 쇼케이스 + 7일 타임라인 포스터'}>
              <span>📋 {isEn ? 'Timeline Poster' : '타임라인 포스터'}</span>
            </button>
            <button type="button" class="btn-mode" data-mode="weekly" data-layout="ticket" id="btnModeWeekly" title={isEn ? 'Retro Travel Boarding Pass Ticket' : '여행 보딩패스 티켓 스타일'}>
              <span>🎫 {isEn ? 'Ticket Pass' : '보딩패스 티켓'}</span>
            </button>
            <button type="button" class="btn-mode" data-mode="monthly" id="btnModeMonthly" title={isEn ? 'Full monthly calendar view' : '월간 캘린더 전체 보기'}>
              <span>🗓️ {isEn ? 'Monthly' : '월간 캘린더'}</span>
            </button>
          </div>
        </div>

        <!-- Month & Week Extractor Buttons -->
        <div class="toolbar-group week-extractor-group" id="weekExtractorGroup">
          <label class="toolbar-label">{isEn ? 'Month & Week' : '연월 및 주차 선택'}</label>
          <div class="month-week-bar-wrap">
            <div class="quick-month-stepper">
              <button type="button" class="btn-month-mini" id="btnQuickPrevMonth" title={isEn ? 'Previous Month' : '이전 달'}>◀</button>
              <span class="quick-month-label" id="dispQuickMonthLabel">2026.09</span>
              <button type="button" class="btn-month-mini" id="btnQuickNextMonth" title={isEn ? 'Next Month' : '다음 달'}>▶</button>
              <button type="button" class="btn-today-jump" id="btnJumpToday" title={isEn ? 'Jump to Current Week' : '오늘이 속한 주로 이동'}>{isEn ? 'Today' : '이번 주'}</button>
            </div>
            <div class="week-buttons-bar" id="weekButtonsBar">
              <!-- Dynamically generated week buttons -->
            </div>
          </div>
        </div>

        <!-- Theme Picker -->
        <div class="toolbar-group theme-group">
          <label class="toolbar-label">{isEn ? 'Color Theme' : '컬러 테마'}</label>
          <div class="theme-picker-compact" id="themePickerRow">
            {Object.values(SCHEDULE_THEMES).map((t) => (
              <button 
                type="button" 
                class={`theme-chip ${t.id === 'chzzk-neon' ? 'active' : ''}`}
                data-theme-id={t.id}
                title={isEn ? t.nameEn : t.nameKo}
                style={`--theme-accent: ${t.accent};`}
              >
                <span class="theme-dot" style={`background: ${t.accent};`}></span>
                <span class="theme-name">{isEn ? t.nameEn : t.nameKo}</span>
              </button>
            ))}
          </div>
        </div>

        <!-- Channel Quick Inputs & Presets -->
        <div class="toolbar-group end-group">
          <label class="toolbar-label">{isEn ? 'Sample Presets' : '샘플 프리셋'}</label>
          <div class="toolbar-btns-row">
            <button type="button" class="btn-preset-mini" id="btnPresetGamer" title={isEn ? 'Variety game streamer sample (Bento Grid)' : '종합 게임 스트리머 샘플 (벤토 그리드)'}>{isEn ? '🎮 Gamer (Bento)' : '🎮 종합게임'}</button>
            <button type="button" class="btn-preset-mini" id="btnPresetVtuber" title={isEn ? 'VTuber / Cozy stream sample (Timeline Poster)' : '버튜버/힐링 샘플 (타임라인 포스터)'}>{isEn ? '🌸 VTuber (Poster)' : '🌸 버튜버'}</button>
            <button type="button" class="btn-preset-mini" id="btnPresetTravel" title={isEn ? 'Travel boarding pass ticket sample' : '여행 보딩패스 티켓 샘플'}>{isEn ? '✈️ Ticket' : '✈️ 여행티켓'}</button>
          </div>
        </div>
      </div>

      <!-- Channel Profile & Notices Settings Panel (Always Visible) -->
      <div class="channel-settings-panel">
        <div class="channel-settings-header">
          <span class="settings-title-icon">⚙️</span>
          <span class="settings-title-text">{isEn ? 'Streamer Profile, Avatar & Notice Settings (Click any day card below to edit schedule)' : '스트리머 프로필 · 아바타 이미지 · 공지사항 설정 (하단 요일 카드를 클릭하면 일정을 수정할 수 있습니다)'}</span>
        </div>
        <div class="channel-inputs-grid">
          <div class="input-field emoji-picker-col">
            <label>{isEn ? 'Avatar (Emoji or Image Upload)' : '프로필 아이콘 (이모지 또는 이미지 업로드)'}</label>
            <div class="emoji-picker-row">
              <input type="text" id="inputAvatarEmoji" class="ctrl-input emoji-input" value="🎮" maxlength="4" />
              <label class="btn-upload-avatar" title={isEn ? 'Upload custom profile/character image' : '채널 로고 또는 버튜버 캐릭터 이미지 업로드'}>
                <span>🖼️ {isEn ? 'Image' : '이미지'}</span>
                <input type="file" id="inputAvatarImage" accept="image/*" style="display: none;" />
              </label>
              <button type="button" class="btn-clear-avatar" id="btnClearAvatarImage" style="display: none;" title={isEn ? 'Remove uploaded image' : '업로드한 이미지 삭제'}>✕</button>
              <div class="emoji-samples-row" id="emojiSamplesRow">
                <button type="button" class="btn-emoji-chip" data-emoji="🎮" title={isEn ? 'Gaming' : '게임'}>🎮</button>
                <button type="button" class="btn-emoji-chip" data-emoji="🌸" title={isEn ? 'Flower / Cozy' : '꽃/힐링'}>🌸</button>
                <button type="button" class="btn-emoji-chip" data-emoji="🐱" title={isEn ? 'Cat' : '고양이'}>🐱</button>
                <button type="button" class="btn-emoji-chip" data-emoji="🍕" title={isEn ? 'Food / Mukbang' : '음식/먹방'}>🍕</button>
                <button type="button" class="btn-emoji-chip" data-emoji="🎤" title={isEn ? 'Singing / Talk' : '노래/토크'}>🎤</button>
                <button type="button" class="btn-emoji-chip" data-emoji="✨" title={isEn ? 'Sparkle' : '반짝'}>✨</button>
                <button type="button" class="btn-emoji-chip" data-emoji="🔥" title={isEn ? 'Hype / Challenge' : '열정/도전'}>🔥</button>
                <button type="button" class="btn-emoji-chip" data-emoji="☕" title={isEn ? 'Cafe / Chat' : '카페/소통'}>☕</button>
                <button type="button" class="btn-emoji-chip" data-emoji="🏆" title={isEn ? 'Rank / Tournament' : '대회/랭크'}>🏆</button>
                <button type="button" class="btn-emoji-chip" data-emoji="📺" title={isEn ? 'Broadcast' : '방송'}>📺</button>
                <button type="button" class="btn-emoji-chip" data-emoji="✈️" title={isEn ? 'Travel' : '여행'}>✈️</button>
                <button type="button" class="btn-emoji-chip" data-emoji="👑" title={isEn ? 'Crown' : '왕관'}>👑</button>
                <button type="button" class="btn-emoji-chip" data-emoji="🎨" title={isEn ? 'Art / Drawing' : '그림'}>🎨</button>
                <button type="button" class="btn-emoji-chip" data-emoji="🎸" title={isEn ? 'Music / Guitar' : '기타/음악'}>🎸</button>
                <button type="button" class="btn-emoji-chip" data-emoji="🍀" title={isEn ? 'Lucky' : '행운'}>🍀</button>
                <button type="button" class="btn-emoji-chip" data-emoji="👾" title={isEn ? 'Retro / Indie' : '인디게임'}>👾</button>
              </div>
            </div>
          </div>
          <div class="input-field flex-2">
            <label>{isEn ? 'Channel Name' : '스트리머 채널명'}</label>
            <input type="text" id="inputChannelName" class="ctrl-input" value={isEn ? 'Streamer Arcade' : '스트리머 아케이드'} placeholder={isEn ? 'Channel Name' : '채널명'} />
          </div>
          <div class="input-field">
            <label>{isEn ? 'Broadcast Platform' : '방송 플랫폼'}</label>
            <select id="selectPlatform" class="ctrl-select">
              <option value="chzzk">{isEn ? 'CHZZK' : '치지직 (CHZZK)'}</option>
              <option value="soop">SOOP</option>
              <option value="twitch" selected={isEn}>{isEn ? 'Twitch' : '트위치 (Twitch)'}</option>
              <option value="youtube">{isEn ? 'YouTube' : '유튜브 (YouTube)'}</option>
              <option value="custom">{isEn ? 'Other (LIVE)' : '기타 (LIVE)'}</option>
            </select>
          </div>
          <div class="input-field flex-2">
            <label>🏷️ {isEn ? 'Accent Badge Text' : '포인트 배지 문구'}</label>
            <input 
              type="text" 
              id="inputKeytagText" 
              class="ctrl-input" 
              value="ON AIR" 
              maxlength="16" 
              placeholder={isEn ? 'e.g. ON AIR, SCHEDULE, LIVE' : '예: ON AIR, SCHEDULE, 방송중'} 
            />
          </div>
          <div class="input-field flex-3">
            <label>{isEn ? 'Tagline / Bio' : '방송 소개 문구'}</label>
            <input type="text" id="inputTagline" class="ctrl-input" value={isEn ? 'Daily 8 PM Variety Gaming & Community Chat' : '매일 저녁 8시 소통 & 종합 게임 방송'} placeholder={isEn ? 'One-line bio / stream schedule' : '한 줄 소개'} />
          </div>
          <div class="input-field flex-3">
            <label>📢 {isEn ? 'Weekly Notice / Highlights' : '주간 공지사항 / 이번 주 하이라이트'}</label>
            <input type="text" id="inputNoticeWeekly" class="ctrl-input" value={isEn ? '📢 Saturday: Viewer Community Games & Giveaway Event!' : '📢 이번 주 토요일은 시청자 참여전 & 치킨 이벤트 진행!'} placeholder={isEn ? 'Weekly notice shown at top (hide if empty)' : '주간 편성표 상단 공지사항 (비우면 숨김)'} />
          </div>
          <div class="input-field flex-3">
            <label>🎯 {isEn ? 'Monthly Goal / Notice' : '월간 공지사항 / 이번 달 목표'}</label>
            <input type="text" id="inputNoticeMonthly" class="ctrl-input" value={isEn ? '🎯 September Goal: 5 Streams/Week & 10K Followers!' : '🎯 9월 목표: 주 5회 정규 방송 & 구독자 1만 달성!'} placeholder={isEn ? 'Monthly goal shown at top (hide if empty)' : '월간 캘린더 상단 목표 (비우면 숨김)'} />
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Desktop Recommended Notice for Mobile Screens (< 900px) -->
  <div class="mobile-desktop-notice" role="alert">
    <div class="notice-icon">🖥️</div>
    <div class="notice-body">
      <strong class="notice-title">
        {isEn ? "Desktop Recommended (PC 최적화)" : "PC 데스크톱 환경에 최적화된 도구입니다"}
      </strong>
      <p class="notice-desc">
        {isEn 
          ? "The stream schedule studio is optimized for desktop PC screens for detailed 7-day multi-stream timetable editing and high-res image generation. On mobile, you can view the schedule by scrolling horizontally (↔)."
          : "방송 편성표 스튜디오는 주간 7일 다중 방송 일정 편집 및 고화질 템플릿 제작을 위해 PC 화면에 최적화되어 있습니다. 스마트폰에서는 좌우 스크롤(↔)을 통해 일정을 열람하실 수 있으며, 세부 편집은 PC 브라우저 접속을 권장합니다."}
      </p>
    </div>
  </div>

  <!-- Live Schedule Board (Single-Page Fit Container) -->
  <div class="schedule-preview-stage">
    <div class="schedule-card-board" id="scheduleBoard" data-theme="chzzk-neon" data-view="weekly" data-layout="bento">
      <!-- Ambient Decorative Glows -->
      <div class="board-ambient-orb orb-tl" aria-hidden="true"></div>
      <div class="board-ambient-orb orb-br" aria-hidden="true"></div>

      <!-- Board Header -->
      <div class="board-header" id="boardTopHeader">
        <div class="channel-info-col">
          <div class="channel-avatar-box" id="dispAvatar">🎮</div>
          <div class="channel-text-group">
            <div class="channel-title-row">
              <h2 class="channel-name" id="dispChannelName">{isEn ? 'Streamer Arcade' : '스트리머 아케이드'}</h2>
              <span class="platform-badge" id="dispPlatformBadge">{isEn ? 'Twitch' : '치지직'}</span>
              <span class="header-keytag-pill" id="dispHeaderKeytag">ON AIR</span>
            </div>
            <p class="channel-tagline" id="dispTagline">{isEn ? 'Daily 8 PM Variety Gaming & Community Chat' : '매일 저녁 8시 신작 & 종합 게임 방송!'}</p>
          </div>
        </div>

        <div class="board-meta-col">
          <div class="board-range-badge" id="dispScheduleRangeBadge">2026.09 {isEn ? 'Week 3 (09.14 ~ 09.20)' : '3주차 (09.14 ~ 09.20)'}</div>
          <div class="branding-watermark">
            <span class="brand-icon-mini">🔴</span>
            <span>WEEKLY BROADCAST SCHEDULE</span>
          </div>
        </div>
      </div>

      <!-- Optional Notice Banner -->
      <div class="board-notice-banner" id="dispNoticeBanner">
        <span class="notice-icon">📢</span>
        <span class="notice-text" id="dispNoticeText">{isEn ? 'Saturday: Viewer Community Games & Giveaway Event!' : '이번 주 토요일은 시청자 참여 돌림판 & 치킨 이벤트 진행!'}</span>
      </div>

      <!-- WEEKLY LAYOUT 1: Modern 4x2 Bento Card Grid (Default) -->
      <div class="bento-schedule-wrap" id="bentoWeeklyWrap">
        <div class="bento-grid-container" id="bentoGridContainer">
          <!-- 7 Day Cards + 1 Weekly Summary Card dynamically rendered -->
        </div>
      </div>

      <!-- WEEKLY LAYOUT 2: Streamer Profile Showcase + 7-Day Timeline Poster -->
      <div class="timeline-schedule-wrap" id="timelineWeeklyWrap" style="display: none;">
        <div class="timeline-split-container">
          <!-- Left: Streamer Showcase Poster Column -->
          <div class="timeline-poster-col" id="timelinePosterCol">
            <!-- Dynamically populated with Avatar/Portrait, Channel Info, Weekly Notice, and Broadcast Stats -->
          </div>
          <!-- Right: 7-Day Horizontal Timeline Stack -->
          <div class="timeline-days-col" id="timelineDaysCol">
            <!-- 7 Horizontal Timeline Rows dynamically rendered -->
          </div>
        </div>
      </div>

      <!-- WEEKLY LAYOUT 3: Travel Boarding Pass / Ticket Schedule (1 + 3 + 3 Single Page) -->
      <div class="bp-schedule-wrap" id="weeklyWrap" style="display: none;">
        <!-- Top Section: Keychain + Flight Board + Monday Ticket -->
        <div class="bp-row-top">
          <!-- Left: Keychain & Flight Board -->
          <div class="bp-top-left-panel">
            <!-- 1. Motel Keychain ("SCHEDULE") -->
            <div class="bp-keytag-unit" id="bpKeytagUnit" role="button" tabindex="0" title={isEn ? "Click to edit keychain badge text" : "클릭하여 키체인 배지 문구 수정"}>
              <div class="bp-keytag-body">
                <div class="bp-keytag-inner-bevel">
                  <div class="bp-keytag-hole"></div>
                  <div class="bp-keyring-loop"></div>
                  <div class="bp-silver-key-box">
                    <svg class="bp-key-svg" viewBox="0 0 120 40" fill="none" xmlns="http://www.w3.org/2000/svg">
                      <defs>
                        <linearGradient id="silverBodyGrad" x1="0%" y1="0%" x2="0%" y2="100%">
                          <stop offset="0%" stop-color="#ffffff"/>
                          <stop offset="25%" stop-color="#e2e8f0"/>
                          <stop offset="55%" stop-color="#cbd5e1"/>
                          <stop offset="85%" stop-color="#94a3b8"/>
                          <stop offset="100%" stop-color="#64748b"/>
                        </linearGradient>
                        <filter id="keyShadow" x="-20%" y="-20%" width="140%" height="140%">
                          <feDropShadow dx="2" dy="3" stdDeviation="2.5" flood-color="rgba(15,23,42,0.45)"/>
                        </filter>
                      </defs>
                      <g filter="url(#keyShadow)">
                        <circle cx="25" cy="25" r="16" fill="url(#silverBodyGrad)" stroke="#718096" stroke-width="1.8"/>
                        <circle cx="25" cy="25" r="6" fill="#486292" stroke="#4a5568" stroke-width="1.2"/>
                        <path d="M 38 21.5 L 112 21.5 L 112 28.5 L 38 28.5 Z" fill="url(#silverBodyGrad)" stroke="#718096" stroke-width="1.5"/>
                        <rect x="75" y="28.5" width="8" height="9" rx="1" fill="url(#silverBodyGrad)" stroke="#718096" stroke-width="1.2"/>
