<script>
import { renderScheduleToCanvas } from './ScheduleCanvasRenderer';
import { STATUS_BADGES, SCHEDULE_THEMES, formatDisplayTime, SAMPLE_PRESETS, SAMPLE_PRESETS_EN } from './scheduleTemplates';

(function () {
  var root = document.getElementById('scheduleStudioRoot');
  var isEn = (root && root.getAttribute('data-lang') === 'en');
  var presets = isEn ? SAMPLE_PRESETS_EN : SAMPLE_PRESETS;

  // ─── Unified Default Schedule State ──
  var DEFAULT_SCHEDULE = JSON.parse(JSON.stringify(presets.travelTicket));

  // ─── State Initialization ──────────────────────────────────────────────────
  var state = null;
  var STORAGE_KEY = isEn ? 'streamarcade_unified_schedule_en_v1' : 'streamarcade_unified_schedule_v6';

  try {
    var saved = localStorage.getItem(STORAGE_KEY);
    if (!saved && !isEn) {
      saved = localStorage.getItem('streamarcade_unified_schedule_v5');
    }
    if (saved) {
      // Clear out legacy sample containing "봉누도"
      if (saved.indexOf('봉누도') !== -1) {
        state = null;
      } else {
        state = JSON.parse(saved);
      }
    }
  } catch (e) {}

  if (!state || !state.monthly || !state.monthly.days) {
    state = JSON.parse(JSON.stringify(DEFAULT_SCHEDULE));
  }

  function saveState() {
    try {
      localStorage.setItem(STORAGE_KEY, JSON.stringify(state));
    } catch (e) {}
  }

  // ─── Week Calculation Helper ───────────────────────────────────────────────
  var monthNames = ['January', 'February', 'March', 'April', 'May', 'June', 'July', 'August', 'September', 'October', 'November', 'December'];
  var monthShortNames = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];

  // Divides any month into standard Monday-Sunday calendar weeks
  function computeMonthWeeks(year, month) {
    var firstDate = new Date(year, month - 1, 1);
    var firstDayOfWeek = firstDate.getDay(); // 0: Sun, 1: Mon, 2: Tue...
    var monOffset = (firstDayOfWeek + 6) % 7; // Distance to Monday
    var startDate = new Date(year, month - 1, 1 - monOffset);

    var weeks = [];
    var curr = new Date(startDate);
    var dayEnList = ['MON', 'TUE', 'WED', 'THU', 'FRI', 'SAT', 'SUN'];
    var dayKoList = ['월', '화', '수', '목', '금', '토', '일'];

    while (true) {
      var weekDays = [];
      var hasDayInMonth = false;

      for (var d = 0; d < 7; d++) {
        var y = curr.getFullYear();
        var m = curr.getMonth() + 1;
        var dayNum = curr.getDate();
        var isCurrentMonth = (y === year && m === month);
        if (isCurrentMonth) hasDayInMonth = true;

        var dateStr = (m < 10 ? '0' + m : m) + '.' + (dayNum < 10 ? '0' + dayNum : dayNum);

        // Fetch entry from monthly schedule if present
        var defaultDayTitle = isEn ? 'Live Stream' : '방송 예정';
        var entry = (isCurrentMonth && state.monthly.days[dayNum])
          ? state.monthly.days[dayNum]
          : { time: '20:00', startTime: '20:00', endTime: '', status: 'live', title: defaultDayTitle };

        weekDays.push({
          year: y,
          month: m,
          day: dayNum,
          dayEn: dayEnList[d],
          dayKo: dayKoList[d],
          isCurrentMonth: isCurrentMonth,
          dateStr: dateStr,
          entry: entry
        });

        curr.setDate(curr.getDate() + 1);
      }

      if (!hasDayInMonth && weeks.length >= 4) {
        break;
      }

      var weekNum = weeks.length + 1;
      var rangeStr = weekDays[0].dateStr + ' ~ ' + weekDays[6].dateStr;
      var label = isEn ? ('Week ' + weekNum + ' (' + rangeStr + ')') : (weekNum + '주차 (' + rangeStr + ')');
      var shortLabel = isEn ? ('Week ' + weekNum) : (weekNum + '주차');
      weeks.push({
        index: weeks.length,
        weekNum: weekNum,
        label: label,
        shortLabel: shortLabel,
        rangeStr: rangeStr,
        days: weekDays
      });

      if (weeks.length >= 6 || (curr.getFullYear() >= year && (curr.getMonth() + 1) > month && curr.getDate() > 7)) {
        break;
      }
    }

    return weeks;
  }

  // ─── DOM References ────────────────────────────────────────────────────────
  var board = document.getElementById('scheduleBoard');
  var weeklyWrap = document.getElementById('weeklyWrap');
  var monthlyWrap = document.getElementById('monthlyWrap');
  var calendarCellsContainer = document.getElementById('calendarCellsContainer');
  var weekButtonsBar = document.getElementById('weekButtonsBar');
  var weekExtractorGroup = document.getElementById('weekExtractorGroup');

  // Boarding Pass Elements
  var bpFlightDatesDisplay = document.getElementById('bpFlightDatesDisplay');
  var bpMonTicketContainer = document.getElementById('bpMonTicketContainer');
  var bpMidTicketsGroup = document.getElementById('bpMidTicketsGroup');
  var bpBtmTicketsGroup = document.getElementById('bpBtmTicketsGroup');

  var dispAvatar = document.getElementById('dispAvatar');
  var dispChannelName = document.getElementById('dispChannelName');
  var dispPlatformBadge = document.getElementById('dispPlatformBadge');
  var dispTagline = document.getElementById('dispTagline');
  var dispScheduleRangeBadge = document.getElementById('dispScheduleRangeBadge');
  var dispNoticeBanner = document.getElementById('dispNoticeBanner');
  var dispNoticeText = document.getElementById('dispNoticeText');
  var dispMonthTitle = document.getElementById('dispMonthTitle');
  var dispMonthlyGoal = document.getElementById('dispMonthlyGoal');
  var btnExportPngLabel = document.getElementById('btnExportPngLabel');

  // Input Controls
  var inputAvatarEmoji = document.getElementById('inputAvatarEmoji');
  var emojiSamplesRow = document.getElementById('emojiSamplesRow');
  var inputChannelName = document.getElementById('inputChannelName');
  var selectPlatform = document.getElementById('selectPlatform');
  var inputTagline = document.getElementById('inputTagline');
  var inputNoticeWeekly = document.getElementById('inputNoticeWeekly');
  var inputNoticeMonthly = document.getElementById('inputNoticeMonthly');

  var btnModeWeekly = document.getElementById('btnModeWeekly');
  var btnModeMonthly = document.getElementById('btnModeMonthly');
  var themePickerRow = document.getElementById('themePickerRow');

  var btnSaveJson = document.getElementById('btnSaveJson');
  var inputLoadJson = document.getElementById('inputLoadJson') as HTMLInputElement;
  var btnExportPng = document.getElementById('btnExportPng');
  var btnCopyText = document.getElementById('btnCopyText');
  var btnPresetTravel = document.getElementById('btnPresetTravel');
  var btnPresetGamer = document.getElementById('btnPresetGamer');
  var btnPresetVtuber = document.getElementById('btnPresetVtuber');
  var exportCanvas = document.getElementById('exportCanvas') as HTMLCanvasElement;

  var btnPrevMonth = document.getElementById('btnPrevMonth');
  var btnNextMonth = document.getElementById('btnNextMonth');

  // Modal DOM
  var modalOverlay = document.getElementById('editModalOverlay');
  var modalDayTitle = document.getElementById('modalDayTitle');
  var modalBadgeGrid = document.getElementById('modalBadgeGrid');
  var modalStartTimeInput = document.getElementById('modalStartTimeInput') as HTMLInputElement;
  var modalEndTimeInput = document.getElementById('modalEndTimeInput') as HTMLInputElement;
  var modalTitleInput = document.getElementById('modalTitleInput') as HTMLInputElement;
  var modalMemoInput = document.getElementById('modalMemoInput') as HTMLInputElement;
  var btnCloseModal = document.getElementById('btnCloseModal');
  var btnModalCancel = document.getElementById('btnModalCancel');
  var btnModalSave = document.getElementById('btnModalSave');

  var currentEditingDayNum = 1;
  var currentSelectedBadgeId = 'live';

  // ─── Render Functions ──────────────────────────────────────────────────────
  function renderAll() {
    var weeks = computeMonthWeeks(state.monthly.year, state.monthly.month);
    if (state.selectedWeekIndex >= weeks.length) {
      state.selectedWeekIndex = 0;
    }
    var currentWeek = weeks[state.selectedWeekIndex] || weeks[0];

    // 1. Board Theme & View Attribute
    board.setAttribute('data-theme', state.themeId);
    board.setAttribute('data-view', state.viewMode);

    // Update keytag title dynamically according to theme
    var bpKeytagTitle = document.getElementById('bpKeytagTitle');
    if (bpKeytagTitle && SCHEDULE_THEMES[state.themeId]) {
      bpKeytagTitle.textContent = SCHEDULE_THEMES[state.themeId].keytagTitle || 'SCHEDULE';
    }

    // 2. Active Theme Chips
    var themeChips = themePickerRow.querySelectorAll('.theme-chip');
    themeChips.forEach(function (chip) {
      if (chip.getAttribute('data-theme-id') === state.themeId) {
        chip.classList.add('active');
      } else {
        chip.classList.remove('active');
      }
    });

    // 3. View Mode Toggle
    if (state.viewMode === 'weekly') {
      btnModeWeekly.classList.add('active');
      btnModeMonthly.classList.remove('active');
      weeklyWrap.style.display = 'block';
      monthlyWrap.style.display = 'none';
      weekExtractorGroup.style.display = 'flex';
      btnExportPngLabel.textContent = isEn ? 'Save Weekly PNG' : '주간 PNG 저장';
      dispScheduleRangeBadge.textContent = state.monthly.year + '.' + (state.monthly.month < 10 ? '0' + state.monthly.month : state.monthly.month) + ' ' + currentWeek.label;
    } else {
      btnModeWeekly.classList.remove('active');
      btnModeMonthly.classList.add('active');
      weeklyWrap.style.display = 'none';
      monthlyWrap.style.display = 'block';
      weekExtractorGroup.style.display = 'none';
      btnExportPngLabel.textContent = isEn ? 'Save Monthly PNG' : '월간 PNG 저장';
      dispScheduleRangeBadge.textContent = isEn
        ? (monthShortNames[state.monthly.month - 1] + ' ' + state.monthly.year + ' All Streams')
        : (state.monthly.year + '년 ' + state.monthly.month + '월 전체 방송');
    }

    // 4. Week Buttons Bar
    renderWeekButtons(weeks);

    // 5. Header Branding Details
    dispAvatar.textContent = state.channel.avatarEmoji || '🎮';
    dispChannelName.textContent = state.channel.name || (isEn ? 'Streamer Channel' : '스트리머 채널');
    dispTagline.textContent = state.channel.tagline || '';

    var platformMap = isEn
      ? { chzzk: 'CHZZK', soop: 'SOOP', twitch: 'Twitch', youtube: 'YouTube', custom: 'LIVE' }
      : { chzzk: '치지직', soop: 'SOOP', twitch: '트위치', youtube: '유튜브', custom: 'LIVE' };
    dispPlatformBadge.textContent = platformMap[state.channel.platform] || 'LIVE';

    // Notice Banner (Weekly vs Monthly)
    if (state.viewMode === 'weekly') {
      var weeklyNotice = state.channel.noticeWeekly || state.channel.notice;
      if (weeklyNotice && weeklyNotice.trim() !== '') {
        dispNoticeBanner.style.display = 'flex';
        dispNoticeText.textContent = weeklyNotice;
      } else {
        dispNoticeBanner.style.display = 'none';
      }
    } else {
      dispNoticeBanner.style.display = 'none';
    }

    // Monthly Goal Badge
    var monthlyGoal = state.channel.noticeMonthly || state.monthly.monthlyGoal;
    dispMonthlyGoal.textContent = monthlyGoal || (isEn ? '🎯 Let’s make this month great!' : '🎯 이번 달도 파이팅!');

    // 6. Sync Input Controls
    inputAvatarEmoji.value = state.channel.avatarEmoji || '🎮';
    inputChannelName.value = state.channel.name || '';
    selectPlatform.value = state.channel.platform || (isEn ? 'twitch' : 'chzzk');
    inputTagline.value = state.channel.tagline || '';
    inputNoticeWeekly.value = state.channel.noticeWeekly || state.channel.notice || '';
    inputNoticeMonthly.value = state.channel.noticeMonthly || state.monthly.monthlyGoal || '';

    // 7. Render Weekly Compact Day Cards
    renderWeeklyDays(currentWeek.days);

    // 8. Render Monthly Compact Cells
    renderMonthlyCalendar();
  }

  function renderWeekButtons(weeks) {
    weekButtonsBar.innerHTML = '';
    weeks.forEach(function (w, idx) {
      var btn = document.createElement('button');
      btn.type = 'button';
      btn.className = 'btn-week-chip' + (idx === state.selectedWeekIndex ? ' active' : '');
      btn.textContent = w.shortLabel;
      btn.title = w.label;

      btn.addEventListener('click', function () {
        state.selectedWeekIndex = idx;
        saveState();
        renderAll();
      });

      weekButtonsBar.appendChild(btn);
    });
  }

  function renderWeeklyDays(weekDays) {
    if (bpFlightDatesDisplay && weekDays.length >= 7) {
      bpFlightDatesDisplay.textContent = weekDays[0].dateStr + ' ✈ ' + weekDays[6].dateStr;
    }

    // 1. Monday Ticket (Top Right)
    if (bpMonTicketContainer) {
      bpMonTicketContainer.innerHTML = '';
      if (weekDays[0]) {
        bpMonTicketContainer.appendChild(createBoardingPassTicket(weekDays[0]));
      }
    }

    // 2. Middle Row Tickets (TUE, WED, THU)
    if (bpMidTicketsGroup) {
      bpMidTicketsGroup.innerHTML = '';
      for (var i = 1; i <= 3; i++) {
        if (i > 1) {
          var div = document.createElement('div');
          div.className = 'bp-perforate-divider';
          div.innerHTML = '<span class="bp-notch top"></span><span class="bp-notch btm"></span>';
          bpMidTicketsGroup.appendChild(div);
        }
        if (weekDays[i]) {
          bpMidTicketsGroup.appendChild(createBoardingPassTicket(weekDays[i]));
        }
      }
    }

    // 3. Bottom Row Tickets (FRI, SAT, SUN)
    if (bpBtmTicketsGroup) {
      bpBtmTicketsGroup.innerHTML = '';
      for (var j = 4; j <= 6; j++) {
        if (j > 4) {
          var div2 = document.createElement('div');
          div2.className = 'bp-perforate-divider';
          div2.innerHTML = '<span class="bp-notch top"></span><span class="bp-notch btm"></span>';
          bpBtmTicketsGroup.appendChild(div2);
        }
        if (weekDays[j]) {
          bpBtmTicketsGroup.appendChild(createBoardingPassTicket(weekDays[j]));
        }
      }
    }
  }

  function createBoardingPassTicket(d) {
    var defaultDayTitle = isEn ? 'Live Stream' : '방송 예정';
    var entry = d.entry || { time: '20:00', startTime: '20:00', endTime: '', status: 'live', title: defaultDayTitle, memo: '' };
    var isOff = (entry.status === 'off' || entry.title === 'OFFLINE');
    var displayTime = formatDisplayTime(entry, isEn ? 'en' : 'ko') || entry.time || '20:00';

    var card = document.createElement('div');
    card.className = 'bp-ticket-card' + (isOff ? ' is-off-day' : '');
    card.setAttribute('data-day', d.dayEn);

    var innerContentHtml = '';

    if (isOff) {
      // Hanging rustic wooden OFFLINE sign tilted at -4.5° with cords and rivets
      innerContentHtml =
        '<div class="bp-hanging-sign-unit">' +
          '<div class="bp-pin-nail"></div>' +
          '<svg class="bp-hanging-strings-svg" viewBox="0 0 68 14" fill="none">' +
            '<line x1="34" y1="2" x2="10" y2="13" stroke="#4b5869" stroke-width="1.6" stroke-linecap="round"/>' +
            '<line x1="34" y1="2" x2="58" y2="13" stroke="#4b5869" stroke-width="1.6" stroke-linecap="round"/>' +
          '</svg>' +
          '<div class="bp-wooden-plaque">' +
            '<span class="bp-rivet tl"></span><span class="bp-rivet tr"></span>' +
            '<span class="bp-wooden-text">OFFLINE</span>' +
            '<span class="bp-rivet bl"></span><span class="bp-rivet br"></span>' +
          '</div>' +
        '</div>';
    } else {
      // Active stream day: Title, Memo/Subtitle, and Time
      innerContentHtml =
        '<div class="bp-ticket-body-content">' +
          '<div class="bp-ticket-title">' + (entry.title || defaultDayTitle) + '</div>' +
          '<div class="bp-ticket-memo">' + (entry.memo || '') + '</div>' +
          '<div class="bp-ticket-time">' + displayTime + '</div>' +
        '</div>';
    }

    card.innerHTML =
      '<div class="bp-ticket-ribbon-wrap">' +
        '<div class="bp-folded-ribbon">' +
          '<span class="bp-ribbon-fold-l"></span>' +
          '<span class="bp-ribbon-label">' + d.dayEn + '</span>' +
          '<span class="bp-ribbon-fold-r"></span>' +
        '</div>' +
      '</div>' +
      '<div class="bp-ticket-inner-frame">' +
        innerContentHtml +
        '<div class="bp-flourish-wrap">' +
          '<svg class="bp-flourish-svg" viewBox="0 0 140 24" fill="none">' +
            '<path d="M 12 15 C 32 21, 42 5, 60 12 C 66 14, 69 14, 70 12 C 71 14, 74 14, 80 12 C 98 5, 108 21, 128 15" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/>' +
            '<circle cx="70" cy="12" r="2.2" fill="currentColor"/>' +
            '<path d="M 22 12 C 16 9, 19 4, 25 6 C 30 8, 27 14, 18 14" stroke="currentColor" stroke-width="1.2" stroke-linecap="round"/>' +
            '<path d="M 118 12 C 124 9, 121 4, 115 6 C 110 8, 113 14, 122 14" stroke="currentColor" stroke-width="1.2" stroke-linecap="round"/>' +
          '</svg>' +
        '</div>' +
      '</div>' +
      '<button type="button" class="bp-ticket-edit-hint" title="' + (isEn ? 'Edit Schedule' : '일정 편집') + '">✏️</button>';

    card.addEventListener('click', function () {
      var dayTitleStr = isEn ? (d.dateStr + ' (' + d.dayEn + ')') : (d.dateStr + ' (' + d.dayKo + ')');
      openEditModal(d.day, dayTitleStr);
    });

    return card;
  }

  function renderMonthlyCalendar() {
    dispMonthTitle.textContent = isEn
      ? (monthNames[state.monthly.month - 1] + ' ' + state.monthly.year + ' Full Broadcast Calendar')
      : (state.monthly.year + '년 ' + state.monthly.month + '월 전체 방송 캘린더');
    var monthlyGoal = state.channel.noticeMonthly || state.monthly.monthlyGoal;
    dispMonthlyGoal.textContent = monthlyGoal || (isEn ? '🎯 Let’s make this month great!' : '🎯 이번 달도 파이팅!');
    calendarCellsContainer.innerHTML = '';

    var daysInMonth = new Date(state.monthly.year, state.monthly.month, 0).getDate();
    var firstDayIndex = new Date(state.monthly.year, state.monthly.month - 1, 1).getDay(); // 0 is Sun

    for (var cell = 0; cell < 35; cell++) {
      var dayNum = cell - firstDayIndex + 1;
      var cellEl = document.createElement('div');

      if (dayNum >= 1 && dayNum <= daysInMonth) {
        cellEl.className = 'cal-cell-compact';
        var entry = state.monthly.days[dayNum] || { time: '', startTime: '', endTime: '', status: 'live', title: '', memo: '' };
        var badge = STATUS_BADGES[entry.status] || STATUS_BADGES.live;
        var isSun = (cell % 7 === 0);
        var isSat = (cell % 7 === 6);
        var colClass = isSun ? ' col-sun' : (isSat ? ' col-sat' : '');
        var displayTime = formatDisplayTime(entry, isEn ? 'en' : 'ko');

        var html = '<div class="cal-cell-num' + colClass + '">' + dayNum + '</div>';
        if (entry.title && entry.title.trim() !== '') {
          var offWord = isEn ? 'OFF' : '휴식';
          var timePrefix = (displayTime && displayTime !== offWord) ? displayTime + ' ' : '';
          html += '<div class="cal-cell-pill" style="background: ' + badge.bg + '; color: ' + badge.color + '; border: 1px solid ' + badge.color + '44;">' +
            badge.icon + ' ' + timePrefix + entry.title +
          '</div>';
        }
        cellEl.innerHTML = html;

        (function (dNum) {
          cellEl.addEventListener('click', function () {
            var titleLabel = isEn ? (monthShortNames[state.monthly.month - 1] + ' ' + dNum) : (state.monthly.month + '월 ' + dNum + '일');
            openEditModal(dNum, titleLabel);
          });
        })(dayNum);
      } else {
        cellEl.className = 'cal-cell-compact is-empty';
      }

      calendarCellsContainer.appendChild(cellEl);
    }
  }

  // ─── Modal Editing Logic ───────────────────────────────────────────────────
  function openEditModal(dayNum, titleLabel) {
    currentEditingDayNum = dayNum;
    modalDayTitle.textContent = isEn ? ('Edit Schedule: ' + titleLabel) : (titleLabel + ' 방송 일정 편집');

    var defaultDayTitle = isEn ? 'Live Stream' : '방송 예정';
    var existing = state.monthly.days[dayNum] || { startTime: '20:00', endTime: '', time: '20:00', status: 'live', title: '', memo: '' };
    currentSelectedBadgeId = existing.status || 'live';
    modalStartTimeInput.value = existing.startTime || existing.time || '20:00';
    modalEndTimeInput.value = existing.endTime || '';
    modalTitleInput.value = existing.title || '';
    if (modalMemoInput) {
      modalMemoInput.value = existing.memo || '';
    }

    updateModalBadgeButtons();
    modalOverlay.style.display = 'flex';
  }

  function updateModalBadgeButtons() {
    var btns = modalBadgeGrid.querySelectorAll('.badge-opt-btn');
    btns.forEach(function (b) {
      if (b.getAttribute('data-badge-id') === currentSelectedBadgeId) {
        b.classList.add('active');
      } else {
        b.classList.remove('active');
      }
    });
  }

  modalBadgeGrid.addEventListener('click', function (e) {
    var btn = e.target.closest('.badge-opt-btn');
    if (!btn) return;
    currentSelectedBadgeId = btn.getAttribute('data-badge-id');
    updateModalBadgeButtons();

    if (currentSelectedBadgeId === 'off') {
      modalStartTimeInput.value = isEn ? 'OFF' : '휴식';
      modalEndTimeInput.value = '';
      if (!modalTitleInput.value || modalTitleInput.value === '방송 예정' || modalTitleInput.value === 'Live Stream') {
        modalTitleInput.value = 'OFFLINE';
      }
    }
  });

  // Quick Start Time Buttons in Modal
  modalOverlay.querySelectorAll('.btn-quick-start').forEach(function (btn) {
    btn.addEventListener('click', function () {
      modalStartTimeInput.value = btn.getAttribute('data-time') || '';
    });
  });

  // Quick End Time Buttons in Modal
  modalOverlay.querySelectorAll('.btn-quick-end').forEach(function (btn) {
    btn.addEventListener('click', function () {
      modalEndTimeInput.value = btn.getAttribute('data-time') || '';
    });
  });

  btnModalCancel.addEventListener('click', function () {
    modalOverlay.style.display = 'none';
  });
  btnCloseModal.addEventListener('click', function () {
    modalOverlay.style.display = 'none';
  });

  btnModalSave.addEventListener('click', function () {
    var startVal = modalStartTimeInput.value.trim() || '20:00';
    var endVal = modalEndTimeInput.value.trim();
    var defaultDayTitle = isEn ? 'Live Stream' : '방송 예정';
    var tempEntry = {
      startTime: startVal,
      endTime: endVal,
      status: currentSelectedBadgeId,
      title: modalTitleInput.value.trim() || (currentSelectedBadgeId === 'off' ? 'OFFLINE' : defaultDayTitle),
      memo: modalMemoInput ? modalMemoInput.value.trim() : ''
    };
    tempEntry.time = formatDisplayTime(tempEntry, isEn ? 'en' : 'ko');

    state.monthly.days[currentEditingDayNum] = tempEntry;
    saveState();
    modalOverlay.style.display = 'none';
    renderAll();
  });

  // ─── Event Handlers ────────────────────────────────────────────────────────
  btnModeWeekly.addEventListener('click', function () {
    state.viewMode = 'weekly';
    saveState();
    renderAll();
  });

  btnModeMonthly.addEventListener('click', function () {
    state.viewMode = 'monthly';
    saveState();
    renderAll();
  });

  themePickerRow.addEventListener('click', function (e) {
    var btn = e.target.closest('.theme-chip');
    if (!btn) return;
    state.themeId = btn.getAttribute('data-theme-id');
    saveState();
    renderAll();
  });

  // Month navigation
  btnPrevMonth.addEventListener('click', function () {
    state.monthly.month -= 1;
    if (state.monthly.month < 1) {
      state.monthly.month = 12;
      state.monthly.year -= 1;
    }
    state.selectedWeekIndex = 0;
    saveState();
    renderAll();
  });

  btnNextMonth.addEventListener('click', function () {
    state.monthly.month += 1;
    if (state.monthly.month > 12) {
      state.monthly.month = 1;
      state.monthly.year += 1;
    }
    state.selectedWeekIndex = 0;
    saveState();
    renderAll();
  });

  // Representative Emoji Input & Sample Chips
  inputAvatarEmoji.addEventListener('input', function (e) {
    state.channel.avatarEmoji = e.target.value;
    saveState();
    dispAvatar.textContent = state.channel.avatarEmoji || '🎮';
  });

  if (emojiSamplesRow) {
    emojiSamplesRow.addEventListener('click', function (e) {
      var btn = e.target.closest('.btn-emoji-chip');
      if (!btn) return;
      var emoji = btn.getAttribute('data-emoji');
      if (emoji) {
        state.channel.avatarEmoji = emoji;
        inputAvatarEmoji.value = emoji;
        dispAvatar.textContent = emoji;
        saveState();
      }
    });
  }

  inputChannelName.addEventListener('input', function (e) {
    state.channel.name = e.target.value;
    saveState();
    dispChannelName.textContent = state.channel.name || (isEn ? 'Streamer Channel' : '스트리머 채널');
  });

  selectPlatform.addEventListener('change', function (e) {
    state.channel.platform = e.target.value;
    saveState();
    var map = isEn
      ? { chzzk: 'CHZZK', soop: 'SOOP', twitch: 'Twitch', youtube: 'YouTube', custom: 'LIVE' }
      : { chzzk: '치지직', soop: 'SOOP', twitch: '트위치', youtube: '유튜브', custom: 'LIVE' };
    dispPlatformBadge.textContent = map[state.channel.platform] || 'LIVE';
  });

  inputTagline.addEventListener('input', function (e) {
    state.channel.tagline = e.target.value;
    saveState();
    dispTagline.textContent = state.channel.tagline || '';
  });

  inputNoticeWeekly.addEventListener('input', function (e) {
    state.channel.noticeWeekly = e.target.value;
    state.channel.notice = e.target.value;
    saveState();
    if (state.viewMode === 'weekly') {
      if (e.target.value && e.target.value.trim() !== '') {
        dispNoticeBanner.style.display = 'flex';
        dispNoticeText.textContent = e.target.value;
      } else {
        dispNoticeBanner.style.display = 'none';
      }
    }
  });

  inputNoticeMonthly.addEventListener('input', function (e) {
    state.channel.noticeMonthly = e.target.value;
    state.monthly.monthlyGoal = e.target.value;
    saveState();
    dispMonthlyGoal.textContent = e.target.value || (isEn ? '🎯 Let’s make this month great!' : '🎯 이번 달도 파이팅!');
  });

  // Sample Presets (No highlight sticky state)
  if (btnPresetTravel) {
    btnPresetTravel.addEventListener('click', function () {
      state = JSON.parse(JSON.stringify(presets.travelTicket));
      saveState();
      renderAll();
    });
  }

  btnPresetGamer.addEventListener('click', function () {
    state = JSON.parse(JSON.stringify(presets.varietyGamer));
    saveState();
    renderAll();
  });

  btnPresetVtuber.addEventListener('click', function () {
    state = JSON.parse(JSON.stringify(presets.vtuberCozy));
    saveState();
    renderAll();
  });

  // ─── Local JSON Save & Load (.json) ────────────────────────────────────────
  btnSaveJson.addEventListener('click', function () {
    var jsonStr = JSON.stringify(state, null, 2);
    var blob = new Blob([jsonStr], { type: 'application/json' });
    var url = URL.createObjectURL(blob);
    var a = document.createElement('a');
    a.href = url;
    a.download = 'stream_schedule_' + state.monthly.year + '_' + state.monthly.month + '.json';
    document.body.appendChild(a);
    a.click();
    document.body.removeChild(a);
    URL.revokeObjectURL(url);
  });

  inputLoadJson.addEventListener('change', function (e) {
    var file = e.target.files && e.target.files[0];
    if (!file) return;

    var reader = new FileReader();
    reader.onload = function (ev) {
      try {
        var parsed = JSON.parse(ev.target.result);
        if (parsed && parsed.monthly && parsed.monthly.days) {
          state = parsed;
          saveState();
          renderAll();
          alert(isEn ? '✅ Template file loaded successfully!' : '✅ 템플릿 파일을 성공적으로 불러왔습니다!');
        } else {
          alert(isEn ? 'Invalid schedule template JSON file.' : '올바른 편성표 템플릿 JSON 파일이 아닙니다.');
        }
      } catch (err) {
        alert((isEn ? 'Error reading JSON file: ' : 'JSON 파일 읽기 오류: ') + err.message);
      }
    };
    reader.readAsText(file);
    e.target.value = '';
  });

  // ─── High-Res PNG Download ─────────────────────────────────────────────────
  if (btnExportPng && exportCanvas) {
    btnExportPng.addEventListener('click', function () {
      try {
        var weeks = computeMonthWeeks(state.monthly.year, state.monthly.month);
        var currentWeek = weeks[state.selectedWeekIndex] || weeks[0];
        var isWeekly = (state.viewMode === 'weekly');

        renderScheduleToCanvas(exportCanvas, state, currentWeek.days, isWeekly, 2, isEn ? 'en' : 'ko');

        var dataUrl = exportCanvas.toDataURL('image/png');
        var a = document.createElement('a');
        a.href = dataUrl;
        a.download = isWeekly
          ? 'stream_schedule_weekly_' + (state.selectedWeekIndex + 1) + 'week_' + state.monthly.year + '-' + state.monthly.month + '.png'
          : 'stream_schedule_monthly_' + state.monthly.year + '-' + state.monthly.month + '.png';
        document.body.appendChild(a);
        a.click();
        document.body.removeChild(a);
      } catch (err) {
        console.error('Canvas export error:', err);
        alert((isEn ? 'Error exporting PNG: ' : 'PNG 내보내기 중 오류가 발생했습니다: ') + (err instanceof Error ? err.message : String(err)));
      }
    });
  }

  // ─── Text Copy for Discord / Fan Cafe ──────────────────────────────────────
  btnCopyText.addEventListener('click', function () {
    var weeks = computeMonthWeeks(state.monthly.year, state.monthly.month);
    var currentWeek = weeks[state.selectedWeekIndex] || weeks[0];

    var text = '📢 [' + state.channel.name + '] ' + state.monthly.year + '.' + state.monthly.month + ' ' + currentWeek.label + '\n\n';
    currentWeek.days.forEach(function (d) {
      var entry = d.entry;
      var badge = STATUS_BADGES[entry.status] || STATUS_BADGES.live;
      var dayTag = isEn ? d.dayEn : d.dayKo;
      var timeStr = entry.time || (isEn ? 'Flexible' : '자율');
      var defaultDayTitle = isEn ? 'Live Stream' : '방송 예정';
      var titleStr = entry.title || defaultDayTitle;
      text += '• ' + d.dateStr + ' (' + dayTag + ') : ' + badge.icon + ' ' + timeStr + ' | ' + titleStr + '\n';
    });

    text += '\n📺 ' + (state.channel.tagline || 'StreamArcade') + '\nhttps://streamarcade.net/' + (isEn ? 'en/' : '') + 'schedule';

    if (navigator.clipboard) {
      navigator.clipboard.writeText(text).then(function () {
        alert(isEn ? '📋 Text copied to clipboard for Discord / Community!' : '📋 디스코드 / 팬카페 공유용 텍스트가 복사되었습니다!');
      });
    }
  });

  // Check URL params for stream/obs mode
  var params = new URLSearchParams(window.location.search);
  if (params.has('obs') || params.has('stream')) {
    root.classList.add('streamer-clean-mode');
  }

  // Initial Render
  renderAll();
})();
</script>
