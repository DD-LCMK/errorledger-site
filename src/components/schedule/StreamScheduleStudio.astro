      if (!board) return;
      var origText = btnExportPngLabel ? btnExportPngLabel.textContent : (isEn ? 'Export PNG' : 'PNG 이미지 저장');
      btnExportPng.disabled = true;
      if (btnExportPngLabel) {
        btnExportPngLabel.textContent = isEn ? 'Generating PNG...' : '이미지 생성 중...';
      }
      board.classList.add('is-exporting-png');

      var weeks = computeMonthWeeks(state.monthly.year, state.monthly.month);
      var currentWeek = weeks[state.selectedWeekIndex] || weeks[0];
      var fileSuffix = state.viewMode === 'monthly'
        ? (state.monthly.year + '_' + state.monthly.month + '_monthly')
        : (state.monthly.year + '_' + state.monthly.month + '_week' + currentWeek.weekNum);
      var fileName = 'stream_schedule_' + fileSuffix + '.png';

      loadModernScreenshot()
        .then(function (ms) {
          return ms.domToPng(board, {
            scale: 2,
            quality: 1
          });
        })
        .catch(function () {
          return renderFallbackCanvasPng(currentWeek);
        })
        .then(function (dataUrl) {
          var a = document.createElement('a');
          a.href = dataUrl;
          a.download = fileName;
          document.body.appendChild(a);
          a.click();
          document.body.removeChild(a);

          if (btnExportPngLabel) {
            btnExportPngLabel.textContent = isEn ? 'Saved PNG! ✓' : 'PNG 저장 완료! ✓';
          }
          setTimeout(function () {
            if (btnExportPngLabel) btnExportPngLabel.textContent = origText;
            if (btnExportPng) btnExportPng.disabled = false;
          }, 2200);
        })
        .finally(function () {
          board.classList.remove('is-exporting-png');
        });
    });
  }

