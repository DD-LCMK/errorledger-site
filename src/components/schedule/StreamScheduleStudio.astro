    --b-offline-text: #fdf2f8;
    background: radial-gradient(circle at top right, rgba(244, 114, 182, 0.15), transparent 55%), #1e1826;
    border-color: rgba(244, 114, 182, 0.38);
  }

  .schedule-card-board[data-theme="retro-arcade"] {
    --b-board-bg: #130924;
    --b-card: rgba(35, 16, 61, 0.92);
    --b-accent: #ff007f;
    --b-border: rgba(255, 230, 0, 0.4);
    --b-text: #ffffff;
    --b-sub: #ffe600;
    --b-keytag-bg: #2e0f45;
    --b-keytag-border: #ffe600;
    --b-keytag-text: #ffe600;
    --b-keytag-shadow: #ff007f;
    --b-ticker-bg: #210935;
    --b-ticker-border: rgba(255, 0, 127, 0.5);
    --b-ticker-label: #ff007f;
    --b-ticker-text: #ffe600;
    --b-ribbon-bg: #ff007f;
    --b-ribbon-fold: #be005d;
    --b-ribbon-text: #ffe600;
    --b-strip-bg: #1c0d33;
    --b-strip-border: rgba(255, 0, 127, 0.45);
    --b-stub-bg: #140826;
    --b-stub-border: rgba(255, 230, 0, 0.35);
    --b-stub-text: #ffe600;
    --b-barcode: #ff007f;
    --b-ticket-bg: #271247;
    --b-ticket-inner-border: rgba(255, 230, 0, 0.3);
    --b-ticket-title: #ffffff;
    --b-ticket-memo: #ffe600;
    --b-ticket-time: #00f0ff;
    --b-flourish: rgba(255, 0, 127, 0.45);
    --b-offline-bg: #351152;
    --b-offline-border: #ff007f;
    --b-offline-text: #ffe600;
    background: radial-gradient(circle at top right, rgba(255, 0, 127, 0.18), transparent 55%), #130924;
    border-color: rgba(255, 230, 0, 0.45);
  }

  .schedule-card-board[data-theme="minimal-obsidian"] {
    --b-board-bg: #0a0a0c;
    --b-card: rgba(18, 18, 24, 0.96);
    --b-accent: #e2e8f0;
    --b-border: rgba(255, 255, 255, 0.18);
    --b-text: #ffffff;
    --b-sub: #94a3b8;
    --b-keytag-bg: #18181f;
    --b-keytag-border: #94a3b8;
    --b-keytag-text: #ffffff;
    --b-keytag-shadow: #64748b;
    --b-ticker-bg: #131318;
    --b-ticker-border: rgba(255, 255, 255, 0.2);
    --b-ticker-label: #94a3b8;
    --b-ticker-text: #f8fafc;
    --b-ribbon-bg: #e2e8f0;
    --b-ribbon-fold: #94a3b8;
    --b-ribbon-text: #0f172a;
    --b-strip-bg: #121217;
    --b-strip-border: rgba(255, 255, 255, 0.18);
    --b-stub-bg: #0d0d12;
    --b-stub-border: rgba(255, 255, 255, 0.15);
    --b-stub-text: #94a3b8;
    --b-barcode: #cbd5e1;
    --b-ticket-bg: #181820;
    --b-ticket-inner-border: rgba(255, 255, 255, 0.14);
    --b-ticket-title: #ffffff;
    --b-ticket-memo: #94a3b8;
    --b-ticket-time: #cbd5e1;
    --b-flourish: rgba(255, 255, 255, 0.25);
    --b-offline-bg: #1e1e26;
    --b-offline-border: #94a3b8;
    --b-offline-text: #f8fafc;
    background: #0a0a0c;
    border-color: rgba(255, 255, 255, 0.22);
  }

  .schedule-card-board[data-theme="cyberpunk-matrix"] {
    --b-board-bg: #090a0f;
    --b-card: rgba(20, 20, 30, 0.94);
    --b-accent: #fcee0a;
    --b-border: rgba(0, 240, 255, 0.4);
    --b-text: #ffffff;
    --b-sub: #00f0ff;
    --b-keytag-bg: #141824;
    --b-keytag-border: #fcee0a;
    --b-keytag-text: #fcee0a;
    --b-keytag-shadow: #00f0ff;
    --b-ticker-bg: #0d111c;
    --b-ticker-border: rgba(0, 240, 255, 0.45);
    --b-ticker-label: #00f0ff;
    --b-ticker-text: #fcee0a;
    --b-ribbon-bg: #fcee0a;
    --b-ribbon-fold: #c8bd04;
    --b-ribbon-text: #05070c;
    --b-strip-bg: #0f131f;
    --b-strip-border: rgba(0, 240, 255, 0.4);
    --b-stub-bg: #090c15;
    --b-stub-border: rgba(0, 240, 255, 0.3);
    --b-stub-text: #00f0ff;
    --b-barcode: #fcee0a;
    --b-ticket-bg: #161c2c;
    --b-ticket-inner-border: rgba(252, 238, 10, 0.28);
    --b-ticket-title: #ffffff;
    --b-ticket-memo: #00f0ff;
    --b-ticket-time: #fcee0a;
    --b-flourish: rgba(0, 240, 255, 0.45);
    --b-offline-bg: #1d2233;
    --b-offline-border: #fcee0a;
    --b-offline-text: #fcee0a;
    background: radial-gradient(circle at top right, rgba(252, 238, 10, 0.14), transparent 55%), #090a0f;
    border-color: rgba(0, 240, 255, 0.45);
  }

  /* Compact Board Header */
  .board-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    margin-bottom: 0.75rem;
    padding-bottom: 0.7rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.07);
  }

  .channel-info-col {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .channel-avatar-box {
    width: 44px;
    height: 44px;
    background: var(--b-card);
    border: 1.5px solid var(--b-border);
    border-radius: 12px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.4rem;
    flex-shrink: 0;
  }

  .channel-title-row {
    display: flex;
    align-items: center;
    gap: 0.45rem;
  }

  html.dark .schedule-card-board .channel-name,
  .channel-name {
    font-size: 1.15rem;
    font-weight: 800;
    margin: 0;
    color: var(--b-text) !important;
  }

  html.dark .schedule-card-board .platform-badge,
  .platform-badge {
    font-size: 0.65rem;
    font-weight: 800;
    padding: 0.15rem 0.4rem;
    border-radius: 4px;
    background: var(--b-card) !important;
    color: var(--b-accent) !important;
    border: 1px solid var(--b-border) !important;
    text-transform: uppercase;
  }

  html.dark .schedule-card-board .channel-tagline,
  .channel-tagline {
    font-size: 0.76rem;
    color: var(--b-sub) !important;
    margin: 0.1rem 0 0;
  }

  .board-meta-col {
    text-align: right;
  }

  html.dark .schedule-card-board .board-range-badge,
  .board-range-badge {
    font-size: 0.88rem;
    font-weight: 800;
    color: var(--b-accent) !important;
    margin-bottom: 0.15rem;
  }

  html.dark .schedule-card-board .branding-watermark,
  .branding-watermark {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    font-size: 0.65rem;
    font-weight: 700;
    color: var(--b-sub) !important;
    letter-spacing: 0.05em;
  }
  .brand-icon-mini { font-size: 0.65rem; }

  /* Notice Banner */
  html.dark .schedule-card-board .board-notice-banner,
  .board-notice-banner {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    background: var(--b-card) !important;
    border: 1px solid var(--b-border) !important;
    padding: 0.4rem 0.85rem;
    border-radius: 8px;
    margin-bottom: 0.75rem;
    font-size: 0.78rem;
    font-weight: 600;
    color: var(--b-text) !important;
  }
  html.dark .schedule-card-board .board-notice-banner .notice-text,
  .board-notice-banner .notice-text {
    color: var(--b-text) !important;
  }
  .notice-icon { font-size: 0.85rem; }

  /* ─────────────────────────────────────────────────────────────────────────────
     VIEW 1: TRAVEL BOARDING PASS & VINTAGE TICKET STUDIO (1 + 3 + 3)
     ───────────────────────────────────────────────────────────────────────────── */
  .bp-schedule-wrap {
    display: flex;
    flex-direction: column;
    gap: 6px;
    user-select: none;
  }

  /* ROW 1: TOP SECTION (Keychain & Flight Gate on Left, MON Ticket on Right) */
  .bp-row-top {
    display: flex;
    gap: 10px;
    align-items: stretch;
  }

  .bp-top-left-panel {
    flex: 1;
    display: flex;
    gap: 12px;
    align-items: center;
    background: var(--b-card, rgba(255, 255, 255, 0.22));
    border: 1px solid var(--b-border, rgba(158, 178, 220, 0.45));
    border-radius: 12px;
    padding: 6px 12px;
    box-shadow: 0 4px 14px rgba(0, 0, 0, 0.15);
    transition: all 0.25s ease;
  }

  /* 1. Motel Keychain ("SCHEDULE") */
  .bp-keytag-unit {
    position: relative;
    display: flex;
    align-items: center;
    cursor: default;
  }

  .bp-keytag-body {
    background: var(--b-keytag-bg, #5570a5);
    border-radius: 50px;
    padding: 7px 16px 7px 24px;
    box-shadow: 2px 6px 14px rgba(0, 0, 0, 0.28), inset 0 1px 1px rgba(255, 255, 255, 0.3);
    position: relative;
    transition: background 0.25s ease;
  }

  .bp-keytag-inner-bevel {
    border: 1.5px solid var(--b-keytag-border, #7c9bd1);
    border-radius: 40px;
    padding: 4px 12px 4px 16px;
    display: flex;
    align-items: center;
    position: relative;
    transition: border-color 0.25s ease;
  }

  .bp-keytag-hole {
    position: absolute;
    left: -10px;
    top: 50%;
    transform: translateY(-50%);
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background: #111827;
    box-shadow: inset 0 1px 2px rgba(0, 0, 0, 0.6);
  }

  .bp-keyring-loop {
    position: absolute;
    left: -22px;
    top: 50%;
    transform: translateY(-50%);
    width: 30px;
    height: 30px;
    border-radius: 50%;
    border: 3.5px solid #b8c4d4;
    box-shadow: 1px 2px 5px rgba(0, 0, 0, 0.25);
    pointer-events: none;
    z-index: 2;
  }

  .bp-silver-key-box {
    position: absolute;
    left: -26px;
    top: 6px;
    width: 110px;
    height: 36px;
    pointer-events: none;
    z-index: 3;
    transform: rotate(14deg);
    filter: drop-shadow(2px 5px 6px rgba(15, 23, 42, 0.35));
  }

  .bp-key-svg {
    width: 100%;
    height: 100%;
  }

  .bp-keytag-title {
    font-family: 'Georgia', 'Times New Roman', serif;
    font-weight: 900;
    font-size: 1.35rem;
    letter-spacing: 0.08em;
    color: var(--b-keytag-text, #1e2c47);
    text-shadow: 0 1px 0 var(--b-keytag-shadow, #9cb6e5);
    user-select: none;
    transition: color 0.25s ease, text-shadow 0.25s ease;
  }

  /* 2. Flight Board Gate Ticker ("DEP ✈ ARR") */
  .bp-flight-gate-card {
    background: var(--b-ticker-bg, #cfe4f5);
    border: 1.5px solid var(--b-ticker-border, #8ab6db);
    border-radius: 6px;
    padding: 4px 10px;
    display: flex;
    flex-direction: column;
    justify-content: center;
    box-shadow: 1px 3px 8px rgba(0, 0, 0, 0.18);
    min-width: 135px;
    margin-left: auto;
    transition: background 0.25s ease, border-color 0.25s ease;
  }

  .bp-flight-header-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    font-size: 0.65rem;
    font-weight: 800;
    color: var(--b-ticker-label, #55799c);
    letter-spacing: 0.12em;
    transition: color 0.25s ease;
  }

  .bp-f-icon {
    color: var(--b-ticker-label, #3b668f);
    font-size: 0.72rem;
  }

  .bp-flight-dates-display {
    font-family: 'Courier New', Courier, monospace, sans-serif;
    font-size: 1.02rem;
    font-weight: 900;
    color: var(--b-ticker-text, #214063) !important;
    text-align: center;
    margin-top: 2px;
    letter-spacing: 0.06em;
    transition: color 0.25s ease;
  }

  /* Top Right: Monday Ticket Container */
  .bp-mon-ticket-container {
    width: 250px;
    flex-shrink: 0;
    display: flex;
  }

  .bp-mon-ticket-container .bp-ticket-card {
    width: 100%;
    border: 1.5px solid var(--b-strip-border, #9eb2dc);
    border-radius: 8px;
    box-shadow: 2px 6px 16px rgba(0, 0, 0, 0.16);
  }

  /* TICKET STRIPS (Middle & Bottom Rows) */
  .bp-ticket-strip {
    background: var(--b-strip-bg, #f8fafc);
    border: 1.5px solid var(--b-strip-border, #9eb2dc);
    border-radius: 8px;
    display: flex;
    align-items: stretch;
    box-shadow: 2px 6px 16px rgba(0, 0, 0, 0.16);
    overflow: hidden;
    position: relative;
    transition: background 0.25s ease, border-color 0.25s ease;
  }

  /* Left Barcode Stub */
  .bp-strip-left-stub {
    width: 44px;
    flex-shrink: 0;
    background: var(--b-stub-bg, #eef3f9);
    border-right: 1.5px dashed var(--b-stub-border, #9eb2dc);
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
    padding: 6px 0;
    transition: background 0.25s ease, border-color 0.25s ease;
  }

  .bp-barcode-stub-content {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    transform: rotate(-90deg);
    white-space: nowrap;
  }

  .bp-barcode-number {
    font-family: 'Courier New', Courier, monospace;
    font-size: 0.62rem;
    font-weight: 800;
    color: var(--b-stub-text, #556c8e);
    letter-spacing: 0.12em;
    transition: color 0.25s ease;
  }

  .bp-barcode-lines {
    display: inline-flex;
    align-items: stretch;
    gap: 1.5px;
    height: 14px;
  }
  .bp-barcode-lines span {
    display: inline-block;
    width: 1.5px;
    background: var(--b-barcode, #465a78);
    transition: background 0.25s ease;
  }
  .bp-barcode-lines span:nth-child(2n) { width: 3px; }
  .bp-barcode-lines span:nth-child(3n) { width: 1px; }

  .bp-stripes-stub {
    width: 28px;
    height: 65px;
    transform: none;
    background: repeating-linear-gradient(
      -45deg,
      var(--b-barcode, #556c8e),
      var(--b-barcode, #556c8e) 4px,
      transparent 4px,
      transparent 9px
    );
    opacity: 0.7;
    border-radius: 2px;
    transition: background 0.25s ease;
  }

  .bp-stub-notches {
    position: absolute;
    top: 0;
    bottom: 0;
    right: 0;
    width: 0;
    height: 100%;
    pointer-events: none;
    z-index: 4;
  }

  .bp-notch {
    width: 14px;
    height: 14px;
    border-radius: 50%;
    background: var(--b-board-bg, #d2d7e2);
    position: absolute;
    left: 50%;
    transform: translateX(-50%);
    z-index: 4;
    transition: background 0.25s ease;
  }
  .bp-notch.top { top: -7px; }
  .bp-notch.btm { bottom: -7px; }

  .bp-strip-tickets-group {
    flex: 1;
    display: flex;
    align-items: stretch;
  }

  .bp-perforate-divider {
    width: 0;
    border-right: 1.5px dashed var(--b-strip-border, #9eb2dc);
    position: relative;
    z-index: 3;
    transition: border-color 0.25s ease;
  }

  /* INDIVIDUAL TICKET CARD */
  .bp-ticket-card {
    flex: 1;
    min-width: 0;
    background: var(--b-ticket-bg, #fbfdff);
    padding: 5px 5px 4px;
    display: flex;
    flex-direction: column;
    align-items: center;
    position: relative;
    cursor: pointer;
    transition: background 0.2s ease, filter 0.2s ease;
  }

  .bp-ticket-card:hover {
    filter: brightness(1.08);
  }

  /* Ribbon Day Banner */
  .bp-ticket-ribbon-wrap {
    margin-bottom: 3px;
    display: flex;
    justify-content: center;
    width: 100%;
  }

  .bp-folded-ribbon {
    position: relative;
    background: var(--b-ribbon-bg, #5b7bc3);
    color: var(--b-ribbon-text, #ffffff);
    font-family: 'Georgia', 'Times New Roman', serif;
    font-size: 0.86rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    padding: 2px 14px;
    border-radius: 2px;
    box-shadow: 0 2px 5px rgba(0, 0, 0, 0.25);
    text-align: center;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    transition: background 0.25s ease, color 0.25s ease;
  }

  .bp-ribbon-fold-l, .bp-ribbon-fold-r {
    position: absolute;
    top: 0;
    bottom: 0;
    width: 9px;
    background: var(--b-ribbon-fold, #4665a8);
    transition: background 0.25s ease;
  }
  .bp-ribbon-fold-l {
    left: -8px;
    clip-path: polygon(100% 0, 100% 100%, 0 50%);
  }
  .bp-ribbon-fold-r {
    right: -8px;
    clip-path: polygon(0 0, 100% 50%, 0 100%);
  }

  /* Inner Ticket Frame */
  .bp-ticket-inner-frame {
    width: 100%;
    flex: 1;
    border: 1px solid var(--b-ticket-inner-border, #9bb5e0);
    border-radius: 6px;
    padding: 4px 5px 3px;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: space-between;
    text-align: center;
    position: relative;
    min-height: 80px;
    transition: border-color 0.25s ease;
  }

  .bp-ticket-body-content {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 1px;
    margin: auto 0;
    width: 100%;
  }

  html.dark .schedule-card-board .bp-ticket-title,
  .bp-ticket-title {
    font-size: 0.98rem;
    font-weight: 900;
    color: var(--b-ticket-title, #24385a) !important;
    line-height: 1.2;
    word-break: break-word;
    transition: color 0.25s ease;
  }

  html.dark .schedule-card-board .bp-ticket-memo,
  .bp-ticket-memo {
    font-size: 0.69rem;
    font-weight: 600;
    color: var(--b-ticket-memo, #5a739c) !important;
    line-height: 1.2;
    min-height: 13px;
    word-break: break-word;
    transition: color 0.25s ease;
  }

  html.dark .schedule-card-board .bp-ticket-time,
  .bp-ticket-time {
    font-size: 0.76rem;
    font-weight: 800;
    color: var(--b-ticket-time, #3b5785) !important;
    margin-top: 1px;
    letter-spacing: 0.02em;
    transition: color 0.25s ease;
  }

  /* Hanging Wooden OFFLINE Sign (Friday / Day Off) */
  .bp-hanging-sign-unit {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    margin: auto 0;
    transform: rotate(-4.5deg);
    filter: drop-shadow(2px 5px 6px rgba(0, 0, 0, 0.25));
  }

  .bp-pin-nail {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #394657;
    box-shadow: 0 1px 2px rgba(0, 0, 0, 0.4);
  }

  .bp-hanging-strings-svg {
    width: 60px;
    height: 12px;
    display: block;
  }

  .bp-wooden-plaque {
    background: var(--b-offline-bg, #b5a799);
    border: 2px solid var(--b-offline-border, #5a4b3d);
    border-radius: 3px;
    padding: 4px 10px;
    position: relative;
    box-shadow: inset 0 0 6px rgba(0, 0, 0, 0.25), 1px 3px 6px rgba(0, 0, 0, 0.2);
    display: flex;
    align-items: center;
    justify-content: center;
    transition: background 0.25s ease, border-color 0.25s ease;
  }

  html.dark .schedule-card-board .bp-wooden-text,
  .bp-wooden-text {
    font-family: 'Georgia', 'Impact', serif;
    font-size: 0.88rem;
    font-weight: 900;
    letter-spacing: 0.12em;
    color: var(--b-offline-text, #35281d) !important;
    text-shadow: 0 1px 0 rgba(0, 0, 0, 0.2);
    transition: color 0.25s ease;
  }

  .bp-rivet {
    position: absolute;
    width: 3px;
    height: 3px;
    border-radius: 50%;
    background: #45392e;
  }
  .bp-rivet.tl { top: 2.5px; left: 2.5px; }
  .bp-rivet.tr { top: 2.5px; right: 2.5px; }
  .bp-rivet.bl { bottom: 2.5px; left: 2.5px; }
  .bp-rivet.br { bottom: 2.5px; right: 2.5px; }

  /* Vintage Flourish Ornament at Bottom of Ticket */
  .bp-flourish-wrap {
    width: 100%;
    max-width: 100px;
    height: 13px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--b-flourish, #8da9dc);
    margin-top: 1px;
    transition: color 0.25s ease;
  }

  .bp-flourish-svg {
    width: 100%;
    height: 100%;
  }

  /* Quick Edit Tooltip/Hint on Hover */
  .bp-ticket-edit-hint {
    position: absolute;
    top: 4px;
    right: 4px;
    background: var(--b-card, rgba(255, 255, 255, 0.85));
    border: 1px solid var(--b-border, rgba(85, 114, 185, 0.25));
    border-radius: 4px;
    font-size: 0.65rem;
    padding: 1px 3px;
