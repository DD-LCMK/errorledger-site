    border: 1px solid rgba(56, 189, 248, 0.35);
    color: #38bdf8;
    font-size: 0.68rem;
    font-weight: 800;
    padding: 0.15rem 0.45rem;
    border-radius: 5px;
    cursor: pointer;
    transition: all 0.15s ease;
  }
  .btn-today-jump:hover {
    background: rgba(56, 189, 248, 0.28);
    color: #ffffff;
  }

  .btn-upload-avatar {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    background: rgba(56, 189, 248, 0.14);
    border: 1px solid rgba(56, 189, 248, 0.38);
    color: #38bdf8;
    font-size: 0.72rem;
    font-weight: 800;
    padding: 0.32rem 0.55rem;
    border-radius: 6px;
    cursor: pointer;
    white-space: nowrap;
    transition: all 0.15s ease;
  }
  .btn-upload-avatar:hover {
    background: rgba(56, 189, 248, 0.26);
    color: #ffffff;
  }

  .btn-clear-avatar {
    background: rgba(244, 63, 94, 0.16);
    border: 1px solid rgba(244, 63, 94, 0.4);
    color: #fb7185;
    font-size: 0.7rem;
    font-weight: 800;
    padding: 0.28rem 0.45rem;
    border-radius: 6px;
    cursor: pointer;
  }
  .btn-clear-avatar:hover {
    background: rgba(244, 63, 94, 0.3);
    color: #ffffff;
  }

  .schedule-card-board {
    width: 100%;
    max-width: 1040px;
    background: #080c14;
    border: 1.5px solid rgba(0, 255, 163, 0.35);
    border-radius: 20px;
    padding: 1.35rem 1.6rem 1.1rem;
    box-shadow: 0 24px 60px rgba(0, 0, 0, 0.55);
    position: relative;
    overflow: hidden;
    transition: max-width 0.25s ease, border-color 0.25s ease, background 0.3s ease;
  }

  .schedule-card-board[data-layout="ticket"] {
    max-width: 880px;
    padding: 0.85rem 1.05rem 0.75rem;
  }

  .schedule-card-board[data-view="monthly"] {
    max-width: 1020px;
  }

  .board-ambient-orb {
    position: absolute;
    width: 340px;
    height: 340px;
    border-radius: 50%;
    pointer-events: none;
    filter: blur(80px);
    opacity: 0.16;
    z-index: 0;
    background: var(--b-accent, #00ffa3);
  }
  .board-ambient-orb.orb-tl {
    top: -140px;
    left: -100px;
  }
  .board-ambient-orb.orb-br {
    bottom: -150px;
    right: -100px;
  }

  .board-header,
  .board-notice-banner,
  .bento-schedule-wrap,
  .timeline-schedule-wrap,
  .bp-schedule-wrap,
  .monthly-schedule-compact-wrap,
  .board-footer {
    position: relative;
    z-index: 1;
  }

  /* In Timeline Poster layout, the left poster showcases the profile & notice */
  .schedule-card-board[data-view="weekly"][data-layout="timeline"] .board-header,
  .schedule-card-board[data-view="weekly"][data-layout="timeline"] .board-notice-banner {
    display: none !important;
  }

