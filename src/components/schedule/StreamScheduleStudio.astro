  // Input Controls
  var inputAvatarEmoji = document.getElementById('inputAvatarEmoji') as HTMLInputElement;
  var inputAvatarImage = document.getElementById('inputAvatarImage') as HTMLInputElement | null;
  var btnClearAvatarImage = document.getElementById('btnClearAvatarImage') as HTMLButtonElement | null;
  var emojiSamplesRow = document.getElementById('emojiSamplesRow');
  var inputChannelName = document.getElementById('inputChannelName') as HTMLInputElement;
  var selectPlatform = document.getElementById('selectPlatform') as HTMLSelectElement;
  var inputTagline = document.getElementById('inputTagline') as HTMLInputElement;
  var inputNoticeWeekly = document.getElementById('inputNoticeWeekly') as HTMLInputElement;
  var inputNoticeMonthly = document.getElementById('inputNoticeMonthly') as HTMLInputElement;

  var btnLayoutBento = document.getElementById('btnLayoutBento');
  var btnLayoutTimeline = document.getElementById('btnLayoutTimeline');
  var btnModeWeekly = document.getElementById('btnModeWeekly');
  var btnModeMonthly = document.getElementById('btnModeMonthly');
  var themePickerRow = document.getElementById('themePickerRow')!;

  var btnSaveJson = document.getElementById('btnSaveJson')!;
  var inputLoadJson = document.getElementById('inputLoadJson') as HTMLInputElement;
  var btnCopyText = document.getElementById('btnCopyText')!;
  var btnPresetTravel = document.getElementById('btnPresetTravel');
  var btnPresetGamer = document.getElementById('btnPresetGamer')!;
  var btnPresetVtuber = document.getElementById('btnPresetVtuber')!;

  var btnPrevMonth = document.getElementById('btnPrevMonth')!;
  var btnNextMonth = document.getElementById('btnNextMonth')!;
  var btnQuickPrevMonth = document.getElementById('btnQuickPrevMonth');
  var btnQuickNextMonth = document.getElementById('btnQuickNextMonth');
  var btnJumpToday = document.getElementById('btnJumpToday');

  // Modal DOM
  var modalOverlay = document.getElementById('editModalOverlay')!;
  var modalDayTitle = document.getElementById('modalDayTitle')!;
  var modalBadgeGrid = document.getElementById('modalBadgeGrid')!;
  var modalStartTimeInput = document.getElementById('modalStartTimeInput') as HTMLInputElement;
  var modalEndTimeInput = document.getElementById('modalEndTimeInput') as HTMLInputElement;
  var modalTitleInput = document.getElementById('modalTitleInput') as HTMLInputElement;
  var modalMemoInput = document.getElementById('modalMemoInput') as HTMLInputElement;
  var btnCloseModal = document.getElementById('btnCloseModal')!;
  var btnModalCancel = document.getElementById('btnModalCancel')!;
  var btnModalSave = document.getElementById('btnModalSave')!;

  var currentEditingDayNum = 1;
  var currentSelectedBadgeId = 'live';

  function getActiveKeytagText(): string {
    var customKeytag = state.keytagText || (state.channel && state.channel.keytagText);
    var defaultThemeKeytag = (SCHEDULE_THEMES[state.themeId] && SCHEDULE_THEMES[state.themeId].keytagTitle) || 'ON AIR';
    return (customKeytag !== undefined && String(customKeytag).trim() !== '') ? String(customKeytag).trim() : defaultThemeKeytag;
  }

  function renderAvatarBox(el: HTMLElement | null) {
    if (!el) return;
    if (state.channel && state.channel.avatarImage) {
      el.innerHTML = '<img class="avatar-custom-img" src="' + state.channel.avatarImage + '" alt="Avatar" />';
      if (btnClearAvatarImage) btnClearAvatarImage.style.display = 'inline-block';
    } else {
      el.textContent = (state.channel && state.channel.avatarEmoji) ? state.channel.avatarEmoji : '🎮';
      if (btnClearAvatarImage) btnClearAvatarImage.style.display = 'none';
    }
  }

  // ─── Render Functions ──────────────────────────────────────────────────────
  function renderAll() {
    var weeks = computeMonthWeeks(state.monthly.year, state.monthly.month);
    if (state.selectedWeekIndex >= weeks.length) {
      state.selectedWeekIndex = 0;
    }
    var currentWeek = weeks[state.selectedWeekIndex] || weeks[0];
    var layoutStyle = state.layoutStyle || 'bento';

    // 1. Board Theme, View & Layout Attributes
    board.setAttribute('data-theme', state.themeId);
    board.setAttribute('data-view', state.viewMode);
    board.setAttribute('data-layout', layoutStyle);

    // Quick Month Label
    if (dispQuickMonthLabel) {
      var mPad = state.monthly.month < 10 ? '0' + state.monthly.month : String(state.monthly.month);
      dispQuickMonthLabel.textContent = state.monthly.year + '.' + mPad;
    }

    // Update keytag title dynamically according to custom text or theme
    updateKeytagDisplay();
    var inputKeytagText = document.getElementById('inputKeytagText') as HTMLInputElement | null;
    if (inputKeytagText && document.activeElement !== inputKeytagText) {
      inputKeytagText.value = getActiveKeytagText();
    }

    // 2. Active Theme Chips
    var themeChips = themePickerRow.querySelectorAll('.theme-chip');
    themeChips.forEach(function (chip) {
      if (chip.getAttribute('data-theme-id') === state.themeId) {
        chip.classList.add('active');
      } else {
        chip.classList.remove('active');
      }
    });

    // 3. View Mode & Layout Toggle
    if (btnLayoutBento) btnLayoutBento.classList.toggle('active', state.viewMode === 'weekly' && layoutStyle === 'bento');
    if (btnLayoutTimeline) btnLayoutTimeline.classList.toggle('active', state.viewMode === 'weekly' && layoutStyle === 'timeline');
    if (btnModeWeekly) btnModeWeekly.classList.toggle('active', state.viewMode === 'weekly' && layoutStyle === 'ticket');
    if (btnModeMonthly) btnModeMonthly.classList.toggle('active', state.viewMode === 'monthly');

    if (state.viewMode === 'weekly') {
      bentoWeeklyWrap.style.display = (layoutStyle === 'bento') ? 'block' : 'none';
      timelineWeeklyWrap.style.display = (layoutStyle === 'timeline') ? 'block' : 'none';
      weeklyWrap.style.display = (layoutStyle === 'ticket') ? 'flex' : 'none';
      monthlyWrap.style.display = 'none';
      weekExtractorGroup.style.display = 'flex';
      dispScheduleRangeBadge.textContent = state.monthly.year + '.' + (state.monthly.month < 10 ? '0' + state.monthly.month : state.monthly.month) + ' · ' + currentWeek.label;
    } else {
      bentoWeeklyWrap.style.display = 'none';
      timelineWeeklyWrap.style.display = 'none';
      weeklyWrap.style.display = 'none';
      monthlyWrap.style.display = 'flex';
      weekExtractorGroup.style.display = 'flex';
      dispScheduleRangeBadge.textContent = isEn
        ? (monthShortNames[state.monthly.month - 1] + ' ' + state.monthly.year + ' All Streams')
        : (state.monthly.year + '년 ' + state.monthly.month + '월 전체 방송');
    }

    // 4. Week Buttons Bar
    renderWeekButtons(weeks);

    // 5. Header Branding Details
    renderAvatarBox(dispAvatar);
    dispChannelName.textContent = state.channel.name || (isEn ? 'Streamer Channel' : '스트리머 채널');
    dispTagline.textContent = state.channel.tagline || '';

    var platformMap: Record<string, string> = isEn
      ? { chzzk: 'CHZZK', soop: 'SOOP', twitch: 'Twitch', youtube: 'YouTube', custom: 'LIVE' }
      : { chzzk: '치지직', soop: 'SOOP', twitch: '트위치', youtube: '유튜브', custom: 'LIVE' };
    dispPlatformBadge.textContent = platformMap[state.channel.platform] || 'LIVE';

    // Notice Banner (Weekly vs Monthly)
    if (state.viewMode === 'weekly' && layoutStyle !== 'timeline') {
      var weeklyNotice = state.channel.noticeWeekly || state.channel.notice;
      if (weeklyNotice && weeklyNotice.trim() !== '') {
        dispNoticeBanner.style.display = 'flex';
        dispNoticeText.textContent = weeklyNotice;
      } else {
        dispNoticeBanner.style.display = 'none';
      }
    } else {
      dispNoticeBanner.style.display = 'none';
    }

    // Monthly Goal Badge
    var monthlyGoal = state.channel.noticeMonthly || state.monthly.monthlyGoal;
    dispMonthlyGoal.textContent = monthlyGoal || (isEn ? '🎯 Let’s make this month great!' : '🎯 이번 달도 파이팅!');

    // 6. Sync Input Controls
    if (document.activeElement !== inputAvatarEmoji) inputAvatarEmoji.value = state.channel.avatarEmoji || '🎮';
    if (document.activeElement !== inputChannelName) inputChannelName.value = state.channel.name || '';
    selectPlatform.value = state.channel.platform || (isEn ? 'twitch' : 'chzzk');
    if (document.activeElement !== inputTagline) inputTagline.value = state.channel.tagline || '';
    if (document.activeElement !== inputNoticeWeekly) inputNoticeWeekly.value = state.channel.noticeWeekly || state.channel.notice || '';
    if (document.activeElement !== inputNoticeMonthly) inputNoticeMonthly.value = state.channel.noticeMonthly || state.monthly.monthlyGoal || '';

    // 7. Render Weekly Views (Bento, Timeline, and Ticket)
    renderBentoGrid(currentWeek);
    renderTimelinePoster(currentWeek);
    renderWeeklyDays(currentWeek.days);

    // 8. Render Monthly Compact Cells
    renderMonthlyCalendar();
  }

  function renderWeekButtons(weeks: any[]) {
    weekButtonsBar.innerHTML = '';
    weeks.forEach(function (w, idx) {
      var btn = document.createElement('button');
      btn.type = 'button';
      btn.className = 'btn-week-chip' + (idx === state.selectedWeekIndex ? ' active' : '');
      btn.textContent = w.shortLabel;
      btn.title = w.label;

      btn.addEventListener('click', function () {
        state.selectedWeekIndex = idx;
        saveState();
        renderAll();
      });

      weekButtonsBar.appendChild(btn);
    });
  }

  // ─── Layout 1: Modern 4x2 Bento Card Grid ──────────────────────────────────
  function renderBentoGrid(currentWeek: any) {
    if (!bentoGridContainer) return;
    bentoGridContainer.innerHTML = '';
    var weekDays = currentWeek.days || [];
    var defaultDayTitle = isEn ? 'Live Stream' : '방송 예정';
    var liveCount = 0;
    var offCount = 0;

    weekDays.forEach(function (d: any) {
      var entry = d.entry || { time: '20:00', startTime: '20:00', endTime: '', status: 'live', title: defaultDayTitle, memo: '' };
      var isOff = (entry.status === 'off' || entry.title === 'OFFLINE');
      if (isOff) offCount++; else liveCount++;

      var badge = STATUS_BADGES[entry.status] || STATUS_BADGES.live;
      var badgeLabel = isEn ? badge.labelEn : badge.labelKo;
      var displayTime = formatDisplayTime(entry, isEn ? 'en' : 'ko') || entry.time || '20:00';
      var dayPillClass = 'bento-day-pill' + (d.dayEn === 'SAT' ? ' is-sat' : (d.dayEn === 'SUN' ? ' is-sun' : ''));
      var dayLabelText = isEn ? d.dayEn : (d.dayEn + ' · ' + d.dayKo);

      var card = document.createElement('div');
      card.className = 'bento-day-card' + (isOff ? ' is-off-day' : '');
      card.style.setProperty('--card-status-color', badge.color);

      var bodyHtml = '';
      if (isOff) {
        var offMemo = entry.memo || (isEn ? 'Scheduled Rest & Recharge' : '정기 휴방 및 컨디션 충전');
        bodyHtml =
          '<div class="bento-off-box">' +
            '<div class="bento-off-moon">🌙</div>' +
            '<div class="bento-off-title">' + (isEn ? 'DAY OFF · REST' : 'OFFLINE · 정기 휴방') + '</div>' +
            '<div class="bento-off-sub">' + escapeHtml(offMemo) + '</div>' +
          '</div>';
      } else {
        bodyHtml =
          '<div class="bento-card-body">' +
            '<div class="bento-stream-title">' + escapeHtml(entry.title || defaultDayTitle) + '</div>' +
            (entry.memo ? '<div class="bento-stream-memo">' + escapeHtml(entry.memo) + '</div>' : '') +
          '</div>';
      }

      card.innerHTML =
        '<div class="bento-day-top">' +
          '<div class="bento-day-left">' +
            '<span class="' + dayPillClass + '">' + dayLabelText + '</span>' +
            '<span class="bento-date-num">' + d.dateStr + '</span>' +
          '</div>' +
          '<span class="bento-status-badge" style="background:' + badge.bg + '; color:' + badge.color + '; border:1px solid ' + badge.color + '44;">' +
            badge.icon + ' ' + badgeLabel +
          '</span>' +
        '</div>' +
        bodyHtml +
        '<div class="bento-card-footer">' +
          '<span class="bento-time-pill">' + (isOff ? '💤 ' + (isEn ? 'OFFLINE' : '휴방일') : ('🕗 ' + escapeHtml(displayTime))) + '</span>' +
          '<span class="bento-edit-icon">✏️ ' + (isEn ? 'Edit' : '편집') + '</span>' +
        '</div>';

      card.addEventListener('click', function () {
        var dayTitleStr = isEn ? (d.dateStr + ' (' + d.dayEn + ')') : (d.dateStr + ' (' + d.dayKo + '요일)');
        openEditModal(d.day, dayTitleStr);
      });

      bentoGridContainer.appendChild(card);
    });

    // 8th Card: Weekly Highlight & Summary Card
    var summaryCard = document.createElement('div');
    summaryCard.className = 'bento-summary-card';
    var keytagStr = getActiveKeytagText();
    var footText = state.channel.noticeWeekly || state.channel.notice || state.channel.tagline || (isEn ? 'Click any day card to customize your broadcast schedule!' : '요일 카드를 클릭하여 방송 시간과 제목을 자유롭게 수정하세요!');

    summaryCard.innerHTML =
      '<div class="bento-summary-top">' +
        '<span class="bento-summary-tag">' + escapeHtml(keytagStr) + '</span>' +
        '<span class="bento-summary-range">' + escapeHtml(currentWeek.rangeStr) + '</span>' +
      '</div>' +
      '<div class="bento-summary-stats">' +
        '<div class="bento-stat-box">' +
          '<span class="bento-stat-num">' + liveCount + (isEn ? ' Days' : '일') + '</span>' +
          '<span class="bento-stat-label">' + (isEn ? '🔴 Live Streams' : '🔴 이번 주 방송') + '</span>' +
        '</div>' +
        '<div class="bento-stat-box">' +
          '<span class="bento-stat-num">' + offCount + (isEn ? ' Days' : '일') + '</span>' +
          '<span class="bento-stat-label">' + (isEn ? '🌙 Rest Days' : '🌙 이번 주 휴방') + '</span>' +
        '</div>' +
      '</div>' +
      '<div class="bento-summary-foot">' +
        escapeHtml(footText) +
      '</div>';

    bentoGridContainer.appendChild(summaryCard);
  }

  // ─── Layout 2: Streamer Profile Showcase + 7-Day Timeline Poster ───────────
  function renderTimelinePoster(currentWeek: any) {
    if (!timelinePosterCol || !timelineDaysCol) return;
    var weekDays = currentWeek.days || [];
    var defaultDayTitle = isEn ? 'Live Stream' : '방송 예정';
    var liveCount = 0;
    var offCount = 0;

    weekDays.forEach(function (d: any) {
      var entry = d.entry || {};
      if (entry.status === 'off' || entry.title === 'OFFLINE') offCount++; else liveCount++;
    });

    var platformMap: Record<string, string> = isEn
      ? { chzzk: 'CHZZK', soop: 'SOOP', twitch: 'Twitch', youtube: 'YouTube', custom: 'LIVE' }
      : { chzzk: '치지직', soop: 'SOOP', twitch: '트위치', youtube: '유튜브', custom: 'LIVE' };
    var platText = platformMap[state.channel.platform] || 'LIVE';
    var avatarHtml = (state.channel && state.channel.avatarImage)
      ? '<img class="poster-custom-img" src="' + state.channel.avatarImage + '" alt="Avatar" />'
      : '<span>' + escapeHtml(state.channel.avatarEmoji || '🎮') + '</span>';
    var noticeText = state.channel.noticeWeekly || state.channel.notice || '';

    timelinePosterCol.innerHTML =
      '<div>' +
        '<div class="poster-top-badges">' +
          '<span class="poster-platform-pill">' + escapeHtml(platText) + ' · ' + escapeHtml(getActiveKeytagText()) + '</span>' +
          '<span class="poster-week-pill">' + escapeHtml(currentWeek.shortLabel) + '</span>' +
        '</div>' +
        '<div class="poster-avatar-showcase" style="margin-top:0.75rem;">' + avatarHtml + '</div>' +
        '<div style="margin-top:0.85rem;">' +
          '<h3 class="poster-channel-title">' + escapeHtml(state.channel.name || (isEn ? 'Streamer Channel' : '스트리머 채널')) + '</h3>' +
          '<p class="poster-channel-tagline">' + escapeHtml(state.channel.tagline || '') + '</p>' +
        '</div>' +
      '</div>' +
      (noticeText ? '<div class="poster-notice-box">' + escapeHtml(noticeText) + '</div>' : '') +
      '<div class="poster-stats-row">' +
        '<div class="poster-stat-chip">' + (isEn ? 'LIVE' : '방송') + '<strong>' + liveCount + (isEn ? 'd' : '일') + '</strong></div>' +
        '<div class="poster-stat-chip">' + (isEn ? 'OFF' : '휴방') + '<strong>' + offCount + (isEn ? 'd' : '일') + '</strong></div>' +
        '<div class="poster-stat-chip"><strong>' + escapeHtml(currentWeek.rangeStr) + '</strong></div>' +
      '</div>';

    timelineDaysCol.innerHTML = '';
    weekDays.forEach(function (d: any) {
      var entry = d.entry || { time: '20:00', startTime: '20:00', endTime: '', status: 'live', title: defaultDayTitle, memo: '' };
      var isOff = (entry.status === 'off' || entry.title === 'OFFLINE');
      var badge = STATUS_BADGES[entry.status] || STATUS_BADGES.live;
      var badgeLabel = isEn ? badge.labelEn : badge.labelKo;
      var displayTime = formatDisplayTime(entry, isEn ? 'en' : 'ko') || entry.time || '20:00';
      var dayPillClass = 'tl-day-pill' + (d.dayEn === 'SAT' ? ' is-sat' : (d.dayEn === 'SUN' ? ' is-sun' : ''));

      var row = document.createElement('div');
      row.className = 'timeline-day-row' + (isOff ? ' is-off-day' : '');
      row.style.setProperty('--row-status-color', badge.color);

      var titleText = isOff ? (isEn ? 'OFFLINE (Scheduled Rest Day)' : '정기 휴방일 (OFFLINE)') : (entry.title || defaultDayTitle);
      var memoText = entry.memo ? ('· ' + entry.memo) : '';

      row.innerHTML =
        '<div class="tl-day-col">' +
          '<span class="' + dayPillClass + '">' + d.dayEn + '</span>' +
          '<span class="tl-date-text">' + d.dateStr + '</span>' +
        '</div>' +
        '<div class="tl-time-col">' + (isOff ? '🌙 ' + (isEn ? 'DAY OFF' : '휴방') : ('🕗 ' + escapeHtml(displayTime))) + '</div>' +
        '<span class="tl-status-chip" style="background:' + badge.bg + '; color:' + badge.color + '; border:1px solid ' + badge.color + '44;">' +
          badge.icon + ' ' + badgeLabel +
        '</span>' +
        '<div class="tl-content-col">' +
          '<span class="tl-stream-title">' + escapeHtml(titleText) + '</span>' +
          (memoText ? '<span class="tl-stream-memo">' + escapeHtml(memoText) + '</span>' : '') +
        '</div>' +
        '<span class="tl-edit-icon">✏️</span>';

      row.addEventListener('click', function () {
        var dayTitleStr = isEn ? (d.dateStr + ' (' + d.dayEn + ')') : (d.dateStr + ' (' + d.dayKo + '요일)');
        openEditModal(d.day, dayTitleStr);
      });

      timelineDaysCol.appendChild(row);
    });
  }

  // ─── Layout 3: Travel Boarding Pass Tickets ────────────────────────────────
  function renderWeeklyDays(weekDays: any[]) {
    if (bpFlightDatesDisplay && weekDays.length >= 7) {
      bpFlightDatesDisplay.textContent = weekDays[0].dateStr + ' ✈ ' + weekDays[6].dateStr;
    }

    // 1. Monday Ticket (Top Right)
    if (bpMonTicketContainer) {
      bpMonTicketContainer.innerHTML = '';
      if (weekDays[0]) {
        bpMonTicketContainer.appendChild(createBoardingPassTicket(weekDays[0]));
      }
    }

    // 2. Middle Row Tickets (TUE, WED, THU)
    if (bpMidTicketsGroup) {
      bpMidTicketsGroup.innerHTML = '';
      for (var i = 1; i <= 3; i++) {
        if (i > 1) {
          var div = document.createElement('div');
          div.className = 'bp-perforate-divider';
          div.innerHTML = '<span class="bp-notch top"></span><span class="bp-notch btm"></span>';
          bpMidTicketsGroup.appendChild(div);
        }
        if (weekDays[i]) {
          bpMidTicketsGroup.appendChild(createBoardingPassTicket(weekDays[i]));
        }
      }
    }

    // 3. Bottom Row Tickets (FRI, SAT, SUN)
    if (bpBtmTicketsGroup) {
      bpBtmTicketsGroup.innerHTML = '';
      for (var j = 4; j <= 6; j++) {
        if (j > 4) {
          var div2 = document.createElement('div');
          div2.className = 'bp-perforate-divider';
          div2.innerHTML = '<span class="bp-notch top"></span><span class="bp-notch btm"></span>';
          bpBtmTicketsGroup.appendChild(div2);
        }
        if (weekDays[j]) {
          bpBtmTicketsGroup.appendChild(createBoardingPassTicket(weekDays[j]));
        }
      }
    }
  }

