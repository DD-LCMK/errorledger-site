      state.monthly.year = y;
      state.monthly.month = m;
      var weeks = computeMonthWeeks(y, m);
      var foundIdx = 0;
      weeks.forEach(function (w: any, idx: number) {
        w.days.forEach(function (dayObj: any) {
          if (dayObj.year === y && dayObj.month === m && dayObj.day === d) {
            foundIdx = idx;
          }
        });
      });
      state.selectedWeekIndex = foundIdx;
      saveState();
      renderAll();
    });
