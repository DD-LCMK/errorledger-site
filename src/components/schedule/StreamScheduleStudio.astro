  /* Broadcast Board Header */
  .board-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 0.9rem;
    padding-bottom: 0.85rem;
    border-bottom: 1px solid var(--b-border);
  }

  .channel-info-col {
    display: flex;
    align-items: center;
    gap: 0.9rem;
  }

  .channel-avatar-box {
    width: 54px;
    height: 54px;
    background: var(--b-card);
    border: 2px solid var(--b-accent);
    border-radius: 16px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.7rem;
    flex-shrink: 0;
    overflow: hidden;
    box-shadow: 0 6px 18px rgba(0, 0, 0, 0.25);
  }

  .channel-avatar-box img.avatar-custom-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .channel-title-row {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex-wrap: wrap;
  }

  html.dark .schedule-card-board .channel-name,
  .channel-name {
    font-size: 1.35rem;
    font-weight: 900;
    margin: 0;
    letter-spacing: -0.02em;
    color: var(--b-text) !important;
  }

  html.dark .schedule-card-board .platform-badge,
  .platform-badge {
    font-size: 0.68rem;
    font-weight: 800;
    padding: 0.18rem 0.5rem;
    border-radius: 6px;
    background: var(--b-card) !important;
    color: var(--b-accent) !important;
    border: 1px solid var(--b-border) !important;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  .header-keytag-pill {
    font-size: 0.64rem;
    font-weight: 900;
    padding: 0.16rem 0.5rem;
    border-radius: 999px;
    background: var(--b-accent);
    color: var(--b-ribbon-text, #041c10);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  html.dark .schedule-card-board .channel-tagline,
  .channel-tagline {
    font-size: 0.82rem;
    font-weight: 600;
    color: var(--b-sub) !important;
    margin: 0.2rem 0 0;
  }

  .board-meta-col {
    text-align: right;
  }

  html.dark .schedule-card-board .board-range-badge,
  .board-range-badge {
    display: inline-block;
    font-size: 0.92rem;
    font-weight: 800;
    color: var(--b-accent) !important;
    background: var(--b-card);
    border: 1px solid var(--b-border);
    padding: 0.28rem 0.75rem;
    border-radius: 999px;
    margin-bottom: 0.25rem;
  }

  html.dark .schedule-card-board .branding-watermark,
  .branding-watermark {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 0.3rem;
    font-size: 0.66rem;
    font-weight: 800;
    color: var(--b-sub) !important;
    letter-spacing: 0.08em;
  }
  .brand-icon-mini { font-size: 0.65rem; }

  /* Notice Banner */
  html.dark .schedule-card-board .board-notice-banner,
  .board-notice-banner {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    background: var(--b-card) !important;
    border: 1px solid var(--b-border) !important;
    border-left: 4px solid var(--b-accent) !important;
    padding: 0.55rem 0.95rem;
    border-radius: 10px;
    margin-bottom: 1rem;
    font-size: 0.84rem;
    font-weight: 700;
    color: var(--b-text) !important;
    box-shadow: 0 4px 14px rgba(0, 0, 0, 0.15);
  }
  html.dark .schedule-card-board .board-notice-banner .notice-text,
  .board-notice-banner .notice-text {
    color: var(--b-text) !important;
  }
  .notice-icon { font-size: 0.95rem; }

  /* ─────────────────────────────────────────────────────────────────────────────
     WEEKLY LAYOUT 1: MODERN 4x2 BENTO CARD GRID (DEFAULT)
     ───────────────────────────────────────────────────────────────────────────── */
  .bento-schedule-wrap {
    width: 100%;
    user-select: none;
  }

  .bento-grid-container {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 0.85rem;
  }

  .bento-day-card {
    position: relative;
    background: var(--b-ticket-bg, var(--b-card));
    border: 1.5px solid var(--b-ticket-inner-border, var(--b-border));
    border-radius: 16px;
    padding: 0.95rem 1rem 0.85rem;
    min-height: 176px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    cursor: pointer;
    transition: transform 0.18s ease, border-color 0.18s ease, box-shadow 0.18s ease;
    box-shadow: 0 8px 22px rgba(0, 0, 0, 0.22);
    overflow: hidden;
  }

  .bento-day-card::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 3.5px;
    background: var(--card-status-color, var(--b-accent));
    opacity: 0.9;
  }

  .bento-day-card:hover {
    transform: translateY(-3px);
    border-color: var(--b-accent);
    box-shadow: 0 14px 28px rgba(0, 0, 0, 0.34);
  }

  .bento-day-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.4rem;
    margin-bottom: 0.65rem;
  }

  .bento-day-left {
    display: flex;
    align-items: baseline;
    gap: 0.4rem;
  }

  .bento-day-pill {
    font-size: 0.76rem;
    font-weight: 900;
    padding: 0.18rem 0.5rem;
    border-radius: 6px;
    background: var(--b-ribbon-bg);
    color: var(--b-ribbon-text);
    letter-spacing: 0.05em;
  }
  .bento-day-pill.is-sat {
    background: #38bdf8;
    color: #041322;
  }
  .bento-day-pill.is-sun {
    background: #fb7185;
    color: #26050c;
  }

  .bento-date-num {
    font-size: 0.86rem;
    font-weight: 800;
    color: var(--b-sub);
    font-variant-numeric: tabular-nums;
  }

  .bento-status-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.22rem;
    font-size: 0.68rem;
    font-weight: 800;
    padding: 0.18rem 0.48rem;
    border-radius: 999px;
    white-space: nowrap;
  }

  .bento-card-body {
    flex: 1;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 0.3rem;
    margin: 0.25rem 0 0.65rem;
  }

  .bento-stream-title {
    font-size: 1.04rem;
    font-weight: 800;
    line-height: 1.32;
    color: var(--b-ticket-title, var(--b-text));
    word-break: keep-all;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .bento-stream-memo {
    font-size: 0.76rem;
    font-weight: 600;
    line-height: 1.35;
    color: var(--b-ticket-memo, var(--b-sub));
    opacity: 0.9;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .bento-card-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-top: 0.55rem;
    border-top: 1px dashed var(--b-ticket-inner-border, var(--b-border));
  }

  .bento-time-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    font-size: 0.78rem;
    font-weight: 800;
    color: var(--b-ticket-time, var(--b-accent));
    font-variant-numeric: tabular-nums;
  }

  .bento-edit-icon {
    font-size: 0.72rem;
    opacity: 0;
    transition: opacity 0.15s ease;
    color: var(--b-sub);
  }
  .bento-day-card:hover .bento-edit-icon {
    opacity: 0.85;
  }
  .schedule-card-board.is-exporting-png .bento-edit-icon,
  .schedule-card-board.is-exporting-png .tl-edit-icon,
  .schedule-card-board.is-exporting-png .bp-ticket-edit-hint {
    display: none !important;
  }

  /* Rest Day (OFFLINE) Bento Card */
  .bento-day-card.is-off-day {
    background: var(--b-stub-bg, rgba(15, 23, 42, 0.55));
    border-style: dashed;
    opacity: 0.85;
  }
  .bento-day-card.is-off-day::before {
    background: #64748b;
    opacity: 0.5;
  }
  .bento-off-box {
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    gap: 0.25rem;
    padding: 0.5rem 0;
  }
  .bento-off-moon {
    font-size: 1.55rem;
    line-height: 1;
    margin-bottom: 0.1rem;
  }
  .bento-off-title {
    font-size: 0.92rem;
    font-weight: 900;
    letter-spacing: 0.08em;
    color: var(--b-sub);
  }
  .bento-off-sub {
    font-size: 0.72rem;
    font-weight: 600;
    color: var(--b-sub);
    opacity: 0.78;
  }

  /* 8th Slot: Weekly Summary & Highlight Card */
  .bento-summary-card {
    position: relative;
    background: linear-gradient(155deg, var(--b-card) 0%, var(--b-stub-bg) 100%);
    border: 1.5px solid var(--b-accent);
    border-radius: 16px;
    padding: 0.95rem 1rem 0.85rem;
    min-height: 176px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.28);
    overflow: hidden;
  }

  .bento-summary-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.4rem;
  }

  .bento-summary-tag {
    font-size: 0.68rem;
    font-weight: 900;
    letter-spacing: 0.08em;
    padding: 0.2rem 0.55rem;
    border-radius: 6px;
    background: var(--b-accent);
    color: var(--b-ribbon-text, #041c10);
    text-transform: uppercase;
  }

  .bento-summary-range {
    font-size: 0.74rem;
    font-weight: 800;
    color: var(--b-sub);
  }

  .bento-summary-stats {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 0.45rem;
    margin: 0.55rem 0;
  }

  .bento-stat-box {
    background: var(--b-ticket-bg);
    border: 1px solid var(--b-ticket-inner-border);
    border-radius: 10px;
    padding: 0.4rem 0.55rem;
    text-align: center;
  }

  .bento-stat-num {
    display: block;
    font-size: 1.05rem;
    font-weight: 900;
    color: var(--b-accent);
    line-height: 1.2;
  }

  .bento-stat-label {
    font-size: 0.66rem;
    font-weight: 700;
    color: var(--b-sub);
  }

  .bento-summary-foot {
    font-size: 0.72rem;
    font-weight: 700;
    color: var(--b-text);
    line-height: 1.35;
    padding-top: 0.45rem;
    border-top: 1px solid var(--b-ticket-inner-border);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  /* ─────────────────────────────────────────────────────────────────────────────
     WEEKLY LAYOUT 2: STREAMER PROFILE SHOWCASE + 7-DAY TIMELINE POSTER
     ───────────────────────────────────────────────────────────────────────────── */
  .timeline-schedule-wrap {
    width: 100%;
    user-select: none;
  }

  .timeline-split-container {
    display: grid;
    grid-template-columns: 300px minmax(0, 1fr);
    gap: 1.15rem;
    align-items: stretch;
  }

  .timeline-poster-col {
    background: linear-gradient(165deg, var(--b-ticket-bg) 0%, var(--b-stub-bg) 100%);
    border: 1.5px solid var(--b-border);
    border-radius: 18px;
    padding: 1.25rem 1.15rem;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 0.9rem;
    box-shadow: 0 12px 30px rgba(0, 0, 0, 0.28);
  }

  .poster-top-badges {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.4rem;
  }

  .poster-platform-pill {
    font-size: 0.68rem;
    font-weight: 900;
    padding: 0.2rem 0.55rem;
    border-radius: 6px;
    background: var(--b-accent);
    color: var(--b-ribbon-text, #041c10);
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }

  .poster-week-pill {
    font-size: 0.74rem;
    font-weight: 800;
    color: var(--b-accent);
    font-variant-numeric: tabular-nums;
  }

  .poster-avatar-showcase {
    width: 100%;
    height: 185px;
    border-radius: 14px;
    background: var(--b-card);
    border: 2px solid var(--b-accent);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 4.4rem;
    overflow: hidden;
    box-shadow: 0 10px 26px rgba(0, 0, 0, 0.3);
    position: relative;
  }

  .poster-avatar-showcase img.poster-custom-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .poster-channel-title {
    font-size: 1.35rem;
    font-weight: 900;
    color: var(--b-text);
    margin: 0.1rem 0 0.2rem;
    letter-spacing: -0.02em;
    line-height: 1.2;
  }

  .poster-channel-tagline {
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--b-sub);
    line-height: 1.4;
    margin: 0;
  }

  .poster-notice-box {
    background: var(--b-card);
    border: 1px solid var(--b-border);
    border-left: 3.5px solid var(--b-accent);
    border-radius: 10px;
    padding: 0.6rem 0.75rem;
    font-size: 0.78rem;
    font-weight: 700;
    color: var(--b-text);
    line-height: 1.4;
  }

  .poster-stats-row {
    display: flex;
    gap: 0.5rem;
  }

  .poster-stat-chip {
    flex: 1;
    background: var(--b-card);
    border: 1px solid var(--b-ticket-inner-border);
    border-radius: 9px;
    padding: 0.4rem 0.5rem;
    text-align: center;
    font-size: 0.72rem;
    font-weight: 800;
    color: var(--b-sub);
  }
  .poster-stat-chip strong {
    color: var(--b-accent);
    font-size: 0.86rem;
    margin-left: 0.2rem;
  }

  .timeline-days-col {
    display: flex;
    flex-direction: column;
    gap: 0.52rem;
    justify-content: space-between;
  }

  .timeline-day-row {
    position: relative;
    background: var(--b-ticket-bg, var(--b-card));
    border: 1.5px solid var(--b-ticket-inner-border, var(--b-border));
    border-radius: 13px;
    padding: 0.62rem 0.95rem 0.62rem 1.05rem;
    display: grid;
    grid-template-columns: 98px 128px 110px minmax(0, 1fr) auto;
    align-items: center;
    gap: 0.7rem;
    cursor: pointer;
    transition: transform 0.15s ease, border-color 0.15s ease, box-shadow 0.15s ease;
    box-shadow: 0 4px 14px rgba(0, 0, 0, 0.18);
    overflow: hidden;
  }

  .timeline-day-row::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 4.5px;
    background: var(--row-status-color, var(--b-accent));
  }

  .timeline-day-row:hover {
    transform: translateX(3px);
    border-color: var(--b-accent);
  }

  .timeline-day-row.is-off-day {
    background: var(--b-stub-bg);
    border-style: dashed;
    opacity: 0.82;
  }
  .timeline-day-row.is-off-day::before {
    background: #64748b;
  }

  .tl-day-col {
    display: flex;
    align-items: center;
    gap: 0.4rem;
  }

  .tl-day-pill {
    font-size: 0.72rem;
    font-weight: 900;
    padding: 0.16rem 0.44rem;
    border-radius: 5px;
    background: var(--b-ribbon-bg);
    color: var(--b-ribbon-text);
    min-width: 38px;
    text-align: center;
  }
  .tl-day-pill.is-sat { background: #38bdf8; color: #041322; }
  .tl-day-pill.is-sun { background: #fb7185; color: #26050c; }

  .tl-date-text {
    font-size: 0.82rem;
    font-weight: 800;
    color: var(--b-sub);
    font-variant-numeric: tabular-nums;
  }

  .tl-time-col {
    font-size: 0.78rem;
    font-weight: 800;
    color: var(--b-ticket-time, var(--b-accent));
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }

  .tl-status-chip {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.22rem;
    font-size: 0.68rem;
    font-weight: 800;
    padding: 0.2rem 0.5rem;
    border-radius: 999px;
    white-space: nowrap;
  }

  .tl-content-col {
    display: flex;
    align-items: baseline;
    gap: 0.55rem;
    min-width: 0;
    overflow: hidden;
  }

  .tl-stream-title {
    font-size: 0.95rem;
    font-weight: 800;
    color: var(--b-ticket-title, var(--b-text));
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .tl-stream-memo {
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--b-ticket-memo, var(--b-sub));
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    opacity: 0.88;
  }

  .tl-edit-icon {
    font-size: 0.72rem;
    opacity: 0;
    transition: opacity 0.15s ease;
  }
  .timeline-day-row:hover .tl-edit-icon {
    opacity: 0.85;
  }

  /* ─────────────────────────────────────────────────────────────────────────────
     WEEKLY LAYOUT 3: TRAVEL BOARDING PASS & VINTAGE TICKET STUDIO (1 + 3 + 3)
     ───────────────────────────────────────────────────────────────────────────── */
  .bp-schedule-wrap {
    display: flex;
    flex-direction: column;
    gap: 6px;
    user-select: none;
  }

  /* ROW 1: TOP SECTION (Keychain & Flight Gate on Left, MON Ticket on Right) */
  .bp-row-top {
    display: flex;
    gap: 10px;
    align-items: stretch;
  }

  .bp-top-left-panel {
    flex: 1;
    display: flex;
    gap: 12px;
    align-items: center;
    background: var(--b-card, rgba(255, 255, 255, 0.22));
    border: 1px solid var(--b-border, rgba(158, 178, 220, 0.45));
    border-radius: 12px;
    padding: 6px 12px;
    box-shadow: 0 4px 14px rgba(0, 0, 0, 0.15);
    transition: all 0.25s ease;
  }

  /* 1. Motel Keychain ("SCHEDULE") */
  .bp-keytag-unit {
    position: relative;
    display: flex;
    align-items: center;
    cursor: pointer;
    transition: transform 0.15s ease, filter 0.15s ease;
  }
  .bp-keytag-unit:hover {
    transform: translateY(-1px) scale(1.02);
    filter: brightness(1.06);
  }

  .bp-keytag-body {
    background: var(--b-keytag-bg, #5570a5);
    border-radius: 50px;
    padding: 7px 16px 7px 24px;
    box-shadow: 2px 6px 14px rgba(0, 0, 0, 0.28), inset 0 1px 1px rgba(255, 255, 255, 0.3);
    position: relative;
    transition: background 0.25s ease;
  }

  .bp-keytag-inner-bevel {
    border: 1.5px solid var(--b-keytag-border, #7c9bd1);
    border-radius: 40px;
    padding: 4px 12px 4px 16px;
    display: flex;
    align-items: center;
    position: relative;
    transition: border-color 0.25s ease;
  }

  .bp-keytag-hole {
    position: absolute;
    left: -10px;
    top: 50%;
    transform: translateY(-50%);
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background: #111827;
    box-shadow: inset 0 1px 2px rgba(0, 0, 0, 0.6);
  }

  .bp-keyring-loop {
    position: absolute;
    left: -22px;
    top: 50%;
    transform: translateY(-50%);
    width: 30px;
    height: 30px;
    border-radius: 50%;
    border: 3.5px solid #b8c4d4;
    box-shadow: 1px 2px 5px rgba(0, 0, 0, 0.25);
    pointer-events: none;
    z-index: 2;
  }

  .bp-silver-key-box {
    position: absolute;
    left: -26px;
    top: 6px;
    width: 110px;
    height: 36px;
    pointer-events: none;
    z-index: 3;
    transform: rotate(14deg);
    filter: drop-shadow(2px 5px 6px rgba(15, 23, 42, 0.35));
  }

  .bp-key-svg {
    width: 100%;
    height: 100%;
  }

  .bp-keytag-title {
    font-family: 'Georgia', 'Times New Roman', serif;
    font-weight: 900;
    font-size: 1.35rem;
    letter-spacing: 0.08em;
    color: var(--b-keytag-text, #1e2c47);
    text-shadow: 0 1px 0 var(--b-keytag-shadow, #9cb6e5);
    user-select: none;
    transition: color 0.25s ease, text-shadow 0.25s ease, font-size 0.2s ease;
    max-width: 175px;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  /* 2. Flight Board Gate Ticker ("DEP ✈ ARR") */
  .bp-flight-gate-card {
    background: var(--b-ticker-bg, #cfe4f5);
    border: 1.5px solid var(--b-ticker-border, #8ab6db);
    border-radius: 6px;
    padding: 4px 10px;
    display: flex;
    flex-direction: column;
    justify-content: center;
    box-shadow: 1px 3px 8px rgba(0, 0, 0, 0.18);
    min-width: 135px;
    margin-left: auto;
    transition: background 0.25s ease, border-color 0.25s ease;
  }

  .bp-flight-header-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    font-size: 0.65rem;
    font-weight: 800;
    color: var(--b-ticker-label, #55799c);
    letter-spacing: 0.12em;
    transition: color 0.25s ease;
  }

  .bp-f-icon {
    color: var(--b-ticker-label, #3b668f);
    font-size: 0.72rem;
  }

  .bp-flight-dates-display {
    font-family: 'Courier New', Courier, monospace, sans-serif;
    font-size: 1.02rem;
    font-weight: 900;
    color: var(--b-ticker-text, #214063) !important;
    text-align: center;
    margin-top: 2px;
    letter-spacing: 0.06em;
    transition: color 0.25s ease;
  }

  /* Top Right: Monday Ticket Container */
  .bp-mon-ticket-container {
    width: 250px;
    flex-shrink: 0;
    display: flex;
  }

  .bp-mon-ticket-container .bp-ticket-card {
    width: 100%;
    border: 1.5px solid var(--b-strip-border, #9eb2dc);
    border-radius: 8px;
    box-shadow: 2px 6px 16px rgba(0, 0, 0, 0.16);
  }

  /* TICKET STRIPS (Middle & Bottom Rows) */
  .bp-ticket-strip {
    background: var(--b-strip-bg, #f8fafc);
    border: 1.5px solid var(--b-strip-border, #9eb2dc);
    border-radius: 8px;
    display: flex;
    align-items: stretch;
    box-shadow: 2px 6px 16px rgba(0, 0, 0, 0.16);
    overflow: hidden;
    position: relative;
    transition: background 0.25s ease, border-color 0.25s ease;
  }

  /* Left Barcode Stub */
  .bp-strip-left-stub {
    width: 44px;
    flex-shrink: 0;
    background: var(--b-stub-bg, #eef3f9);
    border-right: 1.5px dashed var(--b-stub-border, #9eb2dc);
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
    padding: 6px 0;
    transition: background 0.25s ease, border-color 0.25s ease;
  }

  .bp-barcode-stub-content {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    transform: rotate(-90deg);
    white-space: nowrap;
  }

  .bp-barcode-number {
    font-family: 'Courier New', Courier, monospace;
    font-size: 0.62rem;
    font-weight: 800;
    color: var(--b-stub-text, #556c8e);
    letter-spacing: 0.12em;
    transition: color 0.25s ease;
  }

  .bp-barcode-lines {
    display: inline-flex;
    align-items: stretch;
    gap: 1.5px;
    height: 14px;
  }
  .bp-barcode-lines span {
    display: inline-block;
    width: 1.5px;
    background: var(--b-barcode, #465a78);
    transition: background 0.25s ease;
  }
  .bp-barcode-lines span:nth-child(2n) { width: 3px; }
  .bp-barcode-lines span:nth-child(3n) { width: 1px; }

  .bp-stripes-stub {
    width: 28px;
    height: 65px;
    transform: none;
    background: repeating-linear-gradient(
      -45deg,
      var(--b-barcode, #556c8e),
      var(--b-barcode, #556c8e) 4px,
      transparent 4px,
      transparent 9px
    );
    opacity: 0.7;
    border-radius: 2px;
    transition: background 0.25s ease;
  }

  .bp-stub-notches {
    position: absolute;
    top: 0;
    bottom: 0;
    right: 0;
    width: 0;
    height: 100%;
    pointer-events: none;
    z-index: 4;
  }

  .bp-notch {
    width: 14px;
    height: 14px;
    border-radius: 50%;
    background: var(--b-board-bg, #d2d7e2);
