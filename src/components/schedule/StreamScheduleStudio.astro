  function loadModernScreenshot(): Promise<any> {
    if ((window as any).modernScreenshot && (window as any).modernScreenshot.domToPng) {
      return Promise.resolve((window as any).modernScreenshot);
    }
    return new Promise(function (resolve, reject) {
      var script = document.createElement('script');
      script.src = 'https://cdn.jsdelivr.net/npm/modern-screenshot@4.6.0/dist/index.js';
      script.onload = function () {
        if ((window as any).modernScreenshot && (window as any).modernScreenshot.domToPng) {
          resolve((window as any).modernScreenshot);
        } else {
          reject(new Error('modernScreenshot not available'));
        }
      };
      script.onerror = function () {
        reject(new Error('Failed to load screenshot library'));
      };
      document.head.appendChild(script);
    });
  }

  function renderFallbackCanvasPng(weekObj: any): string {
    var canvas = document.createElement('canvas');
    canvas.width = 1600;
    canvas.height = 960;
    var ctx = canvas.getContext('2d')!;
    var theme = SCHEDULE_THEMES[state.themeId] || SCHEDULE_THEMES['travel-boarding-pass'] || { accent: '#00ffa3' };

    // Background
    var grad = ctx.createLinearGradient(0, 0, 1600, 960);
    grad.addColorStop(0, '#0f172a');
    grad.addColorStop(1, '#1e293b');
    ctx.fillStyle = grad;
    ctx.fillRect(0, 0, 1600, 960);

    // Header
    ctx.fillStyle = theme.accent || '#00ffa3';
    ctx.fillRect(60, 50, 1480, 6);

    ctx.fillStyle = '#f8fafc';
    ctx.font = 'bold 42px Pretendard, sans-serif';
    ctx.fillText((state.channel.avatarEmoji || '🎮') + ' ' + (state.channel.name || 'Stream Schedule'), 60, 118);

    ctx.fillStyle = '#94a3b8';
    ctx.font = '600 22px Pretendard, sans-serif';
    ctx.fillText(state.channel.tagline || '', 60, 156);

    ctx.fillStyle = theme.accent || '#00ffa3';
    ctx.font = 'bold 26px Pretendard, sans-serif';
    ctx.textAlign = 'right';
    ctx.fillText(state.monthly.year + '.' + state.monthly.month + ' ' + weekObj.label, 1540, 118);
    ctx.textAlign = 'left';

    // Notice banner
    var noticeStr = state.channel.noticeWeekly || state.channel.notice || '';
    if (noticeStr) {
      ctx.fillStyle = 'rgba(255, 255, 255, 0.07)';
      ctx.fillRect(60, 185, 1480, 54);
      ctx.fillStyle = '#e2e8f0';
      ctx.font = 'bold 22px Pretendard, sans-serif';
      ctx.fillText('📢 ' + noticeStr, 84, 220);
    }

    // 7 Days Grid
    var startY = 265;
    var rowH = 88;
    weekObj.days.forEach(function (d: any, idx: number) {
      var y = startY + idx * (rowH + 8);
      var entry = d.entry || {};
      var isOff = entry.status === 'off' || entry.title === 'OFFLINE';
      var badge = STATUS_BADGES[entry.status] || STATUS_BADGES.live;
      var dayTag = isEn ? d.dayEn : d.dayKo;
      var timeStr = formatDisplayTime(entry, isEn ? 'en' : 'ko') || entry.time || '20:00';
      var titleStr = isOff ? 'OFFLINE (휴방)' : (entry.title || (isEn ? 'Live Stream' : '방송 예정'));

      ctx.fillStyle = isOff ? 'rgba(15, 23, 42, 0.7)' : 'rgba(30, 41, 59, 0.92)';
      ctx.fillRect(60, y, 1480, rowH);

      ctx.fillStyle = isOff ? '#64748b' : (theme.accent || '#00ffa3');
      ctx.fillRect(60, y, 10, rowH);

      ctx.fillStyle = '#f8fafc';
      ctx.font = 'bold 26px Pretendard, sans-serif';
      ctx.fillText(d.dateStr + ' (' + dayTag + ')', 95, y + 54);

      ctx.fillStyle = isOff ? '#94a3b8' : '#38bdf8';
      ctx.font = 'bold 24px Pretendard, sans-serif';
      ctx.fillText(badge.icon + ' ' + timeStr, 310, y + 54);

      ctx.fillStyle = isOff ? '#64748b' : '#ffffff';
      ctx.font = 'bold 28px Pretendard, sans-serif';
      ctx.fillText(titleStr, 590, y + 52);

      if (!isOff && entry.memo) {
        ctx.fillStyle = '#94a3b8';
        ctx.font = '500 20px Pretendard, sans-serif';
        ctx.fillText('• ' + entry.memo, 1080, y + 52);
      }
    });

    return canvas.toDataURL('image/png');
  }

  if (btnExportPng) {
