---
import { SITE_TITLE } from '../consts';
---

<header class="arcade-header">
  <div class="header-inner">
    <div class="header-left">
      <a href="/" class="brand-link">
        <span class="brand-icon">🔴</span>
        <span class="brand-text-main">스트림</span><span class="brand-text-accent">아케이드</span>
      </a>
    </div>

    <nav class="header-nav">
      <a href="/games/marble-roulette" class="nav-item highlight">
        <span class="nav-icon">🔮</span>
        <span class="nav-label">구슬 룰렛</span>
      </a>
      <a href="/games/roulette" class="nav-item">
        <span class="nav-icon">🎡</span>
        <span class="nav-label">돌림판</span>
      </a>
      <a href="/games/ladder" class="nav-item">
        <span class="nav-icon">🪜</span>
        <span class="nav-label">사다리타기</span>
      </a>
      <a href="/games/cosmic-drop" class="nav-item">
        <span class="nav-icon">🪐</span>
        <span class="nav-label">수박게임</span>
      </a>
    </nav>

    <div class="header-actions">
      <button id="global-sound-toggle" class="action-btn" title="소리 켜기/끄기" aria-label="소리 켜기/끄기">
        <span id="sound-icon">🔊</span>
      </button>
    </div>
  </div>
</header>

<style>
  .arcade-header {
    background: rgba(15, 23, 42, 0.85);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    position: sticky;
    top: 0;
    z-index: 100;
    padding: 0.65rem 1rem;
  }

  .header-inner {
    max-width: 1280px;
    margin: 0 auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  .header-left {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .brand-link {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 1.35rem;
    font-weight: 800;
    text-decoration: none;
    letter-spacing: -0.02em;
  }

  .brand-icon {
    font-size: 1.4rem;
    filter: drop-shadow(0 0 8px rgba(168, 85, 247, 0.5));
  }

  .brand-text-main {
    color: #f8fafc;
  }

  .brand-text-accent {
    background: linear-gradient(135deg, #a855f7 0%, #38bdf8 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .header-nav {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .nav-item {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.4rem 0.75rem;
    border-radius: 8px;
    color: #cbd5e1;
    text-decoration: none;
    font-size: 0.88rem;
    font-weight: 600;
    transition: all 0.15s ease;
    border: 1px solid transparent;
  }

  .nav-item:hover {
    color: #ffffff;
    background: rgba(255, 255, 255, 0.08);
    border-color: rgba(255, 255, 255, 0.1);
  }

  .nav-item.highlight {
    background: rgba(168, 85, 247, 0.15);
    border-color: rgba(168, 85, 247, 0.3);
    color: #e9d5ff;
  }

  .nav-item.highlight:hover {
    background: rgba(168, 85, 247, 0.25);
    border-color: rgba(168, 85, 247, 0.5);
    color: #ffffff;
  }

  .header-actions {
    display: flex;
    align-items: center;
    gap: 0.4rem;
  }

  .action-btn {
    width: 36px;
    height: 36px;
    border-radius: 8px;
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid rgba(255, 255, 255, 0.1);
    color: #e2e8f0;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    font-size: 1rem;
    transition: all 0.15s ease;
  }

  .action-btn:hover {
    background: rgba(255, 255, 255, 0.12);
    border-color: rgba(255, 255, 255, 0.2);
    transform: scale(1.05);
  }

  @media (max-width: 640px) {
    .nav-label {
      display: none;
    }
    .badge-hot {
      display: none;
    }
    .nav-item {
      padding: 0.4rem 0.5rem;
      font-size: 1.1rem;
    }
  }
</style>

<script>
  // Client-side sound toggle
  const soundBtn = document.getElementById('global-sound-toggle');
  const soundIcon = document.getElementById('sound-icon');

  function updateSoundUI() {
    const muted = localStorage.getItem('aether_sound_muted') === 'true';
    if (soundIcon) soundIcon.textContent = muted ? '🔇' : '🔊';
  }

  if (soundBtn) {
    soundBtn.addEventListener('click', () => {
      const current = localStorage.getItem('aether_sound_muted') === 'true';
      localStorage.setItem('aether_sound_muted', String(!current));
      updateSoundUI();
    });
    updateSoundUI();
  }
</script>