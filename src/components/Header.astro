---
import { SITE_TITLE } from '../consts';
import { getLang, t, getAlternateUrl } from '../i18n';

const lang = getLang(Astro.url);
const isEn = lang === 'en';

const currentPath = Astro.url.pathname.replace(/\/$/, '') || '/';
const prefix = isEn ? '/en' : '';

// Determine where the language switcher links to
const alternateLang = isEn ? 'ko' : 'en';
const alternateUrl = getAlternateUrl(currentPath, alternateLang);
---

<header class="arcade-header">
  <div class="header-inner">
    <div class="header-left">
      <a href={isEn ? '/en' : '/'} class="brand-link">
        <span class="brand-icon">🔴</span>
        {isEn ? (
          <span class="brand-text-main">Error</span><span class="brand-text-accent">Ledger</span>
        ) : (
          <span class="brand-text-main">에러</span><span class="brand-text-accent">레저</span>
        )}
      </a>
    </div>

    <nav class="header-nav" aria-label="Main Navigation">
      <!-- 1. Games Dropdown -->
      <div class="nav-dropdown" data-dropdown="games">
        <button 
          type="button" 
          class={`nav-dropdown-btn ${currentPath.includes('/games/') ? 'active' : ''}`}
          aria-haspopup="true" 
          aria-expanded="false"
        >
          <span class="nav-icon">🎮</span>
          <span class="nav-label">{t(lang, 'nav.category.games')}</span>
          <span class="chevron-icon">▾</span>
        </button>

        <div class="dropdown-menu dropdown-menu-games" role="menu">
          <div class="dropdown-menu-inner">
            <div class="dropdown-header">
              <span class="dropdown-category-title">🎮 {isEn ? "INTERACTIVE GAMES" : "인기 인터랙티브 게임"}</span>
              <span class="dropdown-category-badge">{isEn ? "7 Games" : "7종 무료"}</span>
            </div>
            <div class="dropdown-grid-games">
              <a href={`${prefix}/games/marble-roulette`} class={`dropdown-item ${currentPath.includes('/games/marble-roulette') ? 'active' : ''}`}>
                <span class="dropdown-item-icon">🔮</span>
                <div class="dropdown-item-content">
                  <div class="dropdown-item-header">
                    <span class="dropdown-item-title">{t(lang, 'nav.marble')}</span>
                    <span class="dropdown-pill hot">HOT</span>
                  </div>
                  <span class="dropdown-item-desc">{isEn ? "3D Physics Racing" : "3D 물리 시뮬레이션 레이스"}</span>
                </div>
              </a>
              <a href={`${prefix}/games/roulette`} class={`dropdown-item ${currentPath.includes('/games/roulette') && !currentPath.includes('marble') ? 'active' : ''}`}>
                <span class="dropdown-item-icon">🎡</span>
                <div class="dropdown-item-content">
                  <span class="dropdown-item-title">{t(lang, 'nav.roulette')}</span>
                  <span class="dropdown-item-desc">{isEn ? "Custom Wheel Spinner" : "확률 커스텀 돌림판"}</span>
                </div>
              </a>
              <a href={`${prefix}/games/ladder`} class={`dropdown-item ${currentPath.includes('/games/ladder') ? 'active' : ''}`}>
                <span class="dropdown-item-icon">🪜</span>
                <div class="dropdown-item-content">
                  <span class="dropdown-item-title">{t(lang, 'nav.ladder')}</span>
                  <span class="dropdown-item-desc">{isEn ? "Ghost Leg Match" : "복불복 사다리타기"}</span>
                </div>
              </a>
              <a href={`${prefix}/games/drinking-marble`} class={`dropdown-item ${currentPath.includes('/games/drinking-marble') ? 'active' : ''}`}>
                <span class="dropdown-item-icon">🌸</span>
                <div class="dropdown-item-content">
                  <span class="dropdown-item-title">{t(lang, 'nav.drinking_marble')}</span>
                  <span class="dropdown-item-desc">{isEn ? "Drinking & Board Game" : "주류마블 파티 보드게임"}</span>
                </div>
              </a>
              <a href={`${prefix}/games/stream-doodle`} class={`dropdown-item ${currentPath.includes('/games/stream-doodle') ? 'active' : ''}`}>
                <span class="dropdown-item-icon">🎨</span>
                <div class="dropdown-item-content">
                  <span class="dropdown-item-title">{t(lang, 'nav.stream_doodle')}</span>
                  <span class="dropdown-item-desc">{isEn ? "Animated GIF Doodle" : "움직이는 GIF 낙서장"}</span>
                </div>
              </a>
              <a href={`${prefix}/games/stream-emoji`} class={`dropdown-item ${currentPath.includes('/games/stream-emoji') ? 'active' : ''}`}>
                <span class="dropdown-item-icon">🎬</span>
                <div class="dropdown-item-content">
                  <span class="dropdown-item-title">{t(lang, 'nav.stream_emoji')}</span>
                  <span class="dropdown-item-desc">{isEn ? "Animated Emote Studio" : "움직이는 이모티콘 메이커"}</span>
                </div>
              </a>
              <a href={`${prefix}/games/ai-music-quiz`} class={`dropdown-item ${currentPath.includes('/games/ai-music-quiz') ? 'active' : ''}`}>
                <span class="dropdown-item-icon">🎧</span>
                <div class="dropdown-item-content">
                  <div class="dropdown-item-header">
                    <span class="dropdown-item-title">{t(lang, 'nav.ai_music_quiz')}</span>
                    <span class="dropdown-pill new">AI</span>
                  </div>
                  <span class="dropdown-item-desc">{isEn ? "Guess Song from AI Cover" : "AI 편곡 노래 맞추기 퀴즈"}</span>
                </div>
              </a>
            </div>
          </div>
        </div>
      </div>

      <!-- 2. Tests & Fortune Dropdown -->
      <div class="nav-dropdown" data-dropdown="tests">
        <button 
          type="button" 
          class={`nav-dropdown-btn ${currentPath.includes('/mbti') || currentPath.endsWith('/fortune') ? 'active' : ''}`}
          aria-haspopup="true" 
          aria-expanded="false"
        >
          <span class="nav-icon">🧠</span>
          <span class="nav-label">{t(lang, 'nav.category.tests')}</span>
          <span class="chevron-icon">▾</span>
        </button>

        <div class="dropdown-menu dropdown-menu-tests" role="menu">
          <div class="dropdown-menu-inner">
            <div class="dropdown-header">
              <span class="dropdown-category-title">🧠 {isEn ? "TESTS & FORTUNE" : "심리 검사 & 운세"}</span>
            </div>
            <div class="dropdown-list">
              <a href={`${prefix}/mbti`} class={`dropdown-item ${currentPath.includes('/mbti') ? 'active' : ''}`}>
                <span class="dropdown-item-icon">🧠</span>
                <div class="dropdown-item-content">
                  <div class="dropdown-item-header">
                    <span class="dropdown-item-title">{t(lang, 'nav.mbti')}</span>
                    <span class="dropdown-pill popular">{isEn ? "Detailed" : "정밀 60제"}</span>
                  </div>
                  <span class="dropdown-item-desc">{isEn ? "16 Personality Test" : "16가지 성격유형 정밀 검사"}</span>
                </div>
              </a>
              <a href={`${prefix}/fortune`} class={`dropdown-item ${currentPath.endsWith('/fortune') ? 'active' : ''}`}>
                <span class="dropdown-item-icon">✨</span>
                <div class="dropdown-item-content">
                  <span class="dropdown-item-title">{t(lang, 'nav.fortune')}</span>
                  <span class="dropdown-item-desc">{isEn ? "Daily Zodiac & Stars" : "오늘의 띠별·별자리 운세"}</span>
                </div>
              </a>
            </div>
          </div>
        </div>
      </div>

      <!-- 3. Stream Utilities Dropdown (HIGHLIGHTED) -->
      <div class="nav-dropdown nav-dropdown-highlight" data-dropdown="tools">
        <button 
          type="button" 
          class={`nav-dropdown-btn btn-highlight ${currentPath.includes('/schedule') || currentPath.includes('/bzzk') || currentPath.includes('/chzzk-downloader') ? 'active' : ''}`}
          aria-haspopup="true" 
          aria-expanded="false"
        >
          <span class="nav-icon">🛠️</span>
          <span class="nav-label">{isEn ? "Stream Tools" : "방송 유틸리티"}</span>
          <span class="pulse-indicator"></span>
          <span class="chevron-icon">▾</span>
        </button>

        <div class="dropdown-menu dropdown-menu-tools" role="menu">
          <div class="dropdown-menu-inner">
            <div class="dropdown-header">
              <span class="dropdown-category-title">🛠️ {isEn ? "STREAM UTILITIES" : "스트리머 필수 방송 도구"}</span>
              <span class="dropdown-category-badge highlight">{isEn ? "Suite" : "무설치 스튜디오"}</span>
            </div>
            <div class="dropdown-list">
              <a href={`${prefix}/chzzk-downloader`} class={`dropdown-item ${currentPath.includes('/chzzk-downloader') ? 'active' : ''}`}>
                <span class="dropdown-item-icon green-glow">📥</span>
                <div class="dropdown-item-content">
                  <div class="dropdown-item-header">
                    <span class="dropdown-item-title chzzk-title">{t(lang, 'nav.chzzk_downloader')}</span>
                    <span class="dropdown-pill chzzk-new">NEW</span>
                  </div>
                  <span class="dropdown-item-desc">{isEn ? "1080p Lossless VOD & Clip MP4" : "치지직 다시보기·클립 원본 고속 다운로드"}</span>
                </div>
              </a>
              <a href={`${prefix}/schedule`} class={`dropdown-item ${currentPath.includes('/schedule') ? 'active' : ''}`}>
                <span class="dropdown-item-icon cyan-glow">📅</span>
                <div class="dropdown-item-content">
                  <div class="dropdown-item-header">
                    <span class="dropdown-item-title">{t(lang, 'nav.schedule')}</span>
                    <span class="dropdown-pill popular">HOT</span>
                  </div>
                  <span class="dropdown-item-desc">{isEn ? "Weekly Broadcast Schedule Studio" : "주간/월간 방송 편성표 템플릿 메이커"}</span>
                </div>
              </a>
              <a href={`${prefix}/bzzk`} class={`dropdown-item ${currentPath.includes('/bzzk') ? 'active' : ''}`}>
                <span class="dropdown-item-icon purple-glow">🛡️</span>
                <div class="dropdown-item-content">
                  <div class="dropdown-item-header">
                    <span class="dropdown-item-title">{t(lang, 'nav.bzzk')}</span>
                    <span class="dropdown-pill live">LIVE</span>
                  </div>
                  <span class="dropdown-item-desc">{isEn ? "Real-time Chat Security Radar" : "치지직 실시간 악성 유저 사전 방어"}</span>
                </div>
              </a>
            </div>
          </div>
        </div>
      </div>
    </nav>

    <div class="header-actions">

      <button id="global-sound-toggle" class="action-btn" title={t(lang, 'nav.sound.off')} aria-label={t(lang, 'nav.sound.off')}>
        <span id="sound-icon">🔊</span>
      </button>
      <!-- Language Switcher -->
      <a 
        href={alternateUrl} 
        class="action-btn lang-btn" 
        title={t(lang, 'nav.lang.title')}
        aria-label={t(lang, 'nav.lang.title')}
        id="lang-switcher"
      >
        {t(lang, 'nav.lang.label')}
      </a>

      <!-- Mobile Menu Toggle (Hamburger) -->
      <button 
        id="mobile-menu-toggle" 
        class="action-btn mobile-menu-btn" 
        title={isEn ? "Open Menu" : "메뉴 열기"} 
        aria-label={isEn ? "Open Menu" : "메뉴 열기"}
        aria-expanded="false"
        aria-controls="mobile-drawer"
      >
        <span class="hamburger-icon">☰</span>
      </button>
    </div>
  </div>

  <!-- Mobile Navigation Drawer Backdrop & Panel -->
  <div id="mobile-drawer-backdrop" class="drawer-backdrop" aria-hidden="true"></div>
  <aside id="mobile-drawer" class="mobile-drawer" aria-hidden="true" role="dialog" aria-modal="true" aria-label={isEn ? "Mobile Navigation" : "모바일 메뉴"}>
    <div class="drawer-header">
      <a href={isEn ? '/en' : '/'} class="drawer-brand">
        <span class="brand-icon">🔴</span>
        {isEn ? (
          <span class="brand-text-main">Error</span><span class="brand-text-accent">Ledger</span>
        ) : (
          <span class="brand-text-main">에러</span><span class="brand-text-accent">레저</span>
        )}
      </a>
      <button id="mobile-drawer-close" class="action-btn drawer-close-btn" aria-label={isEn ? "Close Menu" : "메뉴 닫기"}>
        ✕
      </button>
    </div>

    <div class="drawer-content">
      <!-- 1. Games -->
      <div class="drawer-section">
        <div class="drawer-section-title">{isEn ? "🎮 GAMES" : "🎮 인기 게임"}</div>
        <div class="drawer-nav-list">
          <a 
            href={`${prefix}/games/marble-roulette`} 
            class={`drawer-nav-item ${currentPath.includes('/games/marble-roulette') ? 'active' : ''}`}
          >
            <span class="drawer-item-icon">🔮</span>
            <div class="drawer-item-info">
              <span class="drawer-item-name">{t(lang, 'nav.marble')}</span>
              <span class="drawer-item-desc">{isEn ? "3D Physics Racing" : "3D 물리 시뮬레이션 레이스"}</span>
            </div>
          </a>
          <a 
            href={`${prefix}/games/roulette`} 
            class={`drawer-nav-item ${currentPath.includes('/games/roulette') && !currentPath.includes('marble') ? 'active' : ''}`}
          >
            <span class="drawer-item-icon">🎡</span>
            <div class="drawer-item-info">
              <span class="drawer-item-name">{t(lang, 'nav.roulette')}</span>
              <span class="drawer-item-desc">{isEn ? "Custom Wheel Spinner" : "확률 커스텀 돌림판"}</span>
            </div>
          </a>
          <a 
            href={`${prefix}/games/ladder`} 
            class={`drawer-nav-item ${currentPath.includes('/games/ladder') ? 'active' : ''}`}
          >
            <span class="drawer-item-icon">🪜</span>
            <div class="drawer-item-info">
              <span class="drawer-item-name">{t(lang, 'nav.ladder')}</span>
              <span class="drawer-item-desc">{isEn ? "Ghost Leg Match" : "복불복 사다리타기"}</span>
            </div>
          </a>
          <a 
            href={`${prefix}/games/drinking-marble`} 
            class={`drawer-nav-item ${currentPath.includes('/games/drinking-marble') ? 'active' : ''}`}
          >
            <span class="drawer-item-icon">🌸</span>
            <div class="drawer-item-info">
              <span class="drawer-item-name">{t(lang, 'nav.drinking_marble')}</span>
              <span class="drawer-item-desc">{isEn ? "Drinking & Board Game" : "주류마블 파티 보드게임"}</span>
            </div>
          </a>
          <a 
            href={`${prefix}/games/stream-doodle`} 
            class={`drawer-nav-item ${currentPath.includes('/games/stream-doodle') ? 'active' : ''}`}
          >
            <span class="drawer-item-icon">🎨</span>
            <div class="drawer-item-info">
              <span class="drawer-item-name">{t(lang, 'nav.stream_doodle')}</span>
              <span class="drawer-item-desc">{isEn ? "Animated GIF Doodle" : "움직이는 GIF 낙서장"}</span>
            </div>
          </a>
          <a 
            href={`${prefix}/games/stream-emoji`} 
            class={`drawer-nav-item ${currentPath.includes('/games/stream-emoji') ? 'active' : ''}`}
          >
            <span class="drawer-item-icon">🎬</span>
            <div class="drawer-item-info">
              <span class="drawer-item-name">{t(lang, 'nav.stream_emoji')}</span>
              <span class="drawer-item-desc">{isEn ? "Animated Emote Studio" : "움직이는 이모티콘 메이커"}</span>
            </div>
          </a>
          <a 
            href={`${prefix}/games/ai-music-quiz`} 
            class={`drawer-nav-item ${currentPath.includes('/games/ai-music-quiz') ? 'active' : ''}`}
          >
            <span class="drawer-item-icon">🎧</span>
            <div class="drawer-item-info">
              <span class="drawer-item-name">{t(lang, 'nav.ai_music_quiz')}</span>
              <span class="drawer-item-desc">{isEn ? "Guess The Song From AI Cover" : "AI 편곡 노래 맞추기 퀴즈"}</span>
            </div>
          </a>
        </div>
      </div>

      <!-- 2. Tests & Fortune -->
      <div class="drawer-section">
        <div class="drawer-section-title">{isEn ? "🧠 TESTS & FORTUNE" : "🧠 심리·운세"}</div>
        <div class="drawer-nav-list">
          <a 
            href={`${prefix}/mbti`} 
            class={`drawer-nav-item ${currentPath.includes('/mbti') ? 'active' : ''}`}
          >
            <span class="drawer-item-icon">🧠</span>
            <div class="drawer-item-info">
              <span class="drawer-item-name">{t(lang, 'nav.mbti')}</span>
              <span class="drawer-item-desc">{isEn ? "16 Personality Test" : "16가지 성격유형 정밀 검사"}</span>
            </div>
          </a>
          <a 
            href={`${prefix}/fortune`} 
            class={`drawer-nav-item ${currentPath.endsWith('/fortune') ? 'active' : ''}`}
          >
            <span class="drawer-item-icon">✨</span>
            <div class="drawer-item-info">
              <span class="drawer-item-name">{t(lang, 'nav.fortune')}</span>
              <span class="drawer-item-desc">{isEn ? "Daily Zodiac & Stars" : "오늘의 띠별·별자리 운세"}</span>
            </div>
          </a>
        </div>
      </div>

      <!-- 3. Tools -->
      <div class="drawer-section">
        <div class="drawer-section-title">{isEn ? "🛠️ BROADCAST TOOLS" : "🛠️ 방송 유틸리티"}</div>
        <div class="drawer-nav-list">
          <a 
            href={`${prefix}/schedule`} 
            class={`drawer-nav-item ${currentPath.includes('/schedule') ? 'active' : ''}`}
          >
            <span class="drawer-item-icon">📅</span>
            <div class="drawer-item-info">
              <span class="drawer-item-name">{t(lang, 'nav.schedule')}</span>
              <span class="drawer-item-desc">{isEn ? "Weekly Broadcast Schedule" : "주간 방송 편성표 스튜디오"}</span>
            </div>
          </a>
          <a 
            href={`${prefix}/bzzk`} 
            class={`drawer-nav-item ${currentPath.includes('/bzzk') ? 'active' : ''}`}
          >
            <span class="drawer-item-icon">🛡️</span>
            <div class="drawer-item-info">
              <span class="drawer-item-name">{t(lang, 'nav.bzzk')}</span>
              <span class="drawer-item-desc">{isEn ? "Stream Security Radar" : "치지직 방송 검지직 레이더"}</span>
            </div>
          </a>
          <a 
            href={`${prefix}/chzzk-downloader`} 
            class={`drawer-nav-item ${currentPath.includes('/chzzk-downloader') ? 'active' : ''}`}
          >
            <span class="drawer-item-icon">📥</span>
            <div class="drawer-item-info">
              <span class="drawer-item-name">{t(lang, 'nav.chzzk_downloader')}</span>
              <span class="drawer-item-desc">{isEn ? "VOD & Clip MP4 Downloader" : "치지직 다시보기·클립 다운로더"}</span>
            </div>
          </a>
        </div>
      </div>
    </div>

    <!-- Drawer Footer -->
    <div class="drawer-footer">
      <a href={alternateUrl} class="drawer-lang-btn">
        <span>🌐</span> {isEn ? "한국어로 변경 (KO)" : "English (EN)"}
      </a>
    </div>
  </aside>
</header>

<style>
  .arcade-header {
    background: rgba(15, 23, 42, 0.88);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    position: sticky;
    top: 0;
    z-index: 100;
    padding: 0.45rem 1rem;
  }

  .header-inner {
    max-width: 100%;
    margin: 0 auto;
    padding: 0 0.5rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
  }

  .header-left {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex-shrink: 0;
  }

  .brand-link {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    font-size: 1.18rem;
    font-weight: 800;
    text-decoration: none;
    letter-spacing: -0.02em;
    white-space: nowrap;
    flex-shrink: 0;
  }

  .brand-icon {
    font-size: 1.25rem;
    filter: drop-shadow(0 0 8px rgba(168, 85, 247, 0.5));
  }

  .brand-text-main {
    color: #f8fafc;
  }

  .brand-text-accent {
    background: linear-gradient(135deg, #a855f7 0%, #38bdf8 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .header-nav {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .nav-dropdown {
    position: relative;
  }

  .nav-dropdown-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.42rem 0.8rem;
    border-radius: 9px;
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.08);
    color: #e2e8f0;
    font-size: 0.86rem;
    font-weight: 700;
    cursor: pointer;
    transition: all 0.18s ease;
    user-select: none;
    line-height: 1;
    white-space: nowrap;
  }

  .nav-dropdown-btn:hover,
  .nav-dropdown:hover .nav-dropdown-btn,
  .nav-dropdown.open .nav-dropdown-btn {
    background: rgba(255, 255, 255, 0.1);
    border-color: rgba(255, 255, 255, 0.2);
    color: #ffffff;
  }

  .nav-dropdown-btn.active {
    background: rgba(168, 85, 247, 0.18);
    border-color: rgba(168, 85, 247, 0.4);
    color: #f3e8ff;
  }

  .nav-dropdown-btn.btn-highlight {
    background: linear-gradient(135deg, rgba(0, 255, 163, 0.1) 0%, rgba(56, 189, 248, 0.1) 100%);
    border-color: rgba(0, 255, 163, 0.35);
    color: #f1f5f9;
  }

  .nav-dropdown-btn.btn-highlight:hover,
  .nav-dropdown.nav-dropdown-highlight:hover .nav-dropdown-btn,
  .nav-dropdown.nav-dropdown-highlight.open .nav-dropdown-btn {
