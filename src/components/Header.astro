---
import { SITE_TITLE } from '../consts';
import { getLang, t, getAlternateUrl } from '../i18n';

const lang = getLang(Astro.url);
const isEn = lang === 'en';

const currentPath = Astro.url.pathname.replace(/\/$/, '') || '/';
const prefix = isEn ? '/en' : '';

// Determine where the language switcher links to
const alternateLang = isEn ? 'ko' : 'en';
const alternateUrl = getAlternateUrl(currentPath, alternateLang);
---

<header class="arcade-header">
  <div class="header-inner">
    <div class="header-left">
      <a href={isEn ? '/en' : '/'} class="brand-link">
        <span class="brand-icon">🔴</span>
        {isEn ? (
          <span class="brand-text-main">Stream</span><span class="brand-text-accent">Arcade</span>
        ) : (
          <span class="brand-text-main">스트림</span><span class="brand-text-accent">아케이드</span>
        )}
      </a>
    </div>

    <nav class="header-nav" aria-label="Main Navigation">
      <!-- 1. Games (게임) -->
      <div class="nav-category-group nav-group-games" title={isEn ? "Games" : "게임"}>
        <a 
          href={`${prefix}/games/marble-roulette`} 
          class={`nav-item ${currentPath.includes('/games/marble-roulette') ? 'highlight active' : ''}`}
          aria-current={currentPath.includes('/games/marble-roulette') ? 'page' : undefined}
        >
          <span class="nav-icon">🔮</span>
          <span class="nav-label">{t(lang, 'nav.marble')}</span>
        </a>
        <a 
          href={`${prefix}/games/roulette`} 
          class={`nav-item ${currentPath.includes('/games/roulette') && !currentPath.includes('marble') ? 'highlight active' : ''}`}
          aria-current={currentPath.includes('/games/roulette') && !currentPath.includes('marble') ? 'page' : undefined}
        >
          <span class="nav-icon">🎡</span>
          <span class="nav-label">{t(lang, 'nav.roulette')}</span>
        </a>
        <a 
          href={`${prefix}/games/ladder`} 
          class={`nav-item ${currentPath.includes('/games/ladder') ? 'highlight active' : ''}`}
          aria-current={currentPath.includes('/games/ladder') ? 'page' : undefined}
        >
          <span class="nav-icon">🪜</span>
          <span class="nav-label">{t(lang, 'nav.ladder')}</span>
        </a>
        <a 
          href={`${prefix}/games/drinking-marble`} 
          class={`nav-item ${currentPath.includes('/games/drinking-marble') ? 'highlight active' : ''}`}
          aria-current={currentPath.includes('/games/drinking-marble') ? 'page' : undefined}
        >
          <span class="nav-icon">🌸</span>
          <span class="nav-label">{t(lang, 'nav.drinking_marble')}</span>
        </a>
        <a 
          href={`${prefix}/games/stream-doodle`} 
          class={`nav-item ${currentPath.includes('/games/stream-doodle') ? 'highlight active' : ''}`}
          aria-current={currentPath.includes('/games/stream-doodle') ? 'page' : undefined}
        >
          <span class="nav-icon">🎨</span>
          <span class="nav-label">{t(lang, 'nav.stream_doodle')}</span>
        </a>
      </div>

      <div class="nav-divider" aria-hidden="true"></div>

      <!-- 2. Tests & Fortune (심리·운세) -->
      <div class="nav-category-group nav-group-tests" title={isEn ? "Tests & Fortune" : "심리·운세"}>
        <a 
          href={`${prefix}/mbti`} 
          class={`nav-item ${currentPath.includes('/mbti') ? 'highlight active' : ''}`}
          aria-current={currentPath.includes('/mbti') ? 'page' : undefined}
        >
          <span class="nav-icon">🧠</span>
          <span class="nav-label">{t(lang, 'nav.mbti')}</span>
        </a>
        <a 
          href={`${prefix}/fortune`} 
          class={`nav-item ${currentPath.endsWith('/fortune') ? 'highlight active' : ''}`}
          aria-current={currentPath.endsWith('/fortune') ? 'page' : undefined}
        >
          <span class="nav-icon">✨</span>
          <span class="nav-label">{t(lang, 'nav.fortune')}</span>
        </a>
      </div>

      <div class="nav-divider" aria-hidden="true"></div>

      <!-- 3. Stream Utilities (방송 도구) -->
      <div class="nav-category-group nav-group-tools" title={isEn ? "Stream Tools" : "방송 유틸리티"}>
        <a 
          href={`${prefix}/schedule`} 
          class={`nav-item ${currentPath.includes('/schedule') ? 'highlight active' : ''}`}
          aria-current={currentPath.includes('/schedule') ? 'page' : undefined}
        >
          <span class="nav-icon">📅</span>
          <span class="nav-label">{t(lang, 'nav.schedule')}</span>
        </a>
        <a 
          href={`${prefix}/bzzk`} 
          class={`nav-item ${currentPath.includes('/bzzk') ? 'highlight active' : ''}`}
          aria-current={currentPath.includes('/bzzk') ? 'page' : undefined}
        >
          <span class="nav-icon">🛡️</span>
          <span class="nav-label">{t(lang, 'nav.bzzk')}</span>
        </a>
      </div>
    </nav>

    <div class="header-actions">
      <!-- Hide Ads Button (page-only, resets on navigation) -->
      <button 
        id="page-ad-toggle" 
        class="action-btn ad-toggle-btn" 
        title={isEn ? "Hide ads on this page" : "이 페이지 광고 숨기기"} 
        aria-label={isEn ? "Hide Ads" : "광고 숨기기"}
      >
        <span class="ad-toggle-icon">🚫</span>
        <span class="ad-toggle-text">{isEn ? "Hide Ads" : "광고 숨기기"}</span>
      </button>

      <button id="global-sound-toggle" class="action-btn" title={t(lang, 'nav.sound.off')} aria-label={t(lang, 'nav.sound.off')}>
        <span id="sound-icon">🔊</span>
      </button>
      <!-- Language Switcher -->
      <a 
        href={alternateUrl} 
        class="action-btn lang-btn" 
        title={t(lang, 'nav.lang.title')}
        aria-label={t(lang, 'nav.lang.title')}
        id="lang-switcher"
      >
        {t(lang, 'nav.lang.label')}
      </a>

      <!-- Mobile Menu Toggle (Hamburger) -->
      <button 
        id="mobile-menu-toggle" 
        class="action-btn mobile-menu-btn" 
        title={isEn ? "Open Menu" : "메뉴 열기"} 
        aria-label={isEn ? "Open Menu" : "메뉴 열기"}
        aria-expanded="false"
        aria-controls="mobile-drawer"
      >
        <span class="hamburger-icon">☰</span>
      </button>
    </div>
  </div>

  <!-- Mobile Navigation Drawer Backdrop & Panel -->
  <div id="mobile-drawer-backdrop" class="drawer-backdrop" aria-hidden="true"></div>
  <aside id="mobile-drawer" class="mobile-drawer" aria-hidden="true" role="dialog" aria-modal="true" aria-label={isEn ? "Mobile Navigation" : "모바일 메뉴"}>
    <div class="drawer-header">
      <a href={isEn ? '/en' : '/'} class="drawer-brand">
        <span class="brand-icon">🔴</span>
        {isEn ? (
          <span class="brand-text-main">Stream</span><span class="brand-text-accent">Arcade</span>
        ) : (
          <span class="brand-text-main">스트림</span><span class="brand-text-accent">아케이드</span>
        )}
      </a>
      <button id="mobile-drawer-close" class="action-btn drawer-close-btn" aria-label={isEn ? "Close Menu" : "메뉴 닫기"}>
        ✕
      </button>
    </div>

    <div class="drawer-content">
      <!-- 1. Games -->
      <div class="drawer-section">
        <div class="drawer-section-title">{isEn ? "🎮 GAMES" : "🎮 인기 게임"}</div>
        <div class="drawer-nav-list">
          <a 
            href={`${prefix}/games/marble-roulette`} 
            class={`drawer-nav-item ${currentPath.includes('/games/marble-roulette') ? 'active' : ''}`}
          >
            <span class="drawer-item-icon">🔮</span>
            <div class="drawer-item-info">
              <span class="drawer-item-name">{t(lang, 'nav.marble')}</span>
              <span class="drawer-item-desc">{isEn ? "3D Physics Racing" : "3D 물리 시뮬레이션 레이스"}</span>
            </div>
          </a>
          <a 
            href={`${prefix}/games/roulette`} 
            class={`drawer-nav-item ${currentPath.includes('/games/roulette') && !currentPath.includes('marble') ? 'active' : ''}`}
          >
            <span class="drawer-item-icon">🎡</span>
            <div class="drawer-item-info">
              <span class="drawer-item-name">{t(lang, 'nav.roulette')}</span>
              <span class="drawer-item-desc">{isEn ? "Custom Wheel Spinner" : "확률 커스텀 돌림판"}</span>
            </div>
          </a>
          <a 
            href={`${prefix}/games/ladder`} 
            class={`drawer-nav-item ${currentPath.includes('/games/ladder') ? 'active' : ''}`}
          >
            <span class="drawer-item-icon">🪜</span>
            <div class="drawer-item-info">
              <span class="drawer-item-name">{t(lang, 'nav.ladder')}</span>
              <span class="drawer-item-desc">{isEn ? "Ghost Leg Match" : "복불복 사다리타기"}</span>
            </div>
          </a>
          <a 
            href={`${prefix}/games/drinking-marble`} 
            class={`drawer-nav-item ${currentPath.includes('/games/drinking-marble') ? 'active' : ''}`}
          >
            <span class="drawer-item-icon">🌸</span>
            <div class="drawer-item-info">
              <span class="drawer-item-name">{t(lang, 'nav.drinking_marble')}</span>
              <span class="drawer-item-desc">{isEn ? "Drinking & Board Game" : "주류마블 파티 보드게임"}</span>
            </div>
          </a>
          <a 
            href={`${prefix}/games/stream-doodle`} 
            class={`drawer-nav-item ${currentPath.includes('/games/stream-doodle') ? 'active' : ''}`}
          >
            <span class="drawer-item-icon">🎨</span>
            <div class="drawer-item-info">
              <span class="drawer-item-name">{t(lang, 'nav.stream_doodle')}</span>
              <span class="drawer-item-desc">{isEn ? "Animated GIF Doodle" : "움직이는 GIF 낙서장"}</span>
            </div>
          </a>
        </div>
      </div>

      <!-- 2. Tests & Fortune -->
      <div class="drawer-section">
        <div class="drawer-section-title">{isEn ? "🧠 TESTS & FORTUNE" : "🧠 심리·운세"}</div>
        <div class="drawer-nav-list">
          <a 
            href={`${prefix}/mbti`} 
            class={`drawer-nav-item ${currentPath.includes('/mbti') ? 'active' : ''}`}
          >
            <span class="drawer-item-icon">🧠</span>
            <div class="drawer-item-info">
              <span class="drawer-item-name">{t(lang, 'nav.mbti')}</span>
              <span class="drawer-item-desc">{isEn ? "16 Personality Test" : "16가지 성격유형 정밀 검사"}</span>
            </div>
          </a>
          <a 
            href={`${prefix}/fortune`} 
            class={`drawer-nav-item ${currentPath.endsWith('/fortune') ? 'active' : ''}`}
          >
            <span class="drawer-item-icon">✨</span>
            <div class="drawer-item-info">
              <span class="drawer-item-name">{t(lang, 'nav.fortune')}</span>
              <span class="drawer-item-desc">{isEn ? "Daily Zodiac & Stars" : "오늘의 띠별·별자리 운세"}</span>
            </div>
          </a>
        </div>
      </div>

      <!-- 3. Tools -->
      <div class="drawer-section">
        <div class="drawer-section-title">{isEn ? "🛠️ BROADCAST TOOLS" : "🛠️ 방송 유틸리티"}</div>
        <div class="drawer-nav-list">
          <a 
            href={`${prefix}/schedule`} 
            class={`drawer-nav-item ${currentPath.includes('/schedule') ? 'active' : ''}`}
          >
            <span class="drawer-item-icon">📅</span>
            <div class="drawer-item-info">
              <span class="drawer-item-name">{t(lang, 'nav.schedule')}</span>
              <span class="drawer-item-desc">{isEn ? "Weekly Broadcast Schedule" : "주간 방송 편성표 스튜디오"}</span>
            </div>
          </a>
          <a 
            href={`${prefix}/bzzk`} 
            class={`drawer-nav-item ${currentPath.includes('/bzzk') ? 'active' : ''}`}
          >
            <span class="drawer-item-icon">🛡️</span>
            <div class="drawer-item-info">
              <span class="drawer-item-name">{t(lang, 'nav.bzzk')}</span>
              <span class="drawer-item-desc">{isEn ? "Stream Security Radar" : "치지직 방송 검지직 레이더"}</span>
            </div>
          </a>
        </div>
      </div>
    </div>

    <!-- Drawer Footer -->
    <div class="drawer-footer">
      <a href={alternateUrl} class="drawer-lang-btn">
        <span>🌐</span> {isEn ? "한국어로 변경 (KO)" : "English (EN)"}
      </a>
    </div>
  </aside>
</header>

<style>
  .arcade-header {
    background: rgba(15, 23, 42, 0.85);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    position: sticky;
    top: 0;
    z-index: 100;
    padding: 0.65rem 1rem;
  }

  .header-inner {
    max-width: 100%;
    margin: 0 auto;
    padding: 0 0.5rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  .header-left {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .brand-link {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 1.35rem;
    font-weight: 800;
    text-decoration: none;
    letter-spacing: -0.02em;
    white-space: nowrap;
    flex-shrink: 0;
  }

  .brand-icon {
    font-size: 1.4rem;
    filter: drop-shadow(0 0 8px rgba(168, 85, 247, 0.5));
  }

  .brand-text-main {
    color: #f8fafc;
  }

  .brand-text-accent {
    background: linear-gradient(135deg, #a855f7 0%, #38bdf8 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .header-nav {
    display: flex;
    align-items: center;
    gap: 0.35rem;
  }

  .nav-category-group {
    display: flex;
    align-items: center;
    gap: 0.25rem;
  }

  .nav-divider {
    width: 1px;
    height: 18px;
    background: rgba(255, 255, 255, 0.15);
    margin: 0 0.2rem;
    flex-shrink: 0;
  }

  .nav-item {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.4rem 0.75rem;
    border-radius: 8px;
    color: #cbd5e1;
    text-decoration: none;
    font-size: 0.88rem;
    font-weight: 600;
    transition: all 0.15s ease;
    border: 1px solid transparent;
  }

  .nav-item:hover {
    color: #ffffff;
    background: rgba(255, 255, 255, 0.08);
    border-color: rgba(255, 255, 255, 0.1);
  }

  .nav-item.highlight {
    background: rgba(168, 85, 247, 0.15);
    border-color: rgba(168, 85, 247, 0.3);
    color: #e9d5ff;
  }

  .nav-item.highlight:hover {
    background: rgba(168, 85, 247, 0.25);
    border-color: rgba(168, 85, 247, 0.5);
    color: #ffffff;
  }

  .header-actions {
    display: flex;
    align-items: center;
    gap: 0.4rem;
  }

  .action-btn {
    width: 36px;
    height: 36px;
    border-radius: 8px;
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid rgba(255, 255, 255, 0.1);
    color: #e2e8f0;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    font-size: 1rem;
    transition: all 0.15s ease;
    text-decoration: none;
  }

  .action-btn:hover {
    background: rgba(255, 255, 255, 0.12);
    border-color: rgba(255, 255, 255, 0.2);
    transform: scale(1.05);
  }

  /* Language switcher — slightly wider to fit text */
  .lang-btn {
    width: auto;
    min-width: 36px;
    padding: 0 0.6rem;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    color: #a5b4fc;
    border-color: rgba(165, 180, 252, 0.25);
  }

  .lang-btn:hover {
    color: #ffffff;
    background: rgba(165, 180, 252, 0.15);
    border-color: rgba(165, 180, 252, 0.4);
  }

  /* Ad Toggle button (session/page only) */
  .ad-toggle-btn {
    width: auto;
    min-width: 36px;
    padding: 0 0.55rem;
    gap: 0.35rem;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.02em;
    color: #cbd5e1;
    border-color: rgba(255, 255, 255, 0.15);
  }

  .ad-toggle-btn:hover {
    color: #fca5a5;
    border-color: rgba(248, 113, 113, 0.35);
    background: rgba(248, 113, 113, 0.12);
  }

  .ad-toggle-btn.active {
    color: #38bdf8;
    border-color: rgba(56, 189, 248, 0.4);
    background: rgba(56, 189, 248, 0.15);
  }

  /* Mobile Hamburger Button */
  .mobile-menu-btn {
    display: none;
    font-size: 1.2rem;
  }

  /* Drawer Backdrop */
  .drawer-backdrop {
    position: fixed;
    top: 0;
    left: 0;
    width: 100vw;
    height: 100vh;
    background: rgba(0, 0, 0, 0.65);
    backdrop-filter: blur(4px);
    -webkit-backdrop-filter: blur(4px);
    z-index: 999;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.25s ease;
  }

  .drawer-backdrop.open {
    opacity: 1;
    pointer-events: auto;
  }

  /* Drawer Container */
  .mobile-drawer {
    position: fixed;
    top: 0;
    right: 0;
    width: min(340px, 86vw);
    height: 100vh;
    background: #0f172a;
    border-left: 1px solid rgba(255, 255, 255, 0.12);
    z-index: 1000;
    display: flex;
    flex-direction: column;
    transform: translateX(100%);
    transition: transform 0.28s cubic-bezier(0.16, 1, 0.3, 1);
    box-shadow: -12px 0 35px rgba(0, 0, 0, 0.6);
  }

  .mobile-drawer.open {
    transform: translateX(0);
  }

  .drawer-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 1rem 1.25rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    background: rgba(15, 23, 42, 0.95);
  }

  .drawer-brand {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 1.2rem;
    font-weight: 800;
    text-decoration: none;
  }

  .drawer-close-btn {
    font-size: 1.1rem;
    font-weight: 700;
  }

  .drawer-content {
    flex: 1;
    overflow-y: auto;
    padding: 1rem;
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    -webkit-overflow-scrolling: touch;
  }

  .drawer-section-title {
    font-size: 0.75rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    color: #94a3b8;
    margin-bottom: 0.5rem;
    padding-left: 0.4rem;
    text-transform: uppercase;
  }

  .drawer-nav-list {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .drawer-nav-item {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    padding: 0.65rem 0.85rem;
    border-radius: 10px;
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid rgba(255, 255, 255, 0.06);
    text-decoration: none;
    color: #e2e8f0;
    min-height: 48px;
    transition: all 0.15s ease;
  }

  .drawer-nav-item:active,
  .drawer-nav-item:hover {
    background: rgba(255, 255, 255, 0.08);
    border-color: rgba(255, 255, 255, 0.15);
    color: #ffffff;
  }

  .drawer-nav-item.active {
    background: rgba(168, 85, 247, 0.15);
    border-color: rgba(168, 85, 247, 0.35);
    color: #f8fafc;
  }

  .drawer-item-icon {
    font-size: 1.35rem;
    flex-shrink: 0;
    width: 28px;
    text-align: center;
  }

  .drawer-item-info {
    display: flex;
    flex-direction: column;
    gap: 0.1rem;
    overflow: hidden;
  }

  .drawer-item-name {
    font-size: 0.92rem;
    font-weight: 700;
    color: #f1f5f9;
  }

  .drawer-item-desc {
    font-size: 0.75rem;
    color: #94a3b8;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .drawer-footer {
    padding: 1rem 1.25rem;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
    background: rgba(15, 23, 42, 0.95);
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .drawer-lang-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    padding: 0.65rem 1rem;
    border-radius: 8px;
    background: rgba(165, 180, 252, 0.1);
    border: 1px solid rgba(165, 180, 252, 0.25);
    color: #c7d2fe;
    font-size: 0.85rem;
    font-weight: 700;
    text-decoration: none;
    min-height: 44px;
    transition: all 0.15s ease;
  }

  .drawer-lang-btn:hover {
    background: rgba(165, 180, 252, 0.2);
    color: #ffffff;
  }

  @media (max-width: 1024px) {
    .nav-item {
      padding: 0.35rem 0.5rem;
      font-size: 0.82rem;
    }
    .header-nav {
      gap: 0.2rem;
    }
  }

  @media (max-width: 768px) {
    .arcade-header {
      padding: 0.5rem 0.75rem;
    }
    .header-inner {
      gap: 0.5rem;
    }
    .header-nav {
      display: none !important;
    }
    .mobile-menu-btn {
      display: flex;
    }
    .ad-toggle-text {
      display: none;
    }
    .ad-toggle-btn {
      padding: 0;
      width: 36px;
    }
  }

  @media (max-width: 440px) {
    .brand-text-accent {
      display: none;
    }
  }
</style>

<script>
  // Page-specific Ad Toggle (Resets on navigation — does NOT persist to localStorage)
  const adToggleBtn = document.getElementById('page-ad-toggle');
  if (adToggleBtn) {
    const isEn = document.documentElement.lang === 'en';
    
    // Check if user has ?stream or ?obs or ?noads in URL
    const sp = new URLSearchParams(window.location.search);
    if (sp.has('stream') || sp.has('obs') || sp.has('noads')) {
      document.body.classList.add('ads-hidden');
      adToggleBtn.classList.add('active');
      const icon = adToggleBtn.querySelector('.ad-toggle-icon');
      const text = adToggleBtn.querySelector('.ad-toggle-text');
      if (icon) icon.textContent = '👁️';
      if (text) text.textContent = isEn ? 'Show Ads' : '광고 보기';
    }

    adToggleBtn.addEventListener('click', () => {
      const isHidden = document.body.classList.toggle('ads-hidden');
      adToggleBtn.classList.toggle('active', isHidden);
      const icon = adToggleBtn.querySelector('.ad-toggle-icon');
      const text = adToggleBtn.querySelector('.ad-toggle-text');
      if (isHidden) {
        if (icon) icon.textContent = '👁️';
        if (text) text.textContent = isEn ? 'Show Ads' : '광고 보기';
        adToggleBtn.setAttribute('title', isEn ? 'Show ads on this page' : '이 페이지 광고 다시 표시');
        adToggleBtn.setAttribute('aria-label', isEn ? 'Show Ads' : '광고 보기');
      } else {
        if (icon) icon.textContent = '🚫';
        if (text) text.textContent = isEn ? 'Hide Ads' : '광고 숨기기';
        adToggleBtn.setAttribute('title', isEn ? 'Hide ads on this page' : '이 페이지 광고 숨기기');
        adToggleBtn.setAttribute('aria-label', isEn ? 'Hide Ads' : '광고 숨기기');
      }
    });
  }

  // Mobile Drawer Toggle Logic
  const mobileToggleBtn = document.getElementById('mobile-menu-toggle');
  const mobileDrawer = document.getElementById('mobile-drawer');
  const drawerBackdrop = document.getElementById('mobile-drawer-backdrop');
  const drawerCloseBtn = document.getElementById('mobile-drawer-close');

  function openDrawer() {
    if (mobileDrawer && drawerBackdrop && mobileToggleBtn) {
      mobileDrawer.classList.add('open');
      drawerBackdrop.classList.add('open');
      mobileDrawer.setAttribute('aria-hidden', 'false');
      drawerBackdrop.setAttribute('aria-hidden', 'false');
      mobileToggleBtn.setAttribute('aria-expanded', 'true');
      document.body.style.overflow = 'hidden';
    }
  }

  function closeDrawer() {
    if (mobileDrawer && drawerBackdrop && mobileToggleBtn) {
      mobileDrawer.classList.remove('open');
      drawerBackdrop.classList.remove('open');
      mobileDrawer.setAttribute('aria-hidden', 'true');
      drawerBackdrop.setAttribute('aria-hidden', 'true');
      mobileToggleBtn.setAttribute('aria-expanded', 'false');
      document.body.style.overflow = '';
    }
  }

  if (mobileToggleBtn) {
    mobileToggleBtn.addEventListener('click', openDrawer);
  }
  if (drawerCloseBtn) {
    drawerCloseBtn.addEventListener('click', closeDrawer);
  }
  if (drawerBackdrop) {
    drawerBackdrop.addEventListener('click', closeDrawer);
  }
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && mobileDrawer?.classList.contains('open')) {
      closeDrawer();
    }
  });
  const drawerLinks = mobileDrawer?.querySelectorAll('a');
  drawerLinks?.forEach(link => {
    link.addEventListener('click', closeDrawer);
  });

  // Client-side global sound toggle
  const soundBtn = document.getElementById('global-sound-toggle');
  const soundIcon = document.getElementById('sound-icon');

  function updateSoundUI() {
    const muted = localStorage.getItem('aether_sound_muted') === 'true';
    if (soundIcon) soundIcon.textContent = muted ? '🔇' : '🔊';
    if (soundBtn) {
      soundBtn.setAttribute('title', muted ? '소리 켜기 / Unmute' : '소리 끄기 / Mute');
      soundBtn.setAttribute('aria-label', muted ? '소리 켜기 / Unmute' : '소리 끄기 / Mute');
      soundBtn.classList.toggle('muted', muted);
    }
  }

  if (soundBtn) {
    soundBtn.addEventListener('click', () => {
      const current = localStorage.getItem('aether_sound_muted') === 'true';
      const nextMuted = !current;
      localStorage.setItem('aether_sound_muted', String(nextMuted));
      updateSoundUI();
      window.dispatchEvent(new CustomEvent('sound-toggle', { detail: { muted: nextMuted } }));
    });
    updateSoundUI();
  }

  window.addEventListener('sound-toggle', () => {
    updateSoundUI();
  });
  window.addEventListener('storage', (e) => {
    if (e.key === 'aether_sound_muted') updateSoundUI();
  });

  // Persist language preference
  const langSwitcher = document.getElementById('lang-switcher') as HTMLAnchorElement | null;
  if (langSwitcher) {
    langSwitcher.addEventListener('click', () => {
      const href = langSwitcher.getAttribute('href') || '/';
      const nextLang = href.startsWith('/en') ? 'en' : 'ko';
      localStorage.setItem('preferred_lang', nextLang);
    });
  }
</script>