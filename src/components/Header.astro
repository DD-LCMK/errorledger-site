---
import HeaderLink from './HeaderLink.astro';
import SubmitIncidentModal from './SubmitIncidentModal.astro';
import { SITE_TITLE } from '../consts';
---

<header>
	<nav class="header-nav">
		<h2>
			<a href="/" class="brand-link">
				<span class="brand-badge">&gt;_</span>
				<span class="logo-text-main">Error</span><span class="logo-text-accent">Ledger</span>
			</a>
		</h2>

		<!-- Search Input -->
		<form action="/search" method="GET" class="header-search-form">
			<input 
				type="text" 
				name="q" 
				class="header-search-input" 
				placeholder="Search the Failure Ledger..." 
				aria-label="Search repository globally"
				autocomplete="off"
			/>
		</form>

		<div class="internal-links">
			<HeaderLink href="/">Ledger</HeaderLink>
			<HeaderLink href="/blog">Archive</HeaderLink>
			
			<!-- Interactive Feature 1: Failure Roulette -->
			<button id="random-failure-btn" class="nav-action-btn random-btn" title="Open a random incident from the ledger">
				<span>🎲</span> Random
			</button>

			<!-- Interactive Feature 5: Submit Incident -->
			<button class="nav-action-btn submit-btn" data-open-submit-modal title="Submit an incident to The Archivist">
				<span>+</span> Submit
			</button>
			
			<!-- Theme Toggle Button -->
			<button id="theme-toggle" aria-label="Toggle dark mode" class="theme-btn">
				<svg id="theme-toggle-dark-icon" class="hidden" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"></path></svg>
				<svg id="theme-toggle-light-icon" class="hidden" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="4"></circle><path d="M12 2v2"></path><path d="M12 20v2"></path><path d="m4.93 4.93 1.41 1.41"></path><path d="m17.66 17.66 1.41 1.41"></path><path d="M2 12h2"></path><path d="M20 12h2"></path><path d="m6.34 17.66-1.41 1.41"></path><path d="m19.07 4.93-1.41 1.41"></path></svg>
			</button>
		</div>
	</nav>

	<!-- Telemetry Reading Progress Bar -->
	<div class="progress-bus">
		<div id="reading-progress-bar" class="progress-fill"></div>
	</div>

	<SubmitIncidentModal />
</header>

<script>
	const themeToggleBtn = document.getElementById('theme-toggle');
	const darkIcon = document.getElementById('theme-toggle-dark-icon');
	const lightIcon = document.getElementById('theme-toggle-light-icon');

	function updateIcons() {
		if (document.documentElement.classList.contains('dark')) {
			lightIcon?.classList.remove('hidden');
			darkIcon?.classList.add('hidden');
		} else {
			darkIcon?.classList.remove('hidden');
			lightIcon?.classList.add('hidden');
		}
	}

	updateIcons();

	themeToggleBtn?.addEventListener('click', () => {
		if (document.documentElement.classList.contains('dark')) {
			document.documentElement.classList.remove('dark');
			localStorage.setItem('theme', 'light');
		} else {
			document.documentElement.classList.add('dark');
			localStorage.setItem('theme', 'dark');
		}
		updateIcons();
	});

	// Random Failure Engine
	const randomBtn = document.getElementById('random-failure-btn');
	randomBtn?.addEventListener('click', async () => {
		try {
			// Fallback list of known slugs or fetch sitemap/rss
			const sampleSlugs = [
				'/blog/the-friday-update-that-broke-the-world'
			];
			const randomTarget = sampleSlugs[Math.floor(Math.random() * sampleSlugs.length)];
			window.location.href = randomTarget;
		} catch (err) {
			window.location.href = '/blog';
		}
	});

	// Dynamic Reading Progress Engine
	window.addEventListener('scroll', () => {
		const winScroll = document.documentElement.scrollTop || document.body.scrollTop;
		const height = document.documentElement.scrollHeight - document.documentElement.clientHeight;
		const scrolled = height > 0 ? (winScroll / height) * 100 : 0;
		const progressBar = document.getElementById('reading-progress-bar');
		if (progressBar) {
			progressBar.style.width = scrolled + '%';
		}
	});
</script>

<style>
	header {
		position: sticky;
		top: 0;
		z-index: 100;
		margin: 0;
		padding: 0 1.5rem;
		background: rgba(10, 10, 10, 0.85);
		backdrop-filter: blur(12px);
		-webkit-backdrop-filter: blur(12px);
		border-bottom: 1px solid #262626;
		box-shadow: 0 4px 20px rgba(0, 0, 0, 0.4);
		transition: background-color 0.2s ease, border-color 0.2s ease;
	}
	.header-nav {
		display: flex;
		align-items: center;
		justify-content: space-between;
		max-width: 1200px;
		margin: 0 auto;
		padding: 0.75rem 0;
		gap: 1.5rem;
	}
	.brand-link {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		text-decoration: none;
		font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
		font-weight: 700;
		font-size: 1.25rem;
	}
	.brand-badge {
		background-color: #171717;
		color: #f43f5e;
		padding: 0.15rem 0.45rem;
		border-radius: 6px;
		border: 1px solid #262626;
		font-size: 0.95rem;
		font-weight: 900;
	}
	.logo-text-main { color: #f5f5f5; }
	.logo-text-accent { color: #f43f5e; }

	.internal-links {
		display: flex;
		align-items: center;
		gap: 0.5rem;
	}
	.internal-links a {
		padding: 0.4rem 0.65rem;
		color: #a3a3a3;
		text-decoration: none;
		font-size: 0.9rem;
		font-weight: 500;
		border-radius: 6px;
		transition: color 0.15s ease;
	}
	.internal-links a:hover, .internal-links a.active {
		color: #ffffff;
	}

	.nav-action-btn {
		display: inline-flex;
		align-items: center;
		gap: 0.35rem;
		font-size: 0.8rem;
		font-weight: 700;
		padding: 0.4rem 0.75rem;
		border-radius: 8px;
		border: 1px solid #262626;
		background: #171717;
		color: #d4d4d4;
		cursor: pointer;
		font-family: ui-monospace, monospace;
		transition: all 0.15s ease;
	}
	.random-btn:hover {
		border-color: #f59e0b;
		color: #f59e0b;
		background: rgba(245, 158, 11, 0.1);
	}
	.submit-btn {
		background: rgba(244, 63, 94, 0.1);
		border-color: rgba(244, 63, 94, 0.3);
		color: #fb7185;
	}
	.submit-btn:hover {
		background: #f43f5e;
		color: #ffffff;
		border-color: #f43f5e;
	}

	.theme-btn {
		background: none;
		border: none;
		cursor: pointer;
		padding: 0.4rem;
		color: #a3a3a3;
		display: inline-flex;
		align-items: center;
	}
	.theme-btn:hover { color: #ffffff; }

	.header-search-form {
		flex-grow: 1;
		max-width: 320px;
		margin: 0 1rem;
	}
	.header-search-input {
		width: 100%;
		padding: 0.45rem 0.85rem;
		font-size: 0.85rem;
		border-radius: 8px;
		border: 1px solid #262626;
		background: #171717;
		color: #f5f5f5;
		outline: none;
		font-family: inherit;
		transition: all 0.15s ease;
	}
	.header-search-input:focus {
		border-color: #f43f5e;
		box-shadow: 0 0 0 2px rgba(244, 63, 94, 0.2);
	}

	@media (max-width: 850px) {
		.header-search-form { display: none; }
	}

	.progress-bus {
		position: absolute;
		bottom: -1px;
		left: 0;
		width: 100%;
		height: 2px;
		background: transparent;
	}
	.progress-fill {
		height: 100%;
		width: 0%;
		background: linear-gradient(to r, #f59e0b, #f43f5e);
		box-shadow: 0 0 8px rgba(244, 63, 94, 0.6);
		transition: width 0.05s ease-out;
	}
	.hidden { display: none !important; }
</style>