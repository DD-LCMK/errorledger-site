---
import HeaderLink from './HeaderLink.astro';
import SubmitIncidentModal from './SubmitIncidentModal.astro';
import { SITE_TITLE } from '../consts';
import { getCollection } from 'astro:content';

const allPosts = await getCollection('blog');
const allSlugs = allPosts.map(p => {
	const prefix = p.data.lang === 'ko' ? '/ko/blog/' : '/blog/';
	return `${prefix}${p.data.slug.replace(/^ko\//, '')}`;
});

const currentPath = Astro.url.pathname.replace(/\/$/, '') || '/';
const isKorean = currentPath === '/ko' || currentPath.startsWith('/ko/');
const homeUrl = isKorean ? '/ko' : '/';
const archiveUrl = isKorean ? '/ko/blog' : '/blog';
const aboutUrl = isKorean ? '/ko/about' : '/about';
const searchUrl = isKorean ? '/ko/search' : '/search';

// Precise Language Switcher target calculation
let langTargetUrl = '/';
if (isKorean) {
	const stripped = currentPath.replace(/^\/ko/, '');
	langTargetUrl = stripped || '/';
} else {
	if (currentPath === '/') {
		langTargetUrl = '/ko';
	} else {
		langTargetUrl = `/ko${currentPath}`;
	}
}
const langSwitchLabel = isKorean ? '🇺🇸 English' : '🇰🇷 한국어';
---

<header>
	<nav class="header-nav">
		<h2>
			<a href={homeUrl} class="brand-link">
				<span class="brand-badge">&gt;_</span>
				<span class="logo-text-main">Error</span><span class="logo-text-accent">Ledger</span>
			</a>
		</h2>

		<!-- Search Input -->
		<form action={searchUrl} method="GET" class="header-search-form">
			<input 
				type="text" 
				name="q" 
				class="header-search-input" 
				placeholder={isKorean ? "사건 및 재난 검색..." : "Search the Failure Ledger..."}
				aria-label="Search repository globally"
				autocomplete="off"
			/>
		</form>

		<div class="internal-links">
			<HeaderLink href={homeUrl}>{isKorean ? "홈" : "Ledger"}</HeaderLink>
			<HeaderLink href={archiveUrl}>{isKorean ? "아카이브" : "Archive"}</HeaderLink>
			<HeaderLink href={aboutUrl}>{isKorean ? "소개" : "About"}</HeaderLink>
			
			<!-- Language Switcher Button -->
			<a href={langTargetUrl} class="nav-action-btn lang-btn" title="Switch language">
				{langSwitchLabel}
			</a>

			<!-- Interactive Feature 1: Failure Roulette -->
			<button id="random-failure-btn" class="nav-action-btn random-btn" title="Open a random incident from the ledger">
				<span>🎲</span> {isKorean ? "랜덤" : "Random"}
			</button>

			<!-- Interactive Feature 5: Submit Incident -->
			<button class="nav-action-btn submit-btn" data-open-submit-modal title="Submit an incident to The Archivist">
				<span>+</span> {isKorean ? "제보" : "Submit"}
			</button>
			
			<!-- Theme Toggle Button -->
			<button id="theme-toggle" aria-label="Toggle dark mode" class="theme-btn">
				<svg id="theme-toggle-dark-icon" class="hidden" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"></path></svg>
				<svg id="theme-toggle-light-icon" class="hidden" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="4"></circle><path d="M12 2v2"></path><path d="M12 20v2"></path><path d="m4.93 4.93 1.41 1.41"></path><path d="m17.66 17.66 1.41 1.41"></path><path d="M2 12h2"></path><path d="M20 12h2"></path><path d="m6.34 17.66-1.41 1.41"></path><path d="m19.07 4.93-1.41 1.41"></path></svg>
			</button>
		</div>
	</nav>

	<!-- Telemetry Reading Progress Bar -->
	<div class="progress-bus">
		<div id="reading-progress-bar" class="progress-fill"></div>
	</div>

	<SubmitIncidentModal />
</header>

<script is:inline define:vars={{ allSlugs, isKorean }}>
	window.__ERRORLEDGER_SLUGS__ = allSlugs || ['/blog'];

	const themeToggleBtn = document.getElementById('theme-toggle');
	const darkIcon = document.getElementById('theme-toggle-dark-icon');
	const lightIcon = document.getElementById('theme-toggle-light-icon');

	function updateIcons() {
		if (document.documentElement.classList.contains('dark')) {
			lightIcon?.classList.remove('hidden');
			darkIcon?.classList.add('hidden');
		} else {
			darkIcon?.classList.remove('hidden');
			lightIcon?.classList.add('hidden');
		}
	}

	updateIcons();

	themeToggleBtn?.addEventListener('click', () => {
		if (document.documentElement.classList.contains('dark')) {
			document.documentElement.classList.remove('dark');
			localStorage.setItem('theme', 'light');
		} else {
			document.documentElement.classList.add('dark');
			localStorage.setItem('theme', 'dark');
		}
		updateIcons();
	});

	// Global Random Failure Engine across all buttons (respects current language)
	document.addEventListener('click', function(e) {
		if (e.target.closest('#random-failure-btn') || e.target.closest('#float-random-btn')) {
			e.preventDefault();
			const slugs = (window.__ERRORLEDGER_SLUGS__ || []).filter(s => isKorean ? s.startsWith('/ko/blog') : !s.startsWith('/ko/blog'));
			const pool = slugs.length > 0 ? slugs : window.__ERRORLEDGER_SLUGS__;
			const randomTarget = pool[Math.floor(Math.random() * pool.length)];
			window.location.href = randomTarget;
		}
	});

	// Dynamic Reading Progress Engine
	window.addEventListener('scroll', () => {
		const winScroll = document.documentElement.scrollTop || document.body.scrollTop;
		const height = document.documentElement.scrollHeight - document.documentElement.clientHeight;
		const scrolled = height > 0 ? (winScroll / height) * 100 : 0;
		const progressBar = document.getElementById('reading-progress-bar');
		if (progressBar) {
			progressBar.style.width = scrolled + '%';
		}
	});
</script>

<style>
	header {
		position: sticky;
		top: 0;
		z-index: 100;
		margin: 0;
		padding: 0 1.5rem;
		background: rgba(10, 10, 10, 0.88);
		backdrop-filter: blur(12px);
		-webkit-backdrop-filter: blur(12px);
		border-bottom: 1px solid #262626;
		box-shadow: 0 4px 20px rgba(0, 0, 0, 0.4);
		transition: background-color 0.2s ease, border-color 0.2s ease;
	}
	.header-nav {
		display: flex;
		align-items: center;
		justify-content: space-between;
		max-width: 1200px;
		margin: 0 auto;
		padding: 0.75rem 0;
		gap: 1.5rem;
	}
	.brand-link {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		text-decoration: none;
		font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
		font-weight: 700;
		font-size: 1.25rem;
	}
	.brand-badge {
		background-color: #171717;
		color: #f43f5e;
		padding: 0.15rem 0.45rem;
		border-radius: 6px;
		border: 1px solid #262626;
		font-size: 0.95rem;
		font-weight: 900;
	}
	.logo-text-main { color: #f5f5f5; }
	.logo-text-accent { color: #f43f5e; }

	.internal-links {
		display: flex;
		align-items: center;
		gap: 0.5rem;
	}
	.internal-links a {
		padding: 0.4rem 0.65rem;
		color: #a3a3a3;
		text-decoration: none;
		font-size: 0.9rem;
		font-weight: 500;
		border-radius: 6px;
		transition: color 0.15s ease;
	}
	.internal-links a:hover, .internal-links a.active {
		color: #ffffff;
	}

	.nav-action-btn {
		display: inline-flex;
		align-items: center;
		gap: 0.35rem;
		font-size: 0.8rem;
		font-weight: 700;
		padding: 0.4rem 0.75rem;
		border-radius: 8px;
		border: 1px solid #262626;
		background: #171717;
		color: #d4d4d4;
		cursor: pointer;
		font-family: ui-monospace, monospace;
		transition: all 0.15s ease;
		text-decoration: none;
	}
	.lang-btn {
		background: rgba(245, 158, 11, 0.1);
		border-color: rgba(245, 158, 11, 0.25);
		color: #f59e0b;
	}
	.lang-btn:hover {
		background: #f59e0b;
		color: #000000;
	}
	.random-btn:hover {
		border-color: #f59e0b;
		color: #f59e0b;
		background: rgba(245, 158, 11, 0.1);
	}
	.submit-btn {
		background: rgba(244, 63, 94, 0.1);
		border-color: rgba(244, 63, 94, 0.3);
		color: #fb7185;
	}
	.submit-btn:hover {
		background: #f43f5e;
		color: #ffffff;
		border-color: #f43f5e;
	}

	.theme-btn {
		background: none;
		border: none;
		cursor: pointer;
		padding: 0.4rem;
		color: #a3a3a3;
		display: inline-flex;
		align-items: center;
	}
	.theme-btn:hover { color: #ffffff; }

	.header-search-form {
		flex-grow: 1;
		max-width: 320px;
		margin: 0 1rem;
	}
	.header-search-input {
		width: 100%;
		padding: 0.45rem 0.85rem;
		font-size: 0.85rem;
		border-radius: 8px;
		border: 1px solid #262626;
		background: #171717;
		color: #f5f5f5;
		outline: none;
		font-family: inherit;
		transition: all 0.15s ease;
	}
	.header-search-input:focus {
		border-color: #f43f5e;
		box-shadow: 0 0 0 2px rgba(244, 63, 94, 0.2);
	}

	@media (max-width: 850px) {
		.header-search-form { display: none; }
	}

	.progress-bus {
		position: absolute;
		bottom: -1px;
		left: 0;
		width: 100%;
		height: 2px;
		background: transparent;
	}
	.progress-fill {
		height: 100%;
		width: 0%;
		background: linear-gradient(to r, #f59e0b, #f43f5e);
		box-shadow: 0 0 8px rgba(244, 63, 94, 0.6);
		transition: width 0.05s ease-out;
	}
	.hidden { display: none !important; }

	/* Light mode styles */
	:global(html:not(.dark)) header {
		background: rgba(255, 255, 255, 0.92);
		border-bottom-color: #e2e8f0;
	}
	:global(html:not(.dark)) .logo-text-main { color: #0f172a; }
	:global(html:not(.dark)) .internal-links a { color: #475569; }
	:global(html:not(.dark)) .internal-links a:hover { color: #0f172a; }
	:global(html:not(.dark)) .header-search-input {
		background: #f8fafc;
		border-color: #cbd5e1;
		color: #0f172a;
	}
	:global(html:not(.dark)) .nav-action-btn {
		background: #f8fafc;
		border-color: #cbd5e1;
		color: #334155;
	}
</style>