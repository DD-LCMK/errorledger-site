  // Compute Fortune for a given sign and date
  function computeFortune(sign: SignData, dateKey: string) {
    const seed = hashString(`${dateKey}_${sign.id}`);
    const rng = createSeededRNG(seed);

    // Overall Score: 60 ~ 98
    const overallScore = Math.floor(rng() * 38) + 60;

    let grade = '보통 (平)';
    let gradeColor = '#38bdf8';
    if (overallScore >= 90) {
      grade = '대길 (大吉) 🌟';
      gradeColor = '#facc15';
    } else if (overallScore >= 80) {
      grade = '길 (吉) ✨';
      gradeColor = '#a855f7';
    } else if (overallScore >= 70) {
      grade = '소길 (小吉) 🍀';
      gradeColor = '#38bdf8';
    }

    // Sub-scores: range around overallScore ± 15, clamped 50..100
    const wScore = Math.max(50, Math.min(100, Math.floor(overallScore + (rng() - 0.5) * 25)));
    const lScore = Math.max(50, Math.min(100, Math.floor(overallScore + (rng() - 0.5) * 25)));
    const kScore = Math.max(50, Math.min(100, Math.floor(overallScore + (rng() - 0.5) * 25)));
    const hScore = Math.max(50, Math.min(100, Math.floor(overallScore + (rng() - 0.5) * 25)));

    // Pick content deterministically
    const titleIdx = Math.floor(rng() * FORTUNE_TITLES.length);
    const bodyIdx = Math.floor(rng() * FORTUNE_OVERVIEWS.length);
    const wTipIdx = Math.floor(rng() * WEALTH_TIPS.length);
    const lTipIdx = Math.floor(rng() * LOVE_TIPS.length);
    const kTipIdx = Math.floor(rng() * WORK_TIPS.length);
    const hTipIdx = Math.floor(rng() * HEALTH_TIPS.length);

    // Lucky pills
    const luckyNum = Math.floor(rng() * 89) + 7;
    const luckyColor = LUCKY_COLORS[Math.floor(rng() * LUCKY_COLORS.length)];
    const luckyDir = LUCKY_DIRECTIONS[Math.floor(rng() * LUCKY_DIRECTIONS.length)];
    const luckyTime = LUCKY_TIMES[Math.floor(rng() * LUCKY_TIMES.length)];
    const luckyItem = LUCKY_ITEMS[Math.floor(rng() * LUCKY_ITEMS.length)];

    return {
      overallScore,
      grade,
      gradeColor,
      headline: FORTUNE_TITLES[titleIdx],
      body: FORTUNE_OVERVIEWS[bodyIdx],
      wealth: { score: wScore, tip: WEALTH_TIPS[wTipIdx] },
      love: { score: lScore, tip: LOVE_TIPS[lTipIdx] },
      work: { score: kScore, tip: WORK_TIPS[kTipIdx] },
      health: { score: hScore, tip: HEALTH_TIPS[hTipIdx] },
      luckyNum,
      luckyColor,
      luckyDir,
      luckyTime,
      luckyItem
    };
  }

  // Render Signs Grid (12 items)
  function renderSignsGrid() {
    if (!signsGrid) return;
    const list = currentTab === 'eastern' ? EASTERN_SIGNS : WESTERN_SIGNS;

    signsGrid.innerHTML = '';
    list.forEach(sign => {
      const btn = document.createElement('button');
      btn.className = `sign-btn ${sign.id === currentSignId ? 'active' : ''}`;
      btn.setAttribute('data-id', sign.id);
      btn.setAttribute('type', 'button');

      btn.innerHTML = `
        <span class="sign-btn-icon">${sign.icon}</span>
        <span class="sign-btn-title">${sign.name}</span>
        <span class="sign-btn-desc">${sign.sub}</span>
      `;

      btn.addEventListener('click', () => {
        currentSignId = sign.id;
        document.querySelectorAll('.sign-btn').forEach(b => b.classList.remove('active'));
        btn.classList.add('active');
        renderSelectedFortune();
      });

      signsGrid.appendChild(btn);
    });
  }

  // Render Selected Fortune
  function renderSelectedFortune() {
    const list = currentTab === 'eastern' ? EASTERN_SIGNS : WESTERN_SIGNS;
    let sign = list.find(s => s.id === currentSignId);
    if (!sign) {
      sign = list[0];
      currentSignId = sign.id;
    }

    const { dateKey, humanDate, tagDate } = getTodayInfo();
    if (fortuneDateTag) fortuneDateTag.textContent = `📅 ${tagDate}`;
    if (fortuneCardDate) fortuneCardDate.textContent = humanDate;

    const data = computeFortune(sign, dateKey);

    if (fortuneAvatar) fortuneAvatar.textContent = sign.icon;
    if (fortuneSignName) fortuneSignName.textContent = sign.name;
    if (fortuneSignSub) fortuneSignSub.textContent = sign.sub;

    if (fortuneScoreNum) fortuneScoreNum.textContent = String(data.overallScore);
    if (fortuneScoreGrade) fortuneScoreGrade.textContent = data.grade;
    if (fortuneScorePill) {
      fortuneScorePill.style.borderColor = `${data.gradeColor}60`;
      fortuneScorePill.style.backgroundColor = `${data.gradeColor}20`;
    }

    if (fortuneMeterFill) {
      fortuneMeterFill.style.width = `${data.overallScore}%`;
    }

    if (fortuneHeadline) fortuneHeadline.textContent = `"${data.headline}"`;
    if (fortuneBody) fortuneBody.textContent = data.body;

    // Sub metrics
    if (luckWealthScore) luckWealthScore.textContent = `${data.wealth.score}%`;
    if (luckWealthBar) luckWealthBar.style.width = `${data.wealth.score}%`;
    if (luckWealthTip) luckWealthTip.textContent = data.wealth.tip;

    if (luckLoveScore) luckLoveScore.textContent = `${data.love.score}%`;
    if (luckLoveBar) luckLoveBar.style.width = `${data.love.score}%`;
    if (luckLoveTip) luckLoveTip.textContent = data.love.tip;

    if (luckWorkScore) luckWorkScore.textContent = `${data.work.score}%`;
    if (luckWorkBar) luckWorkBar.style.width = `${data.work.score}%`;
    if (luckWorkTip) luckWorkTip.textContent = data.work.tip;

    if (luckHealthScore) luckHealthScore.textContent = `${data.health.score}%`;
    if (luckHealthBar) luckHealthBar.style.width = `${data.health.score}%`;
    if (luckHealthTip) luckHealthTip.textContent = data.health.tip;

    // Pills
    if (pillNumber) pillNumber.textContent = String(data.luckyNum);
    if (pillColor) pillColor.textContent = data.luckyColor;
    if (pillDirection) pillDirection.textContent = data.luckyDir;
    if (pillTime) pillTime.textContent = data.luckyTime;
    if (pillItem) pillItem.textContent = data.luckyItem;
  }

  // Tab switching
  tabs.forEach(tab => {
    tab.addEventListener('click', () => {
      tabs.forEach(t => {
        t.classList.remove('active');
        t.setAttribute('aria-selected', 'false');
      });
      tab.classList.add('active');
      tab.setAttribute('aria-selected', 'true');

      currentTab = (tab.getAttribute('data-tab') || 'eastern') as 'eastern' | 'western';
      // Default to first item of new tab
      currentSignId = currentTab === 'eastern' ? 'rat' : 'aquarius';

      renderSignsGrid();
      renderSelectedFortune();
    });
  });

  // Copy to Clipboard
  btnCopyFortune?.addEventListener('click', () => {
    const list = currentTab === 'eastern' ? EASTERN_SIGNS : WESTERN_SIGNS;
    const sign = list.find(s => s.id === currentSignId) || list[0];
    const { humanDate } = getTodayInfo();

    const score = fortuneScoreNum?.textContent || '90';
    const grade = fortuneScoreGrade?.textContent || '대길';
    const title = fortuneHeadline?.textContent || '';
    const body = fortuneBody?.textContent || '';
    const num = pillNumber?.textContent || '';
    const color = pillColor?.textContent || '';
    const dir = pillDirection?.textContent || '';

    const textToCopy = `[오늘의 운세 - ${humanDate}]\n` +
      `✨ ${sign.name} (${sign.icon}): 종합운 ${score}점 (${grade})\n` +
      `${title}\n\n` +
      `${body}\n\n` +
      `🍀 행운의 숫자: ${num} | 색상: ${color} | 방향: ${dir}`;

    if (navigator.clipboard && navigator.clipboard.writeText) {
      navigator.clipboard.writeText(textToCopy).then(() => {
        showToast();
      }).catch(() => {
        fallbackCopy(textToCopy);
      });
    } else {
      fallbackCopy(textToCopy);
    }
  });

  function fallbackCopy(text: string) {
    const ta = document.createElement('textarea');
    ta.value = text;
    ta.style.position = 'fixed';
    ta.style.opacity = '0';
    document.body.appendChild(ta);
    ta.select();
    try {
      document.execCommand('copy');
      showToast();
    } finally {
      document.body.removeChild(ta);
    }
  }

  function showToast() {
    if (!fortuneToast) return;
    fortuneToast.classList.remove('hidden');
    setTimeout(() => {
      fortuneToast.classList.add('hidden');
    }, 2400);
  }

  // Initial render
  renderSignsGrid();
  renderSelectedFortune();
</script>
