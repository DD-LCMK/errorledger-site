  // Compute Fortune for a given sign and date
  function computeFortune(sign: SignData, dateKey: string) {
    const seed = hashString(`${dateKey}_${sign.id}_v2`);
    const rng = createSeededRNG(seed);

    // Overall Score: 60 ~ 98
    const overallScore = Math.floor(rng() * 38) + 60;

    let grade = isEn ? 'Steady & Calm 🌿' : '보통 (平)';
    let gradeColor = '#38bdf8';
    if (overallScore >= 90) {
      grade = isEn ? 'Great Fortune 🌟' : '대길 (大吉) 🌟';
      gradeColor = '#facc15';
    } else if (overallScore >= 80) {
      grade = isEn ? 'Good Fortune ✨' : '중길 (中吉) ✨';
      gradeColor = '#a855f7';
    } else if (overallScore >= 70) {
      grade = isEn ? 'Moderate Fortune 🍀' : '소길 (小吉) 🍀';
      gradeColor = '#38bdf8';
    }

    // Sub-scores: clamped 50..100
    const wScore = Math.max(50, Math.min(100, Math.floor(overallScore + (rng() - 0.5) * 25)));
    const lScore = Math.max(50, Math.min(100, Math.floor(overallScore + (rng() - 0.5) * 25)));
    const kScore = Math.max(50, Math.min(100, Math.floor(overallScore + (rng() - 0.5) * 25)));
    const hScore = Math.max(50, Math.min(100, Math.floor(overallScore + (rng() - 0.5) * 25)));

    // Pick content deterministically
    const titles = isEn ? FORTUNE_TITLES_EN : FORTUNE_TITLES;
    const overviews = isEn ? FORTUNE_OVERVIEWS_EN : FORTUNE_OVERVIEWS;
    const wTips = isEn ? WEALTH_TIPS_EN : WEALTH_TIPS;
    const lTips = isEn ? LOVE_TIPS_EN : LOVE_TIPS;
    const kTips = isEn ? WORK_TIPS_EN : WORK_TIPS;
    const hTips = isEn ? HEALTH_TIPS_EN : HEALTH_TIPS;
    const dos = isEn ? DOS_POOL_EN : DOS_POOL;
    const donts = isEn ? DONTS_POOL_EN : DONTS_POOL;
    const colors = isEn ? LUCKY_COLORS_EN : LUCKY_COLORS;
    const dirs = isEn ? LUCKY_DIRECTIONS_EN : LUCKY_DIRECTIONS;
    const times = isEn ? LUCKY_TIMES_EN : LUCKY_TIMES;
    const items = isEn ? LUCKY_ITEMS_EN : LUCKY_ITEMS;
    const foods = isEn ? LUCKY_FOODS_EN : LUCKY_FOODS;
    const yearPool = isEn ? YEAR_FORTUNE_POOL_EN : YEAR_FORTUNE_POOL;

    const titleIdx = Math.floor(rng() * titles.length);
    const bodyIdx = Math.floor(rng() * overviews.length);
    const wTipIdx = Math.floor(rng() * wTips.length);
    const lTipIdx = Math.floor(rng() * lTips.length);
    const kTipIdx = Math.floor(rng() * kTips.length);
    const hTipIdx = Math.floor(rng() * hTips.length);

    // Do & Don't
    const doIdx = Math.floor(rng() * dos.length);
    const dontIdx = Math.floor(rng() * donts.length);

    // Lucky pills
    const luckyNum1 = Math.floor(rng() * 45) + 1;
    const luckyNum2 = Math.floor(rng() * 50) + 10;
    const luckyColor = colors[Math.floor(rng() * colors.length)];
    const luckyDir = dirs[Math.floor(rng() * dirs.length)];
    const luckyTime = times[Math.floor(rng() * times.length)];
    const luckyItem = items[Math.floor(rng() * items.length)];
    const luckyFood = foods[Math.floor(rng() * foods.length)];

    // Birth-year fortunes (for Eastern Zodiac)
    const yearFortunes = (sign.birthYears || []).map((year, idx) => {
      const yearSeed = hashString(`${dateKey}_${sign.id}_${year}`);
      const yearRng = createSeededRNG(yearSeed);
      const yearTextIdx = Math.floor(yearRng() * yearPool.length);
      return {
        year,
        shortYear: String(year).slice(2),
        text: yearPool[(yearTextIdx + idx) % yearPool.length]
      };
    });

    return {
      overallScore,
      grade,
      gradeColor,
      headline: titles[titleIdx],
      body: overviews[bodyIdx],
      wealth: { score: wScore, tip: wTips[wTipIdx] },
      love: { score: lScore, tip: lTips[lTipIdx] },
      work: { score: kScore, tip: kTips[kTipIdx] },
      health: { score: hScore, tip: hTips[hTipIdx] },
      doText: dos[doIdx],
      dontText: donts[dontIdx],
      luckyNums: `${luckyNum1}, ${luckyNum2}`,
      luckyColor,
      luckyDir,
      luckyTime,
      luckyItem,
      luckyFood,
      yearFortunes
    };
  }

  // Render Signs Grid (12 items)
  function renderSignsGrid() {
    if (!signsGrid) return;
    const list = currentTab === 'eastern' ? (isEn ? EASTERN_SIGNS_EN : EASTERN_SIGNS) : (isEn ? WESTERN_SIGNS_EN : WESTERN_SIGNS);

    signsGrid.innerHTML = '';
    list.forEach(sign => {
      const btn = document.createElement('button');
      btn.className = `sign-btn ${sign.id === currentSignId ? 'active' : ''}`;
      btn.setAttribute('data-id', sign.id);
      btn.setAttribute('type', 'button');

      btn.innerHTML = `
        <span class="sign-btn-icon">${sign.icon}</span>
        <span class="sign-btn-title">${sign.name}</span>
        <span class="sign-btn-desc">${sign.sub}</span>
      `;

      btn.addEventListener('click', () => {
        currentSignId = sign.id;
        document.querySelectorAll('.sign-btn').forEach(b => b.classList.remove('active'));
        btn.classList.add('active');
        renderSelectedFortune();
      });

      signsGrid.appendChild(btn);
    });
  }

  // Render Selected Fortune
  function renderSelectedFortune() {
    const list = currentTab === 'eastern' ? (isEn ? EASTERN_SIGNS_EN : EASTERN_SIGNS) : (isEn ? WESTERN_SIGNS_EN : WESTERN_SIGNS);
    let sign = list.find(s => s.id === currentSignId);
    if (!sign) {
      sign = list[0];
      currentSignId = sign.id;
    }

    const { dateKey, humanDate, tagDate } = getTodayInfo();
    if (fortuneDateTag) fortuneDateTag.textContent = `📅 ${tagDate}`;
    if (fortuneCardDate) fortuneCardDate.textContent = humanDate;

    const data = computeFortune(sign, dateKey);

    if (fortuneAvatar) fortuneAvatar.textContent = sign.icon;
    if (fortuneSignName) fortuneSignName.textContent = sign.name;
    if (fortuneSignSub) fortuneSignSub.textContent = sign.sub;

    if (fortuneScoreNum) fortuneScoreNum.textContent = String(data.overallScore);
    if (fortuneScoreGrade) fortuneScoreGrade.textContent = data.grade;
    if (fortuneScorePill) {
      fortuneScorePill.style.borderColor = `${data.gradeColor}60`;
      fortuneScorePill.style.backgroundColor = `${data.gradeColor}20`;
