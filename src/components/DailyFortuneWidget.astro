---
interface Props {
  title?: string;
  subtitle?: string;
  showSectionHeader?: boolean;
  lang?: 'ko' | 'en';
}

const {
  title,
  subtitle,
  showSectionHeader = true,
  lang = 'ko'
} = Astro.props;

const isEn = lang === 'en';
const widgetTitle = title ?? (isEn ? "Daily Horoscope & Fortune" : "오늘의 운세 (Daily Fortune)");
const widgetSubtitle = subtitle ?? (isEn ? "Personalized daily fortune for 12 Zodiac animals & 12 Astrological signs updated daily at midnight" : "매일 자정 자동으로 갱신되는 띠별 & 별자리별 맞춤형 하루 운세");
---

<div class="fortune-widget-root" id="daily-fortune-widget" data-lang={lang}>
  {showSectionHeader && (
    <div class="fortune-header">
      <div class="fortune-badge-row">
        <span class="fortune-badge">{isEn ? '✨ 100% Free Daily Horoscope' : '✨ 100% 무료 일일 운세'}</span>
        <span class="fortune-date-tag" id="fortune-current-date">{isEn ? 'Loading...' : '로딩 중...'}</span>
      </div>
      <h2 class="fortune-title">{widgetTitle}</h2>
      <p class="fortune-subtitle">{widgetSubtitle}</p>
    </div>
  )}

  <!-- Segmented Control (Tabs) -->
  <div class="fortune-tabs-container">
    <div class="fortune-tabs" role="tablist">
      <button class="fortune-tab active" data-tab="eastern" role="tab" aria-selected="true">
        <span class="tab-icon">🐾</span>
        <span class="tab-label">{isEn ? 'Zodiac Animals (12 Signs)' : '십이지간 (12 띠)'}</span>
      </button>
      <button class="fortune-tab" data-tab="western" role="tab" aria-selected="false">
        <span class="tab-icon">🌌</span>
        <span class="tab-label">{isEn ? 'Western Horoscope (12 Signs)' : '서양 별자리 (12 별자리)'}</span>
      </button>
    </div>
  </div>

  <!-- Sign Selection Grid -->
  <div class="signs-grid-wrapper">
    <div class="signs-grid" id="signs-grid">
      <!-- Injected via JavaScript -->
    </div>
  </div>

  <!-- Fortune Display Card -->
  <div class="fortune-card" id="fortune-card">
    <div class="card-glow-bg"></div>

    <!-- Card Header -->
    <div class="card-header">
      <div class="sign-identity">
        <div class="sign-avatar" id="fortune-avatar">🐯</div>
        <div class="sign-meta">
          <div class="sign-name-row">
            <h3 class="sign-name" id="fortune-sign-name">{isEn ? 'Tiger' : '호랑이띠'}</h3>
            <span class="sign-sub" id="fortune-sign-sub">{isEn ? "'50, '62, '74, '86, '98, '10" : '50, 62, 74, 86, 98, 10년생'}</span>
          </div>
          <span class="fortune-date-display" id="fortune-card-date">{isEn ? 'Sunday, September 6, 2026' : '2026년 9월 6일 일요일'}</span>
        </div>
      </div>

      <div class="score-badge-box">
        <span class="score-label">{isEn ? "Today's Overall Luck" : "오늘의 종합운"}</span>
        <div class="score-pill" id="fortune-score-pill">
          <span class="score-num" id="fortune-score-num">95</span><span class="score-unit">{isEn ? 'pts' : '점'}</span>
          <span class="score-grade" id="fortune-score-grade">{isEn ? 'Great Fortune 🌟' : '대길 (大吉)'}</span>
        </div>
      </div>
    </div>

    <!-- Main Overall Luck Meter Bar -->
    <div class="luck-meter-box">
      <div class="luck-meter-track">
        <div class="luck-meter-fill" id="fortune-meter-fill" style="width: 95%;"></div>
      </div>
    </div>

    <!-- Overview Text -->
    <div class="card-content">
      <h4 class="fortune-headline" id="fortune-headline">
        {isEn ? '"A golden day where your dedicated efforts bear bountiful fruits"' : '"노력의 결실이 눈앞에 다가오는 황금빛 하루"'}
      </h4>
      <p class="fortune-body" id="fortune-body">
        {isEn
          ? 'The sincere devotion and energy you have poured in quietly are culminating into meaningful achievements. With support and encouragement from those around you, new initiatives gain remarkable momentum.'
          : '그동안 묵묵히 쏟아부은 노력과 정성이 값진 결실로 이어지는 뜻깊은 하루입니다. 주변 사람들의 지지와 응원이 더해져 새로운 프로젝트나 도전에 탄력이 붙게 됩니다.'}
      </p>
    </div>

    <!-- Sub-Luck Metrics Grid -->
    <div class="sub-luck-grid">
      <div class="sub-luck-item">
        <div class="sub-luck-top">
          <span class="sub-luck-icon">💰</span>
          <span class="sub-luck-name">{isEn ? 'Wealth' : '금전운'}</span>
          <span class="sub-luck-score" id="luck-wealth-score">90%</span>
        </div>
        <div class="sub-luck-bar"><div class="sub-luck-fill" id="luck-wealth-bar" style="width: 90%;"></div></div>
        <p class="sub-luck-tip" id="luck-wealth-tip">{isEn ? 'Unexpected extra returns or pleasing financial bonuses are anticipated.' : '뜻밖의 작은 수익이나 보너스가 기대되는 날입니다.'}</p>
      </div>

      <div class="sub-luck-item">
        <div class="sub-luck-top">
          <span class="sub-luck-icon">❤️</span>
          <span class="sub-luck-name">{isEn ? 'Love' : '애정운'}</span>
          <span class="sub-luck-score" id="luck-love-score">85%</span>
        </div>
        <div class="sub-luck-bar"><div class="sub-luck-fill" id="luck-love-bar" style="width: 85%;"></div></div>
        <p class="sub-luck-tip" id="luck-love-tip">{isEn ? 'An ideal day for open, sincere dialogue to strengthen emotional trust.' : '솔직한 대화로 서로의 마음을 확인하기 좋은 날입니다.'}</p>
      </div>

      <div class="sub-luck-item">
        <div class="sub-luck-top">
          <span class="sub-luck-icon">💼</span>
          <span class="sub-luck-name">{isEn ? 'Career & Work' : '사업/학업'}</span>
          <span class="sub-luck-score" id="luck-work-score">95%</span>
        </div>
        <div class="sub-luck-bar"><div class="sub-luck-fill" id="luck-work-bar" style="width: 95%;"></div></div>
        <p class="sub-luck-tip" id="luck-work-tip">{isEn ? 'High focus and clarity enable rapid, efficient breakthroughs.' : '집중력이 최고조에 달해 빠른 성과를 얻을 수 있습니다.'}</p>
      </div>

      <div class="sub-luck-item">
        <div class="sub-luck-top">
          <span class="sub-luck-icon">🌿</span>
          <span class="sub-luck-name">{isEn ? 'Health' : '건강운'}</span>
          <span class="sub-luck-score" id="luck-health-score">80%</span>
        </div>
        <div class="sub-luck-bar"><div class="sub-luck-fill" id="luck-health-bar" style="width: 80%;"></div></div>
        <p class="sub-luck-tip" id="luck-health-tip">{isEn ? 'Maintain top physical condition with light stretching and plenty of water.' : '가벼운 스트레칭과 수분 섭취로 컨디션을 관리하세요.'}</p>
      </div>
    </div>

    <!-- Today's Do & Don't Section -->
    <div class="fortune-dodont-grid">
      <div class="dodont-card do-card">
        <div class="dodont-header">
          <span class="dodont-badge do-badge">{isEn ? "⭕ Today's DO" : "⭕ 오늘의 추천 (DO)"}</span>
        </div>
        <p class="dodont-text" id="fortune-do-text">{isEn ? 'Offer warm words of encouragement first' : '동료에게 먼저 따뜻한 격려 건네기'}</p>
      </div>
      <div class="dodont-card dont-card">
        <div class="dodont-header">
          <span class="dodont-badge dont-badge">{isEn ? "❌ Today's DON'T" : "❌ 오늘의 주의 (DON'T)"}</span>
        </div>
        <p class="dodont-text" id="fortune-dont-text">{isEn ? 'Hasty reactions to unverified rumors' : '확인되지 않은 소문에 섣부른 동요'}</p>
      </div>
    </div>

    <!-- Dynamic Section: Birth Years (Eastern) OR Astrological Analysis (Western) -->
    <div class="fortune-dynamic-container" id="fortune-dynamic-container">
      <!-- Injected via JavaScript -->
    </div>

    <!-- Lucky Items Pill Row -->
    <div class="lucky-items-container">
      <div class="lucky-items-title">{isEn ? "🍀 Today's Lucky Items & Keywords" : "🍀 오늘의 행운 아이템 & 키워드"}</div>
      <div class="lucky-pills-row">
        <div class="lucky-pill">
          <span class="pill-label">{isEn ? '🔢 Lucky Numbers' : '🔢 행운의 숫자'}</span>
          <strong class="pill-val" id="pill-number">7, 21</strong>
        </div>
        <div class="lucky-pill">
          <span class="pill-label">{isEn ? '🎨 Lucky Color' : '🎨 행운의 색상'}</span>
          <strong class="pill-val" id="pill-color">{isEn ? 'Gold Yellow' : '골드 옐로우'}</strong>
        </div>
        <div class="lucky-pill">
          <span class="pill-label">{isEn ? '🧭 Lucky Direction' : '🧭 행운의 방향'}</span>
          <strong class="pill-val" id="pill-direction">{isEn ? 'Southeast' : '동남쪽'}</strong>
        </div>
        <div class="lucky-pill">
          <span class="pill-label">{isEn ? '⏰ Lucky Time' : '⏰ 행운의 시간'}</span>
          <strong class="pill-val" id="pill-time">14:00 ~ 16:00</strong>
        </div>
        <div class="lucky-pill">
          <span class="pill-label">{isEn ? '🎒 Lucky Item' : '🎒 행운의 물건'}</span>
          <strong class="pill-val" id="pill-item">{isEn ? 'Warm Tea' : '따뜻한 차'}</strong>
        </div>
        <div class="lucky-pill">
          <span class="pill-label">{isEn ? '🍲 Lucky Food' : '🍲 행운의 음식'}</span>
          <strong class="pill-val" id="pill-food">{isEn ? 'Healthy Bowl' : '비빔밥'}</strong>
        </div>
      </div>
    </div>

    <!-- Card Action Buttons -->
    <div class="card-footer-actions">
      <button class="btn-copy-fortune" id="btn-copy-fortune" title={isEn ? "Copy today's fortune to clipboard" : "오늘의 운세를 클립보드에 복사"}>
        <span>{isEn ? '📋 Copy Fortune Text' : '📋 오늘 운세 텍스트 복사'}</span>
      </button>
      <span class="fortune-disclaimer">{isEn ? '※ Daily fortune is updated at midnight every day for entertainment purposes.' : '※ 오늘의 운세는 매일 자정 갱신되며, 하루의 활력을 위한 엔터테인먼트 정보입니다.'}</span>
    </div>
  </div>

  <!-- Toast Notification -->
  <div class="fortune-toast hidden" id="fortune-toast">
    <span>{isEn ? "✅ Today's fortune copied to clipboard!" : '✅ 오늘의 운세가 클립보드에 복사되었습니다!'}</span>
  </div>
</div>

<style>
  .fortune-widget-root {
    background: #0b1120;
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 20px;
    padding: 2rem 1.5rem;
    max-width: 1040px;
    margin: 0 auto;
    position: relative;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.5);
    box-sizing: border-box;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
  }

  .fortune-header {
    text-align: center;
    margin-bottom: 1.5rem;
  }

  .fortune-badge-row {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.6rem;
    margin-bottom: 0.5rem;
    flex-wrap: wrap;
  }

  .fortune-badge {
    display: inline-block;
    background: linear-gradient(135deg, #f59e0b, #ef4444);
    color: #ffffff;
    font-size: 0.72rem;
    font-weight: 800;
    padding: 0.2rem 0.6rem;
    border-radius: 6px;
    letter-spacing: -0.01em;
  }

  .fortune-date-tag {
    font-size: 0.75rem;
    font-weight: 700;
    color: #94a3b8;
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.08);
    padding: 0.18rem 0.55rem;
    border-radius: 6px;
  }

  .fortune-title {
    font-size: 1.85rem;
    font-weight: 900;
    color: #f8fafc;
    margin: 0.2rem 0 0.4rem;
    letter-spacing: -0.02em;
  }

  .fortune-subtitle {
    font-size: 0.92rem;
    color: #94a3b8;
    margin: 0;
  }

  /* Segmented Tabs */
  .fortune-tabs-container {
    display: flex;
    justify-content: center;
    margin-bottom: 1.25rem;
  }

  .fortune-tabs {
    display: inline-flex;
    background: rgba(15, 23, 42, 0.8);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 12px;
    padding: 4px;
    gap: 4px;
  }

  .fortune-tab {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.6rem 1.2rem;
    border: none;
    background: transparent;
    color: #94a3b8;
    font-size: 0.88rem;
    font-weight: 700;
    border-radius: 8px;
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .fortune-tab:hover {
    color: #f8fafc;
  }

  .fortune-tab.active {
    background: #1e293b;
    color: #38bdf8;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.4);
    border: 1px solid rgba(56, 189, 248, 0.3);
  }

  .tab-icon {
    font-size: 1.1rem;
  }

  /* Signs Grid */
  .signs-grid-wrapper {
    margin-bottom: 1.75rem;
  }

  .signs-grid {
    display: grid;
    grid-template-columns: repeat(6, 1fr);
    gap: 0.6rem;
  }

  :global(.sign-btn) {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 0.75rem 0.4rem;
    background: rgba(15, 23, 42, 0.6);
    border: 1px solid rgba(255, 255, 255, 0.06);
    border-radius: 12px;
    cursor: pointer;
    transition: all 0.2s ease;
    text-align: center;
  }

  :global(.sign-btn:hover) {
    background: rgba(30, 41, 59, 0.8);
    border-color: rgba(56, 189, 248, 0.3);
    transform: translateY(-2px);
  }

  :global(.sign-btn.active) {
    background: rgba(56, 189, 248, 0.12);
    border-color: #38bdf8;
    box-shadow: 0 0 15px rgba(56, 189, 248, 0.25);
  }

  :global(.sign-btn-icon) {
    font-size: 1.6rem;
    margin-bottom: 0.3rem;
    filter: drop-shadow(0 2px 4px rgba(0,0,0,0.5));
  }

  :global(.sign-btn-title) {
    font-size: 0.85rem;
    font-weight: 800;
    color: #f1f5f9;
    margin-bottom: 0.15rem;
  }

  :global(.sign-btn.active .sign-btn-title) {
    color: #38bdf8;
  }

  :global(.sign-btn-desc) {
    font-size: 0.68rem;
    color: #64748b;
    white-space: nowrap;
  }

  :global(.sign-btn.active .sign-btn-desc) {
    color: #94a3b8;
  }

  /* Fortune Card */
  .fortune-card {
    position: relative;
    background: #0f172a;
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 16px;
    padding: 1.75rem;
    overflow: hidden;
    box-shadow: 0 12px 36px rgba(0, 0, 0, 0.4);
  }

  .card-glow-bg {
    position: absolute;
    top: -50px;
    right: -50px;
    width: 200px;
    height: 200px;
    background: radial-gradient(circle, rgba(56, 189, 248, 0.12) 0%, transparent 70%);
    pointer-events: none;
    z-index: 0;
  }

  /* Card Header */
  .card-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 1.25rem;
    position: relative;
    z-index: 1;
    flex-wrap: wrap;
    gap: 1rem;
  }

  .sign-identity {
    display: flex;
    align-items: center;
    gap: 0.9rem;
  }

  .sign-avatar {
    width: 58px;
    height: 58px;
    background: linear-gradient(135deg, rgba(56, 189, 248, 0.15), rgba(168, 85, 247, 0.15));
    border: 1px solid rgba(56, 189, 248, 0.3);
    border-radius: 14px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 2.2rem;
  }

  .sign-name-row {
    display: flex;
    align-items: baseline;
    gap: 0.6rem;
    margin-bottom: 0.2rem;
  }

  .sign-name {
    font-size: 1.4rem;
    font-weight: 900;
    color: #f8fafc;
    margin: 0;
    letter-spacing: -0.01em;
  }

  .sign-sub {
    font-size: 0.78rem;
    color: #94a3b8;
    background: rgba(255, 255, 255, 0.05);
    padding: 0.15rem 0.5rem;
    border-radius: 4px;
  }

  .fortune-date-display {
    font-size: 0.78rem;
    color: #64748b;
  }

  .score-badge-box {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 0.25rem;
  }

  .score-label {
    font-size: 0.75rem;
    font-weight: 700;
    color: #94a3b8;
  }

  .score-pill {
    display: inline-flex;
    align-items: baseline;
    gap: 0.35rem;
    background: rgba(250, 204, 21, 0.15);
    border: 1px solid rgba(250, 204, 21, 0.4);
    padding: 0.35rem 0.85rem;
    border-radius: 999px;
  }

  .score-num {
    font-size: 1.45rem;
    font-weight: 900;
    color: #facc15;
    line-height: 1;
  }

  .score-unit {
    font-size: 0.85rem;
    color: #facc15;
    font-weight: 800;
  }

  .score-grade {
    font-size: 0.85rem;
    font-weight: 800;
    color: #fef08a;
    border-left: 1px solid rgba(250, 204, 21, 0.3);
    padding-left: 0.4rem;
  }

  /* Luck Meter Bar */
  .luck-meter-box {
    margin-bottom: 1.25rem;
    position: relative;
    z-index: 1;
  }

  .luck-meter-track {
    width: 100%;
    height: 7px;
    background: rgba(255, 255, 255, 0.08);
    border-radius: 4px;
    overflow: hidden;
  }

  .luck-meter-fill {
    height: 100%;
    background: linear-gradient(90deg, #38bdf8, #a855f7, #f59e0b);
    border-radius: 4px;
    transition: width 0.6s cubic-bezier(0.4, 0, 0.2, 1);
  }

  /* Headline & Body */
  .card-content {
    margin-bottom: 1.35rem;
    position: relative;
    z-index: 1;
  }

  .fortune-headline {
    font-size: 1.15rem;
    font-weight: 800;
    color: #38bdf8;
    margin: 0 0 0.65rem;
    line-height: 1.4;
  }

  .fortune-body {
    font-size: 0.92rem;
    color: #cbd5e1;
    line-height: 1.65;
    margin: 0;
  }

  /* Sub-Luck Grid */
  .sub-luck-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 0.85rem;
    margin-bottom: 1.25rem;
    position: relative;
    z-index: 1;
  }

  .sub-luck-item {
    background: rgba(30, 41, 59, 0.5);
    border: 1px solid rgba(255, 255, 255, 0.05);
    border-radius: 10px;
    padding: 0.75rem 0.85rem;
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
  }

  .sub-luck-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    font-size: 0.8rem;
    font-weight: 800;
  }

  .sub-luck-name {
    color: #f8fafc;
    flex: 1;
    margin-left: 0.35rem;
  }

  .sub-luck-score {
    color: #38bdf8;
  }

  .sub-luck-bar {
    width: 100%;
    height: 5px;
    background: rgba(255, 255, 255, 0.08);
    border-radius: 3px;
    overflow: hidden;
  }

  .sub-luck-fill {
    height: 100%;
    background: #38bdf8;
    border-radius: 3px;
    transition: width 0.5s ease;
  }

  .sub-luck-tip {
    font-size: 0.72rem;
    color: #94a3b8;
    line-height: 1.35;
    margin: 0;
  }

  /* Do & Don't */
  .fortune-dodont-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.85rem;
    margin-bottom: 1.25rem;
    position: relative;
    z-index: 1;
  }

  .dodont-card {
    border-radius: 10px;
    padding: 0.85rem 1rem;
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .do-card {
    background: rgba(34, 197, 94, 0.08);
    border: 1px solid rgba(34, 197, 94, 0.25);
  }

  .dont-card {
    background: rgba(239, 68, 68, 0.08);
    border: 1px solid rgba(239, 68, 68, 0.25);
  }

  .dodont-badge {
    font-size: 0.75rem;
    font-weight: 800;
  }

  .do-badge {
    color: #4ade80;
  }

  .dont-badge {
    color: #f87171;
  }

  .dodont-text {
    font-size: 0.85rem;
    font-weight: 600;
