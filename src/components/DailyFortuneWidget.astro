---
interface Props {
  title?: string;
  subtitle?: string;
  showSectionHeader?: boolean;
}

const {
  title = "오늘의 운세 (Daily Fortune)",
  subtitle = "매일 자정 자동으로 갱신되는 띠별 & 별자리별 맞춤형 하루 운세",
  showSectionHeader = true
} = Astro.props;
---

<div class="fortune-widget-root" id="daily-fortune-widget">
  {showSectionHeader && (
    <div class="fortune-header">
      <div class="fortune-badge-row">
        <span class="fortune-badge">✨ 100% 무료 일일 운세</span>
        <span class="fortune-date-tag" id="fortune-current-date">로딩 중...</span>
      </div>
      <h2 class="fortune-title">{title}</h2>
      <p class="fortune-subtitle">{subtitle}</p>
    </div>
  )}

  <!-- Segmented Control (Tabs) -->
  <div class="fortune-tabs-container">
    <div class="fortune-tabs" role="tablist">
      <button class="fortune-tab active" data-tab="eastern" role="tab" aria-selected="true">
        <span class="tab-icon">🐾</span>
        <span class="tab-label">십이지간 (12 띠)</span>
      </button>
      <button class="fortune-tab" data-tab="western" role="tab" aria-selected="false">
        <span class="tab-icon">🌌</span>
        <span class="tab-label">서양 별자리 (12 별자리)</span>
      </button>
    </div>
  </div>

  <!-- Sign Selection Grid -->
  <div class="signs-grid-wrapper">
    <div class="signs-grid" id="signs-grid">
      <!-- Injected via JavaScript -->
    </div>
  </div>

  <!-- Fortune Display Card -->
  <div class="fortune-card" id="fortune-card">
    <div class="card-glow-bg"></div>

    <!-- Card Header -->
    <div class="card-header">
      <div class="sign-identity">
        <div class="sign-avatar" id="fortune-avatar">🐯</div>
        <div class="sign-meta">
          <div class="sign-name-row">
            <h3 class="sign-name" id="fortune-sign-name">호랑이띠</h3>
            <span class="sign-sub" id="fortune-sign-sub">74, 86, 98년생</span>
          </div>
          <span class="fortune-date-display" id="fortune-card-date">2026년 9월 6일 일요일</span>
        </div>
      </div>

      <div class="score-badge-box">
        <span class="score-label">오늘의 종합운</span>
        <div class="score-pill" id="fortune-score-pill">
          <span class="score-num" id="fortune-score-num">95</span><span class="score-unit">점</span>
          <span class="score-grade" id="fortune-score-grade">대길 (大吉)</span>
        </div>
      </div>
    </div>

    <!-- Main Overall Luck Meter Bar -->
    <div class="luck-meter-box">
      <div class="luck-meter-track">
        <div class="luck-meter-fill" id="fortune-meter-fill" style="width: 95%;"></div>
      </div>
    </div>

    <!-- Overview Text -->
    <div class="card-content">
      <h4 class="fortune-headline" id="fortune-headline">
        "노력의 결실이 눈앞에 다가오는 황금빛 하루"
      </h4>
      <p class="fortune-body" id="fortune-body">
        그동안 묵묵히 쏟아부은 노력과 정성이 값진 결실로 이어지는 뜻깊은 하루입니다. 주변 사람들의 지지와 응원이 더해져 새로운 프로젝트나 도전에 탄력이 붙게 됩니다.
      </p>
    </div>

    <!-- Sub-Luck Metrics Grid -->
    <div class="sub-luck-grid">
      <div class="sub-luck-item">
        <div class="sub-luck-top">
          <span class="sub-luck-icon">💰</span>
          <span class="sub-luck-name">금전운</span>
          <span class="sub-luck-score" id="luck-wealth-score">90%</span>
        </div>
        <div class="sub-luck-bar"><div class="sub-luck-fill" id="luck-wealth-bar" style="width: 90%;"></div></div>
        <p class="sub-luck-tip" id="luck-wealth-tip">뜻밖의 작은 수익이나 보너스가 기대되는 날입니다.</p>
      </div>

      <div class="sub-luck-item">
        <div class="sub-luck-top">
          <span class="sub-luck-icon">❤️</span>
          <span class="sub-luck-name">애정운</span>
          <span class="sub-luck-score" id="luck-love-score">85%</span>
        </div>
        <div class="sub-luck-bar"><div class="sub-luck-fill" id="luck-love-bar" style="width: 85%;"></div></div>
        <p class="sub-luck-tip" id="luck-love-tip">솔직한 대화로 서로의 마음을 확인하기 좋은 날입니다.</p>
      </div>

      <div class="sub-luck-item">
        <div class="sub-luck-top">
          <span class="sub-luck-icon">💼</span>
          <span class="sub-luck-name">사업/학업</span>
          <span class="sub-luck-score" id="luck-work-score">95%</span>
        </div>
        <div class="sub-luck-bar"><div class="sub-luck-fill" id="luck-work-bar" style="width: 95%;"></div></div>
        <p class="sub-luck-tip" id="luck-work-tip">집중력이 최고조에 달해 빠른 성과를 얻을 수 있습니다.</p>
      </div>

      <div class="sub-luck-item">
        <div class="sub-luck-top">
          <span class="sub-luck-icon">🌿</span>
          <span class="sub-luck-name">건강운</span>
          <span class="sub-luck-score" id="luck-health-score">80%</span>
        </div>
        <div class="sub-luck-bar"><div class="sub-luck-fill" id="luck-health-bar" style="width: 80%;"></div></div>
        <p class="sub-luck-tip" id="luck-health-tip">가벼운 스트레칭과 수분 섭취로 컨디션을 관리하세요.</p>
      </div>
    </div>

    <!-- Lucky Items Pill Row -->
    <div class="lucky-items-container">
      <div class="lucky-items-title">🍀 오늘의 행운 아이템</div>
      <div class="lucky-pills-row">
        <div class="lucky-pill">
          <span class="pill-label">🔢 행운의 숫자</span>
          <strong class="pill-val" id="pill-number">7</strong>
        </div>
        <div class="lucky-pill">
          <span class="pill-label">🎨 행운의 색상</span>
          <strong class="pill-val" id="pill-color">골드 옐로우</strong>
        </div>
        <div class="lucky-pill">
          <span class="pill-label">🧭 행운의 방향</span>
          <strong class="pill-val" id="pill-direction">동남쪽</strong>
        </div>
        <div class="lucky-pill">
          <span class="pill-label">⏰ 행운의 시간</span>
          <strong class="pill-val" id="pill-time">14:00 ~ 16:00</strong>
        </div>
        <div class="lucky-pill">
          <span class="pill-label">🎒 행운의 물건</span>
          <strong class="pill-val" id="pill-item">따뜻한 차</strong>
        </div>
      </div>
    </div>

    <!-- Card Action Buttons -->
    <div class="card-footer-actions">
      <button class="btn-copy-fortune" id="btn-copy-fortune" title="오늘의 운세를 클립보드에 복사">
        <span>📋 오늘 운세 텍스트 복사</span>
      </button>
      <span class="fortune-disclaimer">※ 오늘의 운세는 매일 자정 갱신되며, 하루의 활력을 위한 엔터테인먼트 정보입니다.</span>
    </div>
  </div>

  <!-- Toast Notification -->
  <div class="fortune-toast hidden" id="fortune-toast">
    <span>✅ 오늘의 운세가 클립보드에 복사되었습니다!</span>
  </div>
</div>

<style>
  .fortune-widget-root {
    background: #0b1120;
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 20px;
    padding: 2rem 1.5rem;
    max-width: 1040px;
    margin: 0 auto;
    position: relative;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.5);
    box-sizing: border-box;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
  }

  .fortune-header {
    text-align: center;
    margin-bottom: 1.5rem;
  }

  .fortune-badge-row {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.6rem;
    margin-bottom: 0.5rem;
    flex-wrap: wrap;
  }

  .fortune-badge {
    display: inline-block;
    background: linear-gradient(135deg, #f59e0b, #ef4444);
    color: #ffffff;
    font-size: 0.72rem;
    font-weight: 800;
    padding: 0.2rem 0.6rem;
    border-radius: 6px;
    letter-spacing: -0.01em;
  }

  .fortune-date-tag {
    font-size: 0.75rem;
    font-weight: 700;
    color: #94a3b8;
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.08);
    padding: 0.18rem 0.55rem;
    border-radius: 6px;
  }

  .fortune-title {
    font-size: 1.85rem;
    font-weight: 900;
    color: #f8fafc;
    margin: 0.2rem 0 0.4rem;
    letter-spacing: -0.02em;
  }

  .fortune-subtitle {
    font-size: 0.92rem;
    color: #94a3b8;
    margin: 0;
  }

  /* Segmented Tabs */
  .fortune-tabs-container {
    display: flex;
    justify-content: center;
    margin-bottom: 1.25rem;
  }

  .fortune-tabs {
    display: inline-flex;
    background: rgba(15, 23, 42, 0.8);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 12px;
    padding: 0.3rem;
    gap: 0.3rem;
  }

  .fortune-tab {
    background: transparent;
    border: none;
    color: #94a3b8;
    padding: 0.5rem 1.2rem;
    border-radius: 8px;
    font-size: 0.86rem;
    font-weight: 800;
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    transition: all 0.15s ease;
  }

  .fortune-tab:hover {
    color: #f8fafc;
    background: rgba(255, 255, 255, 0.04);
  }

  .fortune-tab.active {
    background: linear-gradient(135deg, #a855f7, #38bdf8);
    color: #ffffff;
    box-shadow: 0 0 16px rgba(56, 189, 248, 0.35);
  }

  /* Signs Grid */
  .signs-grid-wrapper {
    margin-bottom: 1.5rem;
  }

  .signs-grid {
    display: grid;
    grid-template-columns: repeat(6, 1fr);
    gap: 0.5rem;
  }

  @media (max-width: 768px) {
    .signs-grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  @media (max-width: 480px) {
    .signs-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  :global(.sign-btn) {
    background: #0f172a;
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 10px;
    padding: 0.5rem 0.3rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.2rem;
    cursor: pointer;
    transition: all 0.15s ease;
    text-align: center;
    box-sizing: border-box;
    width: 100%;
  }

  :global(.sign-btn:hover) {
    border-color: rgba(56, 189, 248, 0.4);
    background: rgba(255, 255, 255, 0.05);
    transform: translateY(-2px);
  }

  :global(.sign-btn.active) {
    background: rgba(56, 189, 248, 0.14);
    border-color: #38bdf8;
    box-shadow: 0 0 14px rgba(56, 189, 248, 0.3);
    transform: translateY(-2px);
  }

  :global(.sign-btn-icon) {
    font-size: 1.4rem;
    line-height: 1;
  }

  :global(.sign-btn-title) {
    font-size: 0.76rem;
    font-weight: 800;
    color: #f8fafc;
  }

  :global(.sign-btn-desc) {
    font-size: 0.62rem;
    font-weight: 600;
    color: #64748b;
  }

  :global(.sign-btn.active .sign-btn-title) {
    color: #38bdf8;
  }

  :global(.sign-btn.active .sign-btn-desc) {
    color: #94a3b8;
  }

  /* Fortune Card */
  .fortune-card {
    background: #0f172a;
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 16px;
    padding: 1.75rem;
    position: relative;
    overflow: hidden;
    box-shadow: 0 12px 35px rgba(0, 0, 0, 0.5);
  }

  .card-glow-bg {
    position: absolute;
    top: -50px;
    right: -50px;
    width: 250px;
    height: 250px;
    background: radial-gradient(circle, rgba(168, 85, 247, 0.18) 0%, rgba(56, 189, 248, 0.05) 50%, transparent 70%);
    pointer-events: none;
  }

  .card-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 1rem;
    margin-bottom: 1.2rem;
  }

  .sign-identity {
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .sign-avatar {
    font-size: 2.4rem;
    width: 60px;
    height: 60px;
    background: rgba(56, 189, 248, 0.12);
    border: 2px solid rgba(56, 189, 248, 0.3);
    border-radius: 14px;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    box-shadow: 0 0 20px rgba(56, 189, 248, 0.2);
  }

  .sign-meta {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }

  .sign-name-row {
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
  }

  .sign-name {
    font-size: 1.45rem;
    font-weight: 900;
    color: #f8fafc;
    margin: 0;
  }

  .sign-sub {
    font-size: 0.78rem;
    color: #94a3b8;
    font-weight: 700;
  }

  .fortune-date-display {
    font-size: 0.78rem;
    color: #64748b;
    font-weight: 600;
  }

  .score-badge-box {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 0.25rem;
  }

  .score-label {
    font-size: 0.72rem;
    font-weight: 800;
    color: #94a3b8;
  }

  .score-pill {
    background: rgba(250, 204, 21, 0.15);
    border: 1px solid rgba(250, 204, 21, 0.35);
    border-radius: 8px;
    padding: 0.25rem 0.65rem;
    display: flex;
    align-items: baseline;
    gap: 0.3rem;
  }

  .score-num {
    font-size: 1.3rem;
    font-weight: 900;
    color: #facc15;
  }

  .score-unit {
    font-size: 0.75rem;
    color: #fde68a;
    font-weight: 800;
  }

  .score-grade {
    font-size: 0.75rem;
    font-weight: 800;
    color: #fde68a;
    padding-left: 0.25rem;
    border-left: 1px solid rgba(250, 204, 21, 0.3);
  }

  /* Luck Meter Track */
  .luck-meter-box {
    margin-bottom: 1.3rem;
  }

  .luck-meter-track {
    width: 100%;
    height: 10px;
    background: rgba(255, 255, 255, 0.08);
    border-radius: 5px;
    overflow: hidden;
    box-shadow: inset 0 1px 3px rgba(0, 0, 0, 0.4);
  }

  .luck-meter-fill {
    height: 100%;
    background: linear-gradient(90deg, #38bdf8 0%, #a855f7 50%, #facc15 100%);
    border-radius: 5px;
    transition: width 0.6s cubic-bezier(0.16, 1, 0.3, 1);
    box-shadow: 0 0 10px rgba(250, 204, 21, 0.4);
  }

  /* Card Content */
  .card-content {
    background: rgba(255, 255, 255, 0.02);
    border: 1px solid rgba(255, 255, 255, 0.05);
    border-radius: 12px;
    padding: 1.15rem 1.25rem;
    margin-bottom: 1.25rem;
  }

  .fortune-headline {
    font-size: 1.15rem;
    font-weight: 800;
    color: #facc15;
    margin: 0 0 0.5rem;
    line-height: 1.4;
  }

  .fortune-body {
    font-size: 0.92rem;
    color: #e2e8f0;
    line-height: 1.65;
    margin: 0;
  }

  /* Sub-Luck Grid */
  .sub-luck-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 0.75rem;
    margin-bottom: 1.25rem;
  }

  @media (max-width: 768px) {
    .sub-luck-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  .sub-luck-item {
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid rgba(255, 255, 255, 0.06);
    border-radius: 10px;
    padding: 0.85rem 0.9rem;
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .sub-luck-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    font-size: 0.8rem;
    font-weight: 800;
  }

  .sub-luck-name {
    color: #f8fafc;
    flex: 1;
    margin-left: 0.35rem;
  }

  .sub-luck-score {
    color: #38bdf8;
  }

  .sub-luck-bar {
    width: 100%;
    height: 5px;
    background: rgba(255, 255, 255, 0.08);
    border-radius: 3px;
    overflow: hidden;
  }

  .sub-luck-fill {
    height: 100%;
    background: #38bdf8;
    border-radius: 3px;
    transition: width 0.5s ease;
  }

  .sub-luck-tip {
    font-size: 0.72rem;
    color: #94a3b8;
    line-height: 1.35;
    margin: 0;
  }

  /* Lucky Items Pills */
  .lucky-items-container {
    background: rgba(255, 255, 255, 0.02);
    border: 1px solid rgba(255, 255, 255, 0.05);
    border-radius: 12px;
    padding: 1rem 1.15rem;
    margin-bottom: 1.25rem;
  }

  .lucky-items-title {
    font-size: 0.8rem;
    font-weight: 800;
    color: #facc15;
    margin-bottom: 0.65rem;
  }

  .lucky-pills-row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .lucky-pill {
    background: #1e293b;
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 8px;
    padding: 0.35rem 0.65rem;
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.75rem;
  }

  .pill-label {
    color: #94a3b8;
    font-weight: 600;
  }

  .pill-val {
    color: #f8fafc;
    font-weight: 800;
  }

  /* Card Footer Actions */
  .card-footer-actions {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 0.8rem;
    padding-top: 0.5rem;
    border-top: 1px solid rgba(255, 255, 255, 0.06);
  }

  .btn-copy-fortune {
    background: rgba(56, 189, 248, 0.12);
    border: 1px solid rgba(56, 189, 248, 0.3);
    color: #38bdf8;
    font-size: 0.82rem;
    font-weight: 800;
    padding: 0.5rem 1rem;
    border-radius: 8px;
    cursor: pointer;
    transition: all 0.15s ease;
  }

  .btn-copy-fortune:hover {
    background: rgba(56, 189, 248, 0.22);
    color: #ffffff;
    border-color: #38bdf8;
    box-shadow: 0 0 12px rgba(56, 189, 248, 0.3);
  }

  .fortune-disclaimer {
    font-size: 0.72rem;
    color: #64748b;
  }

  /* Toast */
  .fortune-toast {
    position: fixed;
    bottom: 2rem;
    left: 50%;
    transform: translateX(-50%);
    background: #0f172a;
    border: 1px solid #10b981;
    color: #10b981;
    padding: 0.65rem 1.4rem;
    border-radius: 10px;
    font-size: 0.85rem;
    font-weight: 800;
    box-shadow: 0 10px 25px rgba(0, 0, 0, 0.6);
    z-index: 1000;
    transition: opacity 0.3s ease, transform 0.3s ease;
  }

  .fortune-toast.hidden {
    opacity: 0;
    pointer-events: none;
    transform: translate(-50%, 15px);
  }
</style>

<script>
  interface SignData {
    id: string;
    name: string;
    icon: string;
    sub: string;
    type: 'eastern' | 'western';
  }

  // 12 띠 (Eastern Zodiac)
  const EASTERN_SIGNS: SignData[] = [
    { id: 'rat', name: '쥐띠', icon: '🐭', sub: '72, 84, 96, 08년', type: 'eastern' },
    { id: 'ox', name: '소띠', icon: '🐂', sub: '73, 85, 97, 09년', type: 'eastern' },
    { id: 'tiger', name: '호랑이띠', icon: '🐯', sub: '74, 86, 98, 10년', type: 'eastern' },
    { id: 'rabbit', name: '토끼띠', icon: '🐰', sub: '75, 87, 99, 11년', type: 'eastern' },
    { id: 'dragon', name: '용띠', icon: '🐲', sub: '76, 88, 00, 12년', type: 'eastern' },
