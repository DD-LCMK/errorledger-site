    const dontBadge = document.getElementById('dodont-dont-badge');
    if (dontBadge) {
      dontBadge.textContent = isTomorrow
        ? (isEn ? "❌ Tomorrow's DON'T" : "❌ 내일의 주의 (DON'T)")
        : (isEn ? "❌ Today's DON'T" : "❌ 오늘의 주의 (DON'T)");
    }

    if (streamerSectionTitle) {
      streamerSectionTitle.textContent = isTomorrow
        ? (isEn ? "Tomorrow's Streamer Luck & Broadcast Guide" : "내일의 방송·스트리머 운세 & 방송 가이드")
        : (isEn ? "Today's Streamer Luck & Broadcast Guide" : "오늘의 방송·스트리머 운세 & 방송 가이드");
    }

    if (btnCopyFortune) {
      const copySpan = btnCopyFortune.querySelector('span');
      if (copySpan) {
        copySpan.textContent = isTomorrow
          ? (isEn ? "📋 Copy Tomorrow's Fortune" : "📋 내일 운세 텍스트 복사")
          : (isEn ? "📋 Copy Fortune Text" : "📋 오늘 운세 텍스트 복사");
      }
    }

    const data = computeFortune(sign, dateKey);

    if (fortuneAvatar) fortuneAvatar.textContent = sign.icon;
    if (fortuneSignName) fortuneSignName.textContent = sign.name;
    if (fortuneSignSub) fortuneSignSub.textContent = sign.sub;

    if (fortuneScoreNum) fortuneScoreNum.textContent = String(data.overallScore);
    if (fortuneScoreGrade) fortuneScoreGrade.textContent = data.grade;
    if (fortuneScorePill) {
      fortuneScorePill.style.borderColor = `${data.gradeColor}60`;
      fortuneScorePill.style.backgroundColor = `${data.gradeColor}20`;
    }

    if (fortuneMeterFill) {
      fortuneMeterFill.style.width = `${data.overallScore}%`;
    }

    if (fortuneHeadline) fortuneHeadline.textContent = `"${data.headline}"`;
    if (fortuneBody) fortuneBody.textContent = data.body;

    // Sub metrics
    if (luckWealthScore) luckWealthScore.textContent = `${data.wealth.score}%`;
    if (luckWealthBar) luckWealthBar.style.width = `${data.wealth.score}%`;
    if (luckWealthTip) luckWealthTip.textContent = data.wealth.tip;

    if (luckLoveScore) luckLoveScore.textContent = `${data.love.score}%`;
    if (luckLoveBar) luckLoveBar.style.width = `${data.love.score}%`;
    if (luckLoveTip) luckLoveTip.textContent = data.love.tip;

    if (luckWorkScore) luckWorkScore.textContent = `${data.work.score}%`;
    if (luckWorkBar) luckWorkBar.style.width = `${data.work.score}%`;
    if (luckWorkTip) luckWorkTip.textContent = data.work.tip;

    if (luckHealthScore) luckHealthScore.textContent = `${data.health.score}%`;
    if (luckHealthBar) luckHealthBar.style.width = `${data.health.score}%`;
    if (luckHealthTip) luckHealthTip.textContent = data.health.tip;

    // Do & Don't
    if (fortuneDoText) fortuneDoText.textContent = data.doText;
    if (fortuneDontText) fortuneDontText.textContent = data.dontText;

    // Streamer Section updates
    if (streamerTensionScore) streamerTensionScore.textContent = `${data.streamerTensionScore}%`;
    if (streamerTensionFill) streamerTensionFill.style.width = `${data.streamerTensionScore}%`;
    if (streamerTensionDesc) streamerTensionDesc.textContent = data.streamerTensionDesc;
    if (streamerTensionBadge) {
      streamerTensionBadge.textContent = `⚡ ${isEn ? 'Tension: ' : '방송 텐션: '}${data.streamerTensionScore}%`;
    }
    if (streamerContentTip) streamerContentTip.textContent = data.streamerContent;
    if (streamerChatTip) streamerChatTip.textContent = data.streamerChatTip;
    if (streamerDonationTip) streamerDonationTip.textContent = data.streamerDonationTip;
    if (streamerGoldenTime) streamerGoldenTime.textContent = data.streamerGoldenHour;

    // Dynamic Section: Eastern (Birth Years) vs Western (Horoscope Profile)
    if (fortuneDynamicContainer) {
      if (currentTab === 'eastern') {
        const rowsHtml = data.yearFortunes.map(item => `
          <div class="year-fortune-row">
            <span class="year-badge">${isEn ? `Year ${item.year} ('${item.shortYear})` : `${item.year}년 (${item.shortYear}년생)`}</span>
            <p class="year-fortune-text">${item.text}</p>
          </div>
        `).join('');

        fortuneDynamicContainer.innerHTML = `
          <div class="dynamic-section-title">
            <span>${isEn ? '📅 Personalized Fortune by Birth Year' : '📅 출생 연도별 맞춤 운세'}</span>
          </div>
          <div class="year-fortune-list">
            ${rowsHtml}
          </div>
        `;
      } else {
        fortuneDynamicContainer.innerHTML = `
          <div class="dynamic-section-title">
            <span>${isEn ? '🌌 In-Depth Astrological Profile & Compatibility' : '🌌 별자리 심층 분석 & 궁합'}</span>
          </div>
          <div class="western-info-grid">
            <div class="western-info-card">
              <div class="western-info-label">${isEn ? '🪐 Ruling Planet & Nature' : '🪐 수호행성 & 기질'}</div>
              <p class="western-info-val">${sign.planet || (isEn ? 'Ruling Planet' : '수호성')}</p>
            </div>
            <div class="western-info-card">
              <div class="western-info-label">${isEn ? '💖 Best Match' : '💖 오늘의 찰떡 궁합'}</div>
              <p class="western-info-val" style="color: #f472b6;">${sign.bestMatch || (isEn ? 'Sagittarius' : '사수자리')} ${isEn ? '(High Synergy)' : '(상승 시너지)'}</p>
            </div>
            <div class="western-info-card">
              <div class="western-info-label">${isEn ? '⚠️ Caution Match' : '⚠️ 오늘의 주의 궁합'}</div>
              <p class="western-info-val" style="color: #fb923c;">${sign.cautionMatch || (isEn ? 'Taurus' : '황소자리')} ${isEn ? '(Careful Communication)' : '(소통 배려 필요)'}</p>
            </div>
          </div>
        `;
      }
    }

    // Pills
    if (pillNumber) pillNumber.textContent = data.luckyNums;
    if (pillColor) pillColor.textContent = data.luckyColor;
    if (pillDirection) pillDirection.textContent = data.luckyDir;
    if (pillTime) pillTime.textContent = data.luckyTime;
    if (pillItem) pillItem.textContent = data.luckyItem;
    if (pillFood) pillFood.textContent = data.luckyFood;
  }

  // Date Toggle Buttons (Today vs Tomorrow)
  document.querySelectorAll('.date-toggle-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      const offset = parseInt(btn.getAttribute('data-offset') || '0', 10);
      if (offset === currentDateOffset) return;
      currentDateOffset = offset;
      document.querySelectorAll('.date-toggle-btn').forEach(b => b.classList.remove('active'));
      btn.classList.add('active');
      renderSelectedFortune();
    });
  });

  // Segmented Tabs Switch
  document.querySelectorAll('.fortune-tab').forEach(tab => {
    tab.addEventListener('click', () => {
      const target = tab.getAttribute('data-tab') as 'eastern' | 'western';
      if (target === currentTab) return;

      currentTab = target;
      document.querySelectorAll('.fortune-tab').forEach(t => {
        t.classList.remove('active');
        t.setAttribute('aria-selected', 'false');
      });
      tab.classList.add('active');
      tab.setAttribute('aria-selected', 'true');

      // Set default sign for tab
      currentSignId = currentTab === 'eastern' ? 'tiger' : 'leo';

      renderSignsGrid();
      renderSelectedFortune();
    });
  });

  // Copy to Clipboard
  btnCopyFortune?.addEventListener('click', () => {
    const list = currentTab === 'eastern' ? (isEn ? EASTERN_SIGNS_EN : EASTERN_SIGNS) : (isEn ? WESTERN_SIGNS_EN : WESTERN_SIGNS);
    const sign = list.find(s => s.id === currentSignId) || list[0];
    const { humanDate } = getDateInfo(currentDateOffset);
    const isTomorrow = currentDateOffset === 1;

    const score = fortuneScoreNum?.textContent || '90';
    const grade = fortuneScoreGrade?.textContent || (isEn ? 'Great Fortune' : '대길');
    const title = fortuneHeadline?.textContent || '';
    const body = fortuneBody?.textContent || '';
    const doAct = fortuneDoText?.textContent || '';
    const dontAct = fortuneDontText?.textContent || '';
    const num = pillNumber?.textContent || '';
    const color = pillColor?.textContent || '';
    const dir = pillDirection?.textContent || '';
    const food = pillFood?.textContent || '';

    const tensionVal = streamerTensionScore?.textContent || '95%';
    const tensionDesc = streamerTensionDesc?.textContent || '';
    const sContent = streamerContentTip?.textContent || '';
    const sChat = streamerChatTip?.textContent || '';
    const sDonation = streamerDonationTip?.textContent || '';
    const sTime = streamerGoldenTime?.textContent || '';

    const textToCopy = isEn
      ? `[${isTomorrow ? "Tomorrow's Fortune Preview" : "Daily Fortune"} - ${humanDate}]\n` +
        `✨ ${sign.name} (${sign.icon}): Overall Luck ${score} pts (${grade})\n` +
        `${title}\n\n` +
        `${body}\n\n` +
        `⭕ ${isTomorrow ? "Tomorrow's" : "Today's"} DO: ${doAct}\n` +
        `❌ ${isTomorrow ? "Tomorrow's" : "Today's"} DON'T: ${dontAct}\n` +
        `🍀 Lucky Numbers: ${num} | Color: ${color} | Direction: ${dir} | Food: ${food}\n\n` +
        `🎬 Streamer Guide:\n` +
        `  ⚡ Broadcast Tension: ${tensionVal} (${tensionDesc})\n` +
        `  🎮 Recommended Content: ${sContent}\n` +
        `  💬 Chat Interaction: ${sChat}\n` +
        `  🎁 Donation Luck: ${sDonation}\n` +
        `  ⏰ Golden Streaming Hour: ${sTime}`
      : `[${isTomorrow ? '내일의 운세 미리보기' : '오늘의 운세'} - ${humanDate}]\n` +
        `✨ ${sign.name} (${sign.icon}): 종합운 ${score}점 (${grade})\n` +
        `${title}\n\n` +
        `${body}\n\n` +
        `⭕ ${isTomorrow ? '내일의' : '오늘의'} 추천: ${doAct}\n` +
        `❌ ${isTomorrow ? '내일의' : '오늘의'} 주의: ${dontAct}\n` +
        `🍀 행운의 숫자: ${num} | 색상: ${color} | 방향: ${dir} | 음식: ${food}\n\n` +
        `🎬 방송·스트리머 가이드:\n` +
        `  ⚡ 방송 텐션: ${tensionVal} (${tensionDesc})\n` +
        `  🎮 추천 콘텐츠: ${sContent}\n` +
        `  💬 시청자 소통: ${sChat}\n` +
        `  🎁 후원/도네 길운: ${sDonation}\n` +
        `  ⏰ 방송 골든타임: ${sTime}`;

    if (navigator.clipboard && navigator.clipboard.writeText) {
      navigator.clipboard.writeText(textToCopy).then(() => {
        showToast();
      }).catch(() => {
        fallbackCopy(textToCopy);
      });
    } else {
      fallbackCopy(textToCopy);
    }
  });

  function fallbackCopy(text: string) {
    const ta = document.createElement('textarea');
    ta.value = text;
    ta.style.position = 'fixed';
    ta.style.opacity = '0';
    document.body.appendChild(ta);
    ta.select();
    try {
      document.execCommand('copy');
      showToast();
    } finally {
      document.body.removeChild(ta);
    }
  }

  function showToast() {
    if (!fortuneToast) return;
    fortuneToast.classList.remove('hidden');
    setTimeout(() => {
      fortuneToast.classList.add('hidden');
    }, 2400);
  }

  // Initial render
  renderSignsGrid();
  renderSelectedFortune();
</script>
