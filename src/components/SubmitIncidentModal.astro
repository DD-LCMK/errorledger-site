---
// SubmitIncidentModal.astro
---

<div id="submit-incident-modal" class="modal-overlay">
  <div class="modal-card">
    <div class="modal-top-accent"></div>

    <button id="close-modal-btn" class="close-btn" aria-label="Close modal">
      &times;
    </button>

    <!-- Header -->
    <div class="modal-header">
      <div class="intake-badge">
        <span class="intake-dot"></span>
        <span class="intake-badge-text" id="modal-intake-badge-text">Anonymous Encrypted Intake</span>
      </div>
      <h3 class="modal-title" id="modal-title-text">Submit an Incident to the Ledger</h3>
      <p class="modal-subtitle" id="modal-subtitle-text">Every mistake leaves a story. All identifying names and credentials are scrubbed prior to archival review.</p>
    </div>

    <!-- Multi-Step Form -->
    <form id="incident-form" class="modal-form">
      <div class="form-group">
        <label class="form-label" for="inc-title" id="lbl-inc-title">1. Incident Headline</label>
        <input 
          type="text" 
          id="inc-title" 
          required 
          placeholder="e.g. I sent a compensation spreadsheet to the whole office"
          class="form-input"
        />
      </div>

      <div class="form-row">
        <div class="form-group">
          <label class="form-label" for="inc-cat" id="lbl-inc-cat">2. Category</label>
          <select id="inc-cat" class="form-select">
            <option value="work">🧑‍💻 Work & Career</option>
            <option value="money">💰 Money & Finance</option>
            <option value="corporate">🏢 Corporate & Infrastructure</option>
            <option value="ai">🤖 AI & Automation</option>
            <option value="internet">🌐 Internet & Social</option>
            <option value="relationships">❤️ Relationships</option>
          </select>
        </div>
        <div class="form-group">
          <label class="form-label" for="inc-damage" id="lbl-inc-damage">3. Blast Radius</label>
          <select id="inc-damage" class="form-select">
            <option value="minor">Minor Embarrassment (&lt; $10k)</option>
            <option value="serious">Org-Wide Fallout ($10k - $1M)</option>
            <option value="catastrophic">Existential Crisis (&gt; $1M)</option>
          </select>
        </div>
      </div>

      <div class="form-group">
        <label class="form-label" for="inc-body" id="lbl-inc-body">4. What Actually Happened?</label>
        <textarea 
          id="inc-body" 
          rows="4" 
          required 
          placeholder="Describe the initial decision, the moment of realization, and who took the blame..."
          class="form-textarea"
        ></textarea>
      </div>

      <div class="form-footer">
        <span class="protocol-tag" id="modal-protocol-tag">🔒 Tier 2 Submission Protocol</span>
        <button type="submit" class="submit-action-btn" id="modal-submit-btn">
          Submit to Archivist &rarr;
        </button>
      </div>
    </form>

    <!-- Success Confirmation View -->
    <div id="form-success-view" class="success-view hidden">
      <div class="success-icon">&check;</div>
      <h4 class="success-title" id="modal-success-title">Incident Recorded in Intake Queue</h4>
      <p class="success-desc" id="modal-success-desc">
        Your submission has been sealed. The Archivist reviews incoming leads for Tier 2 narrative reconstruction.
      </p>
      <button id="close-success-btn" class="return-btn" id="modal-return-btn">
        Return to the Ledger
      </button>
    </div>
  </div>
</div>

<script is:inline>
  (function() {
    function getModal() {
      return document.getElementById('submit-incident-modal');
    }

    function localizeModal() {
      const isKo = document.documentElement.lang === 'ko' || window.location.pathname.startsWith('/ko');
      if (!isKo) return;

      const badgeText = document.getElementById('modal-intake-badge-text');
      if (badgeText) badgeText.innerText = "익명 암호화 제보 창구";

      const titleText = document.getElementById('modal-title-text');
      if (titleText) titleText.innerText = "에러레저 사건 제보하기";

      const subText = document.getElementById('modal-subtitle-text');
      if (subText) subText.innerText = "모든 실수는 이야기를 남깁니다. 모든 개인 식별 정보는 편집진 검토 전 안전하게 가명 처리됩니다.";

      const lblTitle = document.getElementById('lbl-inc-title');
      if (lblTitle) lblTitle.innerText = "1. 사건 한 줄 요약 (헤드라인)";
      const inputTitle = document.getElementById('inc-title');
      if (inputTitle) inputTitle.placeholder = "예: 전체 사내 메일로 연봉 협상 엑셀 파일을 잘못 전송했습니다";

      const lblCat = document.getElementById('lbl-inc-cat');
      if (lblCat) lblCat.innerText = "2. 카테고리";
      const selectCat = document.getElementById('inc-cat');
      if (selectCat) {
        selectCat.innerHTML = `
          <option value="work">🧑‍💻 직장 & 커리어</option>
          <option value="money">💰 금융 & 경제</option>
          <option value="corporate">🏢 기업 & 인프라</option>
          <option value="ai">🤖 AI & 자동화</option>
          <option value="internet">🌐 인터넷 & 사회</option>
          <option value="relationships">❤️ 인간관계</option>
        `;
      }

      const lblDamage = document.getElementById('lbl-inc-damage');
      if (lblDamage) lblDamage.innerText = "3. 피해 규모";
      const selectDamage = document.getElementById('inc-damage');
      if (selectDamage) {
        selectDamage.innerHTML = `
          <option value="minor">사소한 해프닝 (< 1,000만원)</option>
          <option value="serious">조직/부서 마비 (1천만원 ~ 10억원)</option>
          <option value="catastrophic">전사적 파탄 위기 (> 10억원)</option>
        `;
      }

      const lblBody = document.getElementById('lbl-inc-body');
      if (lblBody) lblBody.innerText = "4. 실제로 무슨 일이 일어났습니까?";
      const inputBody = document.getElementById('inc-body');
      if (inputBody) inputBody.placeholder = "처음 내린 결정, 실수를 깨달은 순간, 그리고 누가 책임을 졌는지 적어주세요...";

      const protocolTag = document.getElementById('modal-protocol-tag');
      if (protocolTag) protocolTag.innerText = "🔒 Tier 2 제보자 보호 프로토콜";

      const submitBtn = document.getElementById('modal-submit-btn');
      if (submitBtn) submitBtn.innerText = "아키비스트에게 제보하기 →";

      const succTitle = document.getElementById('modal-success-title');
      if (succTitle) succTitle.innerText = "제보가 안전하게 인테이크 큐에 봉인되었습니다";

      const succDesc = document.getElementById('modal-success-desc');
      if (succDesc) succDesc.innerText = "제보해 주셔서 감사합니다. 아키비스트가 검토 후 Tier 2 서사적 재구성 작업을 진행합니다.";

      const returnBtn = document.getElementById('close-success-btn');
      if (returnBtn) returnBtn.innerText = "에러레저로 돌아가기";
    }

    function openModal() {
      localizeModal();
      const modal = getModal();
      if (modal) modal.style.display = 'flex';
    }

    function closeModal() {
      const modal = getModal();
      if (modal) modal.style.display = 'none';
    }

    // Global event delegation for all submit triggers across the entire page
    document.addEventListener('click', function(e) {
      if (e.target.closest('[data-open-submit-modal]')) {
        e.preventDefault();
        openModal();
      }
      if (e.target.closest('#close-modal-btn') || e.target.closest('#close-success-btn')) {
        e.preventDefault();
        closeModal();
      }
      const modal = getModal();
      if (e.target === modal) {
        closeModal();
      }
    });

    document.addEventListener('submit', function(e) {
      if (e.target && e.target.id === 'incident-form') {
        e.preventDefault();
        const title = document.getElementById('inc-title')?.value || '';
        const cat = document.getElementById('inc-cat')?.value || 'work';
        const damage = document.getElementById('inc-damage')?.value || 'minor';
        const body = document.getElementById('inc-body')?.value || '';

        const submission = { title, cat, damage, body, date: new Date().toISOString() };
        const existing = JSON.parse(localStorage.getItem('errorledger_submissions') || '[]');
        existing.push(submission);
        localStorage.setItem('errorledger_submissions', JSON.stringify(existing));

        const form = document.getElementById('incident-form');
        const successView = document.getElementById('form-success-view');
        if (form) form.classList.add('hidden');
        if (successView) successView.classList.remove('hidden');
      }
    });
  })();
</script>

<style>
  .modal-overlay {
    position: fixed;
    top: 0;
    left: 0;
    width: 100vw;
    height: 100vh;
    background: rgba(0, 0, 0, 0.85);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    z-index: 99999;
    display: none;
    align-items: center;
    justify-content: center;
    padding: 1rem;
    box-sizing: border-box;
  }

  .modal-card {
    background: #171717;
    border: 1px solid #333333;
    border-radius: 16px;
    width: 100%;
    max-width: 540px;
    padding: 2rem;
    position: relative;
    box-shadow: 0 25px 60px rgba(0, 0, 0, 0.8);
    color: #f5f5f5;
    box-sizing: border-box;
    overflow: hidden;
  }

  .modal-top-accent {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 4px;
    background: linear-gradient(90deg, #f59e0b, #f43f5e, #ef4444);
  }

  .close-btn {
    position: absolute;
    top: 1rem;
    right: 1.25rem;
    background: transparent;
    border: none;
    color: #a3a3a3;
    font-size: 1.75rem;
    cursor: pointer;
    line-height: 1;
    padding: 0.25rem;
    border-radius: 6px;
  }
  .close-btn:hover {
    color: #ffffff;
    background: #262626;
  }

  .modal-header {
    margin-bottom: 1.5rem;
  }
  .intake-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    margin-bottom: 0.5rem;
  }
  .intake-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background-color: #10b981;
    display: inline-block;
  }
  .intake-badge-text {
    font-family: ui-monospace, monospace;
    font-size: 0.72rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: #34d399;
  }

  .modal-title {
    font-size: 1.4rem;
    font-weight: 800;
    margin: 0 0 0.4rem 0;
    color: #ffffff;
    letter-spacing: -0.015em;
  }
  .modal-subtitle {
    font-size: 0.85rem;
    color: #a3a3a3;
    margin: 0;
    line-height: 1.5;
  }

  .modal-form {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }
  .form-group {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    flex: 1;
  }
  .form-row {
    display: flex;
    gap: 0.75rem;
  }
  @media (max-width: 500px) {
    .form-row {
      flex-direction: column;
    }
  }

  .form-label {
    font-family: ui-monospace, monospace;
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    color: #d4d4d4;
    letter-spacing: 0.025em;
  }

  .form-input, .form-select, .form-textarea {
    width: 100%;
    background: #0a0a0a;
    border: 1px solid #262626;
    border-radius: 8px;
    padding: 0.65rem 0.85rem;
    color: #f5f5f5;
    font-size: 0.9rem;
    font-family: inherit;
    box-sizing: border-box;
    outline: none;
    transition: border-color 0.15s ease;
  }
  .form-input:focus, .form-select:focus, .form-textarea:focus {
    border-color: #f43f5e;
    box-shadow: 0 0 0 2px rgba(244, 63, 94, 0.2);
  }

  .form-textarea {
    resize: vertical;
    min-height: 85px;
    line-height: 1.5;
  }

  .form-footer {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-top: 0.5rem;
    padding-top: 0.75rem;
  }
  .protocol-tag {
    font-family: ui-monospace, monospace;
    font-size: 0.72rem;
    color: #737373;
  }

  .submit-action-btn {
    background: linear-gradient(135deg, #f43f5e, #e11d48);
    color: #ffffff;
    border: none;
    border-radius: 8px;
    padding: 0.6rem 1.15rem;
    font-size: 0.85rem;
    font-weight: 700;
    cursor: pointer;
    box-shadow: 0 4px 12px rgba(244, 63, 94, 0.3);
    transition: transform 0.15s ease, background 0.15s ease;
  }
  .submit-action-btn:hover {
    transform: translateY(-1px);
    background: linear-gradient(135deg, #fb7185, #f43f5e);
  }

  .success-view {
    text-align: center;
    padding: 2rem 0;
  }
  .success-icon {
    width: 48px;
    height: 48px;
    border-radius: 50%;
    background: rgba(16, 185, 129, 0.12);
    border: 1px solid rgba(16, 185, 129, 0.3);
    color: #10b981;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.5rem;
    font-weight: 900;
    margin: 0 auto 1rem auto;
  }
  .success-title {
    font-size: 1.25rem;
    font-weight: 800;
    margin: 0 0 0.5rem 0;
    color: #ffffff;
  }
  .success-desc {
    font-size: 0.85rem;
    color: #a3a3a3;
    line-height: 1.5;
    margin: 0 0 1.25rem 0;
  }
  .return-btn {
    background: transparent;
    border: 1px solid #262626;
    color: #f43f5e;
    font-family: ui-monospace, monospace;
    font-size: 0.8rem;
    padding: 0.5rem 1rem;
    border-radius: 6px;
    cursor: pointer;
  }
  .return-btn:hover {
    background: #262626;
  }

  .hidden {
    display: none !important;
  }

  /* Light mode styles */
  :global(html:not(.dark)) .modal-card {
    background: #ffffff;
    border-color: #cbd5e1;
    color: #0f172a;
    box-shadow: 0 25px 60px rgba(0, 0, 0, 0.2);
  }
  :global(html:not(.dark)) .modal-title { color: #0f172a; }
  :global(html:not(.dark)) .modal-subtitle { color: #475569; }
  :global(html:not(.dark)) .form-group label { color: #1e293b; }
  :global(html:not(.dark)) .form-input,
  :global(html:not(.dark)) .form-select,
  :global(html:not(.dark)) .form-textarea {
    background: #f8fafc;
    border-color: #cbd5e1;
    color: #0f172a;
  }
  :global(html:not(.dark)) .form-input:focus,
  :global(html:not(.dark)) .form-select:focus,
  :global(html:not(.dark)) .form-textarea:focus {
    border-color: #f43f5e;
    background: #ffffff;
  }
  :global(html:not(.dark)) .close-btn { color: #64748b; }
  :global(html:not(.dark)) .close-btn:hover { color: #0f172a; }
  :global(html:not(.dark)) .success-title { color: #0f172a; }
  :global(html:not(.dark)) .success-desc { color: #475569; }
</style>
