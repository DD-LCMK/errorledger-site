---
// SubmitIncidentModal.astro
---

<div id="submit-incident-modal" class="modal-overlay">
  <div class="modal-card">
    <div class="modal-top-accent"></div>

    <button id="close-modal-btn" class="close-btn" aria-label="Close modal">
      &times;
    </button>

    <!-- Header -->
    <div class="modal-header">
      <div class="intake-badge">
        <span class="intake-dot"></span>
        <span class="intake-badge-text">Anonymous Encrypted Intake</span>
      </div>
      <h3 class="modal-title">Submit an Incident to the Ledger</h3>
      <p class="modal-subtitle">Every mistake leaves a story. All identifying names and credentials are scrubbed prior to archival review.</p>
    </div>

    <!-- Multi-Step Form -->
    <form id="incident-form" class="modal-form">
      <div class="form-group">
        <label class="form-label" for="inc-title">1. Incident Headline</label>
        <input 
          type="text" 
          id="inc-title" 
          required 
          placeholder="e.g. I sent a compensation spreadsheet to the whole office"
          class="form-input"
        />
      </div>

      <div class="form-row">
        <div class="form-group">
          <label class="form-label" for="inc-cat">2. Category</label>
          <select id="inc-cat" class="form-select">
            <option value="work">🧑‍💻 Work & Career</option>
            <option value="money">💰 Money & Finance</option>
            <option value="corporate">🏢 Corporate & Infrastructure</option>
            <option value="ai">🤖 AI & Automation</option>
            <option value="internet">🌐 Internet & Social</option>
            <option value="relationships">❤️ Relationships</option>
          </select>
        </div>
        <div class="form-group">
          <label class="form-label" for="inc-damage">3. Blast Radius</label>
          <select id="inc-damage" class="form-select">
            <option value="minor">Minor Embarrassment (&lt; $10k)</option>
            <option value="serious">Org-Wide Fallout ($10k - $1M)</option>
            <option value="catastrophic">Existential Crisis (&gt; $1M)</option>
          </select>
        </div>
      </div>

      <div class="form-group">
        <label class="form-label" for="inc-body">4. What Actually Happened?</label>
        <textarea 
          id="inc-body" 
          rows="4" 
          required 
          placeholder="Describe the initial decision, the moment of realization, and who took the blame..."
          class="form-textarea"
        ></textarea>
      </div>

      <div class="form-footer">
        <span class="protocol-tag">🔒 Tier 2 Submission Protocol</span>
        <button type="submit" class="submit-action-btn">
          Submit to Archivist &rarr;
        </button>
      </div>
    </form>

    <!-- Success Confirmation View -->
    <div id="form-success-view" class="success-view hidden">
      <div class="success-icon">&check;</div>
      <h4 class="success-title">Incident Recorded in Intake Queue</h4>
      <p class="success-desc">
        Your submission has been sealed. The Archivist reviews incoming leads for Tier 2 narrative reconstruction.
      </p>
      <button id="close-success-btn" class="return-btn">
        Return to the Ledger
      </button>
    </div>
  </div>
</div>

<script is:inline>
  (function() {
    function getModal() {
      return document.getElementById('submit-incident-modal');
    }

    function openModal() {
      const modal = getModal();
      if (modal) modal.style.display = 'flex';
    }

    function closeModal() {
      const modal = getModal();
      if (modal) modal.style.display = 'none';
    }

    // Global event delegation for all submit triggers across the entire page
    document.addEventListener('click', function(e) {
      if (e.target.closest('[data-open-submit-modal]')) {
        e.preventDefault();
        openModal();
      }
      if (e.target.closest('#close-modal-btn') || e.target.closest('#close-success-btn')) {
        e.preventDefault();
        closeModal();
      }
      const modal = getModal();
      if (e.target === modal) {
        closeModal();
      }
    });

    document.addEventListener('submit', function(e) {
      if (e.target && e.target.id === 'incident-form') {
        e.preventDefault();
        const title = document.getElementById('inc-title')?.value || '';
        const cat = document.getElementById('inc-cat')?.value || 'work';
        const damage = document.getElementById('inc-damage')?.value || 'minor';
        const body = document.getElementById('inc-body')?.value || '';

        const submission = { title, cat, damage, body, date: new Date().toISOString() };
        const existing = JSON.parse(localStorage.getItem('errorledger_submissions') || '[]');
        existing.push(submission);
        localStorage.setItem('errorledger_submissions', JSON.stringify(existing));

        const form = document.getElementById('incident-form');
        const successView = document.getElementById('form-success-view');
        if (form) form.classList.add('hidden');
        if (successView) successView.classList.remove('hidden');
      }
    });
  })();
</script>

<style>
  .modal-overlay {
    position: fixed;
    top: 0;
    left: 0;
    width: 100vw;
    height: 100vh;
    background: rgba(0, 0, 0, 0.85);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    z-index: 99999;
    display: none;
    align-items: center;
    justify-content: center;
    padding: 1rem;
    box-sizing: border-box;
  }

  .modal-card {
    background: #171717;
    border: 1px solid #333333;
    border-radius: 16px;
    width: 100%;
    max-width: 540px;
    padding: 2rem;
    position: relative;
    box-shadow: 0 25px 60px rgba(0, 0, 0, 0.8);
    color: #f5f5f5;
    box-sizing: border-box;
    overflow: hidden;
  }

  .modal-top-accent {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 4px;
    background: linear-gradient(90deg, #f59e0b, #f43f5e, #ef4444);
  }

  .close-btn {
    position: absolute;
    top: 1rem;
    right: 1.25rem;
    background: transparent;
    border: none;
    color: #a3a3a3;
    font-size: 1.75rem;
    cursor: pointer;
    line-height: 1;
    padding: 0.25rem;
    border-radius: 6px;
  }
  .close-btn:hover {
    color: #ffffff;
    background: #262626;
  }

  .modal-header {
    margin-bottom: 1.5rem;
  }
  .intake-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    margin-bottom: 0.5rem;
  }
  .intake-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background-color: #10b981;
    display: inline-block;
  }
  .intake-badge-text {
    font-family: ui-monospace, monospace;
    font-size: 0.72rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: #34d399;
  }

  .modal-title {
    font-size: 1.4rem;
    font-weight: 800;
    margin: 0 0 0.4rem 0;
    color: #ffffff;
    letter-spacing: -0.015em;
  }
  .modal-subtitle {
    font-size: 0.85rem;
    color: #a3a3a3;
    margin: 0;
    line-height: 1.5;
  }

  .modal-form {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }
  .form-group {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    flex: 1;
  }
  .form-row {
    display: flex;
    gap: 0.75rem;
  }
  @media (max-width: 500px) {
    .form-row {
      flex-direction: column;
    }
  }

  .form-label {
    font-family: ui-monospace, monospace;
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    color: #d4d4d4;
    letter-spacing: 0.025em;
  }

  .form-input, .form-select, .form-textarea {
    width: 100%;
    background: #0a0a0a;
    border: 1px solid #262626;
    border-radius: 8px;
    padding: 0.65rem 0.85rem;
    color: #f5f5f5;
    font-size: 0.9rem;
    font-family: inherit;
    box-sizing: border-box;
    outline: none;
    transition: border-color 0.15s ease;
  }
  .form-input:focus, .form-select:focus, .form-textarea:focus {
    border-color: #f43f5e;
    box-shadow: 0 0 0 2px rgba(244, 63, 94, 0.2);
  }

  .form-textarea {
    resize: vertical;
    min-height: 85px;
    line-height: 1.5;
  }

  .form-footer {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-top: 0.5rem;
    padding-top: 0.75rem;
  }
  .protocol-tag {
    font-family: ui-monospace, monospace;
    font-size: 0.72rem;
    color: #737373;
  }

  .submit-action-btn {
    background: linear-gradient(135deg, #f43f5e, #e11d48);
    color: #ffffff;
    border: none;
    border-radius: 8px;
    padding: 0.6rem 1.15rem;
    font-size: 0.85rem;
    font-weight: 700;
    cursor: pointer;
    box-shadow: 0 4px 12px rgba(244, 63, 94, 0.3);
    transition: transform 0.15s ease, background 0.15s ease;
  }
  .submit-action-btn:hover {
    transform: translateY(-1px);
    background: linear-gradient(135deg, #fb7185, #f43f5e);
  }

  .success-view {
    text-align: center;
    padding: 2rem 0;
  }
  .success-icon {
    width: 48px;
    height: 48px;
    border-radius: 50%;
    background: rgba(16, 185, 129, 0.12);
    border: 1px solid rgba(16, 185, 129, 0.3);
    color: #10b981;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.5rem;
    font-weight: 900;
    margin: 0 auto 1rem auto;
  }
  .success-title {
    font-size: 1.25rem;
    font-weight: 800;
    margin: 0 0 0.5rem 0;
    color: #ffffff;
  }
  .success-desc {
    font-size: 0.85rem;
    color: #a3a3a3;
    line-height: 1.5;
    margin: 0 0 1.25rem 0;
  }
  .return-btn {
    background: transparent;
    border: 1px solid #262626;
    color: #f43f5e;
    font-family: ui-monospace, monospace;
    font-size: 0.8rem;
    padding: 0.5rem 1rem;
    border-radius: 6px;
    cursor: pointer;
  }
  .return-btn:hover {
    background: #262626;
  }

  .hidden {
    display: none !important;
  }
</style>
