    function renderHighlights(data: any) {
      const h = data.highlights || {};
      const hoursCollected = num(data.meta?.hours_collected);
      if (hoursCollected === 0) {
        elHighlights.hidden = true;
        return;
      }

      const chips: { icon: string; title: string; detail: string }[] = [];

      // Peak / Calmest KST hour
      if (h.peak_mod_hour_kst != null) {
        const peakH = typeof h.peak_mod_hour_kst === 'object' ? h.peak_mod_hour_kst.hour_kst : h.peak_mod_hour_kst;
        const peakVal = typeof h.peak_mod_hour_kst === 'object' ? h.peak_mod_hour_kst.mod_per_10k_chats : null;
        const calmH =
          h.calmest_mod_hour_kst != null
            ? typeof h.calmest_mod_hour_kst === 'object'
              ? h.calmest_mod_hour_kst.hour_kst
              : h.calmest_mod_hour_kst
            : null;
        let detail = `가장 치열한 시간 ${String(peakH).padStart(2, '0')}시`;
        if (peakVal != null) detail += ` (${fmtDec(peakVal, 1)}건/1만)`;
        if (calmH != null) detail += ` · 가장 평온 ${String(calmH).padStart(2, '0')}시`;
        chips.push({ icon: '🕒', title: '시간대 피크', detail });
      }

      // Highest intensity category
      if (h.highest_intensity_category != null) {
        const rawName =
          typeof h.highest_intensity_category === 'object'
            ? h.highest_intensity_category.name
            : h.highest_intensity_category;
        const rate =
          typeof h.highest_intensity_category === 'object'
            ? h.highest_intensity_category.mod_per_10k_chats
            : null;
        const catName = mapLabel(String(rawName));
        chips.push({
          icon: '🔥',
          title: '제재율 최고 카테고리',
          detail: rate != null ? `${catName} (1만 채팅당 ${fmtDec(rate, 1)}건)` : catName,
        });
      }

      // Riskiest chat pattern
      if (h.riskiest_chat_pattern != null) {
        const key =
          typeof h.riskiest_chat_pattern === 'object'
            ? h.riskiest_chat_pattern.pattern || h.riskiest_chat_pattern.key || h.riskiest_chat_pattern.name
            : String(h.riskiest_chat_pattern);
        const pMeta = PATTERN_LABELS[String(key)];
        const patObj = data.troll_insights?.blinded_message_patterns?.[String(key)];
        const mult =
          (typeof h.riskiest_chat_pattern === 'object' ? h.riskiest_chat_pattern.risk_vs_normal : null) ??
          patObj?.risk_vs_normal;
        const label = pMeta ? pMeta.label : String(key);
        chips.push({
          icon: '⚠️',
          title: '최고 위험 채팅 패턴',
          detail: mult && num(mult) > 0 ? `${label} — 일반 채팅 대비 ${fmtDec(mult, 1)}배` : label,
        });
      }

      // Zero perm-ban streams
      if (num(data.stream_calmness_48h?.total_observed_streams) > 0) {
        chips.push({
          icon: '🕊️',
          title: '영구차단 0건 방송',
          detail: `전체 관측 방송의 ${fmtDec(h.zero_perm_ban_streams_pct, 1)}%가 영구차단 없이 평온 유지`,
        });
      }

      // Timeout pardon rate
      if (num(data.timeout_insights?.total) > 0) {
        chips.push({
          icon: '🔓',
          title: '임시제한 사면율',
          detail: `조기 해제 ${fmtDec(h.timeout_pardon_rate_pct, 1)}% · 재범 비율 ${fmtDec(h.repeat_timeout_pct, 1)}%`,
        });
      }

      if (chips.length === 0) {
        elHighlights.hidden = true;
        return;
      }

      elHighlights.hidden = false;
      elHighlights.innerHTML = chips
        .slice(0, 4)
        .map(
          (ch) => `
          <div class="highlight-chip">
            <span class="hl-ico">${ch.icon}</span>
            <div class="hl-text">
              <span class="hl-title">${escapeHtml(ch.title)}</span>
              <strong class="hl-detail">${escapeHtml(ch.detail)}</strong>
            </div>
          </div>
        `
        )
        .join('');
    }

    function renderActionBreakdown(data: any) {
      const ab = data.action_breakdown || {};
      const trends = data.trends_24h || {};
      const permTotal = ab.perm_bans_total || { count: 0, pct: 0 };
      const permDelta = renderTrendBadge(trends.delta_pct?.perm_bans_total, Boolean(trends.ready), true);
      elPermbanPill.innerHTML = `영구차단 ${fmtInt(permTotal.count)}건 (${fmtDec(permTotal.pct, 1)}%) ${permDelta}`;

      const items = [
        { key: 'cleanbot_blinds', label: '클린봇 블라인드', color: '#818cf8', data: ab.cleanbot_blinds },
        { key: 'manual_single_blinds', label: '단기 블라인드 (매니저)', color: '#38bdf8', data: ab.manual_single_blinds },
        { key: 'timeouts', label: '임시제한 (채팅금지)', color: '#f59e0b', data: ab.timeouts },
        { key: 'perm_bans_explicit', label: '영구차단 (명시적)', color: '#ef4444', data: ab.perm_bans_explicit },
        { key: 'perm_bans_inferred', label: '다중 블라인드 추정 영차', color: '#ec4899', data: ab.perm_bans_inferred },
      ];

      const totalCount = items.reduce((acc, it) => acc + num(it.data?.count), 0);
      const r = 46;
      const circ = 2 * Math.PI * r;
      let offset = 0;

      const slices =
        totalCount > 0
          ? items
              .map((it) => {
                const cnt = num(it.data?.count);
                const frac = cnt / totalCount;
                const dash = frac * circ;
                const seg = `<circle cx="60" cy="60" r="${r}" fill="none" stroke="${it.color}" stroke-width="14" stroke-dasharray="${dash.toFixed(2)} ${(circ - dash).toFixed(2)}" stroke-dashoffset="${(-offset).toFixed(2)}" transform="rotate(-90 60 60)" />`;
                offset += dash;
                return seg;
              })
              .join('')
          : `<circle cx="60" cy="60" r="${r}" fill="none" stroke="#1e293b" stroke-width="14" />`;

      elActionBreakdown.innerHTML = `
        <div class="donut-wrap">
          <svg viewBox="0 0 120 120" class="donut-svg" aria-label="제재 유형 비율 차트">
            ${slices}
            <text x="60" y="56" text-anchor="middle" fill="#94a3b8" font-size="9" font-weight="700">총 제재</text>
            <text x="60" y="72" text-anchor="middle" fill="#f8fafc" font-size="14" font-weight="800" font-family="monospace">${totalCount > 0 ? fmtCompactKo(totalCount) : '0'}</text>
          </svg>
        </div>
        <div class="donut-legend">
          ${items
            .map((it) => {
              const cnt = num(it.data?.count);
              const pct = num(it.data?.pct);
              return `
                <div class="legend-row">
                  <div class="legend-meta">
                    <span class="leg-dot" style="background:${it.color}"></span>
                    <span class="leg-name">${escapeHtml(it.label)}</span>
                    <span class="leg-val">${fmtInt(cnt)}건 <small>(${fmtDec(pct, 1)}%)</small></span>
                  </div>
                  <div class="leg-bar-track">
                    <div class="leg-bar-fill" style="width:${Math.min(100, pct)}%; background:${it.color}"></div>
                  </div>
                </div>
              `;
            })
            .join('')}
        </div>
      `;
    }

