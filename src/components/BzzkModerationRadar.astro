    // ─── 5. Troll Funnel & Human-Blinded Message Risk ─────────────────────────
    function renderTrollFunnel(data: any) {
      const ti = data.troll_insights || {};
      const sum = data.summary_48h || {};
      const funnel = ti.multi_channel_funnel || {};
      const tiers = ti.auto_ban_tiers || {};

      const multiUsers =
        sum.multi_channel_offenders != null
          ? num(sum.multi_channel_offenders)
          : num(funnel['2_channels']?.users) +
            num(funnel['3_to_4_channels']?.users) +
            num(funnel['5_plus_channels']?.users);
      const multiPct = num(sum.multi_channel_offender_pct ?? data.highlights?.multi_channel_offender_pct);
      elTrollSharePill.textContent = `다채널 ${fmtInt(multiUsers)}명 (${fmtDec(multiPct, 1)}%)`;

      const steps = [
        { key: '1_channel', fallback: '1개 채널 (단발성)', data: funnel['1_channel'], color: '#64748b' },
        { key: '2_channels', fallback: '2개 채널', data: funnel['2_channels'], color: '#38bdf8' },
        { key: '3_to_4_channels', fallback: '3~4개 채널', data: funnel['3_to_4_channels'], color: '#f59e0b' },
        { key: '5_plus_channels', fallback: '5개 이상 채널 (상습 분탕)', data: funnel['5_plus_channels'], color: '#ef4444' },
      ];

      const maxUsers = Math.max(1, ...steps.map((s) => num(s.data?.users)));

      const tierList = [
        { code: 'T1', name: '지속 누적', val: num(tiers.tier1_persistent) },
        { code: 'T2', name: '일일 급증', val: num(tiers.tier2_daily) },
        { code: 'T3', name: '단기 폭주', val: num(tiers.tier3_velocity) },
        { code: 'T4', name: '복합 패턴', val: num(tiers.tier4_hybrid) },
        { code: 'T5', name: '채금 다발', val: num(tiers.tier5_timeout) },
        { code: 'T6', name: '블라인드 다발', val: num(tiers.tier6_blind) },
      ];
      const totalTierHits = tierList.reduce((acc, t) => acc + t.val, 0);

      elTrollFunnel.innerHTML = `
        <div class="funnel-list">
          ${steps
            .map((s) => {
              const label = s.data?.label_kr || s.fallback;
              const users = num(s.data?.users);
              const pct = num(s.data?.pct);
              const barW = users > 0 ? Math.max(4, (users / maxUsers) * 100) : 0;
              return `
                <div class="funnel-row">
                  <div class="funnel-meta">
                    <span class="fn-label">${escapeHtml(label)}</span>
                    <span class="fn-val"><strong>${fmtInt(users)}명</strong> <small>(${fmtDec(pct, 2)}%)</small></span>
                  </div>
                  <div class="leg-bar-track">
                    <div class="leg-bar-fill" style="width:${barW}%; background:${s.color}"></div>
                  </div>
                </div>
              `;
            })
            .join('')}
        </div>

        <div class="troll-summary-strip">
          <div class="tss-item">
            <span class="tss-lbl">다중 채널 제재 (2개+)</span>
            <strong>${fmtInt(multiUsers)}명 <small>(${fmtDec(multiPct, 2)}%)</small></strong>
          </div>
          <div class="tss-item">
            <span class="tss-lbl">기등록 트롤 감시 활동</span>
            <strong>제재 ${fmtInt(sum.known_troll_actions)}건 <small>(채팅 ${fmtInt(sum.known_troll_chats)}건 · ${fmtDec(sum.known_troll_share_pct, 2)}%)</small></strong>
          </div>
        </div>

        ${
          totalTierHits > 0
            ? `
          <div class="tiers-divider">
            <span>자동 차단 룰 티어별 신규 탐지</span>
            <small>총 ${fmtInt(totalTierHits)}건</small>
          </div>
          <div class="tier-pills-grid">
            ${tierList
              .map(
                (t) => `
                <div class="tier-pill-box">
                  <span class="tp-code">${t.code}</span>
                  <span class="tp-name">${escapeHtml(t.name)}</span>
                  <strong class="tp-val">${fmtInt(t.val)}</strong>
                </div>
              `
              )
              .join('')}
          </div>
        `
            : ''
        }
      `;
    }

    function renderPatternInsights(data: any) {
      const mp = data.troll_insights?.blinded_message_patterns || {};
      const totalMatched = num(mp.total_matched);
      const totalClassified = num(mp.total_chats_classified);
      const hoursCovered = mp.hours_covered != null ? num(mp.hours_covered) : null;
      const fallbackToAllChats = totalMatched === 0 && totalClassified > 0;

      elPatternTotalPill.textContent =
        totalMatched > 0
          ? `매칭 표본 ${fmtInt(totalMatched)}건`
          : totalClassified > 0
            ? `분류 채팅 ${fmtCompactKo(totalClassified)}건`
            : '표본 0건';

      const keys: Array<'url' | 'flood' | 'long_text' | 'short_text' | 'normal'> = [
        'url',
        'flood',
        'long_text',
        'short_text',
        'normal',
      ];

      let scopeBanner = '';
      if (fallbackToAllChats) {
        scopeBanner = `<div class="pattern-scope-note">수동 블라인드 원문 매칭 표본 누적 중 · 현재 전체 분류 채팅(${fmtCompactKo(totalClassified)}건) 패턴 분포 표시</div>`;
      } else if (totalMatched > 0) {
        const hrsTxt = hoursCovered != null && hoursCovered > 0 ? `최근 ${fmtInt(hoursCovered)}시간 기준 ` : '';
        scopeBanner = `<div class="pattern-scope-note">${hrsTxt}매니저 수동 블라인드 매칭 표본 <strong>${fmtInt(totalMatched)}건</strong> (비교 모수 ${fmtCompactKo(totalClassified)}건)</div>`;
      }

      const maxBlindRate = Math.max(
        0.1,
        ...keys.map((k) => num(mp[k]?.blind_per_10k_chats))
      );

      elPatternInsights.innerHTML =
        scopeBanner +
        keys
          .map((k) => {
            const meta = PATTERN_META[k];
            const row = mp[k] || {};
            const label = row.label_kr || meta.fallbackLabel;

            if (fallbackToAllChats) {
              const chatPct = num(row.all_chat_pct);
              return `
                <div class="pattern-row">
                  <div class="pattern-top">
                    <span class="pat-name">${meta.icon} ${escapeHtml(label)}</span>
                    <div class="pat-right">
                      <span class="pat-pct">${fmtDec(chatPct, 2)}%</span>
                      <span class="risk-badge risk-base">${fmtCompactKo(row.all_chat_count)}건</span>
                    </div>
                  </div>
                  <div class="leg-bar-track">
                    <div class="leg-bar-fill" style="width:${Math.min(100, chatPct)}%; background:${meta.color}"></div>
                  </div>
                </div>
              `;
            }

            const risk = num(row.risk_vs_normal);
            const blindPer10k = num(row.blind_per_10k_chats);
            const barW =
              blindPer10k > 0
                ? Math.min(100, Math.max(4, (blindPer10k / maxBlindRate) * 100))
                : Math.min(100, num(row.pct));
            const riskCls = risk >= 2.5 ? 'risk-high' : risk >= 1.3 ? 'risk-med' : 'risk-base';
            const riskLabel =
              k === 'normal'
                ? '기준 (1.00배)'
                : totalMatched > 0 && risk > 0
                  ? `${fmtDec(risk, 2)}배 위험`
                  : '—';

            return `
              <div class="pattern-row">
                <div class="pattern-top">
                  <span class="pat-name">${meta.icon} ${escapeHtml(label)}</span>
                  <div class="pat-right">
                    <span class="pat-pct">1만당 ${fmtDec(blindPer10k, 2)}건</span>
                    <span class="risk-badge ${riskCls}">${riskLabel}</span>
                  </div>
                </div>
                <div class="leg-bar-track">
                  <div class="leg-bar-fill" style="width:${barW}%; background:${meta.color}"></div>
                </div>
                <div class="pattern-foot">
                  <span>매칭 ${fmtInt(row.count)}건 (블라인드 중 ${fmtDec(row.pct, 1)}%)</span>
                  <span>전체 채팅 중 ${fmtDec(row.all_chat_pct, 2)}%</span>
                </div>
              </div>
            `;
          })
          .join('');
    }

    // ─── 6. Two-Tier Category & Segment Explorer ──────────────────────────────
    function syncGenrePillUI() {
      document.querySelectorAll<HTMLButtonElement>('#radar-cat-genre-pills .sort-pill').forEach((b) => {
        b.classList.toggle('active', b.dataset.genre === catGenreFilter);
      });
    }

    function renderMacroGenres(data: any) {
      const groups = Array.isArray(data.by_category_group_48h) ? data.by_category_group_48h : [];
      if (groups.length === 0) {
        elMacroGenres.hidden = true;
        return;
      }
      elMacroGenres.hidden = false;

      const shareSegs = groups
        .map((g: any) => {
          const gKey = String(g.group_key || 'ETC');
          const st = MACRO_GENRE_STYLE[gKey] || MACRO_GENRE_STYLE.ETC;
          const pct = num(g.share_of_total_chats_pct);
          return `<span style="width:${Math.max(pct > 0 ? 0.6 : 0, pct)}%; background:${st.color}" title="${escapeHtml(g.group_label_kr || g.name)}: 채팅 점유율 ${fmtDec(pct, 2)}%"></span>`;
        })
        .join('');

      const cardsHtml = groups
        .map((g: any) => {
          const gKey = String(g.group_key || 'ETC');
          const st = MACRO_GENRE_STYLE[gKey] || MACRO_GENRE_STYLE.ETC;
          const filterTarget = gKey === 'UNCATEGORIZED' ? 'FOLDED' : gKey;
          const isSelected = segmentTab === 'category' && catGenreFilter === filterTarget;
          return `
            <button type="button" class="macro-genre-card ${isSelected ? 'is-selected' : ''}" data-macro-genre="${escapeHtml(filterTarget)}">
              <div class="mg-top">
                <span class="mg-title">${st.icon} ${escapeHtml(g.group_label_kr || g.name)}</span>
                <span class="mg-share" style="color:${st.color}">${fmtDec(g.share_of_total_chats_pct, 2)}%</span>
              </div>
              <div class="mg-main-stat">
                <strong>1만당 ${fmtDec(g.mod_per_10k_chats, 1)}건</strong>
                <small>${fmtInt(g.active_streams)}개 방송</small>
              </div>
              <div class="mg-sub-row">
                <span>채팅 ${fmtCompactKo(g.total_chats)}</span>
                <span>AI ${fmtDec(g.cleanbot_pct, 0)}% · 강퇴 ${fmtDec(g.perm_ban_pct, 2)}%</span>
              </div>
            </button>
          `;
        })
        .join('');

      elMacroGenres.innerHTML = `
        <div class="macro-head-row">
          <span class="macro-lbl">치지직 전체 대분류 장르 점유율 (100%)</span>
          <span class="macro-hint">카드를 클릭하면 아래 세부 카테고리 표가 해당 장르로 필터링됩니다</span>
        </div>
        <div class="stacked-bar macro-share-bar">${shareSegs}</div>
        <div class="macro-cards-grid">${cardsHtml}</div>
      `;

      elMacroGenres.querySelectorAll<HTMLButtonElement>('.macro-genre-card').forEach((card) => {
        card.addEventListener('click', () => {
          const target = card.dataset.macroGenre as typeof catGenreFilter;
          if (!target) return;
          if (segmentTab !== 'category') {
            segmentTab = 'category';
            document.querySelectorAll('#radar-segment-tabs .seg-btn').forEach((b) => {
              b.classList.toggle('active', (b as HTMLElement).dataset.tab === 'category');
            });
          }
          catGenreFilter = catGenreFilter === target ? 'ALL' : target;
          showAllCategories = false;
          syncGenrePillUI();
          renderMacroGenres(currentData);
          renderSegments(currentData);
        });
      });
    }

    function renderTableRow(r: any, maxMetric: number, metricKey: string, isSummaryRow = false): string {
      const val = num(r[metricKey]);
      const barW = maxMetric > 0 ? Math.min(100, (val / maxMetric) * 100) : 0;
      const displayName = rowLabel(r);

      const chips: string[] = [];
      if (segmentTab === 'category' && r.group_label_kr && !isSummaryRow) {
        chips.push(`<span class="cat-type-chip">${escapeHtml(r.group_label_kr)}</span>`);
      }
      if (num(r.distinct_categories_folded) > 0) {
        chips.push(`<span class="cat-folded-chip">외 ${fmtInt(r.distinct_categories_folded)}개 소규모 합산</span>`);
      } else if (isSummaryRow && r.group_key === 'UNCATEGORIZED') {
        chips.push(`<span class="cat-folded-chip">미지정 방송 합산</span>`);
      }

      const chatShare = r.share_of_total_chats_pct != null ? `<small class="cell-sub">(${fmtDec(r.share_of_total_chats_pct, 2)}%)</small>` : '';
      const aiPct = num(r.cleanbot_pct);
      const humanPct = num(r.human_mod_pct);
      const permCnt = getPermBans(r);

      return `
        <tr class="${isSummaryRow ? 'folded-summary-row' : ''}">
          <td class="col-name">
            <div class="seg-name-wrap">
              <div class="seg-title-line"><strong>${escapeHtml(displayName)}</strong>${chips.join('')}</div>
              <div class="seg-inline-bar"><span style="width:${barW}%"></span></div>
            </div>
          </td>
          <td class="num-col">${fmtInt(r.active_streams)}개</td>
          <td class="num-col">${fmtCompactKo(r.total_chats)} ${chatShare}</td>
          <td class="num-col highlight-col">${fmtDec(r.mod_per_10k_chats, 1)}건</td>
          <td class="num-col">${fmtDec(aiPct, 0)}% / ${fmtDec(humanPct, 0)}%</td>
          <td class="num-col">${fmtInt(r.timeouts)}건</td>
          <td class="num-col c-rose-text">${fmtInt(permCnt)}건 <small class="cell-sub">(${fmtDec(r.perm_ban_pct, 2)}%)</small></td>
        </tr>
      `;
    }

    function renderSegments(data: any) {
      elCatControls.hidden = segmentTab !== 'category';

      if (segmentTab === 'category') {
        const allCatRows = Array.isArray(data.by_category_48h) ? data.by_category_48h : [];
        const namedRows = allCatRows.filter(
          (r: any) => r.group_key !== 'OTHER_NAMED' && r.group_key !== 'UNCATEGORIZED'
        );
        const foldedRows = allCatRows.filter(
          (r: any) => r.group_key === 'OTHER_NAMED' || r.group_key === 'UNCATEGORIZED'
        );

        let filteredNamed: any[] = [];
        let footerSummaries: any[] = [];
        let macroFallbackNotice = '';

        if (catGenreFilter === 'ALL') {
          filteredNamed = [...namedRows];
          footerSummaries = foldedRows;
        } else if (catGenreFilter === 'FOLDED') {
          filteredNamed = [];
          footerSummaries = foldedRows;
        } else {
          filteredNamed = namedRows.filter((r: any) => r.group_key === catGenreFilter);
          if (filteredNamed.length === 0) {
            const macroMatch = (Array.isArray(data.by_category_group_48h) ? data.by_category_group_48h : []).find(
              (g: any) => g.group_key === catGenreFilter
            );
            if (macroMatch) {
              footerSummaries = [macroMatch];
              macroFallbackNotice = `현재 채팅 상위 30개 개별 카테고리 내 '${macroMatch.group_label_kr || macroMatch.name}' 항목이 없어 소규모 카테고리에 합산되어 있으며, 아래는 해당 장르 전체 합산 통계입니다.`;
            }
          }
        }

        filteredNamed.sort((a, b) => num(b[catSortKey]) - num(a[catSortKey]));

        if (filteredNamed.length === 0 && footerSummaries.length === 0) {
          elSegmentContent.innerHTML = `
            <div class="empty-inline-msg">아직 집계된 카테고리 데이터가 없습니다.</div>
          `;
          return;
        }

        const limit = !showAllCategories ? 12 : filteredNamed.length;
        const visibleNamed = filteredNamed.slice(0, limit);
        const combinedForMax = [...visibleNamed, ...footerSummaries];
        const maxMetric = Math.max(1, ...combinedForMax.map((r) => num(r[catSortKey])));

        const rowsHtml =
          visibleNamed.map((r) => renderTableRow(r, maxMetric, catSortKey, false)).join('') +
          footerSummaries.map((r) => renderTableRow(r, maxMetric, catSortKey, true)).join('');

        const expandBtn =
          filteredNamed.length > 12
            ? `<div class="expand-row-wrap"><button type="button" class="expand-cat-btn" id="radar-expand-cat-btn">${
                showAllCategories ? '상위 12개만 접기 ▲' : `상위 ${filteredNamed.length}개 개별 카테고리 모두 펼치기 ▼`
              }</button></div>`
            : '';

        elSegmentContent.innerHTML = `
          ${macroFallbackNotice ? `<div class="macro-fallback-banner">ℹ️ ${escapeHtml(macroFallbackNotice)}</div>` : ''}
          <div class="seg-table-scroll">
            <table class="radar-table">
              <thead>
                <tr>
                  <th>카테고리</th>
                  <th class="num-col">관측 방송</th>
                  <th class="num-col">총 채팅 (점유율)</th>
                  <th class="num-col">1만당 제재</th>
                  <th class="num-col">클린봇 / 수동</th>
                  <th class="num-col">임시제한</th>
                  <th class="num-col">영구차단 (비중)</th>
                </tr>
              </thead>
              <tbody>${rowsHtml}</tbody>
            </table>
          </div>
          ${expandBtn}
        `;

        const expBtn = document.getElementById('radar-expand-cat-btn');
        if (expBtn) {
          expBtn.addEventListener('click', () => {
            showAllCategories = !showAllCategories;
            renderSegments(currentData);
          });
        }
        return;
      }

      // Segment tabs: viewer / age / uptime
      let segRows: any[] = [];
      if (segmentTab === 'viewer') {
        segRows = normalizeSegmentRows(data.by_segment_48h?.viewer_brackets);
      } else if (segmentTab === 'age') {
        segRows = normalizeSegmentRows(data.by_segment_48h?.age_rating);
      } else if (segmentTab === 'uptime') {
        segRows = normalizeSegmentRows(data.by_segment_48h?.stream_uptime);
      }

      if (segRows.length === 0) {
        elSegmentContent.innerHTML = `<div class="empty-inline-msg">아직 집계된 세그먼트 비교 데이터가 없습니다.</div>`;
        return;
      }

      const maxMetric = Math.max(1, ...segRows.map((r) => num(r.mod_per_10k_chats)));
      const rowsHtml = segRows.map((r) => renderTableRow(r, maxMetric, 'mod_per_10k_chats', false)).join('');

      elSegmentContent.innerHTML = `
        <div class="seg-table-scroll">
          <table class="radar-table">
            <thead>
              <tr>
                <th>세그먼트 구분</th>
                <th class="num-col">관측 방송</th>
                <th class="num-col">총 채팅 (점유율)</th>
                <th class="num-col">1만당 제재</th>
                <th class="num-col">클린봇 / 수동</th>
                <th class="num-col">임시제한</th>
                <th class="num-col">영구차단 (비중)</th>
              </tr>
            </thead>
            <tbody>${rowsHtml}</tbody>
          </table>
        </div>
      `;
    }

    // ─── 7. Methodology & Zero-PII Footer ─────────────────────────────────────
    function renderMethodology(data: any) {
      const meth = data.meta?.methodology || {};
      const taxonomy = Array.isArray(meth.action_taxonomy) && meth.action_taxonomy.length > 0
        ? meth.action_taxonomy
        : [
            { key: 'cleanbot_blinds', label_kr: '클린봇 자동 블라인드', desc_kr: '네이버 AI 클린봇 자동 필터링 (CBOTBLIND)' },
            { key: 'manual_blinds', label_kr: '매니저 수동 블라인드', desc_kr: '스트리머·매니저의 단일/소량 메시지 가리기 (HIDDEN/BLIND)' },
            { key: 'timeouts', label_kr: '임시제한 (채팅 금지)', desc_kr: '일정 시간 채팅 제한 조치 (TEMPORARY_RESTRICT)' },
            { key: 'perm_bans', label_kr: '영구차단 (강퇴)', desc_kr: '채널 영구차단 (임시제한 없는 10초 내 4건+ 일괄 블라인드 강퇴 시그니처 및 명시 차단 통합)' },
          ];

      const taxColors: Record<string, string> = {
        cleanbot_blinds: '#818cf8',
        manual_blinds: '#38bdf8',
        timeouts: '#f59e0b',
        perm_bans: '#ef4444',
      };

      elMethodologyContent.innerHTML = `
        <div class="meth-grid">
          <div class="meth-col">
            <h4>4종 표준 제재 분류 체계 (합계 100%)</h4>
            <div class="meth-tax-list">
              ${taxonomy
                .map(
                  (t: any) => `
                  <div class="meth-tax-item">
                    <span class="leg-dot" style="background:${taxColors[t.key] || '#818cf8'}"></span>
                    <div>
                      <strong>${escapeHtml(t.label_kr)}</strong>
                      <p>${escapeHtml(t.desc_kr)}</p>
                    </div>
                  </div>
                `
                )
                .join('')}
            </div>
          </div>

          <div class="meth-col">
            <h4>시간창 정책 & 개인정보 비식별화 (Zero-PII)</h4>
            <ul class="meth-policy-list">
              <li>
                <strong>정각 완료 48시간 슬라이딩 윈도우:</strong>
                매시 01분 정각(KST)에 직전 완료된 60분 단위 버킷만 최대 48시간 시계열에 반영하여 부분 집계 왜곡을 배제합니다. 진행 중인 현재 시간대는 상단 실시간 상태 배지로만 별도 표기됩니다.
              </li>
              <li>
                <strong>단방향 솔트 해시 익명화:</strong>
                스트리머 채널 ID, 시청자 고유 식별자, 닉네임 및 채팅 원문 텍스트는 디스크나 스냅샷에 일체 저장되지 않으며 단방향 솔트(Salt) SHA-256 해시 절삭값으로만 교차 빈도를 집계합니다.
              </li>
              <li>
                <strong>소규모 방송 프라이버시 보호 (k-익명성):</strong>
                최소 3개 이상의 독립 방송이 활성화된 카테고리만 개별 표기하며, 미만 소규모 카테고리는 ‘기타 카테고리’로 자동 병합됩니다.
              </li>
            </ul>
          </div>
        </div>
      `;
    }

    function renderAll(data: any) {
      currentData = data;
      renderHeader(data);
      renderKpis(data);
      renderHighlights(data);
      renderTimeline(data);
      renderTimeOfDay(data);
      renderActionBreakdown(data);
      renderTimeoutInsights(data);
      renderCalmness(data);
      renderTrollFunnel(data);
      renderPatternInsights(data);
      renderMacroGenres(data);
      renderSegments(data);
      renderMethodology(data);

      elLoading.hidden = true;
      elError.hidden = true;
      elDashboard.hidden = false;
    }

    async function loadStats() {
      elError.hidden = true;
      if (!currentData) {
        elLoading.hidden = false;
        elDashboard.hidden = true;
      }

      try {
        const res = await fetch(`${GIST_URL}?t=${Date.now()}`, {
          cache: 'no-store',
          headers: { Accept: 'application/json' },
        });
        if (!res.ok) throw new Error(`HTTP ${res.status}`);
        const json = await res.json();
        if (!json || typeof json !== 'object') throw new Error('Invalid JSON payload');
        renderAll(json);
      } catch (err: any) {
        if (!currentData) {
          elLoading.hidden = true;
          elDashboard.hidden = true;
          elError.hidden = false;
          elErrorMsg.textContent = `데이터를 가져오는 중 오류가 발생했습니다 (${err?.message || 'Network Error'}).`;
        }
      }
    }

    // ─── Event Bindings ───────────────────────────────────────────────────────
    document.querySelectorAll<HTMLButtonElement>('#radar-chart-mode .seg-btn').forEach((btn) => {
      btn.addEventListener('click', () => {
        const m = btn.dataset.mode as typeof chartMode;
        if (!m || m === chartMode) return;
        chartMode = m;
        document.querySelectorAll('#radar-chart-mode .seg-btn').forEach((b) => b.classList.remove('active'));
        btn.classList.add('active');
        if (currentData) renderTimeline(currentData);
      });
    });

    document.querySelectorAll<HTMLButtonElement>('#radar-segment-tabs .seg-btn').forEach((btn) => {
      btn.addEventListener('click', () => {
        const t = btn.dataset.tab as typeof segmentTab;
        if (!t || t === segmentTab) return;
        segmentTab = t;
        showAllCategories = false;
        document.querySelectorAll('#radar-segment-tabs .seg-btn').forEach((b) => b.classList.remove('active'));
        btn.classList.add('active');
        if (currentData) {
          renderMacroGenres(currentData);
          renderSegments(currentData);
        }
      });
    });

    document.querySelectorAll<HTMLButtonElement>('#radar-cat-genre-pills .sort-pill').forEach((btn) => {
      btn.addEventListener('click', () => {
        const g = btn.dataset.genre as typeof catGenreFilter;
        if (!g || g === catGenreFilter) return;
        catGenreFilter = g;
        showAllCategories = false;
        syncGenrePillUI();
        if (currentData) {
          renderMacroGenres(currentData);
          renderSegments(currentData);
        }
      });
    });

    document.querySelectorAll<HTMLButtonElement>('#radar-cat-sort-pills .sort-pill').forEach((btn) => {
      btn.addEventListener('click', () => {
        const s = btn.dataset.sort as typeof catSortKey;
        if (!s || s === catSortKey) return;
        catSortKey = s;
        document.querySelectorAll('#radar-cat-sort-pills .sort-pill').forEach((b) => b.classList.remove('active'));
        btn.classList.add('active');
        if (currentData) renderSegments(currentData);
      });
    });

    elRetryBtn.addEventListener('click', loadStats);

    // Initial client-side fetch + quiet 5-minute auto-refresh when tab is visible
    loadStats();
    window.setInterval(() => {
      if (document.visibilityState === 'visible') {
        loadStats();
      }
    }, 5 * 60 * 1000);
  })();
</script>

<style>
  .bzzk-radar-section {
    margin-top: 32px;
  }

  /* Header Strip */
  .radar-top-header {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 16px;
    flex-wrap: wrap;
    margin-bottom: 14px;
  }

  .radar-title-cluster h2 {
    font-size: 1.5rem;
    font-weight: 800;
    color: #f8fafc;
    margin: 8px 0 0;
    letter-spacing: -0.02em;
  }

  .radar-badge-row {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 8px;
  }

  .radar-tag-pill {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 4px 10px;
    border-radius: 6px;
    background: rgba(99, 102, 241, 0.16);
    border: 1px solid rgba(99, 102, 241, 0.35);
    color: #a5b4fc;
    font-size: 0.74rem;
    font-weight: 800;
    letter-spacing: 0.04em;
  }

  .radar-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #38bdf8;
    box-shadow: 0 0 8px #38bdf8;
  }

  .radar-weather-badge {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 4px 12px;
    border-radius: 9999px;
    font-size: 0.8rem;
    font-weight: 700;
    border: 1px solid rgba(255, 255, 255, 0.12);
  }

  .radar-weather-badge.weather-calm {
    background: rgba(16, 185, 129, 0.14);
    border-color: rgba(16, 185, 129, 0.35);
    color: #34d399;
  }

  .radar-weather-badge.weather-normal {
    background: rgba(56, 189, 248, 0.13);
    border-color: rgba(56, 189, 248, 0.32);
    color: #7dd3fc;
  }

  .radar-weather-badge.weather-elevated {
    background: rgba(245, 158, 11, 0.15);
    border-color: rgba(245, 158, 11, 0.4);
    color: #fcd34d;
  }

  .radar-weather-badge.weather-surge {
    background: rgba(239, 68, 68, 0.18);
    border-color: rgba(239, 68, 68, 0.45);
    color: #fca5a5;
  }

  .weather-ratio {
    font-size: 0.73rem;
    opacity: 0.9;
    padding-left: 6px;
    border-left: 1px solid currentColor;
  }

  .radar-collection-badge {
    font-size: 0.75rem;
    font-weight: 600;
    color: #cbd5e1;
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.1);
    padding: 4px 10px;
    border-radius: 6px;
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
  }

  .radar-meta-actions {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 6px;
  }

  .radar-meta-line {
    display: flex;
    align-items: center;
    gap: 10px;
    flex-wrap: wrap;
  }

  .radar-updated-time {
    font-size: 0.81rem;
    color: #94a3b8;
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
  }

  .radar-auto-badge {
    font-size: 0.78rem;
    color: #cbd5e1;
    background: rgba(255, 255, 255, 0.05);
    padding: 4px 10px;
    border-radius: 7px;
    border: 1px solid rgba(255, 255, 255, 0.08);
  }

  .radar-live-hour-pill {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    font-size: 0.75rem;
    color: #a7f3d0;
    background: rgba(16, 185, 129, 0.1);
    border: 1px solid rgba(16, 185, 129, 0.28);
    padding: 4px 11px;
    border-radius: 999px;
  }

  :global(.live-hr-dot) {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: #10b981;
    box-shadow: 0 0 8px #10b981;
    flex-shrink: 0;
  }

  :global(.radar-live-hour-pill strong) {
    color: #34d399;
    font-family: monospace;
  }

  /* Privacy Bar */
  .radar-privacy-bar {
    display: flex;
    align-items: flex-start;
    gap: 10px;
    background: rgba(30, 41, 59, 0.45);
    border: 1px solid rgba(99, 102, 241, 0.22);
    border-radius: 12px;
    padding: 11px 16px;
    margin-bottom: 18px;
    font-size: 0.86rem;
    color: #cbd5e1;
    line-height: 1.5;
  }

  .privacy-ico {
    flex-shrink: 0;
  }

  /* Loading & Error & Warmup States */
  .skeleton-kpi-grid {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 12px;
    margin-bottom: 16px;
  }

  .skel-card {
    height: 104px;
    border-radius: 14px;
    background: linear-gradient(90deg, #111420 25%, #192036 50%, #111420 75%);
    background-size: 200% 100%;
    animation: skelPulse 1.5s infinite;
    border: 1px solid #1e2438;
  }

  .skel-panel {
    height: 240px;
    border-radius: 16px;
    background: linear-gradient(90deg, #111420 25%, #192036 50%, #111420 75%);
    background-size: 200% 100%;
    animation: skelPulse 1.5s infinite;
    border: 1px solid #1e2438;
  }

  @keyframes skelPulse {
    0% { background-position: 200% 0; }
    100% { background-position: -200% 0; }
  }

  .radar-error-state {
    text-align: center;
    padding: 40px 20px;
    border-radius: 16px;
    background: rgba(239, 68, 68, 0.08);
    border: 1px solid rgba(239, 68, 68, 0.3);
  }

  .state-icon {
    font-size: 2rem;
    margin-bottom: 8px;
  }

  .radar-error-state h3 {
    margin: 0 0 8px;
    color: #fca5a5;
  }

  .radar-error-state p {
    margin: 0 0 18px;
    color: #cbd5e1;
    font-size: 0.92rem;
  }

  .radar-retry-btn {
    background: linear-gradient(135deg, #6366f1, #8b5cf6);
    color: #fff;
    border: none;
    padding: 10px 20px;
    border-radius: 10px;
    font-weight: 700;
    cursor: pointer;
  }

  .radar-warmup-banner {
    display: flex;
    align-items: flex-start;
    gap: 12px;
    background: linear-gradient(135deg, rgba(56, 189, 248, 0.1), rgba(99, 102, 241, 0.12));
    border: 1px solid rgba(56, 189, 248, 0.32);
    border-radius: 14px;
    padding: 14px 18px;
  }

  .warmup-icon {
    font-size: 1.35rem;
    flex-shrink: 0;
  }

  .warmup-body strong {
    display: block;
    color: #e0f2fe;
    font-size: 0.95rem;
    margin-bottom: 4px;
  }

  .warmup-body p {
    margin: 0;
    font-size: 0.86rem;
    color: #cbd5e1;
    line-height: 1.5;
  }

  /* Dashboard Layout */
  .radar-dashboard {
    display: flex;
    flex-direction: column;
    gap: 18px;
  }

  /* 5-Card Executive KPI Grid */
  .radar-kpi-grid {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 12px;
  }

  :global(.kpi-card) {
    background: #111420;
    border: 1px solid #232a42;
    border-radius: 14px;
    padding: 15px 16px;
    position: relative;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 6px;
  }

  :global(.kpi-card::before) {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 2px;
  }

  :global(.kpi-indigo::before) { background: #6366f1; }
  :global(.kpi-sky::before) { background: #38bdf8; }
  :global(.kpi-emerald::before) { background: #10b981; }
  :global(.kpi-amber::before) { background: #f59e0b; }
  :global(.kpi-purple::before) { background: #a855f7; }
  :global(.kpi-rose::before) { background: #f43f5e; }

  :global(.kpi-top) {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 6px;
  }

  :global(.kpi-label) {
    font-size: 0.78rem;
    font-weight: 700;
    color: #94a3b8;
  }

  :global(.kpi-value) {
    font-size: 1.42rem;
    font-weight: 800;
    color: #f8fafc;
    letter-spacing: -0.02em;
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
  }

  :global(.kpi-sub) {
    font-size: 0.76rem;
    color: #94a3b8;
    line-height: 1.4;
  }

  :global(.kpi-sub-caption) {
    display: block;
    margin-top: 5px;
    font-size: 0.72rem;
    color: #64748b;
  }

  :global(.kpi-trend) {
    font-size: 0.68rem;
    font-weight: 700;
    padding: 2px 6px;
    border-radius: 5px;
    white-space: nowrap;
  }

  :global(.trend-good),
  :global(.trend-up) {
    background: rgba(16, 185, 129, 0.16);
    color: #34d399;
  }

  :global(.trend-warn) {
    background: rgba(239, 68, 68, 0.16);
    color: #fca5a5;
  }

  :global(.trend-down),
  :global(.trend-flat) {
    background: rgba(148, 163, 184, 0.15);
    color: #cbd5e1;
  }

  :global(.mini-split-bar) {
    display: flex;
    height: 6px;
    border-radius: 999px;
    overflow: hidden;
    background: #1e2438;
    margin-top: 2px;
  }

  :global(.sb-ai) { background: #818cf8; }
  :global(.sb-human) { background: #38bdf8; }

  /* Highlights Strip */
  .radar-highlights-strip {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 10px;
  }

  :global(.highlight-chip) {
    display: flex;
    align-items: center;
    gap: 10px;
    background: rgba(22, 27, 46, 0.75);
    border: 1px solid rgba(99, 102, 241, 0.25);
    border-radius: 12px;
    padding: 11px 14px;
  }

  :global(.hl-ico) {
    font-size: 1.25rem;
    flex-shrink: 0;
  }

  :global(.hl-text) {
    display: flex;
    flex-direction: column;
    gap: 2px;
    min-width: 0;
  }

  :global(.hl-title) {
    font-size: 0.72rem;
    color: #94a3b8;
    font-weight: 700;
  }

  :global(.hl-detail) {
    font-size: 0.84rem;
    color: #f1f5f9;
    font-weight: 700;
  }

  /* Panels */
  .radar-three-col {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 16px;
  }

  .radar-two-col {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 16px;
  }

  .radar-panel {
    background: #111420;
    border: 1px solid #232a42;
    border-radius: 16px;
    padding: 20px;
    position: relative;
  }

  .panel-head {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 10px;
    margin-bottom: 16px;
  }

  .wrap-head {
    flex-wrap: wrap;
    align-items: center;
  }

  .panel-kicker {
    display: block;
    font-size: 0.68rem;
    font-weight: 800;
    letter-spacing: 0.06em;
    color: #818cf8;
    margin-bottom: 3px;
  }

  .panel-head h3 {
    margin: 0;
    font-size: 1.08rem;
    font-weight: 800;
    color: #f8fafc;
  }

  .panel-pill {
    font-size: 0.74rem;
    font-weight: 700;
    color: #cbd5e1;
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.09);
    padding: 4px 9px;
    border-radius: 7px;
    white-space: nowrap;
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }

  /* Donut & Legend */
  :global(.donut-layout) {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  :global(.donut-wrap) {
    display: flex;
    justify-content: center;
  }

  :global(.donut-svg) {
    width: 128px;
    height: 128px;
  }

  :global(.donut-legend),
  :global(.pattern-body),
  :global(.funnel-list) {
    display: flex;
    flex-direction: column;
    gap: 11px;
  }

  :global(.legend-row),
  :global(.pattern-row),
  :global(.funnel-row) {
    display: flex;
    flex-direction: column;
    gap: 5px;
  }

  :global(.legend-meta),
  :global(.pattern-top),
  :global(.funnel-meta) {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
    font-size: 0.82rem;
  }

  :global(.leg-dot) {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    display: inline-block;
    flex-shrink: 0;
  }

  :global(.leg-name) {
    color: #cbd5e1;
    flex: 1;
    margin-left: 4px;
  }

  :global(.leg-val) {
    color: #f8fafc;
    font-weight: 700;
    font-family: monospace;
  }

  :global(.leg-val small) {
    color: #94a3b8;
    font-weight: 500;
  }

  :global(.leg-bar-track) {
    height: 6px;
    border-radius: 999px;
    background: #1a2033;
    overflow: hidden;
  }

  :global(.leg-bar-fill) {
    height: 100%;
    border-radius: 999px;
    transition: width 0.4s ease;
  }

  /* Timeout Insights */
  :global(.timeout-body) {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  :global(.timeout-mini-grid) {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 8px;
  }

  :global(.tmini-box) {
    background: #0d101a;
    border: 1px solid #1e2438;
    border-radius: 10px;
    padding: 10px;
    display: flex;
    flex-direction: column;
    gap: 3px;
  }

  :global(.tmini-lbl) {
    font-size: 0.72rem;
    color: #94a3b8;
  }

  :global(.tmini-box strong) {
    font-size: 1.05rem;
    color: #f8fafc;
    font-family: monospace;
  }

  :global(.tmini-box small) {
    font-size: 0.7rem;
    color: #64748b;
  }

  :global(.c-emerald) { color: #34d399 !important; }
  :global(.c-rose) { color: #f87171 !important; }
  :global(.c-rose-text) { color: #fca5a5; }

  :global(.dist-block) {
    display: flex;
    flex-direction: column;
    gap: 7px;
  }

  :global(.dist-head) {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 0.8rem;
    color: #cbd5e1;
    font-weight: 600;
  }

  :global(.dist-head small) {
    color: #64748b;
    font-weight: 500;
  }

  :global(.stacked-bar) {
    display: flex;
    height: 10px;
    border-radius: 999px;
    overflow: hidden;
    background: #1a2033;
    gap: 2px;
  }

  :global(.stacked-bar.tall-bar) {
    height: 14px;
    margin-bottom: 14px;
  }

  :global(.dist-legend-inline) {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    font-size: 0.74rem;
    color: #94a3b8;
  }

  :global(.dist-legend-inline i) {
    display: inline-block;
    width: 8px;
    height: 8px;
    border-radius: 2px;
    margin-right: 4px;
  }

  :global(.dist-legend-inline b) {
    color: #e2e8f0;
    margin-left: 2px;
  }

  /* Message Patterns */
  :global(.pattern-scope-note) {
    font-size: 0.75rem;
    color: #93c5fd;
    background: rgba(56, 189, 248, 0.08);
    border: 1px solid rgba(56, 189, 248, 0.22);
    border-radius: 8px;
    padding: 7px 11px;
    margin-bottom: 2px;
  }

  :global(.pattern-scope-note strong) {
    color: #e0f2fe;
  }

  :global(.pat-name) {
    color: #e2e8f0;
    font-weight: 600;
  }

  :global(.pat-right) {
    display: flex;
    align-items: center;
    gap: 6px;
  }

  :global(.pat-pct) {
    font-family: monospace;
    font-size: 0.78rem;
    font-weight: 700;
    color: #cbd5e1;
  }

  :global(.risk-badge) {
    font-size: 0.69rem;
    font-weight: 800;
    padding: 2px 6px;
    border-radius: 5px;
  }

  :global(.risk-high) {
    background: rgba(239, 68, 68, 0.2);
    color: #fca5a5;
    border: 1px solid rgba(239, 68, 68, 0.4);
  }

  :global(.risk-med) {
    background: rgba(245, 158, 11, 0.18);
    color: #fcd34d;
    border: 1px solid rgba(245, 158, 11, 0.35);
  }

  :global(.risk-base) {
    background: rgba(148, 163, 184, 0.12);
    color: #94a3b8;
  }

  :global(.pattern-foot) {
    display: flex;
    justify-content: space-between;
    font-size: 0.72rem;
    color: #64748b;
  }

  /* Segment Toggle Controls */
  .seg-toggle {
    display: inline-flex;
    background: #0d101a;
    border: 1px solid #232a42;
    border-radius: 9px;
    padding: 3px;
    gap: 3px;
    flex-wrap: wrap;
  }

  .seg-btn {
    background: transparent;
    border: none;
    color: #94a3b8;
    font-size: 0.79rem;
    font-weight: 700;
    padding: 6px 12px;
    border-radius: 6px;
    cursor: pointer;
    transition: all 0.15s;
  }

  .seg-btn:hover {
    color: #f1f5f9;
  }

  .seg-btn.active {
    background: linear-gradient(135deg, #6366f1, #8b5cf6);
    color: #ffffff;
  }

  /* Timeline Chart */
  .timeline-legend-row {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
    font-size: 0.78rem;
    color: #94a3b8;
    margin-bottom: 10px;
  }

  :global(.timeline-legend-row i) {
    display: inline-block;
    width: 10px;
    height: 10px;
    border-radius: 2px;
    margin-right: 5px;
    vertical-align: middle;
  }

  :global(.timeline-legend-row i.dash-i) {
    width: 14px;
    height: 0;
    border-top: 2px dashed #fbbf24;
    border-radius: 0;
  }

  :global(.timeline-legend-row i.line-i) {
    width: 14px;
    height: 0;
    border-top: 2.5px solid #38bdf8;
    border-radius: 0;
  }

  .timeline-chart-wrap {
    background: #0d101a;
    border: 1px solid #1e2438;
    border-radius: 12px;
    padding: 12px;
    overflow-x: auto;
  }

  :global(.timeline-svg) {
    width: 100%;
    min-width: 600px;
    height: auto;
    display: block;
  }

  :global(.bar-hit) {
    cursor: pointer;
  }

  :global(.empty-chart-box) {
    text-align: center;
    padding: 34px 16px;
    color: #94a3b8;
  }

  :global(.empty-ico) {
    font-size: 1.75rem;
    display: block;
    margin-bottom: 6px;
  }

  :global(.empty-chart-box strong) {
    color: #e2e8f0;
    font-size: 0.95rem;
    display: block;
    margin-bottom: 4px;
  }

  :global(.empty-chart-box p) {
    margin: 0;
    font-size: 0.84rem;
  }

  /* Floating Tooltip */
  .chart-tooltip {
    position: absolute;
    z-index: 20;
    pointer-events: none;
    background: rgba(11, 13, 20, 0.96);
    border: 1px solid rgba(99, 102, 241, 0.45);
    border-radius: 10px;
    padding: 10px 12px;
    width: 242px;
    box-shadow: 0 12px 28px rgba(0, 0, 0, 0.65);
    font-size: 0.75rem;
  }

  :global(.tt-head) {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 6px;
    margin-bottom: 6px;
    padding-bottom: 6px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    color: #f8fafc;
  }

  :global(.tt-surge) {
    font-size: 0.68rem;
    font-weight: 800;
    color: #fca5a5;
    background: rgba(239, 68, 68, 0.2);
    padding: 1px 5px;
    border-radius: 4px;
  }

  :global(.tt-grid) {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 4px 8px;
    color: #94a3b8;
  }

  :global(.tt-grid b) {
    color: #f1f5f9;
    font-family: monospace;
    text-align: right;
  }

  /* Time-of-Day Subgrid */
  .time-of-day-grid {
    display: grid;
    grid-template-columns: 1fr 1.25fr;
    gap: 16px;
    margin-top: 16px;
    padding-top: 16px;
    border-top: 1px solid #1e2438;
  }

  .sub-block-head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    margin-bottom: 10px;
  }

  .sub-block-head h4 {
    margin: 0;
    font-size: 0.9rem;
    font-weight: 700;
    color: #e2e8f0;
  }

  .sub-hint {
    font-size: 0.74rem;
    color: #64748b;
  }

  .tod-zones-cards {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  :global(.tod-zone-card) {
    background: #0d101a;
    border: 1px solid #1e2438;
    border-radius: 10px;
    padding: 10px 12px;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  :global(.tz-top) {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 0.82rem;
  }

  :global(.tz-label) {
    color: #e2e8f0;
    font-weight: 700;
  }

