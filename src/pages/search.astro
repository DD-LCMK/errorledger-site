---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';
import { getCollection } from 'astro:content';

const allGames = await getCollection('games');
---

<!doctype html>
<html lang="en" class="dark">
  <head>
    <BaseHead title={`Search Games | ${SITE_TITLE}`} description={SITE_DESCRIPTION} />
  </head>
  <body class="search-page-body">
    <Header />

    <main class="search-main">
      <div class="search-header">
        <h1>Find a Game</h1>
        <p>Search our library of free, client-side web games and puzzles.</p>
        <div class="search-input-wrapper">
          <input type="text" id="game-search-input" placeholder="Search by name, category, or keyword..." autocomplete="off" autofocus />
        </div>
      </div>

      <div class="games-results-grid" id="results-grid">
        {allGames.map(game => (
          <article class="search-game-card" data-title={game.data.title.toLowerCase()} data-cat={game.data.category.toLowerCase()} data-desc={game.data.description.toLowerCase()}>
            <div class="card-icon">{game.data.icon}</div>
            <div class="card-text">
              <h3><a href={`/games/${game.id}`}>{game.data.title}</a></h3>
              <p class="tagline">{game.data.tagline}</p>
              <p class="desc">{game.data.description}</p>
              <div class="badge-row">
                <span class="pill">{game.data.category}</span>
                <span class="pill">{game.data.playTime}</span>
              </div>
            </div>
          </article>
        ))}
      </div>
    </main>

    <Footer />
  </body>
</html>

<style>
  .search-page-body {
    background: #090d16 !important;
    color: #f1f5f9 !important;
    min-height: 100vh;
    display: flex;
    flex-direction: column;
  }

  .search-main {
    flex: 1;
    max-width: 900px;
    margin: 0 auto;
    padding: 3rem 1.5rem 5rem;
    width: 100%;
  }

  .search-header {
    text-align: center;
    margin-bottom: 2.5rem;
  }

  h1 {
    font-size: 2.2rem;
    font-weight: 900;
    color: #f8fafc;
    margin: 0 0 0.5rem;
  }

  .search-header p {
    color: #94a3b8;
    margin: 0 0 1.5rem;
  }

  .search-input-wrapper {
    max-width: 540px;
    margin: 0 auto;
  }

  #game-search-input {
    width: 100%;
    padding: 0.85rem 1.25rem;
    background: #0f172a;
    border: 2px solid rgba(168, 85, 247, 0.35);
    border-radius: 12px;
    color: #ffffff;
    font-size: 1rem;
    outline: none;
    transition: border-color 0.2s ease, box-shadow 0.2s ease;
  }

  #game-search-input:focus {
    border-color: #38bdf8;
    box-shadow: 0 0 20px rgba(56, 189, 248, 0.3);
  }

  .games-results-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.25rem;
  }

  .search-game-card {
    background: #0f172a;
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 14px;
    padding: 1.5rem;
    display: flex;
    align-items: center;
    gap: 1.5rem;
    transition: transform 0.15s ease, border-color 0.15s ease;
  }

  .search-game-card:hover {
    transform: translateY(-2px);
    border-color: rgba(56, 189, 248, 0.4);
  }

  .card-icon {
    font-size: 3rem;
    background: rgba(255, 255, 255, 0.04);
    border-radius: 12px;
    width: 70px;
    height: 70px;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .card-text {
    flex: 1;
  }

  .card-text h3 {
    font-size: 1.3rem;
    font-weight: 800;
    margin: 0 0 0.2rem;
  }

  .card-text h3 a {
    color: #f8fafc;
    text-decoration: none;
  }

  .card-text h3 a:hover {
    color: #38bdf8;
  }

  .tagline {
    font-size: 0.85rem;
    color: #38bdf8;
    margin: 0 0 0.4rem;
  }

  .desc {
    font-size: 0.88rem;
    color: #94a3b8;
    line-height: 1.5;
    margin: 0 0 0.75rem;
  }

  .badge-row {
    display: flex;
    gap: 0.5rem;
  }

  .pill {
    background: rgba(255, 255, 255, 0.06);
    color: #cbd5e1;
    font-size: 0.75rem;
    font-weight: 700;
    padding: 0.2rem 0.55rem;
    border-radius: 6px;
    text-transform: uppercase;
  }

  .hidden {
    display: none !important;
  }

  @media (max-width: 640px) {
    .search-game-card {
      flex-direction: column;
      text-align: center;
    }
    .badge-row {
      justify-content: center;
    }
  }
</style>

<script>
  const searchInput = document.getElementById('game-search-input') as HTMLInputElement;
  const cards = document.querySelectorAll('.search-game-card');

  if (searchInput) {
    searchInput.addEventListener('input', (e) => {
      const q = (e.target as HTMLInputElement).value.toLowerCase().trim();
      cards.forEach(card => {
        const title = card.getAttribute('data-title') || '';
        const cat = card.getAttribute('data-cat') || '';
        const desc = card.getAttribute('data-desc') || '';
        const match = title.includes(q) || cat.includes(q) || desc.includes(q);
        if (match) {
          card.classList.remove('hidden');
        } else {
          card.classList.add('hidden');
        }
      });
    });
  }
</script>