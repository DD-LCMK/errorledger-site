---
import BaseHead from '../../../components/BaseHead.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import FormattedDate from '../../../components/FormattedDate.astro';
import { SITE_TITLE } from '../../../consts';
import { getCollection } from 'astro:content';

const allPosts = await getCollection('blog');
const koPosts = allPosts.filter(p => p.data.lang === 'ko');

const posts = koPosts.sort((a, b) => {
	const dateA = a.data.pubDate ? new Date(a.data.pubDate).valueOf() : 0;
	const dateB = b.data.pubDate ? new Date(b.data.pubDate).valueOf() : 0;
	return dateB - dateA;
});

const categoryCounts: Record<string, number> = {
	all: posts.length,
	corporate: posts.filter(p => p.data.category === 'corporate').length,
	money: posts.filter(p => p.data.category === 'money').length,
	work: posts.filter(p => p.data.category === 'work').length,
	ai: posts.filter(p => p.data.category === 'ai').length,
	internet: posts.filter(p => p.data.category === 'internet').length,
	relationships: posts.filter(p => p.data.category === 'relationships').length,
	human: posts.filter(p => p.data.category === 'human').length,
};

const categories = [
	{ id: "all", label: "⚡ 전체 사건 목록", icon: "⚡" },
	{ id: "corporate", label: "🏢 기업 & 시스템 인프라", icon: "🏢" },
	{ id: "money", label: "💰 금융 & 경제 재난", icon: "💰" },
	{ id: "work", label: "🧑‍💻 직장 & 개인 커리어", icon: "🧑‍💻" },
	{ id: "ai", label: "🤖 AI & 자동화 결함", icon: "🤖" },
	{ id: "internet", label: "🌐 인터넷 & 사회적 참사", icon: "🌐" },
	{ id: "relationships", label: "❤️ 인간관계", icon: "❤️" },
	{ id: "human", label: "🧠 인간 심리 & 인지 편향", icon: "🧠" },
];
---

<html lang="ko" class="dark">
	<head>
		<BaseHead title={`에러레저 사건 보관소 | ${SITE_TITLE}`} description="인간의 실수, 기업 과실, 시스템 붕괴에 대한 탐사 기록 보관소." />
		<style>
			main { width: 1160px; max-width: calc(100% - 2rem); margin: 0 auto; padding: 3em 1rem; }

			.archive-header {
				margin-bottom: 2.5rem;
				border-bottom: 1px solid #262626;
				padding-bottom: 1.5rem;
			}
			.archive-header h1 {
				font-size: 2.5rem;
				font-weight: 800;
				color: #f5f5f5;
				margin: 0 0 0.5rem 0;
				letter-spacing: -0.03em;
			}
			.archive-header p {
				color: #a3a3a3;
				font-size: 1.1rem;
				margin: 0;
				line-height: 1.6;
			}

			/* 2-Column Responsive Archive Layout */
			.archive-layout-grid {
				display: grid;
				grid-template-columns: 1fr;
				gap: 2rem;
				align-items: start;
			}
			@media (min-width: 1024px) {
				.archive-layout-grid {
					grid-template-columns: 280px 1fr;
				}
			}

			/* Left Sticky Category Rail */
			.category-rail {
				background: #171717;
				border: 1px solid #262626;
				border-radius: 16px;
				padding: 1.25rem;
				position: sticky;
				top: 5.5rem;
				max-height: calc(100vh - 7rem);
				overflow-y: auto;
			}
			@media (max-width: 1023px) {
				.category-rail {
					position: relative;
					top: 0;
					margin-bottom: 1.5rem;
					padding: 1rem;
				}
			}

			.rail-header {
				font-family: ui-monospace, monospace;
				font-size: 0.75rem;
				font-weight: 700;
				text-transform: uppercase;
				color: #a3a3a3;
				letter-spacing: 0.05em;
				margin-bottom: 0.85rem;
				padding-bottom: 0.5rem;
				border-bottom: 1px solid #262626;
				display: flex;
				justify-content: space-between;
				align-items: center;
			}

			.category-nav-list {
				display: flex;
				flex-direction: column;
				gap: 0.4rem;
			}
			@media (max-width: 1023px) {
				.category-nav-list {
					flex-direction: row;
					flex-wrap: wrap;
					gap: 0.5rem;
				}
			}

			.category-nav-btn {
				display: flex;
				align-items: center;
				justify-content: space-between;
				width: 100%;
				background: transparent;
				border: 1px solid transparent;
				color: #d4d4d4;
				padding: 0.6rem 0.85rem;
				border-radius: 8px;
				font-size: 0.88rem;
				font-weight: 600;
				cursor: pointer;
				text-align: left;
				transition: all 0.15s ease;
				box-sizing: border-box;
				font-family: inherit;
			}
			@media (max-width: 1023px) {
				.category-nav-btn {
					width: auto;
					padding: 0.45rem 0.8rem;
					border: 1px solid #262626;
					background: #0a0a0a;
					border-radius: 9999px;
					font-size: 0.8rem;
				}
			}
			.category-nav-btn:hover {
				background: #262626;
				color: #ffffff;
			}
			.category-nav-btn.active {
				background: rgba(244, 63, 94, 0.12);
				border-color: rgba(244, 63, 94, 0.3);
				color: #fb7185;
			}

			.cat-count-badge {
				font-family: ui-monospace, monospace;
				font-size: 0.72rem;
				background: #0a0a0a;
				color: #737373;
				padding: 0.1rem 0.45rem;
				border-radius: 9999px;
				border: 1px solid #262626;
			}
			.category-nav-btn.active .cat-count-badge {
				background: #f43f5e;
				color: #ffffff;
				border-color: #f43f5e;
			}

			.rail-dossiers {
				margin-top: 1.5rem;
				padding-top: 1.25rem;
				border-top: 1px solid #262626;
			}
			@media (max-width: 1023px) {
				.rail-dossiers {
					display: none;
				}
			}
			.dossier-link {
				display: block;
				font-size: 0.82rem;
				color: #a3a3a3;
				text-decoration: none;
				padding: 0.35rem 0;
				transition: color 0.15s ease;
			}
			.dossier-link:hover {
				color: #f59e0b;
			}

			/* Right Incident Stream & Search */
			.stream-controls {
				display: flex;
				align-items: center;
				justify-content: space-between;
				margin-bottom: 1.5rem;
				gap: 1rem;
				flex-wrap: wrap;
			}
			.stream-heading {
				font-size: 1.1rem;
				font-weight: 800;
				color: #f5f5f5;
				text-transform: uppercase;
				letter-spacing: 0.025em;
			}

			.live-filter-input {
				background: #171717;
				border: 1px solid #262626;
				color: #f5f5f5;
				font-size: 0.85rem;
				padding: 0.5rem 0.85rem;
				border-radius: 8px;
				outline: none;
				width: 100%;
				max-width: 320px;
				font-family: inherit;
				transition: border-color 0.15s ease;
			}
			.live-filter-input:focus {
				border-color: #f43f5e;
			}

			.grid-archive {
				display: grid;
				grid-template-columns: 1fr;
				gap: 1.25rem;
			}

			.archive-card {
				background: #171717;
				border: 1px solid #262626;
				border-radius: 12px;
				padding: 1.5rem;
				transition: transform 0.2s ease, border-color 0.2s ease;
				text-decoration: none;
				display: block;
			}
			.archive-card:hover {
				transform: translateY(-2px);
				border-color: #f43f5e;
			}

			.card-meta {
				display: flex;
				align-items: center;
				gap: 0.6rem;
				margin-bottom: 0.6rem;
				font-size: 0.75rem;
				color: #737373;
				font-family: ui-monospace, monospace;
				flex-wrap: wrap;
			}
			.card-cat-tag {
				padding: 0.15rem 0.5rem;
				border-radius: 4px;
				background: #0a0a0a;
				border: 1px solid #262626;
				color: #d4d4d4;
				font-weight: 700;
				text-transform: uppercase;
			}
			.card-archive-title {
				font-size: 1.25rem;
				font-weight: 700;
				color: #f5f5f5;
				margin: 0 0 0.5rem 0;
				line-height: 1.35;
				transition: color 0.15s ease;
			}
			.archive-card:hover .card-archive-title {
				color: #fb7185;
			}
			.card-archive-desc {
				font-size: 0.88rem;
				color: #a3a3a3;
				line-height: 1.5;
				margin: 0;
			}

			.hidden { display: none !important; }

			/* Light mode styles */
			:global(html:not(.dark)) .archive-header {
				border-bottom-color: #e2e8f0;
			}
			:global(html:not(.dark)) .archive-header h1 {
				color: #0f172a;
			}
			:global(html:not(.dark)) .archive-header p {
				color: #64748b;
			}
			:global(html:not(.dark)) .category-rail,
			:global(html:not(.dark)) .archive-card {
				background: #f8fafc;
				border-color: #e2e8f0;
			}
			:global(html:not(.dark)) .rail-header {
				border-bottom-color: #e2e8f0;
				color: #64748b;
			}
			:global(html:not(.dark)) .category-nav-btn {
				color: #334155;
			}
			:global(html:not(.dark)) .category-nav-btn:hover {
				background: #e2e8f0;
				color: #0f172a;
			}
			:global(html:not(.dark)) .category-nav-btn.active {
				background: #fee2e2;
				border-color: #fca5a5;
				color: #e11d48;
			}
			:global(html:not(.dark)) .cat-count-badge {
				background: #ffffff;
				border-color: #cbd5e1;
				color: #475569;
			}
			:global(html:not(.dark)) .stream-heading {
				color: #0f172a;
			}
			:global(html:not(.dark)) .live-filter-input {
				background: #f8fafc;
				border-color: #cbd5e1;
				color: #0f172a;
			}
			:global(html:not(.dark)) .archive-card:hover {
				background: #ffffff;
			}
			:global(html:not(.dark)) .card-archive-title {
				color: #0f172a;
			}
			:global(html:not(.dark)) .card-archive-desc {
				color: #475569;
			}
			:global(html:not(.dark)) .card-cat-tag {
				background: #ffffff;
				border-color: #cbd5e1;
				color: #334155;
			}
			:global(html:not(.dark)) .dossier-link {
				color: #475569 !important;
			}
			:global(html:not(.dark)) .dossier-link:hover {
				color: #d97706 !important;
			}
			:global(html:not(.dark)) .card-meta {
				color: #64748b !important;
			}
		</style>
	</head>
	<body class="bg-neutral-950 text-neutral-200 antialiased min-h-screen">
		<Header />
		<main>
			<div class="archive-header">
				<h1>에러레저 사건 보관소</h1>
				<p>인간의 실수, 기업의 과실, 시스템 붕괴에 대한 탐사 기록입니다. 좌측 카테고리를 선택하거나 키워드로 검색하세요.</p>
			</div>

			<div class="archive-layout-grid">
				<!-- Left Sticky Category Rail -->
				<aside class="category-rail">
					<div class="rail-header">
						<span>사건 카테고리</span>
						<span>{posts.length}개 파일</span>
					</div>
					<div class="category-nav-list" id="category-filter-list">
						{categories.map((cat) => (
							<button 
								class={`category-nav-btn ${cat.id === 'all' ? 'active' : ''}`}
								data-category-filter={cat.id}
							>
								<span>{cat.label}</span>
								<span class="cat-count-badge">{categoryCounts[cat.id] || 0}</span>
							</button>
						))}
					</div>

					<div class="rail-dossiers">
						<div class="rail-header" style="border: none; margin-bottom: 0.5rem; padding-bottom: 0;">
							<span>테마별 사건 도시에</span>
						</div>
						<a href="/ko/blog/deleted-production-database-blamed-intern" class="dossier-link">
							📂 사내 희생양 사건 모음집
						</a>
						<a href="/ko/blog/knight-capital-trading-glitch-45-minutes" class="dossier-link">
							⚡ 45분 만의 파산: 알고리즘 폭주
						</a>
						<a href="/ko/blog/the-friday-update-that-broke-the-world" class="dossier-link">
							🌋 클라우드 단일 장애점 마비
						</a>
					</div>
				</aside>

				<!-- Right Incident Stream -->
				<section class="archive-stream">
					<div class="stream-controls">
						<div class="stream-heading" id="current-filter-title">
							전체 사건 목록
						</div>
						<input 
							type="text" 
							id="archive-search" 
							class="live-filter-input" 
							placeholder="제목 또는 키워드로 실시간 검색..." 
							autocomplete="off"
						/>
					</div>

					<div class="grid-archive" id="archive-grid">
						{posts.map((post) => (
							<a 
								href={`/ko/blog/${post.data.slug.replace(/^ko\//, '')}`} 
								class="archive-card" 
								data-category={post.data.category}
								data-title={post.data.title.toLowerCase()}
							>
								<div class="card-meta">
									<span class="card-cat-tag">
										{post.data.category}
									</span>
									<span>•</span>
									<FormattedDate date={post.data.pubDate || new Date()} />
									<span>•</span>
									<span>⏱️ {post.data.read_time_minutes || 6}분 읽기</span>
									<span>•</span>
									<span style="color: #fb7185;">{post.data.provenance_label || "공식 문서 검증"}</span>
								</div>
								<h3 class="card-archive-title">
									{post.data.title}
								</h3>
								<p class="card-archive-desc">
									{post.data.description}
								</p>
							</a>
						))}
					</div>

					<div id="no-results" class="hidden" style="text-align: center; padding: 4rem 0; color: #737373; font-family: ui-monospace, monospace; font-size: 0.9rem;">
						일치하는 사건 기록이 없습니다.
					</div>
				</section>
			</div>
		</main>
		<Footer />

		<script is:inline>
			(function() {
				const catButtons = document.querySelectorAll('[data-category-filter]');
				const searchInput = document.getElementById('archive-search');
				const cards = document.querySelectorAll('.archive-card');
				const noResults = document.getElementById('no-results');
				const streamTitle = document.getElementById('current-filter-title');

				let activeCategory = 'all';
				let searchQuery = '';

				function applyFilters() {
					let visibleCount = 0;
					cards.forEach(card => {
						const cat = card.getAttribute('data-category');
						const title = card.getAttribute('data-title') || '';

						const matchesCategory = (activeCategory === 'all') || (cat === activeCategory);
						const matchesSearch = !searchQuery || title.includes(searchQuery.toLowerCase());

						if (matchesCategory && matchesSearch) {
							card.style.display = 'block';
							visibleCount++;
						} else {
							card.style.display = 'none';
						}
					});

					if (noResults) {
						if (visibleCount === 0) noResults.classList.remove('hidden');
						else noResults.classList.add('hidden');
					}
				}

				catButtons.forEach(btn => {
					btn.addEventListener('click', function() {
						catButtons.forEach(b => b.classList.remove('active'));
						this.classList.add('active');
						activeCategory = this.getAttribute('data-category-filter') || 'all';
						
						if (streamTitle) {
							const label = this.querySelector('span:first-child')?.innerText || '전체 사건 목록';
							streamTitle.innerText = label;
						}
						applyFilters();
					});
				});

				searchInput?.addEventListener('input', function() {
					searchQuery = this.value.trim();
					applyFilters();
				});
			})();
		</script>
	</body>
</html>
