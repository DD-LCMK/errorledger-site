---
import BaseHead from '../../components/BaseHead.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { SITE_TITLE } from '../../consts';
import { getCollection } from 'astro:content';

const allPosts = await getCollection('blog');
const koPosts = allPosts.filter(p => p.id.startsWith('ko/') || p.data.lang === 'ko');

const posts = koPosts.sort((a, b) => new Date(b.data.pubDate || 0).valueOf() - new Date(a.data.pubDate || 0).valueOf());
---

<html lang="ko" class="dark">
	<head>
		<BaseHead title={`사건 검색 | ${SITE_TITLE}`} description="에러레저에 기록된 사건, 기업 참사, 휴먼 에러를 검색하세요." />
		<style>
			main { width: 960px; max-width: calc(100% - 2rem); margin: 0 auto; padding: 3em 1rem; }
			ul { display: flex; flex-direction: column; gap: 1.25rem; list-style-type: none; margin: 0; padding: 0; }
			ul li { background: #171717; border: 1px solid #262626; border-radius: 12px; padding: 1.5rem; transition: transform 0.15s ease, border-color 0.15s ease; }
			ul li:hover { transform: translateY(-2px); border-color: #f43f5e; }
			.title { margin: 0 0 0.5rem 0; font-size: 1.25rem; color: #f5f5f5; font-weight: 700; }
			ul li a { text-decoration: none; }
			.description { margin: 0; color: #a3a3a3; font-size: 0.9rem; line-height: 1.5; }
			.search-container { margin-bottom: 2rem; width: 100%; }
			#search-box { width: 100%; padding: 0.75rem 1rem; font-size: 1rem; border-radius: 8px; border: 1px solid #262626; background: #171717; color: #f5f5f5; outline: none; font-family: inherit; box-sizing: border-box; }
			#search-box:focus { border-color: #f43f5e; }
			.tag-row { display: flex; gap: 0.5rem; margin-bottom: 0.5rem; flex-wrap: wrap; align-items: center; }
			.card-tag { font-size: 0.72rem; font-weight: 700; background: #0a0a0a; color: #d4d4d4; padding: 0.15rem 0.45rem; border-radius: 4px; font-family: ui-monospace, monospace; border: 1px solid #262626; }
			.type-badge { font-size: 0.72rem; font-weight: 800; padding: 0.15rem 0.45rem; border-radius: 4px; font-family: ui-monospace, monospace; background: rgba(244, 63, 94, 0.12); color: #fb7185; border: 1px solid rgba(244, 63, 94, 0.25); }

			/* Light mode styles */
			:global(html:not(.dark)) ul li { background: #f8fafc; border-color: #e2e8f0; }
			:global(html:not(.dark)) .title { color: #0f172a; }
			:global(html:not(.dark)) .description { color: #475569; }
			:global(html:not(.dark)) #search-box { background-color: #f8fafc; border-color: #cbd5e1; color: #0f172a; }
			:global(html:not(.dark)) .card-tag { background: #ffffff; border-color: #cbd5e1; color: #334155; }
		</style>
	</head>
	<body class="bg-neutral-950 text-neutral-200 antialiased min-h-screen">
		<Header />
		<main>
			<div class="search-container">
				<input type="text" id="search-box" placeholder="키워드, 기업명, 또는 사건명으로 검색..." autocomplete="off" />
			</div>
			<ul>
				{posts.map((post) => (
					<li class="post-card" data-category={post.data.category} data-tags={post.data.tags?.join(' ') || ''}>
						<a href={`/ko/blog/${post.data.slug.replace(/^ko\//, '')}`}>
							<div class="tag-row">
								<span class="type-badge">
									{post.data.category}
								</span>
								{post.data.tags.map((tag: string) => <span class="card-tag">#{tag}</span>)}
							</div>
							<h4 class="title">{post.data.title}</h4>
							<p class="description">{post.data.description}</p>
						</a>
					</li>
				))}
			</ul>
		</main>
		<Footer />
		<script>
			function filterPosts(query: string) {
				const trimmed = query.trim().toLowerCase();

				document.querySelectorAll('.post-card').forEach((post: any) => {
					const text = post.textContent.toLowerCase();
					const cat = (post.getAttribute('data-category') || '').toLowerCase();
					const tags = (post.getAttribute('data-tags') || '').toLowerCase();
					if (!trimmed) {
						post.style.display = '';
					} else {
						post.style.display = (text.includes(trimmed) || cat.includes(trimmed) || tags.includes(trimmed)) ? '' : 'none';
					}
				});
			}

			function init() {
				const pageSearch: any = document.getElementById('search-box');
				const headerSearch: any = document.querySelector('.header-search-input');
				const query = new URLSearchParams(window.location.search).get('q') || '';
				
				if (pageSearch) pageSearch.value = query;
				if (headerSearch) headerSearch.value = query;
				filterPosts(query);

				const handler = (e: any) => {
					if (headerSearch && e.target !== headerSearch) headerSearch.value = e.target.value;
					if (pageSearch && e.target !== pageSearch) pageSearch.value = e.target.value;
					filterPosts(e.target.value);
				};
				pageSearch?.addEventListener('input', handler);
				headerSearch?.addEventListener('input', handler);
			}
			
			init();
			document.addEventListener('astro:page-load', init);
		</script>
	</body>
</html>
