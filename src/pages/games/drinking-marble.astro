  const rollBtn = document.getElementById('btn-roll-dice') as HTMLButtonElement | null;
  const rollStatus = document.getElementById('roll-status-message');
  const turnIcon = document.getElementById('turn-player-icon');
  const turnName = document.getElementById('turn-player-name');
  const lapCounter = document.getElementById('lap-counter');
  const arenaPlayersBar = document.getElementById('arena-players-bar');
  const playerNamesList = document.getElementById('player-names-list');

  function renderPlayerNamesList() {
    if (!playerNamesList) return;
    playerNamesList.innerHTML = '';

    players.forEach((p, idx) => {
      const row = document.createElement('div');
      row.className = `player-name-row ${idx === currentPlayerIdx ? 'active-turn-row' : ''}`;
      row.id = `p-name-row-${idx}`;

      const iconSpan = document.createElement('span');
      iconSpan.className = 'p-row-icon';
      iconSpan.textContent = p.icon;

      const input = document.createElement('input');
      input.type = 'text';
      input.className = 'p-row-input';
      input.value = p.name;
      input.maxLength = 14;
      input.placeholder = isEn ? `Player ${idx + 1}` : `플레이어 ${idx + 1}`;
      input.setAttribute('data-pid', String(idx));
      input.title = isEn ? 'Click to edit player name' : '플레이어 이름 수정';

      input.addEventListener('input', () => {
        p.name = input.value;
        customPlayerNames[idx] = input.value;
        savePlayerNames();
        updatePawnsOnBoard();
      });

      input.addEventListener('blur', () => {
        if (!input.value.trim()) {
          input.value = defaultAvatars[idx].defaultName;
          p.name = input.value;
          customPlayerNames[idx] = input.value;
          savePlayerNames();
          updatePawnsOnBoard();
        }
      });

      row.appendChild(iconSpan);
      row.appendChild(input);
      playerNamesList.appendChild(row);
    });
  }

  // Modal Elements
  const actionModal = document.getElementById('action-modal');
  const modalToken = document.getElementById('modal-token');
  const modalName = document.getElementById('modal-name');
  const modalIcon = document.getElementById('modal-tile-icon');
