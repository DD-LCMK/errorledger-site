---
import GameLayout from '../../layouts/GameLayout.astro';
import { getEntry } from 'astro:content';

const gameEntry = await getEntry('games', 'drinking-marble');
const data = gameEntry?.data || {
  title: '주루마블 (블라썸 에디션)',
  tagline: '생방송 술게임 & 벌칙 주사위 말판 게임',
  description: '치지직, 유튜브, SOOP 생방송 맞춤형 주루마블! 3D 주사위 굴리기, 24칸 한눈에 들어오는 맞춤형 말판, 벚꽃 블라썸 테마와 술게임·방송벌칙·스트리머 토크 원클릭 템플릿을 무료로 즐기세요.',
  icon: '🌸',
  category: 'stream',
  badge: '🌸 신규 출시',
  players: '1~4인 (솔로/합방)',
  playTime: '5분~25분',
  controls: [
    '스페이스바(Space) 또는 [주사위 굴리기] 버튼으로 3D 주사위 투척',
    '말판의 칸을 클릭하여 벌칙 내용, 아이콘, 텍스트 직접 커스텀',
    '상단 프리셋 버튼으로 주루마블 / 매운맛 벌칙 / 카페 토크 1초 변경',
    '1~4인 참가자 모드로 솔로 방송 및 디스코드 합방 완벽 지원'
  ],
  rules: [
    '주사위를 굴려 나온 눈(1~6)만큼 말이 시계 방향으로 칸을 이동합니다.',
    '도착한 칸에 적힌 지령(한 모금, 원샷, 안주, 벌칙 미션 등)을 수행합니다.',
    '출발점을 통과하거나 무인도, 골든벨 등 특수 구역에 걸리면 보너스/특수 룰이 발동합니다.'
  ],
  faqItems: [
    {
      q: '술을 마시지 않는 일반 방송에서도 사용할 수 있나요?',
      a: '네! 상단 프리셋에서 [🌶️ 방송 매운맛 벌칙] 또는 [☕ 스트리머 토크]를 선택하시면 무알콜 방송, 시청자 미션 수행, 잡담 방송용으로 건전하고 유쾌하게 즐기실 수 있습니다.'
    },
    {
      q: '내가 수정한 말판 내용이 나중에도 유지되나요?',
      a: '네! 브라우저 로컬 저장소(localStorage)에 실시간 자동 저장되므로 페이지를 새로고침하거나 브라우저를 껐다 켜도 커스텀 내용이 그대로 유지됩니다.'
    },
    {
      q: '전체화면이나 집중 모드는 어떻게 사용하나요?',
      a: '상단의 [⛶ 전체화면] 또는 [📺 집중 모드]를 누르면 상하단 여백 없이 브라우저 화면 가득 말판을 깔끔하게 띄워 시원하게 플레이할 수 있습니다.'
    }
  ]
};
---

<GameLayout
  title={data.title}
  description={data.description}
  tagline={data.tagline}
  icon={data.icon}
  category={data.category}
  badge={data.badge}
  players={data.players}
  playTime={data.playTime}
  controls={data.controls}
  rules={data.rules}
  faqItems={data.faqItems}
  layoutMode="full"
  hideStageHeader={true}
  hideFooter={false}
>
  <div class="blossom-app-root" id="blossom-root">
    <!-- Floating Sakura Petals Background Canvas -->
    <canvas id="sakura-canvas" class="sakura-canvas"></canvas>

    <div class="board-layout-container side-by-side">
      <!-- Left: Main Monopoly Board Grid (7x7 Grid with 24 perimeter tiles + Center Stage) -->
      <div class="board-grid-wrapper">
        <div class="monopoly-board" id="monopoly-board">
          <!-- 24 Tiles will be rendered dynamically by JavaScript -->
          <!-- Center Arena: 3D Dice Stage -->
          <div class="center-arena" id="center-arena">
            <div class="arena-header">
              <div class="current-player-badge" id="current-player-badge">
                <span class="player-icon" id="turn-player-icon">🌸</span>
                <span class="player-name" id="turn-player-name">플레이어 1</span>
                <span class="turn-label" id="turn-label">차례</span>
              </div>
              <div class="lap-counter" id="lap-counter">바퀴: 1Lap</div>
            </div>

            <!-- 3D CSS Dice Container -->
            <div class="dice-scene" id="dice-scene">
              <div class="cube-dice" id="cube-dice">
                <div class="dice-face front" data-face="1">
                  <div class="dot dot-center"></div>
                </div>
                <div class="dice-face back" data-face="6">
                  <div class="dot dot-top-left"></div>
                  <div class="dot dot-top-right"></div>
                  <div class="dot dot-mid-left"></div>
                  <div class="dot dot-mid-right"></div>
                  <div class="dot dot-bot-left"></div>
                  <div class="dot dot-bot-right"></div>
                </div>
                <div class="dice-face right" data-face="3">
                  <div class="dot dot-top-left"></div>
                  <div class="dot dot-center"></div>
                  <div class="dot dot-bot-right"></div>
                </div>
                <div class="dice-face left" data-face="4">
                  <div class="dot dot-top-left"></div>
                  <div class="dot dot-top-right"></div>
                  <div class="dot dot-bot-left"></div>
                  <div class="dot dot-bot-right"></div>
                </div>
                <div class="dice-face top" data-face="2">
                  <div class="dot dot-top-left"></div>
                  <div class="dot dot-bot-right"></div>
                </div>
                <div class="dice-face bottom" data-face="5">
                  <div class="dot dot-top-left"></div>
                  <div class="dot dot-top-right"></div>
                  <div class="dot dot-center"></div>
                  <div class="dot dot-bot-left"></div>
                  <div class="dot dot-bot-right"></div>
                </div>
              </div>
            </div>

            <!-- Roll Action Button -->
            <div class="roll-action-box">
              <button class="btn-roll-dice" id="btn-roll-dice">
                <span class="roll-dice-icon">🎲</span>
                <span class="roll-dice-text" id="btn-roll-text">주사위 굴리기</span>
                <span class="roll-shortcut-hint">(Space)</span>
              </button>
              <div class="roll-status-message" id="roll-status-message">주사위를 굴려 말판을 전진하세요!</div>
            </div>

            <!-- Players Bar in Center -->
            <div class="arena-players-bar" id="arena-players-bar">
              <!-- Dynamically populated -->
            </div>
          </div>
        </div>
      </div>

      <!-- Right: Streamer Control Panel Sidebar -->
      <aside class="board-side-panel">
        <div class="panel-section panel-brand">
          <span class="brand-badge">🌸 Blossom Suite</span>
          <h3 class="panel-heading">방송 제어판</h3>
        </div>

        <!-- Presets Section -->
        <div class="panel-section">
          <label class="panel-label" id="lbl-preset">🎨 템플릿 프리셋</label>
          <div class="preset-buttons vertical">
            <button class="preset-btn active" data-preset="drinking">
              <span class="btn-icon">🍶</span>
              <span class="btn-text">주루마블 기본</span>
            </button>
            <button class="preset-btn" data-preset="penalty">
              <span class="btn-icon">🌶️</span>
              <span class="btn-text">매운맛 벌칙</span>
            </button>
            <button class="preset-btn" data-preset="coffee">
              <span class="btn-icon">☕</span>
              <span class="btn-text">방송 토크</span>
            </button>
          </div>
        </div>

        <!-- Players Count Section -->
        <div class="panel-section">
          <label class="panel-label" id="lbl-players">👥 참여 인원</label>
          <div class="player-count-btns grid">
            <button class="player-cnt-btn active" data-count="1">1인 (솔로)</button>
            <button class="player-cnt-btn" data-count="2">2인</button>
            <button class="player-cnt-btn" data-count="3">3인</button>
            <button class="player-cnt-btn" data-count="4">4인 (합방)</button>
          </div>
          <!-- Editable Player Names -->
          <div class="player-names-wrap" id="player-names-wrap">
            <label class="panel-sublabel" id="lbl-edit-names">✏️ 참가자 이름</label>
            <div class="player-names-list" id="player-names-list"></div>
          </div>
        </div>

        <!-- Action Buttons -->
        <div class="panel-section panel-actions">
          <button class="btn-custom-edit side-action" id="btn-open-editor" title="말판 내용 전체 편집">
            ✏️ 말판 칸 전체 편집
          </button>
          <button class="btn-reset-board side-action" id="btn-reset-game" title="게임 처음부터 다시 시작">
            🔄 게임 처음부터 리셋
          </button>
        </div>

        <!-- Tips & Shortcut Info -->
        <div class="panel-section panel-tips">
          <div class="tips-header">
            <span>💡</span>
            <span class="tips-title" id="tips-heading">방송 팁 & 단축키</span>
          </div>
          <ul class="tips-list" id="tips-list">
            <li><strong>Space</strong> : 주사위 굴리기 / 턴 넘기기</li>
            <li><strong>칸 클릭</strong> : 벌칙 내용 실시간 커스텀</li>
            <li><strong>전체화면</strong> : F11 또는 ⛶ 버튼으로 꽉 찬 화면</li>
          </ul>
        </div>
      </aside>
    </div>

    <!-- Tile Action Landing Modal (Result Popup) -->
    <div class="action-modal-overlay hidden" id="action-modal">
      <div class="action-modal-card">
        <div class="modal-petals-decor">🌸 ✨ 🌸</div>
        <div class="modal-player-tag" id="modal-player-tag">
          <span class="modal-token" id="modal-token">🌸</span>
          <span class="modal-name" id="modal-name">플레이어 1</span>
        </div>
        <div class="modal-tile-icon" id="modal-tile-icon">🍺</div>
        <h2 class="modal-tile-title" id="modal-tile-title">한 모금 마시기</h2>
        <p class="modal-tile-desc" id="modal-tile-desc">시원하게 음료 또는 술 한 모금 마시기!</p>
        <div class="modal-action-row">
          <button class="btn-modal-confirm" id="btn-modal-confirm">확인 (다음 턴) →</button>
        </div>
      </div>
    </div>

    <!-- Tile Editor Modal -->
    <div class="editor-modal-overlay hidden" id="editor-modal">
      <div class="editor-modal-card">
        <div class="editor-header">
          <h3 id="editor-title">✏️ 말판 칸 커스텀 편집</h3>
          <button class="editor-close-btn" id="btn-close-editor">✕</button>
        </div>
        <div class="editor-tabs">
          <button class="editor-tab active" data-tab="single" id="tab-single">선택 칸 편집</button>
          <button class="editor-tab" data-tab="all" id="tab-all">24칸 전체 목록</button>
        </div>

        <div class="editor-tab-pane" id="pane-single">
          <div class="form-group">
            <label id="lbl-edit-target">수정할 칸 선택:</label>
            <select id="edit-tile-select" class="form-select"></select>
          </div>
          <div class="form-group">
            <label id="lbl-edit-title">지령 제목 (짧게):</label>
            <input type="text" id="edit-tile-title" class="form-input" maxlength="20" />
          </div>
          <div class="form-group">
            <label id="lbl-edit-desc">상세 설명 / 벌칙 내용:</label>
            <input type="text" id="edit-tile-desc" class="form-input" maxlength="60" />
          </div>
          <div class="form-group">
            <label id="lbl-edit-icon">아이콘 이모지:</label>
            <div class="emoji-palette" id="emoji-palette">
              <span>🍺</span><span>🍶</span><span>💧</span><span>🍗</span>
              <span>🌶️</span><span>🎤</span><span>🐱</span><span>👑</span>
              <span>🌸</span><span>⭐</span><span>💣</span><span>🎁</span>
              <span>🤫</span><span>🍻</span><span>📢</span><span>🛡️</span>
              <span>🔥</span><span>☕</span><span>❓</span><span>💖</span>
            </div>
          </div>
          <button class="btn-save-tile" id="btn-save-single-tile">✓ 이 칸 수정 적용</button>
        </div>

        <div class="editor-tab-pane hidden" id="pane-all">
          <div class="all-tiles-list" id="all-tiles-list">
            <!-- Injected dynamically -->
          </div>
          <div class="editor-all-actions">
            <button class="btn-save-all" id="btn-save-all-tiles">✓ 전체 저장</button>
            <button class="btn-reset-preset" id="btn-reset-preset-default">기본값으로 복원</button>
          </div>
        </div>
      </div>
    </div>
  </div>
</GameLayout>

<style>
  /* Blossom Dark Theme */
  :global(body) {
    background: #090c15 !important;
    overflow-x: hidden;
  }

  .blossom-app-root {
    position: relative;
    min-height: auto;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: flex-start;
    padding: 0.35rem 0.5rem 1.2rem;
    color: #f1f5f9;
    user-select: none;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Noto Sans KR", sans-serif;
  }

  /* Floating Petals Canvas */
  .sakura-canvas {
    position: fixed;
    top: 0;
    left: 0;
    width: 100vw;
    height: 100vh;
    pointer-events: none;
    z-index: 1;
  }

  .board-layout-container.side-by-side {
    position: relative;
    z-index: 2;
    width: 100%;
    max-width: 1080px;
    margin: 0 auto;
    display: flex;
    flex-direction: row;
    align-items: flex-start;
    justify-content: center;
    gap: 1.25rem;
    padding: 0 0.5rem;
  }

  /* Board Grid Wrapper (Left) */
  .board-grid-wrapper {
    flex: 1;
    max-width: 740px;
    width: 100%;
    display: flex;
    justify-content: center;
    perspective: 1000px;
  }

  /* 7x7 Monopoly Board (24 Tiles, 15% Larger Boxes) */
  .monopoly-board {
    width: 100%;
    max-width: 740px;
    aspect-ratio: 1 / 1;
    display: grid;
    grid-template-columns: 1.35fr repeat(5, 1fr) 1.35fr;
    grid-template-rows: 1.35fr repeat(5, 1fr) 1.35fr;
    gap: 6px;
    padding: 8px;
    background: linear-gradient(145deg, rgba(17, 19, 36, 0.92) 0%, rgba(10, 11, 24, 0.95) 100%);
    border: 2px solid rgba(244, 114, 182, 0.35);
    border-radius: 18px;
    box-shadow: 0 16px 50px rgba(0, 0, 0, 0.7), 0 0 35px rgba(244, 114, 182, 0.15);
    box-sizing: border-box;
    position: relative;
  }

  /* Right: Streamer Control Panel Sidebar */
  .board-side-panel {
    width: 290px;
    min-width: 265px;
    background: rgba(18, 20, 36, 0.82);
    border: 1px solid rgba(244, 114, 182, 0.25);
    border-radius: 18px;
    padding: 1.1rem;
    backdrop-filter: blur(14px);
    box-shadow: 0 12px 40px rgba(0, 0, 0, 0.5), 0 0 25px rgba(244, 114, 182, 0.1);
    display: flex;
    flex-direction: column;
    gap: 0.95rem;
    box-sizing: border-box;
  }

  .panel-brand {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    padding-bottom: 0.55rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
  }

  .brand-badge {
    font-size: 0.72rem;
    font-weight: 800;
    color: #f472b6;
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }

  .panel-heading {
    margin: 0;
    font-size: 1.05rem;
    font-weight: 800;
    color: #ffffff;
  }

  .panel-label {
    display: block;
    font-size: 0.8rem;
    font-weight: 800;
    color: #f472b6;
    margin-bottom: 0.45rem;
  }

  .preset-buttons.vertical {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .preset-btn {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    width: 100%;
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.1);
    color: #cbd5e1;
    font-size: 0.82rem;
    font-weight: 700;
    padding: 0.5rem 0.75rem;
    border-radius: 9px;
    cursor: pointer;
    transition: all 0.18s ease;
    text-align: left;
  }

  .preset-btn:hover {
    background: rgba(244, 114, 182, 0.15);
    border-color: rgba(244, 114, 182, 0.4);
    color: #fdf2f8;
    transform: translateX(3px);
  }

  .preset-btn.active {
    background: linear-gradient(135deg, #ec4899 0%, #a855f7 100%);
    border-color: #f472b6;
    color: #ffffff;
    box-shadow: 0 0 16px rgba(236, 72, 153, 0.4);
  }

  .btn-icon {
    font-size: 1.05rem;
  }

  .player-count-btns.grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.4rem;
  }

  .player-cnt-btn {
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.1);
    color: #cbd5e1;
    font-size: 0.78rem;
    font-weight: 700;
    padding: 0.45rem 0.5rem;
    border-radius: 8px;
    cursor: pointer;
    text-align: center;
    transition: all 0.18s ease;
  }

  .player-cnt-btn:hover {
    background: rgba(244, 114, 182, 0.15);
    border-color: rgba(244, 114, 182, 0.4);
    color: #fdf2f8;
  }

  .player-cnt-btn.active {
    background: linear-gradient(135deg, #ec4899 0%, #a855f7 100%);
    border-color: #f472b6;
    color: #ffffff;
    box-shadow: 0 0 14px rgba(236, 72, 153, 0.35);
  }

  /* Player Names Editor in Sidebar */
  .player-names-wrap {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    margin-top: 0.4rem;
  }

  .panel-sublabel {
    font-size: 0.72rem;
    font-weight: 800;
    color: #f472b6;
    letter-spacing: 0.02em;
    text-transform: uppercase;
  }

  .player-names-list {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
  }

  :global(.player-name-row) {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 8px;
    padding: 0.28rem 0.55rem;
    transition: all 0.15s ease;
  }

  :global(.player-name-row:focus-within) {
    border-color: #f472b6;
    background: rgba(244, 114, 182, 0.12);
    box-shadow: 0 0 10px rgba(244, 114, 182, 0.25);
  }

  :global(.player-name-row.active-turn-row) {
    border-color: rgba(244, 114, 182, 0.5);
  }

  :global(.p-row-icon) {
    font-size: 1rem;
    flex-shrink: 0;
  }

  :global(.p-row-input) {
    flex: 1;
    background: transparent;
    border: none;
    color: #f8fafc;
    font-size: 0.8rem;
    font-weight: 700;
    outline: none;
    padding: 0.12rem 0;
    min-width: 0;
    width: 100%;
  }

  :global(.p-row-input::placeholder) {
    color: #64748b;
    font-weight: 500;
  }

  .panel-actions {
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
    padding-top: 0.3rem;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
  }

  .side-action {
    width: 100%;
    padding: 0.55rem 0.8rem;
    font-size: 0.82rem;
    font-weight: 800;
    border-radius: 9px;
    cursor: pointer;
    text-align: center;
    transition: all 0.18s ease;
  }

  .btn-custom-edit {
    background: rgba(168, 85, 247, 0.15);
    border: 1px solid rgba(168, 85, 247, 0.4);
    color: #f3e8ff;
  }

  .btn-custom-edit:hover {
    background: rgba(168, 85, 247, 0.3);
    border-color: #c084fc;
    transform: scale(1.02);
  }

  .btn-reset-board {
    background: rgba(239, 68, 68, 0.12);
    border: 1px solid rgba(239, 68, 68, 0.3);
    color: #fca5a5;
  }

  .btn-reset-board:hover {
    background: rgba(239, 68, 68, 0.25);
    border-color: #f87171;
    transform: scale(1.02);
  }

  .panel-tips {
    background: rgba(0, 0, 0, 0.25);
    border: 1px solid rgba(255, 255, 255, 0.06);
