      document.querySelectorAll('.player-cnt-btn').forEach(b => b.classList.remove('active'));
      btn.classList.add('active');

      players = [];
      for (let i = 0; i < count; i++) {
        players.push({
          id: i + 1,
          name: customPlayerNames[i] || defaultAvatars[i].defaultName,
          icon: defaultAvatars[i].icon,
          color: defaultAvatars[i].color,
          position: 0,
