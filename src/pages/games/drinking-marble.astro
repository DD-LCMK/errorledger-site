<script>
  // Detect language from path or query parameter
  const urlParams = new URLSearchParams(window.location.search);
  const isEn = window.location.pathname.startsWith('/en') || urlParams.get('lang') === 'en';

  // Game State & Audio
  interface TileData {
    id: number;
    title: string;
    desc: string;
    icon: string;
    type: 'corner' | 'normal';
    special?: 'start' | 'island' | 'king' | 'fate';
  }

  interface Player {
    id: number;
    name: string;
    icon: string;
    color: string;
    position: number; // 0 to 23
    laps: number;
    isResting?: boolean;
  }

  const PRESETS_DATA: Record<string, { name: string; tiles: TileData[] }> = {
    drinking: {
      name: '주루마블 기본',
      tiles: [
        { id: 0, title: '출발 (START)', desc: '지날 때마다 축하 건배!', icon: '🌸', type: 'corner', special: 'start' },
        { id: 1, title: '한 모금 마시기', desc: '시원하게 음료/술 한 모금 축이기', icon: '🍺', type: 'normal' },
        { id: 2, title: '반 잔 비우기', desc: '부담 없이 딱 반 잔만 마시기', icon: '🍶', type: 'normal' },
        { id: 3, title: '생존용 안주 찬스', desc: '맛있는 안주 1입 먹고 속 달래기', icon: '🍗', type: 'normal' },
        { id: 4, title: '시원한 원샷!', desc: '망설임 없이 원샷! (무알콜 가능)', icon: '💣', type: 'normal' },
        { id: 5, title: '옆 사람과 건배', desc: '양옆 중 한 명과 다정하게 짠!', icon: '🤝', type: 'normal' },
        { id: 6, title: '무인도 (술자리 감옥)', desc: '1턴 쉬거나 물 1컵 마시고 탈출', icon: '🏝️', type: 'corner', special: 'island' },
        { id: 7, title: '물 한 컵 마시기', desc: '간 보호! 시원한 냉수 1컵 충전', icon: '💧', type: 'normal' },
