  .dot-top-right  { grid-column: 3; grid-row: 1; }
  .dot-mid-left   { grid-column: 1; grid-row: 2; }
  .dot-mid-right  { grid-column: 3; grid-row: 2; }
  .dot-bot-left   { grid-column: 1; grid-row: 3; }
  .dot-bot-right  { grid-column: 3; grid-row: 3; }

