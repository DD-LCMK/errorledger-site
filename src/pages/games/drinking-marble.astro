  .cube-dice {
    width: 100%;
    height: 100%;
    position: relative;
    transform-style: preserve-3d;
    transform: rotateX(-20deg) rotateY(30deg);
    transition: transform 0.2s cubic-bezier(0.175, 0.885, 0.32, 1.275);
    cursor: pointer;
  }

  .cube-dice.rolling {
    animation: diceSpin 1.1s cubic-bezier(0.2, 0.8, 0.3, 1) forwards;
  }

  @keyframes diceSpin {
    0% { transform: rotateX(0deg) rotateY(0deg) rotateZ(0deg); }
    30% { transform: rotateX(720deg) rotateY(360deg) rotateZ(180deg) scale(1.12); }
    70% { transform: rotateX(1200deg) rotateY(900deg) rotateZ(540deg) scale(1.04); }
    100% { transform: var(--final-rotation); }
  }

  .dice-face {
    position: absolute;
    width: 88px;
    height: 88px;
    background: linear-gradient(135deg, #1e1b2e 0%, #151322 100%);
    border: 2px solid rgba(244, 114, 182, 0.5);
    border-radius: 16px;
    box-shadow: inset 0 0 14px rgba(244, 114, 182, 0.2), 0 0 12px rgba(0, 0, 0, 0.6);
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    grid-template-rows: repeat(3, 1fr);
    padding: 9px;
    box-sizing: border-box;
  }

  .dice-face.front  { transform: rotateY(0deg) translateZ(44px); }
  .dice-face.back   { transform: rotateY(180deg) translateZ(44px); }
  .dice-face.right  { transform: rotateY(90deg) translateZ(44px); }
  .dice-face.left   { transform: rotateY(-90deg) translateZ(44px); }
  .dice-face.top    { transform: rotateX(90deg) translateZ(44px); }
  .dice-face.bottom { transform: rotateX(-90deg) translateZ(44px); }

  .dot {
    width: 14px;
    height: 14px;
