  /* Tiles */
  :global(.board-tile) {
    position: relative;
    background: rgba(26, 30, 56, 0.75);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 9px;
    padding: 6px 4px;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    cursor: pointer;
    transition: transform 0.18s ease, border-color 0.18s ease, box-shadow 0.18s ease, background 0.18s ease;
    overflow: hidden;
    backdrop-filter: blur(8px);
  }

  :global(.board-tile:hover) {
    transform: translateY(-2px);
    border-color: rgba(244, 114, 182, 0.6);
    box-shadow: 0 6px 18px rgba(244, 114, 182, 0.25);
    background: rgba(38, 43, 76, 0.85);
  }

  /* Active landing pulse */
  :global(.board-tile.active-destination) {
    border-color: #f472b6 !important;
    background: rgba(236, 72, 153, 0.25) !important;
    box-shadow: 0 0 25px rgba(236, 72, 153, 0.6), inset 0 0 15px rgba(236, 72, 153, 0.3) !important;
    animation: tilePulse 1.2s infinite alternate ease-in-out;
  }

  @keyframes tilePulse {
    from { box-shadow: 0 0 15px rgba(236, 72, 153, 0.4); }
    to { box-shadow: 0 0 30px rgba(236, 72, 153, 0.8), inset 0 0 20px rgba(236, 72, 153, 0.4); }
  }

  /* Corner Tiles */
  :global(.board-tile.tile-corner) {
    background: linear-gradient(135deg, rgba(30, 36, 70, 0.88) 0%, rgba(20, 24, 48, 0.95) 100%);
    border: 1.5px solid rgba(244, 114, 182, 0.4);
    box-shadow: 0 4px 18px rgba(0, 0, 0, 0.35);
  }

  :global(.board-tile.tile-corner-start) {
    border-color: rgba(244, 114, 182, 0.7);
    background: linear-gradient(135deg, rgba(80, 24, 56, 0.85) 0%, rgba(30, 20, 44, 0.95) 100%);
  }

  :global(.board-tile.tile-corner-king) {
    border-color: rgba(251, 191, 36, 0.6);
    background: linear-gradient(135deg, rgba(64, 48, 20, 0.85) 0%, rgba(28, 24, 40, 0.95) 100%);
