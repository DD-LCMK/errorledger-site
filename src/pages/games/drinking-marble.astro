  // Acoustic Blossom Audio Synth Engine
  class BoardSFX {
    private ctx: AudioContext | null = null;

    private getCtx(): AudioContext | null {
      if (!this.ctx && typeof window !== 'undefined') {
        const AudioCtx = window.AudioContext || (window as unknown as { webkitAudioContext: typeof AudioContext }).webkitAudioContext;
        if (AudioCtx) this.ctx = new AudioCtx();
      }
      if (this.ctx && this.ctx.state === 'suspended') {
        this.ctx.resume();
      }
      return this.ctx;
    }

    // Soft, organic wooden dice tumble taps (Zero buzz/sawtooth)
    playDiceShake() {
      const c = this.getCtx();
      if (!c) return;
      [0, 0.07, 0.16].forEach((delay, i) => {
        const osc = c.createOscillator();
        const gain = c.createGain();
        const filter = c.createBiquadFilter();
        filter.type = 'bandpass';
        filter.frequency.setValueAtTime(320 + i * 70, c.currentTime + delay);
        filter.Q.setValueAtTime(5, c.currentTime + delay);

        osc.type = 'triangle';
        osc.frequency.setValueAtTime(200 + (i % 2) * 50, c.currentTime + delay);
        osc.frequency.exponentialRampToValueAtTime(70, c.currentTime + delay + 0.045);

        gain.gain.setValueAtTime(0.12, c.currentTime + delay);
        gain.gain.exponentialRampToValueAtTime(0.001, c.currentTime + delay + 0.045);

        osc.connect(filter);
        filter.connect(gain);
        gain.connect(c.destination);

        osc.start(c.currentTime + delay);
        osc.stop(c.currentTime + delay + 0.05);
      });
    }

    // Gentle, soothing kalimba / water-drop melodic pentatonic notes
    playHop(stepIdx: number = 0) {
      const c = this.getCtx();
      if (!c) return;
      const osc = c.createOscillator();
      const gain = c.createGain();
      const pentatonic = [659.25, 783.99, 880.0, 987.77, 1174.66, 1318.51];
      const freq = pentatonic[stepIdx % pentatonic.length];

      osc.type = 'sine';
      osc.frequency.setValueAtTime(freq, c.currentTime);
      osc.frequency.exponentialRampToValueAtTime(freq * 0.99, c.currentTime + 0.11);

      gain.gain.setValueAtTime(0.12, c.currentTime);
      gain.gain.exponentialRampToValueAtTime(0.001, c.currentTime + 0.11);

      osc.connect(gain);
      gain.connect(c.destination);
      osc.start(c.currentTime);
      osc.stop(c.currentTime + 0.11);
    }

    // Sparkling cherry blossom wind-chime arpeggio chord
    playLand() {
      const c = this.getCtx();
      if (!c) return;
      const chord = [523.25, 659.25, 783.99, 987.77, 1046.5];
      chord.forEach((freq, idx) => {
        const osc = c.createOscillator();
        const gain = c.createGain();
        osc.type = 'sine';
        osc.frequency.setValueAtTime(freq, c.currentTime + idx * 0.055);

        gain.gain.setValueAtTime(0.09, c.currentTime + idx * 0.055);
        gain.gain.exponentialRampToValueAtTime(0.001, c.currentTime + idx * 0.055 + 0.35);

        osc.connect(gain);
        gain.connect(c.destination);
        osc.start(c.currentTime + idx * 0.055);
        osc.stop(c.currentTime + idx * 0.055 + 0.36);
      });
    }
  }

  const sfx = new BoardSFX();

  // Floating Sakura Petals Engine
  function initSakuraCanvas() {
    const canvas = document.getElementById('sakura-canvas') as HTMLCanvasElement | null;
    if (!canvas) return;
    const ctx = canvas.getContext('2d');
    if (!ctx) return;

    function resize() {
      if (!canvas) return;
      canvas.width = window.innerWidth;
      canvas.height = window.innerHeight;
    }
    window.addEventListener('resize', resize);
    resize();

    interface Petal {
      x: number;
      y: number;
      size: number;
      speedX: number;
      speedY: number;
      angle: number;
      spin: number;
      opacity: number;
    }

    const petals: Petal[] = [];
    const count = 35;

    for (let i = 0; i < count; i++) {
      petals.push({
        x: Math.random() * canvas.width,
        y: Math.random() * canvas.height,
        size: Math.random() * 8 + 7,
        speedX: Math.random() * 1.2 - 0.2,
        speedY: Math.random() * 1.2 + 0.8,
        angle: Math.random() * Math.PI * 2,
        spin: Math.random() * 0.03 - 0.015,
        opacity: Math.random() * 0.5 + 0.35,
      });
    }

    function renderPetals() {
      if (!ctx || !canvas) return;
      ctx.clearRect(0, 0, canvas.width, canvas.height);

      petals.forEach(p => {
        p.x += p.speedX;
        p.y += p.speedY;
        p.angle += p.spin;

        if (p.y > canvas.height + 20) {
          p.y = -20;
          p.x = Math.random() * canvas.width;
        }
        if (p.x > canvas.width + 20) {
          p.x = -20;
        }

        ctx.save();
        ctx.translate(p.x, p.y);
        ctx.rotate(p.angle);
        ctx.fillStyle = `rgba(244, 114, 182, ${p.opacity})`;
        ctx.beginPath();
        ctx.ellipse(0, 0, p.size, p.size * 0.55, 0, 0, Math.PI * 2);
        ctx.fill();
        ctx.restore();
      });

      requestAnimationFrame(renderPetals);
    }
    requestAnimationFrame(renderPetals);
  }

  // 24 Tiles Grid Mapping (7x7 Perimeter)
  // Clockwise order around the 7x7 grid:
  // Row 1 (top):    [0..6]   cols 1 to 7, row 1 (7 tiles)
  // Col 7 (right):  [7..12]  col 7, rows 2 to 7 (6 tiles)
  // Row 7 (bottom): [13..18] cols 6 down to 1, row 7 (6 tiles)
  // Col 1 (left):   [19..23] col 1, rows 6 down to 2 (5 tiles)
  const TILE_GRID_POSITIONS = [
    // Top Row (cols 1..7, row 1): 7 tiles
    { col: 1, row: 1 }, // 0: Top-Left START (Corner)
    { col: 2, row: 1 }, // 1
    { col: 3, row: 1 }, // 2
    { col: 4, row: 1 }, // 3
    { col: 5, row: 1 }, // 4
    { col: 6, row: 1 }, // 5
    { col: 7, row: 1 }, // 6: Top-Right CORNER (Island)

    // Right Col (col 7, rows 2..7): 6 tiles
    { col: 7, row: 2 }, // 7
    { col: 7, row: 3 }, // 8
    { col: 7, row: 4 }, // 9
    { col: 7, row: 5 }, // 10
    { col: 7, row: 6 }, // 11
    { col: 7, row: 7 }, // 12: Bottom-Right CORNER (Golden Bell)

    // Bottom Row (cols 6..1, row 7): 6 tiles
    { col: 6, row: 7 }, // 13
    { col: 5, row: 7 }, // 14
    { col: 4, row: 7 }, // 15
    { col: 3, row: 7 }, // 16
    { col: 2, row: 7 }, // 17
    { col: 1, row: 7 }, // 18: Bottom-Left CORNER (Fate)

    // Left Col (col 1, rows 6..2): 5 tiles
    { col: 1, row: 6 }, // 19
    { col: 1, row: 5 }, // 20
    { col: 1, row: 4 }, // 21
    { col: 1, row: 3 }, // 22
    { col: 1, row: 2 }, // 23
  ];

  // Game Engine State
  let currentPresetKey = 'drinking';
  let activeTiles: TileData[] = [];

  const defaultAvatars = [
    { defaultName: isEn ? 'Player 1' : '플레이어 1', icon: '🌸', color: '#f472b6' },
    { defaultName: isEn ? 'Player 2' : '플레이어 2', icon: '🍶', color: '#38bdf8' },
    { defaultName: isEn ? 'Player 3' : '플레이어 3', icon: '👑', color: '#fbbf24' },
    { defaultName: isEn ? 'Player 4' : '플레이어 4', icon: '🐱', color: '#c084fc' },
  ];

  let customPlayerNames: string[] = [];
  try {
    const savedNames = localStorage.getItem('streamarcade_blossom_player_names');
    if (savedNames) {
      customPlayerNames = JSON.parse(savedNames);
    }
  } catch {
    customPlayerNames = [];
  }
  // Sanitize out any demo names so default is strictly 플레이어 1 ~ 4 / Player 1 ~ 4
  if (Array.isArray(customPlayerNames)) {
    customPlayerNames = customPlayerNames.map((name, i) => {
      if (name === '침착맨' || name === '주호민' || !name) {
        return isEn ? `Player ${i + 1}` : `플레이어 ${i + 1}`;
      }
      return name;
    });
  }
  if (!Array.isArray(customPlayerNames) || customPlayerNames.length < 4) {
    customPlayerNames = defaultAvatars.map(a => a.defaultName);
  }

  function savePlayerNames() {
    try {
      localStorage.setItem('streamarcade_blossom_player_names', JSON.stringify(customPlayerNames));
    } catch {
      // ignore
    }
  }

  let players: Player[] = [
    { id: 1, name: customPlayerNames[0] || (isEn ? 'Player 1' : '플레이어 1'), icon: '🌸', color: '#f472b6', position: 0, laps: 1 }
  ];
  let currentPlayerIdx = 0;
  let isRolling = false;
  let isMoving = false;

  const diceFaceRotations: Record<number, string> = {
    1: 'rotateX(0deg) rotateY(0deg)',
    2: 'rotateX(-90deg) rotateY(0deg)',
    3: 'rotateX(0deg) rotateY(-90deg)',
    4: 'rotateX(0deg) rotateY(90deg)',
    5: 'rotateX(90deg) rotateY(0deg)',
    6: 'rotateX(180deg) rotateY(0deg)',
  };

  function loadInitialTiles() {
    const storageKey = isEn ? 'streamarcade_blossom_board_24_custom_en' : 'streamarcade_blossom_board_24_custom_ko';
    const saved = localStorage.getItem(storageKey);
    if (saved) {
      try {
        const parsed = JSON.parse(saved);
        if (Array.isArray(parsed) && parsed.length === 24) {
          activeTiles = parsed;
          return;
        }
      } catch (e) {
        // Fallback
      }
    }
    const dict = isEn ? PRESETS_EN : PRESETS_DATA;
    activeTiles = JSON.parse(JSON.stringify(dict[currentPresetKey].tiles));
  }

  function saveTiles() {
    const storageKey = isEn ? 'streamarcade_blossom_board_24_custom_en' : 'streamarcade_blossom_board_24_custom_ko';
    localStorage.setItem(storageKey, JSON.stringify(activeTiles));
  }

