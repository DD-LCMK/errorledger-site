    activeTiles[idx].title = editTileTitle.value.trim() || '지령';
    activeTiles[idx].desc = editTileDesc.value.trim() || '';
    if (selectedEmoji) activeTiles[idx].icon = selectedEmoji;
    saveTiles();
    renderBoard();
    if (editorModal) editorModal.classList.add('hidden');
  });

  function populateAllTilesEditor() {
    if (!allTilesList) return;
    allTilesList.innerHTML = activeTiles.map((t, idx) => `
      <div class="all-tile-row">
        <span class="all-tile-num">#${idx + 1}</span>
        <span>${t.icon}</span>
        <input type="text" class="all-tile-input-title" data-idx="${idx}" value="${t.title}" />
      </div>
    `).join('');
  }

  btnSaveAll?.addEventListener('click', () => {
    if (!allTilesList) return;
    const inputs = allTilesList.querySelectorAll<HTMLInputElement>('.all-tile-input-title');
    inputs.forEach(input => {
      const idx = parseInt(input.getAttribute('data-idx') || '0', 10);
      activeTiles[idx].title = input.value.trim() || activeTiles[idx].title;
    });
    saveTiles();
    renderBoard();
    if (editorModal) editorModal.classList.add('hidden');
  });

  btnResetDefault?.addEventListener('click', () => {
    const dict = isEn ? PRESETS_EN : PRESETS_DATA;
    activeTiles = JSON.parse(JSON.stringify(dict[currentPresetKey].tiles));
    saveTiles();
    renderBoard();
    populateAllTilesEditor();
    populateEditorSelect();
  });

  // English UI Adjustments
  if (isEn) {
    const brandBadge = document.querySelector('.brand-badge');
    if (brandBadge) brandBadge.textContent = '🌸 Blossom Suite';
    const panelHeading = document.querySelector('.panel-heading');
    if (panelHeading) panelHeading.textContent = 'Broadcast Panel';

    const lblPreset = document.getElementById('lbl-preset');
    if (lblPreset) lblPreset.textContent = '🎨 Presets';
    const bDrinking = document.querySelector('.preset-btn[data-preset="drinking"] .btn-text');
    if (bDrinking) bDrinking.textContent = 'Drinking Board';
    const bPenalty = document.querySelector('.preset-btn[data-preset="penalty"] .btn-text');
    if (bPenalty) bPenalty.textContent = 'Penalty Challenge';
    const bCoffee = document.querySelector('.preset-btn[data-preset="coffee"] .btn-text');
    if (bCoffee) bCoffee.textContent = 'Streamer Talk';

    const lblPlayers = document.getElementById('lbl-players');
    if (lblPlayers) lblPlayers.textContent = '👥 Participants';
    const pBtns = document.querySelectorAll('.player-cnt-btn');
    if (pBtns[0]) pBtns[0].textContent = '1P (Solo)';
    if (pBtns[1]) pBtns[1].textContent = '2P';
    if (pBtns[2]) pBtns[2].textContent = '3P';
    if (pBtns[3]) pBtns[3].textContent = '4P (Group)';

    if (btnOpenEditor) btnOpenEditor.textContent = '✏️ Edit All 24 Tiles';
    if (btnResetGame) btnResetGame.textContent = '🔄 Reset to START';

    const tipsHeading = document.getElementById('tips-heading');
    if (tipsHeading) tipsHeading.textContent = 'Stream Tips & Controls';
    const tipsList = document.getElementById('tips-list');
    if (tipsList) {
      tipsList.innerHTML = `
        <li><strong>Space</strong> : Roll dice / Advance turn</li>
        <li><strong>Click Tile</strong> : Instant tile customizer</li>
        <li><strong>Fullscreen</strong> : Press ⛶ for distraction-free play</li>
      `;
    }

    const rollText = document.getElementById('btn-roll-text');
    if (rollText) rollText.textContent = 'Roll Dice';
    const turnLbl = document.getElementById('turn-label');
    if (turnLbl) turnLbl.textContent = 'Turn';
    if (rollStatus) rollStatus.textContent = 'Roll the dice to advance on the board!';
    if (btnModalConfirm) btnModalConfirm.textContent = 'Next Turn →';

    const edTitle = document.getElementById('editor-title');
    if (edTitle) edTitle.textContent = '✏️ Custom Board Editor';
    if (tabSingle) tabSingle.textContent = 'Edit Tile';
    if (tabAll) tabAll.textContent = 'All 24 Tiles';
    const lblTarget = document.getElementById('lbl-edit-target');
    if (lblTarget) lblTarget.textContent = 'Select Tile:';
    const lblTTitle = document.getElementById('lbl-edit-title');
    if (lblTTitle) lblTTitle.textContent = 'Tile Action (Short):';
    const lblTDesc = document.getElementById('lbl-edit-desc');
    if (lblTDesc) lblTDesc.textContent = 'Description / Penalty:';
    const lblTIcon = document.getElementById('lbl-edit-icon');
    if (lblTIcon) lblTIcon.textContent = 'Emoji Icon:';
    if (btnSaveSingle) btnSaveSingle.textContent = '✓ Save This Tile';
    if (btnSaveAll) btnSaveAll.textContent = '✓ Save All';
    if (btnResetDefault) btnResetDefault.textContent = 'Reset to Defaults';

    const lblEditNames = document.getElementById('lbl-edit-names');
    if (lblEditNames) lblEditNames.textContent = '✏️ Player Names';
  }

  // Click on active turn player in center arena focuses their sidebar name input
  turnName?.addEventListener('click', () => {
    const input = document.querySelector(`.p-row-input[data-pid="${currentPlayerIdx}"]`) as HTMLInputElement | null;
    if (input) {
      input.focus();
      input.select();
    }
  });

  // Initialize
  initSakuraCanvas();
  loadInitialTiles();
  renderBoard();
  renderPlayerNamesList();
</script>
