  const btnCloseEditor = document.getElementById('btn-close-editor');
  const editTileSelect = document.getElementById('edit-tile-select') as HTMLSelectElement | null;
  const editTileTitle = document.getElementById('edit-tile-title') as HTMLInputElement | null;
  const editTileDesc = document.getElementById('edit-tile-desc') as HTMLInputElement | null;
  const emojiPalette = document.getElementById('emoji-palette');
  const btnSaveSingle = document.getElementById('btn-save-single-tile');
  const allTilesList = document.getElementById('all-tiles-list');
