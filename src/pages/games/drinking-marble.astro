  // Render Board Tiles
  function renderBoard() {
    if (!boardEl) return;

    // Remove existing tile elements, keeping the center arena
    boardEl.querySelectorAll('.board-tile').forEach(el => el.remove());

    activeTiles.forEach((tile, index) => {
      const pos = TILE_GRID_POSITIONS[index];
      const tileDiv = document.createElement('div');
      tileDiv.className = `board-tile ${tile.type === 'corner' ? 'tile-corner' : ''} ${tile.special ? 'tile-corner-' + tile.special : ''}`;
      tileDiv.id = `tile-${index}`;
      tileDiv.style.gridColumn = String(pos.col);
      tileDiv.style.gridRow = String(pos.row);

      tileDiv.innerHTML = `
        <span class="tile-step-num">#${index + 1}</span>
        <span class="tile-icon">${tile.icon}</span>
        <strong class="tile-title">${tile.title}</strong>
        <span class="tile-desc">${tile.desc}</span>
        <div class="tile-tokens-container" id="tile-tokens-${index}"></div>
      `;

      tileDiv.addEventListener('click', () => {
        openEditorForTile(index);
      });

      boardEl.appendChild(tileDiv);
    });

    updatePawnsOnBoard();
  }

  // Update Pawns on Tiles
  function updatePawnsOnBoard() {
    // Clear all token containers
    for (let i = 0; i < 24; i++) {
      const c = document.getElementById(`tile-tokens-${i}`);
      if (c) c.innerHTML = '';
    }

    // Place each player pawn on its current tile
    players.forEach(p => {
      const container = document.getElementById(`tile-tokens-${p.position}`);
      if (container) {
        const token = document.createElement('span');
        token.className = 'pawn-token';
        token.textContent = p.icon;
        token.title = `${p.name} (#${p.position + 1})`;
        container.appendChild(token);
      }
    });

    // Update Arena Players Bar
    if (arenaPlayersBar) {
      arenaPlayersBar.innerHTML = players.map((p, idx) => `
        <div class="player-token-pill ${idx === currentPlayerIdx ? 'active-turn' : ''}" data-pid="${idx}" style="cursor: pointer;" title="${isEn ? 'Click to edit name in sidebar' : '클릭하여 이름 수정'}">
          <span>${p.icon}</span>
          <span>${p.name}</span>
          <span style="opacity: 0.6;">(#${p.position + 1})</span>
        </div>
      `).join('');

      arenaPlayersBar.querySelectorAll('.player-token-pill').forEach(pill => {
        pill.addEventListener('click', () => {
          const pid = pill.getAttribute('data-pid');
          const input = document.querySelector(`.p-row-input[data-pid="${pid}"]`) as HTMLInputElement | null;
          if (input) {
            input.focus();
            input.select();
          }
        });
      });
    }

    // Update active highlight on sidebar player name rows
    document.querySelectorAll('.player-name-row').forEach((row, idx) => {
      if (idx === currentPlayerIdx) {
        row.classList.add('active-turn-row');
      } else {
        row.classList.remove('active-turn-row');
      }
    });

    const cur = players[currentPlayerIdx];
    if (turnIcon) turnIcon.textContent = cur.icon;
    if (turnName) turnName.textContent = cur.name;
    if (lapCounter) lapCounter.textContent = isEn ? `Lap: ${cur.laps}` : `바퀴: ${cur.laps}Lap`;
  }

  // Roll Dice & Move Pawn
  function rollDice() {
    if (isRolling || isMoving) return;
    isRolling = true;
    if (rollBtn) rollBtn.disabled = true;

    // Shake audio
    sfx.playDiceShake();
    const interval = setInterval(() => sfx.playDiceShake(), 220);

    const rolledNumber = Math.floor(Math.random() * 6) + 1;
    if (rollStatus) {
      rollStatus.textContent = isEn ? 'Rolling the dice...' : '주사위 굴리는 중...';
    }

    if (cubeDice) {
      cubeDice.style.setProperty('--final-rotation', diceFaceRotations[rolledNumber]);
      cubeDice.classList.remove('rolling');
      void cubeDice.offsetWidth; // Reflow
      cubeDice.classList.add('rolling');
    }

    setTimeout(() => {
      clearInterval(interval);
      isRolling = false;

      if (rollStatus) {
        rollStatus.textContent = isEn
          ? `🎲 Rolled a ${rolledNumber}! Moving ${rolledNumber} steps...`
          : `🎲 ${rolledNumber}이 나왔습니다! ${rolledNumber}칸 전진합니다.`;
      }

      // Start stepping pawn
      stepPawn(rolledNumber, 0);
    }, 1150);
  }

  // Step-by-step Pawn Hopping Animation
  function stepPawn(stepsRemaining: number, stepIdx: number) {
    if (stepsRemaining <= 0) {
      // Arrived at destination
      isMoving = false;
      if (rollBtn) rollBtn.disabled = false;
      handleLanding(players[currentPlayerIdx].position);
      return;
    }

    isMoving = true;
    const player = players[currentPlayerIdx];
    const prevPos = player.position;
    const nextPos = (prevPos + 1) % 24;

    if (nextPos === 0) {
      player.laps += 1;
    }
    player.position = nextPos;

    sfx.playHop(stepIdx);
    updatePawnsOnBoard();

    // Highlight active destination
    document.querySelectorAll('.board-tile').forEach(t => t.classList.remove('active-destination'));
    const destEl = document.getElementById(`tile-${nextPos}`);
    if (destEl) destEl.classList.add('active-destination');

    setTimeout(() => {
      stepPawn(stepsRemaining - 1, stepIdx + 1);
    }, 280);
  }

  // Handle Tile Landing
  function handleLanding(tileIndex: number) {
    const tile = activeTiles[tileIndex];
    const player = players[currentPlayerIdx];

    sfx.playLand();

    // Fill Action Modal
    if (modalToken) modalToken.textContent = player.icon;
    if (modalName) modalName.textContent = player.name;
    if (modalIcon) modalIcon.textContent = tile.icon;
    if (modalTitle) modalTitle.textContent = tile.title;
    if (modalDesc) modalDesc.textContent = tile.desc;

    if (actionModal) {
      actionModal.classList.remove('hidden');
    }
  }

  function advanceTurn() {
    if (actionModal) actionModal.classList.add('hidden');
    document.querySelectorAll('.board-tile').forEach(t => t.classList.remove('active-destination'));

    // Move to next player
    currentPlayerIdx = (currentPlayerIdx + 1) % players.length;
    updatePawnsOnBoard();

    if (rollStatus) {
      const nextP = players[currentPlayerIdx];
      rollStatus.textContent = isEn
        ? `${nextP.name}'s turn! Press Space or Roll.`
        : `${nextP.name}님의 차례입니다! 주사위를 굴려주세요.`;
    }
  }

  btnModalConfirm?.addEventListener('click', advanceTurn);

  // Roll Button Event
  rollBtn?.addEventListener('click', rollDice);

  // Spacebar Hotkey
  window.addEventListener('keydown', (e) => {
    if (e.code === 'Space' && e.target === document.body) {
      e.preventDefault();
      if (actionModal && !actionModal.classList.contains('hidden')) {
        advanceTurn();
      } else if (!isRolling && !isMoving) {
        rollDice();
      }
