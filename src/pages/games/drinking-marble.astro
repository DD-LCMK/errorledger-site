    display: flex;
    align-items: center;
    gap: 0.35rem;
    font-size: 0.75rem;
    font-weight: 800;
    color: #f472b6;
    margin-bottom: 0.35rem;
  }

  .tips-list {
    margin: 0;
    padding-left: 1.1rem;
    font-size: 0.72rem;
    color: #94a3b8;
    line-height: 1.45;
  }

  .tips-list strong {
    color: #e2e8f0;
  }

  /* Responsive fallback for smaller screens */
  @media (max-width: 960px) {
    .board-layout-container.side-by-side {
      flex-direction: column;
      align-items: center;
    }
    .board-side-panel {
      width: 100%;
      max-width: 740px;
    }
