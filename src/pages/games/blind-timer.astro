</style>

<script is:inline>
(function () {
  const params = new URLSearchParams(window.location.search);
  const isEn = params.get('lang') === 'en' || window.location.pathname.startsWith('/en');

  function applyLang() {
    if (!isEn) return;
    document.querySelectorAll('[data-en]').forEach((el) => {
      el.textContent = el.getAttribute('data-en');
    });
    const chalInput = document.getElementById('bt-chal-name');
    if (chalInput && chalInput.value === '스트리머 #1') {
      chalInput.value = 'Player #1';
    }
  }
  applyLang();

  const STORAGE_KEY = 'el_blind_timer_v1';

  let stats = {
    pbDiffMs: null, // smallest absolute ms error
    pbTarget: 7.77,
    jackpots: 0,
    totalRuns: 0,
    sPlusRuns: 0,
    curStreak: 0,
    bestStreak: 0,
    leaderboard: []
  };

  function loadStats() {
    try {
      const raw = localStorage.getItem(STORAGE_KEY);
      if (raw) {
        const parsed = JSON.parse(raw);
        stats = { ...stats, ...parsed };
      }
    } catch (_) {}
  }

  function saveStats() {
    try {
      localStorage.setItem(STORAGE_KEY, JSON.stringify(stats));
    } catch (_) {}
  }

  loadStats();

  // State
  let targetSec = 7.77;
  let blindMode = 'standard'; // 'standard' | 'hardcore' | 'troll'
  let isRunning = false;
  let startTimePerf = 0;
  let rafId = 0;
  let lastTickSec = 0;
  let lastTrollBeepTime = 0;
  let lastResultShareText = '';

  // Audio
  let audioCtx = null;
  function getAudio() {
    if (!audioCtx) {
      const AC = window.AudioContext || window.webkitAudioContext;
      if (AC) audioCtx = new AC();
    }
    if (audioCtx && audioCtx.state === 'suspended') {
      audioCtx.resume();
    }
    return audioCtx;
  }

  function isMuted() {
    return localStorage.getItem('el_sound_muted') === '1';
  }

  function playBeep(freq, dur, vol = 0.14, type = 'sine') {
    if (isMuted()) return;
    const ctx = getAudio();
    if (!ctx) return;
    const now = ctx.currentTime;
    const osc = ctx.createOscillator();
    const gain = ctx.createGain();
    osc.type = type;
    osc.frequency.setValueAtTime(freq, now);
    gain.gain.setValueAtTime(vol, now);
    gain.gain.exponentialRampToValueAtTime(0.001, now + dur);
    osc.connect(gain);
    gain.connect(ctx.destination);
    osc.start(now);
    osc.stop(now + dur + 0.01);
  }

  function playJackpotFanfare() {
    if (isMuted()) return;
    const ctx = getAudio();
    if (!ctx) return;
    const notes = [523.25, 659.25, 783.99, 1046.5, 1318.5];
    notes.forEach((f, idx) => {
      setTimeout(() => playBeep(f, 0.24, 0.2, 'triangle'), idx * 70);
    });
  }

  // Confetti
  const canvas = document.getElementById('bt-confetti-canvas');
  const cctx = canvas ? canvas.getContext('2d') : null;
  let particles = [];

  function triggerConfetti() {
    if (!canvas || !cctx) return;
    canvas.width = canvas.offsetWidth;
    canvas.height = canvas.offsetHeight;
    particles = [];
    const colors = ['#facc15', '#38bdf8', '#34d399', '#f43f5e', '#c084fc'];
    for (let i = 0; i < 70; i++) {
      particles.push({
        x: canvas.width / 2,
        y: canvas.height / 2,
        vx: (Math.random() - 0.5) * 12,
        vy: (Math.random() - 0.8) * 12,
        size: 5 + Math.random() * 6,
        color: colors[i % colors.length],
        life: 1.0
      });
    }
    requestAnimationFrame(stepConfetti);
  }

  function stepConfetti() {
    if (!cctx || particles.length === 0) return;
    cctx.clearRect(0, 0, canvas.width, canvas.height);
    particles.forEach((p) => {
      p.x += p.vx;
      p.y += p.vy;
      p.vy += 0.28;
      p.life -= 0.018;
      if (p.life > 0) {
        cctx.fillStyle = p.color;
        cctx.globalAlpha = Math.max(0, p.life);
        cctx.fillRect(p.x, p.y, p.size, p.size);
      }
    });
    cctx.globalAlpha = 1;
    particles = particles.filter((p) => p.life > 0);
    if (particles.length > 0) requestAnimationFrame(stepConfetti);
    else cctx.clearRect(0, 0, canvas.width, canvas.height);
  }

  // DOM Elements
  const elPbDiff = document.getElementById('bt-pb-diff');
  const elJackpots = document.getElementById('bt-jackpots');
  const elSRate = document.getElementById('bt-s-rate');
  const elStreak = document.getElementById('bt-streak');
  const elResetBtn = document.getElementById('bt-reset-btn');
  const elPresetBtns = document.querySelectorAll('.bt-preset-btn');
  const elCustomInput = document.getElementById('bt-custom-target');
  const elModeBtns = document.querySelectorAll('.bt-mode-btn');
  const elScreen = document.getElementById('bt-screen');
  const elTargetPill = document.getElementById('bt-target-pill');
  const elStatusPill = document.getElementById('bt-status-pill');
  const elDigitsMain = document.getElementById('bt-digits-main');
  const elDigitsMs = document.getElementById('bt-digits-ms');
  const elScreenSub = document.getElementById('bt-screen-sub');
  const elMeterPin = document.getElementById('bt-meter-pin');
  const elResultBox = document.getElementById('bt-result-box');
  const elGradeBadge = document.getElementById('bt-grade-badge');
  const elResHeadline = document.getElementById('bt-res-headline');
  const elResComment = document.getElementById('bt-res-comment');
  const elCopyResBtn = document.getElementById('bt-copy-res-btn');
  const elTriggerBtn = document.getElementById('bt-trigger-btn');
  const elTrigIcon = document.getElementById('bt-trig-icon');
  const elTrigMain = document.getElementById('bt-trig-main');
  const elTrigSub = document.getElementById('bt-trig-sub');
  const elChalName = document.getElementById('bt-chal-name');
  const elAutoIncChk = document.getElementById('bt-auto-inc-chk');
  const elRankList = document.getElementById('bt-rank-list');
  const elCopyBoardBtn = document.getElementById('bt-copy-board-btn');
  const elClearBoardBtn = document.getElementById('bt-clear-board-btn');

  function formatSecMain(sec) {
    const whole = Math.floor(sec);
    const centi = Math.floor((sec - whole) * 100);
    return `${String(whole).padStart(2, '0')}.${String(centi).padStart(2, '0')}`;
  }

  function formatSecMsSub(sec) {
    const msDigit = Math.floor((sec * 1000) % 10);
    return `.${msDigit}s`;
  }

  function updateHUD() {
    if (stats.pbDiffMs === null) {
      elPbDiff.textContent = isEn ? 'No Record' : '기록 없음';
    } else {
      const s = (stats.pbDiffMs / 1000).toFixed(3);
      elPbDiff.textContent = `±${s}s (${stats.pbDiffMs}ms)`;
    }
    elJackpots.textContent = isEn ? `${stats.jackpots}` : `${stats.jackpots}회`;
    const pct = stats.totalRuns > 0 ? Math.round((stats.sPlusRuns / stats.totalRuns) * 100) : 0;
    elSRate.textContent = `${pct}% (${stats.sPlusRuns}/${stats.totalRuns})`;
    elStreak.textContent = isEn
      ? `${stats.curStreak} (Best ${stats.bestStreak})`
      : `${stats.curStreak}연속 (최고 ${stats.bestStreak})`;

    renderLeaderboard();
  }

  function renderLeaderboard() {
    if (!stats.leaderboard || stats.leaderboard.length === 0) {
      elRankList.innerHTML = `<div class="bt-rank-empty">${
        isEn
          ? 'No attempts yet! Enter a challenger name and stop the clock.'
          : '아직 도전 기록이 없습니다! 도전자 이름을 입력하고 스톱워치를 멈춰보세요.'
      }</div>`;
      return;
    }

    elRankList.innerHTML = stats.leaderboard
      .slice(0, 15)
      .map((item, idx) => {
        const medal = idx === 0 ? '🥇' : idx === 1 ? '🥈' : idx === 2 ? '🥉' : `${idx + 1}`;
        const sign = item.diffSec >= 0 ? '+' : '';
        return `
          <div class="bt-rank-item ${idx === 0 ? 'top-1' : ''}">
            <div class="bt-rank-left">
              <span class="bt-rank-num">${medal}</span>
              <div class="bt-rank-info">
                <span class="bt-rank-name">${item.name}</span>
                <span class="bt-rank-meta">🎯 ${item.target.toFixed(2)}s → ⏱️ ${item.actual.toFixed(3)}s</span>
              </div>
            </div>
            <div class="bt-rank-right">
              <span class="bt-rank-diff">${sign}${item.diffSec.toFixed(3)}s</span>
              <span class="bt-rank-grade">${item.grade}</span>
            </div>
          </div>
        `;
      })
      .join('');
  }

  function updateTargetDisplay() {
    elTargetPill.textContent = `🎯 TARGET: ${formatSecMain(targetSec)}s`;
    if (!isRunning) {
      elDigitsMain.textContent = '00.00';
      elDigitsMs.textContent = '.0s';
    }
  }

  function evaluateGrade(absDiffSec, signedDiffSec) {
    // 0.00s rounded check (< 0.005s = ±4ms)
    if (absDiffSec < 0.005) {
      return {
        grade: '👑 JACKPOT',
        color: '#facc15',
        comment: isEn
          ? 'GODLIKE HUMAN ATOMIC CLOCK!! 0.00s Perfect Jackpot!'
          : '인간 원자시계 강림!! 0.00초 퍼펙트 잭팟 달성! 오늘 로또 사세요!'
      };
    }
    if (absDiffSec <= 0.03) {
      return {
        grade: '⚡ SSS급',
        color: '#38bdf8',
        comment: isEn
          ? 'Superhuman internal clock! Within ±0.03 seconds!'
          : '초능력 수준의 시간 감각! ±0.03초 이내 초정밀 칼박입니다!'
      };
    }
    if (absDiffSec <= 0.08) {
      return {
        grade: '🔥 S급',
        color: '#34d399',
        comment: isEn
          ? 'Pro rhythm sense! Razor-sharp stop within ±0.08s.'
          : '칼박 장인 인정! 눈 감고도 리듬 게임을 씹어먹을 감각입니다.'
      };
    }
    if (absDiffSec <= 0.2) {
      return {
        grade: '✨ A급',
        color: '#a78bfa',
        comment: isEn
          ? 'Solid timing! Very close to the target.'
          : '준수한 생체 시계! 아깝게 칼박은 놓쳤지만 상위권 감각입니다.'
      };
    }
    if (absDiffSec <= 0.5) {
      return {
        grade: '😅 B급',
        color: '#fb923c',
        comment:
          signedDiffSec < 0
            ? isEn
              ? 'A bit hasty! Your internal clock is running fast.'
              : '성격이 조금 급하시군요! 목표보다 손가락이 먼저 나갔습니다.'
            : isEn
            ? 'A bit relaxed! Your internal clock is running slow.'
            : '세월아 네월아~ 머릿속 시계 배터리가 살짝 닳았습니다!'
      };
    }
    return {
      grade: '🐢 C급',
      color: '#f87171',
      comment:
        signedDiffSec < 0
          ? isEn
            ? 'Way too early! Did you panic press?'
            : '너무 일찍 눌렀습니다! 암전되자마자 당황해서 누르셨나요?'
          : isEn
          ? 'Way too late! Did you fall asleep counting?'
          : '한참 지나서 멈췄습니다! 숫자 세다가 주무신 건 아니죠?'
    };
  }

  function setControlsDisabled(disabled) {
    elPresetBtns.forEach((b) => (b.disabled = disabled));
    elCustomInput.disabled = disabled;
    elModeBtns.forEach((b) => (b.disabled = disabled));
  }

  function startStopwatch() {
    if (isRunning) return;
    isRunning = true;
    startTimePerf = performance.now();
    lastTickSec = 0;
    lastTrollBeepTime = 1.5;

    setControlsDisabled(true);
    elResultBox.style.display = 'none';
    elMeterPin.style.display = 'none';
    elScreen.classList.remove('jackpot-win');

    elTriggerBtn.className = 'bt-trigger-btn running';
    elTrigIcon.textContent = '🛑';
    elTrigMain.textContent = isEn
      ? `STOP AT ${targetSec.toFixed(2)}s! (Space / Click)`
      : `정확히 ${targetSec.toFixed(2)}초에 STOP! (Space / 클릭)`;
    elTrigSub.textContent = isEn
      ? 'Count in your head and press!'
      : '머릿속으로 숫자를 세다가 정확히 눌러주세요!';

    playBeep(660, 0.08, 0.14, 'sine');
    rafId = requestAnimationFrame(tickLoop);
  }

  function tickLoop(nowPerf) {
    if (!isRunning) return;
    const elapsedSec = (nowPerf - startTimePerf) / 1000;

    // Auto stop safety at 59.99s
    if (elapsedSec >= 59.99) {
      stopStopwatch(nowPerf);
      return;
    }

    const blindThreshold = blindMode === 'hardcore' ? 0.0 : 1.5;

    if (elapsedSec < blindThreshold) {
      // Visible phase
      elScreen.classList.remove('blind-active');
      elDigitsMain.className = 'bt-digits-main';
      elDigitsMain.textContent = formatSecMain(elapsedSec);
      elDigitsMs.textContent = formatSecMsSub(elapsedSec);
      elStatusPill.className = 'bt-status-pill counting';
      elStatusPill.textContent = isEn ? '⏱️ COUNTING...' : '⏱️ 카운트 진행 중';

      const wholeSec = Math.floor(elapsedSec);
      if (wholeSec > lastTickSec) {
        lastTickSec = wholeSec;
        playBeep(880, 0.05, 0.1, 'sine');
      }
    } else {
      // Blind or Troll phase
      elScreen.classList.add('blind-active');
      elStatusPill.className = 'bt-status-pill blind';

      if (blindMode === 'troll') {
        elStatusPill.textContent = isEn ? '🌀 FAKE NUMBER DISTRACTION!' : '🌀 방해 공작 교란 중!';
        elDigitsMain.className = 'bt-digits-main troll-mask';
        // Flash deceptive numbers every ~110ms
        if (Math.random() < 0.35) {
          const fakeWhole = Math.floor(Math.random() * 14);
          const fakeCenti = Math.floor(Math.random() * 99);
          elDigitsMain.textContent = `${String(fakeWhole).padStart(2, '0')}.${String(fakeCenti).padStart(2, '0')}`;
          elDigitsMs.textContent = `.${Math.floor(Math.random() * 9)}s`;
        }
        if (elapsedSec - lastTrollBeepTime > 0.28 + Math.random() * 0.45) {
          lastTrollBeepTime = elapsedSec;
          playBeep(300 + Math.random() * 700, 0.05, 0.08, 'triangle');
        }
      } else {
        elStatusPill.textContent = isEn ? '🕶️ BLIND MODE ACTIVE' : '🕶️ 암전 진행 중 (감각 집중!)';
        elDigitsMain.className = 'bt-digits-main blind-mask';
        elDigitsMain.textContent = '??.??';
        elDigitsMs.textContent = '.?s';
      }
    }

    rafId = requestAnimationFrame(tickLoop);
  }

  function autoIncrementChallengerName() {
    if (!elAutoIncChk.checked) return;
    const val = elChalName.value.trim();
    const m = val.match(/^(.*?#?)(\d+)$/);
    if (m) {
      const nextNum = parseInt(m[2], 10) + 1;
      elChalName.value = `${m[1]}${nextNum}`;
    }
  }

  function stopStopwatch(stopPerf) {
    if (!isRunning) return;
    const elapsedSec = (stopPerf - startTimePerf) / 1000;
    // Ignore accidental bounce within first 180ms
    if (elapsedSec < 0.18) return;

    isRunning = false;
    cancelAnimationFrame(rafId);
    setControlsDisabled(false);

    const actualSec = Math.round(elapsedSec * 1000) / 1000;
    const signedDiffSec = actualSec - targetSec;
    const absDiffSec = Math.abs(signedDiffSec);
    const absDiffMs = Math.round(absDiffSec * 1000);

    // Reveal true digits
    elScreen.classList.remove('blind-active');
    elDigitsMain.className = 'bt-digits-main';
    elDigitsMain.textContent = formatSecMain(actualSec);
    elDigitsMs.textContent = formatSecMsSub(actualSec);

    const evalRes = evaluateGrade(absDiffSec, signedDiffSec);

    if (absDiffSec < 0.005) {
      elScreen.classList.add('jackpot-win');
      playJackpotFanfare();
      triggerConfetti();
    } else if (absDiffSec <= 0.08) {
      playBeep(987.77, 0.18, 0.18, 'triangle');
    } else {
      playBeep(240, 0.22, 0.18, 'sawtooth');
    }

    elStatusPill.className = 'bt-status-pill';
    elStatusPill.textContent = evalRes.grade;

    // Update Error Pin on Meter (-1.0s to +1.0s mapped to 0%..100%)
    const clampedDiff = Math.max(-1.0, Math.min(1.0, signedDiffSec));
    const pinPct = 50 + (clampedDiff / 1.0) * 50;
    elMeterPin.style.display = 'block';
    elMeterPin.style.left = `${pinPct}%`;
    elMeterPin.style.background = evalRes.color;

    // Update Result Card
    const signStr = signedDiffSec >= 0 ? '+' : '';
    elResultBox.style.display = 'flex';
    elGradeBadge.textContent = evalRes.grade;
    elGradeBadge.style.color = evalRes.color;
    elGradeBadge.style.borderColor = evalRes.color;
    elResHeadline.textContent = isEn
      ? `Target ${targetSec.toFixed(2)}s → Stopped at ${actualSec.toFixed(3)}s (Error: ${signStr}${signedDiffSec.toFixed(3)}s)`
      : `목표 ${targetSec.toFixed(2)}초 → 기록 ${actualSec.toFixed(3)}초 (오차: ${signStr}${signedDiffSec.toFixed(3)}초 / ${signStr}${Math.round(signedDiffSec * 1000)}ms)`;
    elResComment.textContent = evalRes.comment;

    // Reset Trigger Button
    elTriggerBtn.className = 'bt-trigger-btn ready';
    elTrigIcon.textContent = '⏱️';
    elTrigMain.textContent = isEn ? 'TRY AGAIN (Space / Click)' : '다시 도전하기 (Space / 클릭)';
    elTrigSub.textContent = isEn ? 'Triggers instantly on press (0ms)' : '누르는 즉시(0ms) 작동합니다';

    // Update Persistent Stats & Leaderboard
    stats.totalRuns += 1;
    if (stats.pbDiffMs === null || absDiffMs < stats.pbDiffMs) {
      stats.pbDiffMs = absDiffMs;
      stats.pbTarget = targetSec;
    }
    if (absDiffSec < 0.005) {
      stats.jackpots += 1;
    }
    if (absDiffSec <= 0.08) {
      stats.sPlusRuns += 1;
    }
    if (absDiffSec <= 0.1) {
      stats.curStreak += 1;
      if (stats.curStreak > stats.bestStreak) stats.bestStreak = stats.curStreak;
    } else {
      stats.curStreak = 0;
    }

    const chalName = (elChalName.value || '').trim() || (isEn ? 'Player' : '스트리머');
    stats.leaderboard.push({
      name: chalName,
      target: targetSec,
      actual: actualSec,
      diffSec: signedDiffSec,
      absDiffSec: absDiffSec,
      grade: evalRes.grade
    });
    stats.leaderboard.sort((a, b) => a.absDiffSec - b.absDiffSec);
    if (stats.leaderboard.length > 30) stats.leaderboard.length = 30;

    saveStats();
    updateHUD();
    autoIncrementChallengerName();

    lastResultShareText = isEn
      ? `⏱️ [Blind Timer ${targetSec.toFixed(2)}s] ${chalName}: Stopped at ${actualSec.toFixed(3)}s (${signStr}${signedDiffSec.toFixed(3)}s | ${evalRes.grade}) — https://errorledger.com/en/games/blind-timer`
      : `⏱️ [인간 스톱워치 ${targetSec.toFixed(2)}초 챌린지] ${chalName}: ${actualSec.toFixed(3)}초 기록! (오차 ${signStr}${signedDiffSec.toFixed(3)}초 | ${evalRes.grade}) — https://errorledger.com/games/blind-timer`;
  }

  // Event Listeners
  elTriggerBtn.addEventListener('pointerdown', (e) => {
    e.preventDefault();
    if (!isRunning) startStopwatch();
    else stopStopwatch(performance.now());
  });

  window.addEventListener('keydown', (e) => {
    if (e.target && (e.target.tagName === 'INPUT' || e.target.tagName === 'TEXTAREA')) return;
    if (e.repeat) return;
    if (e.code === 'Space') {
      e.preventDefault();
      if (!isRunning) startStopwatch();
      else stopStopwatch(performance.now());
    }
  });

  elPresetBtns.forEach((btn) => {
    btn.addEventListener('click', () => {
      if (isRunning) return;
      elPresetBtns.forEach((b) => b.classList.remove('active'));
      btn.classList.add('active');
      elCustomInput.value = '';
      targetSec = parseFloat(btn.dataset.target) || 7.77;
      updateTargetDisplay();
    });
  });

  elCustomInput.addEventListener('input', () => {
    if (isRunning) return;
    const val = parseFloat(elCustomInput.value);
    if (!isNaN(val) && val >= 2 && val <= 30) {
      elPresetBtns.forEach((b) => b.classList.remove('active'));
      targetSec = Math.round(val * 100) / 100;
      updateTargetDisplay();
    }
  });

  elModeBtns.forEach((btn) => {
    btn.addEventListener('click', () => {
      if (isRunning) return;
      elModeBtns.forEach((b) => b.classList.remove('active'));
      btn.classList.add('active');
      blindMode = btn.dataset.mode || 'standard';
      if (blindMode === 'standard') {
        elScreenSub.textContent = isEn
          ? 'The clock hides as ??.?? after 1.50 seconds!'
          : '시작 후 1.50초 뒤에 시계가 ??.?? 로 가려집니다!';
      } else if (blindMode === 'hardcore') {
        elScreenSub.textContent = isEn
          ? 'HARDCORE: The clock hides at 0.00s immediately!'
          : '하드코어: 시작과 동시에 0.00초부터 즉시 ??.?? 로 암전됩니다!';
      } else {
        elScreenSub.textContent = isEn
          ? 'DISTRACTION: Fake numbers & off-beat beeps after 1.50s!'
          : '방해 공작: 1.50초 뒤부터 가짜 숫자와 엇박자 비프음이 당신을 현혹합니다!';
      }
    });
  });

  elCopyResBtn.addEventListener('click', () => {
    if (!lastResultShareText) return;
    navigator.clipboard.writeText(lastResultShareText).then(() => {
      const orig = elCopyResBtn.innerHTML;
      elCopyResBtn.innerHTML = isEn ? '✅ Copied!' : '✅ 복사 완료!';
      setTimeout(() => (elCopyResBtn.innerHTML = orig), 1500);
    });
  });

  elCopyBoardBtn.addEventListener('click', () => {
    if (!stats.leaderboard || stats.leaderboard.length === 0) return;
    const lines = stats.leaderboard.slice(0, 10).map((item, i) => {
      const sign = item.diffSec >= 0 ? '+' : '';
      return `${i + 1}위. ${item.name} — ${item.actual.toFixed(3)}s (목표 ${item.target.toFixed(2)}s | 오차 ${sign}${item.diffSec.toFixed(3)}s | ${item.grade})`;
    });
    const text = `🏆 [인간 스톱워치 도전자 순위표]\n${lines.join('\n')}\nhttps://errorledger.com/games/blind-timer`;
    navigator.clipboard.writeText(text).then(() => {
      const orig = elCopyBoardBtn.innerHTML;
      elCopyBoardBtn.innerHTML = isEn ? '✅ Copied!' : '✅ 복사됨!';
      setTimeout(() => (elCopyBoardBtn.innerHTML = orig), 1500);
    });
  });

  elClearBoardBtn.addEventListener('click', () => {
    if (!stats.leaderboard || stats.leaderboard.length === 0) return;
    stats.leaderboard = [];
    saveStats();
    renderLeaderboard();
  });

  elResetBtn.addEventListener('click', () => {
    if (isRunning) return;
    const msg = isEn ? 'Reset all personal records and leaderboard?' : '모든 개인 신기록과 순위표를 초기화하시겠습니까?';
    if (!confirm(msg)) return;
    stats = {
      pbDiffMs: null,
      pbTarget: 7.77,
      jackpots: 0,
      totalRuns: 0,
      sPlusRuns: 0,
      curStreak: 0,
      bestStreak: 0,
      leaderboard: []
    };
    saveStats();
    updateHUD();
  });

  updateHUD();
  updateTargetDisplay();
})();
</script>

