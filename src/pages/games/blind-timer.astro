---
import GameLayout from '../../layouts/GameLayout.astro';
import { getEntry } from 'astro:content';

const entry = await getEntry('games', 'blind-timer');
if (!entry) throw new Error('blind-timer entry not found');
---

<GameLayout entry={entry}>
  <div class="bt-app" id="bt-app">
    <!-- Top Personal Best HUD -->
    <div class="bt-hud">
      <div class="bt-stat-card best-card">
        <span class="bt-stat-label" data-ko="👑 최소 오차 신기록" data-en="👑 BEST PRECISION PB">👑 최소 오차 신기록</span>
        <strong class="bt-stat-val cyan" id="bt-pb-diff">기록 없음</strong>
      </div>
      <div class="bt-stat-card">
        <span class="bt-stat-label" data-ko="🎰 0.00초 잭팟 달성" data-en="🎰 0.00s JACKPOTS">🎰 0.00초 잭팟 달성</span>
        <strong class="bt-stat-val gold" id="bt-jackpots">0회</strong>
      </div>
      <div class="bt-stat-card">
        <span class="bt-stat-label" data-ko="⚡ 칼박 성공률 (±0.08초)" data-en="⚡ S+ HIT RATE (±0.08s)">⚡ 칼박 성공률 (±0.08초)</span>
        <strong class="bt-stat-val emerald" id="bt-s-rate">0% (0/0)</strong>
      </div>
      <div class="bt-stat-card">
        <span class="bt-stat-label" data-ko="🔥 연속 칼박 (±0.10초)" data-en="🔥 PRECISION STREAK">🔥 연속 칼박 (±0.10초)</span>
        <strong class="bt-stat-val amber" id="bt-streak">0연속 (최고 0)</strong>
      </div>
      <button type="button" class="bt-reset-btn" id="bt-reset-btn">
        🔄 <span data-ko="초기화" data-en="Reset">초기화</span>
      </button>
    </div>

    <!-- Main 2-Column Layout -->
    <div class="bt-main-grid">
      <!-- Left / Center Stopwatch Arena -->
      <section class="bt-arena-col">
        <div class="bt-arena-card" id="bt-arena-card">
          <!-- Confetti Canvas for Jackpot -->
          <canvas id="bt-confetti-canvas" class="bt-confetti-canvas"></canvas>

          <!-- Target Time Presets + Mode Controls -->
          <div class="bt-controls-top">
            <div class="bt-control-group">
              <span class="bt-ctrl-label" data-ko="🎯 목표 시간 선택" data-en="🎯 TARGET TIME">🎯 목표 시간 선택</span>
              <div class="bt-preset-row" id="bt-preset-row">
                <button type="button" class="bt-preset-btn" data-target="3.33">⚡ 3.33s</button>
                <button type="button" class="bt-preset-btn" data-target="5.00">⏱️ 5.00s</button>
                <button type="button" class="bt-preset-btn active" data-target="7.77">🎰 7.77s</button>
                <button type="button" class="bt-preset-btn" data-target="10.00">🔥 10.00s</button>
                <div class="bt-custom-wrap">
                  <input type="number" id="bt-custom-target" class="bt-custom-input" min="2" max="30" step="0.01" placeholder="직접 입력" title="2.00 ~ 30.00초 자유 설정" />
                  <span class="bt-custom-unit">s</span>
                </div>
              </div>
            </div>

            <div class="bt-control-group">
              <span class="bt-ctrl-label" data-ko="🕶️ 블라인드 난이도" data-en="🕶️ BLIND MODE">🕶️ 블라인드 난이도</span>
              <div class="bt-mode-row" id="bt-mode-row">
                <button type="button" class="bt-mode-btn active" data-mode="standard">
                  🕶️ <span data-ko="표준 (1.5초 후 암전)" data-en="Standard (Blind @ 1.5s)">표준 (1.5초 후 암전)</span>
                </button>
                <button type="button" class="bt-mode-btn" data-mode="hardcore">
                  🌑 <span data-ko="하드코어 (0초 즉시 암전)" data-en="Hardcore (0s Instant Blind)">하드코어 (0초 즉시 암전)</span>
                </button>
                <button type="button" class="bt-mode-btn" data-mode="troll">
                  🌀 <span data-ko="방해 공작 (가짜 숫자 교란)" data-en="Distraction (Fake Numbers)">방해 공작 (가짜 숫자 교란)</span>
                </button>
              </div>
            </div>
          </div>

          <!-- Digital Stopwatch Screen -->
          <div class="bt-screen" id="bt-screen">
            <div class="bt-screen-top">
              <span class="bt-target-pill" id="bt-target-pill">🎯 TARGET: 07.77s</span>
              <span class="bt-status-pill" id="bt-status-pill" data-ko="대기 중 • Space로 시작" data-en="READY • Press Space">대기 중 • Space로 시작</span>
            </div>

            <div class="bt-digits-wrap" id="bt-digits-wrap">
              <span class="bt-digits-main" id="bt-digits-main">00.00</span>
              <span class="bt-digits-ms" id="bt-digits-ms">.0s</span>
            </div>

            <div class="bt-screen-sub" id="bt-screen-sub" data-ko="시작 후 1.50초 뒤에 시계가 ??.?? 로 가려집니다!" data-en="The clock hides as ??.?? after 1.50 seconds!">
              시작 후 1.50초 뒤에 시계가 ??.?? 로 가려집니다!
            </div>

            <!-- Precision Error Bar (-1.00s ~ 0.00s ~ +1.00s) -->
            <div class="bt-meter-wrap" id="bt-meter-wrap">
              <div class="bt-meter-labels">
                <span data-ko="◀ 너무 빠름 (-1.0s)" data-en="◀ EARLY (-1.0s)">◀ 너무 빠름 (-1.0s)</span>
                <span class="bt-meter-center-lbl">🎯 0.00s (PERFECT)</span>
                <span data-ko="너무 느림 (+1.0s) ▶" data-en="LATE (+1.0s) ▶">너무 느림 (+1.0s) ▶</span>
              </div>
              <div class="bt-meter-track">
                <div class="bt-meter-zone-s"></div>
                <div class="bt-meter-zone-jackpot"></div>
                <div class="bt-meter-pin" id="bt-meter-pin" style="left: 50%; display: none;"></div>
              </div>
            </div>
          </div>

          <!-- Result Grade & Commentary Card -->
          <div class="bt-result-box" id="bt-result-box" style="display: none;">
            <div class="bt-res-left">
              <span class="bt-grade-badge" id="bt-grade-badge">⚡ SSS급</span>
              <div class="bt-res-texts">
                <strong class="bt-res-headline" id="bt-res-headline">오차 +0.012초 (+12ms)</strong>
                <p class="bt-res-comment" id="bt-res-comment">소름 돋는 생체 시계! 프로게이머급 시간 감각입니다.</p>
              </div>
            </div>
            <button type="button" class="bt-copy-res-btn" id="bt-copy-res-btn">
              📋 <span data-ko="결과 복사" data-en="Copy Result">결과 복사</span>
            </button>
          </div>

          <!-- Giant Trigger Button (PointerDown / Spacebar instant response) -->
          <button type="button" class="bt-trigger-btn ready" id="bt-trigger-btn">
            <span class="bt-trig-icon" id="bt-trig-icon">⏱️</span>
            <div class="bt-trig-texts">
              <strong class="bt-trig-main" id="bt-trig-main" data-ko="카운트 시작하기 (Space / 클릭)" data-en="START STOPWATCH (Space / Click)">카운트 시작하기 (Space / 클릭)</strong>
              <span class="bt-trig-sub" id="bt-trig-sub" data-ko="누르는 즉시(0ms) 작동합니다" data-en="Triggers instantly on press (0ms)">누르는 즉시(0ms) 작동합니다</span>
            </div>
          </button>
        </div>
      </section>

      <!-- Right Column: Live Challenger Leaderboard -->
      <aside class="bt-board-col">
        <div class="bt-board-card">
          <div class="bt-board-header">
            <div>
              <h3 class="bt-board-title">🏆 <span data-ko="도전자 오차 순위 전광판" data-en="CHALLENGER LEADERBOARD">도전자 오차 순위 전광판</span></h3>
              <p class="bt-board-desc" data-ko="합방·시참 내기용! 오차가 0.000초에 가까울수록 상위 랭크" data-en="Sorted by closest accuracy to 0.000s error">합방·시참 내기용! 오차가 0.000초에 가까울수록 상위 랭크</p>
            </div>
            <div class="bt-board-hdr-btns">
              <button type="button" class="bt-sm-btn" id="bt-copy-board-btn" title="순위표 복사">
                📋 <span data-ko="순위 복사" data-en="Copy">순위 복사</span>
              </button>
              <button type="button" class="bt-sm-btn danger" id="bt-clear-board-btn" title="순위표 비우기">
                🗑️
              </button>
            </div>
          </div>

          <!-- Challenger Name Input -->
          <div class="bt-challenger-bar">
            <div class="bt-chal-input-wrap">
              <span class="bt-chal-icon">👤</span>
              <input type="text" id="bt-chal-name" class="bt-chal-input" value="스트리머 #1" maxlength="18" placeholder="도전자 닉네임 입력" />
            </div>
            <label class="bt-auto-inc" title="시도할 때마다 #번호 자동 증가">
              <input type="checkbox" id="bt-auto-inc-chk" checked />
              <span data-ko="#번호 자동증가" data-en="Auto #++">#번호 자동증가</span>
            </label>
          </div>

          <!-- Leaderboard List -->
          <div class="bt-rank-list" id="bt-rank-list">
            <!-- Populated by JS -->
          </div>
        </div>
      </aside>
    </div>
  </div>
</GameLayout>

<style is:global>
  .bt-app {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    color: #f8fafc;
    user-select: none;
  }

  /* Top HUD */
  .bt-hud {
    display: grid;
    grid-template-columns: repeat(4, 1fr) auto;
    gap: 0.75rem;
    align-items: stretch;
  }

  .bt-stat-card {
    background: rgba(15, 23, 42, 0.88);
    border: 1px solid rgba(148, 163, 184, 0.16);
    border-radius: 14px;
    padding: 0.75rem 1rem;
    display: flex;
    flex-direction: column;
    gap: 0.22rem;
  }

  .bt-stat-card.best-card {
    border-color: rgba(56, 189, 248, 0.35);
    background: linear-gradient(135deg, rgba(14, 165, 233, 0.12), rgba(15, 23, 42, 0.95));
  }

  .bt-stat-label {
    font-size: 0.75rem;
    font-weight: 700;
    color: #94a3b8;
  }

  .bt-stat-val {
    font-size: 1.2rem;
    font-weight: 900;
    font-variant-numeric: tabular-nums;
  }

  .bt-stat-val.cyan { color: #38bdf8; }
  .bt-stat-val.gold { color: #facc15; }
  .bt-stat-val.emerald { color: #34d399; }
  .bt-stat-val.amber { color: #fb923c; }

  .bt-reset-btn {
    background: rgba(30, 41, 59, 0.8);
    border: 1px solid rgba(148, 163, 184, 0.2);
    color: #cbd5e1;
    border-radius: 12px;
    padding: 0 1rem;
    font-size: 0.82rem;
    font-weight: 700;
    cursor: pointer;
    transition: all 0.15s ease;
  }

  .bt-reset-btn:hover {
    background: rgba(239, 68, 68, 0.15);
    border-color: rgba(239, 68, 68, 0.4);
    color: #fca5a5;
  }

  /* Main 2-Column Layout */
  .bt-main-grid {
    display: grid;
    grid-template-columns: 1fr 370px;
    gap: 1.15rem;
    align-items: start;
  }

  .bt-arena-card {
    position: relative;
    background: rgba(15, 23, 42, 0.92);
    border: 1px solid rgba(148, 163, 184, 0.18);
    border-radius: 20px;
    padding: 1.35rem;
    display: flex;
    flex-direction: column;
    gap: 1.1rem;
    overflow: hidden;
  }

  .bt-confetti-canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    z-index: 10;
  }

  .bt-controls-top {
    display: flex;
    flex-direction: column;
    gap: 0.8rem;
    z-index: 2;
  }

  .bt-control-group {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .bt-ctrl-label {
    font-size: 0.78rem;
    font-weight: 800;
    color: #94a3b8;
  }

  .bt-preset-row {
    display: grid;
    grid-template-columns: repeat(4, 1fr) 125px;
    gap: 0.45rem;
  }

  .bt-preset-btn {
    background: rgba(30, 41, 59, 0.8);
    border: 1px solid rgba(148, 163, 184, 0.2);
    border-radius: 10px;
    padding: 0.55rem 0.4rem;
    color: #e2e8f0;
    font-size: 0.86rem;
    font-weight: 800;
    cursor: pointer;
    transition: all 0.15s ease;
  }

  .bt-preset-btn:hover:not(:disabled) {
    border-color: #38bdf8;
    color: #ffffff;
  }

  .bt-preset-btn.active {
    background: rgba(14, 165, 233, 0.2);
    border-color: #38bdf8;
    color: #7dd3fc;
    box-shadow: 0 0 14px rgba(56, 189, 248, 0.22);
  }

  .bt-preset-btn:disabled {
    opacity: 0.45;
    cursor: not-allowed;
  }

  .bt-custom-wrap {
    position: relative;
    display: flex;
    align-items: center;
  }

  .bt-custom-input {
    width: 100%;
    background: #090d16;
    border: 1px solid rgba(148, 163, 184, 0.25);
    border-radius: 10px;
    padding: 0.52rem 1.6rem 0.52rem 0.6rem;
    color: #facc15;
    font-size: 0.85rem;
    font-weight: 800;
    outline: none;
  }

  .bt-custom-input:focus {
    border-color: #facc15;
  }

  .bt-custom-unit {
    position: absolute;
    right: 0.55rem;
    font-size: 0.75rem;
    color: #64748b;
    font-weight: 800;
  }

  .bt-mode-row {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0.45rem;
  }

  .bt-mode-btn {
    background: rgba(30, 41, 59, 0.75);
    border: 1px solid rgba(148, 163, 184, 0.18);
    border-radius: 10px;
    padding: 0.5rem 0.6rem;
    color: #cbd5e1;
    font-size: 0.8rem;
    font-weight: 700;
    cursor: pointer;
    transition: all 0.15s ease;
  }

  .bt-mode-btn.active {
    background: rgba(168, 85, 247, 0.18);
    border-color: #c084fc;
    color: #f3e8ff;
  }

  .bt-mode-btn:disabled {
    opacity: 0.45;
    cursor: not-allowed;
  }

  /* Digital Stopwatch Screen */
  .bt-screen {
    background: radial-gradient(circle at 50% 35%, #111c33 0%, #070b14 100%);
    border: 2px solid rgba(56, 189, 248, 0.25);
    border-radius: 18px;
    padding: 1.5rem 1.4rem 1.25rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.65rem;
    box-shadow: inset 0 0 40px rgba(0, 0, 0, 0.65);
    transition: border-color 0.25s ease, box-shadow 0.25s ease;
  }

  .bt-screen.blind-active {
    border-color: rgba(168, 85, 247, 0.55);
    box-shadow: inset 0 0 50px rgba(88, 28, 135, 0.35), 0 0 25px rgba(168, 85, 247, 0.2);
  }

  .bt-screen.jackpot-win {
    border-color: #facc15;
    box-shadow: inset 0 0 50px rgba(250, 204, 21, 0.25), 0 0 32px rgba(250, 204, 21, 0.4);
  }

  .bt-screen-top {
    width: 100%;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .bt-target-pill {
    background: rgba(250, 204, 21, 0.16);
    border: 1px solid rgba(250, 204, 21, 0.4);
    color: #fde047;
    font-size: 0.85rem;
    font-weight: 900;
    padding: 0.28rem 0.75rem;
    border-radius: 999px;
    font-family: monospace;
  }

  .bt-status-pill {
    font-size: 0.76rem;
    font-weight: 800;
    padding: 0.25rem 0.7rem;
    border-radius: 999px;
    background: rgba(148, 163, 184, 0.15);
    color: #cbd5e1;
  }

  .bt-status-pill.counting {
    background: rgba(16, 185, 129, 0.2);
    color: #34d399;
    border: 1px solid rgba(16, 185, 129, 0.4);
  }

  .bt-status-pill.blind {
    background: rgba(168, 85, 247, 0.25);
    color: #e9d5ff;
    border: 1px solid rgba(192, 132, 252, 0.5);
    animation: btPulse 1s infinite;
  }

  @keyframes btPulse {
    0%, 100% { transform: scale(1); opacity: 1; }
    50% { transform: scale(1.04); opacity: 0.75; }
  }

  .bt-digits-wrap {
    display: flex;
    align-items: baseline;
    justify-content: center;
    margin: 0.4rem 0;
    font-family: 'JetBrains Mono', 'Courier New', monospace;
    font-variant-numeric: tabular-nums;
  }

  .bt-digits-main {
    font-size: clamp(3.6rem, 7vw, 5.4rem);
    font-weight: 900;
    letter-spacing: 0.03em;
    color: #f8fafc;
    text-shadow: 0 0 28px rgba(56, 189, 248, 0.45);
    line-height: 1;
  }

  .bt-digits-main.blind-mask {
    color: #c084fc;
    text-shadow: 0 0 32px rgba(192, 132, 252, 0.65);
    animation: btPulse 1.1s infinite;
  }

  .bt-digits-main.troll-mask {
    color: #fb7185;
    text-shadow: 0 0 28px rgba(244, 63, 94, 0.6);
  }

  .bt-digits-ms {
    font-size: clamp(1.4rem, 2.8vw, 2.1rem);
    font-weight: 800;
    color: #64748b;
    margin-left: 0.2rem;
  }

  .bt-screen-sub {
    font-size: 0.83rem;
    color: #94a3b8;
    font-weight: 600;
    text-align: center;
  }

  /* Precision Error Meter Bar */
  .bt-meter-wrap {
    width: 100%;
    max-width: 520px;
    margin-top: 0.4rem;
    display: flex;
    flex-direction: column;
    gap: 0.32rem;
  }

  .bt-meter-labels {
    display: flex;
    justify-content: space-between;
    font-size: 0.7rem;
    font-weight: 700;
    color: #64748b;
  }

  .bt-meter-center-lbl {
    color: #facc15;
    font-weight: 800;
  }

  .bt-meter-track {
    position: relative;
    height: 12px;
    background: rgba(30, 41, 59, 0.95);
    border-radius: 999px;
    border: 1px solid rgba(148, 163, 184, 0.2);
    overflow: visible;
  }

  .bt-meter-zone-s {
    position: absolute;
    top: 0;
    bottom: 0;
    left: 42%;
    width: 16%;
    background: rgba(56, 189, 248, 0.25);
    border-radius: 4px;
  }

  .bt-meter-zone-jackpot {
    position: absolute;
    top: -2px;
    bottom: -2px;
    left: 49.2%;
    width: 1.6%;
    background: #facc15;
    box-shadow: 0 0 10px #facc15;
    border-radius: 2px;
  }

  .bt-meter-pin {
    position: absolute;
    top: -5px;
    width: 10px;
    height: 22px;
    border-radius: 4px;
    background: #34d399;
    border: 2px solid #ffffff;
    transform: translateX(-50%);
    box-shadow: 0 0 12px rgba(52, 211, 153, 0.8);
    transition: left 0.25s cubic-bezier(0.22, 1, 0.36, 1);
  }

  /* Result Box */
  .bt-result-box {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.85rem;
    background: rgba(30, 41, 59, 0.85);
    border: 1px solid rgba(56, 189, 248, 0.35);
    border-radius: 14px;
    padding: 0.85rem 1.1rem;
  }

  .bt-res-left {
    display: flex;
    align-items: center;
    gap: 0.85rem;
  }

  .bt-grade-badge {
    font-size: 1.05rem;
    font-weight: 900;
    padding: 0.45rem 0.85rem;
    border-radius: 11px;
    white-space: nowrap;
    background: rgba(56, 189, 248, 0.2);
    color: #38bdf8;
    border: 1px solid rgba(56, 189, 248, 0.45);
  }

  .bt-res-texts {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }

  .bt-res-headline {
    font-size: 1rem;
    font-weight: 900;
    color: #f8fafc;
  }

  .bt-res-comment {
    margin: 0;
    font-size: 0.82rem;
    color: #cbd5e1;
  }

  .bt-copy-res-btn {
    background: rgba(56, 189, 248, 0.18);
    border: 1px solid rgba(56, 189, 248, 0.45);
    color: #7dd3fc;
    border-radius: 9px;
    padding: 0.5rem 0.85rem;
    font-size: 0.8rem;
    font-weight: 800;
    cursor: pointer;
    white-space: nowrap;
  }

  .bt-copy-res-btn:hover {
    background: rgba(56, 189, 248, 0.32);
    color: #ffffff;
  }

  /* Giant Trigger Button */
  .bt-trigger-btn {
    width: 100%;
    padding: 1.25rem 1.5rem;
    border-radius: 16px;
    border: none;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.9rem;
    cursor: pointer;
    transition: transform 0.1s ease, box-shadow 0.15s ease, background 0.15s ease;
  }

  .bt-trigger-btn.ready {
    background: linear-gradient(135deg, #0ea5e9 0%, #2563eb 100%);
