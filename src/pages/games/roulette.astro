    font-weight: 800;
    color: #94a3b8;
    letter-spacing: 0.05em;
  }

  .label-with-meta {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .items-count-badge {
    font-size: 0.7rem;
    font-weight: 800;
    color: #38bdf8;
    background: rgba(56, 189, 248, 0.12);
    padding: 0.15rem 0.45rem;
    border-radius: 4px;
  }

  .input-hint-text {
    font-size: 0.75rem;
    color: #a855f7;
    margin: 0;
    line-height: 1.4;
    font-weight: 600;
  }

  .input-hint-text code {
    background: rgba(168, 85, 247, 0.15);
    color: #f0abfc;
    padding: 0.1rem 0.3rem;
    border-radius: 4px;
  }

  #input-title, #input-items {
    background: #090d16;
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 8px;
    color: #f8fafc;
    padding: 0.6rem 0.75rem;
    font-size: 0.88rem;
