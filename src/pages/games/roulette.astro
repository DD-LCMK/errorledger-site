---
import GameLayout from '../../layouts/GameLayout.astro';
import { getEntry } from 'astro:content';

const gameEntry = await getEntry('games', 'roulette');
const data = gameEntry?.data || {
  title: '스트리머 돌림판 룰렛',
  tagline: '방송 & 추첨 전용 커스텀 행운의 룰렛',
  description: '야식 메뉴 결정, 벌칙 추첨, 구독자 이벤트까지! 부드러운 물리 회전과 1초 프리셋을 지원하는 무료 방송용 웹 룰렛입니다.',
  icon: '🎡',
  category: 'stream',
  badge: '🔥 방송 필수',
  players: '1인 ~ 시청자 다수',
  playTime: '즉시 (3~10초)',
  controls: [
    '스페이스바(Space) 또는 [룰렛 돌리기] 버튼 클릭',
    '오른쪽 목록에서 나만의 항목 및 가중치 직접 입력',
    '상단 원클릭 프리셋으로 야식, 벌칙, 선물 추첨 즉시 세팅',
    '집중 모드를 활용해 깔끔한 전체화면 연출 가능'
  ],
  rules: [
    '각 항목은 돌림판 위의 화려한 부채꼴 칸으로 자동 배정됩니다.',
    '물리 엔진 기반의 무작위 회전 토크와 감속 마찰을 거쳐 회전합니다.',
    '상단 바늘이 최종 멈춘 칸이 당첨자로 선정되며 꽃가루 축하 효과가 울립니다!'
  ],
  faqItems: [
    {
      q: '전체화면이나 집중 모드는 어떻게 사용하나요?',
      a: '하단의 [📺 집중 모드] 버튼이나 상단 [⛶ 전체화면]을 누르면 불필요한 브라우저 여백 없이 돌림판을 화면 가득 시원하게 띄워 진행할 수 있습니다.'
    },
    {
      q: '한 번 뽑힌 항목을 다음 라운드에서 자동 제외할 수 있나요?',
      a: '네! 제어판에서 [당첨 항목 제외] 옵션을 켜두시면 여러 번 연속 추첨할 때 이미 뽑힌 항목이 자동으로 목록에서 제외됩니다.'
    }
  ]
};
---

<GameLayout
  title={data.title}
  description={data.description}
  tagline={data.tagline}
  icon={data.icon}
  category={data.category}
  badge={data.badge}
  players={data.players}
  playTime={data.playTime}
  controls={data.controls}
  rules={data.rules}
  faqItems={data.faqItems}
  layoutMode="full"
  hideStageHeader={true}
  hideFooter={false}
>
  <div class="roulette-app-root" id="roulette-root">
    <!-- Carnival Neon & Golden Sparkles Theme Canvas -->
    <canvas id="carnival-canvas" class="carnival-canvas"></canvas>

    <!-- Left / Center: The Wheel Stage -->
    <div class="wheel-stage-container">
      <div class="wheel-title-bar" id="display-title">오늘의 방송 룰렛</div>

      <div class="wheel-canvas-wrapper" id="wheel-wrapper">
        <!-- Physical Pointer Needle -->
        <div class="roulette-pointer" id="wheel-pointer">
          <div class="pointer-arrow"></div>
        </div>

        <!-- HTML5 High-DPI Canvas -->
        <canvas id="roulette-canvas" width="600" height="600"></canvas>

        <!-- Center Glowing Hub & Spin Button -->
        <button id="center-spin-btn" class="center-hub-btn" title="클릭하거나 스페이스바를 눌러 룰렛 회전">
          <span class="hub-label">돌리기</span>
        </button>
      </div>

      <!-- Quick Action Controls -->
      <div class="wheel-action-bar">
        <button id="main-spin-btn" class="roulette-btn spin-btn-main">
          <span>🎯 룰렛 돌리기 (Space)</span>
        </button>
        <button id="shuffle-btn" class="roulette-btn btn-secondary">
          <span>🔀 항목 섞기</span>
        </button>
        <button id="stream-mode-btn" class="roulette-btn btn-stream" title="깔끔한 집중 모드 전환">
          <span>📺 집중 모드</span>
        </button>
      </div>
    </div>

    <!-- Right: Streamer Control Desk -->
    <div class="streamer-sidebar" id="streamer-sidebar">
      <div class="sidebar-header">
        <span class="panel-icon">⚙️</span>
        <h3>룰렛 설정 데스크</h3>
      </div>

      <!-- Title Input -->
      <div class="config-group">
        <label for="input-title">룰렛 / 추첨 제목</label>
        <input type="text" id="input-title" value="오늘의 방송 룰렛" placeholder="룰렛 제목을 입력하세요" />
      </div>

      <!-- Presets Row -->
      <div class="config-group">
        <label>⚡ 방송 추천 프리셋</label>
        <div class="presets-grid">
          <button class="preset-pill" data-preset="food">🍗 야식 메뉴</button>
          <button class="preset-pill" data-preset="penalty">⚡ 벌칙 룰렛</button>
          <button class="preset-pill" data-preset="event">🎁 치킨/이벤트</button>
          <button class="preset-pill" data-preset="game">🎮 게임 뽑기</button>
        </div>
      </div>

      <!-- Items Textarea -->
      <div class="config-group">
        <div class="label-with-meta">
          <label for="input-items">항목 목록</label>
          <span class="items-count-badge" id="items-count-badge">8개 항목</span>
        </div>
        <p class="input-hint-text">💡 팁: <code>피자*2</code>, <code>치킨*3</code> 처럼 입력하면 여러 칸이 자동 생성됩니다!</p>
        <textarea id="input-items" rows="5" placeholder="항목을 줄바꿈으로 입력하세요 (예: 피자*2, 치킨*3, 꽝*5)">치킨
피자*2
햄버거
족발
엽기떡볶이
마라탕
삼겹살
라면</textarea>
      </div>

      <!-- Options Toggles -->
      <div class="config-group toggles-row">
        <label class="checkbox-label">
          <input type="checkbox" id="chk-eliminate" />
          <span>당첨된 항목 자동 제외</span>
        </label>
        <label class="checkbox-label">
          <input type="checkbox" id="chk-sound" checked />
          <span>효과음 (틱 & 팡파레)</span>
        </label>
      </div>

      <!-- Recent Winners History -->
      <div class="config-group history-group">
        <div class="label-with-meta">
          <label>🏆 당첨 히스토리</label>
          <button id="clear-history-btn" class="mini-clear-btn">초기화</button>
        </div>
        <div class="winners-history-list" id="winners-history">
          <span class="empty-history-text">아직 당첨 기록이 없습니다. 룰렛을 돌려보세요!</span>
        </div>
      </div>
    </div>

    <!-- Celebration Modal / Banner Overlay -->
    <div class="winner-celebration-overlay hidden" id="winner-modal">
      <div class="celebration-card">
        <div class="trophy-bounce">👑</div>
        <div class="congrats-tag">🎉 당첨을 축하합니다!</div>
        <div class="winner-item-name" id="winner-name-display">치킨</div>
        <button id="modal-confirm-btn" class="winner-confirm-btn">확인 (닫기)</button>
      </div>
    </div>

    <!-- Particle Confetti Canvas Layer -->
    <canvas id="confetti-canvas" class="confetti-layer"></canvas>
  </div>

  <div slot="guide">
    <h2>방송용 돌림판 룰렛 활용 가이드</h2>
    <p>
      <strong>스트리머 룰렛</strong>은 치지직(CHZZK), SOOP(아프리카TV), 유튜브 라이브 등 다양한 방송 환경에서 시청자와 함께 실시간으로 소통할 수 있도록 제작된 무료 웹 도구입니다.
    </p>

    <h3>1. 1초 원클릭 방송 프리셋</h3>
    <p>
      상단의 야식 메뉴, 벌칙 룰렛, 치킨 이벤트 프리셋 버튼을 클릭하면 방송에서 가장 많이 쓰이는 항목들이 돌림판에 즉시 자동 입력됩니다.
    </p>

    <h3>2. 가중치 설정 팁</h3>
    <p>
      특정 항목의 당첨 확률을 높이거나 여러 칸으로 만들고 싶다면 <code>피자*2</code>, <code>치킨*3</code>과 같이 별표(*)와 숫자를 붙여 입력해 보세요. 해당 칸이 자동으로 분할되어 생성됩니다.
    </p>
  </div>
</GameLayout>

<style>
  /* Floating Carnival Golden Sparkles Canvas */
  .carnival-canvas {
    position: fixed;
    top: 0;
    left: 0;
    width: 100vw;
    height: 100vh;
    pointer-events: none;
    z-index: 0;
  }

  .roulette-app-root {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: minmax(560px, 1fr) 340px;
    gap: 1.25rem;
    background: transparent;
    padding: 0;
    max-width: 100%;
    width: 100%;
    margin: 0;
    user-select: none;
    align-items: start;
  }

  @media (max-width: 1000px) {
    .roulette-app-root {
      grid-template-columns: 1fr;
    }
  }

  /* Wheel Stage */
  .wheel-stage-container {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: flex-start;
    background: #0f172a;
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 14px;
    padding: 0.85rem 1rem;
    position: relative;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.4);
  }

  .wheel-title-bar {
    font-size: 1.3rem;
    font-weight: 900;
    color: #f8fafc;
    letter-spacing: -0.02em;
    margin-bottom: 0.5rem;
    text-shadow: 0 0 15px rgba(168, 85, 247, 0.4);
    text-align: center;
  }

  .wheel-canvas-wrapper {
    position: relative;
    width: 500px;
    height: 500px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  #roulette-canvas {
    width: 490px;
    height: 490px;
    border-radius: 50%;
    box-shadow: 0 0 35px rgba(0, 0, 0, 0.7), 0 0 25px rgba(168, 85, 247, 0.3);
  }

  /* Top Needle Pointer */
  .roulette-pointer {
    position: absolute;
    top: 2px;
    left: 50%;
    transform: translateX(-50%);
    z-index: 25;
    pointer-events: none;
    transition: transform 0.08s ease-out;
  }

  .pointer-arrow {
    width: 0;
    height: 0;
    border-left: 18px solid transparent;
    border-right: 18px solid transparent;
    border-top: 36px solid #ef4444;
    filter: drop-shadow(0 4px 8px rgba(0, 0, 0, 0.6)) drop-shadow(0 0 10px #ef4444);
  }

  .pointer-tick {
    transform: translateX(-50%) rotate(-15deg);
  }

  /* Center Hub Button */
  .center-hub-btn {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 72px;
    height: 72px;
    border-radius: 50%;
    background: radial-gradient(circle, #f8fafc 0%, #0f172a 100%);
    border: 4px solid #ffffff;
    box-shadow: 0 0 20px rgba(0, 0, 0, 0.8), 0 0 15px rgba(56, 189, 248, 0.6);
    color: #020617;
    cursor: pointer;
    z-index: 20;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: transform 0.15s cubic-bezier(0.34, 1.56, 0.64, 1), box-shadow 0.15s ease;
  }

  .center-hub-btn:hover {
    transform: translate(-50%, -50%) scale(1.1);
    box-shadow: 0 0 25px rgba(56, 189, 248, 0.9);
  }

  .hub-label {
    font-size: 0.88rem;
    font-weight: 900;
    letter-spacing: 0.05em;
  }

  /* Action Bar */
  .wheel-action-bar {
    display: flex;
    gap: 0.75rem;
    margin-top: 0.85rem;
    flex-wrap: wrap;
    justify-content: center;
  }

  .roulette-btn {
    padding: 0.75rem 1.5rem;
    border-radius: 10px;
    font-size: 0.95rem;
    font-weight: 800;
    cursor: pointer;
    border: none;
    transition: transform 0.15s ease, box-shadow 0.15s ease;
  }

  .spin-btn-main {
    background: linear-gradient(135deg, #a855f7 0%, #38bdf8 100%);
    color: #ffffff;
    box-shadow: 0 0 20px rgba(168, 85, 247, 0.4);
  }

  .spin-btn-main:hover {
    transform: scale(1.04);
    box-shadow: 0 0 25px rgba(168, 85, 247, 0.6);
  }

  .btn-secondary {
    background: rgba(255, 255, 255, 0.08);
    color: #e2e8f0;
    border: 1px solid rgba(255, 255, 255, 0.12);
  }

  .btn-secondary:hover {
    background: rgba(255, 255, 255, 0.15);
    color: #ffffff;
  }

  .btn-stream {
    background: rgba(56, 189, 248, 0.15);
    color: #38bdf8;
    border: 1px solid rgba(56, 189, 248, 0.3);
  }

  .btn-stream:hover {
    background: rgba(56, 189, 248, 0.25);
  }

  /* Streamer Sidebar */
  .streamer-sidebar {
    background: #0f172a;
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 14px;
    padding: 1rem 1.15rem;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.4);
  }

  .sidebar-header {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding-bottom: 0.6rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.06);
  }

  .sidebar-header h3 {
    font-size: 1.05rem;
    font-weight: 800;
    color: #f8fafc;
    margin: 0;
  }

  .config-group {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .config-group label {
    font-size: 0.75rem;
    font-weight: 800;
    color: #94a3b8;
    letter-spacing: 0.05em;
  }

  .label-with-meta {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .items-count-badge {
    font-size: 0.7rem;
    font-weight: 800;
    color: #38bdf8;
    background: rgba(56, 189, 248, 0.12);
    padding: 0.15rem 0.45rem;
    border-radius: 4px;
  }

  .input-hint-text {
    font-size: 0.75rem;
    color: #a855f7;
    margin: 0;
    line-height: 1.4;
    font-weight: 600;
  }

  .input-hint-text code {
    background: rgba(168, 85, 247, 0.15);
    color: #f0abfc;
    padding: 0.1rem 0.3rem;
    border-radius: 4px;
  }

  #input-title, #input-items {
    background: #090d16;
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 8px;
    color: #f8fafc;
    padding: 0.6rem 0.75rem;
    font-size: 0.88rem;
    outline: none;
    font-family: inherit;
    transition: border-color 0.15s ease;
  }

  #input-title:focus, #input-items:focus {
    border-color: #38bdf8;
  }

  #input-items {
    resize: vertical;
    line-height: 1.5;
  }

  /* Presets Grid */
  .presets-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.4rem;
  }

  .preset-pill {
    background: rgba(168, 85, 247, 0.12);
    border: 1px solid rgba(168, 85, 247, 0.25);
    color: #e9d5ff;
    padding: 0.4rem 0.5rem;
    border-radius: 6px;
    font-size: 0.75rem;
    font-weight: 700;
    cursor: pointer;
    transition: all 0.15s ease;
    text-align: center;
  }

  .preset-pill:hover {
    background: rgba(168, 85, 247, 0.25);
    color: #ffffff;
  }

  .toggles-row {
    gap: 0.6rem;
  }

  .checkbox-label {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.8rem !important;
    color: #cbd5e1 !important;
    cursor: pointer;
  }

  /* Winners History */
  .mini-clear-btn {
    background: none;
    border: none;
    color: #64748b;
    cursor: pointer;
    font-size: 0.7rem;
  }

  .mini-clear-btn:hover {
    color: #e2e8f0;
  }

  .winners-history-list {
    background: #090d16;
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 8px;
    padding: 0.5rem;
    max-height: 110px;
    overflow-y: auto;
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
  }

  .history-item {
    font-size: 0.78rem;
    color: #cbd5e1;
    display: flex;
    justify-content: space-between;
    padding: 0.2rem 0.4rem;
    border-radius: 4px;
    background: rgba(255, 255, 255, 0.03);
  }

  .history-item .h-time {
    color: #64748b;
    font-size: 0.68rem;
  }

  .empty-history-text {
    font-size: 0.72rem;
    color: #475569;
    font-style: italic;
    text-align: center;
    padding: 0.4rem 0;
  }

  /* Celebration Modal */
  .winner-celebration-overlay {
    position: absolute;
    inset: 0;
    background: rgba(9, 13, 22, 0.85);
    backdrop-filter: blur(8px);
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 100;
  }

  .celebration-card {
    background: #0f172a;
    border: 2px solid rgba(234, 179, 8, 0.6);
    border-radius: 20px;
    padding: 2.5rem 2rem;
    text-align: center;
    max-width: 400px;
    width: 90%;
    box-shadow: 0 0 50px rgba(234, 179, 8, 0.4);
    animation: popModal 0.35s cubic-bezier(0.34, 1.56, 0.64, 1);
  }

  @keyframes popModal {
    0% { transform: scale(0.6); opacity: 0; }
    100% { transform: scale(1); opacity: 1; }
  }

  .trophy-bounce {
    font-size: 3.8rem;
    margin-bottom: 0.5rem;
    animation: bounce 1s infinite alternate;
  }

  @keyframes bounce {
    0% { transform: translateY(0); }
    100% { transform: translateY(-8px); }
  }

  .congrats-tag {
    font-size: 0.85rem;
    font-weight: 800;
    color: #facc15;
    letter-spacing: 0.1em;
    margin-bottom: 0.5rem;
  }

  .winner-item-name {
    font-size: 2.2rem;
    font-weight: 900;
    color: #ffffff;
    letter-spacing: -0.02em;
    margin-bottom: 1.5rem;
    word-break: break-word;
    text-shadow: 0 0 20px rgba(250, 204, 21, 0.6);
  }

  .winner-confirm-btn {
    width: 100%;
    background: linear-gradient(135deg, #facc15 0%, #f97316 100%);
    color: #020617;
    font-size: 1.05rem;
    font-weight: 900;
    padding: 0.75rem;
    border-radius: 12px;
    border: none;
    cursor: pointer;
  }

  /* Confetti Layer */
  .confetti-layer {
    position: absolute;
    inset: 0;
    pointer-events: none;
    z-index: 90;
  }

  .hidden {
    display: none !important;
  }

  @media (max-width: 900px) {
    
  /* Mode Switcher Tabs */
  .roulette-mode-tabs {
    grid-column: 1 / -1;
    display: flex;
    justify-content: center;
    gap: 0.5rem;
    background: #0f172a;
    padding: 0.35rem;
    border-radius: 12px;
    border: 1px solid rgba(255, 255, 255, 0.1);
    box-shadow: 0 4px 15px rgba(0, 0, 0, 0.4);
    margin-bottom: 0.5rem;
  }

  .mode-tab {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.5rem 1rem;
    border-radius: 8px;
    font-size: 0.85rem;
    font-weight: 800;
    color: #94a3b8;
    text-decoration: none;
    transition: all 0.15s ease;
  }

  .mode-tab:hover {
    color: #f8fafc;
    background: rgba(255, 255, 255, 0.05);
  }

  .mode-tab.active {
    background: #38bdf8;
    color: #040813;
    box-shadow: 0 0 15px rgba(56, 189, 248, 0.4);
  }

  .tab-badge {
    background: #ef4444;
    color: #ffffff;
    font-size: 0.65rem;
    font-weight: 900;
    padding: 0.1rem 0.35rem;
    border-radius: 4px;
    margin-left: 0.2rem;
  }

  .roulette-app-root {
      grid-template-columns: 1fr;
