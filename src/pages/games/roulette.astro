  function parseItems(): string[] {
    if (!itemsTextarea) return [];
    const rawLines = itemsTextarea.value
      .split(/[\r\n,]+/)
      .map(s => s.trim())
      .filter(s => s.length > 0);

    const result: string[] = [];
    for (const line of rawLines) {
      // Check for multiplier patterns: "피자*2", "치킨 * 3", "꽝x5", "콜라×4"
      const match = line.match(/^(.+?)(?:\s*[\*xX×]\s*(\d+))$/);
      if (match) {
        const name = match[1].trim();
        const count = Math.min(Math.max(parseInt(match[2], 10) || 1, 1), 100);
        for (let i = 0; i < count; i++) {
          result.push(name);
        }
      } else {
        result.push(line);
      }
    }
    return result;
  }

  function removeOneInstanceFromTextarea(winner: string) {
    if (!itemsTextarea) return;
    const lines = itemsTextarea.value.split('\n');
    let removed = false;
    const newLines: string[] = [];

    for (const line of lines) {
      const trimmed = line.trim();
      if (!removed) {
        const match = trimmed.match(/^(.+?)(?:\s*[\*xX×]\s*(\d+))$/);
        if (match && match[1].trim() === winner) {
          const count = parseInt(match[2], 10) || 1;
          if (count > 2) {
            newLines.push(`${winner}*${count - 1}`);
          } else if (count === 2) {
            newLines.push(winner);
          }
          removed = true;
          continue;
        } else if (trimmed === winner) {
          removed = true;
          continue;
        }
      }
      if (trimmed.length > 0) newLines.push(line);
    }
    itemsTextarea.value = newLines.join('\n');
  }

  // Probability Calculation & Dynamic List Rendering
  interface ItemProbGroup {
    name: string;
    count: number;
    probPercent: string;
    color: string;
  }

  function calculateProbabilities(): ItemProbGroup[] {
    if (items.length === 0) return [];
    const counts: Record<string, { count: number; firstIndex: number }> = {};
    items.forEach((item, idx) => {
      if (!counts[item]) {
        counts[item] = { count: 1, firstIndex: idx };
      } else {
        counts[item].count++;
      }
    });

    const total = items.length;
    const groups: ItemProbGroup[] = Object.keys(counts).map(name => {
      const c = counts[name].count;
      const pct = ((c / total) * 100).toFixed(1);
      const color = SLICE_COLORS[counts[name].firstIndex % SLICE_COLORS.length];
      return {
        name,
        count: c,
        probPercent: pct,
        color
      };
    });

    // Sort by count descending, then alphabetical
    groups.sort((a, b) => b.count - a.count);
    return groups;
  }

  function renderProbabilityList() {
    if (!probItemsList) return;
    const groups = calculateProbabilities();

    if (probTotalBadge) {
      probTotalBadge.textContent = isEn ? `Total ${items.length} Slices` : `총 ${items.length}개 칸`;
