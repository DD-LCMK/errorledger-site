  // Particle Confetti Engine
  class ConfettiEngine {
    private canvas: HTMLCanvasElement;
    private ctx: CanvasRenderingContext2D | null;
    private particles: { x: number; y: number; vx: number; vy: number; color: string; size: number; rot: number; vrot: number }[] = [];
    private running: boolean = false;

    constructor(canvas: HTMLCanvasElement) {
      this.canvas = canvas;
      this.ctx = canvas.getContext('2d');
    }

    burst() {
      this.canvas.width = this.canvas.offsetWidth;
      this.canvas.height = this.canvas.offsetHeight;
      this.particles = [];
      const colors = ['#facc15', '#ec4899', '#38bdf8', '#a855f7', '#10b981', '#f97316'];
      for (let i = 0; i < 90; i++) {
        this.particles.push({
          x: this.canvas.width / 2,
          y: this.canvas.height / 2,
          vx: (Math.random() - 0.5) * 14,
          vy: (Math.random() - 0.5) * 14 - 3,
          color: colors[Math.floor(Math.random() * colors.length)],
          size: Math.random() * 8 + 4,
          rot: Math.random() * Math.PI,
          vrot: (Math.random() - 0.5) * 0.2
        });
      }
      this.running = true;
      this.loop();
    }

    private loop = () => {
      if (!this.ctx || !this.running) return;
      this.ctx.clearRect(0, 0, this.canvas.width, this.canvas.height);
      let alive = 0;
      for (const p of this.particles) {
        p.vy += 0.3; // gravity
        p.x += p.vx;
        p.y += p.vy;
        p.rot += p.vrot;

        if (p.y < this.canvas.height) {
          alive++;
          this.ctx.save();
          this.ctx.translate(p.x, p.y);
          this.ctx.rotate(p.rot);
          this.ctx.fillStyle = p.color;
          this.ctx.fillRect(-p.size / 2, -p.size / 2, p.size, p.size);
          this.ctx.restore();
        }
      }

      if (alive > 0) {
        requestAnimationFrame(this.loop);
      } else {
        this.running = false;
        this.ctx.clearRect(0, 0, this.canvas.width, this.canvas.height);
      }
    };
  }

  // Festival Particle Sparkles Engine (Carnival Lights & Star Trails)
  class FestivalSparklesEngine {
    private canvas: HTMLCanvasElement;
    private ctx: CanvasRenderingContext2D | null;
    private particles: { x: number; y: number; vx: number; vy: number; color: string; size: number; alpha: number; life: number; maxLife: number; shape: 'star' | 'circle' }[] = [];
    private running: boolean = false;

    constructor(canvas: HTMLCanvasElement) {
      this.canvas = canvas;
      this.ctx = canvas ? canvas.getContext('2d') : null;
      this.resize();
      window.addEventListener('resize', () => this.resize());
    }

    private resize() {
      if (!this.canvas) return;
      this.canvas.width = window.innerWidth;
      this.canvas.height = window.innerHeight;
    }

    spawnSparksAroundWheel(cx: number, cy: number, radius: number, color: string) {
      if (!this.ctx || !this.canvas) return;
      const count = 3;
      const festiveColors = [color, '#facc15', '#ffffff', '#38bdf8', '#f43f5e', '#a855f7'];
      for (let i = 0; i < count; i++) {
        const angle = Math.random() * Math.PI * 2;
        const r = radius + (Math.random() - 0.5) * 20;
        const x = cx + Math.cos(angle) * r;
        const y = cy + Math.sin(angle) * r;
        const c = festiveColors[Math.floor(Math.random() * festiveColors.length)];

        this.particles.push({
          x,
          y,
          vx: (Math.random() - 0.5) * 4 + Math.cos(angle) * 1.5,
          vy: (Math.random() - 0.5) * 4 + Math.sin(angle) * 1.5 - 1.2,
          color: c,
          size: Math.random() * 5 + 3,
          alpha: 1,
          life: 0,
          maxLife: 22 + Math.random() * 18,
          shape: Math.random() > 0.35 ? 'star' : 'circle'
        });
      }

      if (!this.running) {
        this.running = true;
        this.loop();
      }
    }

    burstVictoryStars(cx: number, cy: number) {
      if (!this.ctx || !this.canvas) return;
      const festiveColors = ['#facc15', '#f59e0b', '#fef08a', '#ffffff', '#f43f5e', '#38bdf8'];
      for (let i = 0; i < 40; i++) {
        const angle = Math.random() * Math.PI * 2;
        const speed = Math.random() * 8 + 3;
        this.particles.push({
          x: cx,
          y: cy,
          vx: Math.cos(angle) * speed,
          vy: Math.sin(angle) * speed - 2.5,
          color: festiveColors[Math.floor(Math.random() * festiveColors.length)],
          size: Math.random() * 7 + 4,
          alpha: 1,
          life: 0,
          maxLife: 35 + Math.random() * 25,
          shape: 'star'
        });
      }
      if (!this.running) {
        this.running = true;
        this.loop();
      }
    }

    private drawStar(cx: number, cy: number, spikes: number, outerRadius: number, innerRadius: number, color: string, alpha: number) {
      if (!this.ctx) return;
      let rot = (Math.PI / 2) * 3;
      let x = cx;
      let y = cy;
      const step = Math.PI / spikes;

      this.ctx.save();
      this.ctx.globalAlpha = alpha;
      this.ctx.fillStyle = color;
      this.ctx.beginPath();
      this.ctx.moveTo(cx, cy - outerRadius);
      for (let i = 0; i < spikes; i++) {
        x = cx + Math.cos(rot) * outerRadius;
        y = cy + Math.sin(rot) * outerRadius;
        this.ctx.lineTo(x, y);
        rot += step;

        x = cx + Math.cos(rot) * innerRadius;
        y = cy + Math.sin(rot) * innerRadius;
        this.ctx.lineTo(x, y);
        rot += step;
      }
      this.ctx.lineTo(cx, cy - outerRadius);
      this.ctx.closePath();
      this.ctx.fill();
      this.ctx.restore();
    }

    private loop = () => {
      if (!this.ctx || !this.running) return;
      this.ctx.clearRect(0, 0, this.canvas.width, this.canvas.height);

      let alive = 0;
      for (let i = 0; i < this.particles.length; i++) {
        const p = this.particles[i];
        p.life++;
        p.x += p.vx;
        p.y += p.vy;
        p.alpha = Math.max(0, 1 - (p.life / p.maxLife));

        if (p.alpha > 0) {
          alive++;
          if (p.shape === 'star') {
            this.drawStar(p.x, p.y, 4, p.size, p.size * 0.45, p.color, p.alpha);
          } else {
            this.ctx.save();
            this.ctx.globalAlpha = p.alpha;
            this.ctx.fillStyle = p.color;
            this.ctx.beginPath();
            this.ctx.arc(p.x, p.y, p.size / 2, 0, Math.PI * 2);
            this.ctx.fill();
            this.ctx.restore();
          }
        }
      }

      this.particles = this.particles.filter(p => p.alpha > 0);

      if (alive > 0) {
        requestAnimationFrame(this.loop);
      } else {
        this.running = false;
        this.ctx.clearRect(0, 0, this.canvas.width, this.canvas.height);
      }
    };
  }

