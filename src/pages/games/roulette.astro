  }

  #input-title:focus, #input-items:focus {
    border-color: #38bdf8;
  }

  #input-items {
    resize: vertical;
    line-height: 1.5;
  }

  /* Presets Grid */
  .presets-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.4rem;
  }

  .preset-pill {
    background: rgba(168, 85, 247, 0.12);
    border: 1px solid rgba(168, 85, 247, 0.25);
    color: #e9d5ff;
    padding: 0.4rem 0.5rem;
    border-radius: 6px;
    font-size: 0.75rem;
    font-weight: 700;
    cursor: pointer;
    transition: all 0.15s ease;
    text-align: center;
  }

  .preset-pill:hover {
    background: rgba(168, 85, 247, 0.25);
    color: #ffffff;
  }

  .toggles-row {
    gap: 0.6rem;
  }

  .checkbox-label {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.8rem !important;
    color: #cbd5e1 !important;
    cursor: pointer;
  }

  /* Winners History */
  .mini-clear-btn {
    background: none;
    border: none;
    color: #64748b;
    cursor: pointer;
    font-size: 0.7rem;
  }

  .mini-clear-btn:hover {
    color: #e2e8f0;
  }

  .winners-history-list {
