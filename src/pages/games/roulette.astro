  async function computeSha256(text: string): Promise<string> {
    const enc = new TextEncoder().encode(text);
    const buf = await window.crypto.subtle.digest('SHA-256', enc);
    return Array.from(new Uint8Array(buf))
      .map(b => b.toString(16).padStart(2, '0'))
      .join('');
  }

  async function prepareFairnessSeed(winner: string, winnerIndex: number): Promise<FairnessData> {
    const randBytes = new Uint8Array(8);
    window.crypto.getRandomValues(randBytes);
    const salt = Array.from(randBytes).map(b => b.toString(16).padStart(2, '0')).join('');
    const rawString = `${winner}#${salt}`;
    const hashHex = await computeSha256(rawString);
    return { winner, winnerIndex, salt, rawString, hashHex };
  }

