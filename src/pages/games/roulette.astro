    },
    game: {
      title: '🎮 다음 할 게임 뽑기',
      items: ['리그 오브 레전드', '발로란트', '배틀그라운드', '스팀 신작 탐방', '공포 게임 (심야)', '종합 똥게임 챌린지', '시청자 참여 멀티', 'just chatting']
    }
  };

  const PRESETS_EN: Record<string, { title: string; items: string[] }> = {
    food: {
      title: '🍕 Food & Dinner Wheel',
      items: ['Pizza*2', 'Burger', 'Fried Chicken', 'Tacos', 'Sushi', 'Steak', 'Pasta', 'Ramen', 'Salad']
    },
    penalty: {
      title: '⚡ Streamer Penalty Wheel',
      items: ['Sing a song', '20 Push-ups', 'Stream +30m', 'Tell a secret', 'Drink water 500ml', 'Viewer wish', 'Safe pass (Lucky!)', 'Dance 15s']
    },
    event: {
      title: '🎁 Viewer Giveaway Wheel',
      items: ['Gift Card $20', 'Steam Game Key', 'Discord Nitro', 'Coffee Coupon', 'Try Again', 'Missed!', 'VIP Badge', 'Better Luck!']
    },
    game: {
      title: '🎮 Next Game to Play',
      items: ['Valorant', 'Minecraft', 'League of Legends', 'Apex Legends', 'Overwatch 2', 'Horror Game', 'Steam Indie', 'Just Chatting']
    }
  };

  // Color Palette for Slices
  const SLICE_COLORS = [
    '#ec4899', '#8b5cf6', '#3b82f6', '#06b6d4',
    '#10b981', '#84cc16', '#eab308', '#f97316',
    '#ef4444', '#a855f7', '#14b8a6', '#6366f1'
  ];

  // Web Audio Procedural Sound Synthesizer
  class SoundFX {
    private ctx: AudioContext | null = null;
    public enabled: boolean = true;

    constructor() {
      window.addEventListener('sound-toggle', (e: any) => {
        this.enabled = !e.detail?.muted;
      });
      window.addEventListener('storage', (e) => {
        if (e.key === 'aether_sound_muted') {
          this.enabled = localStorage.getItem('aether_sound_muted') !== 'true';
        }
      });
      this.enabled = localStorage.getItem('aether_sound_muted') !== 'true';
    }

    private isMuted(): boolean {
      try {
        return localStorage.getItem('aether_sound_muted') === 'true';
      } catch {
        return false;
      }
    }

    private init() {
      if (this.isMuted()) return;
      if (!this.ctx) {
        const AudioCtx = window.AudioContext || (window as any).webkitAudioContext;
        if (AudioCtx) this.ctx = new AudioCtx();
      }
      if (this.ctx && this.ctx.state === 'suspended') {
        this.ctx.resume();
      }
    }

    playTick() {
      if (!this.enabled) return;
      this.init();
      if (!this.ctx) return;
      const osc = this.ctx.createOscillator();
      const gain = this.ctx.createGain();
      osc.type = 'triangle';
      osc.frequency.setValueAtTime(600, this.ctx.currentTime);
      osc.frequency.exponentialRampToValueAtTime(120, this.ctx.currentTime + 0.04);
      gain.gain.setValueAtTime(0.2, this.ctx.currentTime);
      gain.gain.exponentialRampToValueAtTime(0.01, this.ctx.currentTime + 0.04);
      osc.connect(gain);
      gain.connect(this.ctx.destination);
      osc.start();
      osc.stop(this.ctx.currentTime + 0.04);
    }

    playWinFanfare() {
      if (!this.enabled) return;
      this.init();
      if (!this.ctx) return;
      const notes = [523.25, 659.25, 783.99, 1046.50]; // C5, E5, G5, C6
      notes.forEach((freq, idx) => {
        const osc = this.ctx!.createOscillator();
        const gain = this.ctx!.createGain();
        osc.type = 'sine';
        osc.frequency.setValueAtTime(freq, this.ctx!.currentTime + idx * 0.1);
        gain.gain.setValueAtTime(0.3, this.ctx!.currentTime + idx * 0.1);
        gain.gain.exponentialRampToValueAtTime(0.01, this.ctx!.currentTime + idx * 0.1 + 0.35);
        osc.connect(gain);
        gain.connect(this.ctx!.destination);
        osc.start(this.ctx!.currentTime + idx * 0.1);
        osc.stop(this.ctx!.currentTime + idx * 0.1 + 0.35);
      });
    }
  }

  const sfx = new SoundFX();

  // Particle Confetti Engine
  class ConfettiEngine {
    private canvas: HTMLCanvasElement;
    private ctx: CanvasRenderingContext2D | null;
    private particles: { x: number; y: number; vx: number; vy: number; color: string; size: number; rot: number; vrot: number }[] = [];
    private running: boolean = false;

    constructor(canvas: HTMLCanvasElement) {
      this.canvas = canvas;
      this.ctx = canvas.getContext('2d');
    }

    burst() {
      this.canvas.width = this.canvas.offsetWidth;
      this.canvas.height = this.canvas.offsetHeight;
      this.particles = [];
      const colors = ['#facc15', '#ec4899', '#38bdf8', '#a855f7', '#10b981', '#f97316'];
      for (let i = 0; i < 90; i++) {
        this.particles.push({
          x: this.canvas.width / 2,
          y: this.canvas.height / 2,
          vx: (Math.random() - 0.5) * 14,
          vy: (Math.random() - 0.5) * 14 - 3,
          color: colors[Math.floor(Math.random() * colors.length)],
          size: Math.random() * 8 + 4,
          rot: Math.random() * Math.PI,
          vrot: (Math.random() - 0.5) * 0.2
        });
      }
      this.running = true;
      this.loop();
    }

    private loop = () => {
      if (!this.ctx || !this.running) return;
      this.ctx.clearRect(0, 0, this.canvas.width, this.canvas.height);
      let alive = 0;
      for (const p of this.particles) {
        p.vy += 0.3; // gravity
        p.x += p.vx;
        p.y += p.vy;
        p.rot += p.vrot;

        if (p.y < this.canvas.height) {
          alive++;
          this.ctx.save();
          this.ctx.translate(p.x, p.y);
          this.ctx.rotate(p.rot);
          this.ctx.fillStyle = p.color;
          this.ctx.fillRect(-p.size / 2, -p.size / 2, p.size, p.size);
          this.ctx.restore();
        }
      }

      if (alive > 0) {
        requestAnimationFrame(this.loop);
      } else {
        this.running = false;
        this.ctx.clearRect(0, 0, this.canvas.width, this.canvas.height);
      }
    };
  }

  // DOM Elements
  const canvas = document.getElementById('roulette-canvas') as HTMLCanvasElement;
  const ctx = canvas?.getContext('2d');
  const pointerElem = document.getElementById('wheel-pointer');
  const confettiCanvas = document.getElementById('confetti-canvas') as HTMLCanvasElement;
  const confetti = new ConfettiEngine(confettiCanvas);

  const titleInput = document.getElementById('input-title') as HTMLInputElement;
  const itemsTextarea = document.getElementById('input-items') as HTMLTextAreaElement;
  const displayTitle = document.getElementById('display-title');
  const itemsCountBadge = document.getElementById('items-count-badge');
  const chkEliminate = document.getElementById('chk-eliminate') as HTMLInputElement;
  const chkSound = document.getElementById('chk-sound') as HTMLInputElement;

  const mainSpinBtn = document.getElementById('main-spin-btn');
  const centerSpinBtn = document.getElementById('center-spin-btn');
  const shuffleBtn = document.getElementById('shuffle-btn');
  const streamModeBtn = document.getElementById('stream-mode-btn');

  const winnerModal = document.getElementById('winner-modal');
  const winnerNameDisplay = document.getElementById('winner-name-display');
  const modalConfirmBtn = document.getElementById('modal-confirm-btn');
  const winnersHistory = document.getElementById('winners-history');
  const clearHistoryBtn = document.getElementById('clear-history-btn');

  let items: string[] = [];
  let currentAngle = 0; // In radians
  let isSpinning = false;
  let lastTickedSlice = -1;

  function parseItems(): string[] {
    if (!itemsTextarea) return [];
    const rawLines = itemsTextarea.value
      .split(/[\r\n,]+/)
      .map(s => s.trim())
      .filter(s => s.length > 0);

    const result: string[] = [];
    for (const line of rawLines) {
      // Check for multiplier patterns: "피자*2", "치킨 * 3", "꽝x5", "콜라×4"
      const match = line.match(/^(.+?)(?:\s*[\*xX×]\s*(\d+))$/);
      if (match) {
        const name = match[1].trim();
        const count = Math.min(Math.max(parseInt(match[2], 10) || 1, 1), 100);
        for (let i = 0; i < count; i++) {
          result.push(name);
        }
      } else {
        result.push(line);
      }
    }
    return result;
  }

  function removeOneInstanceFromTextarea(winner: string) {
    if (!itemsTextarea) return;
    const lines = itemsTextarea.value.split('\n');
    let removed = false;
    const newLines: string[] = [];

    for (const line of lines) {
      const trimmed = line.trim();
      if (!removed) {
        const match = trimmed.match(/^(.+?)(?:\s*[\*xX×]\s*(\d+))$/);
        if (match && match[1].trim() === winner) {
          const count = parseInt(match[2], 10) || 1;
          if (count > 2) {
            newLines.push(`${winner}*${count - 1}`);
          } else if (count === 2) {
            newLines.push(winner);
          }
          removed = true;
          continue;
        } else if (trimmed === winner) {
          removed = true;
          continue;
        }
      }
      if (trimmed.length > 0) newLines.push(line);
    }
    itemsTextarea.value = newLines.join('\n');
  }

  function syncItems() {
    items = parseItems();
    if (itemsCountBadge) itemsCountBadge.textContent = isEn ? `${items.length} Items` : `${items.length}개 항목`;
    drawWheel();
  }

  function drawWheel() {
    if (!ctx) return;
    const width = canvas.width;
    const height = canvas.height;
    const centerX = width / 2;
    const centerY = height / 2;
    const radius = width / 2 - 15;

    ctx.clearRect(0, 0, width, height);

    if (items.length === 0) {
      // Empty wheel state
      ctx.beginPath();
      ctx.arc(centerX, centerY, radius, 0, Math.PI * 2);
      ctx.fillStyle = '#1e293b';
      ctx.fill();
      ctx.strokeStyle = '#334155';
      ctx.lineWidth = 6;
      ctx.stroke();

      ctx.fillStyle = '#64748b';
      ctx.font = 'bold 20px sans-serif';
      ctx.textAlign = 'center';
      ctx.fillText(isEn ? 'Please enter items' : '옵션을 입력해주세요', centerX, centerY);
      return;
    }

    const sliceAngle = (Math.PI * 2) / items.length;

    // Outer Glow Ring
    ctx.beginPath();
    ctx.arc(centerX, centerY, radius + 5, 0, Math.PI * 2);
    ctx.strokeStyle = 'rgba(168, 85, 247, 0.4)';
    ctx.lineWidth = 8;
    ctx.stroke();

    for (let i = 0; i < items.length; i++) {
      const startAngle = currentAngle + i * sliceAngle;
      const endAngle = startAngle + sliceAngle;
      const color = SLICE_COLORS[i % SLICE_COLORS.length];

      // Draw Slice
      ctx.beginPath();
      ctx.moveTo(centerX, centerY);
      ctx.arc(centerX, centerY, radius, startAngle, endAngle);
      ctx.closePath();
      ctx.fillStyle = color;
      ctx.fill();
      ctx.strokeStyle = '#0f172a';
      ctx.lineWidth = 3;
      ctx.stroke();

      // Draw Slice Text
      ctx.save();
      ctx.translate(centerX, centerY);
      ctx.rotate(startAngle + sliceAngle / 2);
      ctx.textAlign = 'right';
      ctx.fillStyle = '#ffffff';
      // Format slice label
      let text = items[i];
      let fontSize = items.length > 12 ? 13 : 16;
      if (text.length > 12) {
        fontSize = Math.max(11, fontSize - 2);
      }
      if (text.length > 18) text = text.substring(0, 17) + '…';
      ctx.font = `bold ${fontSize}px sans-serif`;
      ctx.fillText(text, radius - 20, 5);
      ctx.restore();
    }
  }

  function spinWheel() {
    if (isSpinning || items.length < 2) return;
    isSpinning = true;

    // Random spin parameters
    const minRounds = 5;
    const maxRounds = 9;
    const extraRounds = minRounds + Math.random() * (maxRounds - minRounds);
    const targetDeltaAngle = extraRounds * Math.PI * 2 + Math.random() * Math.PI * 2;
    const duration = 4800 + Math.random() * 800; // ms
    const startTime = performance.now();
    const startAngle = currentAngle;

    function anim(now: number) {
      const elapsed = now - startTime;
      const progress = Math.min(1, elapsed / duration);

      // Ease out cubic deceleration
      const ease = 1 - Math.pow(1 - progress, 3.2);
      currentAngle = startAngle + targetDeltaAngle * ease;

      // Calculate current slice under top pointer (Pointer is at -PI/2 or 270 deg)
      const normalized = ((currentAngle % (Math.PI * 2)) + Math.PI * 2) % (Math.PI * 2);
      const pointerAngle = (Math.PI * 1.5 - normalized + Math.PI * 2) % (Math.PI * 2);
      const sliceAngle = (Math.PI * 2) / items.length;
      const currentSlice = Math.floor(pointerAngle / sliceAngle);

      // Play tick sound when slice boundary crossed
      if (currentSlice !== lastTickedSlice) {
        lastTickedSlice = currentSlice;
        sfx.playTick();
        if (pointerElem) {
          pointerElem.classList.remove('pointer-tick');
          void pointerElem.offsetWidth;
          pointerElem.classList.add('pointer-tick');
        }
      }

      drawWheel();

      if (progress < 1) {
        requestAnimationFrame(anim);
      } else {
        isSpinning = false;
        const winnerIndex = currentSlice;
        const winner = items[winnerIndex];
        finishSpin(winner, winnerIndex);
      }
    }

    requestAnimationFrame(anim);
  }

  function finishSpin(winner: string, index: number) {
    sfx.playWinFanfare();
    confetti.burst();

    // Show winner banner
    if (winnerNameDisplay) winnerNameDisplay.textContent = winner;
    if (winnerModal) winnerModal.classList.remove('hidden');

    // Add to history
    addHistoryItem(winner);

    // If eliminate winner checked
    if (chkEliminate && chkEliminate.checked) {
      removeOneInstanceFromTextarea(winner);
      syncItems();
    }
  }

  function addHistoryItem(winner: string) {
    if (!winnersHistory) return;
    const emptyHint = winnersHistory.querySelector('.empty-history-text');
    if (emptyHint) emptyHint.remove();

    const item = document.createElement('div');
    item.className = 'history-item';
    const now = new Date();
    const timeStr = `${now.getHours()}:${String(now.getMinutes()).padStart(2, '0')}:${String(now.getSeconds()).padStart(2, '0')}`;
    item.innerHTML = `<span>🏆 <strong>${winner}</strong></span><span class="h-time">${timeStr}</span>`;
    winnersHistory.prepend(item);
  }

  // Preset Handlers
  const activePresets = isEn ? PRESETS_EN : PRESETS;

  document.querySelectorAll('.preset-pill').forEach(btn => {
    btn.addEventListener('click', () => {
      const key = (btn as HTMLElement).dataset.preset || '';
      const preset = activePresets[key];
      if (preset) {
        if (titleInput) titleInput.value = preset.title;
        if (displayTitle) displayTitle.textContent = preset.title;
        if (itemsTextarea) itemsTextarea.value = preset.items.join('\n');
        syncItems();
      }
    });
  });

  // Event Listeners
  titleInput?.addEventListener('input', () => {
    if (displayTitle) displayTitle.textContent = titleInput.value || (isEn ? "Today's Spin Wheel" : '오늘의 룰렛');
  });

  itemsTextarea?.addEventListener('input', syncItems);

  shuffleBtn?.addEventListener('click', () => {
    items.sort(() => Math.random() - 0.5);
    if (itemsTextarea) itemsTextarea.value = items.join('\n');
    syncItems();
  });

  mainSpinBtn?.addEventListener('click', spinWheel);
  centerSpinBtn?.addEventListener('click', spinWheel);

  modalConfirmBtn?.addEventListener('click', () => {
    if (winnerModal) winnerModal.classList.add('hidden');
  });

  clearHistoryBtn?.addEventListener('click', () => {
    if (winnersHistory) winnersHistory.innerHTML = `<span class="empty-history-text">${isEn ? 'No winners yet. Spin the wheel!' : '아직 당첨 기록이 없습니다. 룰렛을 돌려보세요!'}</span>`;
  });

  chkSound?.addEventListener('change', () => {
    sfx.enabled = chkSound.checked;
  });

  // Stream Overlay Mode Toggle
  const sidebar = document.getElementById('streamer-sidebar');
  streamModeBtn?.addEventListener('click', () => {
    if (sidebar) {
      sidebar.classList.toggle('hidden');
      streamModeBtn.classList.toggle('btn-secondary');
    }
  });

  // Spacebar to Spin
  window.addEventListener('keydown', (e) => {
    if (e.code === 'Space' && document.activeElement !== itemsTextarea && document.activeElement !== titleInput) {
      e.preventDefault();
      if (!winnerModal?.classList.contains('hidden')) {
        winnerModal?.classList.add('hidden');
      } else {
        spinWheel();
      }
    }
  });

  // English UI Localization
  if (isEn) {
    if (centerSpinBtn) {
      const hubLabel = centerSpinBtn.querySelector('.hub-label');
      if (hubLabel) hubLabel.textContent = 'SPIN';
      centerSpinBtn.setAttribute('title', 'Click or press Space to spin wheel');
    }
    if (mainSpinBtn) {
      const span = mainSpinBtn.querySelector('span');
      if (span) span.textContent = '🎯 Spin Wheel (Space)';
    }
    if (shuffleBtn) {
      const span = shuffleBtn.querySelector('span');
      if (span) span.textContent = '🔀 Shuffle Items';
    }
    if (streamModeBtn) {
      const span = streamModeBtn.querySelector('span');
      if (span) span.textContent = '📺 Focus Mode';
      streamModeBtn.setAttribute('title', 'Toggle minimal focus mode');
    }
    const deskHeader = document.querySelector('.sidebar-header h3');
    if (deskHeader) deskHeader.textContent = 'Wheel Settings Desk';

    const titleLabel = document.querySelector('label[for="input-title"]');
    if (titleLabel) titleLabel.textContent = 'Wheel Title';

    if (titleInput && (!titleInput.value || titleInput.value === '오늘의 방송 룰렛')) {
      titleInput.value = "Today's Spin Wheel";
      titleInput.placeholder = 'Enter wheel title';
    }
    if (displayTitle && (!displayTitle.textContent || displayTitle.textContent.includes('오늘의 방송'))) {
      displayTitle.textContent = "Today's Spin Wheel";
    }

    const presetLabel = document.querySelector('.presets-grid')?.previousElementSibling;
    if (presetLabel) presetLabel.textContent = '⚡ Stream Presets';

    const pFood = document.querySelector('.preset-pill[data-preset="food"]');
    if (pFood) pFood.textContent = '🍕 Food Menu';
    const pPenalty = document.querySelector('.preset-pill[data-preset="penalty"]');
    if (pPenalty) pPenalty.textContent = '⚡ Penalties';
    const pEvent = document.querySelector('.preset-pill[data-preset="event"]');
    if (pEvent) pEvent.textContent = '🎁 Giveaways';
    const pGame = document.querySelector('.preset-pill[data-preset="game"]');
    if (pGame) pGame.textContent = '🎮 Game Picker';

    const itemsLabel = document.querySelector('label[for="input-items"]');
    if (itemsLabel) itemsLabel.textContent = 'Item List';

    const hintText = document.querySelector('.input-hint-text');
    if (hintText) hintText.innerHTML = '💡 Tip: Enter <code>Pizza*2</code> or <code>Burger*3</code> to give items multiple slices!';

    if (itemsTextarea) {
      itemsTextarea.placeholder = 'Enter items separated by newlines (e.g. Pizza*2, Burger*3, Prize*5)';
      if (itemsTextarea.value.includes('치킨')) {
        itemsTextarea.value = PRESETS_EN.food.items.join('\n');
      }
    }

    const chkEliminateLabel = chkEliminate?.parentElement?.querySelector('span');
    if (chkEliminateLabel) chkEliminateLabel.textContent = 'Remove won item automatically';

    const chkSoundLabel = chkSound?.parentElement?.querySelector('span');
    if (chkSoundLabel) chkSoundLabel.textContent = 'Sound Effects (Tick & Fanfare)';

    const historyLabel = document.querySelector('.history-group .label-with-meta label');
    if (historyLabel) historyLabel.textContent = '🏆 Winner History';

    if (clearHistoryBtn) clearHistoryBtn.textContent = 'Clear';

    const emptyHint = document.querySelector('.empty-history-text');
    if (emptyHint) emptyHint.textContent = 'No winners yet. Spin the wheel!';

    const congratsTag = document.querySelector('.congrats-tag');
    if (congratsTag) congratsTag.textContent = '🎉 Congratulations!';

    if (modalConfirmBtn) modalConfirmBtn.textContent = 'Close (OK)';
  }

  // Carnival Golden Sparkles Background Animation
  function initCarnivalSparkles() {
    const bgCanvas = document.getElementById('carnival-canvas') as HTMLCanvasElement;
    if (!bgCanvas) return;
    const bgCtx = bgCanvas.getContext('2d');
    if (!bgCtx) return;

    function resize() {
      if (!bgCanvas) return;
      bgCanvas.width = window.innerWidth;
      bgCanvas.height = window.innerHeight;
    }
    window.addEventListener('resize', resize);
    resize();

    interface Sparkle {
      x: number;
      y: number;
      size: number;
      speedY: number;
      speedX: number;
      color: string;
      alpha: number;
      alphaSpeed: number;
      pulsePhase: number;
      isStar: boolean;
    }

    const sparkleColors = ['#facc15', '#fbbf24', '#38bdf8', '#c084fc', '#f472b6', '#ffffff'];
    const sparkles: Sparkle[] = [];
    const count = 38;

    for (let i = 0; i < count; i++) {
      sparkles.push({
        x: Math.random() * bgCanvas.width,
        y: Math.random() * bgCanvas.height,
        size: Math.random() * 3.5 + 1.2,
        speedY: -(Math.random() * 0.6 + 0.2), // gentle upward float
        speedX: Math.random() * 0.4 - 0.2,
        color: sparkleColors[Math.floor(Math.random() * sparkleColors.length)],
        alpha: Math.random() * 0.6 + 0.2,
        alphaSpeed: Math.random() * 0.02 + 0.01,
        pulsePhase: Math.random() * Math.PI * 2,
        isStar: Math.random() > 0.45,
      });
    }

    function renderSparkles() {
      if (!bgCtx || !bgCanvas) return;
      bgCtx.clearRect(0, 0, bgCanvas.width, bgCanvas.height);

      sparkles.forEach(s => {
        s.y += s.speedY;
        s.x += s.speedX;
        s.pulsePhase += s.alphaSpeed;

        if (s.y < -20) {
          s.y = bgCanvas.height + 20;
          s.x = Math.random() * bgCanvas.width;
        }
        if (s.x < -20) s.x = bgCanvas.width + 20;
        if (s.x > bgCanvas.width + 20) s.x = -20;

        const currentAlpha = Math.max(0.1, Math.min(0.85, s.alpha + Math.sin(s.pulsePhase) * 0.3));

        bgCtx.save();
        bgCtx.translate(s.x, s.y);
        bgCtx.globalAlpha = currentAlpha;
        bgCtx.fillStyle = s.color;

        if (s.isStar) {
          // 4-pointed sparkle diamond
          const r = s.size * 1.5;
          bgCtx.beginPath();
          bgCtx.moveTo(0, -r);
          bgCtx.lineTo(r * 0.3, -r * 0.3);
          bgCtx.lineTo(r, 0);
          bgCtx.lineTo(r * 0.3, r * 0.3);
          bgCtx.lineTo(0, r);
          bgCtx.lineTo(-r * 0.3, r * 0.3);
          bgCtx.lineTo(-r, 0);
          bgCtx.lineTo(-r * 0.3, -r * 0.3);
          bgCtx.closePath();
          bgCtx.fill();
        } else {
          // Glowing orb
          bgCtx.beginPath();
          bgCtx.arc(0, 0, s.size, 0, Math.PI * 2);
          bgCtx.fill();
        }
        bgCtx.restore();
      });

      requestAnimationFrame(renderSparkles);
    }
    requestAnimationFrame(renderSparkles);
  }

  // Initial setup
  initCarnivalSparkles();
  syncItems();
</script>
