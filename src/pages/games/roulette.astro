---
import GameLayout from '../../layouts/GameLayout.astro';
import { getEntry } from 'astro:content';

const gameEntry = await getEntry('games', 'roulette');
const data = gameEntry?.data || {
  title: 'Streamer Roulette',
  tagline: 'Customizable Wheel of Fortune for Live Streams & Raffles',
  description: 'A broadcast-ready, customizable spinning wheel roulette designed for streamers, content creators, and party games.',
  icon: '🎡',
  category: 'arcade',
  badge: '🔴 Stream Tool',
  players: '1-100+ (Party / Chat)',
  playTime: '30s',
  controls: [
    'Click SPIN or press Spacebar to spin the wheel',
    'Type or paste names in the text box (one per line or comma-separated)',
    'Use quick preset buttons (Food, Penalties, Giveaways) for instant setup',
    'Click Fullscreen / Stream Mode for a clean OBS broadcast view'
  ],
  rules: [
    'Each item is assigned a vibrant wedge on the wheel.',
    'The wheel spins with randomized physical torque and realistic friction deceleration.',
    'The top needle points to the winning slice with confetti and fanfare!'
  ],
  faqItems: [
    {
      q: 'How do I use this on OBS Studio for Twitch, Chzzk, or YouTube?',
      a: 'Add a Browser Source in OBS pointing to this page, or capture the window and click the Fullscreen / Stream Mode button for a clean broadcast overlay.'
    },
    {
      q: 'Can I remove the winning option after it is selected?',
      a: 'Yes! Check the "Eliminate Winner" option in the control panel to automatically remove selected winners for multi-round giveaways.'
    }
  ]
};
---

<GameLayout
  title={data.title}
  description={data.description}
  tagline={data.tagline}
  icon={data.icon}
  category={data.category}
  badge={data.badge}
  players={data.players}
  playTime={data.playTime}
  controls={data.controls}
  rules={data.rules}
  faqItems={data.faqItems}
>
  <div class="roulette-app-root" id="roulette-root">

    <!-- Top Mode Switcher Bar -->
    <div class="roulette-mode-tabs">
      <a href="/games/roulette" class="mode-tab active">
        <span class="tab-icon">🎡</span>
        <span class="tab-label">원판 돌림판 룰렛</span>
      </a>
      <a href="/games/marble-roulette" class="mode-tab">
        <span class="tab-icon">🔮</span>
        <span class="tab-label">구슬 레이스 룰렛</span>
        <span class="tab-badge">신규</span>
      </a>
    </div>
    <!-- Left / Center: The Wheel Stage -->
    <div class="wheel-stage-container">
      <div class="wheel-title-bar" id="display-title">오늘의 방송 룰렛</div>

      <div class="wheel-canvas-wrapper" id="wheel-wrapper">
        <!-- Physical Pointer Needle -->
        <div class="roulette-pointer" id="wheel-pointer">
          <div class="pointer-arrow"></div>
        </div>

        <!-- HTML5 High-DPI Canvas -->
        <canvas id="roulette-canvas" width="600" height="600"></canvas>

        <!-- Center Glowing Hub & Spin Button -->
        <button id="center-spin-btn" class="center-hub-btn" title="클릭하거나 스페이스바를 눌러 룰렛 회전">
          <span class="hub-label">돌리기</span>
        </button>
      </div>

      <!-- Quick Action Controls -->
      <div class="wheel-action-bar">
        <button id="main-spin-btn" class="roulette-btn spin-btn-main">
          <span>🎯 룰렛 돌리기 (Space)</span>
        </button>
        <button id="shuffle-btn" class="roulette-btn btn-secondary">
          <span>🔀 항목 섞기</span>
        </button>
        <button id="stream-mode-btn" class="roulette-btn btn-stream" title="깔끔한 집중 모드 전환">
          <span>📺 집중 모드</span>
        </button>
      </div>
    </div>

    <!-- Right: Streamer Control Desk -->
    <div class="streamer-sidebar" id="streamer-sidebar">
      <div class="sidebar-header">
        <span class="panel-icon">⚙️</span>
        <h3>룰렛 설정 데스크</h3>
      </div>

      <!-- Title Input -->
      <div class="config-group">
        <label for="input-title">룰렛 / 추첨 제목</label>
        <input type="text" id="input-title" value="오늘의 방송 룰렛" placeholder="룰렛 제목을 입력하세요" />
      </div>

      <!-- Presets Row -->
      <div class="config-group">
        <label>⚡ 방송 추천 프리셋</label>
        <div class="presets-grid">
          <button class="preset-pill" data-preset="food">🍗 야식 메뉴</button>
          <button class="preset-pill" data-preset="penalty">⚡ 벌칙 룰렛</button>
          <button class="preset-pill" data-preset="event">🎁 치킨/이벤트</button>
          <button class="preset-pill" data-preset="game">🎮 게임 뽑기</button>
        </div>
      </div>

      <!-- Items Textarea -->
      <div class="config-group">
        <div class="label-with-meta">
          <label for="input-items">항목 목록</label>
          <span class="items-count-badge" id="items-count-badge">8개 항목</span>
        </div>
        <p class="input-hint-text">💡 팁: <code>피자*2</code>, <code>치킨*3</code> 처럼 입력하면 여러 칸이 자동 생성됩니다!</p>
        <textarea id="input-items" rows="7" placeholder="항목을 줄바꿈으로 입력하세요 (예: 피자*2, 치킨*3, 꽝*5)">치킨
피자*2
햄버거
족발
엽기떡볶이
마라탕
삼겹살
라면</textarea>
      </div>

      <!-- Options Toggles -->
      <div class="config-group toggles-row">
        <label class="checkbox-label">
          <input type="checkbox" id="chk-eliminate" />
          <span>당첨된 항목 자동 제외</span>
        </label>
        <label class="checkbox-label">
          <input type="checkbox" id="chk-sound" checked />
          <span>효과음 (틱 & 팡파레)</span>
        </label>
      </div>

      <!-- Recent Winners History -->
      <div class="config-group history-group">
        <div class="label-with-meta">
          <label>🏆 당첨 히스토리</label>
          <button id="clear-history-btn" class="mini-clear-btn">초기화</button>
        </div>
        <div class="winners-history-list" id="winners-history">
          <span class="empty-history-text">아직 당첨 기록이 없습니다. 룰렛을 돌려보세요!</span>
        </div>
      </div>
    </div>

    <!-- Celebration Modal / Banner Overlay -->
    <div class="winner-celebration-overlay hidden" id="winner-modal">
      <div class="celebration-card">
        <div class="trophy-bounce">👑</div>
        <div class="congrats-tag">🎉 당첨을 축하합니다!</div>
        <div class="winner-item-name" id="winner-name-display">치킨</div>
        <button id="modal-confirm-btn" class="winner-confirm-btn">확인 (닫기)</button>
      </div>
    </div>

    <!-- Particle Confetti Canvas Layer -->
    <canvas id="confetti-canvas" class="confetti-layer"></canvas>
  </div>

  <div slot="guide">
    <h2>방송용 돌림판 룰렛 활용 가이드</h2>
    <p>
      <strong>스트리머 룰렛</strong>은 치지직(CHZZK), SOOP(아프리카TV), 유튜브 라이브 등 다양한 방송 환경에서 시청자와 함께 실시간으로 소통할 수 있도록 제작된 무료 웹 도구입니다.
    </p>

    <h3>1. 1초 원클릭 방송 프리셋</h3>
    <p>
      상단의 야식 메뉴, 벌칙 룰렛, 치킨 이벤트 프리셋 버튼을 클릭하면 방송에서 가장 많이 쓰이는 항목들이 돌림판에 즉시 자동 입력됩니다.
    </p>

    <h3>2. 가중치 설정 팁</h3>
    <p>
      특정 항목의 당첨 확률을 높이거나 여러 칸으로 만들고 싶다면 <code>피자*2</code>, <code>치킨*3</code>과 같이 별표(*)와 숫자를 붙여 입력해 보세요. 해당 칸이 자동으로 분할되어 생성됩니다.
    </p>
  </div>
</GameLayout>

<style>
  
  /* Mode Switcher Tabs */
  .roulette-mode-tabs {
    grid-column: 1 / -1;
    display: flex;
    justify-content: center;
    gap: 0.5rem;
    background: #0f172a;
    padding: 0.35rem;
    border-radius: 12px;
    border: 1px solid rgba(255, 255, 255, 0.1);
    box-shadow: 0 4px 15px rgba(0, 0, 0, 0.4);
    margin-bottom: 0.5rem;
  }

  .mode-tab {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.5rem 1rem;
    border-radius: 8px;
    font-size: 0.85rem;
    font-weight: 800;
    color: #94a3b8;
    text-decoration: none;
    transition: all 0.15s ease;
  }

  .mode-tab:hover {
    color: #f8fafc;
    background: rgba(255, 255, 255, 0.05);
  }

  .mode-tab.active {
    background: #38bdf8;
    color: #040813;
    box-shadow: 0 0 15px rgba(56, 189, 248, 0.4);
  }

  .tab-badge {
    background: #ef4444;
    color: #ffffff;
    font-size: 0.65rem;
    font-weight: 900;
    padding: 0.1rem 0.35rem;
    border-radius: 4px;
    margin-left: 0.2rem;
  }

  .roulette-app-root {
    position: relative;
    display: grid;
    grid-template-columns: 1fr 360px;
    gap: 1.5rem;
    background: #090d16;
    border-radius: 16px;
    padding: 1.5rem;
    min-height: 640px;
    user-select: none;
  }

  /* Wheel Stage */
  .wheel-stage-container {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    background: #0f172a;
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 14px;
    padding: 1.5rem 1rem;
    position: relative;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.4);
  }

  .wheel-title-bar {
    font-size: 1.5rem;
    font-weight: 900;
    color: #f8fafc;
    letter-spacing: -0.02em;
    margin-bottom: 1.25rem;
    text-shadow: 0 0 15px rgba(168, 85, 247, 0.4);
    text-align: center;
  }

  .wheel-canvas-wrapper {
    position: relative;
    width: 460px;
    height: 460px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  #roulette-canvas {
    width: 440px;
    height: 440px;
    border-radius: 50%;
    box-shadow: 0 0 35px rgba(0, 0, 0, 0.7), 0 0 20px rgba(168, 85, 247, 0.25);
  }

  /* Top Needle Pointer */
  .roulette-pointer {
    position: absolute;
    top: 2px;
    left: 50%;
    transform: translateX(-50%);
    z-index: 25;
    pointer-events: none;
    transition: transform 0.08s ease-out;
  }

  .pointer-arrow {
    width: 0;
    height: 0;
    border-left: 18px solid transparent;
    border-right: 18px solid transparent;
    border-top: 36px solid #ef4444;
    filter: drop-shadow(0 4px 8px rgba(0, 0, 0, 0.6)) drop-shadow(0 0 10px #ef4444);
  }

  .pointer-tick {
    transform: translateX(-50%) rotate(-15deg);
  }

  /* Center Hub Button */
  .center-hub-btn {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 72px;
    height: 72px;
    border-radius: 50%;
    background: radial-gradient(circle, #f8fafc 0%, #0f172a 100%);
    border: 4px solid #ffffff;
    box-shadow: 0 0 20px rgba(0, 0, 0, 0.8), 0 0 15px rgba(56, 189, 248, 0.6);
    color: #020617;
    cursor: pointer;
    z-index: 20;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: transform 0.15s cubic-bezier(0.34, 1.56, 0.64, 1), box-shadow 0.15s ease;
  }

  .center-hub-btn:hover {
    transform: translate(-50%, -50%) scale(1.1);
    box-shadow: 0 0 25px rgba(56, 189, 248, 0.9);
  }

  .hub-label {
    font-size: 0.88rem;
    font-weight: 900;
    letter-spacing: 0.05em;
  }

  /* Action Bar */
  .wheel-action-bar {
    display: flex;
    gap: 0.75rem;
    margin-top: 1.5rem;
    flex-wrap: wrap;
    justify-content: center;
  }

  .roulette-btn {
    padding: 0.75rem 1.5rem;
    border-radius: 10px;
    font-size: 0.95rem;
    font-weight: 800;
    cursor: pointer;
    border: none;
    transition: transform 0.15s ease, box-shadow 0.15s ease;
  }

  .spin-btn-main {
    background: linear-gradient(135deg, #a855f7 0%, #38bdf8 100%);
    color: #ffffff;
    box-shadow: 0 0 20px rgba(168, 85, 247, 0.4);
  }

  .spin-btn-main:hover {
    transform: scale(1.04);
    box-shadow: 0 0 25px rgba(168, 85, 247, 0.6);
  }

  .btn-secondary {
    background: rgba(255, 255, 255, 0.08);
    color: #e2e8f0;
    border: 1px solid rgba(255, 255, 255, 0.12);
  }

  .btn-secondary:hover {
    background: rgba(255, 255, 255, 0.15);
    color: #ffffff;
  }

  .btn-stream {
    background: rgba(56, 189, 248, 0.15);
    color: #38bdf8;
    border: 1px solid rgba(56, 189, 248, 0.3);
  }

  .btn-stream:hover {
    background: rgba(56, 189, 248, 0.25);
  }

  /* Streamer Sidebar */
  .streamer-sidebar {
    background: #0f172a;
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 14px;
    padding: 1.25rem;
    display: flex;
