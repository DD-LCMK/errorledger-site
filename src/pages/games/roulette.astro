      width: 340px;
      height: 340px;
    }
    #roulette-canvas {
      width: 330px;
      height: 330px;
    }
  }
</style>

<script>
  // Presets Data (Korean & English)
  const isEn = typeof window !== 'undefined' && new URLSearchParams(window.location.search).get('lang') === 'en';

  const PRESETS: Record<string, { title: string; items: string[] }> = {
    food: {
      title: '🍗 야식 / 배달 메뉴 룰렛',
      items: ['치킨', '피자', '햄버거', '족발/보쌈', '엽기떡볶이', '마라탕', '삼겹살 구이', '라면/분식', '초밥/회', '샐러드(양심)']
    },
    penalty: {
