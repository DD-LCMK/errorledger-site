---
import GameLayout from '../../layouts/GameLayout.astro';
import { getEntry } from 'astro:content';

const gameEntry = await getEntry('games', 'roulette');
const data = gameEntry?.data || {
  title: '스트리머 돌림판 룰렛',
  tagline: '방송 & 추첨 전용 커스텀 행운의 룰렛',
  description: '야식 메뉴 결정, 벌칙 추첨, 구독자 이벤트까지! 부드러운 물리 회전과 1초 프리셋을 지원하는 무료 방송용 웹 룰렛입니다.',
  icon: '🎡',
  category: 'stream',
  badge: '🔥 방송 필수',
  players: '1인 ~ 시청자 다수',
  playTime: '즉시 (3~10초)',
  controls: [
    '스페이스바(Space) 또는 [룰렛 돌리기] 버튼 클릭',
    '오른쪽 목록에서 나만의 항목 및 가중치 직접 입력',
    '상단 원클릭 프리셋으로 야식, 벌칙, 선물 추첨 즉시 세팅',
    '집중 모드를 활용해 깔끔한 전체화면 연출 가능'
  ],
  rules: [
    '각 항목은 돌림판 위의 화려한 부채꼴 칸으로 자동 배정됩니다.',
    '물리 엔진 기반의 무작위 회전 토크와 감속 마찰을 거쳐 회전합니다.',
    '상단 바늘이 최종 멈춘 칸이 당첨자로 선정되며 꽃가루 축하 효과가 울립니다!'
  ],
  faqItems: [
    {
      q: '전체화면이나 집중 모드는 어떻게 사용하나요?',
      a: '하단의 [📺 집중 모드] 버튼이나 상단 [⛶ 전체화면]을 누르면 불필요한 브라우저 여백 없이 돌림판을 화면 가득 시원하게 띄워 진행할 수 있습니다.'
    },
    {
      q: '한 번 뽑힌 항목을 다음 라운드에서 자동 제외할 수 있나요?',
      a: '네! 제어판에서 [당첨 항목 제외] 옵션을 켜두시면 여러 번 연속 추첨할 때 이미 뽑힌 항목이 자동으로 목록에서 제외됩니다.'
    }
  ]
};
---

<GameLayout
  title={data.title}
  description={data.description}
  tagline={data.tagline}
  icon={data.icon}
  category={data.category}
  badge={data.badge}
  players={data.players}
  playTime={data.playTime}
  controls={data.controls}
  rules={data.rules}
  faqItems={data.faqItems}
  layoutMode="full"
  hideStageHeader={true}
  hideFooter={false}
>
  <div class="roulette-app-root" id="roulette-root">
    <!-- Carnival Neon & Golden Sparkles Theme Canvas -->
    <canvas id="carnival-canvas" class="carnival-canvas"></canvas>

    <!-- Left / Center: The Wheel Stage -->
    <div class="wheel-stage-container">
      <div class="wheel-title-bar" id="display-title">오늘의 방송 룰렛</div>

      <div class="wheel-canvas-wrapper" id="wheel-wrapper">
        <!-- Physical Pointer Needle with Live Arrow Ticker -->
        <div class="roulette-pointer" id="wheel-pointer">
          <div class="pointer-live-ticker" id="pointer-ticker">
            <span class="ticker-dot" id="ticker-dot"></span>
            <span class="ticker-text" id="ticker-text">준비 완료 (Space)</span>
          </div>
          <div class="pointer-arrow"></div>
        </div>

        <!-- HTML5 High-DPI Canvas -->
        <canvas id="roulette-canvas" width="600" height="600"></canvas>

        <!-- Center Glowing Hub & Spin Button -->
        <button id="center-spin-btn" class="center-hub-btn" title="클릭하거나 스페이스바를 눌러 룰렛 회전">
          <span class="hub-label">돌리기</span>
        </button>

        <!-- Celebration Modal: overlays the wheel canvas -->
        <div class="winner-celebration-overlay hidden" id="winner-modal">
          <div class="celebration-card">
            <div class="trophy-bounce">👑</div>
            <div class="congrats-tag">🎉 당첨을 축하합니다!</div>
            <div class="winner-item-name" id="winner-name-display">치킨</div>

            <!-- Provably Fair Verification Section -->
            <div class="fairness-verify-box" id="fairness-verify-box">
              <div class="verify-header">
                <span class="verify-title" id="verify-box-title">🛡️ 공정성 검증 (Provably Fair)</span>
                <span class="verify-status-badge" id="verify-status-badge">검증 대기</span>
              </div>
              <div class="verify-detail-row">
                <span class="verify-k" id="verify-k-raw">사전 원문:</span>
                <code class="verify-v" id="verify-raw-str">--</code>
              </div>
              <div class="verify-detail-row">
                <span class="verify-k" id="verify-k-hash">사전 해시:</span>
                <code class="verify-v" id="verify-hash-str">--</code>
              </div>
              <div class="verify-actions">
                <button type="button" class="btn-verify-check" id="btn-verify-check">🔍 해시 일치 검증</button>
                <button type="button" class="btn-verify-copy" id="btn-verify-copy">📋 증명 복사</button>
              </div>
            </div>

            <button id="modal-confirm-btn" class="winner-confirm-btn">확인 (닫기)</button>
          </div>
        </div>
      </div>

      <!-- Clean Primary Action Controls -->
      <div class="wheel-action-bar">
        <button id="main-spin-btn" class="roulette-btn spin-btn-main">
          <span>🎯 룰렛 돌리기 (Space)</span>
        </button>
        <button id="shuffle-btn" class="roulette-btn btn-secondary">
          <span>🔀 항목 섞기</span>
        </button>
      </div>

      <!-- Verifiable Fairness Pre-Spin Hash Badge -->
      <div class="fairness-badge-bar" id="fairness-badge-bar">
        <div class="fairness-info-wrap">
          <span class="fairness-shield-icon">🛡️</span>
          <span class="fairness-label" id="fairness-badge-label">주작방지 사전 해시:</span>
          <code class="fairness-hash-code" id="fairness-hash-display" title="클릭하여 복사">스핀 시 SHA-256 자동 고정</code>
        </div>
        <button type="button" class="btn-copy-hash" id="btn-copy-hash" title="SHA-256 해시 복사">📋 복사</button>
      </div>
    </div>

    <!-- Right: Streamer Control Desk -->
    <div class="streamer-sidebar" id="streamer-sidebar">
      <div class="sidebar-header">
        <span class="panel-icon">⚙️</span>
        <h3>룰렛 설정 데스크</h3>
      </div>

      <!-- Title Input -->
      <div class="config-group">
        <label for="input-title">룰렛 / 추첨 제목</label>
        <input type="text" id="input-title" value="오늘의 방송 룰렛" placeholder="룰렛 제목을 입력하세요" />
      </div>

      <!-- Presets Row -->
      <div class="config-group">
        <label>⚡ 방송 추천 프리셋</label>
        <div class="presets-grid">
          <button class="preset-pill" data-preset="food">🍗 야식 메뉴</button>
          <button class="preset-pill" data-preset="penalty">⚡ 벌칙 룰렛</button>
          <button class="preset-pill" data-preset="event">🎁 치킨/이벤트</button>
          <button class="preset-pill" data-preset="game">🎮 게임 뽑기</button>
        </div>
      </div>

      <!-- Items Textarea -->
      <div class="config-group">
        <div class="label-with-meta">
          <label for="input-items">항목 목록</label>
          <div class="items-header-actions">
            <button type="button" id="btn-smart-input" class="mini-tool-btn" title="쉼표/줄바꿈/채팅 텍스트 일괄 정리 및 추가">📋 스마트 입력</button>
            <span class="items-count-badge" id="items-count-badge">8개 항목</span>
          </div>
        </div>
        <p class="input-hint-text">💡 팁: <code>피자*2</code>, <code>치킨*3</code> 처럼 입력하면 여러 칸이 자동 생성됩니다!</p>
        <textarea id="input-items" rows="5" placeholder="항목을 줄바꿈으로 입력하세요 (예: 피자*2, 치킨*3, 꽝*5)">치킨
피자*2
햄버거
족발
엽기떡볶이
마라탕
삼겹살
라면</textarea>
        <!-- Data Portability Row -->
        <div class="portability-row">
          <button type="button" id="btn-export-preset" class="port-btn" title="현재 룰렛 항목을 .json 파일로 저장">💾 프리셋 저장</button>
          <label class="port-btn port-btn-upload" title="저장해둔 .json 또는 .txt 프리셋 파일 불러오기">
            📂 불러오기
            <input type="file" id="file-import-preset" accept=".json,.txt" class="hidden-file-input" />
          </label>
        </div>
      </div>

      <!-- Probability Distribution Summary -->
      <div class="config-group prob-summary-group">
        <div class="label-with-meta">
          <label>📊 항목별 당첨 확률</label>
          <span class="prob-total-badge" id="prob-total-badge">총 8개 칸</span>
        </div>
        <div class="prob-items-list" id="prob-items-list">
          <!-- Dynamically populated in JS -->
        </div>
      </div>

      <!-- Options Toggles -->
      <div class="config-group toggles-row">
        <label class="checkbox-label">
          <input type="checkbox" id="chk-eliminate" />
          <span>당첨된 항목 자동 제외</span>
        </label>
        <label class="checkbox-label">
          <input type="checkbox" id="chk-sound" checked />
          <span>효과음 (틱 & 팡파레)</span>
        </label>
      </div>

      <!-- Recent Winners History -->
      <div class="config-group history-group">
        <div class="label-with-meta">
          <label>🏆 당첨 히스토리</label>
          <button id="clear-history-btn" class="mini-clear-btn">초기화</button>
        </div>
        <div class="winners-history-list" id="winners-history">
          <span class="empty-history-text">아직 당첨 기록이 없습니다. 룰렛을 돌려보세요!</span>
        </div>
      </div>
    </div>



    <!-- Smart Bulk Input Modal -->
    <div class="smart-input-overlay hidden" id="smart-input-modal">
      <div class="smart-modal-card">
        <div class="smart-modal-header">
          <div class="modal-title-wrap">
            <span class="modal-icon">📋</span>
            <h3 id="smart-modal-title">시청자 명단 / 항목 스마트 일괄 입력</h3>
          </div>
          <button type="button" id="btn-close-smart-modal" class="modal-close-x" aria-label="닫기">✕</button>
        </div>
        <p class="smart-modal-desc" id="smart-modal-desc">
          채팅창, 디스코드, 메모장에서 복사한 명단을 그대로 붙여넣으세요. 쉼표(,), 줄바꿈, 띄어쓰기를 자동으로 정돈해 드립니다.
        </p>
        <textarea id="smart-raw-input" class="smart-textarea" rows="6" placeholder="예시:
치지직_닉네임1, 치지직_닉네임2
시청자A
시청자B*2
중복된이름 (자동 필터 가능)"></textarea>
        
        <div class="smart-options-row">
          <label class="smart-option-check">
            <input type="checkbox" id="chk-smart-dedup" checked />
            <span id="lbl-smart-dedup">중복 닉네임 자동 제거</span>
          </label>
          <label class="smart-option-check">
            <input type="checkbox" id="chk-smart-shuffle" />
            <span id="lbl-smart-shuffle">추가 전 무작위 셔플</span>
          </label>
        </div>

        <div class="smart-actions-row">
          <button type="button" id="btn-smart-replace" class="smart-btn smart-btn-primary">
            <span>✨ 전체 목록 바꾸기</span>
          </button>
          <button type="button" id="btn-smart-append" class="smart-btn smart-btn-secondary">
            <span>➕ 기존 목록 뒤에 추가</span>
          </button>
        </div>
      </div>
    </div>

    <!-- Feedback Toast -->
    <div id="roulette-toast" class="roulette-toast hidden" role="status" aria-live="polite"></div>

    <!-- Particle Confetti Canvas Layer -->
    <canvas id="confetti-canvas" class="confetti-layer"></canvas>
  </div>

  <div slot="guide">
    <h2>방송용 돌림판 룰렛 활용 가이드</h2>
    <p>
      <strong>스트리머 룰렛</strong>은 치지직(CHZZK), SOOP(아프리카TV), 유튜브 라이브 등 다양한 방송 환경에서 시청자와 함께 실시간으로 소통할 수 있도록 제작된 무료 웹 도구입니다.
    </p>

    <h3>1. 1초 원클릭 방송 프리셋</h3>
    <p>
      상단의 야식 메뉴, 벌칙 룰렛, 치킨 이벤트 프리셋 버튼을 클릭하면 방송에서 가장 많이 쓰이는 항목들이 돌림판에 즉시 자동 입력됩니다.
    </p>

    <h3>2. 가중치 설정 팁</h3>
    <p>
      특정 항목의 당첨 확률을 높이거나 여러 칸으로 만들고 싶다면 <code>피자*2</code>, <code>치킨*3</code>과 같이 별표(*)와 숫자를 붙여 입력해 보세요. 해당 칸이 자동으로 분할되어 생성됩니다.
    </p>
  </div>
</GameLayout>

<style>
  /* Floating Carnival Golden Sparkles Canvas */
  .carnival-canvas {
    position: fixed;
    top: 0;
    left: 0;
    width: 100vw;
    height: 100vh;
    pointer-events: none;
    z-index: 0;
  }

  .roulette-app-root {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: minmax(0, 1fr) 340px;
    gap: 1.25rem;
    background: transparent;
    padding: 0;
    max-width: 100%;
    width: 100%;
    margin: 0;
    user-select: none;
    align-items: start;
  }

  @media (max-width: 960px) {
    .roulette-app-root {
      grid-template-columns: 1fr;
    }
  }

  /* Wheel Stage */
  .wheel-stage-container {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    background: #0f172a;
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 16px;
    padding: 1.5rem 1.25rem 1.25rem;
    position: relative;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.4);
    min-height: 640px;
  }

  .wheel-title-bar {
    font-size: 1.45rem;
    font-weight: 900;
    color: #f8fafc;
    letter-spacing: -0.02em;
    margin-bottom: 0.75rem;
    text-shadow: 0 0 15px rgba(168, 85, 247, 0.4);
    text-align: center;
  }

  .wheel-canvas-wrapper {
    position: relative;
    width: 510px;
    height: 510px;
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 0.5rem auto;
  }

  #roulette-canvas {
    width: 500px;
    height: 500px;
    border-radius: 50%;
    box-shadow: 0 0 40px rgba(0, 0, 0, 0.7), 0 0 25px rgba(168, 85, 247, 0.25);
  }

  /* Probability Summary in Sidebar Desk */
  .prob-summary-group {
    background: rgba(0, 0, 0, 0.22);
    border: 1px solid rgba(255, 255, 255, 0.07);
    border-radius: 10px;
    padding: 0.65rem 0.75rem;
  }

  .prob-total-badge {
    font-size: 0.72rem;
    font-weight: 800;
    color: #38bdf8;
    background: rgba(56, 189, 248, 0.12);
    border: 1px solid rgba(56, 189, 248, 0.25);
    padding: 0.15rem 0.45rem;
    border-radius: 6px;
  }

  .prob-items-list {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    max-height: 165px;
    overflow-y: auto;
    margin-top: 0.35rem;
    padding-right: 0.2rem;
  }

  .prob-items-list::-webkit-scrollbar {
    width: 4px;
  }
  .prob-items-list::-webkit-scrollbar-thumb {
    background: rgba(255, 255, 255, 0.2);
    border-radius: 4px;
  }

  :global(.prob-item-row) {
    position: relative;
    display: flex !important;
    align-items: center !important;
    justify-content: space-between !important;
    background: rgba(255, 255, 255, 0.035);
    border: 1px solid rgba(255, 255, 255, 0.06);
    border-radius: 7px;
    height: 30px;
    min-height: 30px;
    padding: 0 0.55rem;
    gap: 0.35rem;
    transition: all 0.12s ease;
    overflow: hidden;
  }

  :global(.prob-item-row:hover) {
    background: rgba(255, 255, 255, 0.08);
    border-color: rgba(255, 255, 255, 0.15);
  }

  :global(.prob-item-row.is-active-slice) {
    background: rgba(255, 255, 255, 0.14);
    border-color: var(--item-color, #38bdf8);
    box-shadow: 0 0 12px var(--item-color, rgba(56, 189, 248, 0.45));
    transform: scale(1.02) translateX(2px);
  }

  :global(.prob-color-dot) {
    display: inline-block !important;
    width: 8px !important;
    height: 8px !important;
    border-radius: 50%;
    flex-shrink: 0;
    box-shadow: 0 0 6px var(--item-color, currentColor);
  }

  :global(.prob-item-name) {
    font-size: 0.78rem;
    font-weight: 700;
    color: #f1f5f9;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    flex: 1;
    min-width: 0;
  }

  :global(.prob-item-count) {
    font-size: 0.64rem;
    font-weight: 700;
    color: #94a3b8;
    background: rgba(255, 255, 255, 0.08);
    padding: 0.05rem 0.28rem;
    border-radius: 4px;
    white-space: nowrap;
    flex-shrink: 0;
  }

  :global(.prob-inline-bar-track) {
    width: 34px;
    height: 4px;
    background: rgba(255, 255, 255, 0.08);
    border-radius: 2px;
    overflow: hidden;
    flex-shrink: 0;
  }

  :global(.prob-inline-bar-fill) {
    height: 100%;
    border-radius: 2px;
    transition: width 0.3s ease;
  }

  :global(.prob-item-percent) {
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    font-size: 0.74rem;
    font-weight: 800;
    color: #38bdf8;
    background: rgba(56, 189, 248, 0.1);
    border: 1px solid rgba(56, 189, 248, 0.22);
    border-radius: 5px;
    padding: 0.05rem 0.32rem;
    flex-shrink: 0;
    min-width: 42px;
    text-align: right;
    letter-spacing: -0.02em;
  }

  :global(.prob-empty-text) {
    font-size: 0.76rem;
    color: #64748b;
    text-align: center;
    padding: 0.8rem 0;
    font-style: italic;
  }

  /* Top Needle Pointer with Live Arrow Ticker */
  .roulette-pointer {
    position: absolute;
    top: -18px;
    left: 50%;
    transform: translateX(-50%);
    z-index: 25;
    pointer-events: none;
    transition: transform 0.08s ease-out;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .pointer-live-ticker {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 120px;
    gap: 0.35rem;
    padding: 0.25rem 0.75rem;
    background: rgba(15, 23, 42, 0.95);
    border: 1.5px solid var(--ticker-color, #38bdf8);
    border-radius: 9999px;
    box-shadow: 0 4px 15px rgba(0, 0, 0, 0.7), 0 0 12px var(--ticker-color, rgba(56, 189, 248, 0.5));
    font-size: 0.78rem;
    font-weight: 800;
    color: #ffffff;
    white-space: nowrap;
    margin-bottom: 2px;
    transition: all 0.08s ease;
    backdrop-filter: blur(4px);
  }

  .ticker-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
