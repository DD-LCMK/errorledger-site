  function drawWheel() {
    if (!ctx) return;
    const width = canvas.width;
    const height = canvas.height;
    const centerX = width / 2;
    const centerY = height / 2;
    const outerCasingRadius = width / 2 - 14; // 286
    const bulbRingRadius = outerCasingRadius - 16; // 270
    const sliceRadius = bulbRingRadius - 18; // 252

    ctx.clearRect(0, 0, width, height);

    if (items.length === 0) {
      // Empty wheel state
      ctx.beginPath();
      ctx.arc(centerX, centerY, sliceRadius, 0, Math.PI * 2);
      ctx.fillStyle = '#1e293b';
      ctx.fill();
      ctx.strokeStyle = '#334155';
      ctx.lineWidth = 6;
      ctx.stroke();

      ctx.fillStyle = '#64748b';
      ctx.font = 'bold 20px sans-serif';
      ctx.textAlign = 'center';
      ctx.fillText(isEn ? 'Please enter items' : '옵션을 입력해주세요', centerX, centerY);
      return;
    }

    const sliceAngle = (Math.PI * 2) / items.length;

    // 1. Draw Outer Carnival Metallic Rim & Track
    ctx.beginPath();
    ctx.arc(centerX, centerY, outerCasingRadius, 0, Math.PI * 2);
    ctx.fillStyle = '#090d16';
    ctx.fill();
    ctx.strokeStyle = isSpinning ? '#eab308' : '#334155';
    ctx.lineWidth = 4;
    ctx.stroke();

    ctx.beginPath();
    ctx.arc(centerX, centerY, bulbRingRadius + 8, 0, Math.PI * 2);
    ctx.strokeStyle = '#1e293b';
    ctx.lineWidth = 14;
    ctx.stroke();

    // 2. Carnival Marquee Lights (32 bulbs around perimeter)
    const numBulbs = 32;
    const bulbColors = ['#facc15', '#38bdf8', '#f43f5e', '#34d399'];
    for (let b = 0; b < numBulbs; b++) {
      const bAngle = (b / numBulbs) * Math.PI * 2;
      const bx = centerX + Math.cos(bAngle) * bulbRingRadius;
      const by = centerY + Math.sin(bAngle) * bulbRingRadius;

      let bulbColor = '#fef08a';
      let bulbGlow = 'rgba(250, 204, 21, 0.6)';

      if (isSpinning) {
        const chaseIndex = (b + Math.floor(currentAngle * 7)) % 4;
        bulbColor = bulbColors[chaseIndex];
        bulbGlow = bulbColor;
      } else {
        bulbColor = (b % 2 === 0) ? '#facc15' : '#fef08a';
      }

      // Bulb Socket
      ctx.beginPath();
      ctx.arc(bx, by, 5.5, 0, Math.PI * 2);
      ctx.fillStyle = '#020617';
      ctx.fill();

      // Glowing Bulb
      ctx.save();
      ctx.beginPath();
      ctx.arc(bx, by, 3.8, 0, Math.PI * 2);
      ctx.fillStyle = bulbColor;
      ctx.shadowColor = bulbGlow;
      ctx.shadowBlur = isSpinning ? 12 : 5;
      ctx.fill();
      ctx.restore();
    }

    // 3. Draw Slices
    for (let i = 0; i < items.length; i++) {
      const startAngle = currentAngle + i * sliceAngle;
      const endAngle = startAngle + sliceAngle;
      const color = SLICE_COLORS[i % SLICE_COLORS.length];

      // Draw Slice Pie
      ctx.beginPath();
      ctx.moveTo(centerX, centerY);
      ctx.arc(centerX, centerY, sliceRadius, startAngle, endAngle);
      ctx.closePath();
      ctx.fillStyle = color;
      ctx.fill();
      ctx.strokeStyle = '#0f172a';
      ctx.lineWidth = 2.5;
      ctx.stroke();

      // Draw Slice Text
      ctx.save();
      ctx.translate(centerX, centerY);
      ctx.rotate(startAngle + sliceAngle / 2);
      ctx.textAlign = 'right';
      ctx.fillStyle = '#ffffff';
      let text = items[i];
      let fontSize = items.length > 14 ? 12 : (items.length > 8 ? 14 : 16);
      if (text.length > 12) {
        fontSize = Math.max(10, fontSize - 2);
      }
      if (text.length > 18) text = text.substring(0, 17) + '…';
      ctx.font = `bold ${fontSize}px sans-serif`;
      ctx.fillText(text, sliceRadius - 18, 5);
      ctx.restore();
    }

    // 4. Center Bezel behind center button
    ctx.beginPath();
    ctx.arc(centerX, centerY, 48, 0, Math.PI * 2);
    ctx.fillStyle = '#0f172a';
    ctx.fill();
    ctx.strokeStyle = 'rgba(250, 204, 21, 0.6)';
    ctx.lineWidth = 3;
    ctx.stroke();
  }

  function spinWheel() {
    if (isSpinning || items.length < 2) return;
    isSpinning = true;

    if (pointerTicker) {
      pointerTicker.classList.remove('is-winner');
    }

    // Provably fair: determine winner using cryptographically secure PRNG
    const randBuf = new Uint32Array(1);
    window.crypto.getRandomValues(randBuf);
    const predeterminedWinnerIdx = randBuf[0] % items.length;
    const predeterminedWinner = items[predeterminedWinnerIdx];

    // Compute pre-spin hash immediately and display badge
    prepareFairnessSeed(predeterminedWinner, predeterminedWinnerIdx).then(fairData => {
      currentFairness = fairData;
      if (fairnessHashDisplay) {
        fairnessHashDisplay.textContent = `${fairData.hashHex.slice(0, 10)}…${fairData.hashHex.slice(-6)}`;
        fairnessHashDisplay.title = fairData.hashHex;
      }
    });

    // Precise angle physics targeting predetermined slice
    const sliceAngle = (Math.PI * 2) / items.length;
    const offsetInSlice = (0.25 + 0.5 * Math.random()) * sliceAngle;
    const targetPointerAngle = predeterminedWinnerIdx * sliceAngle + offsetInSlice;
    const targetNormalized = ((Math.PI * 1.5 - targetPointerAngle) % (Math.PI * 2) + Math.PI * 2) % (Math.PI * 2);
    const currentNormalized = ((currentAngle % (Math.PI * 2)) + Math.PI * 2) % (Math.PI * 2);
    let deltaAngle = targetNormalized - currentNormalized;
    if (deltaAngle < 0) deltaAngle += Math.PI * 2;
    const minRounds = 6;
    const extraRounds = minRounds + Math.floor(Math.random() * 4);
    const targetDeltaAngle = extraRounds * Math.PI * 2 + deltaAngle;
    const duration = 4800 + Math.random() * 800; // ms
    const startTime = performance.now();
    const startAngle = currentAngle;

    function anim(now: number) {
      const elapsed = now - startTime;
      const progress = Math.min(1, elapsed / duration);

      // Ease out cubic deceleration
      const ease = 1 - Math.pow(1 - progress, 3.2);
      currentAngle = startAngle + targetDeltaAngle * ease;

      // Calculate current slice under top pointer (Pointer is at -PI/2 or 270 deg)
      const normalized = ((currentAngle % (Math.PI * 2)) + Math.PI * 2) % (Math.PI * 2);
      const pointerAngle = (Math.PI * 1.5 - normalized + Math.PI * 2) % (Math.PI * 2);
      const sliceAngle = (Math.PI * 2) / items.length;
      const currentSlice = Math.floor(pointerAngle / sliceAngle);
      const currentItem = items[currentSlice] || '';
      const currentColor = SLICE_COLORS[currentSlice % SLICE_COLORS.length];

      // Real-time live ticker update on top of pointer needle!
      if (tickerText && currentItem) {
        tickerText.textContent = currentItem;
      }
      if (tickerDot) {
        tickerDot.style.background = currentColor;
        tickerDot.style.boxShadow = `0 0 8px ${currentColor}`;
      }
      if (pointerTicker) {
        pointerTicker.style.setProperty('--ticker-color', currentColor);
      }

      // Play tick sound when slice boundary crossed
      if (currentSlice !== lastTickedSlice) {
        lastTickedSlice = currentSlice;
        sfx.playTick();
        if (pointerElem) {
          pointerElem.classList.remove('pointer-tick');
          void pointerElem.offsetWidth;
          pointerElem.classList.add('pointer-tick');
        }
        if (pointerTicker) {
          pointerTicker.classList.remove('ticker-pulse');
          void pointerTicker.offsetWidth;
          pointerTicker.classList.add('ticker-pulse');
        }

        // Live highlight corresponding item in probability panel!
        highlightProbItem(currentItem);

        // Festival Sparkles: emit sparks around wheel edge
        const rect = canvas.getBoundingClientRect();
        festivalSparkles.spawnSparksAroundWheel(
          rect.left + rect.width / 2,
          rect.top + rect.height / 2,
          rect.width / 2,
          currentColor
        );
      }

      drawWheel();

      if (progress < 1) {
        requestAnimationFrame(anim);
      } else {
        isSpinning = false;
        const winnerIndex = currentSlice;
        const winner = items[winnerIndex];
        finishSpin(winner, winnerIndex);
      }
    }

    requestAnimationFrame(anim);
  }

  function finishSpin(winner: string, index: number) {
    sfx.playWinFanfare();
    confetti.burst();

    // Victory stars from wheel center!
    const rect = canvas.getBoundingClientRect();
    festivalSparkles.burstVictoryStars(rect.left + rect.width / 2, rect.top + rect.height / 2);

    // Update live ticker with winner celebration!
    if (tickerText) tickerText.textContent = `👑 ${winner}`;
    if (pointerTicker) pointerTicker.classList.add('is-winner');

    // Highlight winning item in probability list
    highlightProbItem(winner);

    // Populate Provably Fair verification box
    if (currentFairness) {
      if (verifyRawStr) verifyRawStr.textContent = currentFairness.rawString;
      if (verifyHashStr) verifyHashStr.textContent = currentFairness.hashHex;
      if (verifyStatusBadge) {
        verifyStatusBadge.textContent = isEn ? 'Unverified' : '검증 대기';
        verifyStatusBadge.classList.remove('verified');
      }
    }

    // Show winner banner
    if (winnerNameDisplay) winnerNameDisplay.textContent = winner;
    if (winnerModal) winnerModal.classList.remove('hidden');

    // Add to history
    addHistoryItem(winner);

    // If eliminate winner checked
    if (chkEliminate && chkEliminate.checked) {
      removeOneInstanceFromTextarea(winner);
      syncItems();
    }

    // Broadcast result to other tabs (controller/OBS)
    if (syncChannel) {
      syncChannel.postMessage({
        type: 'SPIN_RESULT',
        winner,
        fairData: currentFairness
      });
    }
  }

