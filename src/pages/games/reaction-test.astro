<script>
  (function () {
    const params = new URLSearchParams(window.location.search);
    const isEn = params.get('lang') === 'en' || window.location.pathname.startsWith('/en');

    // ─── Web Audio SFX ──────────────────────────────────────────────────────
    let audioCtx: AudioContext | null = null;
    let isMuted = localStorage.getItem('sound-muted') === 'true';

    function getAudio(): AudioContext | null {
      if (isMuted) return null;
      if (!audioCtx && typeof window !== 'undefined') {
        const Ctx = window.AudioContext || (window as any).webkitAudioContext;
        if (Ctx) audioCtx = new Ctx();
      }
      if (audioCtx && audioCtx.state === 'suspended') {
        audioCtx.resume().catch(() => {});
      }
      return audioCtx;
    }

    function playTone(freq: number, dur = 0.1, type: OscillatorType = 'sine', vol = 0.2) {
      const ctx = getAudio();
      if (!ctx) return;
      const now = ctx.currentTime;
      const osc = ctx.createOscillator();
      const gain = ctx.createGain();
      osc.type = type;
      osc.frequency.setValueAtTime(freq, now);
      gain.gain.setValueAtTime(vol, now);
      gain.gain.exponentialRampToValueAtTime(0.001, now + dur);
      osc.connect(gain);
      gain.connect(ctx.destination);
      osc.start(now);
      osc.stop(now + dur + 0.01);
    }

    function playBuzzer() {
      playTone(150, 0.25, 'sawtooth', 0.22);
    }

    function playFanfare() {
      [523.25, 659.25, 783.99, 1046.5].forEach((f, idx) => {
        setTimeout(() => playTone(f, 0.18, 'triangle', 0.22), idx * 70);
      });
    }

    // ─── Personal Bests Persistence ─────────────────────────────────────────
    const STORAGE_KEY = 'errorledger_reaction_test_v1';
    interface BestRecords {
      bestAge: number | null;
      bestReactMs: number | null;
      bestAimHits: number | null;
      bestCps: number | null;
    }

    let pb: BestRecords = {
      bestAge: null,
      bestReactMs: null,
      bestAimHits: null,
      bestCps: null
    };

    try {
      const saved = localStorage.getItem(STORAGE_KEY);
      if (saved) pb = { ...pb, ...JSON.parse(saved) };
    } catch (e) {}

    function savePb() {
      try {
        localStorage.setItem(STORAGE_KEY, JSON.stringify(pb));
      } catch (e) {}
    }

    // ─── State ──────────────────────────────────────────────────────────────
    type TestMode = 'full' | 'react' | 'aim' | 'cps';
    let currentMode: TestMode = 'full';
    let activeStage: 1 | 2 | 3 | 4 = 1;

    // Stage 1: Reaction State
    type ReactPhase = 'idle' | 'waiting' | 'go' | 'foul' | 'round_done' | 'stage_done';
    let reactPhase: ReactPhase = 'idle';
    let reactTimerId: number | null = null;
    let reactGoTime = 0;
    let reactTimes: number[] = [];
    let avgReactMs = 220;

    // Stage 2: Aim State
    let aimRunning = false;
    let aimTimeLeft = 12.0;
    let aimHits = 0;
    let aimClicks = 0;
    let aimRafId: number | null = null;
    let aimLastTick = 0;
    let lastTargetX = 50;
    let lastTargetY = 50;

    // Stage 3: CPS State
    let cpsRunning = false;
    let cpsDone = false;
    let cpsTimeLeft = 5.0;
    let cpsCount = 0;
    let cpsRafId: number | null = null;
    let cpsLastTick = 0;

    // ─── DOM Elements ───────────────────────────────────────────────────────
    const panelReaction = document.getElementById('panel-reaction');
    const panelAim = document.getElementById('panel-aim');
    const panelCps = document.getElementById('panel-cps');
    const panelReceipt = document.getElementById('panel-receipt');

    const reactPad = document.getElementById('react-pad');
    const reactRoundBadge = document.getElementById('react-round-badge');
    const reactAvgChip = document.getElementById('react-avg-chip');
    const reactBigIcon = document.getElementById('react-big-icon');
    const reactMainTitle = document.getElementById('react-main-title');
    const reactSubDesc = document.getElementById('react-sub-desc');

    const aimTimeVal = document.getElementById('aim-time-val');
    const aimHitsVal = document.getElementById('aim-hits-val');
    const aimAccVal = document.getElementById('aim-acc-val');
    const aimTpsVal = document.getElementById('aim-tps-val');
    const aimField = document.getElementById('aim-field');
    const aimOverlay = document.getElementById('aim-overlay');
    const aimOvTitle = document.getElementById('aim-ov-title');
    const aimOvDesc = document.getElementById('aim-ov-desc');
    const btnStartAim = document.getElementById('btn-start-aim');
    const aimTarget = document.getElementById('aim-target');

    const cpsTimeVal = document.getElementById('cps-time-val');
    const cpsCountVal = document.getElementById('cps-count-val');
    const cpsRateVal = document.getElementById('cps-rate-val');
    const cpsMashPad = document.getElementById('cps-mash-pad') as HTMLButtonElement | null;
    const cpsPadTitle = document.getElementById('cps-pad-title');
    const cpsPadSub = document.getElementById('cps-pad-sub');
    const cpsLiveNum = document.getElementById('cps-live-num');
    const cpsDoneActions = document.getElementById('cps-done-actions');
    const btnCpsFinish = document.getElementById('btn-cps-finish');

    const logListEl = document.getElementById('rx-log-list');

    // Apply English UI if lang=en
    if (isEn) {
      const setTxt = (id: string, txt: string) => {
        const el = document.getElementById(id);
        if (el) el.textContent = txt;
      };
      setTxt('tab-mode-full', '🏆 Full 3-Stage Age Test');
      setTxt('tab-mode-react', '⚡ Reaction Only (ms)');
      setTxt('tab-mode-aim', '🎯 Aim Tracking Only (12s)');
      setTxt('tab-mode-cps', '🔥 5s CPS Burst Only');
      setTxt('ui-step1-txt', '⚡ Reaction (3x)');
      setTxt('ui-step2-txt', '🎯 Aim Track (12s)');
      setTxt('ui-step3-txt', '🔥 CPS Burst (5s)');
      setTxt('ui-step4-txt', 'Physical Age Receipt');
      setTxt('ui-aim-time', '⏱️ Time Left');
      setTxt('ui-aim-hits', '🎯 Targets Hit');
      setTxt('ui-aim-acc', '✨ Accuracy');
      setTxt('ui-aim-speed', '⚡ Speed');
      setTxt('ui-cps-time', '⏱️ Time Left');
      setTxt('ui-cps-count', '👆 Total Taps');
      setTxt('ui-cps-rate', '🔥 Clicks / Sec');
      setTxt('ui-rec-hospital', '🏥 ErrorLedger Esports Physical Center');
      setTxt('ui-rec-heading', 'Official Gamer Physical Age Report');
      setTxt('ui-rec-agelabel', 'Measured Physical Reflex Age');
      setTxt('ui-rm-react', '⚡ Reaction Speed');
      setTxt('ui-rm-aim', '🎯 Aim Tracking (12s)');
      setTxt('ui-rm-cps', '🔥 CPS Burst (5s)');
      setTxt('ui-doc-title', '👨‍⚕️ Doctor’s Savage Diagnosis & Prescription');
      setTxt('btn-rec-copy', '📋 Copy Report Card for Stream Chat');
      setTxt('btn-rec-retry', '🔄 Retest From Start');
      setTxt('ui-pb-title', '🏆 Personal Best Records');
      setTxt('ui-pb-age', 'Youngest Physical Age');
      setTxt('ui-pb-react', 'Best Avg Reaction');
      setTxt('ui-pb-aim', 'Best Aim (12s)');
      setTxt('ui-pb-cps', 'Best CPS');
      setTxt('ui-bench-title', '📊 Physical Age Benchmark Table');
      setTxt('th-age', 'Physical Age');
      setTxt('th-react', 'Reaction');
      setTxt('th-tier', 'Tier Rating');
      setTxt('ui-log-title', '📜 Live Session Log');
    }

    function addLog(msg: string, cls = 'info') {
      if (!logListEl) return;
      const div = document.createElement('div');
      div.className = `rx-log-item ${cls}`;
      div.textContent = msg;
      logListEl.prepend(div);
      while (logListEl.children.length > 25) {
        logListEl.removeChild(logListEl.lastChild!);
      }
    }

    function renderPb() {
      const elAge = document.getElementById('pb-age-val');
      const elReact = document.getElementById('pb-react-val');
      const elAim = document.getElementById('pb-aim-val');
      const elCps = document.getElementById('pb-cps-val');
      if (elAge) elAge.textContent = pb.bestAge !== null ? (isEn ? `Age ${pb.bestAge}` : `만 ${pb.bestAge}세`) : '-';
      if (elReact) elReact.textContent = pb.bestReactMs !== null ? `${pb.bestReactMs.toFixed(1)} ms` : '-';
      if (elAim) elAim.textContent = pb.bestAimHits !== null ? (isEn ? `${pb.bestAimHits} hits` : `${pb.bestAimHits}개`) : '-';
      if (elCps) elCps.textContent = pb.bestCps !== null ? `${pb.bestCps.toFixed(1)} CPS` : '-';
    }

    function updateStepper(stage: 1 | 2 | 3 | 4) {
      activeStage = stage;
      [1, 2, 3, 4].forEach((n) => {
        const el = document.getElementById(`step-ind-${n}`);
        if (!el) return;
        el.classList.remove('active', 'done');
        if (n === stage) el.classList.add('active');
        else if (n < stage) el.classList.add('done');
      });

      panelReaction?.classList.toggle('hidden', stage !== 1);
      panelAim?.classList.toggle('hidden', stage !== 2);
      panelCps?.classList.toggle('hidden', stage !== 3);
      panelReceipt?.classList.toggle('hidden', stage !== 4);
    }

    // ─── STAGE 1: REACTION SPEED (3 ROUNDS) ─────────────────────────────────
    function resetReactionStage() {
      if (reactTimerId) clearTimeout(reactTimerId);
      reactPhase = 'idle';
      reactTimes = [];
      updateReactionPadUI();
    }

    function updateReactionPadUI() {
      if (!reactPad || !reactRoundBadge || !reactAvgChip || !reactBigIcon || !reactMainTitle || !reactSubDesc) return;
      reactPad.className = 'react-pad';

      for (let i = 0; i < 3; i++) {
        const pill = document.getElementById(`r-pill-${i}`);
        if (pill) {
          if (reactTimes[i] !== undefined) {
            pill.textContent = isEn ? `R${i + 1}: ${reactTimes[i].toFixed(1)} ms` : `${i + 1}차: ${reactTimes[i].toFixed(1)} ms`;
            pill.classList.add('done');
          } else {
            pill.textContent = isEn ? `R${i + 1}: -` : `${i + 1}차: -`;
            pill.classList.remove('done');
          }
        }
      }

      const curAvg = reactTimes.length > 0
        ? reactTimes.reduce((a, b) => a + b, 0) / reactTimes.length
        : null;
      reactAvgChip.textContent = curAvg !== null
        ? (isEn ? `Avg: ${curAvg.toFixed(1)} ms` : `평균: ${curAvg.toFixed(1)} ms`)
        : (isEn ? 'Avg: - ms' : '평균: - ms');
      reactRoundBadge.textContent = `ROUND ${Math.min(3, reactTimes.length + (reactPhase === 'stage_done' ? 0 : 1))} / 3`;

      if (reactPhase === 'idle') {
        reactPad.classList.add('state-idle');
        reactBigIcon.textContent = '⚡';
        reactMainTitle.textContent = isEn ? 'Stage 1: Visual Reaction Speed' : '1단계: 순간 반응속도 측정';
        reactSubDesc.innerHTML = isEn
          ? 'Click anywhere or press <strong>[Space]</strong> to start.<br/>Click as fast as possible the moment the screen turns <strong>GREEN</strong>!'
          : '화면을 클릭하거나 <strong>[Space]</strong>를 누르면 시작합니다.<br/>빨간색 화면이 <strong>초록색으로 바뀌는 순간</strong> 즉시 클릭하세요!';
      } else if (reactPhase === 'waiting') {
        reactPad.classList.add('state-waiting');
        reactBigIcon.textContent = '🛑';
        reactMainTitle.textContent = isEn ? 'WAIT FOR GREEN...' : '기다리세요... (초록색 대기 중)';
        reactSubDesc.textContent = isEn ? 'Do NOT click yet! Wait until it flashes green!' : '아직 누르지 마세요! 초록색으로 바뀌면 즉시 클릭/Space!';
      } else if (reactPhase === 'go') {
        reactPad.classList.add('state-go');
        reactBigIcon.textContent = '🟢';
        reactMainTitle.textContent = isEn ? 'CLICK NOW!! (SPACE)' : '⚡ 지금 클릭!! (SPACE)';
        reactSubDesc.textContent = isEn ? 'As fast as you can!' : '최대한 빠르게 누르세요!';
      } else if (reactPhase === 'foul') {
        reactPad.classList.add('state-foul');
        reactBigIcon.textContent = '🚨';
        reactMainTitle.textContent = isEn ? 'FALSE START! (Too Early)' : '🚨 부정출발! (너무 일찍 눌렀습니다)';
        reactSubDesc.textContent = isEn
          ? 'You clicked before the screen turned green. Click or press Space to retry this round.'
          : '초록색으로 바뀌기 전에 눌렀습니다! 클릭 또는 [Space]로 이 라운드를 다시 시작하세요.';
      } else if (reactPhase === 'round_done') {
        const lastMs = reactTimes[reactTimes.length - 1];
        reactPad.classList.add('state-result');
        reactBigIcon.textContent = '⏱️';
        reactMainTitle.textContent = `${lastMs.toFixed(1)} ms`;
        reactSubDesc.textContent = isEn
          ? `Round ${reactTimes.length}/3 recorded! Click or press [Space] for the next round.`
          : `${reactTimes.length}차 측정 완료! 클릭 또는 [Space]를 눌러 다음 라운드를 진행하세요.`;
      } else if (reactPhase === 'stage_done') {
        reactPad.classList.add('state-result');
        reactBigIcon.textContent = '🏆';
        reactMainTitle.textContent = isEn ? `Average: ${avgReactMs.toFixed(1)} ms` : `평균 반응속도: ${avgReactMs.toFixed(1)} ms`;
        reactSubDesc.textContent = currentMode === 'full'
          ? (isEn ? 'Click or press [Space] to advance to Stage 2 (Aim Tracking)!' : '클릭 또는 [Space]를 누르면 2단계(에임 트래킹)로 이동합니다!')
          : (isEn ? 'Click or press [Space] to test Reaction Speed again!' : '클릭 또는 [Space]를 누르면 다시 측정합니다!');
      }
    }

    function startReactionWaiting() {
      reactPhase = 'waiting';
      updateReactionPadUI();
      const delay = 1400 + Math.random() * 2600;
      reactTimerId = window.setTimeout(() => {
        reactPhase = 'go';
        reactGoTime = performance.now();
        playTone(880, 0.08, 'sine', 0.18);
        updateReactionPadUI();
      }, delay);
    }

    function handleReactionInput() {
      if (activeStage !== 1) return;

      if (reactPhase === 'idle' || reactPhase === 'round_done' || reactPhase === 'foul') {
        startReactionWaiting();
      } else if (reactPhase === 'waiting') {
        if (reactTimerId) clearTimeout(reactTimerId);
        reactPhase = 'foul';
        playBuzzer();
        addLog(isEn ? '🚨 False start detected! Retrying round.' : '🚨 [부정출발] 초록색 점등 전에 클릭했습니다!', 'warn');
        updateReactionPadUI();
      } else if (reactPhase === 'go') {
        const ms = Math.max(80, performance.now() - reactGoTime);
        reactTimes.push(ms);
        playTone(660, 0.1, 'triangle', 0.22);

        if (reactTimes.length >= 3) {
          avgReactMs = reactTimes.reduce((a, b) => a + b, 0) / reactTimes.length;
          if (pb.bestReactMs === null || avgReactMs < pb.bestReactMs) {
            pb.bestReactMs = avgReactMs;
            savePb();
            renderPb();
          }
          addLog(
            isEn
              ? `⚡ [Stage 1] 3-Round Avg Reaction: ${avgReactMs.toFixed(1)} ms`
              : `⚡ [1단계 완료] 3회 평균 반응속도: ${avgReactMs.toFixed(1)} ms`,
            'good'
          );
          reactPhase = 'stage_done';
          updateReactionPadUI();
        } else {
          reactPhase = 'round_done';
          updateReactionPadUI();
        }
      } else if (reactPhase === 'stage_done') {
        if (currentMode === 'full') {
          prepareAimStage();
          updateStepper(2);
        } else {
          resetReactionStage();
          startReactionWaiting();
        }
      }
    }

    reactPad?.addEventListener('mousedown', (e) => {
      e.preventDefault();
      handleReactionInput();
    });

    // ─── STAGE 2: AIM TRACKING (12 SECONDS) ─────────────────────────────────
    function prepareAimStage() {
      if (aimRafId) cancelAnimationFrame(aimRafId);
      aimRunning = false;
      aimTimeLeft = 12.0;
      aimHits = 0;
      aimClicks = 0;
      updateAimHud();
      aimTarget?.classList.add('hidden');
      aimOverlay?.classList.remove('hidden');
      if (aimOvTitle) {
        aimOvTitle.textContent = isEn ? 'Stage 2: 12s Aim Tracking' : '2단계: 12초 순간 에임 트래킹';
      }
      if (aimOvDesc) {
        aimOvDesc.innerHTML = isEn
          ? 'Click the glowing bullseye targets as fast and accurately as possible for 12 seconds!'
          : '12초 동안 화면에 나타나는 타겟을 빠르고 정확하게 조준 클릭하세요!';
      }
      if (btnStartAim) {
        btnStartAim.textContent = isEn ? '🎯 Start 12s Aim Test' : '🎯 12초 에임 측정 시작하기';
      }
    }

    function updateAimHud() {
      if (aimTimeVal) aimTimeVal.textContent = `${aimTimeLeft.toFixed(1)}s`;
      if (aimHitsVal) aimHitsVal.textContent = isEn ? `${aimHits}` : `${aimHits}개`;
      const acc = aimClicks > 0 ? Math.round((aimHits / aimClicks) * 100) : 100;
      if (aimAccVal) aimAccVal.textContent = `${acc}%`;
      const elapsed = Math.max(0.2, 12.0 - aimTimeLeft);
      const tps = aimHits / elapsed;
      if (aimTpsVal) aimTpsVal.textContent = `${tps.toFixed(2)} T/s`;
    }

    function spawnAimTarget() {
      if (!aimTarget || !aimField) return;
      let nx = 50;
      let ny = 50;
      for (let tries = 0; tries < 10; tries++) {
        nx = 12 + Math.random() * 76;
        ny = 16 + Math.random() * 68;
        if (Math.hypot(nx - lastTargetX, ny - lastTargetY) > 22) break;
      }
      lastTargetX = nx;
      lastTargetY = ny;
      const scale = Math.max(0.76, 1 - aimHits * 0.008);
      aimTarget.style.left = `${nx}%`;
      aimTarget.style.top = `${ny}%`;
      aimTarget.style.width = `${Math.round(64 * scale)}px`;
      aimTarget.style.height = `${Math.round(64 * scale)}px`;
      aimTarget.classList.remove('hidden');
    }

    function tickAimLoop(now: number) {
      if (!aimRunning) return;
      const dt = (now - aimLastTick) / 1000;
      aimLastTick = now;
      aimTimeLeft = Math.max(0, aimTimeLeft - dt);
      updateAimHud();

      if (aimTimeLeft <= 0) {
        finishAimStage();
        return;
      }
      aimRafId = requestAnimationFrame(tickAimLoop);
    }

    function startAimStage() {
      aimRunning = true;
      aimTimeLeft = 12.0;
      aimHits = 0;
      aimClicks = 0;
      aimOverlay?.classList.add('hidden');
      spawnAimTarget();
      aimLastTick = performance.now();
      aimRafId = requestAnimationFrame(tickAimLoop);
    }

    function finishAimStage() {
      aimRunning = false;
      if (aimRafId) cancelAnimationFrame(aimRafId);
      aimTarget?.classList.add('hidden');

      if (pb.bestAimHits === null || aimHits > pb.bestAimHits) {
        pb.bestAimHits = aimHits;
        savePb();
        renderPb();
      }

      const acc = aimClicks > 0 ? Math.round((aimHits / aimClicks) * 100) : 100;
      addLog(
        isEn
          ? `🎯 [Stage 2] Aim Hits: ${aimHits} (Accuracy: ${acc}%)`
          : `🎯 [2단계 완료] 에임 명중: ${aimHits}개 (명중률 ${acc}%)`,
        'good'
      );

      if (currentMode === 'full') {
        prepareCpsStage();
        updateStepper(3);
      } else {
        aimOverlay?.classList.remove('hidden');
        if (aimOvTitle) {
          aimOvTitle.textContent = isEn ? `🎯 Result: ${aimHits} Targets (${acc}%)` : `🎯 측정 완료: ${aimHits}개 명중 (명중률 ${acc}%)`;
        }
        if (btnStartAim) {
          btnStartAim.textContent = isEn ? '🔄 Retry Aim Test' : '🔄 에임 트래킹 다시 측정하기';
        }
      }
    }

    btnStartAim?.addEventListener('click', (e) => {
      e.stopPropagation();
      startAimStage();
    });

    aimTarget?.addEventListener('mousedown', (e) => {
      e.stopPropagation();
      if (!aimRunning) return;
      aimHits += 1;
      aimClicks += 1;
      playTone(740 + Math.min(400, aimHits * 15), 0.07, 'sine', 0.2);
      updateAimHud();
      spawnAimTarget();
    });

    aimField?.addEventListener('mousedown', () => {
      if (!aimRunning) return;
      aimClicks += 1;
      playBuzzer();
      updateAimHud();
    });

    // ─── STAGE 3: 5-SECOND CPS BURST ────────────────────────────────────────
    function prepareCpsStage() {
      if (cpsRafId) cancelAnimationFrame(cpsRafId);
      cpsRunning = false;
      cpsDone = false;
      cpsTimeLeft = 5.0;
      cpsCount = 0;
      if (cpsMashPad) cpsMashPad.disabled = false;
      if (cpsPadTitle) {
        cpsPadTitle.textContent = isEn
          ? 'MASH CLICK OR [SPACE] AS FAST AS POSSIBLE!'
          : '여기를 마우스로 광클하거나 [Space]를 연타하세요!';
      }
      if (cpsPadSub) {
        cpsPadSub.textContent = isEn
          ? '(5.0s timer starts on your first tap)'
          : '(첫 클릭 또는 스페이스바 입력 순간 5초 카운트다운이 시작됩니다)';
      }
      if (cpsLiveNum) cpsLiveNum.textContent = '0';
      cpsDoneActions?.classList.add('hidden');
      updateCpsHud();
    }

    function updateCpsHud() {
      if (cpsTimeVal) cpsTimeVal.textContent = `${cpsTimeLeft.toFixed(2)}s`;
      if (cpsCountVal) cpsCountVal.textContent = isEn ? `${cpsCount}` : `${cpsCount}회`;
      const elapsed = cpsRunning || cpsDone ? Math.max(0.15, 5.0 - cpsTimeLeft) : 5.0;
      const rate = cpsCount > 0 ? cpsCount / elapsed : 0;
      if (cpsRateVal) cpsRateVal.textContent = `${rate.toFixed(1)} CPS`;
      if (cpsLiveNum) cpsLiveNum.textContent = String(cpsCount);
    }

    function tickCpsLoop(now: number) {
      if (!cpsRunning) return;
      const dt = (now - cpsLastTick) / 1000;
      cpsLastTick = now;
      cpsTimeLeft = Math.max(0, cpsTimeLeft - dt);
      updateCpsHud();

      if (cpsTimeLeft <= 0) {
        finishCpsStage();
        return;
      }
      cpsRafId = requestAnimationFrame(tickCpsLoop);
    }

    function registerCpsTap() {
      if (activeStage !== 3 || cpsDone) return;
      if (!cpsRunning) {
        cpsRunning = true;
        cpsTimeLeft = 5.0;
        cpsLastTick = performance.now();
        cpsRafId = requestAnimationFrame(tickCpsLoop);
      }
      cpsCount += 1;
      playTone(440 + Math.min(500, cpsCount * 8), 0.04, 'triangle', 0.14);
      updateCpsHud();
    }

    function finishCpsStage() {
      cpsRunning = false;
      cpsDone = true;
      if (cpsRafId) cancelAnimationFrame(cpsRafId);
      if (cpsMashPad) cpsMashPad.disabled = true;

      const finalCps = cpsCount / 5.0;
      if (pb.bestCps === null || finalCps > pb.bestCps) {
        pb.bestCps = finalCps;
        savePb();
        renderPb();
      }

      addLog(
        isEn
          ? `🔥 [Stage 3] CPS Burst: ${finalCps.toFixed(1)} CPS (${cpsCount} taps in 5s)`
          : `🔥 [3단계 완료] 5초 광클: ${finalCps.toFixed(1)} CPS (총 ${cpsCount}회)`,
        'good'
      );

      if (cpsPadTitle) {
        cpsPadTitle.textContent = isEn
          ? `🔥 5s Burst Complete! ${finalCps.toFixed(1)} CPS`
          : `🔥 5초 광클 측정 완료! (${finalCps.toFixed(1)} CPS)`;
      }
      cpsDoneActions?.classList.remove('hidden');
      if (btnCpsFinish) {
        btnCpsFinish.textContent = currentMode === 'full'
          ? (isEn ? '🧾 View My Physical Age Receipt →' : '🧾 최종 피지컬 나이 진단서 확인하기 →')
          : (isEn ? '🔄 Retry 5s CPS Test' : '🔄 5초 광클 다시 측정하기');
      }
    }

    cpsMashPad?.addEventListener('mousedown', (e) => {
      e.preventDefault();
      registerCpsTap();
    });

    btnCpsFinish?.addEventListener('click', () => {
      if (currentMode === 'full') {
        buildAndShowReceipt();
      } else {
        prepareCpsStage();
      }
    });

    // Global Spacebar handler for Stage 1 & Stage 3 (blocks e.repeat cheating!)
    window.addEventListener('keydown', (e) => {
      if (e.code !== 'Space' || e.repeat) return;
      const tag = document.activeElement?.tagName.toLowerCase();
      if (tag === 'input' || tag === 'textarea') return;

      if (activeStage === 1) {
        e.preventDefault();
        handleReactionInput();
      } else if (activeStage === 3 && !cpsDone) {
        e.preventDefault();
        registerCpsTap();
      }
    });

    // ─── STAGE 4: PHYSICAL AGE CALCULATION & MEDICAL RECEIPT ────────────────
    function buildAndShowReceipt() {
      updateStepper(4);
      playFanfare();

      const finalCps = cpsCount / 5.0;
      const aimAcc = aimClicks > 0 ? Math.round((aimHits / aimClicks) * 100) : 100;

      // Calculate composite Physical Age (16 ~ 70)
      // Base age from Reaction Speed (175ms => 17, 215ms => 23, 250ms => 29, 300ms => 40)
      let rawAge = 16 + (avgReactMs - 170) * 0.18;
      // Adjust by Aim Performance (22 hits @ 90%+ is par)
      const effectiveAim = aimHits * (aimAcc / 100);
      rawAge -= (effectiveAim - 18) * 0.42;
      // Adjust by CPS (8.5 CPS is par)
      rawAge -= (finalCps - 7.5) * 0.55;

      const physicalAge = Math.max(16, Math.min(72, Math.round(rawAge)));

      if (pb.bestAge === null || physicalAge < pb.bestAge) {
        pb.bestAge = physicalAge;
        savePb();
        renderPb();
      }

      let tierText = '';
      let docComment = '';
      let rxGames = '';
      let ageColor = '#00ffa3';

      if (physicalAge <= 19) {
        ageColor = '#00ffa3';
        tierText = isEn ? '🏆 CHALLENGER (Top 0.5% Pro Reflexes)' : '🏆 CHALLENGER — 상위 0.5% 프로게이머급 괴물 피지컬';
        docComment = isEn
          ? 'Your hands react faster than conscious thought! Zero signs of aging curve. You have full bragging rights on stream.'
          : '뇌보다 손이 먼저 반응하는 경이로운 신경계를 보유하고 있습니다! 에이징 커브는커녕 당장 대회 예선에 나가도 될 수준입니다.';
        rxGames = isEn
          ? '💊 Prescribed Games: Valorant Radiant Queue, League of Legends, Apex Legends, StarCraft'
          : '💊 권장 처방 게임: 발로란트, 리그 오브 레전드(미드/원딜), 에이펙스 레전드, 이터널 리턴';
      } else if (physicalAge <= 24) {
        ageColor = '#38bdf8';
        tierText = isEn ? '💎 DIAMOND (Prime Streamer Mechanics)' : '💎 DIAMOND — 현역 최전성기 피지컬';
        docComment = isEn
          ? 'Sharp reflexes, crisp aim flicks, and healthy finger stamina. Your viewers cannot blame your mechanics today!'
          : '반응속도와 에임 정확도 모두 현역 최전성기입니다! 오늘 방송에서 피지컬 부심을 당당하게 부려도 시청자들이 인정할 수치입니다.';
        rxGames = isEn
          ? '💊 Prescribed Games: PUBG, Overwatch 2, Counter-Strike 2, Tekken 8'
          : '💊 권장 처방 게임: 배틀그라운드, 오버워치 2, 철권 8, 로스트아크 군단장';
      } else if (physicalAge <= 29) {
        ageColor = '#fbbf24';
        tierText = isEn ? '🥇 GOLD / PLATINUM (Average Gamer)' : '🥇 GOLD — 지극히 평범한 평균 게이머';
        docComment = isEn
          ? 'Respectable reflexes, though you occasionally get hit by skillshots you clearly saw coming. A sip of iced Americano is advised.'
          : '준수하지만 가끔 상대 스킬을 눈으로 똑똑히 보고도 손이 굳어 맞는 나이입니다. 랭크 게임 전 아이스 아메리카노 수혈을 권장합니다.';
        rxGames = isEn
          ? '💊 Prescribed Games: League of Legends (Tank/Support), Teamfight Tactics, Helldivers 2'
          : '💊 권장 처방 게임: 롤(든든한 국밥 탱커), 전략적 팀 전투(롤체), 헬다이버즈 2';
      } else if (physicalAge <= 39) {
        ageColor = '#fb923c';
        tierText = isEn ? '🥈 SILVER (Aging Curve Detected)' : '🥈 SILVER — 에이징 커브 공식 진입';
        docComment = isEn
          ? 'Your eyes saw the target, but the signal took a scenic route to your fingers. Time to rely on big-brain macro and stream banter!'
          : '눈은 분명히 반응했는데 손가락까지 신호가 택배로 도착하고 있습니다. 이제 화려한 피지컬보다는 노련한 뇌지컬과 입담으로 승부하세요!';
        rxGames = isEn
          ? '💊 Prescribed Games: Hearthstone, Baldur’s Gate 3, Civilization, Football Manager'
          : '💊 권장 처방 게임: 하스스톤, 발더스 게이트 3, 문명, 풋볼 매니저(FM)';
      } else {
        ageColor = '#f43f5e';
        tierText = isEn ? '🦴 FOSSIL TIER (Streamers’ Retirement Home Ace)' : '🦴 전설의 화석 — 경로당 에이스 (시청자 보호 필요)';
        docComment = isEn
          ? ' Urgent medical attention required for your wrist! Viewers in chat are wiping away tears. Stick to cozy turn-based games!'
          : '스트리머 손목 보호가 시급합니다! 채팅창 시청자들도 눈물을 훔치고 있습니다. 격렬한 컨트롤 게임은 내려놓고 힐링 게임을 켜세요.';
        rxGames = isEn
          ? '💊 Prescribed Games: Stardew Valley, Animal Crossing, Minesweeper, Just Chatting'
          : '💊 권장 처방 게임: 스타듀 밸리, 동물의 숲, 천하제일 저스트 채팅, 장기·바둑';
      }

      const elAge = document.getElementById('rec-age-val');
      const elTier = document.getElementById('rec-tier-val');
      const elReact = document.getElementById('rec-react-val');
      const elReactGrade = document.getElementById('rec-react-grade');
      const elAim = document.getElementById('rec-aim-val');
      const elAimGrade = document.getElementById('rec-aim-grade');
      const elCps = document.getElementById('rec-cps-val');
      const elCpsGrade = document.getElementById('rec-cps-grade');
      const elDoc = document.getElementById('rec-doc-comment');
      const elGames = document.getElementById('rec-doc-games');

      if (elAge) {
        elAge.textContent = isEn ? `${physicalAge} yrs old` : `만 ${physicalAge}세`;
        elAge.style.color = ageColor;
      }
      if (elTier) elTier.textContent = tierText;
      if (elReact) elReact.textContent = `${avgReactMs.toFixed(1)} ms`;
      if (elReactGrade) {
        elReactGrade.textContent = avgReactMs <= 190
          ? (isEn ? 'Pro Level' : '초고속 반사신경')
          : avgReactMs <= 235
            ? (isEn ? 'Good Reflex' : '현역 준수')
            : (isEn ? 'Delayed Signal' : '신호 지연 감지');
      }
      if (elAim) elAim.textContent = isEn ? `${aimHits} Hits` : `${aimHits} 타겟`;
      if (elAimGrade) {
        elAimGrade.textContent = isEn
          ? `Acc ${aimAcc}% (${(aimHits / 12).toFixed(2)} T/s)`
          : `명중률 ${aimAcc}% (${(aimHits / 12).toFixed(2)} T/s)`;
      }
      if (elCps) elCps.textContent = `${finalCps.toFixed(1)} CPS`;
      if (elCpsGrade) {
        elCpsGrade.textContent = isEn ? `${cpsCount} taps in 5s` : `5초간 총 ${cpsCount}회 연타`;
      }
      if (elDoc) elDoc.textContent = docComment;
      if (elGames) elGames.textContent = rxGames;

      addLog(
        isEn
          ? `🧾 [DIAGNOSIS] Physical Age: ${physicalAge} (${avgReactMs.toFixed(1)}ms / ${aimHits} hits / ${finalCps.toFixed(1)} CPS)`
          : `🧾 [진단 완료] 측정된 피지컬 나이: 만 ${physicalAge}세 (${avgReactMs.toFixed(1)}ms / 에임 ${aimHits}개 / ${finalCps.toFixed(1)} CPS)`,
        'good'
      );
    }

    document.getElementById('btn-rec-retry')?.addEventListener('click', () => {
      resetReactionStage();
      updateStepper(1);
    });

    document.getElementById('btn-rec-copy')?.addEventListener('click', async () => {
      const ageTxt = document.getElementById('rec-age-val')?.textContent || '';
      const tierTxt = document.getElementById('rec-tier-val')?.textContent || '';
      const finalCps = (cpsCount / 5.0).toFixed(1);
      const aimAcc = aimClicks > 0 ? Math.round((aimHits / aimClicks) * 100) : 100;

      const text = isEn
        ? `⚡ [ErrorLedger Gamer Physical Age Report]\n• Physical Age: ${ageTxt} (${tierTxt})\n• Reaction Speed: ${avgReactMs.toFixed(1)} ms\n• 12s Aim Tracking: ${aimHits} hits (${aimAcc}% acc)\n• 5s CPS Burst: ${finalCps} CPS\nhttps://errorledger.com/en/games/reaction-test`
        : `⚡ [스트리머 피지컬 나이 공식 진단서]\n• 측정된 피지컬 나이: ${ageTxt}\n• 등급 판정: ${tierTxt}\n• 순간 반응속도: ${avgReactMs.toFixed(1)} ms\n• 12초 에임 트래킹: ${aimHits}개 명중 (명중률 ${aimAcc}%)\n• 5초 광클 연타력: ${finalCps} CPS\nhttps://errorledger.com/games/reaction-test`;

      try {
        await navigator.clipboard.writeText(text);
        const btn = document.getElementById('btn-rec-copy');
        if (btn) {
          const orig = btn.textContent;
          btn.textContent = isEn ? '✅ Copied to Clipboard!' : '✅ 클립보드에 복사되었습니다!';
          setTimeout(() => { btn.textContent = orig; }, 1600);
        }
      } catch (e) {}
    });

    // Mode Switching Tabs
    document.querySelectorAll('.rx-mode-tab').forEach((tab) => {
      tab.addEventListener('click', () => {
        document.querySelectorAll('.rx-mode-tab').forEach(t => t.classList.remove('active'));
        tab.classList.add('active');
        const mode = (tab.getAttribute('data-mode') || 'full') as TestMode;
        currentMode = mode;

        if (mode === 'full' || mode === 'react') {
          resetReactionStage();
          updateStepper(1);
        } else if (mode === 'aim') {
          prepareAimStage();
          updateStepper(2);
        } else if (mode === 'cps') {
          prepareCpsStage();
          updateStepper(3);
        }
      });
    });

    document.getElementById('btn-reset-pb')?.addEventListener('click', () => {
      pb = { bestAge: null, bestReactMs: null, bestAimHits: null, bestCps: null };
      savePb();
      renderPb();
    });

    // Utility buttons
    const btnSound = document.getElementById('btn-sound-toggle');
    if (btnSound) {
      btnSound.textContent = isMuted ? '🔇' : '🔊';
      btnSound.addEventListener('click', () => {
        isMuted = !isMuted;
        localStorage.setItem('sound-muted', String(isMuted));
        btnSound.textContent = isMuted ? '🔇' : '🔊';
      });
    }

    document.getElementById('btn-copy-obs')?.addEventListener('click', async () => {
      const u = new URL(window.location.href);
      u.searchParams.set('stream', 'true');
      try {
        await navigator.clipboard.writeText(u.href);
        addLog(isEn ? '🎥 OBS Overlay URL copied!' : '🎥 OBS 브라우저 소스 URL이 복사되었습니다!', 'good');
      } catch (e) {}
    });

    document.getElementById('btn-fullscreen')?.addEventListener('click', () => {
      if (!document.fullscreenElement) {
        document.documentElement.requestFullscreen().catch(() => {});
      } else {
        document.exitFullscreen().catch(() => {});
      }
    });

    renderPb();
    resetReactionStage();
    updateStepper(1);
  })();
</script>

