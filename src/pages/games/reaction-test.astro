---
import GameLayout from '../../layouts/GameLayout.astro';
import { getEntry } from 'astro:content';

const gameEntry = await getEntry('games', 'reaction-test');
const data = gameEntry?.data || {
  title: '스트리머 피지컬 나이 판독기 (Reaction & Age Test)',
  tagline: '반응속도(ms) · 에임 트래킹 · 광클 연타력(CPS) 3종 측정으로 팩폭 피지컬 나이 진단서 발급!',
  description: '우리 스트리머 에이징 커브 왔나요? 순간 반응속도(ms), 12초 에임 트래킹, 5초 광클 연타력(CPS) 3단계 고속 테스트를 통해 냉정한 피지컬 나이 진단서를 발급해 드립니다.',
  icon: '⚡',
  category: 'arcade',
  badge: '⚡ 피지컬 측정',
  players: '1인 / 시청자 대결',
  playTime: '45초 (고속 진단)',
  controls: [
    '1단계 [⚡ 순간 반응속도]: 빨간 화면이 초록색으로 바뀌는 순간 마우스 클릭 또는 Space (3회 평균)',
    '2단계 [🎯 에임 트래킹]: 12초 동안 랜덤 위치에 나타나는 타겟을 빠르고 정확하게 조준 클릭',
    '3단계 [🔥 광클 연타력]: 5초 동안 마우스 클릭 또는 스페이스바(Space) 연타로 최대 CPS 측정',
    '종합 코스 완주 시 [🧾 피지컬 나이 진단서] 자동 발급 및 종목별 단독 연습 모드 지원'
  ],
  rules: [
    '종합 측정 코스는 1단계(반응속도 3회) → 2단계(에임 트래킹 12초) → 3단계(광클 연타 5초) 순서로 진행됩니다.',
    '1단계에서 초록색으로 바뀌기 전에 미리 누르면 부정출발(False Start)로 판정되어 해당 라운드를 다시 측정합니다.',
    '2단계 에임 트래킹에서는 타겟 외 허공을 클릭하면 명중률(Accuracy)이 깎이므로 정확도와 속도를 모두 챙겨야 합니다.',
    '3단계 광클 연타에서는 스페이스바를 꾹 누르고 있는 오토 리핏(Key Repeat)이 차단되며, 실제 손가락 연타만 인정됩니다.'
  ],
  faqItems: [
    {
      q: '반응속도(ms) 평균 기준은 어떻게 되나요?',
      a: '일반적인 PC 모니터·마우스 환경에서 180ms 이하는 상위 1% 프로게이머급, 200~235ms는 현역 피지컬(20대 초반), 250ms 이상은 평균 게이머, 300ms 이상은 에이징 커브 구간으로 판정됩니다.'
    },
    {
      q: '한 가지 종목만 따로 연습하거나 대결할 수 있나요?',
      a: '네! 상단 모드 탭에서 [🏆 3종 종합 진단] 외에 [⚡ 반응속도만], [🎯 에임만], [🔥 광클만] 탭을 선택하면 원하는 종목만 즉시 반복 플레이할 수 있습니다.'
    },
    {
      q: '스페이스바를 꾹 누르고 있으면 연타로 인정되나요?',
      a: '아니요, 키보드 자동 반복 입력(e.repeat)은 부정행위로 자동 필터링됩니다. 실제로 키를 뗐다가 다시 누르거나 마우스를 직접 클릭해야 횟수가 올라갑니다.'
    }
  ]
};
---

<GameLayout
  title={data.title}
  description={data.description}
  tagline={data.tagline}
  icon={data.icon}
  category={data.category}
  badge={data.badge}
  players={data.players}
  playTime={data.playTime}
  controls={data.controls}
  rules={data.rules}
  faqItems={data.faqItems}
  layoutMode="full"
  hideStageHeader={true}
  hideFooter={false}
>
  <div class="rx-root" id="rx-root">
    <!-- Top Mode Selector Bar -->
    <div class="rx-mode-bar">
      <div class="rx-mode-tabs" role="tablist">
        <button type="button" class="rx-mode-tab active" data-mode="full" id="tab-mode-full">
          🏆 3종 종합 피지컬 나이 진단
        </button>
        <button type="button" class="rx-mode-tab" data-mode="react" id="tab-mode-react">
          ⚡ 반응속도 단독 (ms)
        </button>
        <button type="button" class="rx-mode-tab" data-mode="aim" id="tab-mode-aim">
          🎯 에임 트래킹 단독 (12초)
        </button>
        <button type="button" class="rx-mode-tab" data-mode="cps" id="tab-mode-cps">
          🔥 5초 광클 단독 (CPS)
        </button>
      </div>

      <div class="rx-util-btns">
        <button type="button" class="btn-rx-util" id="btn-sound-toggle" title="효과음 켜기/끄기">🔊</button>
        <button type="button" class="btn-rx-util" id="btn-copy-obs" title="OBS 브라우저 소스 URL 복사">🎥 OBS</button>
        <button type="button" class="btn-rx-util" id="btn-fullscreen" title="전체화면 전환">⛶</button>
      </div>
    </div>

    <div class="rx-main-grid">
      <!-- Left: Main Interactive Arena -->
      <section class="rx-stage-col">
        <!-- Step Progress Header -->
        <div class="rx-stepper" id="rx-stepper">
          <div class="rx-step active" id="step-ind-1">
            <span class="step-num">1</span>
            <span class="step-txt" id="ui-step1-txt">⚡ 순간 반응속도 (3회)</span>
          </div>
          <span class="step-arrow">→</span>
          <div class="rx-step" id="step-ind-2">
            <span class="step-num">2</span>
            <span class="step-txt" id="ui-step2-txt">🎯 에임 트래킹 (12초)</span>
          </div>
          <span class="step-arrow">→</span>
          <div class="rx-step" id="step-ind-3">
            <span class="step-num">3</span>
            <span class="step-txt" id="ui-step3-txt">🔥 광클 연타 (5초)</span>
          </div>
          <span class="step-arrow">→</span>
          <div class="rx-step" id="step-ind-4">
            <span class="step-num">🧾</span>
            <span class="step-txt" id="ui-step4-txt">피지컬 나이 진단서</span>
          </div>
        </div>

        <!-- Dynamic Stage Container -->
        <div class="rx-arena-card" id="rx-arena-card">
          <!-- 1. REACTION TEST PANEL -->
          <div class="rx-panel" id="panel-reaction">
            <div class="react-pad state-idle" id="react-pad" tabindex="0">
              <div class="react-top-hud">
                <span class="react-badge" id="react-round-badge">ROUND 0 / 3</span>
                <span class="react-avg-chip" id="react-avg-chip">평균: - ms</span>
              </div>

              <div class="react-center-content">
                <div class="react-big-icon" id="react-big-icon">⚡</div>
                <h2 class="react-main-title" id="react-main-title">순간 반응속도 측정</h2>
                <p class="react-sub-desc" id="react-sub-desc">
                  화면을 클릭하거나 [Space]를 누르면 시작합니다.<br />
                  <strong>빨간색 화면이 초록색으로 바뀌는 순간</strong> 가장 빠르게 클릭하세요!
                </p>
              </div>

              <div class="react-rounds-row">
                <div class="round-pill" id="r-pill-0">1차: -</div>
                <div class="round-pill" id="r-pill-1">2차: -</div>
                <div class="round-pill" id="r-pill-2">3차: -</div>
              </div>
            </div>
          </div>

          <!-- 2. AIM TRACKING PANEL -->
          <div class="rx-panel hidden" id="panel-aim">
            <div class="aim-hud-bar">
              <div class="aim-stat">
                <span id="ui-aim-time">⏱️ 남은 시간</span>
                <strong id="aim-time-val">12.0s</strong>
              </div>
              <div class="aim-stat">
                <span id="ui-aim-hits">🎯 명중 타겟</span>
                <strong id="aim-hits-val" class="text-green">0개</strong>
              </div>
              <div class="aim-stat">
                <span id="ui-aim-acc">✨ 명중률</span>
                <strong id="aim-acc-val" class="text-cyan">100%</strong>
              </div>
              <div class="aim-stat">
                <span id="ui-aim-speed">⚡ 처리 속도</span>
                <strong id="aim-tps-val" class="text-amber">0.00 T/s</strong>
              </div>
            </div>

            <div class="aim-field" id="aim-field">
              <!-- Start / Next Overlay inside Aim Field -->
              <div class="aim-overlay" id="aim-overlay">
                <div class="aim-ov-icon">🎯</div>
                <h3 class="aim-ov-title" id="aim-ov-title">2단계: 12초 순간 에임 트래킹</h3>
                <p class="aim-ov-desc" id="aim-ov-desc">
                  12초 동안 화면 곳곳에 나타나는 네온 타겟을 빠르고 정확하게 클릭하세요!<br />
                  허공을 클릭하면 명중률(Accuracy)이 감소합니다.
                </p>
                <button type="button" class="btn-stage-action" id="btn-start-aim">
                  🎯 에임 측정 시작하기 (클릭)
                </button>
              </div>

              <!-- Active Target Element -->
              <button type="button" class="aim-target hidden" id="aim-target" aria-label="Target">
                <span class="aim-ring-outer"></span>
                <span class="aim-ring-mid"></span>
                <span class="aim-ring-core"></span>
              </button>
            </div>
          </div>

          <!-- 3. CPS BURST PANEL -->
          <div class="rx-panel hidden" id="panel-cps">
            <div class="cps-hud-bar">
              <div class="aim-stat">
                <span id="ui-cps-time">⏱️ 남은 시간</span>
                <strong id="cps-time-val">5.00s</strong>
              </div>
              <div class="aim-stat">
                <span id="ui-cps-count">👆 누적 연타</span>
                <strong id="cps-count-val" class="text-green">0회</strong>
              </div>
              <div class="aim-stat">
                <span id="ui-cps-rate">🔥 초당 연타 (CPS)</span>
                <strong id="cps-rate-val" class="text-amber">0.0 CPS</strong>
              </div>
            </div>

            <div class="cps-arena">
              <button type="button" class="cps-mash-pad" id="cps-mash-pad">
                <div class="cps-pad-icon" id="cps-pad-icon">🔥</div>
                <div class="cps-pad-title" id="cps-pad-title">여기를 클릭하거나 [Space]를 미친듯이 연타하세요!</div>
                <div class="cps-pad-sub" id="cps-pad-sub">(첫 클릭/스페이스바 입력 순간 5초 타이머가 즉시 작동합니다)</div>
                <div class="cps-live-num" id="cps-live-num">0</div>
              </button>

              <div class="cps-done-actions hidden" id="cps-done-actions">
                <button type="button" class="btn-stage-action" id="btn-cps-finish">
                  🧾 최종 피지컬 나이 진단서 확인하기 →
                </button>
              </div>
            </div>
          </div>

          <!-- 4. MEDICAL PHYSICAL AGE RECEIPT PANEL -->
          <div class="rx-panel hidden" id="panel-receipt">
            <div class="receipt-wrap">
              <div class="receipt-card">
                <div class="receipt-header">
                  <span class="receipt-hospital" id="ui-rec-hospital">🏥 에러레저 e스포츠 피지컬 정밀 검진센터</span>
                  <h2 class="receipt-main-heading" id="ui-rec-heading">스트리머 피지컬 나이 공식 진단서</h2>
                </div>

                <div class="receipt-age-hero">
                  <div class="age-label" id="ui-rec-agelabel">측정된 생체 피지컬 나이</div>
                  <div class="age-big-number" id="rec-age-val">만 21세</div>
                  <div class="age-tier-pill" id="rec-tier-val">💎 DIAMOND — 현역 상위권 피지컬</div>
                </div>

                <div class="receipt-metrics-grid">
                  <div class="rec-metric-box">
                    <span class="rm-label" id="ui-rm-react">⚡ 순간 반응속도</span>
                    <strong class="rm-val" id="rec-react-val">195.4 ms</strong>
                    <span class="rm-sub" id="rec-react-grade">상위 8% (초고속)</span>
                  </div>
                  <div class="rec-metric-box">
                    <span class="rm-label" id="ui-rm-aim">🎯 에임 트래킹 (12초)</span>
                    <strong class="rm-val" id="rec-aim-val">23 타겟</strong>
                    <span class="rm-sub" id="rec-aim-grade">명중률 96% (1.92 T/s)</span>
                  </div>
                  <div class="rec-metric-box">
                    <span class="rm-label" id="ui-rm-cps">🔥 광클 연타력 (5초)</span>
                    <strong class="rm-val" id="rec-cps-val">9.2 CPS</strong>
                    <span class="rm-sub" id="rec-cps-grade">총 46회 연타</span>
                  </div>
                </div>

                <div class="receipt-doctor-box">
                  <div class="doc-title" id="ui-doc-title">👨‍⚕️ 담당의 팩폭 소견 및 추천 게임 처방</div>
                  <p class="doc-comment" id="rec-doc-comment">
                    아직 에이징 커브가 오지 않았습니다! 방송에서 피지컬 부심을 부려도 시청자들이 납득할 수 있는 준수한 반사신경을 보유하고 계십니다.
                  </p>
                  <div class="doc-rx-games" id="rec-doc-games">
                    💊 권장 처방 게임: 발로란트, 리그 오브 레전드, 배틀그라운드, 에이펙스 레전드
                  </div>
                </div>

                <div class="receipt-actions">
                  <button type="button" class="btn-rec-copy" id="btn-rec-copy">
                    📋 진단서 결과 텍스트 복사 (채팅창 공유)
                  </button>
                  <button type="button" class="btn-rec-retry" id="btn-rec-retry">
                    🔄 처음부터 재측정하기
                  </button>
                </div>
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- Right: Personal Bests, Age Benchmark Table & Session Log -->
      <aside class="rx-sidebar-col">
        <!-- Personal Bests Card -->
        <div class="rx-side-card">
          <div class="side-card-head">
            <span class="side-card-title" id="ui-pb-title">🏆 내 역대 최고 피지컬 기록</span>
            <button type="button" class="btn-reset-pb" id="btn-reset-pb" title="최고 기록 초기화">초기화</button>
          </div>
          <div class="pb-grid">
            <div class="pb-box">
              <span class="pb-k" id="ui-pb-age">최연소 피지컬 나이</span>
              <strong class="pb-v text-amber" id="pb-age-val">-</strong>
            </div>
            <div class="pb-box">
              <span class="pb-k" id="ui-pb-react">최고 반응속도 (3회 평균)</span>
              <strong class="pb-v text-green" id="pb-react-val">-</strong>
            </div>
            <div class="pb-box">
              <span class="pb-k" id="ui-pb-aim">최고 에임 (12초)</span>
              <strong class="pb-v text-cyan" id="pb-aim-val">-</strong>
            </div>
            <div class="pb-box">
              <span class="pb-k" id="ui-pb-cps">최고 광클 (CPS)</span>
              <strong class="pb-v text-pink" id="pb-cps-val">-</strong>
            </div>
          </div>
        </div>

        <!-- Age Tier Benchmark Table -->
        <div class="rx-side-card">
          <div class="side-card-head">
            <span class="side-card-title" id="ui-bench-title">📊 피지컬 나이 등급 판정 기준표</span>
          </div>
          <table class="bench-table">
            <thead>
              <tr>
                <th id="th-age">피지컬 나이</th>
                <th id="th-react">반응속도</th>
                <th id="th-tier">티어 판정</th>
              </tr>
            </thead>
            <tbody>
              <tr>
                <td><strong class="text-green">16 ~ 19세</strong></td>
                <td>≤ 185 ms</td>
                <td>🏆 프로게이머급 (0.5%)</td>
              </tr>
              <tr>
                <td><strong class="text-cyan">20 ~ 24세</strong></td>
                <td>186 ~ 215 ms</td>
                <td>💎 현역 피지컬 (상위권)</td>
              </tr>
              <tr>
                <td><strong class="text-amber">25 ~ 29세</strong></td>
                <td>216 ~ 245 ms</td>
                <td>🥇 평균 게이머</td>
              </tr>
              <tr>
                <td><strong style="color:#fb923c">30 ~ 39세</strong></td>
                <td>246 ~ 285 ms</td>
                <td>🥈 에이징 커브 진입</td>
              </tr>
              <tr>
                <td><strong style="color:#f43f5e">40 ~ 49세</strong></td>
                <td>286 ~ 340 ms</td>
                <td>🥉 입담·훈수형 스트리머</td>
              </tr>
              <tr>
                <td><strong style="color:#94a3b8">50세 이상</strong></td>
                <td>341 ms +</td>
                <td>🦴 전설의 화석 (보호 대상)</td>
              </tr>
            </tbody>
          </table>
        </div>

        <!-- Live Session Log -->
        <div class="rx-side-card">
          <div class="side-card-head">
            <span class="side-card-title" id="ui-log-title">📜 실시간 측정 기록</span>
          </div>
          <div class="rx-log-list" id="rx-log-list">
            <div class="rx-log-item info">⚡ 피지컬 나이 판독기가 준비되었습니다. 측정을 시작하세요!</div>
          </div>
        </div>
      </aside>
    </div>
  </div>
</GameLayout>

<style>
  .rx-root {
    width: 100%;
    max-width: 1280px;
    margin: 0 auto;
    padding: 0.5rem 1rem 2rem;
    box-sizing: border-box;
    font-family: 'Pretendard', -apple-system, BlinkMacSystemFont, system-ui, sans-serif;
    color: #f8fafc;
  }

  /* Mode Bar */
  .rx-mode-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 0.6rem;
    margin-bottom: 0.85rem;
    background: #0f172a;
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 12px;
    padding: 0.5rem 0.75rem;
  }

  .rx-mode-tabs {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }

  .rx-mode-tab {
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.1);
    color: #94a3b8;
    font-size: 0.8rem;
    font-weight: 800;
    padding: 0.45rem 0.85rem;
    border-radius: 8px;
    cursor: pointer;
    transition: all 0.15s;
  }

  .rx-mode-tab:hover {
    color: #f8fafc;
    background: rgba(255, 255, 255, 0.09);
  }

  .rx-mode-tab.active {
    background: linear-gradient(135deg, rgba(0, 255, 163, 0.18) 0%, rgba(56, 189, 248, 0.18) 100%);
    border-color: #00ffa3;
    color: #ffffff;
  }

  .rx-util-btns {
    display: flex;
    gap: 0.35rem;
  }

  .btn-rx-util {
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid rgba(255, 255, 255, 0.12);
    color: #e2e8f0;
