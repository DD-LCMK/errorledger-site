---
import GameLayout from '../../layouts/GameLayout.astro';
import { getEntry } from 'astro:content';

const gameEntry = await getEntry('games', 'block-blast');
const data = gameEntry?.data || {
  title: '블록 블라스트 (Block Blast!)',
  tagline: '8×8 보드에 블록을 맞춰 가로·세로 라인을 터뜨리는 최고의 중독성 두뇌 퍼즐',
  description: '국내외 인기 1위 모바일 퍼즐을 무설치 웹으로 바로 플레이하세요! 8×8 보드판에 무작위로 주어지는 블록을 배치하여 가로·세로 줄을 빈틈없이 채우면 시원하게 폭파(블라스트)됩니다. 연속 콤보를 이어가며 최고 점수에 도전해보세요.',
  icon: '🧩',
  category: 'arcade',
  badge: '🔥 1위 퍼즐 블라스트',
  players: '1인 (스코어 랭킹)',
  playTime: '3분~15분',
  controls: [
    '하단에 제시된 3개의 블록 중 원하는 블록을 마우스 또는 터치로 드래그',
    '8×8 보드판의 비어있는 공간으로 끌고 가 원하는 위치에 드롭하여 배치',
    '모바일 화면에서는 손가락에 가려지지 않도록 터치 포인트 위쪽으로 자연스럽게 블록이 떠오릅니다',
    'R 키 또는 재도전 버튼을 눌러 언제든지 처음부터 다시 시작 가능'
  ],
  rules: [
    '주어진 블록은 회전할 수 없으며, 형태 그대로 보드에 배치해야 합니다.',
    '가로나 세로 한 줄(8칸)을 빈틈없이 모두 채우면 해당 라인이 즉시 폭파(블라스트)되며 점수를 획득합니다.',
    '가로와 세로 줄이 동시에 완성되면 다중 라인 폭파 보너스 점수가 부여됩니다.',
    '블록을 배치할 때마다 연속으로 줄을 지우면 콤보(Combo)가 발동하여 점수가 기하급수적으로 폭증합니다.',
    '하단에 주어진 3개의 블록을 모두 사용해야 다음 3개의 블록이 새롭게 지급됩니다.',
    '하단에 남은 블록을 보드판의 빈 공간 어디에도 더 이상 끼워 넣을 수 없으면 게임 오버가 됩니다.'
  ],
  faqItems: [
    {
      q: '블록을 회전시킬 수는 없나요?',
      a: '블록 블라스트의 정통 규칙상 블록 회전은 불가능합니다! 회전이 불가능한 상태에서 3개의 블록 형태를 보고 보드의 여유 공간을 계산하며 배치하는 것이 핵심 재미입니다.'
    },
    {
      q: '새 블록 3개는 언제 다시 나오나요?',
      a: '하단에 제시된 3개의 블록을 보드에 모두 올려놓는 순간, 즉시 다음 세트 3개의 블록이 새롭게 리필됩니다.'
    },
    {
      q: '콤보는 어떻게 유지되나요?',
      a: '블록을 배치했을 때 최소 1줄 이상 라인이 지워지면 콤보 카운트가 1씩 올라갑니다. 블록을 놓았는데 아무 줄도 지워지지 않으면 콤보가 초기화됩니다.'
    },
    {
      q: 'OBS 방송 화면에 배경 없이 게임만 띄울 수 있나요?',
      a: "주소 뒤에 '?bare=1' 또는 '?stream=true'를 추가하면 헤더와 푸터가 숨겨진 깔끔한 스트리머 방송 전용 모드로 실행됩니다."
    }
  ]
};
---

<GameLayout
  title={data.title}
  description={data.description}
  tagline={data.tagline}
  icon={data.icon}
  category={data.category}
  badge={data.badge}
  players={data.players}
  playTime={data.playTime}
  controls={data.controls}
  rules={data.rules}
  faqItems={data.faqItems}
  layoutMode="full"
  hideStageHeader={true}
  hideFooter={false}
>
  <div class="blast-game-root" id="blast-game-root">
    <!-- Ambient Dynamic Background Glows -->
    <div class="blast-bg-glow glow-top"></div>
    <div class="blast-bg-glow glow-bottom"></div>

    <div class="blast-main-wrapper">
      <!-- Top Arcade Header & Stats -->
      <header class="blast-header">
        <div class="header-brand-group">
          <a href="/games" class="blast-back-btn" title="전체 게임 목록으로">←</a>
          <div class="brand-title-wrap">
            <span class="brand-icon">🧩</span>
            <div class="brand-text">
              <h1 class="brand-title">BLOCK BLAST!</h1>
              <span class="brand-subtitle">8×8 무한 콤보 퍼즐</span>
            </div>
          </div>
        </div>

        <!-- Scoreboard Stats -->
        <div class="header-stats-row">
          <div class="stat-pill score-pill">
            <span class="stat-label">SCORE</span>
            <span class="stat-value" id="current-score">0</span>
          </div>
          <div class="stat-pill best-pill">
            <span class="stat-label">BEST 🏆</span>
            <span class="stat-value" id="best-score">0</span>
          </div>
          <div class="header-actions">
            <button id="btn-sound" class="icon-tool-btn" title="소리 토글" aria-label="소리 토글">🔊</button>
            <button id="btn-restart" class="icon-tool-btn" title="다시 시작" aria-label="다시 시작">🔄</button>
          </div>
        </div>
      </header>

      <!-- Game Mode Switcher -->
      <div class="mode-select-bar">
        <button id="mode-btn-infinite" class="mode-tab-btn active" data-mode="infinite">
          <span class="mode-tab-icon">♾️</span> 무한 클래식
        </button>
        <button id="mode-btn-timed" class="mode-tab-btn" data-mode="timed">
          <span class="mode-tab-icon">⏱️</span> 타임어택 (2분)
        </button>
      </div>

      <!-- Timed Mode Status Bar -->
      <div class="timed-status-card hidden" id="timed-status-card">
        <div class="timed-info-row">
          <span class="timed-label">⏱️ 남은 시간</span>
          <span class="timed-clock" id="timed-clock">02:00</span>
        </div>
        <div class="timed-track">
          <div class="timed-fill" id="timed-fill" style="width: 100%;"></div>
        </div>
      </div>

      <!-- Dynamic Combo Streak Banner -->
      <div class="combo-announcer-area">
        <div class="combo-badge hidden" id="combo-badge">
          <span class="combo-flame">🔥</span>
          <span class="combo-text" id="combo-text">COMBO x2</span>
          <span class="combo-sub" id="combo-sub">EXCELLENT!</span>
        </div>
      </div>

      <!-- Main 8x8 Board Arena -->
      <div class="board-arena" id="board-arena">
        <div class="board-wrapper" id="board-wrapper">
          <!-- 8x8 Board Grid (64 Cells) -->
          <div class="board-grid" id="board-grid">
            {Array.from({ length: 64 }).map((_, i) => (
              <div class="grid-cell" data-r={Math.floor(i / 8)} data-c={i % 8}></div>
            ))}
          </div>

          <!-- FX Overlay Canvas for Particle Explosions -->
          <canvas id="fx-canvas" class="fx-canvas"></canvas>

          <!-- Floating Blast Text Layer -->
          <div id="float-text-layer" class="float-text-layer"></div>
        </div>
      </div>

      <!-- Bottom Piece Dock (3 Slots) -->
      <footer class="dock-container" id="dock-container">
        <div class="dock-slot" id="dock-slot-0" data-slot="0"></div>
        <div class="dock-slot" id="dock-slot-1" data-slot="1"></div>
        <div class="dock-slot" id="dock-slot-2" data-slot="2"></div>
      </footer>
    </div>

    <!-- Active Drag Floating Proxy (Follows Pointer) -->
    <div id="drag-proxy" class="drag-proxy hidden"></div>

    <!-- Game Over Modal -->
    <div class="blast-modal-overlay hidden" id="game-over-modal">
      <div class="blast-modal-card">
        <div class="modal-crown" id="modal-crown">💥</div>
        <h2 class="modal-title" id="modal-title">GAME OVER</h2>
        <p class="modal-subtitle" id="modal-subtitle">더 이상 블록을 놓을 수 있는 자리가 없습니다!</p>

        <div class="modal-metrics-grid">
          <div class="modal-metric">
            <span class="m-label">최종 점수</span>
            <span class="m-val highlight" id="modal-final-score">0</span>
          </div>
          <div class="modal-metric">
            <span class="m-label">최고 기록</span>
            <span class="m-val" id="modal-best-score">0</span>
          </div>
          <div class="modal-metric">
            <span class="m-label">최대 콤보</span>
            <span class="m-val highlight-amber" id="modal-max-combo">0x</span>
          </div>
          <div class="modal-metric">
            <span class="m-label">폭파한 라인</span>
            <span class="m-val" id="modal-total-lines">0줄</span>
          </div>
        </div>

        <div class="modal-actions">
          <button id="modal-btn-replay" class="modal-btn primary">
            <span>🔄 다시 도전</span>
          </button>
          <button id="modal-btn-share" class="modal-btn secondary">
            <span>📋 결과 복사</span>
          </button>
        </div>
      </div>
    </div>

    <!-- Toast Notification -->
    <div id="blast-toast" class="blast-toast"></div>
  </div>
</GameLayout>

<style is:global>
  :root {
    --blast-bg: #070a13;
    --blast-panel-bg: rgba(15, 23, 42, 0.75);
    --blast-grid-bg: #0d1322;
    --blast-cell-empty: #141c30;
    --blast-cell-border: rgba(255, 255, 255, 0.05);
    
    /* Vibrant Color Theme Definitions */
    --color-1: #06b6d4; /* Cyan */
    --color-1-light: #67e8f9;
    --color-2: #10b981; /* Emerald */
    --color-2-light: #6ee7b7;
    --color-3: #3b82f6; /* Electric Blue */
    --color-3-light: #93c5fd;
    --color-4: #f59e0b; /* Amber / Orange */
    --color-4-light: #fde68a;
    --color-5: #f43f5e; /* Crimson */
    --color-5-light: #fda4af;
    --color-6: #8b5cf6; /* Purple */
    --color-6-light: #c4b5fd;
    --color-7: #ec4899; /* Pink */
    --color-7-light: #f9a8d4;
    --color-8: #eab308; /* Sunny Gold */
    --color-8-light: #fef08a;
  }

  .blast-game-root {
    position: relative;
    width: 100%;
    min-height: calc(100vh - 70px);
    background: var(--blast-bg);
    color: #e2e8f0;
    overflow: hidden;
    user-select: none;
    -webkit-user-select: none;
    touch-action: none;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: flex-start;
    padding: 0.75rem 0.5rem 1.5rem;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Pretendard", sans-serif;
  }

  /* Ambient Glows */
  .blast-bg-glow {
    position: absolute;
    width: 500px;
    height: 500px;
    border-radius: 50%;
    filter: blur(120px);
    pointer-events: none;
    opacity: 0.22;
    z-index: 0;
  }
  .glow-top {
    top: -100px;
    background: radial-gradient(circle, #3b82f6, #8b5cf6);
  }
  .glow-bottom {
    bottom: -100px;
    background: radial-gradient(circle, #ec4899, #f59e0b);
  }

  .blast-main-wrapper {
    position: relative;
    z-index: 1;
    width: 100%;
    max-width: 480px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
    margin: 0 auto;
  }

  /* Header */
  .blast-header {
    width: 100%;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    background: var(--blast-panel-bg);
    backdrop-filter: blur(12px);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 16px;
    padding: 0.75rem 1rem;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.4);
  }

  .header-brand-group {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }
  .blast-back-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 34px;
    height: 34px;
    border-radius: 10px;
    background: rgba(255, 255, 255, 0.07);
    color: #94a3b8;
    text-decoration: none;
    font-size: 1.1rem;
    font-weight: bold;
    transition: all 0.2s ease;
  }
  .blast-back-btn:hover {
    background: rgba(255, 255, 255, 0.15);
    color: #fff;
    transform: translateX(-2px);
  }
  .brand-title-wrap {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }
  .brand-icon {
    font-size: 1.5rem;
    animation: iconBob 3s ease-in-out infinite alternate;
  }
  @keyframes iconBob {
    0% { transform: translateY(0) rotate(0deg); }
    100% { transform: translateY(-3px) rotate(5deg); }
  }
  .brand-title {
    margin: 0;
    font-size: 1.15rem;
    font-weight: 900;
    letter-spacing: 0.05em;
    background: linear-gradient(135deg, #60a5fa, #c084fc, #f472b6);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }
  .brand-subtitle {
    font-size: 0.72rem;
    color: #94a3b8;
    font-weight: 500;
  }

  .header-stats-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
  }
  .stat-pill {
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    background: rgba(10, 15, 29, 0.85);
    border: 1px solid rgba(255, 255, 255, 0.06);
    border-radius: 10px;
    padding: 0.35rem 0.5rem;
    min-height: 48px;
  }
  .stat-label {
    font-size: 0.65rem;
    font-weight: 700;
    color: #64748b;
    letter-spacing: 0.05em;
  }
  .score-pill .stat-label {
    color: #38bdf8;
  }
  .best-pill .stat-label {
    color: #fbbf24;
  }
  .stat-value {
    font-size: 1.25rem;
    font-weight: 800;
    font-family: monospace, sans-serif;
    color: #f8fafc;
    line-height: 1.1;
  }
  .stat-value.score-bump {
    animation: scoreBump 0.25s cubic-bezier(0.175, 0.885, 0.32, 1.275);
  }
  @keyframes scoreBump {
    0% { transform: scale(1); }
    50% { transform: scale(1.22); color: #38bdf8; }
    100% { transform: scale(1); }
  }

  .header-actions {
    display: flex;
    gap: 0.35rem;
  }
  .icon-tool-btn {
    width: 38px;
    height: 48px;
    border-radius: 10px;
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid rgba(255, 255, 255, 0.08);
    color: #e2e8f0;
    font-size: 1.1rem;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all 0.15s ease;
  }
  .icon-tool-btn:hover {
    background: rgba(255, 255, 255, 0.12);
    transform: translateY(-1px);
  }
  .icon-tool-btn:active {
    transform: translateY(1px);
  }

  /* Mode Selector Bar */
  .mode-select-bar {
    width: 100%;
    display: flex;
    gap: 0.5rem;
    background: rgba(10, 15, 29, 0.7);
    border: 1px solid rgba(255, 255, 255, 0.07);
    border-radius: 12px;
    padding: 4px;
    box-sizing: border-box;
  }
  .mode-tab-btn {
    flex: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.4rem;
    padding: 0.45rem 0.6rem;
    border-radius: 8px;
    background: transparent;
    border: none;
    color: #94a3b8;
    font-size: 0.82rem;
    font-weight: 700;
    cursor: pointer;
    transition: all 0.2s ease;
  }
  .mode-tab-btn:hover {
    color: #f1f5f9;
    background: rgba(255, 255, 255, 0.05);
  }
  .mode-tab-btn.active {
    background: linear-gradient(135deg, rgba(59, 130, 246, 0.3), rgba(139, 92, 246, 0.3));
    border: 1px solid rgba(139, 92, 246, 0.6);
    color: #ffffff;
    box-shadow: 0 2px 10px rgba(99, 102, 241, 0.25);
  }
  .mode-tab-icon {
    font-size: 0.95rem;
  }

  /* Timed Mode Status Card */
  .timed-status-card {
    width: 100%;
    background: rgba(15, 23, 42, 0.85);
    border: 1px solid rgba(245, 158, 11, 0.4);
    border-radius: 12px;
    padding: 0.5rem 0.75rem;
    box-sizing: border-box;
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    animation: fadeInSlide 0.25s ease;
    box-shadow: 0 4px 15px rgba(245, 158, 11, 0.15);
  }
  @keyframes fadeInSlide {
    0% { opacity: 0; transform: translateY(-4px); }
    100% { opacity: 1; transform: translateY(0); }
  }
  .timed-info-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }
  .timed-label {
    font-size: 0.75rem;
    font-weight: 700;
    color: #fbbf24;
    display: flex;
    align-items: center;
    gap: 0.3rem;
  }
  .timed-clock {
    font-size: 1.15rem;
    font-weight: 800;
    font-family: monospace, sans-serif;
    color: #f8fafc;
    letter-spacing: 0.05em;
    transition: color 0.2s ease;
  }
  .timed-clock.danger {
    color: #ef4444;
    animation: clockPulse 0.5s ease-in-out infinite alternate;
  }
  @keyframes clockPulse {
    0% { transform: scale(1); }
    100% { transform: scale(1.1); text-shadow: 0 0 10px rgba(239, 68, 68, 0.8); }
  }
  .timed-track {
    width: 100%;
    height: 7px;
    background: rgba(0, 0, 0, 0.4);
    border-radius: 9999px;
    overflow: hidden;
    border: 1px solid rgba(255, 255, 255, 0.05);
  }
  .timed-fill {
    height: 100%;
    background: linear-gradient(90deg, #10b981, #f59e0b);
    border-radius: 9999px;
    transition: width 0.3s ease, background 0.3s ease;
  }
  .timed-fill.danger {
    background: linear-gradient(90deg, #f59e0b, #ef4444);
  }

  /* Combo Announcer Area */
  .combo-announcer-area {
    min-height: 38px;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
  }
  .combo-badge {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.3rem 0.9rem;
    background: linear-gradient(135deg, rgba(239, 68, 68, 0.25), rgba(245, 158, 11, 0.25));
    border: 1px solid rgba(245, 158, 11, 0.45);
    border-radius: 9999px;
    box-shadow: 0 0 20px rgba(245, 158, 11, 0.3);
    animation: comboPulse 0.6s cubic-bezier(0.175, 0.885, 0.32, 1.275);
  }
  @keyframes comboPulse {
    0% { transform: scale(0.6); opacity: 0; }
    60% { transform: scale(1.15); opacity: 1; }
    100% { transform: scale(1); }
  }
  .combo-flame {
    font-size: 1.1rem;
  }
  .combo-text {
    font-size: 0.9rem;
    font-weight: 800;
    color: #fbbf24;
    letter-spacing: 0.05em;
  }
  .combo-sub {
    font-size: 0.75rem;
    font-weight: 700;
    color: #f97316;
  }

  /* Board Arena */
  .board-arena {
    width: 100%;
    display: flex;
    justify-content: center;
    align-items: center;
  }
  .board-wrapper {
    position: relative;
    width: 100%;
    max-width: 440px;
    aspect-ratio: 1 / 1;
    background: var(--blast-grid-bg);
    border: 2px solid rgba(255, 255, 255, 0.08);
    border-radius: 18px;
    padding: 8px;
    box-shadow: 0 20px 45px rgba(0, 0, 0, 0.5), inset 0 0 20px rgba(0, 0, 0, 0.6);
    box-sizing: border-box;
  }

  .board-grid {
    display: grid;
    grid-template-columns: repeat(8, 1fr);
    grid-template-rows: repeat(8, 1fr);
    gap: 4px;
    width: 100%;
    height: 100%;
  }

