<script>
  // ─── Procedural Web Audio API Synthesizer ─────────────────────────────────
  class BlastAudio {
    private ctx: AudioContext | null = null;
    public muted: boolean = false;

    constructor() {
      const saved = localStorage.getItem('errorledger_block_blast_muted');
      this.muted = saved === 'true';
    }

    private init(): AudioContext | null {
      if (!this.ctx) {
        const AudioClass = window.AudioContext || (window as any).webkitAudioContext;
        if (AudioClass) {
          this.ctx = new AudioClass();
        }
      }
      if (this.ctx && this.ctx.state === 'suspended') {
        this.ctx.resume();
      }
      return this.ctx;
    }

    public toggleMute(): boolean {
      this.muted = !this.muted;
      localStorage.setItem('errorledger_block_blast_muted', String(this.muted));
      return this.muted;
    }

    // Pickup Sound (Pleasant pop)
    public playPickup() {
      if (this.muted) return;
      const ctx = this.init();
      if (!ctx) return;
      const osc = ctx.createOscillator();
      const gain = ctx.createGain();
      const now = ctx.currentTime;
      osc.type = 'sine';
      osc.frequency.setValueAtTime(320, now);
      osc.frequency.exponentialRampToValueAtTime(560, now + 0.08);

      gain.gain.setValueAtTime(0.14, now);
      gain.gain.exponentialRampToValueAtTime(0.001, now + 0.08);

      osc.connect(gain);
      gain.connect(ctx.destination);
      osc.start(now);
      osc.stop(now + 0.08);
    }

    // Drop / Snap Sound
    public playDrop() {
      if (this.muted) return;
      const ctx = this.init();
      if (!ctx) return;
      const now = ctx.currentTime;
      const osc = ctx.createOscillator();
      const gain = ctx.createGain();

      osc.type = 'triangle';
      osc.frequency.setValueAtTime(380, now);
      osc.frequency.exponentialRampToValueAtTime(140, now + 0.09);

      gain.gain.setValueAtTime(0.25, now);
      gain.gain.exponentialRampToValueAtTime(0.001, now + 0.09);

      osc.connect(gain);
      gain.connect(ctx.destination);
      osc.start(now);
      osc.stop(now + 0.09);
    }

    // Blast Line Clear with Rising Combo Scale
    public playClear(combo: number, lines: number) {
      if (this.muted) return;
      const ctx = this.init();
      if (!ctx) return;
      const now = ctx.currentTime;

      // Pentatonic rising scale (C, D, E, G, A, C, D, E...)
      const scale = [523.25, 587.33, 659.25, 783.99, 880.00, 1046.50, 1174.66, 1318.51, 1567.98];
      const noteIdx = Math.min(combo - 1, scale.length - 1);
      const baseFreq = scale[Math.max(0, noteIdx)];

      // Primary Chime
      const osc1 = ctx.createOscillator();
      const gain1 = ctx.createGain();
      osc1.type = 'sine';
      osc1.frequency.setValueAtTime(baseFreq, now);

      gain1.gain.setValueAtTime(0.28, now);
      gain1.gain.exponentialRampToValueAtTime(0.001, now + 0.45);

      osc1.connect(gain1);
      gain1.connect(ctx.destination);
      osc1.start(now);
      osc1.stop(now + 0.45);

      // Harmony note for combos or multi-line clears
      if (lines > 1 || combo > 1) {
        const osc2 = ctx.createOscillator();
        const gain2 = ctx.createGain();
        osc2.type = 'triangle';
        osc2.frequency.setValueAtTime(baseFreq * 1.5, now + 0.04);

        gain2.gain.setValueAtTime(0.18, now + 0.04);
        gain2.gain.exponentialRampToValueAtTime(0.001, now + 0.5);

        osc2.connect(gain2);
        gain2.connect(ctx.destination);
        osc2.start(now + 0.04);
        osc2.stop(now + 0.5);
      }
    }

    // Time Bonus Chime (Pleasant rising ding-ding)
    public playTimeBonus() {
      if (this.muted) return;
      const ctx = this.init();
      if (!ctx) return;
      const now = ctx.currentTime;
      const osc = ctx.createOscillator();
      const gain = ctx.createGain();
      osc.type = 'triangle';
      osc.frequency.setValueAtTime(659.25, now); // E5
      osc.frequency.setValueAtTime(880.00, now + 0.08); // A5
      gain.gain.setValueAtTime(0.22, now);
      gain.gain.exponentialRampToValueAtTime(0.001, now + 0.3);
      osc.connect(gain);
      gain.connect(ctx.destination);
      osc.start(now);
      osc.stop(now + 0.3);
    }

    // Game Over Cadence
    public playGameOver() {
      if (this.muted) return;
      const ctx = this.init();
      if (!ctx) return;
      const now = ctx.currentTime;
      const freqs = [440, 370, 293.66];
      freqs.forEach((f, i) => {
        const osc = ctx.createOscillator();
        const gain = ctx.createGain();
        const t = now + i * 0.16;
        osc.type = 'sine';
        osc.frequency.setValueAtTime(f, t);
        gain.gain.setValueAtTime(0.2, t);
        gain.gain.exponentialRampToValueAtTime(0.001, t + 0.25);
        osc.connect(gain);
        gain.connect(ctx.destination);
        osc.start(t);
        osc.stop(t + 0.25);
      });
    }

    public playClick() {
      if (this.muted) return;
      const ctx = this.init();
      if (!ctx) return;
      const now = ctx.currentTime;
      const osc = ctx.createOscillator();
      const gain = ctx.createGain();
      osc.type = 'sine';
      osc.frequency.setValueAtTime(600, now);
      gain.gain.setValueAtTime(0.08, now);
      gain.gain.exponentialRampToValueAtTime(0.001, now + 0.05);
      osc.connect(gain);
      gain.connect(ctx.destination);
      osc.start(now);
      osc.stop(now + 0.05);
    }
  }

  // ─── Shape Definitions (24 Canonical Polyomino Shapes) ─────────────────────
  interface ShapeDef {
    matrix: number[][];
    color: number;
    weight: number;
  }

  const SHAPES: ShapeDef[] = [
    // 1x1 Single
    { matrix: [[1]], color: 1, weight: 6 },
    // 2-blocks
    { matrix: [[1, 1]], color: 2, weight: 10 },
    { matrix: [[1], [1]], color: 2, weight: 10 },
    // 3-blocks (h/v line)
    { matrix: [[1, 1, 1]], color: 3, weight: 10 },
    { matrix: [[1], [1], [1]], color: 3, weight: 10 },
    // 2x2 corner (3 blocks)
    { matrix: [[1, 1], [1, 0]], color: 4, weight: 8 },
    { matrix: [[1, 1], [0, 1]], color: 4, weight: 8 },
    { matrix: [[1, 0], [1, 1]], color: 4, weight: 8 },
    { matrix: [[0, 1], [1, 1]], color: 4, weight: 8 },
    // 2x2 Square (4 blocks)
    { matrix: [[1, 1], [1, 1]], color: 5, weight: 10 },
    // 4-blocks line
    { matrix: [[1, 1, 1, 1]], color: 6, weight: 8 },
    { matrix: [[1], [1], [1], [1]], color: 6, weight: 8 },
    // T-shapes
    { matrix: [[0, 1, 0], [1, 1, 1]], color: 7, weight: 7 },
    { matrix: [[1, 1, 1], [0, 1, 0]], color: 7, weight: 7 },
    { matrix: [[1, 0], [1, 1], [1, 0]], color: 7, weight: 7 },
    { matrix: [[0, 1], [1, 1], [0, 1]], color: 7, weight: 7 },
    // L-shapes 3x2
    { matrix: [[1, 0], [1, 0], [1, 1]], color: 8, weight: 7 },
    { matrix: [[0, 1], [0, 1], [1, 1]], color: 8, weight: 7 },
    { matrix: [[1, 1], [1, 0], [1, 0]], color: 8, weight: 7 },
    { matrix: [[1, 1], [0, 1], [0, 1]], color: 8, weight: 7 },
    // 3x3 big corner
    { matrix: [[1, 1, 1], [1, 0, 0], [1, 0, 0]], color: 1, weight: 4 },
    { matrix: [[1, 1, 1], [0, 0, 1], [0, 0, 1]], color: 1, weight: 4 },
    { matrix: [[1, 0, 0], [1, 0, 0], [1, 1, 1]], color: 1, weight: 4 },
    { matrix: [[0, 0, 1], [0, 0, 1], [1, 1, 1]], color: 1, weight: 4 },
    // 5-block line
    { matrix: [[1, 1, 1, 1, 1]], color: 3, weight: 4 },
    { matrix: [[1], [1], [1], [1], [1]], color: 3, weight: 4 },
    // 3x3 giant square
    { matrix: [[1, 1, 1], [1, 1, 1], [1, 1, 1]], color: 5, weight: 3 },
  ];

  // ─── Particle System for Line Clears ──────────────────────────────────────
  interface Particle {
    x: number;
    y: number;
    vx: number;
    vy: number;
    size: number;
    color: string;
    alpha: number;
    life: number;
    maxLife: number;
  }

  const COLOR_MAP: Record<number, string> = {
    1: '#06b6d4',
    2: '#10b981',
    3: '#3b82f6',
    4: '#f59e0b',
    5: '#f43f5e',
    6: '#8b5cf6',
    7: '#ec4899',
    8: '#eab308'
  };

  class ParticleEngine {
    private canvas: HTMLCanvasElement;
    private ctx: CanvasRenderingContext2D;
    private particles: Particle[] = [];
    private animationId: number | null = null;

    constructor(canvas: HTMLCanvasElement) {
      this.canvas = canvas;
      this.ctx = canvas.getContext('2d')!;
      this.resize();
      window.addEventListener('resize', () => this.resize());
    }

    public resize() {
      const rect = this.canvas.getBoundingClientRect();
      const dpr = window.devicePixelRatio || 1;
      this.canvas.width = (rect.width || 400) * dpr;
      this.canvas.height = (rect.height || 400) * dpr;
      this.ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
    }

    public spawnBlast(cellX: number, cellY: number, cellSize: number, colorId: number) {
      const color = COLOR_MAP[colorId] || '#38bdf8';
      const count = 14;
      for (let i = 0; i < count; i++) {
        const angle = Math.random() * Math.PI * 2;
        const speed = 1.5 + Math.random() * 4.5;
        this.particles.push({
          x: cellX + cellSize / 2,
          y: cellY + cellSize / 2,
          vx: Math.cos(angle) * speed,
          vy: Math.sin(angle) * speed - 1.2,
          size: 3 + Math.random() * 5,
          color,
          alpha: 1,
          life: 0,
          maxLife: 28 + Math.floor(Math.random() * 20)
        });
      }
      this.startLoop();
    }

    private startLoop() {
      if (this.animationId === null) {
        this.tick();
      }
    }

    private tick = () => {
      if (this.particles.length === 0) {
        this.animationId = null;
        this.ctx.clearRect(0, 0, this.canvas.width, this.canvas.height);
        return;
      }

      const rect = this.canvas.getBoundingClientRect();
      this.ctx.clearRect(0, 0, rect.width, rect.height);

      for (let i = this.particles.length - 1; i >= 0; i--) {
        const p = this.particles[i];
        p.life++;
        p.x += p.vx;
        p.y += p.vy;
        p.vy += 0.12; // Gravity
        p.vx *= 0.98;
        p.alpha = Math.max(0, 1 - (p.life / p.maxLife));

        this.ctx.save();
        this.ctx.globalAlpha = p.alpha;
        this.ctx.fillStyle = p.color;
        this.ctx.shadowColor = p.color;
        this.ctx.shadowBlur = 6;
        this.ctx.beginPath();
        this.ctx.arc(p.x, p.y, p.size / 2, 0, Math.PI * 2);
        this.ctx.fill();
        this.ctx.restore();

        if (p.life >= p.maxLife) {
          this.particles.splice(i, 1);
        }
      }

      this.animationId = requestAnimationFrame(this.tick);
    };
  }

  // ─── Main Block Blast Game Engine ──────────────────────────────────────────
  type GameMode = 'infinite' | 'timed';

  class BlockBlastGame {
    private mode: GameMode = 'infinite';
    private board: number[][] = Array.from({ length: 8 }, () => Array(8).fill(0));
    private dockPieces: (ShapeDef | null)[] = [null, null, null];
    private score: number = 0;
    private bestScore: number = 0;
    private combo: number = 0;
    private maxCombo: number = 0;
    private totalLinesCleared: number = 0;

    // Timed Mode State
    private timeLeft: number = 120;
    private maxTime: number = 120;
    private timerInterval: number | null = null;

    // Transition & Animation Guard State
    private isClearing: boolean = false;
    private gameOverTimeout: number | null = null;

    // Elements
    private boardGridEl: HTMLElement;
    private boardWrapperEl: HTMLElement;
    private dockSlotsEl: HTMLElement[];
    private currentScoreEl: HTMLElement;
    private bestScoreEl: HTMLElement;
    private comboBadgeEl: HTMLElement;
    private comboTextEl: HTMLElement;
    private comboSubEl: HTMLElement;
    private dragProxyEl: HTMLElement;
    private floatTextLayerEl: HTMLElement;
    private modalEl: HTMLElement;
    private toastEl: HTMLElement;

    // Mode & Timed Status Elements
    private modeInfiniteBtn: HTMLButtonElement | null = null;
    private modeTimedBtn: HTMLButtonElement | null = null;
    private timedStatusCardEl: HTMLElement | null = null;
    private timedClockEl: HTMLElement | null = null;
    private timedFillEl: HTMLElement | null = null;
    private modalCrownEl: HTMLElement | null = null;
    private modalTitleEl: HTMLElement | null = null;
    private modalSubtitleEl: HTMLElement | null = null;

    // Systems
    private audio: BlastAudio;
    private particles: ParticleEngine;

    // Drag State
    private isDragging: boolean = false;
    private activeSlot: number | null = null;
    private activeShape: ShapeDef | null = null;
    private dragPointerId: number | null = null;
    private touchOffsetY: number = 0;
    private lastHoverCell: { r: number; c: number } | null = null;

    constructor() {
      this.boardGridEl = document.getElementById('board-grid')!;
      this.boardWrapperEl = document.getElementById('board-wrapper')!;
      this.dockSlotsEl = [
        document.getElementById('dock-slot-0')!,
        document.getElementById('dock-slot-1')!,
        document.getElementById('dock-slot-2')!
      ];
      this.currentScoreEl = document.getElementById('current-score')!;
      this.bestScoreEl = document.getElementById('best-score')!;
      this.comboBadgeEl = document.getElementById('combo-badge')!;
      this.comboTextEl = document.getElementById('combo-text')!;
      this.comboSubEl = document.getElementById('combo-sub')!;
      this.dragProxyEl = document.getElementById('drag-proxy')!;
      this.floatTextLayerEl = document.getElementById('float-text-layer')!;
      this.modalEl = document.getElementById('game-over-modal')!;
      this.toastEl = document.getElementById('blast-toast')!;

      this.modeInfiniteBtn = document.getElementById('mode-btn-infinite') as HTMLButtonElement | null;
      this.modeTimedBtn = document.getElementById('mode-btn-timed') as HTMLButtonElement | null;
      this.timedStatusCardEl = document.getElementById('timed-status-card');
      this.timedClockEl = document.getElementById('timed-clock');
      this.timedFillEl = document.getElementById('timed-fill');
      this.modalCrownEl = document.getElementById('modal-crown');
      this.modalTitleEl = document.getElementById('modal-title');
      this.modalSubtitleEl = document.getElementById('modal-subtitle');

      this.audio = new BlastAudio();
      this.particles = new ParticleEngine(document.getElementById('fx-canvas') as HTMLCanvasElement);

      // Check initial mode from URL param (?mode=timed)
      const urlParams = new URLSearchParams(window.location.search);
      if (urlParams.get('mode') === 'timed') {
        this.mode = 'timed';
      }

      this.loadBestScore();
      this.initBoardDOM();
      this.bindControls();
      this.updateModeUI();
      this.startNewGame();
    }

    private getStorageKey(): string {
      return this.mode === 'timed'
        ? 'errorledger_block_blast_best_timed'
        : 'errorledger_block_blast_best_infinite';
    }

    private loadBestScore() {
      const key = this.getStorageKey();
      let saved = localStorage.getItem(key);
      if (!saved && this.mode === 'infinite') {
        // Fallback migration from legacy key
        saved = localStorage.getItem('errorledger_block_blast_best');
      }
      this.bestScore = saved ? parseInt(saved, 10) : 0;
      this.bestScoreEl.textContent = this.bestScore.toLocaleString();
    }

    private initBoardDOM() {
      if (this.boardGridEl.children.length === 64) {
        return;
      }
      this.boardGridEl.innerHTML = '';
      for (let r = 0; r < 8; r++) {
        for (let c = 0; c < 8; c++) {
          const cell = document.createElement('div');
          cell.className = 'grid-cell';
          cell.dataset.r = String(r);
          cell.dataset.c = String(c);
          this.boardGridEl.appendChild(cell);
        }
      }
    }

    private bindControls() {
      // Sound button
      const soundBtn = document.getElementById('btn-sound');
      if (soundBtn) {
        soundBtn.textContent = this.audio.muted ? '🔇' : '🔊';
        soundBtn.addEventListener('click', () => {
          const muted = this.audio.toggleMute();
          soundBtn.textContent = muted ? '🔇' : '🔊';
        });
      }

      // Restart button
      const restartBtn = document.getElementById('btn-restart');
      if (restartBtn) {
        restartBtn.addEventListener('click', () => {
          this.audio.playClick();
          this.startNewGame();
        });
      }

      // Mode Switchers
      if (this.modeInfiniteBtn) {
        this.modeInfiniteBtn.addEventListener('click', () => {
          this.audio.playClick();
          this.setMode('infinite');
        });
      }
      if (this.modeTimedBtn) {
        this.modeTimedBtn.addEventListener('click', () => {
          this.audio.playClick();
          this.setMode('timed');
        });
      }

      // Keyboard R for quick restart
      window.addEventListener('keydown', (e) => {
        if (e.key === 'r' || e.key === 'R') {
          if (!this.isDragging) {
            this.audio.playClick();
            this.startNewGame();
          }
        }
      });

      // Modal buttons
      const replayBtn = document.getElementById('modal-btn-replay');
      if (replayBtn) {
        replayBtn.addEventListener('click', () => {
          this.audio.playClick();
          this.modalEl.classList.add('hidden');
          this.startNewGame();
        });
      }

      const shareBtn = document.getElementById('modal-btn-share');
      if (shareBtn) {
        shareBtn.addEventListener('click', () => {
          this.audio.playClick();
          this.shareScore();
        });
      }

      // Global pointer listeners for dragging
      window.addEventListener('pointermove', this.onPointerMove, { passive: false });
      window.addEventListener('pointerup', this.onPointerUp);
      window.addEventListener('pointercancel', this.onPointerUp);
    }

    public setMode(newMode: GameMode) {
      if (this.mode === newMode) return;
      this.mode = newMode;
      this.updateModeUI();
      this.loadBestScore();
      this.startNewGame();
    }

    private updateModeUI() {
      if (this.modeInfiniteBtn && this.modeTimedBtn) {
        if (this.mode === 'infinite') {
          this.modeInfiniteBtn.classList.add('active');
          this.modeTimedBtn.classList.remove('active');
          this.timedStatusCardEl?.classList.add('hidden');
        } else {
          this.modeInfiniteBtn.classList.remove('active');
          this.modeTimedBtn.classList.add('active');
          this.timedStatusCardEl?.classList.remove('hidden');
        }
      }
    }

    // ─── Timed Mode Engine ───────────────────────────────────────────────────
    private startTimer() {
      this.stopTimer();
      if (this.mode !== 'timed') return;
      this.timeLeft = 120;
      this.maxTime = 120;
      this.updateTimerUI();

      this.timerInterval = window.setInterval(() => {
        this.tickTimer();
      }, 1000);
    }

    private stopTimer() {
      if (this.timerInterval !== null) {
        clearInterval(this.timerInterval);
        this.timerInterval = null;
      }
    }

    private tickTimer() {
      if (this.timeLeft <= 0) return;
      this.timeLeft--;
      this.updateTimerUI();

      if (this.timeLeft <= 0) {
        this.stopTimer();
        this.triggerGameOver('timeout');
      }
    }

    private addTimeBonus(seconds: number) {
      if (this.mode !== 'timed' || this.timeLeft <= 0) return;
      this.timeLeft = Math.min(150, this.timeLeft + seconds);
      this.updateTimerUI();
    }

    private updateTimerUI() {
      if (!this.timedClockEl || !this.timedFillEl) return;
      const mins = Math.floor(this.timeLeft / 60);
      const secs = this.timeLeft % 60;
      this.timedClockEl.textContent = `${String(mins).padStart(2, '0')}:${String(secs).padStart(2, '0')}`;

      const pct = Math.max(0, Math.min(100, (this.timeLeft / this.maxTime) * 100));
      this.timedFillEl.style.width = `${pct}%`;

      if (this.timeLeft <= 15) {
        this.timedClockEl.classList.add('danger');
        this.timedFillEl.classList.add('danger');
      } else {
        this.timedClockEl.classList.remove('danger');
        this.timedFillEl.classList.remove('danger');
      }
    }

    // ─── Game Loop ───────────────────────────────────────────────────────────
    public startNewGame() {
      if (this.gameOverTimeout) {
        clearTimeout(this.gameOverTimeout);
        this.gameOverTimeout = null;
      }
      this.isClearing = false;
      this.board = Array.from({ length: 8 }, () => Array(8).fill(0));
      this.score = 0;
      this.combo = 0;
      this.maxCombo = 0;
      this.totalLinesCleared = 0;
      this.currentScoreEl.textContent = '0';
      this.hideComboBadge();
      this.modalEl.classList.add('hidden');
      this.loadBestScore();
      this.renderBoard();
      this.dealNewPieces();

      if (this.mode === 'timed') {
        this.startTimer();
      } else {
        this.stopTimer();
      }
    }

    private renderBoard() {
      const cells = this.boardGridEl.children;
      for (let r = 0; r < 8; r++) {
        for (let c = 0; c < 8; c++) {
          const idx = r * 8 + c;
          const cell = cells[idx] as HTMLElement;
          // CRITICAL FIX: Ensure 'clearing' class is always removed so cleared cells never vanish
          cell.classList.remove('clearing');
          const val = this.board[r][c];
          if (val > 0) {
            cell.classList.add('filled');
            cell.dataset.color = String(val);
          } else {
            cell.classList.remove('filled');
            delete cell.dataset.color;
          }
          cell.classList.remove('ghost');
          for (let i = 1; i <= 8; i++) {
            cell.classList.remove(`ghost-valid-color-${i}`);
          }
        }
      }
    }

    // ─── Deal 3 Pieces with Anti-Frustration Verification ─────────────────────
    private dealNewPieces() {
      const totalWeight = SHAPES.reduce((sum, s) => sum + s.weight, 0);
      const pickRandomShape = (): ShapeDef => {
        let r = Math.random() * totalWeight;
        for (const s of SHAPES) {
          if (r < s.weight) return s;
          r -= s.weight;
        }
        return SHAPES[0];
      };

      // Generate 3 pieces
      let p1 = pickRandomShape();
      let p2 = pickRandomShape();
      let p3 = pickRandomShape();

      // Ensure at least one piece can be placed on current board
      const checkPlaceable = (shape: ShapeDef): boolean => {
        for (let r = 0; r <= 8 - shape.matrix.length; r++) {
          for (let c = 0; c <= 8 - shape.matrix[0].length; c++) {
            if (this.canPlace(shape.matrix, r, c)) return true;
          }
        }
        return false;
      };

      if (!checkPlaceable(p1) && !checkPlaceable(p2) && !checkPlaceable(p3)) {
        // Fallback: replace p1 with an easy small piece that fits
        const smallShapes = SHAPES.filter(s => s.matrix.length <= 2 && s.matrix[0].length <= 2);
        for (const s of smallShapes) {
          if (checkPlaceable(s)) {
            p1 = s;
            break;
          }
        }
      }

      this.dockPieces = [p1, p2, p3];
      this.renderDock();
      this.checkGameOverState();
    }

    private renderDock() {
      this.dockSlotsEl.forEach((slotEl, idx) => {
        slotEl.innerHTML = '';
        const shape = this.dockPieces[idx];
        if (!shape) return;

        const pieceWrapper = document.createElement('div');
        pieceWrapper.className = 'piece-wrapper';
        pieceWrapper.dataset.slot = String(idx);

        const rows = shape.matrix.length;
        const cols = shape.matrix[0].length;
        pieceWrapper.style.gridTemplateRows = `repeat(${rows}, 1fr)`;
        pieceWrapper.style.gridTemplateColumns = `repeat(${cols}, 1fr)`;

        // Calculate cell size in dock so small pieces look balanced
        const cellSize = Math.min(22, Math.floor(80 / Math.max(rows, cols, 3)));
        pieceWrapper.style.width = `${cols * (cellSize + 3)}px`;
        pieceWrapper.style.height = `${rows * (cellSize + 3)}px`;

        for (let r = 0; r < rows; r++) {
          for (let c = 0; c < cols; c++) {
            const cell = document.createElement('div');
            cell.className = 'piece-cell';
            cell.style.width = `${cellSize}px`;
            cell.style.height = `${cellSize}px`;
            if (shape.matrix[r][c] === 1) {
              cell.dataset.color = String(shape.color);
            } else {
              cell.style.visibility = 'hidden';
            }
            pieceWrapper.appendChild(cell);
          }
        }

        // Pointer down to initiate drag
        pieceWrapper.addEventListener('pointerdown', (e) => this.onPiecePointerDown(e, idx, shape));

        slotEl.appendChild(pieceWrapper);
      });
    }

    // ─── Drag & Drop Implementation ──────────────────────────────────────────
    private onPiecePointerDown(e: PointerEvent, slotIdx: number, shape: ShapeDef) {
      // Prevent drag if already dragging or during active clear explosion
      if (this.isDragging || this.isClearing) return;
      e.preventDefault();

      // Note: Pieces in the dock can ALWAYS be dragged. If dropped invalidly, they simply bounce back.
      this.isDragging = true;
      this.activeSlot = slotIdx;
      this.activeShape = shape;
      this.dragPointerId = e.pointerId;

      // On touch, offset upward ~65px so finger doesn't block view of piece
      this.touchOffsetY = e.pointerType === 'touch' ? -65 : 0;

      // Mark original dock piece as dragging
      const originPiece = this.dockSlotsEl[slotIdx].querySelector('.piece-wrapper');
      if (originPiece) {
        originPiece.classList.add('is-dragging-origin');
      }

      // Build floating drag proxy with board cell scale
      const boardCellSize = this.getBoardCellSize();
      this.buildDragProxy(shape, boardCellSize);

      this.updateDragProxyPos(e.clientX, e.clientY);
      this.dragProxyEl.classList.remove('hidden');

      this.audio.playPickup();
    }

    private getBoardCellSize(): number {
      const gridRect = this.boardGridEl.getBoundingClientRect();
      if (gridRect && gridRect.width > 0) {
        // 8 columns with 7 gaps of 4px each = 28px
        return (gridRect.width - 28) / 8;
      }
      return 44;
    }

    private buildDragProxy(shape: ShapeDef, cellSize: number) {
      this.dragProxyEl.innerHTML = '';
      const rows = shape.matrix.length;
      const cols = shape.matrix[0].length;
      this.dragProxyEl.style.gridTemplateRows = `repeat(${rows}, 1fr)`;
      this.dragProxyEl.style.gridTemplateColumns = `repeat(${cols}, 1fr)`;
      this.dragProxyEl.style.width = `${cols * cellSize + (cols - 1) * 4}px`;
      this.dragProxyEl.style.height = `${rows * cellSize + (rows - 1) * 4}px`;

      for (let r = 0; r < rows; r++) {
        for (let c = 0; c < cols; c++) {
          const cell = document.createElement('div');
          cell.className = 'piece-cell';
          cell.style.width = `${cellSize}px`;
          cell.style.height = `${cellSize}px`;
          if (shape.matrix[r][c] === 1) {
            cell.dataset.color = String(shape.color);
          } else {
            cell.style.visibility = 'hidden';
          }
          this.dragProxyEl.appendChild(cell);
        }
      }
    }

    private updateDragProxyPos(clientX: number, clientY: number) {
      const y = clientY + this.touchOffsetY;
      this.dragProxyEl.style.left = `${clientX}px`;
      this.dragProxyEl.style.top = `${y}px`;
    }

    private onPointerMove = (e: PointerEvent) => {
      if (!this.isDragging || !this.activeShape) return;
      e.preventDefault();
      this.updateDragProxyPos(e.clientX, e.clientY);

      // Determine hover board cell
      const hover = this.getHoverCell(e.clientX, e.clientY + this.touchOffsetY, this.activeShape);
      if (hover && this.canPlace(this.activeShape.matrix, hover.r, hover.c)) {
        this.highlightGhost(this.activeShape, hover.r, hover.c);
        this.lastHoverCell = hover;
      } else {
        this.clearGhost();
        this.lastHoverCell = null;
      }
    };

    private getHoverCell(proxyCenterX: number, proxyCenterY: number, shape: ShapeDef): { r: number; c: number } | null {
      const gridRect = this.boardGridEl.getBoundingClientRect();
      const cellSize = this.getBoardCellSize();
      const gap = 4;
      const totalCell = cellSize + gap;

      const shapeWidth = shape.matrix[0].length * totalCell;
      const shapeHeight = shape.matrix.length * totalCell;
      const topLeftX = proxyCenterX - shapeWidth / 2;
      const topLeftY = proxyCenterY - shapeHeight / 2;

      const relX = topLeftX - gridRect.left;
      const relY = topLeftY - gridRect.top;

      const col = Math.round(relX / totalCell);
      const row = Math.round(relY / totalCell);

      if (row >= 0 && row <= 8 - shape.matrix.length && col >= 0 && col <= 8 - shape.matrix[0].length) {
        return { r: row, c: col };
      }
      return null;
    }

    private canPlace(matrix: number[][], startR: number, startC: number): boolean {
      const rows = matrix.length;
      const cols = matrix[0].length;
      if (startR < 0 || startR + rows > 8 || startC < 0 || startC + cols > 8) return false;

      for (let r = 0; r < rows; r++) {
        for (let c = 0; c < cols; c++) {
          if (matrix[r][c] === 1) {
            if (this.board[startR + r][startC + c] !== 0) {
              return false;
            }
          }
        }
      }
      return true;
    }

    private highlightGhost(shape: ShapeDef, startR: number, startC: number) {
      this.clearGhost();
      const cells = this.boardGridEl.children;
      for (let r = 0; r < shape.matrix.length; r++) {
        for (let c = 0; c < shape.matrix[0].length; c++) {
          if (shape.matrix[r][c] === 1) {
            const idx = (startR + r) * 8 + (startC + c);
            const cell = cells[idx] as HTMLElement;
            if (cell) {
              cell.classList.add('ghost');
              cell.classList.add(`ghost-valid-color-${shape.color}`);
            }
          }
        }
      }
    }

    private clearGhost() {
      const cells = this.boardGridEl.children;
      for (let i = 0; i < cells.length; i++) {
        const cell = cells[i] as HTMLElement;
        cell.classList.remove('ghost');
        for (let c = 1; c <= 8; c++) {
          cell.classList.remove(`ghost-valid-color-${c}`);
        }
      }
    }

    private onPointerUp = (e: PointerEvent) => {
      if (!this.isDragging) return;
      this.isDragging = false;
      this.dragProxyEl.classList.add('hidden');
      this.clearGhost();

      const slotIdx = this.activeSlot!;
      const shape = this.activeShape!;
      const hover = this.lastHoverCell;

      // Reset origin dock piece opacity
      const originPiece = this.dockSlotsEl[slotIdx]?.querySelector('.piece-wrapper');
      if (originPiece) {
        originPiece.classList.remove('is-dragging-origin');
      }

      if (hover && this.canPlace(shape.matrix, hover.r, hover.c)) {
        // Valid Drop! Snap onto board
        this.placePiece(shape, hover.r, hover.c, slotIdx);
      }

      this.activeSlot = null;
      this.activeShape = null;
      this.lastHoverCell = null;
    };

    // ─── Place Piece & Check Line Clears ─────────────────────────────────────
    private placePiece(shape: ShapeDef, startR: number, startC: number, slotIdx: number) {
      let placedCellsCount = 0;
      const placedCellEls: HTMLElement[] = [];
      const cells = this.boardGridEl.children;

      for (let r = 0; r < shape.matrix.length; r++) {
        for (let c = 0; c < shape.matrix[0].length; c++) {
          if (shape.matrix[r][c] === 1) {
            const boardR = startR + r;
            const boardC = startC + c;
            this.board[boardR][boardC] = shape.color;
            placedCellsCount++;

            const idx = boardR * 8 + boardC;
            const cellEl = cells[idx] as HTMLElement;
            cellEl.classList.add('filled', 'cell-placed');
            cellEl.dataset.color = String(shape.color);
            placedCellEls.push(cellEl);
          }
        }
      }

      // Remove piece from dock slot
      this.dockPieces[slotIdx] = null;
      this.dockSlotsEl[slotIdx].innerHTML = '';

      // Play drop sound
      this.audio.playDrop();

      // Clear cell-placed animation class after bounce
      setTimeout(() => {
        placedCellEls.forEach(el => el.classList.remove('cell-placed'));
      }, 250);

      // Check full rows & columns
      this.checkLineClears(placedCellsCount, startR, startC);
    }

    private checkLineClears(placedCellsCount: number, centerR: number, centerC: number) {
      const fullRows: number[] = [];
      const fullCols: number[] = [];

      for (let r = 0; r < 8; r++) {
        if (this.board[r].every(val => val > 0)) fullRows.push(r);
      }
      for (let c = 0; c < 8; c++) {
        let full = true;
        for (let r = 0; r < 8; r++) {
          if (this.board[r][c] === 0) { full = false; break; }
        }
        if (full) fullCols.push(c);
      }

      const totalLines = fullRows.length + fullCols.length;

      if (totalLines > 0) {
        this.isClearing = true;

        // COMBO UP!
        this.combo++;
        this.maxCombo = Math.max(this.maxCombo, this.combo);
        this.totalLinesCleared += totalLines;

        // Collect all distinct cleared cells
        const clearedCoords = new Set<string>();
        fullRows.forEach(r => {
          for (let c = 0; c < 8; c++) clearedCoords.add(`${r},${c}`);
        });
        fullCols.forEach(c => {
          for (let r = 0; r < 8; r++) clearedCoords.add(`${r},${c}`);
        });

        // Trigger particles & blast flash
        const cellSize = this.getBoardCellSize();
        const gridRect = this.boardGridEl.getBoundingClientRect();
        const wrapperRect = this.boardWrapperEl.getBoundingClientRect();
        const offsetX = gridRect.left - wrapperRect.left;
        const offsetY = gridRect.top - wrapperRect.top;

        clearedCoords.forEach(coord => {
          const [rStr, cStr] = coord.split(',');
          const r = parseInt(rStr, 10);
          const c = parseInt(cStr, 10);
          const colorId = this.board[r][c];

          const cellX = offsetX + c * (cellSize + 4);
          const cellY = offsetY + r * (cellSize + 4);
          this.particles.spawnBlast(cellX, cellY, cellSize, colorId);

          const idx = r * 8 + c;
          const cellEl = this.boardGridEl.children[idx] as HTMLElement;
          cellEl.classList.add('clearing');
        });

        // Calculate score
        const baseScore = placedCellsCount * 10;
        const lineBase = totalLines * 100;
        const comboMultiplier = 1 + (this.combo - 1) * 0.5;
        const multiBonus = totalLines >= 2 ? (totalLines - 1) * 150 : 0;
        const addedScore = Math.floor(baseScore + (lineBase * comboMultiplier) + multiBonus);

        this.addScore(addedScore);
        this.audio.playClear(this.combo, totalLines);
        this.showComboBadge(this.combo, totalLines);
        this.spawnFloatingScore(`+${addedScore}`, centerR, centerC);

        // Timed Mode: add bonus seconds
        if (this.mode === 'timed') {
          const bonusSeconds = totalLines * 3 + (this.combo >= 2 ? 2 : 0);
          this.addTimeBonus(bonusSeconds);
          this.audio.playTimeBonus();
          this.spawnFloatingScore(`+${bonusSeconds}s ⏱️`, Math.max(0, centerR - 1), centerC);
        }

        // Zero out data in board array immediately so checks see empty cells
        clearedCoords.forEach(coord => {
          const [rStr, cStr] = coord.split(',');
          const r = parseInt(rStr, 10);
          const c = parseInt(cStr, 10);
          this.board[r][c] = 0;
        });

        // Wait for visual clear animation (320ms), then render clean board and advance turn
        setTimeout(() => {
          this.renderBoard();
          this.onTurnFinished();
          this.isClearing = false;
        }, 320);

      } else {
        // No line cleared: combo resets to 0
        this.combo = 0;
        this.hideComboBadge();
        const addedScore = placedCellsCount * 10;
        this.addScore(addedScore);
        this.onTurnFinished();
      }
    }

    private onTurnFinished() {
      // Check if all 3 dock slots are empty
      if (this.dockPieces.every(p => p === null)) {
        this.dealNewPieces();
      } else {
        this.checkGameOverState();
      }
    }

    private addScore(amount: number) {
      this.score += amount;
      this.currentScoreEl.textContent = this.score.toLocaleString();
      this.currentScoreEl.classList.remove('score-bump');
      void this.currentScoreEl.offsetWidth; // trigger reflow
      this.currentScoreEl.classList.add('score-bump');

      if (this.score > this.bestScore) {
        this.bestScore = this.score;
        this.bestScoreEl.textContent = this.bestScore.toLocaleString();
        localStorage.setItem(this.getStorageKey(), String(this.bestScore));
      }
    }

    private showComboBadge(combo: number, lines: number) {
      this.comboBadgeEl.classList.remove('hidden');
      this.comboTextEl.textContent = `COMBO x${combo}`;

      const subtitles = [
        'CLEAR!', 'EXCELLENT! 🔥', 'AWESOME! ⚡', 'SUPER BLAST! 🌟',
        'UNBELIEVABLE! 💥', 'LEGENDARY! 👑'
      ];
      const text = subtitles[Math.min(combo, subtitles.length - 1)];
      this.comboSubEl.textContent = lines > 1 ? `MULTI BLAST x${lines}!` : text;
    }

    private hideComboBadge() {
      this.comboBadgeEl.classList.add('hidden');
    }

    private spawnFloatingScore(text: string, r: number, c: number) {
      const cellSize = this.getBoardCellSize();
      const gridRect = this.boardGridEl.getBoundingClientRect();
      const wrapperRect = this.boardWrapperEl.getBoundingClientRect();
      const x = (gridRect.left - wrapperRect.left) + c * (cellSize + 4) + cellSize;
      const y = (gridRect.top - wrapperRect.top) + r * (cellSize + 4);

      const el = document.createElement('div');
      el.className = 'floating-score';
      el.textContent = text;
      el.style.left = `${x}px`;
      el.style.top = `${y}px`;
      this.floatTextLayerEl.appendChild(el);

      setTimeout(() => el.remove(), 850);
    }

    // ─── Game Over State Check ───────────────────────────────────────────────
    private checkGameOverState() {
      let anyPieceCanFit = false;

      this.dockPieces.forEach((shape, idx) => {
        if (!shape) return;
        let fits = false;
        for (let r = 0; r <= 8 - shape.matrix.length; r++) {
          for (let c = 0; c <= 8 - shape.matrix[0].length; c++) {
            if (this.canPlace(shape.matrix, r, c)) {
              fits = true;
              break;
            }
          }
          if (fits) break;
        }

        const slotEl = this.dockSlotsEl[idx];
        const wrapper = slotEl.querySelector('.piece-wrapper');
        if (wrapper) {
          if (!fits) {
            wrapper.classList.add('unplaceable');
          } else {
            wrapper.classList.remove('unplaceable');
            anyPieceCanFit = true;
          }
        }
      });

      // If at least one unplaced piece exists but NO piece can fit anywhere -> GAME OVER
      const hasUnplacedPieces = this.dockPieces.some(p => p !== null);
      if (hasUnplacedPieces && !anyPieceCanFit) {
        if (!this.gameOverTimeout) {
          this.gameOverTimeout = window.setTimeout(() => this.triggerGameOver('gridlock'), 450);
        }
      } else {
        if (this.gameOverTimeout) {
          clearTimeout(this.gameOverTimeout);
          this.gameOverTimeout = null;
        }
      }
    }

    private triggerGameOver(reason: 'gridlock' | 'timeout' = 'gridlock') {
      this.stopTimer();
      this.audio.playGameOver();

      if (this.modalCrownEl && this.modalTitleEl && this.modalSubtitleEl) {
        if (reason === 'timeout') {
          this.modalCrownEl.textContent = '⏱️';
          this.modalTitleEl.textContent = 'TIME OVER!';
          this.modalSubtitleEl.textContent = '제한 시간 2분이 모두 종료되었습니다!';
        } else {
          this.modalCrownEl.textContent = '💥';
          this.modalTitleEl.textContent = 'GAME OVER';
          this.modalSubtitleEl.textContent = '더 이상 블록을 놓을 수 있는 자리가 없습니다!';
        }
      }

      const modalFinal = document.getElementById('modal-final-score')!;
      const modalBest = document.getElementById('modal-best-score')!;
      const modalCombo = document.getElementById('modal-max-combo')!;
      const modalLines = document.getElementById('modal-total-lines')!;

      modalFinal.textContent = this.score.toLocaleString();
      modalBest.textContent = this.bestScore.toLocaleString();
      modalCombo.textContent = `${this.maxCombo}x`;
      modalLines.textContent = `${this.totalLinesCleared}줄`;

      this.modalEl.classList.remove('hidden');
    }

    private shareScore() {
      const modeName = this.mode === 'timed' ? '⏱️ 타임어택 (2분)' : '♾️ 무한 클래식';
      const shareText = `🧩 블록 블라스트 (Block Blast!) [${modeName}] 결과\n점수: ${this.score.toLocaleString()}점 | 최고 콤보: ${this.maxCombo}x 🔥\n폭파한 라인: ${this.totalLinesCleared}줄\n🔗 https://errorledger.com/games/block-blast`;

      if (navigator.clipboard && navigator.clipboard.writeText) {
        navigator.clipboard.writeText(shareText).then(() => {
          this.showToast('📋 결과가 클립보드에 복사되었습니다!');
        }).catch(() => {
          this.fallbackCopy(shareText);
        });
      } else {
        this.fallbackCopy(shareText);
      }
    }

    private fallbackCopy(text: string) {
      const ta = document.createElement('textarea');
      ta.value = text;
      ta.style.position = 'fixed';
      ta.style.opacity = '0';
      document.body.appendChild(ta);
      ta.select();
      try {
        document.execCommand('copy');
        this.showToast('📋 결과가 클립보드에 복사되었습니다!');
      } catch (e) {
        this.showToast('❌ 복사에 실패했습니다.');
      }
      document.body.removeChild(ta);
    }

    private showToast(msg: string) {
      this.toastEl.textContent = msg;
      this.toastEl.classList.add('show');
      setTimeout(() => {
        this.toastEl.classList.remove('show');
      }, 2500);
    }
  }

  // Mount game instance when DOM is ready
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', () => new BlockBlastGame());
  } else {
    new BlockBlastGame();
  }
</script>
