  // ==========================================================================
  // TOP DROPPER CONTROLLER
  // ==========================================================================
  class SandDropper {
    public x: number = 80;
    public readonly y: number = 22;
    public targetX: number = 80;

    constructor(startX: number = 80) {
      this.x = startX;
      this.targetX = startX;
    }

    public setPosition(gridX: number, radius: number, wallLeft: number, wallRight: number) {
      const minX = wallLeft + 1 + radius + 1.5;
      const maxX = wallRight - radius - 1.5;
      this.targetX = Math.max(minX, Math.min(maxX, gridX));
    }

    public nudge(deltaX: number, radius: number, wallLeft: number, wallRight: number) {
      const minX = wallLeft + 1 + radius + 1.5;
      const maxX = wallRight - radius - 1.5;
      this.targetX = Math.max(minX, Math.min(maxX, this.targetX + deltaX));
    }

    public update(dt: number, radius: number, wallLeft: number, wallRight: number) {
      const minX = wallLeft + 1 + radius + 1.5;
      const maxX = wallRight - radius - 1.5;
      this.targetX = Math.max(minX, Math.min(maxX, this.targetX));
      // Smooth responsive easing
      this.x += (this.targetX - this.x) * 0.35;
    }

    public render(
      ctx: CanvasRenderingContext2D,
      scaleX: number,
      scaleY: number,
      currentTier: number,
      isPouring: boolean,
      pourRemainingRatio: number,
      isGameOver: boolean,
      wallLeft: number,
      wallRight: number,
      floorY: number,
      grid: Uint8Array,
      gridCols: number,
      drawSandClumpFn: (cx: number, cy: number, tier: number, radius: number, scaleX: number, scaleY: number) => void,
      isOverDangerLine: boolean = false
    ) {
      if (isGameOver) return;

      const tierInfo = TIERS[currentTier - 1];
      if (!tierInfo) return;

      const screenX = this.x * scaleX;
      const screenY = this.y * scaleY;

      // 1. Vertical Drop Guide Line to Obstacle/Floor (shown only when ready to drop and not in danger)
      const isReadyToDrop = !isPouring && pourRemainingRatio >= 0.85 && !isOverDangerLine;
      if (isReadyToDrop) {
        const col = Math.round(this.x);
        let hitY = floorY;
        for (let cy = Math.round(this.y + tierInfo.radius); cy < floorY; cy++) {
          if (grid[cy * gridCols + col] > 0) {
            hitY = cy;
            break;
          }
        }

        ctx.save();
        // Subtle dashed laser guide line
        ctx.setLineDash([4, 4]);
        ctx.strokeStyle = 'rgba(255, 255, 255, 0.35)';
        ctx.lineWidth = 1.5;
        ctx.beginPath();
        ctx.moveTo(screenX, (this.y + tierInfo.radius) * scaleY + 2);
        ctx.lineTo(screenX, hitY * scaleY);
        ctx.stroke();
        ctx.setLineDash([]);

        // Subtle landing point indicator ring
        ctx.strokeStyle = tierInfo.baseColor;
        ctx.lineWidth = 2;
        ctx.beginPath();
        ctx.arc(screenX, hitY * scaleY, 4, 0, Math.PI * 2);
        ctx.stroke();
        ctx.restore();
      }

      // 2. Sleek Top Rail Carriage
      ctx.save();
      const railY = 8 * scaleY;
      ctx.fillStyle = '#334155';
      ctx.fillRect((wallLeft + 1 + 2) * scaleX, railY - 1.5, (wallRight - (wallLeft + 1) - 4) * scaleX, 3);

      // Dropper Carriage Marker
      ctx.fillStyle = '#64748b';
      ctx.beginPath();
      ctx.roundRect(screenX - 14, railY - 4, 28, 8, 3);
      ctx.fill();

      // Glowing LED on dropper (glows bright when ready, warning red during danger limit, dim during reload cooldown)
      ctx.fillStyle = isOverDangerLine 
        ? '#ff4757' 
        : (isReadyToDrop ? tierInfo.baseColor : 'rgba(100, 116, 139, 0.6)');
      ctx.beginPath();
      ctx.arc(screenX, railY, 2.5, 0, Math.PI * 2);
      ctx.fill();

      // Dropper arrow pointer
      ctx.fillStyle = isReadyToDrop ? 'rgba(255, 255, 255, 0.85)' : (isOverDangerLine ? 'rgba(255, 71, 87, 0.8)' : 'rgba(255, 255, 255, 0.3)');
      ctx.beginPath();
      ctx.moveTo(screenX - 5, railY + 6);
      ctx.lineTo(screenX + 5, railY + 6);
      ctx.lineTo(screenX, railY + 11);
      ctx.closePath();
      ctx.fill();
      ctx.restore();

      // 3. Hanging Ready-to-Drop Sand Clump in the hopper
      if (pourRemainingRatio > 0.05) {
        drawSandClumpFn(
          screenX,
          screenY,
          currentTier,
          tierInfo.radius * Math.sqrt(pourRemainingRatio),
          scaleX,
          scaleY
        );
      }
    }
  }

  // MAIN GAME CONTROLLER
  class SandSuikaGame {
    private canvas: HTMLCanvasElement;
    private ctx: CanvasRenderingContext2D;
    private sound: SoundManager;

    // Simulation Grid (Cellular Automata)
    // Resolution: 160 columns x 220 rows
    public readonly gridCols = 160;
    public readonly gridRows = 220;
    private grid: Uint8Array; // 0: empty, 1..11: tier, 255: wall
    private gridFlags: Uint8Array; // 0: unmodified, 1: updated this frame
    private gridBatch: Uint32Array; // drop/batch ID of each sand grain
    private gridFlash: Uint8Array; // 0: normal, 1..12: gleaming merge flash frames
    private clusterVisit: Uint32Array; // per-frame stamp: cell already flood-filled this frame
    private clusterStamp: number = 0;

    // Rendering: canvas size in CSS pixels + 1-pixel-per-cell sand layer
    private viewW: number = 480;
    private viewH: number = 640;
    private sandLayer: HTMLCanvasElement;
    private sandLayerCtx: CanvasRenderingContext2D;
    private sandImage: ImageData;

    private currentBatchId: number = 1;
    private batchMergeCooldown: Map<number, number> = new Map(); // batchId -> timestamp cooldown

    // Container geometry in grid units
    public readonly wallLeft = 8;
    public readonly wallRight = 152;
    public readonly floorY = 214;
    public readonly dangerRow = 55; // Row above which is danger zone (25% from top: 55/220)

    // Top Dropper Controller
    public dropper: SandDropper;
    private dropCooldown: number = 0;

    // Physical Airborne Splash Grains & Camera Shake
    private splashGrains: SplashGrain[] = [];
    private cameraShake: number = 0;

    // Game State
    public score = 0;
    public bestScore = 0;
    public combo = 0;
    public comboTimer = 0;
    public maxTierReached = 1;
    public isGameOver = false;

    // Advanced Stats & Dynamics
    private landslidesCount: number = 0;
    private emergencyClearsCount: number = 0;
    private maxComboReached: number = 0;
    private lastLandslideTime: number = 0;
    private floatingBanners: FloatingBanner[] = [];

    // Danger Timer
    public dangerCounter = 0; // In seconds
    public isOverDangerLine = false;

    // Ball Inventory (2-Piece Upcoming Queue: NEXT & THEN)
    public currentTier: number = 1;
    public nextTier: number = 1;
    public thenTier: number = 1;

    // Active Pouring Sand Stream
    public activeStream: PouringStream | null = null;

    // Particle FX
    private sparkles: Sparkle[] = [];

    // Animation / Loop
    private lastFrameTime = performance.now();
    private physicsAccumulator: number = 0;
    private animationId: number = 0;

    // UI Elements
    private scoreEl: HTMLElement;
    private bestScoreEl: HTMLElement;
    private comboBadgeEl: HTMLElement;
    private comboTextEl: HTMLElement;
    private comboTitleEl: HTMLElement;
    private comboBarFillEl: HTMLElement;
    private nextBallVisualEl: HTMLElement;
    private nextBallEmojiEl: HTMLElement;
    private nextBallNameEl: HTMLElement;
    private nextBallTierEl: HTMLElement;
    private thenBallVisualEl: HTMLElement;
    private thenBallEmojiEl: HTMLElement;
    private thenBallNameEl: HTMLElement;
    private dangerTagEl: HTMLElement;
    private dangerTimerEl: HTMLElement;
    private dropHintEl: HTMLElement;
    private gameOverModalEl: HTMLElement;
    private finalScoreValEl: HTMLElement;
    private modalBestValEl: HTMLElement;
    private modalMaxTierEl: HTMLElement;
    private modalMaxComboEl: HTMLElement;
    private modalLandslidesEl: HTMLElement;
    private modalEmergencyEl: HTMLElement;
    private tierListContainerEl: HTMLElement;

    constructor() {
      this.canvas = document.getElementById('sand-canvas') as HTMLCanvasElement;
      this.ctx = this.canvas.getContext('2d', { alpha: false })!;
      this.sound = new SoundManager();
      this.dropper = new SandDropper(80);

      this.grid = new Uint8Array(this.gridCols * this.gridRows);
      this.gridFlags = new Uint8Array(this.gridCols * this.gridRows);
      this.gridBatch = new Uint32Array(this.gridCols * this.gridRows);
      this.gridFlash = new Uint8Array(this.gridCols * this.gridRows);
      this.clusterVisit = new Uint32Array(this.gridCols * this.gridRows);

      this.sandLayer = document.createElement('canvas');
      this.sandLayer.width = this.gridCols;
      this.sandLayer.height = this.gridRows;
      this.sandLayerCtx = this.sandLayer.getContext('2d')!;
      this.sandImage = this.sandLayerCtx.createImageData(this.gridCols, this.gridRows);

      // Cache DOM Elements
      this.scoreEl = document.getElementById('current-score-text')!;
      this.bestScoreEl = document.getElementById('best-score-text')!;
      this.comboBadgeEl = document.getElementById('combo-badge')!;
      this.comboTextEl = document.getElementById('combo-text')!;
      this.comboTitleEl = document.getElementById('combo-title')!;
      this.comboBarFillEl = document.getElementById('combo-bar-fill')!;
      this.nextBallVisualEl = document.getElementById('next-ball-visual')!;
      this.nextBallEmojiEl = document.getElementById('next-ball-emoji')!;
      this.nextBallNameEl = document.getElementById('next-ball-name')!;
      this.nextBallTierEl = document.getElementById('next-ball-tier')!;
      this.thenBallVisualEl = document.getElementById('then-ball-visual')!;
      this.thenBallEmojiEl = document.getElementById('then-ball-emoji')!;
      this.thenBallNameEl = document.getElementById('then-ball-name')!;
      this.dangerTagEl = document.getElementById('danger-tag')!;
      this.dangerTimerEl = document.getElementById('danger-timer')!;
      this.dropHintEl = document.getElementById('drop-hint')!;
      this.gameOverModalEl = document.getElementById('game-over-modal')!;
      this.finalScoreValEl = document.getElementById('final-score-val')!;
      this.modalBestValEl = document.getElementById('modal-best-val')!;
      this.modalMaxTierEl = document.getElementById('modal-max-tier')!;
      this.modalMaxComboEl = document.getElementById('modal-max-combo')!;
      this.modalLandslidesEl = document.getElementById('modal-landslides')!;
      this.modalEmergencyEl = document.getElementById('modal-emergency')!;
      this.tierListContainerEl = document.getElementById('tier-list-container')!;

      this.setupHiDPICanvas();
      window.addEventListener('resize', () => this.setupHiDPICanvas());

      this.loadSavedScore();
      this.buildWalls();
      this.renderTierList();
      this.initEvents();
      this.resetRound();

      // Start main loop
      this.lastFrameTime = performance.now();
      this.loop = this.loop.bind(this);
      this.animationId = requestAnimationFrame(this.loop);
    }

    private setupHiDPICanvas() {
      const dpr = Math.min(window.devicePixelRatio || 1, 2.5);
      const rect = this.canvas.getBoundingClientRect();
      this.viewW = rect.width || 480;
      this.viewH = rect.height || 640;
      this.canvas.width = Math.round(this.viewW * dpr);
      this.canvas.height = Math.round(this.viewH * dpr);
      // Resizing resets context state: draw in CSS pixels, scaled to device pixels
      this.ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      this.ctx.imageSmoothingEnabled = false;
    }

    private addFloatingBanner(text: string, subText: string, color: string, x: number, y: number) {
      this.floatingBanners.push({
        text,
        subText,
        color,
        x,
        y,
        alpha: 1.0,
        scale: 1.0,
        vy: -0.55,
        life: 1.9
      });
      if (this.floatingBanners.length > 5) {
        this.floatingBanners.shift();
      }
    }

    private loadSavedScore() {
      try {
        const saved = localStorage.getItem('sand_drop_best_score') || localStorage.getItem('sand_suika_best_score');
        if (saved) {
          this.bestScore = parseInt(saved, 10) || 0;
          this.bestScoreEl.textContent = this.bestScore.toLocaleString();
        }
      } catch (_) {}
    }

    private saveScore() {
      if (this.score > this.bestScore) {
        this.bestScore = this.score;
        this.bestScoreEl.textContent = this.bestScore.toLocaleString();
        try {
          localStorage.setItem('sand_drop_best_score', this.bestScore.toString());
        } catch (_) {}
      }
    }

    private buildWalls() {
      this.grid.fill(0);
      this.gridFlags.fill(0);
      this.gridBatch.fill(0);
      this.gridFlash.fill(0);
      this.clusterVisit.fill(0);
      this.clusterStamp = 0;
      this.batchMergeCooldown.clear();

      // Fill boundary walls (solid boundaries on left, right, and floor)
      for (let y = 0; y < this.gridRows; y++) {
        for (let x = 0; x < this.gridCols; x++) {
          if (x <= this.wallLeft || x >= this.wallRight || y >= this.floorY) {
            this.grid[y * this.gridCols + x] = 255; // Solid wall
          }
        }
      }
    }

    private renderTierList() {
      if (!this.tierListContainerEl) return;
      this.tierListContainerEl.innerHTML = '';
      TIERS.forEach((t) => {
        const chip = document.createElement('div');
        const isMax = t.tier === 11;
        chip.className = 'tier-chip' + (t.tier === 1 ? ' unlocked' : '') + (isMax ? ' tier-chip-max' : '');
        chip.id = `tier-row-${t.tier}`;
        const shortName = t.name.replace(/ 샌드$/, '');
        chip.innerHTML = `
          <div class="tier-chip-left">
            <span class="tier-color-dot" style="background:${t.baseColor}; box-shadow: 0 0 6px ${t.baseColor}88;"></span>
            <span class="tier-name-label">${t.emoji} ${shortName}</span>
          </div>
          <span class="tier-num-badge">${isMax ? 'MAX ★' : `T${t.tier}`}</span>
        `;
        this.tierListContainerEl.appendChild(chip);
      });
    }

    private getRandomInitialTier(): number {
      // 40% Tier 1 (Small), 30% Tier 2 (Medium), 20% Tier 3 (Large), 10% Tier 4 (Extra Large)
      const r = Math.random();
      if (r < 0.40) return 1;
      if (r < 0.70) return 2;
      if (r < 0.90) return 3;
      return 4;
    }

    public resetRound() {
      this.currentBatchId = 1;
      this.batchMergeCooldown.clear();
      this.buildWalls();
      this.score = 0;
      this.combo = 0;
      this.comboTimer = 0;
      this.dangerCounter = 0;
      this.isOverDangerLine = false;
      this.isGameOver = false;
      this.activeStream = null;
      this.dropCooldown = 0;
      this.physicsAccumulator = 0;
      this.dropper.setPosition(80, 5, this.wallLeft, this.wallRight);
      this.splashGrains = [];
      this.cameraShake = 0;
      this.sparkles = [];
      this.floatingBanners = [];
      this.landslidesCount = 0;
      this.emergencyClearsCount = 0;
      this.maxComboReached = 0;
      this.lastLandslideTime = 0;
      this.maxTierReached = 1;

      this.currentTier = this.getRandomInitialTier();
      this.nextTier = this.getRandomInitialTier();
      this.thenTier = this.getRandomInitialTier();

      this.scoreEl.textContent = '0';
      this.comboBadgeEl.classList.add('hidden');
      if (this.comboBarFillEl) this.comboBarFillEl.style.width = '0%';
      this.gameOverModalEl.classList.add('hidden');
      this.dangerTagEl.classList.remove('danger-active');
      this.dangerTimerEl.classList.add('hidden');
      if (this.dropHintEl) this.dropHintEl.style.opacity = '1';

      this.updateNextBallUI();
    }

    private updateNextBallUI() {
      const nextInfo = TIERS[this.nextTier - 1];
      if (nextInfo) {
        // Visibly scale next preview orb based on tier radius
        const visualSize = Math.min(68, Math.max(34, 28 + nextInfo.radius * 2.4));
        this.nextBallVisualEl.style.width = `${visualSize}px`;
        this.nextBallVisualEl.style.height = `${visualSize}px`;
        this.nextBallVisualEl.style.background = `radial-gradient(circle at 35% 35%, ${nextInfo.baseColor}, #111)`;
        this.nextBallEmojiEl.textContent = nextInfo.emoji;
        this.nextBallNameEl.textContent = nextInfo.name;
        this.nextBallTierEl.textContent = `Tier ${nextInfo.tier} (크기 Ø${nextInfo.radius * 2})`;
      }

      // Update THEN 2ND ball preview chip
      const thenInfo = TIERS[this.thenTier - 1];
      if (thenInfo && this.thenBallVisualEl) {
        this.thenBallVisualEl.style.background = `radial-gradient(circle at 35% 35%, ${thenInfo.baseColor}, #111)`;
        if (this.thenBallEmojiEl) this.thenBallEmojiEl.textContent = thenInfo.emoji;
        if (this.thenBallNameEl) this.thenBallNameEl.textContent = `${thenInfo.name} (T${thenInfo.tier})`;
      }

      // Update unlocked tiers in guide
      TIERS.forEach((t) => {
        const row = document.getElementById(`tier-row-${t.tier}`);
        if (row) {
          row.classList.toggle('unlocked', t.tier <= this.maxTierReached);
        }
      });
    }

    private initEvents() {
      const mount = document.getElementById('canvas-mount')!;

      const getGridX = (clientX: number): number => {
        const rect = this.canvas.getBoundingClientRect();
        const normX = (clientX - rect.left) / rect.width;
        return normX * this.gridCols;
      };

      const getCurrentRadius = () => {
        const t = TIERS[this.currentTier - 1];
        return t ? t.radius : 6;
      };

      // Mouse controls: track horizontal position and click to pour
      mount.addEventListener('mousemove', (e: MouseEvent) => {
        if (this.activeStream !== null) return;
        const gx = getGridX(e.clientX);
        this.dropper.setPosition(gx, getCurrentRadius(), this.wallLeft, this.wallRight);
      });

      mount.addEventListener('mousedown', (e: MouseEvent) => {
        if (e.button === 0) {
          if (this.activeStream === null) {
            const gx = getGridX(e.clientX);
            this.dropper.setPosition(gx, getCurrentRadius(), this.wallLeft, this.wallRight);
          }
          this.startPouring();
        }
      });

      // Mobile Touch controls: touch/drag to position, release to pour
      mount.addEventListener('touchstart', (e: TouchEvent) => {
        if (this.activeStream !== null) return;
        if (e.touches.length > 0) {
          const gx = getGridX(e.touches[0].clientX);
          this.dropper.setPosition(gx, getCurrentRadius(), this.wallLeft, this.wallRight);
        }
      }, { passive: true });

      mount.addEventListener('touchmove', (e: TouchEvent) => {
        if (this.activeStream !== null) return;
        if (e.touches.length > 0) {
          const gx = getGridX(e.touches[0].clientX);
          this.dropper.setPosition(gx, getCurrentRadius(), this.wallLeft, this.wallRight);
        }
      }, { passive: true });

      mount.addEventListener('touchend', () => {
        this.startPouring();
      });

      // Context menu disable on canvas
      mount.addEventListener('contextmenu', (e) => e.preventDefault());

      // Keyboard Controls
      window.addEventListener('keydown', (e) => {
        const target = e.target as HTMLElement | null;
        if (target && (target.tagName === 'INPUT' || target.tagName === 'TEXTAREA' || target.isContentEditable)) return;

        const rad = getCurrentRadius();
        if (e.code === 'ArrowLeft' || e.code === 'KeyA') {
          if (this.activeStream === null) this.dropper.nudge(-4, rad, this.wallLeft, this.wallRight);
        } else if (e.code === 'ArrowRight' || e.code === 'KeyD') {
          if (this.activeStream === null) this.dropper.nudge(4, rad, this.wallLeft, this.wallRight);
        } else if (e.code === 'Space' || e.code === 'ArrowDown' || e.code === 'KeyS') {
          e.preventDefault();
          this.startPouring();
        }
      });

      // UI Buttons
      document.getElementById('btn-restart')?.addEventListener('click', () => this.resetRound());
      document.getElementById('btn-manual-reset')?.addEventListener('click', () => {
        if (confirm('게임을 새로 시작하시겠습니까?')) {
          this.resetRound();
        }
      });

      const soundBtn = document.getElementById('btn-toggle-sound');
      soundBtn?.addEventListener('click', () => {
        this.sound.enabled = !this.sound.enabled;
        const iconEl = document.getElementById('sound-icon')!;
        const textEl = document.getElementById('sound-text')!;
        if (this.sound.enabled) {
          iconEl.textContent = '🔊';
          textEl.textContent = '사운드 ON';
        } else {
          iconEl.textContent = '🔇';
          textEl.textContent = '사운드 OFF';
        }
      });
    }

    private startPouring() {
      if (this.activeStream !== null || this.isGameOver || this.dropCooldown > 0 || this.isOverDangerLine) return;

      const tierInfo = TIERS[this.currentTier - 1];
      if (!tierInfo) return;

      const r = tierInfo.radius;
      // Generous, rich sand volume per drop (~ pi * r^2 * 1.15)
      const totalGrains = Math.max(60, Math.round(Math.PI * r * r * 1.15));
      const batchId = ++this.currentBatchId;

      this.activeStream = {
        tier: this.currentTier,
        batchId,
        totalGrains,
        grainsSpawned: 0,
        startX: this.dropper.x,
        startY: this.dropper.y + 4,
        radius: r,
        grains: [],
        isFinishedSpawning: false
      };

      this.dropCooldown = 220;
      this.sound.playPourStart();

      if (this.dropHintEl) {
        this.dropHintEl.style.opacity = '0';
      }

      // Advance 2-piece queue (current <- next <- then <- random)
      this.currentTier = this.nextTier;
      this.nextTier = this.thenTier;
      this.thenTier = this.getRandomInitialTier();
      this.updateNextBallUI();
    }

    private updateSplashGrains(dt: number) {
      if (this.splashGrains.length === 0) return;
      const W = this.gridCols;
      const gravity = 0.09;

      for (let i = this.splashGrains.length - 1; i >= 0; i--) {
        const sp = this.splashGrains[i];
        sp.vy += gravity;
        sp.x += sp.vx;
        sp.y += sp.vy;

        // Wall collisions
        if (sp.x <= this.wallLeft + 1) {
          sp.x = this.wallLeft + 1.2;
          sp.vx = -sp.vx * 0.5;
        } else if (sp.x >= this.wallRight - 1) {
          sp.x = this.wallRight - 1.2;
          sp.vx = -sp.vx * 0.5;
        }

        // Check if landing into sand pile or floor
        const gx = Math.round(sp.x);
        const gy = Math.round(sp.y);

        let settled = false;
        if (gy >= this.floorY - 1) {
          settled = true;
        } else if (gy > 0 && gx > this.wallLeft && gx < this.wallRight) {
          const idx = gy * W + gx;
          if (this.grid[idx] !== 0) {
            settled = true;
          }
        }

        if (settled) {
          let placed = false;
          const clampedX = Math.max(this.wallLeft + 1, Math.min(this.wallRight - 1, gx));
          const searchY = Math.min(this.floorY - 1, Math.max(1, gy));

          // Place in highest available empty cell in current or adjacent columns
          for (let sy = searchY; sy >= 1; sy--) {
            const cIdx = sy * W + clampedX;
            if (this.grid[cIdx] === 0) {
              this.grid[cIdx] = sp.tier;
              this.gridBatch[cIdx] = sp.batchId;
              this.gridFlash[cIdx] = 0;
              placed = true;
              break;
            }
          }

          if (!placed) {
            for (let dx = -1; dx <= 1 && !placed; dx += 2) {
              const adjX = clampedX + dx;
              if (adjX > this.wallLeft && adjX < this.wallRight) {
                for (let sy = searchY; sy >= 1; sy--) {
                  const aIdx = sy * W + adjX;
                  if (this.grid[aIdx] === 0) {
                    this.grid[aIdx] = sp.tier;
                    this.gridBatch[aIdx] = sp.batchId;
                    this.gridFlash[aIdx] = 0;
                    placed = true;
                    break;
                  }
                }
              }
            }
          }

          this.splashGrains.splice(i, 1);
        }
      }
    }

    // ========================================================================
    // CELLULAR AUTOMATA SAND SIMULATION
    // ========================================================================
    private updateSandPhysics() {
      this.gridFlags.fill(0);
      const W = this.gridCols;
      const H = this.gridRows;
      let tumbleCount = 0;

      // Scan from bottom row to top row so falling sand doesn't teleport
      for (let y = this.floorY - 1; y >= 1; y--) {
        // Alternate left-to-right / right-to-left scan to avoid slope bias
        const leftToRight = (y % 2 === 0);
        const startX = leftToRight ? this.wallLeft + 1 : this.wallRight - 1;
        const endX = leftToRight ? this.wallRight : this.wallLeft;
        const step = leftToRight ? 1 : -1;

        for (let x = startX; x !== endX; x += step) {
          const idx = y * W + x;
          const grain = this.grid[idx];

          // If not sand or already updated this frame
          if (grain === 0 || grain > 11 || this.gridFlags[idx] === 1) continue;

          const tierInfo = TIERS[grain - 1];
          const tumbleChance = tierInfo ? tierInfo.tumbleChance : 0.85;

          // 1. Check straight down
          const downIdx = (y + 1) * W + x;
          if (this.grid[downIdx] === 0) {
            this.grid[downIdx] = grain;
            this.gridBatch[downIdx] = this.gridBatch[idx];
            this.gridFlash[downIdx] = this.gridFlash[idx];

            this.grid[idx] = 0;
            this.gridBatch[idx] = 0;
            this.gridFlash[idx] = 0;

            this.gridFlags[downIdx] = 1;
            continue;
          }

          // 2. Check down-left and down-right with tier-specific tumbleChance
          if (Math.random() <= tumbleChance) {
            const dlIdx = (y + 1) * W + (x - 1);
            const drIdx = (y + 1) * W + (x + 1);
            const dlEmpty = (x > this.wallLeft + 1) && this.grid[dlIdx] === 0;
            const drEmpty = (x < this.wallRight - 1) && this.grid[drIdx] === 0;

            if (dlEmpty && drEmpty) {
              const pickLeft = Math.random() < 0.5;
              const target = pickLeft ? dlIdx : drIdx;
              this.grid[target] = grain;
              this.gridBatch[target] = this.gridBatch[idx];
              this.gridFlash[target] = this.gridFlash[idx];

              this.grid[idx] = 0;
              this.gridBatch[idx] = 0;
              this.gridFlash[idx] = 0;

              this.gridFlags[target] = 1;
              tumbleCount++;
              continue;
            } else if (dlEmpty) {
              this.grid[dlIdx] = grain;
              this.gridBatch[dlIdx] = this.gridBatch[idx];
              this.gridFlash[dlIdx] = this.gridFlash[idx];

              this.grid[idx] = 0;
              this.gridBatch[idx] = 0;
              this.gridFlash[idx] = 0;

              this.gridFlags[dlIdx] = 1;
              tumbleCount++;
              continue;
            } else if (drEmpty) {
              this.grid[drIdx] = grain;
              this.gridBatch[drIdx] = this.gridBatch[idx];
              this.gridFlash[drIdx] = this.gridFlash[idx];

              this.grid[idx] = 0;
              this.gridBatch[idx] = 0;
              this.gridFlash[idx] = 0;

              this.gridFlags[drIdx] = 1;
              tumbleCount++;
              continue;
            }
          }

          // 3. Natural avalanche tumble on steep multi-step cliffs
          const leftCliff = (x > this.wallLeft + 2) && this.grid[y * W + (x - 1)] === 0 && this.grid[(y + 1) * W + (x - 2)] === 0;
          const rightCliff = (x < this.wallRight - 2) && this.grid[y * W + (x + 1)] === 0 && this.grid[(y + 1) * W + (x + 2)] === 0;

          if (leftCliff && rightCliff) {
            const pickL = Math.random() < 0.5;
            const target = pickL ? (y * W + (x - 1)) : (y * W + (x + 1));
            this.grid[target] = grain;
            this.gridBatch[target] = this.gridBatch[idx];
            this.gridFlash[target] = this.gridFlash[idx];

            this.grid[idx] = 0;
            this.gridBatch[idx] = 0;
            this.gridFlash[idx] = 0;
            this.gridFlags[target] = 1;
            tumbleCount++;
          } else if (leftCliff && Math.random() < (tumbleChance * 0.55)) {
            const target = y * W + (x - 1);
            this.grid[target] = grain;
            this.gridBatch[target] = this.gridBatch[idx];
            this.gridFlash[target] = this.gridFlash[idx];

            this.grid[idx] = 0;
            this.gridBatch[idx] = 0;
            this.gridFlash[idx] = 0;
            this.gridFlags[target] = 1;
            tumbleCount++;
          } else if (rightCliff && Math.random() < (tumbleChance * 0.55)) {
            const target = y * W + (x + 1);
            this.grid[target] = grain;
            this.gridBatch[target] = this.gridBatch[idx];
            this.gridFlash[target] = this.gridFlash[idx];

            this.grid[idx] = 0;
            this.gridBatch[idx] = 0;
            this.gridFlash[idx] = 0;
            this.gridFlags[target] = 1;
            tumbleCount++;
          }
        }
      }

      // Check for significant Landslide / Avalanche event (only after sand has settled/not during pouring!)
      const now = performance.now();
      if (this.activeStream === null && tumbleCount >= 42 && (now - this.lastLandslideTime > 3500)) {
        this.triggerLandslide(tumbleCount);
      }
    }

    private triggerLandslide(grainsShifted: number) {
      this.lastLandslideTime = performance.now();
      this.landslidesCount++;
      this.sound.playLandslide();
      const bonus = 250;
      this.score += bonus;
      this.scoreEl.textContent = this.score.toLocaleString();
      this.saveScore();
      this.cameraShake = Math.max(this.cameraShake, 3.2);

      this.addFloatingBanner(
        '⚠️ 모래사태! (LANDSLIDE)',
        `대규모 이동 (${grainsShifted} grains) +250 PTS`,
        '#ffd32a',
        80,
        70
      );
    }

    // ========================================================================
    // FLOWING SAND POURING STREAM & INSTANT SURFACE CRUMBLING SIMULATION
    // ========================================================================
    private updatePouringStream(dt: number) {
      if (!this.activeStream) return;
      const stream = this.activeStream;
      const W = this.gridCols;
      const H = this.gridRows;
      const tierInfo = TIERS[stream.tier - 1];

      // 1. Dispense stream grains from the hopper nozzle
      if (!stream.isFinishedSpawning) {
        // Dispense over ~50 frames for smooth, liquid-like pouring flow (capped to prevent flash dumping)
        const spawnChunk = Math.max(2, Math.min(14, Math.ceil(stream.totalGrains / 50)));
        const toSpawn = Math.min(spawnChunk, stream.totalGrains - stream.grainsSpawned);
        const nozzleWidth = Math.min(6.0, Math.max(1.8, stream.radius * 0.35));

        for (let i = 0; i < toSpawn; i++) {
          const offsetX = (Math.random() - 0.5) * nozzleWidth;
          const shade = Math.floor(Math.random() * 32) - 16;
          stream.grains.push({
            x: stream.startX + offsetX,
            y: stream.startY + Math.random() * 1.5,
            vx: (Math.random() - 0.5) * 0.35,
            vy: 2.2 + Math.random() * 1.5,
            tier: stream.tier,
            batchId: stream.batchId,
            shade
          });
        }

        stream.grainsSpawned += toSpawn;
        if (Math.random() < 0.55) {
          this.sound.playPourTrickle();
        }

        if (stream.grainsSpawned >= stream.totalGrains) {
          stream.isFinishedSpawning = true;
        }
      }

      // 2. Simulate flying and flowing sand grains in the air
      const gravity = 0.22;
      for (let i = stream.grains.length - 1; i >= 0; i--) {
        const g = stream.grains[i];
        g.vy = Math.min(6.5, g.vy + gravity);
        g.vx *= 0.98;

        const prevY = g.y;
        g.x += g.vx;
        g.y += g.vy;

        // Container boundary clamping
        if (g.x <= this.wallLeft + 1) {
          g.x = this.wallLeft + 1.2;
          g.vx = Math.abs(g.vx) * 0.3;
        } else if (g.x >= this.wallRight - 1) {
          g.x = this.wallRight - 1.2;
          g.vx = -Math.abs(g.vx) * 0.3;
        }

        const gx = Math.round(g.x);
        let landed = false;
        let landY = Math.round(g.y);

        // Raycast down from previous position to detect surface contact
        const startY = Math.max(0, Math.floor(prevY));
        const endY = Math.min(this.floorY, Math.ceil(g.y));

        for (let y = startY; y <= endY; y++) {
          if (y >= this.floorY) {
            landed = true;
            landY = this.floorY - 1;
            break;
          }
          if (gx > this.wallLeft && gx < this.wallRight && y >= 0 && y < this.gridRows) {
            if (this.grid[y * W + gx] > 0) {
              landed = true;
              landY = y - 1;
              break;
            }
          }
        }

        if (landed) {
          // INSTANTLY CRUMBLE INTO CELLULAR AUTOMATA SAND GRID (Spreads horizontally into dunes)
          let placed = false;
          const candidateSpots = [
            { dx: 0, dy: 0 },
            { dx: -1, dy: 0 }, { dx: 1, dy: 0 },
            { dx: -2, dy: 0 }, { dx: 2, dy: 0 },
            { dx: -3, dy: 0 }, { dx: 3, dy: 0 },
            { dx: 0, dy: -1 },
            { dx: -1, dy: -1 }, { dx: 1, dy: -1 },
            { dx: -2, dy: -1 }, { dx: 2, dy: -1 },
            { dx: 0, dy: -2 }
          ];

          for (const spot of candidateSpots) {
            const tx = gx + spot.dx;
            const ty = landY + spot.dy;
            if (tx > this.wallLeft && tx < this.wallRight && ty > 0 && ty < this.floorY) {
              const tIdx = ty * W + tx;
              if (this.grid[tIdx] === 0) {
                this.grid[tIdx] = g.tier;
                this.gridBatch[tIdx] = g.batchId;
                this.gridFlash[tIdx] = 0;
                placed = true;
                break;
              }
            }
          }

          // If local hollows are packed, stack neatly atop the column
          if (!placed) {
            for (let ty = landY; ty >= Math.max(1, landY - 12); ty--) {
              const tIdx = ty * W + gx;
              if (this.grid[tIdx] === 0) {
                this.grid[tIdx] = g.tier;
                this.gridBatch[tIdx] = g.batchId;
                this.gridFlash[tIdx] = 0;
                placed = true;
                break;
              }
            }
          }

          // Subtle landing dust spray and soft impact bounce
          if (Math.random() < 0.12 && tierInfo) {
            this.sparkles.push({
              x: gx,
              y: landY,
              vx: (Math.random() - 0.5) * 1.6,
              vy: -Math.random() * 1.2 - 0.2,
              color: tierInfo.baseColor,
              alpha: 0.9,
              size: Math.random() * 1.8 + 0.8,
              life: 0.5
            });
          }

          // Airborne splash grain for higher impact speed
          if (g.vy > 4.5 && Math.random() < 0.08 && this.splashGrains.length < 24) {
            this.splashGrains.push({
              x: gx,
              y: landY,
              vx: (Math.random() - 0.5) * 1.8,
              vy: -Math.random() * 1.4 - 0.4,
              tier: g.tier,
              batchId: g.batchId
            });
          }

          stream.grains.splice(i, 1);
        }
      }

      // Stream fully poured and settled
      if (stream.isFinishedSpawning && stream.grains.length === 0) {
        this.activeStream = null;
        this.dropCooldown = 1000; // 1.0s delay between pourings to allow sand to flow & settle
      }
    }

    // ========================================================================
    // SAME-TIER CONTACT MERGE SYSTEM (COOLDOWN PROTECTED & GLEAM FLASH)
    // ========================================================================
    private checkContactIgnition() {
      // Sand can only upgrade once pouring is completely finished!
      if (this.activeStream !== null) return;

      const W = this.gridCols;
      const H = this.gridRows;
      const now = performance.now();
      // New stamp each frame: every cluster is flood-filled at most once per frame
      const stamp = ++this.clusterStamp;

      // Clean old cooldown entries periodically
      if (this.batchMergeCooldown.size > 200) {
        for (const [bId, exp] of this.batchMergeCooldown.entries()) {
          if (now > exp) this.batchMergeCooldown.delete(bId);
        }
      }

      for (let y = this.floorY - 1; y >= 2; y--) {
        for (let x = this.wallLeft + 1; x < this.wallRight; x++) {
          const idx = y * W + x;
          const grain = this.grid[idx];
          if (grain < 1 || grain > 11) continue;
          if (this.clusterVisit[idx] === stamp) continue; // cluster already examined this frame

          const batchA = this.gridBatch[idx];
          if (batchA === 0) continue;
          const cdA = this.batchMergeCooldown.get(batchA) || 0;
          if (now < cdA) continue;

          // Check adjacent neighbors (Right, Down, Down-Right, Down-Left)
          const neighbors = [
            y * W + (x + 1),
            (y + 1) * W + x,
            (y + 1) * W + (x + 1),
            (y + 1) * W + (x - 1)
          ];

          for (const nIdx of neighbors) {
            if (this.clusterVisit[idx] === stamp) break; // whole cluster examined via an earlier neighbor
            if (nIdx >= 0 && nIdx < W * H) {
              const nGrain = this.grid[nIdx];
              if (nGrain === grain) {
                const batchB = this.gridBatch[nIdx];
                if (batchB > 0 && batchB !== batchA) {
                  const cdB = this.batchMergeCooldown.get(batchB) || 0;
                  if (now < cdB) continue;

                  // Contact between matching tiers of different batches!
                  const cluster = this.gatherMergeCluster(grain, idx, nIdx, stamp);
                  const tierInfo = TIERS[grain - 1];
                  const minMass = tierInfo ? tierInfo.minMergeGrains : 65;

                  // 1. Critical Mass Requirement: Must have enough volume
                  if (cluster.length < minMass) continue;

                  // 2. Multi-Batch Balance: at least two batches must each contribute >= 20%
                  //    (computed over the whole cluster so the result doesn't depend on the start cell)
                  const minContribution = Math.max(12, Math.floor(minMass * 0.20));
                  const batchCounts = new Map<number, number>();
                  for (let c = 0; c < cluster.length; c++) {
                    const bId = this.gridBatch[cluster[c]];
                    batchCounts.set(bId, (batchCounts.get(bId) || 0) + 1);
                  }
                  let contributingBatches = 0;
                  for (const count of batchCounts.values()) {
                    if (count >= minContribution) contributingBatches++;
                  }
                  if (contributingBatches < 2) continue;

                  // 3. Stabilization Delay: Ensure no grain in the cluster is in active cooldown
                  let clusterHasCooldown = false;
                  for (let c = 0; c < cluster.length; c++) {
                    const bId = this.gridBatch[cluster[c]];
                    if (bId > 0 && (this.batchMergeCooldown.get(bId) || 0) > now) {
                      clusterHasCooldown = true;
                      break;
                    }
                  }
                  if (clusterHasCooldown) continue;

                  this.mergeClusters(grain, cluster);
                  return; // Crucial: Process at most 1 merge per frame to prevent runaway loops
                }
              }
            }
          }
        }
      }
    }

    private gatherMergeCluster(tier: number, startA: number, startB: number, stamp: number): number[] {
      const W = this.gridCols;
      const cluster: number[] = [];
      const visited = this.clusterVisit;
      const queue: number[] = [startA, startB];

      visited[startA] = stamp;
      visited[startB] = stamp;

      while (queue.length > 0) {
        const curr = queue.pop()!;
        cluster.push(curr);

        const cx = curr % W;
        const cy = Math.floor(curr / W);

        for (let dy = -1; dy <= 1; dy++) {
          for (let dx = -1; dx <= 1; dx++) {
            if (dx === 0 && dy === 0) continue;
            const nx = cx + dx;
            const ny = cy + dy;

            if (nx > this.wallLeft && nx < this.wallRight && ny > 0 && ny < this.floorY) {
              const nIdx = ny * W + nx;
              if (visited[nIdx] !== stamp && this.grid[nIdx] === tier) {
                visited[nIdx] = stamp;
                queue.push(nIdx);
              }
            }
          }
        }
      }

      return cluster;
    }

    private mergeClusters(fromTier: number, cluster: number[]) {
      if (cluster.length === 0) return;
      const targetTier = fromTier + 1;

      // Check if merge occurred under danger threat -> EMERGENCY CLEAR CLUTCH BONUS!
      if (this.isOverDangerLine) {
        this.triggerEmergencyClear();
      }

      // Max Tier Grand Clear (Tier 11 + Tier 11 -> AURORA GRAVITATIONAL COLLAPSE)
      if (fromTier >= 11) {
        this.sound.playAuroraCollapse();
        const points = 10000 * Math.max(1, this.combo);
        this.score += points;
        this.scoreEl.textContent = this.score.toLocaleString();
        this.saveScore();

        this.combo++;
        this.comboTimer = 3.5;
        this.showCombo();

        // Calculate centroid of the Aurora cluster
        let sumX = 0, sumY = 0;
        for (const idx of cluster) {
          sumX += idx % this.gridCols;
          sumY += Math.floor(idx / this.gridCols);
        }
        const cx = Math.round(sumX / cluster.length);
        const cy = Math.round(sumY / cluster.length);

        // Black Hole Gravitational Collapse: vaporize surrounding sand within radius 32
        const vacuumRadius = 32;
        for (let dy = -vacuumRadius; dy <= vacuumRadius; dy++) {
          for (let dx = -vacuumRadius; dx <= vacuumRadius; dx++) {
            if (dx * dx + dy * dy <= vacuumRadius * vacuumRadius) {
              const nx = cx + dx;
              const ny = cy + dy;
              if (nx > this.wallLeft && nx < this.wallRight && ny > 0 && ny < this.floorY) {
                const vIdx = ny * this.gridCols + nx;
                if (this.grid[vIdx] > 0 && this.grid[vIdx] <= 11) {
                  this.grid[vIdx] = 0;
                  this.gridBatch[vIdx] = 0;
                  this.gridFlash[vIdx] = 0;
                }
              }
            }
          }
        }

        this.cameraShake = 12.0;
        this.addFloatingBanner(
          '👑 AURORA COLLAPSE!',
          '+10,000 PTS (중력 붕괴 진공 소멸)',
          '#f1f5f9',
          cx,
          Math.max(35, cy - 20)
        );

        // Cosmic Rainbow Sparkles
        const rainbowColors = ['#ff0055', '#ff9900', '#ffff00', '#00ff88', '#00ccff', '#cc00ff', '#ffffff'];
        for (let i = 0; i < 60; i++) {
          this.sparkles.push({
            x: cx + (Math.random() - 0.5) * 16,
            y: cy + (Math.random() - 0.5) * 16,
            vx: (Math.random() - 0.5) * 5.5,
            vy: -Math.random() * 5.0 - 1.0,
            color: rainbowColors[Math.floor(Math.random() * rainbowColors.length)],
            alpha: 1,
            size: Math.random() * 4 + 2,
            life: 1.8
          });
        }
        return;
      }

      const targetInfo = TIERS[targetTier - 1];
      if (!targetInfo) return;

      if (targetTier > this.maxTierReached) {
        this.maxTierReached = targetTier;
      }

      this.sound.playMergeChime(targetTier, this.combo);
      const points = fromTier * 120 * Math.max(1, this.combo);
      this.score += points;
      this.scoreEl.textContent = this.score.toLocaleString();
      this.saveScore();

      this.combo++;
      this.comboTimer = 2.5;
      this.showCombo();

      const newBatch = ++this.currentBatchId;
      // 2500ms (2.5 seconds) delay prevents continuous auto-upgrading itself
      this.batchMergeCooldown.set(newBatch, performance.now() + 2500);

      // Volume condensation (~16% top grains evaporate into score sparkles)
      cluster.sort((a, b) => a - b);
      const evaporateCount = Math.floor(cluster.length * 0.16);

      for (let i = 0; i < cluster.length; i++) {
        const idx = cluster[i];
        const gx = idx % this.gridCols;
        const gy = Math.floor(idx / this.gridCols);

        if (i < evaporateCount) {
          this.grid[idx] = 0;
          this.gridBatch[idx] = 0;
          this.gridFlash[idx] = 0;
          if (Math.random() < 0.35) {
            this.sparkles.push({
              x: gx,
              y: gy,
              vx: (Math.random() - 0.5) * 1.8,
              vy: -Math.random() * 2.2 - 0.5,
              color: '#ffffff',
              alpha: 1,
              size: Math.random() * 2.5 + 1.5,
              life: 0.8
            });
          }
        } else {
          this.grid[idx] = targetTier;
          this.gridBatch[idx] = newBatch;
          this.gridFlash[idx] = 150; // 150-frame (~2.5s) gleam & stabilization aura
        }
      }

      // Target tier celebration sparkles
      for (let i = 0; i < 16; i++) {
        const randIdx = cluster[Math.floor(Math.random() * cluster.length)];
        this.sparkles.push({
          x: randIdx % this.gridCols,
          y: Math.floor(randIdx / this.gridCols),
          vx: (Math.random() - 0.5) * 2.5,
          vy: -Math.random() * 2.5,
          color: targetInfo.baseColor,
          alpha: 1,
          size: Math.random() * 2.5 + 1.2,
          life: 0.8
        });
      }
    }

    private triggerEmergencyClear() {
      this.emergencyClearsCount++;
      this.sound.playEmergencyClear();
      this.dangerCounter = 0;
      this.isOverDangerLine = false;
      this.dangerTagEl.classList.remove('danger-active');
      this.dangerTimerEl.classList.add('hidden');
      const clutchBonus = 500;
      this.score += clutchBonus;
      this.scoreEl.textContent = this.score.toLocaleString();
      this.saveScore();

      this.addFloatingBanner(
        '🚨 EMERGENCY CLEAR!',
        `위기 탈출 클러치 성공! +${clutchBonus} PTS`,
        '#2ed573',
        80,
        45
      );
    }

    private showCombo() {
      this.maxComboReached = Math.max(this.maxComboReached, this.combo);
      if (this.combo >= 2) {
        this.comboBadgeEl.classList.remove('hidden');
        this.comboTextEl.textContent = `${this.combo}x COMBO!`;

        let title = 'DOUBLE MERGE';
        if (this.combo === 3) title = 'CHAIN REACTION!';
        else if (this.combo === 4) title = 'MEGA CHAIN!!';
        else if (this.combo >= 5) title = '🌪️ SANDSTORM!!';

        if (this.comboTitleEl) {
          this.comboTitleEl.textContent = title;
        }
        if (this.comboBarFillEl) {
          this.comboBarFillEl.style.width = '100%';
        }
      }
    }

    // ========================================================================
    // DANGER LINE & GAME OVER MONITOR
    // ========================================================================
    private updateDangerLine(dt: number) {
      if (this.isGameOver) return;

      // While actively pouring a stream, ignore danger limit to allow high-volume sand to flow and disperse
      if (this.activeStream !== null) {
        return;
      }

      // Count solid resting sand grains settled above the danger line (y <= dangerRow)
      let grainsAboveLine = 0;
      const W = this.gridCols;
      // Require a genuine accumulated sand pile (24 grains) to prevent false alarms from stray flecks
      const dangerThreshold = 24;

      for (let y = this.dangerRow; y >= 2; y--) {
        for (let x = this.wallLeft + 1; x < this.wallRight; x++) {
          const val = this.grid[y * W + x];
          if (val > 0 && val <= 11) {
            grainsAboveLine++;
          }
        }
      }

      const isDangerState = grainsAboveLine >= dangerThreshold;

      if (isDangerState) {
        this.isOverDangerLine = true;
        // Timer continues counting down without restarting on pour (no reset exploit!)
        this.dangerCounter += dt * 0.001; // in seconds
        this.dangerTagEl.classList.add('danger-active');
        this.dangerTimerEl.classList.remove('hidden');

        // 10.0-second timer gives ample time for sand to flow, tumble, and merge
        const remaining = Math.max(0, 10.0 - this.dangerCounter);
        this.dangerTimerEl.textContent = remaining.toFixed(1) + 's';

        if (this.dangerCounter >= 10.0) {
          this.triggerGameOver();
        }
      } else {
        this.isOverDangerLine = false;
        this.dangerCounter = 0;
        this.dangerTagEl.classList.remove('danger-active');
        this.dangerTimerEl.classList.add('hidden');
      }
    }

    private triggerGameOver() {
      this.isGameOver = true;
      this.sound.playGameOver();
      this.finalScoreValEl.textContent = this.score.toLocaleString();
      this.modalBestValEl.textContent = this.bestScore.toLocaleString();
      const maxInfo = TIERS[this.maxTierReached - 1] || TIERS[0];
      this.modalMaxTierEl.textContent = `${maxInfo.emoji} ${maxInfo.name} (Tier ${maxInfo.tier})`;
      if (this.modalMaxComboEl) this.modalMaxComboEl.textContent = `${this.maxComboReached}x`;
      if (this.modalLandslidesEl) this.modalLandslidesEl.textContent = `${this.landslidesCount}회`;
      if (this.modalEmergencyEl) this.modalEmergencyEl.textContent = `${this.emergencyClearsCount}회`;
      this.gameOverModalEl.classList.remove('hidden');
    }

    // ========================================================================
    // RENDERING
    // ========================================================================
    private render() {
      const W = this.viewW;
      const H = this.viewH;
      const scaleX = W / this.gridCols;
      const scaleY = H / this.gridRows;

      this.ctx.save();
      if (this.cameraShake > 0.05) {
        const shakeX = (Math.random() - 0.5) * this.cameraShake * 1.8;
        const shakeY = (Math.random() - 0.5) * this.cameraShake * 1.8;
        this.ctx.translate(shakeX, shakeY);
        this.cameraShake *= 0.85;
      } else {
        this.cameraShake = 0;
      }

      // 1. Clear Backdrop
      this.ctx.fillStyle = '#090e1a';
      this.ctx.fillRect(0, 0, W, H);

      // 2. Draw Sand Jar Walls
      this.ctx.fillStyle = '#1e293b';
      // Left border
      this.ctx.fillRect(0, 0, (this.wallLeft + 1) * scaleX, H);
      // Right border
      this.ctx.fillRect(this.wallRight * scaleX, 0, (this.gridCols - this.wallRight) * scaleX, H);
      // Floor
      this.ctx.fillRect(0, this.floorY * scaleY, W, (this.gridRows - this.floorY) * scaleY);

      // Glowing Glass Container Inset Bevel
      this.ctx.strokeStyle = 'rgba(255, 255, 255, 0.12)';
      this.ctx.lineWidth = 2;
      this.ctx.strokeRect(
        (this.wallLeft + 1) * scaleX,
        2,
        (this.wallRight - (this.wallLeft + 1)) * scaleX,
        (this.floorY - 2) * scaleY
      );

      // 3. Draw Sand Grains (one pixel per cell, then scaled up with nearest-neighbour)
      const pixels = this.sandImage.data;
      pixels.fill(0);
      for (let y = 0; y < this.floorY; y++) {
        for (let x = this.wallLeft + 1; x < this.wallRight; x++) {
          const idx = y * this.gridCols + x;
          const grain = this.grid[idx];
          if (grain >= 1 && grain <= 11) {
            const tierInfo = TIERS[grain - 1];
            let r = tierInfo.rgb[0];
            let g = tierInfo.rgb[1];
            let b = tierInfo.rgb[2];

            const flash = this.gridFlash[idx];
            if (flash > 0) {
              if (flash > 80) {
                // Gleam burst fading from white (frames 150 -> 80, ~1.2s at 60 steps/s)
                const flashRatio = (flash - 80) / 70;
                r = Math.min(255, Math.round(r + (255 - r) * flashRatio));
                g = Math.min(255, Math.round(g + (255 - g) * flashRatio));
                b = Math.min(255, Math.round(b + (255 - b) * flashRatio));
              } else {
                // Gentle pulsing cooldown aura (frames 80 -> 0, ~1.3s remaining of the 2.5s cooldown)
                const pulse = Math.sin(flash * 0.22) * 0.25 + 0.25;
                r = Math.min(255, Math.round(r + (255 - r) * pulse * 0.6));
                g = Math.min(255, Math.round(g + (255 - g) * pulse * 0.6));
                b = Math.min(255, Math.round(b + (255 - b) * pulse * 0.6));
              }
            } else {
              // Subtle grain noise variation for natural matte sand texture
              const noise = ((x ^ y) % 5) * 4 - 8;
              r = Math.min(255, Math.max(0, r + noise));
              g = Math.min(255, Math.max(0, g + noise));
              b = Math.min(255, Math.max(0, b + noise));
            }

            const p = idx * 4;
            pixels[p] = r;
            pixels[p + 1] = g;
            pixels[p + 2] = b;
            pixels[p + 3] = 255;
          }
        }
      }
      this.sandLayerCtx.putImageData(this.sandImage, 0, 0);
      this.ctx.imageSmoothingEnabled = false;
      this.ctx.drawImage(this.sandLayer, 0, 0, W, H);

      // 3.5 Draw Physical Airborne Splash Grains
      for (let i = 0; i < this.splashGrains.length; i++) {
        const sg = this.splashGrains[i];
        const tInfo = TIERS[sg.tier - 1];
        if (!tInfo) continue;
        const sx = sg.x * scaleX;
        const sy = sg.y * scaleY;

        this.ctx.fillStyle = tInfo.baseColor;
        this.ctx.fillRect(
          Math.floor(sx),
          Math.floor(sy),
          Math.ceil(scaleX * 1.3),
          Math.ceil(scaleY * 1.3)
        );

        // Specular glow dot
        this.ctx.fillStyle = 'rgba(255, 255, 255, 0.75)';
        this.ctx.fillRect(Math.floor(sx), Math.floor(sy), 1.5, 1.5);
      }

      // 4. Draw Active Flowing Sand Stream Grains
      if (this.activeStream) {
        const stream = this.activeStream;
        const tierInfo = TIERS[stream.tier - 1];
        if (tierInfo) {
          const [br, bg, bb] = tierInfo.rgb;
          for (let i = 0; i < stream.grains.length; i++) {
            const sg = stream.grains[i];
            const sx = Math.floor(sg.x * scaleX);
            const sy = Math.floor(sg.y * scaleY);
            const r = Math.min(255, Math.max(0, br + sg.shade));
            const g = Math.min(255, Math.max(0, bg + sg.shade));
            const b = Math.min(255, Math.max(0, bb + sg.shade));

            // Stream grain with slight motion streak along vy
            this.ctx.fillStyle = `rgb(${r},${g},${b})`;
            const grainH = Math.max(Math.ceil(scaleY), Math.ceil(sg.vy * 0.45 * scaleY));
            this.ctx.fillRect(sx, sy, Math.ceil(scaleX * 1.15), grainH);
          }
        }
      }

      // 5. Draw Top Dropper & Laser Guide Line
      const isPouring = this.activeStream !== null;
      let pourRemainingRatio = 1.0;
      if (this.activeStream) {
        pourRemainingRatio = Math.max(0, 1 - (this.activeStream.grainsSpawned / this.activeStream.totalGrains));
      } else if (this.dropCooldown > 0) {
        // Smoothly grow back as hopper reloads over the 1.0-second settling delay
        pourRemainingRatio = Math.max(0, 1 - (this.dropCooldown / 1000));
      }

      this.dropper.render(
        this.ctx,
        scaleX,
        scaleY,
        this.currentTier,
        isPouring,
        pourRemainingRatio,
        this.isGameOver,
        this.wallLeft,
        this.wallRight,
        this.floorY,
        this.grid,
        this.gridCols,
        (cx, cy, tier, radius, sx, sy) => this.drawSandClump(cx, cy, tier, radius, sx, sy),
        this.isOverDangerLine
      );

      // 6. Draw Sparkle FX
      for (let i = 0; i < this.sparkles.length; i++) {
        const sp = this.sparkles[i];
        this.ctx.fillStyle = sp.color;
        this.ctx.globalAlpha = Math.max(0, Math.min(1, sp.alpha));
        this.ctx.beginPath();
        this.ctx.arc(sp.x * scaleX, sp.y * scaleY, sp.size, 0, Math.PI * 2);
        this.ctx.fill();
      }

      // 7. Draw Floating Banner Notifications
      for (let i = 0; i < this.floatingBanners.length; i++) {
        const b = this.floatingBanners[i];
        const bx = b.x * scaleX;
        const by = b.y * scaleY;

        this.ctx.save();
        this.ctx.globalAlpha = Math.min(1.0, Math.max(0, b.alpha));
        this.ctx.textAlign = 'center';

        // Title text
        this.ctx.font = 'bold 16px Outfit, "Pretendard", sans-serif';
        this.ctx.strokeStyle = 'rgba(0, 0, 0, 0.9)';
        this.ctx.lineWidth = 3.5;
        this.ctx.strokeText(b.text, bx, by);
        this.ctx.fillStyle = b.color;
        this.ctx.fillText(b.text, bx, by);

        // Subtext
        if (b.subText) {
          this.ctx.font = 'bold 11px Outfit, "Pretendard", sans-serif';
          this.ctx.strokeStyle = 'rgba(0, 0, 0, 0.85)';
          this.ctx.lineWidth = 2.5;
          this.ctx.strokeText(b.subText, bx, by + 16);
          this.ctx.fillStyle = '#ffffff';
          this.ctx.fillText(b.subText, bx, by + 16);
        }
        this.ctx.restore();
      }

      this.ctx.globalAlpha = 1.0;
      this.ctx.restore();
    }

    // ========================================================================
    // ORGANIC KINETIC SAND CLUMP RENDERING
    // ========================================================================
    private drawSandClump(
      cx: number,
      cy: number,
      tier: number,
      radius: number,
      scaleX: number,
      scaleY: number,
      squishX: number = 1,
      squishY: number = 1,
      grains?: SandGrainOffset[]
    ) {
      const tierInfo = TIERS[tier - 1];
      const [baseR, baseG, baseB] = tierInfo.rgb;
      const screenR = radius * scaleX;

      this.ctx.save();
      this.ctx.translate(cx, cy);
      this.ctx.scale(squishX, squishY);

      // 1. Organic Hand-Formed Clump Silhouette (Bumpy matte outline, not a solid sphere)
      this.ctx.beginPath();
      const steps = 36;
      for (let i = 0; i <= steps; i++) {
        const angle = (i / steps) * Math.PI * 2;
        const bump = 1.0 
          + 0.08 * Math.sin(angle * 5 + 0.3) 
          + 0.05 * Math.cos(angle * 8 + 1.1)
          + 0.03 * Math.sin(angle * 13);
        const pr = screenR * bump;
        const px = Math.cos(angle) * pr;
        const py = Math.sin(angle) * pr;
        if (i === 0) this.ctx.moveTo(px, py);
        else this.ctx.lineTo(px, py);
      }
      this.ctx.closePath();

      // Matte diffuse shading (powdery kinetic sand feel without shiny billiard highlight)
      const matteGrad = this.ctx.createRadialGradient(
        -screenR * 0.25, -screenR * 0.25, 0,
        0, 0, screenR * 1.15
      );
      matteGrad.addColorStop(0, `rgb(${Math.min(255, baseR + 32)}, ${Math.min(255, baseG + 32)}, ${Math.min(255, baseB + 32)})`);
      matteGrad.addColorStop(0.65, tierInfo.baseColor);
      matteGrad.addColorStop(1, `rgb(${Math.max(0, baseR - 55)}, ${Math.max(0, baseG - 55)}, ${Math.max(0, baseB - 55)})`);
      this.ctx.fillStyle = matteGrad;
      this.ctx.fill();

      // 2. Render Real Stippled Sand Grains (Speckles with shade variation)
      if (grains && grains.length > 0) {
        for (let i = 0; i < grains.length; i++) {
          const g = grains[i];
          if (g.dissolved) continue;

          const gx = g.dx * scaleX;
          const gy = g.dy * scaleY;
          const r = Math.min(255, Math.max(0, baseR + g.shade));
          const gr = Math.min(255, Math.max(0, baseG + g.shade));
          const b = Math.min(255, Math.max(0, baseB + g.shade));

          this.ctx.fillStyle = `rgb(${r},${gr},${b})`;
          this.ctx.fillRect(gx - 1, gy - 1, 2.4, 2.4);
        }
      } else {
        // Procedural sand speckling for cradle preview
        for (let dy = -radius + 1; dy <= radius - 1; dy += 2) {
          for (let dx = -radius + 1; dx <= radius - 1; dx += 2) {
            if (dx * dx + dy * dy <= (radius - 1) * (radius - 1)) {
              const hash = Math.sin(dx * 12.9898 + dy * 78.233) * 43758.5453;
              const shade = Math.floor((hash - Math.floor(hash)) * 32) - 16;
              const r = Math.min(255, Math.max(0, baseR + shade));
              const gr = Math.min(255, Math.max(0, baseG + shade));
              const b = Math.min(255, Math.max(0, baseB + shade));
              this.ctx.fillStyle = `rgb(${r},${gr},${b})`;
              this.ctx.fillRect(dx * scaleX - 1, dy * scaleY - 1, 2.2, 2.2);
            }
          }
        }
      }

      // 3. Loose Edge Flecks (Crumbly perimeter)
      this.ctx.fillStyle = `rgba(${baseR}, ${baseG}, ${baseB}, 0.9)`;
      for (let i = 0; i < 8; i++) {
        const angle = (i / 8) * Math.PI * 2 + 0.35;
        const dist = screenR * (1.02 + 0.05 * Math.sin(i * 4));
        this.ctx.fillRect(Math.cos(angle) * dist - 1, Math.sin(angle) * dist - 1, 2.2, 2.2);
      }

      this.ctx.restore();
    }

    // ========================================================================
    // PHYSICS STEP (FIXED 60HZ TIMESTEP)
    // ========================================================================
    private stepPhysics(dt: number) {
      if (this.dropCooldown > 0) {
        this.dropCooldown -= dt;
      }

      // Decrement merge flash gleam counters (150 steps @ 60Hz = exactly 2.5s)
      for (let i = 0; i < this.gridFlash.length; i++) {
        if (this.gridFlash[i] > 0) {
          this.gridFlash[i]--;
        }
      }

      // Update Combo Timer & Live Progress Bar
      if (this.comboTimer > 0) {
        this.comboTimer -= dt * 0.001;
        if (this.comboBarFillEl) {
          const pct = Math.max(0, Math.min(100, (this.comboTimer / 2.5) * 100));
          this.comboBarFillEl.style.width = `${pct}%`;
        }
        if (this.comboTimer <= 0) {
          this.combo = 0;
          this.comboBadgeEl.classList.add('hidden');
          if (this.comboBarFillEl) this.comboBarFillEl.style.width = '0%';
        }
      }

      // Update Floating Banners
      for (let i = this.floatingBanners.length - 1; i >= 0; i--) {
        const b = this.floatingBanners[i];
        b.y += b.vy;
        b.life -= dt * 0.001;
        b.alpha = Math.max(0, b.life / 1.9);
        if (b.life <= 0) {
          this.floatingBanners.splice(i, 1);
        }
      }

      // Update Sparkle FX Particles
      for (let i = this.sparkles.length - 1; i >= 0; i--) {
        const sp = this.sparkles[i];
        sp.x += sp.vx;
        sp.y += sp.vy;
        sp.alpha -= 0.025;
        if (sp.alpha <= 0) {
          this.sparkles.splice(i, 1);
        }
      }

      // 1. Update Sand Grid Cellular Automata
      this.updateSandPhysics();

      // 2. Update Active Flowing Sand Pouring Stream
      this.updatePouringStream(dt);

      // 2.5 Update Physical Airborne Splash Grains
      this.updateSplashGrains(dt);

      // 3. Check for Same-Tier Contact Merge
      this.checkContactIgnition();

      // 4. Monitor Danger Line
      this.updateDangerLine(dt);
    }

    // ========================================================================
    // MAIN LOOP (FIXED 60HZ ACCUMULATOR + HIGH-FPS RENDER)
    // ========================================================================
    private loop(time: number) {
      const dt = Math.min(100, time - this.lastFrameTime);
      this.lastFrameTime = time;
      this.physicsAccumulator += dt;

      // Update Dropper position smoothing per visual frame for instant responsiveness
      const curRadius = TIERS[this.currentTier - 1]?.radius || 5;
      this.dropper.update(dt, curRadius, this.wallLeft, this.wallRight);

      // Fixed 60Hz physics stepping (~16.67ms per step)
      const FIXED_STEP = 1000 / 60;
      let subSteps = 0;
      while (this.physicsAccumulator >= FIXED_STEP && subSteps < 4) {
        this.stepPhysics(FIXED_STEP);
        this.physicsAccumulator -= FIXED_STEP;
        subSteps++;
      }
      if (this.physicsAccumulator > FIXED_STEP * 2) {
        this.physicsAccumulator = 0; // Prevent spiral of death on long tab stalls
      }

      // Render Everything
      this.render();

      this.animationId = requestAnimationFrame(this.loop);
    }
  }

  // Auto-mount game on page ready
  document.addEventListener('DOMContentLoaded', () => {
    new SandSuikaGame();
  });
</script>
