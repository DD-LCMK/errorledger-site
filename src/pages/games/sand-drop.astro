---
import GameLayout from '../../layouts/GameLayout.astro';
import { getEntry } from 'astro:content';

const gameEntry = await getEntry('games', 'sand-drop');
const data = gameEntry?.data || {
  title: '모래 드롭 (Sand Drop)',
  tagline: '원하는 위치에 모래를 떨어뜨려 융합하는 모래 물리 낙하 머지 퍼즐',
  description: '스르륵 흘러내리는 고운 모래의 유체 역학 물리 시뮬레이션! 모래를 떨어뜨려 같은 색 모래를 맞추고, 상위 티어로 융합하여 최고 티어 오로라를 완성해보세요.',
  icon: '🍉',
  category: 'arcade',
  badge: '🔥 NEW 물리퍼즐',
  players: '1인 (스코어 랭킹)',
  playTime: '3분~15분',
  controls: [
    '마우스 좌우 이동 또는 화면 터치로 드롭 위치 조절',
    '마우스 클릭 또는 화면 탭으로 모래 스트림 붓기',
    '스페이스바(Space) 또는 좌우 방향키로 조작 가능'
  ],
  rules: [
    '상단에서 드롭된 모래는 표면에 닿는 즉시 스르륵 무너져 자연스러운 모래 언덕을 형성합니다.',
    '착지 순간 표면 모래가 튀어 오르는 스플래시 입자(Splash Grains)와 충격 진동이 발생합니다.',
    '같은 색상(티어)의 모래가 서로 닿으면 은은한 섬광과 함께 상위 티어로 깔끔하게 융합(Merge)됩니다.',
    '융합 시 상단 모래가 일부 압축 증발하여 공간이 확보되고 연속 콤보 보너스가 발동합니다.',
    '상단 붉은색 데인저 라인(Danger Line) 위로 모래가 10초 이상 쌓이면 게임 오버! (투하 중에는 타이머 정지)'
  ],
  faqItems: [
    {
      q: '모래가 너무 빨리 쌓여서 넘치면 어떻게 하나요?',
      a: '같은 색 모래가 서로 연결되도록 드롭 위치를 조절해보세요! 융합이 일어날 때 모래가 압축되어 상단 공간이 여유로워집니다.'
    },
    {
      q: 'OBS 방송 화면에 배경 없이 띄울 수 있나요?',
      a: "주소 뒤에 '?bare=1' 또는 '?stream=true' 파라미터를 추가하면 불필요한 UI가 숨겨진 투명 방송 전용 모드로 실행됩니다."
    }
  ]
};
---

<GameLayout
  title={data.title}
  description={data.description}
  tagline={data.tagline}
  icon={data.icon}
  category={data.category}
  badge={data.badge}
  players={data.players}
  playTime={data.playTime}
  controls={data.controls}
  rules={data.rules}
  faqItems={data.faqItems}
  layoutMode="full"
  hideStageHeader={true}
  hideFooter={false}
>
  <div class="sand-suika-app-root" id="sand-app-root">
    <!-- Background Ambient Glow -->
    <div class="sand-ambient-backdrop"></div>

    <div class="sand-main-container">
      <!-- Top Brand Header Bar -->
      <div class="sand-top-header">
        <div class="brand-title-wrap">
          <span class="brand-icon-anim">🍉</span>
          <div class="brand-name-group">
            <span class="brand-name">SAND DROP</span>
            <span class="brand-badge-pill">모래 물리 머지</span>
          </div>
        </div>
        <div class="header-tagline">
          <span>모래를 떨어뜨려 같은 색을 융합하고 최고 티어 오로라를 완성하세요!</span>
        </div>
      </div>

      <!-- Main Game Canvas Wrapper -->
      <div class="game-stage-wrapper">
        <div class="canvas-mount-box" id="canvas-mount">
          <!-- Main Simulation Canvas -->
          <canvas id="sand-canvas" width="480" height="640"></canvas>

          <!-- Danger Line Warning Overlay -->
          <div class="danger-line-indicator" id="danger-line">
            <div class="danger-laser-beam"></div>
            <div class="danger-tag" id="danger-tag">
              <span class="warning-icon">⚠️</span>
              <span class="warning-text">DANGER LIMIT</span>
              <span class="danger-countdown hidden" id="danger-timer">10.0s</span>
            </div>
          </div>

          <!-- Dropper Indicator Overlay -->
          <div class="drop-hint" id="drop-hint">
            <div class="hint-hand-icon">👇</div>
            <span>마우스를 좌우로 움직이고 클릭하여 드롭!</span>
          </div>

          <!-- Game Over Modal Overlay -->
          <div class="sand-modal-overlay hidden" id="game-over-modal">
            <div class="sand-modal-card">
              <div class="modal-crown-icon">💥</div>
              <h2 class="modal-title">GAME OVER</h2>
              <p class="modal-sub">모래가 제한선을 초과하여 넘쳤습니다!</p>
              
              <div class="modal-score-board">
                <div class="score-metric">
                  <span class="metric-label">최종 점수</span>
                  <span class="metric-val" id="final-score-val">0</span>
                </div>
                <div class="score-metric">
                  <span class="metric-label">최고 기록</span>
                  <span class="metric-val highlight" id="modal-best-val">0</span>
                </div>
                <div class="score-metric">
                  <span class="metric-label">최고 도달 티어</span>
                  <span class="metric-val" id="modal-max-tier">🍋 레몬 샌드</span>
                </div>
                <div class="score-metric">
                  <span class="metric-label">최대 콤보</span>
                  <span class="metric-val highlight" id="modal-max-combo">0x</span>
                </div>
                <div class="score-metric">
                  <span class="metric-label">모래사태 횟수</span>
                  <span class="metric-val" id="modal-landslides">0회</span>
                </div>
                <div class="score-metric">
                  <span class="metric-label">위기 탈출</span>
                  <span class="metric-val highlight" id="modal-emergency">0회</span>
                </div>
              </div>

              <div class="modal-actions">
                <button type="button" class="btn-play-again" id="btn-restart">
                  <span>🔄 다시 도전하기</span>
                </button>
              </div>
            </div>
          </div>
        </div>

        <!-- Sidebar / Control Desk -->
        <aside class="sand-sidebar">
          <!-- Live Score & Record Panel (Right-side HUD) -->
          <div class="sand-card score-panel-card">
            <div class="score-grid-duo">
              <div class="sidebar-stat-box score-stat-box">
                <span class="stat-label">SCORE</span>
                <span class="stat-val score-glow" id="current-score-text">0</span>
              </div>
              <div class="sidebar-stat-box best-stat-box">
                <span class="stat-label">BEST</span>
                <span class="stat-val best-glow" id="best-score-text">0</span>
              </div>
            </div>

            <!-- Dynamic Combo Banner / Gauge -->
            <div class="combo-badge hidden" id="combo-badge">
              <div class="combo-badge-top">
                <span class="combo-count" id="combo-text">2x COMBO!</span>
                <span class="combo-title" id="combo-title">DOUBLE MERGE</span>
              </div>
              <div class="combo-bar-track">
                <div class="combo-bar-fill" id="combo-bar-fill"></div>
              </div>
            </div>
          </div>

          <!-- Next & Then Ball Card -->
          <div class="sand-card next-ball-card">
            <div class="card-header-mini">
              <span class="dot-indicator"></span>
              <span>UPCOMING SAND (NEXT & THEN)</span>
            </div>
            <div class="next-preview-box">
              <div class="next-ball-orb" id="next-ball-visual">
                <span class="ball-emoji" id="next-ball-emoji">🍋</span>
              </div>
              <div class="next-ball-info">
                <span class="preview-queue-tag">NEXT 1ST</span>
                <strong id="next-ball-name">레몬 샌드</strong>
                <span id="next-ball-tier">Tier 1</span>
              </div>
            </div>
            <div class="then-preview-row">
              <span class="then-label-badge">THEN 2ND ▶</span>
              <div class="then-ball-chip" id="then-ball-chip">
                <div class="then-orb" id="then-ball-visual">
                  <span class="then-emoji" id="then-ball-emoji">🍊</span>
                </div>
                <span class="then-ball-name" id="then-ball-name">오렌지 샌드 (T2)</span>
              </div>
            </div>
          </div>

          <!-- Tier Evolution Guide (2-Column Single Window 도감) -->
          <div class="sand-card evolution-card">
            <div class="card-header-mini">
              <span class="icon-small">✨</span>
              <span>모래 융합 티어 (11 Tiers)</span>
            </div>
            <div class="tier-grid" id="tier-list-container">
              <!-- Dynamically populated in 2 columns -->
            </div>
          </div>

          <!-- Utility Bar -->
          <div class="sand-card utility-card">
            <button type="button" class="btn-util" id="btn-toggle-sound" title="사운드 켜기/끄기">
              <span id="sound-icon">🔊</span>
              <span id="sound-text">사운드 ON</span>
            </button>
            <button type="button" class="btn-util btn-danger-soft" id="btn-manual-reset" title="게임 다시 시작">
              <span>🔄 리셋</span>
            </button>
          </div>
        </aside>
      </div>

      <!-- Quick Control Instruction Footer -->
      <div class="sand-controls-help">
        <span class="ctrl-chip">🖱️ <strong>위치 이동:</strong> 마우스 좌우 이동 / 화면 터치</span>
        <span class="ctrl-chip">🎯 <strong>모래 드롭:</strong> 클릭, 화면 탭 또는 [Space]</span>
        <span class="ctrl-chip">✨ <strong>모래 융합:</strong> 같은 색 모래가 닿으면 상위 티어로 융합</span>
      </div>
    </div>
  </div>
</GameLayout>

<style>
  /* ==========================================================================
     SAND SUIKA THEME & GLASSMORPHISM DESIGN SYSTEM
     ========================================================================== */
  .sand-suika-app-root {
    position: relative;
    width: 100%;
    min-height: calc(100vh - 70px);
    display: flex;
    justify-content: center;
    align-items: flex-start;
    padding: 1.5rem 1rem 3rem;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Noto Sans KR", sans-serif;
    color: #f1f2f6;
    background: radial-gradient(circle at 50% 10%, #1e1b4b 0%, #0f172a 45%, #080c16 100%);
    overflow-x: hidden;
    user-select: none;
    -webkit-user-select: none;
  }

  .sand-ambient-backdrop {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: 
      radial-gradient(circle at 20% 30%, rgba(255, 71, 87, 0.08) 0%, transparent 40%),
      radial-gradient(circle at 80% 40%, rgba(46, 213, 115, 0.08) 0%, transparent 40%),
      radial-gradient(circle at 50% 80%, rgba(112, 161, 255, 0.06) 0%, transparent 50%);
    z-index: 0;
  }

  .sand-main-container {
    position: relative;
    z-index: 1;
    width: 100%;
    max-width: 960px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.25rem;
  }

  /* TOP BRAND HEADER */
  .sand-top-header {
    width: 100%;
    max-width: 820px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.65rem 1.25rem;
    background: rgba(15, 23, 42, 0.65);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 16px;
    box-shadow: 0 8px 32px rgba(0, 0, 0, 0.35);
  }

  .brand-title-wrap {
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }

  .brand-name-group {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .brand-icon-anim {
    font-size: 1.6rem;
    filter: drop-shadow(0 0 10px rgba(46, 213, 115, 0.5));
    animation: pulseFloat 2.4s ease-in-out infinite;
  }

  .brand-name {
    margin: 0;
    font-size: 1.35rem;
    font-weight: 900;
    letter-spacing: 0.04em;
    background: linear-gradient(135deg, #ff4757 0%, #ff9f43 50%, #2ed573 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .brand-badge-pill {
    padding: 0.18rem 0.55rem;
    font-size: 0.68rem;
    font-weight: 800;
    color: #38bdf8;
    background: rgba(56, 189, 248, 0.12);
    border: 1px solid rgba(56, 189, 248, 0.3);
    border-radius: 999px;
    letter-spacing: 0.02em;
  }

  .header-tagline {
    font-size: 0.78rem;
    color: #94a3b8;
    font-weight: 500;
  }

  /* GAME STAGE WRAPPER */
  .game-stage-wrapper {
    width: 100%;
    display: flex;
    justify-content: center;
    align-items: flex-start;
    gap: 1.5rem;
  }

  .canvas-mount-box {
    position: relative;
    width: 480px;
    height: 640px;
    border-radius: 24px;
    background: #090e1a;
    border: 3px solid rgba(255, 255, 255, 0.15);
    box-shadow: 
      0 12px 48px rgba(0, 0, 0, 0.6),
      0 0 0 1px rgba(255, 255, 255, 0.05),
      inset 0 0 32px rgba(0, 0, 0, 0.8);
    overflow: hidden;
    touch-action: none;
    cursor: grab;
  }

  .canvas-mount-box:active {
    cursor: grabbing;
  }

  #sand-canvas {
    display: block;
    width: 100%;
    height: 100%;
    image-rendering: -webkit-optimize-contrast;
    image-rendering: crisp-edges;
    image-rendering: pixelated;
    touch-action: none;
  }

  /* DANGER LINE (Lowered to exactly 25% from top) */
  .danger-line-indicator {
    position: absolute;
    top: 25%;
    left: 0;
    right: 0;
    height: 20px;
    pointer-events: none;
    display: flex;
    align-items: center;
    z-index: 10;
  }

  .danger-laser-beam {
    position: absolute;
    left: 0;
    right: 0;
    height: 2px;
    background: repeating-linear-gradient(
      90deg,
      rgba(255, 71, 87, 0.8) 0px,
      rgba(255, 71, 87, 0.8) 8px,
      transparent 8px,
      transparent 14px
    );
    box-shadow: 0 0 8px rgba(255, 71, 87, 0.7);
  }

  .danger-tag {
    position: absolute;
    right: 12px;
    transform: translateY(-50%);
    display: flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.2rem 0.6rem;
    background: rgba(255, 71, 87, 0.2);
    border: 1px solid rgba(255, 71, 87, 0.5);
    border-radius: 6px;
    backdrop-filter: blur(8px);
    font-size: 0.68rem;
    font-weight: 700;
    color: #ff6b81;
    letter-spacing: 0.04em;
  }

  .danger-tag.danger-active {
    background: rgba(255, 71, 87, 0.85);
    color: #fff;
    border-color: #ff4757;
    animation: dangerStrobe 0.5s infinite alternate;
  }

  .danger-countdown {
    margin-left: 0.3rem;
    font-weight: 900;
    color: #fff;
    background: #c23616;
    padding: 0.1rem 0.35rem;
    border-radius: 4px;
  }

  /* DROP HINT OVERLAY */
  .drop-hint {
    position: absolute;
    top: 85px;
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.5rem 1rem;
    background: rgba(15, 23, 42, 0.85);
    border: 1px solid rgba(255, 255, 255, 0.15);
    border-radius: 999px;
    pointer-events: none;
    font-size: 0.82rem;
    font-weight: 600;
    color: #cbd5e1;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.4);
    transition: opacity 0.4s ease;
  }

  .hint-hand-icon {
    font-size: 1.1rem;
    animation: handPull 1.5s ease-in-out infinite;
  }

  /* MODAL OVERLAY */
  .sand-modal-overlay {
    position: absolute;
    inset: 0;
    background: rgba(8, 12, 22, 0.85);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    display: flex;
    justify-content: center;
    align-items: center;
    z-index: 50;
    padding: 1.5rem;
    animation: fadeIn 0.3s ease;
  }

  .sand-modal-card {
    width: 100%;
    max-width: 360px;
    background: rgba(30, 41, 59, 0.95);
    border: 1px solid rgba(255, 255, 255, 0.15);
    border-radius: 20px;
    padding: 2rem 1.75rem;
    text-align: center;
    box-shadow: 0 16px 48px rgba(0, 0, 0, 0.7);
  }

  .modal-crown-icon {
    font-size: 3rem;
    margin-bottom: 0.5rem;
    filter: drop-shadow(0 0 12px rgba(255, 71, 87, 0.6));
  }

  .modal-title {
    font-size: 1.8rem;
    font-weight: 900;
    color: #ff4757;
    margin-bottom: 0.35rem;
    letter-spacing: 0.05em;
  }

  .modal-sub {
    font-size: 0.88rem;
    color: #94a3b8;
    margin-bottom: 1.5rem;
  }

  .modal-score-board {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    background: rgba(15, 23, 42, 0.7);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 12px;
    padding: 1rem;
    margin-bottom: 1.5rem;
  }

  .score-metric {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .metric-label {
    font-size: 0.82rem;
    color: #94a3b8;
    font-weight: 600;
  }

  .metric-val {
    font-size: 1.25rem;
    font-weight: 800;
    color: #f1f2f6;
  }

  .metric-val.highlight {
    color: #2ed573;
  }

  .btn-play-again {
    width: 100%;
    padding: 0.9rem;
    background: linear-gradient(135deg, #ff4757 0%, #ff6b81 100%);
    border: none;
    border-radius: 12px;
    color: #fff;
    font-size: 1.05rem;
    font-weight: 800;
    cursor: pointer;
    box-shadow: 0 6px 20px rgba(255, 71, 87, 0.4);
    transition: transform 0.15s ease, box-shadow 0.15s ease;
  }

  .btn-play-again:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 24px rgba(255, 71, 87, 0.55);
  }

  .btn-play-again:active {
    transform: translateY(0);
  }

  /* SIDEBAR */
  .sand-sidebar {
    width: 310px;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .sand-card {
    background: rgba(15, 23, 42, 0.65);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 16px;
    padding: 0.85rem 1rem;
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.3);
  }

  /* SCORE PANEL CARD */
  .score-panel-card {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .score-grid-duo {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.55rem;
  }

  .sidebar-stat-box {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 0.45rem 0.6rem;
    border-radius: 12px;
    background: rgba(255, 255, 255, 0.035);
    border: 1px solid rgba(255, 255, 255, 0.07);
    transition: transform 0.15s ease;
  }

  .sidebar-stat-box:hover {
    background: rgba(255, 255, 255, 0.05);
  }

  .stat-label {
    font-size: 0.66rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    color: #94a3b8;
    margin-bottom: 2px;
  }

  .stat-val {
    font-size: 1.55rem;
    font-weight: 900;
    font-variant-numeric: tabular-nums;
    line-height: 1.1;
  }

  .score-glow {
    color: #ff9f43;
    text-shadow: 0 0 16px rgba(255, 159, 67, 0.45);
  }

  .best-glow {
    color: #2ed573;
    text-shadow: 0 0 16px rgba(46, 213, 115, 0.45);
  }

  .combo-badge {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.25rem;
    padding: 0.4rem 0.75rem;
    background: linear-gradient(135deg, rgba(255, 71, 87, 0.95), rgba(255, 107, 129, 0.95));
    border-radius: 10px;
    box-shadow: 0 0 16px rgba(255, 71, 87, 0.6);
    animation: comboPop 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275);
    width: 100%;
    margin-top: 0.15rem;
  }

  .combo-badge-top {
    display: flex;
    align-items: center;
    gap: 0.4rem;
  }

  .combo-count {
    font-size: 0.82rem;
    font-weight: 900;
    color: #fff;
    letter-spacing: 0.05em;
  }

  .combo-title {
    font-size: 0.66rem;
    font-weight: 800;
