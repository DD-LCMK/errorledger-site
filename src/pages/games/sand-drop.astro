<script>
  // ==========================================================================
  // SAND SUIKA: HIGH PERFORMANCE CELLULAR AUTOMATA DROP ENGINE
  // ==========================================================================

  interface SandTier {
    tier: number;
    name: string;
    emoji: string;
    baseColor: string;
    rgb: [number, number, number];
    radius: number; // in grid cells (generous volume)
    points: number;
    tumbleChance: number; // fluidity / angle of repose (1.0 = loose fine sand, 0.5 = heavy sticky sand)
    minMergeGrains: number; // critical pressure & mass threshold needed to crystallize into next tier
  }

  const TIERS: SandTier[] = [
    { tier: 1,  name: '레몬 샌드',     emoji: '🍋', baseColor: '#ffe600', rgb: [255, 230, 0],   radius: 7,  points: 10,   tumbleChance: 0.95, minMergeGrains: 65 },
    { tier: 2,  name: '오렌지 샌드',   emoji: '🍊', baseColor: '#ff6a00', rgb: [255, 106, 0],   radius: 9,  points: 25,   tumbleChance: 0.90, minMergeGrains: 120 },
    { tier: 3,  name: '사과 샌드',     emoji: '🍎', baseColor: '#ff1744', rgb: [255, 23, 68],   radius: 12, points: 50,   tumbleChance: 0.85, minMergeGrains: 220 },
    { tier: 4,  name: '복숭아 샌드',   emoji: '🌸', baseColor: '#ff2d95', rgb: [255, 45, 149],  radius: 15, points: 90,   tumbleChance: 0.82, minMergeGrains: 350 },
    { tier: 5,  name: '포도 샌드',     emoji: '🍇', baseColor: '#8b2be2', rgb: [139, 43, 226],  radius: 18, points: 150,  tumbleChance: 0.78, minMergeGrains: 520 },
    { tier: 6,  name: '블루베리 샌드', emoji: '🫐', baseColor: '#0066ff', rgb: [0, 102, 255],   radius: 22, points: 240,  tumbleChance: 0.74, minMergeGrains: 740 },
    { tier: 7,  name: '소다 샌드',     emoji: '💎', baseColor: '#00e5ff', rgb: [0, 229, 255],   radius: 26, points: 380,  tumbleChance: 0.70, minMergeGrains: 1020 },
    { tier: 8,  name: '멜론 샌드',     emoji: '🍈', baseColor: '#10e760', rgb: [16, 231, 96],   radius: 31, points: 580,  tumbleChance: 0.65, minMergeGrains: 1380 },
    { tier: 9,  name: '코코넛 샌드',   emoji: '🥥', baseColor: '#8d5b4c', rgb: [141, 91, 76],   radius: 36, points: 880,  tumbleChance: 0.60, minMergeGrains: 1800 },
    { tier: 10, name: '수박 샌드',     emoji: '🍉', baseColor: '#026b42', rgb: [2, 107, 66],    radius: 42, points: 1300, tumbleChance: 0.55, minMergeGrains: 2350 },
    { tier: 11, name: '오로라 샌드',   emoji: '👑', baseColor: '#f1f5f9', rgb: [241, 245, 249], radius: 48, points: 2000, tumbleChance: 0.50, minMergeGrains: 3000 }
  ];

  // Packed grain inside the kinetic sand clump
  interface SandGrainOffset {
    dx: number;
    dy: number;
    shade: number;
    dissolved: boolean;
  }

  function generateClumpGrains(radius: number): SandGrainOffset[] {
    const grains: SandGrainOffset[] = [];
    const r = radius;
    for (let dy = -r; dy <= r; dy++) {
      for (let dx = -r; dx <= r; dx++) {
        const angle = Math.atan2(dy, dx);
        // Organic hand-formed lump bumpiness
        const bump = 1.0 
          + 0.08 * Math.sin(angle * 5 + 0.3) 
          + 0.05 * Math.cos(angle * 8 + 1.1)
          + 0.03 * Math.sin(angle * 13);
        const dist = Math.hypot(dx, dy);
        if (dist <= r * bump) {
          const hash = Math.sin(dx * 12.9898 + dy * 78.233) * 43758.5453;
          const shade = Math.floor((hash - Math.floor(hash)) * 36) - 18;
          grains.push({ dx, dy, shade, dissolved: false });
        }
      }
    }
    // Sort descending by dy (bottom grains first so they dissolve into dunes first on landing)
    grains.sort((a, b) => b.dy - a.dy);
    return grains;
  }

  // Sound Synthesizer via Web Audio API
  class SoundManager {
    private ctx: AudioContext | null = null;
    public enabled = true;

    private getContext(): AudioContext | null {
      if (!this.enabled) return null;
      if (!this.ctx) {
        const AudioClass = window.AudioContext || (window as any).webkitAudioContext;
        if (AudioClass) {
          this.ctx = new AudioClass();
        }
      }
      if (this.ctx && this.ctx.state === 'suspended') {
        this.ctx.resume();
      }
      return this.ctx;
    }

    public playPourStart() {
      const ctx = this.getContext();
      if (!ctx) return;
      try {
        const now = ctx.currentTime;
        const osc = ctx.createOscillator();
        const gain = ctx.createGain();
        osc.type = 'sine';
        osc.frequency.setValueAtTime(320, now);
        osc.frequency.exponentialRampToValueAtTime(160, now + 0.12);

        gain.gain.setValueAtTime(0.18, now);
        gain.gain.exponentialRampToValueAtTime(0.001, now + 0.12);

        osc.connect(gain);
        gain.connect(ctx.destination);
        osc.start(now);
        osc.stop(now + 0.12);
      } catch (_) {}
    }

    public playPourTrickle() {
      const ctx = this.getContext();
      if (!ctx) return;
      try {
        const now = ctx.currentTime;
        const bufferSize = Math.floor(ctx.sampleRate * 0.035);
        const buffer = ctx.createBuffer(1, bufferSize, ctx.sampleRate);
        const data = buffer.getChannelData(0);
        for (let i = 0; i < bufferSize; i++) {
          data[i] = Math.random() * 2 - 1;
        }

        const noise = ctx.createBufferSource();
        noise.buffer = buffer;

        const filter = ctx.createBiquadFilter();
        filter.type = 'bandpass';
        filter.frequency.setValueAtTime(1400 + Math.random() * 400, now);
        filter.Q.setValueAtTime(3.0, now);

        const gain = ctx.createGain();
        gain.gain.setValueAtTime(0.04, now);
        gain.gain.exponentialRampToValueAtTime(0.001, now + 0.035);

        noise.connect(filter);
        filter.connect(gain);
        gain.connect(ctx.destination);
        noise.start(now);
      } catch (_) {}
    }

    public playIgnitionSizzle(tier: number) {
      const ctx = this.getContext();
      if (!ctx) return;
      try {
        const now = ctx.currentTime;
        const osc = ctx.createOscillator();
        const gain = ctx.createGain();
        osc.type = 'sawtooth';
        osc.frequency.setValueAtTime(580 + tier * 60, now);
        osc.frequency.exponentialRampToValueAtTime(1100 + tier * 90, now + 0.07);

        gain.gain.setValueAtTime(0.07, now);
        gain.gain.exponentialRampToValueAtTime(0.001, now + 0.07);

        osc.connect(gain);
        gain.connect(ctx.destination);
        osc.start(now);
        osc.stop(now + 0.07);
      } catch (_) {}
    }

    public playMergeChime(tier: number, combo: number) {
      const ctx = this.getContext();
      if (!ctx) return;
      try {
        const now = ctx.currentTime;
        const baseFreqs = [261.63, 293.66, 329.63, 349.23, 392.00, 440.00, 493.88, 523.25, 587.33, 659.25, 783.99];
        const root = baseFreqs[Math.min(tier - 1, baseFreqs.length - 1)];
        const comboShift = Math.min(combo * 30, 150);

        // Harmonic chord (root + fifth)
        [root + comboShift, (root + comboShift) * 1.5].forEach((freq, idx) => {
          const osc = ctx.createOscillator();
          const gain = ctx.createGain();
          osc.type = 'sine';
          osc.frequency.setValueAtTime(freq, now + idx * 0.03);

          gain.gain.setValueAtTime(0.18, now + idx * 0.03);
          gain.gain.exponentialRampToValueAtTime(0.001, now + 0.35);

          osc.connect(gain);
          gain.connect(ctx.destination);
          osc.start(now + idx * 0.03);
          osc.stop(now + 0.36);
        });
      } catch (_) {}
    }

    public playGameOver() {
      const ctx = this.getContext();
      if (!ctx) return;
      try {
        const now = ctx.currentTime;
        const osc = ctx.createOscillator();
        const gain = ctx.createGain();
        osc.type = 'sawtooth';
        osc.frequency.setValueAtTime(240, now);
        osc.frequency.exponentialRampToValueAtTime(50, now + 0.6);

        gain.gain.setValueAtTime(0.3, now);
        gain.gain.exponentialRampToValueAtTime(0.001, now + 0.65);

        osc.connect(gain);
        gain.connect(ctx.destination);
        osc.start(now);
        osc.stop(now + 0.65);
      } catch (_) {}
    }

    public playEmergencyClear() {
      const ctx = this.getContext();
      if (!ctx) return;
      try {
        const now = ctx.currentTime;
        [523.25, 659.25, 783.99, 1046.5].forEach((freq, idx) => {
          const osc = ctx.createOscillator();
          const gain = ctx.createGain();
          osc.type = 'triangle';
          osc.frequency.setValueAtTime(freq, now + idx * 0.05);

          gain.gain.setValueAtTime(0.2, now + idx * 0.05);
          gain.gain.exponentialRampToValueAtTime(0.001, now + idx * 0.05 + 0.25);

          osc.connect(gain);
          gain.connect(ctx.destination);
          osc.start(now + idx * 0.05);
          osc.stop(now + idx * 0.05 + 0.26);
        });
      } catch (_) {}
    }

    public playLandslide() {
      const ctx = this.getContext();
      if (!ctx) return;
      try {
        const now = ctx.currentTime;
        const bufferSize = Math.floor(ctx.sampleRate * 0.22);
        const buffer = ctx.createBuffer(1, bufferSize, ctx.sampleRate);
        const data = buffer.getChannelData(0);
        for (let i = 0; i < bufferSize; i++) {
          data[i] = Math.random() * 2 - 1;
        }

        const noise = ctx.createBufferSource();
        noise.buffer = buffer;

        const filter = ctx.createBiquadFilter();
        filter.type = 'lowpass';
        filter.frequency.setValueAtTime(320, now);
        filter.frequency.exponentialRampToValueAtTime(120, now + 0.22);

        const gain = ctx.createGain();
        gain.gain.setValueAtTime(0.22, now);
        gain.gain.exponentialRampToValueAtTime(0.001, now + 0.22);

        noise.connect(filter);
        filter.connect(gain);
        gain.connect(ctx.destination);
        noise.start(now);
      } catch (_) {}
    }

    public playAuroraCollapse() {
      const ctx = this.getContext();
      if (!ctx) return;
      try {
        const now = ctx.currentTime;
        // Deep cosmic sub bass drop
        const subOsc = ctx.createOscillator();
        const subGain = ctx.createGain();
        subOsc.type = 'sine';
        subOsc.frequency.setValueAtTime(90, now);
        subOsc.frequency.exponentialRampToValueAtTime(28, now + 0.8);

        subGain.gain.setValueAtTime(0.4, now);
        subGain.gain.exponentialRampToValueAtTime(0.001, now + 0.85);

        subOsc.connect(subGain);
        subGain.connect(ctx.destination);
        subOsc.start(now);
        subOsc.stop(now + 0.85);

        // Shimmering celestial chimes
        [440, 659.25, 880, 1318.51, 1760].forEach((freq, idx) => {
          const osc = ctx.createOscillator();
          const gain = ctx.createGain();
          osc.type = 'sine';
          osc.frequency.setValueAtTime(freq, now + idx * 0.04);
          gain.gain.setValueAtTime(0.18, now + idx * 0.04);
          gain.gain.exponentialRampToValueAtTime(0.001, now + 0.7);

          osc.connect(gain);
          gain.connect(ctx.destination);
          osc.start(now + idx * 0.04);
          osc.stop(now + 0.72);
        });
      } catch (_) {}
    }
  }

  // Floating notifications banner
  interface FloatingBanner {
