      const symHBtn = document.getElementById('sym-h-btn');
      if (symHBtn) {
        const l = symHBtn.querySelector('.sym-label');
        if (l) l.textContent = 'Left/Right';
        symHBtn.title = 'Horizontal Mirror Symmetry';
      }
      const symVBtn = document.getElementById('sym-v-btn');
      if (symVBtn) {
        const l = symVBtn.querySelector('.sym-label');
        if (l) l.textContent = 'Top/Bottom';
        symVBtn.title = 'Vertical Mirror Symmetry';
      }
      const symQuadBtn = document.getElementById('sym-quad-btn');
      if (symQuadBtn) {
        const l = symQuadBtn.querySelector('.sym-label');
        if (l) l.textContent = '4-Way';
        symQuadBtn.title = '4-Way Mandala Symmetry';
      }

      const photoLabel = document.querySelector('.photo-upload-label span');
      if (photoLabel) photoLabel.textContent = '🖼️ Underlay Photo';
      const removePhotoBtn = document.getElementById('remove-photo-btn');
      if (removePhotoBtn) removePhotoBtn.textContent = '❌ Remove Photo';
      const photoBadgeLabel = document.getElementById('photo-badge-label');
      if (photoBadgeLabel) photoBadgeLabel.textContent = '🖼️ Photo Layer';
      const photoOverlayRemoveBtn = document.getElementById('photo-overlay-remove-btn');
      if (photoOverlayRemoveBtn) {
        photoOverlayRemoveBtn.textContent = '✕ Remove';
        photoOverlayRemoveBtn.title = 'Remove photo layer';
      }

      const zoomOutBtn = document.getElementById('zoom-out-btn');
      if (zoomOutBtn) zoomOutBtn.title = 'Zoom Out (−)';
      const zoomResetBtn = document.getElementById('zoom-reset-btn');
      if (zoomResetBtn) zoomResetBtn.title = 'Reset Zoom (100%)';
      const zoomInBtn = document.getElementById('zoom-in-btn');
      if (zoomInBtn) zoomInBtn.title = 'Zoom In (+)';
      const zoomFitBtn = document.getElementById('zoom-fit-btn');
      if (zoomFitBtn) zoomFitBtn.title = 'Fit to Viewport';
      const panToggleBtn = document.getElementById('pan-toggle-btn');
      if (panToggleBtn) panToggleBtn.title = 'Hand Tool (Pan / Space+Drag)';

      const customPickerGroup = document.querySelector('.custom-picker-group');
      if (customPickerGroup) (customPickerGroup as HTMLElement).title = 'Pick any custom RGB/HEX color';
      const customPickerTitle = document.querySelector('.custom-picker-title');
      if (customPickerTitle) customPickerTitle.textContent = 'RGB Picker';

      const sizeLabelText = document.querySelector('.size-label');
      if (sizeLabelText) sizeLabelText.textContent = 'Size';

      const presetStencils: Record<string, { text: string; title: string }> = {
        'cat': { text: '🐱 Cat', title: 'Load cat stencil' },
        'heart': { text: '💖 Heart', title: 'Load heart stencil' },
        'star': { text: '⭐ Star', title: 'Load star stencil' },
        'smile': { text: '😃 Smile', title: 'Load smile stencil' }
      };
      document.querySelectorAll('.preset-btn').forEach(btn => {
        const p = (btn as HTMLElement).dataset.preset || '';
        if (presetStencils[p]) {
          btn.textContent = presetStencils[p].text;
          (btn as HTMLElement).title = presetStencils[p].title;
        }
      });

      const toastUndo = document.getElementById('toast-undo-btn');
      if (toastUndo) toastUndo.textContent = 'Undo ↩';

      const modalClose = document.getElementById('modal-close-btn');
      if (modalClose) modalClose.title = 'Close';
      const downloadBtn = document.getElementById('file-download-link');
      if (downloadBtn) downloadBtn.textContent = '💾 Download';
      const copyModalBtn = document.getElementById('modal-copy-btn');
      if (copyModalBtn) copyModalBtn.textContent = '📋 Copy Image';
    }

    const canvas = document.getElementById('doodle-canvas') as HTMLCanvasElement;
    const photoCanvas = document.getElementById('photo-canvas') as HTMLCanvasElement;
    const canvasViewport = document.getElementById('canvas-viewport') as HTMLElement;
    const canvasFrame = document.getElementById('canvas-frame') as HTMLElement;
    const brushCursor = document.getElementById('brush-cursor') as HTMLElement;
    const photoOverlayBar = document.getElementById('photo-overlay-bar') as HTMLElement;
    const photoOverlayRemoveBtn = document.getElementById('photo-overlay-remove-btn');
    const zoomOutBtn = document.getElementById('zoom-out-btn');
    const zoomResetBtn = document.getElementById('zoom-reset-btn');
    const zoomInBtn = document.getElementById('zoom-in-btn');
    const zoomFitBtn = document.getElementById('zoom-fit-btn');
    const zoomLevelText = document.getElementById('zoom-level-text');
    const panToggleBtn = document.getElementById('pan-toggle-btn');
    if (!canvas) return;

    const engine = new StreamDoodleEngine(canvas, photoCanvas);

    // ── Canvas Size Dropdown Setup ──
    const sizeBtn = document.getElementById('canvas-size-btn');
    const sizeDropdown = document.getElementById('size-dropdown-menu');
    const sizeLabel = document.getElementById('current-size-label');

    sizeBtn?.addEventListener('click', (e) => {
      e.stopPropagation();
      if (sizeDropdown) {
        sizeDropdown.style.display = sizeDropdown.style.display === 'none' ? 'block' : 'none';
      }
    });

    document.addEventListener('click', () => {
      if (sizeDropdown) sizeDropdown.style.display = 'none';
    });

    sizeDropdown?.addEventListener('click', (e) => e.stopPropagation());

    document.querySelectorAll('.dropdown-item').forEach(item => {
      item.addEventListener('click', (e) => {
        const target = (e.currentTarget as HTMLElement);
        const w = parseInt(target.dataset.w || '360', 10);
        const h = parseInt(target.dataset.h || '360', 10);
        document.querySelectorAll('.dropdown-item').forEach(d => d.classList.remove('active'));
        target.classList.add('active');
        if (sizeLabel) sizeLabel.textContent = `${w}×${h}`;
        if (sizeDropdown) sizeDropdown.style.display = 'none';
        engine.setDimensions(w, h);
        updateBrushCursorColorAndSize();
      });
    });

    document.getElementById('apply-custom-size-btn')?.addEventListener('click', () => {
      const wInput = document.getElementById('custom-w') as HTMLInputElement;
      const hInput = document.getElementById('custom-h') as HTMLInputElement;
      const w = Math.min(1024, Math.max(64, parseInt(wInput?.value || '360', 10)));
      const h = Math.min(1024, Math.max(64, parseInt(hInput?.value || '360', 10)));
      document.querySelectorAll('.dropdown-item').forEach(d => d.classList.remove('active'));
      if (sizeLabel) sizeLabel.textContent = `${w}×${h}`;
      if (sizeDropdown) sizeDropdown.style.display = 'none';
      engine.setDimensions(w, h);
      updateBrushCursorColorAndSize();
    });

    // ── FPS Selector Setup ──
    const fpsSelect = document.getElementById('fps-select') as HTMLSelectElement;
    fpsSelect?.addEventListener('change', () => {
      engine.fps = parseInt(fpsSelect.value, 10) || 12;
    });

    // ── Brush Metadata & UI Synchronization ──
    const BRUSH_META: Record<string, { icon: string; nameKo: string; nameEn: string }> = {
      pen:     { icon: '🖊️', nameKo: '펜',       nameEn: 'Pen' },
      pixel:   { icon: '🔲', nameKo: '픽셀 펜',   nameEn: 'Pixel Pen' },
      bucket:  { icon: '🪣', nameKo: '페인트통',  nameEn: 'Bucket Fill' },
      pencil:  { icon: '✏️', nameKo: '연필',      nameEn: 'Pencil' },
      spray:   { icon: '💨', nameKo: '스프레이',  nameEn: 'Spray' },
      rainbow: { icon: '🌈', nameKo: '무지개',    nameEn: 'Rainbow' },
      behind:  { icon: '🎨', nameKo: '덧칠',      nameEn: 'Underlay' },
      eraser:  { icon: '🧼', nameKo: '지우개',    nameEn: 'Eraser' },
      cutout:  { icon: '🕳️', nameKo: '투명 오리기', nameEn: 'Cutout' }
    };

    // Sidebar active tool card elements
    const toolCardIcon = document.getElementById('tool-card-icon');
    const toolCardName = document.getElementById('tool-card-name');
    const sidebarSizeSlider = document.getElementById('sidebar-size-slider') as HTMLInputElement;
    const sidebarSizeVal = document.getElementById('sidebar-size-val');
    const sidebarOpacitySlider = document.getElementById('sidebar-opacity-slider') as HTMLInputElement;
    const sidebarOpacityVal = document.getElementById('sidebar-opacity-val');
    const sidebarColorRow = document.getElementById('sidebar-color-row');
    const sidebarColorInput = document.getElementById('sidebar-color-input') as HTMLInputElement;
    const sidebarColorHex = document.getElementById('sidebar-color-hex');
    const sidebarSwatchLabel = document.getElementById('sidebar-swatch-label');
    const sidebarColorNote = document.getElementById('sidebar-color-note');

    // Bottom palette elements
    const customColorInput = document.getElementById('custom-color-input') as HTMLInputElement;
    const customHexLabel = document.getElementById('custom-hex-label');
    const customSwatchLabel = document.getElementById('custom-swatch-label');
    const sizeSlider = document.getElementById('brush-size-slider') as HTMLInputElement;
    const sizeVal = document.getElementById('brush-size-val');
    const paletteSizeLabel = document.getElementById('palette-size-label');
    const opacitySlider = document.getElementById('brush-opacity-slider') as HTMLInputElement;
    const opacityVal = document.getElementById('brush-opacity-val');
    const paletteOpacityLabel = document.getElementById('palette-opacity-label');

    const syncBrushUI = () => {
      const bKey = engine.activeBrush;
      const meta = BRUSH_META[bKey] || BRUSH_META.pen;
      const bName = isEn ? meta.nameEn : meta.nameKo;

      if (toolCardIcon) toolCardIcon.textContent = meta.icon;
      if (toolCardName) toolCardName.textContent = bName;

      // 1. Tip Shape synchronization
      if (bKey === 'pixel') {
        engine.tipShape = 'square';
      }
      document.querySelectorAll('.tip-btn').forEach(btn => {
        btn.classList.toggle('active', (btn as HTMLElement).dataset.tip === engine.tipShape);
      });

      // 2. Size synchronization
      const curSize = engine.brushSizes[bKey] || engine.brushSize;
      engine.brushSize = curSize;
      if (sidebarSizeSlider) sidebarSizeSlider.value = curSize.toString();
      if (sidebarSizeVal) sidebarSizeVal.textContent = `${curSize}px`;
      if (sizeSlider) sizeSlider.value = curSize.toString();
      if (sizeVal) sizeVal.textContent = `${curSize}px`;
      if (paletteSizeLabel) paletteSizeLabel.textContent = isEn ? `${bName} Size` : `${bName} 굵기`;

      document.querySelectorAll('.size-pill').forEach(p => {
        p.classList.toggle('active', parseInt((p as HTMLElement).dataset.size || '0', 10) === curSize);
      });

      // 3. Opacity synchronization
      const curOpacityPercent = Math.round(engine.brushOpacity * 100);
      if (sidebarOpacitySlider) sidebarOpacitySlider.value = curOpacityPercent.toString();
      if (sidebarOpacityVal) sidebarOpacityVal.textContent = `${curOpacityPercent}%`;
      if (opacitySlider) opacitySlider.value = curOpacityPercent.toString();
      if (opacityVal) opacityVal.textContent = `${curOpacityPercent}%`;
      document.querySelectorAll('.opacity-pill').forEach(p => {
        p.classList.toggle('active', parseInt((p as HTMLElement).dataset.opacity || '0', 10) === curOpacityPercent);
      });

      // 4. Color synchronization
      const isEraseTool = bKey === 'eraser' || bKey === 'cutout';
      if (sidebarColorRow) {
        sidebarColorRow.style.opacity = isEraseTool ? '0.35' : '1';
        sidebarColorRow.style.pointerEvents = isEraseTool ? 'none' : 'auto';
      }
      if (sidebarColorNote) {
        sidebarColorNote.textContent = isEraseTool
          ? (isEn ? 'Erase / Cutout Mode' : '지우기/누끼 모드')
          : (isEn ? 'Click to pick RGB' : '클릭하여 RGB 선택');
      }

      const curColor = engine.paletteTable[engine.activeColorIndex] || PALETTE[2];
      const hex = curColor.hex;

      if (sidebarColorHex) sidebarColorHex.textContent = hex;
      if (sidebarSwatchLabel) sidebarSwatchLabel.style.backgroundColor = hex;
      if (sidebarColorInput) sidebarColorInput.value = hex.startsWith('#') ? hex : '#FF0055';

      if (customHexLabel) customHexLabel.textContent = hex;
      if (customSwatchLabel) customSwatchLabel.style.backgroundColor = hex;
      if (customColorInput) customColorInput.value = hex.startsWith('#') ? hex : '#FF0055';

      document.querySelectorAll('.color-swatch').forEach(s => {
        const idx = parseInt((s as HTMLElement).dataset.index || '-1', 10);
        s.classList.toggle('active', idx === engine.activeColorIndex && !engine.isCustomColor);
      });
      if (customSwatchLabel) {
        customSwatchLabel.classList.toggle('active', engine.isCustomColor);
      }

      // 5. Visibility for Bucket tool vs normal brush
      const isBucket = bKey === 'bucket';
      const sidebarSizeRow = document.getElementById('sidebar-size-row');
      const sidebarTipRow = document.getElementById('sidebar-tip-row');
      if (sidebarSizeRow) sidebarSizeRow.style.display = isBucket ? 'none' : 'flex';
      if (sidebarTipRow) sidebarTipRow.style.display = isBucket ? 'none' : 'flex';

      updateBrushCursorColorAndSize();
    };

    const setBrushSize = (val: number) => {
      engine.brushSize = val;
      engine.brushSizes[engine.activeBrush] = val;
      if (sidebarSizeSlider) sidebarSizeSlider.value = val.toString();
      if (sidebarSizeVal) sidebarSizeVal.textContent = `${val}px`;
      if (sizeSlider) sizeSlider.value = val.toString();
      if (sizeVal) sizeVal.textContent = `${val}px`;
      document.querySelectorAll('.size-pill').forEach(p => {
        p.classList.toggle('active', parseInt((p as HTMLElement).dataset.size || '0', 10) === val);
      });
      updateBrushCursorColorAndSize();
    };

    const setBrushOpacity = (val: number) => {
      engine.brushOpacity = Math.max(0.1, Math.min(1.0, val / 100));
      if (sidebarOpacitySlider) sidebarOpacitySlider.value = val.toString();
      if (sidebarOpacityVal) sidebarOpacityVal.textContent = `${val}%`;
      if (opacitySlider) opacitySlider.value = val.toString();
      if (opacityVal) opacityVal.textContent = `${val}%`;
      document.querySelectorAll('.opacity-pill').forEach(p => {
        p.classList.toggle('active', parseInt((p as HTMLElement).dataset.opacity || '0', 10) === val);
      });
      updateBrushCursorColorAndSize();
    };

    const setCustomColorValue = (hex: string) => {
      engine.setCustomColor(hex);
      syncBrushUI();
      updateBrushCursorColorAndSize();
    };

    // Tip Shape Toggle Listeners
    document.querySelectorAll('.tip-btn').forEach(btn => {
      btn.addEventListener('click', (e) => {
        const tip = (e.currentTarget as HTMLElement).dataset.tip as 'round' | 'square';
        if (tip) {
          engine.tipShape = tip;
          document.querySelectorAll('.tip-btn').forEach(b => b.classList.toggle('active', (b as HTMLElement).dataset.tip === tip));
          updateBrushCursorColorAndSize();
        }
      });
    });

    // Opacity Sliders & Pills Listeners
    sidebarOpacitySlider?.addEventListener('input', () => {
      setBrushOpacity(parseInt(sidebarOpacitySlider.value, 10));
    });
    opacitySlider?.addEventListener('input', () => {
      setBrushOpacity(parseInt(opacitySlider.value, 10));
    });
    document.querySelectorAll('.opacity-pill').forEach(pill => {
      pill.addEventListener('click', (e) => {
        const val = parseInt((e.currentTarget as HTMLElement).dataset.opacity || '100', 10);
        setBrushOpacity(val);
      });
    });

    // Color Pickers Input Events
    customColorInput?.addEventListener('input', () => {
      setCustomColorValue(customColorInput.value.toUpperCase());
    });
    sidebarColorInput?.addEventListener('input', () => {
      setCustomColorValue(sidebarColorInput.value.toUpperCase());
    });

    // Swatches Setup
    const swatchesContainer = document.getElementById('palette-swatches');
    if (swatchesContainer) {
      PALETTE.slice(0, 15).forEach((col, idx) => {
        const btn = document.createElement('button');
        btn.type = 'button';
        btn.className = `color-swatch ${idx === engine.activeColorIndex ? 'active' : ''}`;
        btn.style.backgroundColor = col.hex;
        btn.title = col.name;
        btn.dataset.index = idx.toString();
        btn.addEventListener('click', () => {
          engine.activeColorIndex = idx;
          engine.isCustomColor = false;
          if (engine.activeBrush !== 'eraser' && engine.activeBrush !== 'cutout') {
            engine.brushColors[engine.activeBrush] = idx;
          }
          syncBrushUI();
        });
        swatchesContainer.appendChild(btn);
      });
    }

    // Brush Selection Buttons
    document.querySelectorAll('.brush-btn').forEach(btn => {
      btn.addEventListener('click', (e) => {
        document.querySelectorAll('.brush-btn').forEach(b => b.classList.remove('active'));
        const target = (e.currentTarget as HTMLElement);
        target.classList.add('active');
        const b = target.dataset.brush || 'pen';
        engine.activeBrush = b;
        syncBrushUI();
      });
    });

    // Brush Size Controls (Both Sidebar & Bottom Slider)
    sizeSlider?.addEventListener('input', () => {
      setBrushSize(parseInt(sizeSlider.value, 10));
    });
    sidebarSizeSlider?.addEventListener('input', () => {
      setBrushSize(parseInt(sidebarSizeSlider.value, 10));
    });
    document.querySelectorAll('.size-pill').forEach(pill => {
      pill.addEventListener('click', (e) => {
        const size = parseInt((e.currentTarget as HTMLElement).dataset.size || '4', 10);
        setBrushSize(size);
      });
    });

    // Initial UI Sync
    syncBrushUI();

    // ── Symmetry Toggles ──
    const symHBtn = document.getElementById('sym-h-btn');
    const symVBtn = document.getElementById('sym-v-btn');
    const symQuadBtn = document.getElementById('sym-quad-btn');

    symHBtn?.addEventListener('click', () => {
      engine.mirrorH = !engine.mirrorH;
      engine.mirrorQuad = false;
      symHBtn.classList.toggle('active', engine.mirrorH);
      symQuadBtn?.classList.remove('active');
    });

    symVBtn?.addEventListener('click', () => {
      engine.mirrorV = !engine.mirrorV;
      engine.mirrorQuad = false;
      symVBtn.classList.toggle('active', engine.mirrorV);
      symQuadBtn?.classList.remove('active');
    });

    symQuadBtn?.addEventListener('click', () => {
      engine.mirrorQuad = !engine.mirrorQuad;
      engine.mirrorH = false;
      engine.mirrorV = false;
      symQuadBtn.classList.toggle('active', engine.mirrorQuad);
      symHBtn?.classList.remove('active');
      symVBtn?.classList.remove('active');
    });

    // ── Background Mode Buttons ──
    const bgDarkBtn = document.getElementById('bg-dark-btn');
    const bgGreenBtn = document.getElementById('bg-green-btn');
    const bgTransBtn = document.getElementById('bg-trans-btn');
    const checkerBg = document.getElementById('checker-bg');

    const updateBgMode = (mode: 'dark' | 'green' | 'trans') => {
      engine.bgMode = mode;
      [bgDarkBtn, bgGreenBtn, bgTransBtn].forEach(b => b?.classList.remove('active'));
      if (mode === 'dark') {
        bgDarkBtn?.classList.add('active');
        if (checkerBg) checkerBg.style.display = 'none';
        if (canvasFrame) canvasFrame.style.background = '#0b0f19';
      } else if (mode === 'green') {
        bgGreenBtn?.classList.add('active');
        if (checkerBg) checkerBg.style.display = 'none';
        if (canvasFrame) canvasFrame.style.background = '#00ff00';
      } else {
        bgTransBtn?.classList.add('active');
        if (checkerBg) checkerBg.style.display = 'block';
        if (canvasFrame) canvasFrame.style.background = 'transparent';
      }
      engine.render();
    };

    bgDarkBtn?.addEventListener('click', () => updateBgMode('dark'));
    bgGreenBtn?.addEventListener('click', () => updateBgMode('green'));
    bgTransBtn?.addEventListener('click', () => updateBgMode('trans'));

    // ── Animation Play/Pause Toggle ──
    const animToggleBtn = document.getElementById('anim-toggle-btn');
    const animIcon = document.getElementById('anim-icon');
    const animLabel = document.getElementById('anim-label');

    const toggleAnimation = () => {
      engine.isPlaying = !engine.isPlaying;
      if (animIcon) animIcon.textContent = engine.isPlaying ? '⏸' : '▶';
      if (animLabel) animLabel.textContent = engine.isPlaying
        ? (isEn ? 'Pause Boil' : '꿈틀 정지')
        : (isEn ? 'Resume Boil' : '꿈틀 시작');
      animToggleBtn?.classList.toggle('paused', !engine.isPlaying);
    };
    animToggleBtn?.addEventListener('click', toggleAnimation);

    // ── Toast System with Undo Action ──
    const toastPopup = document.getElementById('toast-popup');
    const toastMsg = document.getElementById('toast-msg');
    const toastUndoBtn = document.getElementById('toast-undo-btn');
    let toastTimeout: any = null;

    const showToast = (text: string, showUndo: boolean = false) => {
      if (!toastPopup || !toastMsg) return;
      toastMsg.textContent = text;
      if (toastUndoBtn) toastUndoBtn.style.display = showUndo ? 'inline-block' : 'none';
      toastPopup.style.display = 'flex';
      clearTimeout(toastTimeout);
      toastTimeout = setTimeout(() => { toastPopup.style.display = 'none'; }, 3000);
    };

    toastUndoBtn?.addEventListener('click', () => {
      engine.undo();
      if (toastPopup) toastPopup.style.display = 'none';
    });

    // ── Undo / Redo / Clear (Instant without blocked alert) ──
    document.getElementById('undo-btn')?.addEventListener('click', () => engine.undo());
    document.getElementById('redo-btn')?.addEventListener('click', () => engine.redo());
    document.getElementById('clear-btn')?.addEventListener('click', () => {
      engine.clear();
      if (engine.hasPhoto) {
        removePhoto(false);
      }
      showToast(isEn ? 'Canvas cleared!' : '캔버스를 모두 비웠습니다!', true);
    });

    // ── Presets ──
    document.querySelectorAll('.preset-btn').forEach(btn => {
      btn.addEventListener('click', (e) => {
        const preset = (e.currentTarget as HTMLElement).dataset.preset;
        if (preset) engine.loadPreset(preset);
      });
    });

    // ── Photo Upload & Background Eraser ──
    const photoInput = document.getElementById('photo-upload-input') as HTMLInputElement;
    const removePhotoBtn = document.getElementById('remove-photo-btn');

    const removePhoto = (notify: boolean = true) => {
      if (engine.photoCtx && photoCanvas) {
        engine.photoCtx.clearRect(0, 0, engine.width, engine.height);
        photoCanvas.style.display = 'none';
        engine.hasPhoto = false;
        if (removePhotoBtn) removePhotoBtn.style.display = 'none';
        if (photoOverlayBar) photoOverlayBar.style.display = 'none';
        if (photoInput) photoInput.value = '';
        updateBgMode('dark');
        if (notify) {
          showToast(isEn ? 'Photo removed.' : '사진이 제거되었습니다.');
        }
      }
    };

    photoInput?.addEventListener('change', (e) => {
      const file = (e.target as HTMLInputElement).files?.[0];
      if (file && engine.photoCtx && photoCanvas) {
        const img = new Image();
        img.onload = () => {
          photoCanvas.style.display = 'block';
          engine.hasPhoto = true;
          engine.photoCtx!.clearRect(0, 0, engine.width, engine.height);
          // Scale to fit canvas
          const hRatio = engine.width / img.width;
          const vRatio = engine.height / img.height;
          const ratio = Math.min(hRatio, vRatio);
          const centerShiftX = (engine.width - img.width * ratio) / 2;
          const centerShiftY = (engine.height - img.height * ratio) / 2;
          engine.photoCtx!.drawImage(img, 0, 0, img.width, img.height,
                                     centerShiftX, centerShiftY, img.width * ratio, img.height * ratio);
          updateBgMode('trans');
          if (removePhotoBtn) removePhotoBtn.style.display = 'inline-flex';
          if (photoOverlayBar) photoOverlayBar.style.display = 'inline-flex';
          showToast(isEn
            ? 'Photo loaded! Use [Cutout Tool] to erase transparently.'
            : '사진을 불러왔습니다! [🕳️ 투명 오리기]로 배경을 오려낼 수 있습니다.');
        };
        img.src = URL.createObjectURL(file);
      }
    });

    removePhotoBtn?.addEventListener('click', () => removePhoto(true));
    photoOverlayRemoveBtn?.addEventListener('click', () => removePhoto(true));

    // ── Zoom & Pan System ──
    const ZOOM_LEVELS = [0.25, 0.5, 0.75, 1.0, 1.25, 1.5, 2.0, 3.0, 4.0];
    let currentZoom = 1.0;
    let panX = 0;
    let panY = 0;
    let isPanning = false;
    let panStartX = 0;
    let panStartY = 0;
    let isSpacePressed = false;
    let spaceDragDistance = 0;
    let isHandToolActive = false;

    const updateCanvasTransform = (animate: boolean = false) => {
      if (!canvasFrame) return;
      canvasFrame.style.transition = animate ? 'transform 0.16s cubic-bezier(0.2, 0.8, 0.2, 1)' : 'none';
      canvasFrame.style.transform = `translate(${panX}px, ${panY}px) scale(${currentZoom})`;
      if (zoomLevelText) {
        zoomLevelText.textContent = `${Math.round(currentZoom * 100)}%`;
      }
      if (zoomResetBtn) {
        zoomResetBtn.classList.toggle('is-custom', Math.abs(currentZoom - 1.0) > 0.01);
      }
      updateBrushCursorColorAndSize();
    };

    const zoomTo = (newZoom: number, animate: boolean = true) => {
      currentZoom = Math.max(0.25, Math.min(4.0, Math.round(newZoom * 100) / 100));
      updateCanvasTransform(animate);
    };

    const zoomIn = () => {
      const next = ZOOM_LEVELS.find(lvl => lvl > currentZoom + 0.02) || 4.0;
      zoomTo(next, true);
    };

    const zoomOut = () => {
      const prev = [...ZOOM_LEVELS].reverse().find(lvl => lvl < currentZoom - 0.02) || 0.25;
      zoomTo(prev, true);
    };

    const resetZoom = () => {
      currentZoom = 1.0;
      panX = 0;
      panY = 0;
      updateCanvasTransform(true);
      showToast(isEn ? 'Zoom reset (100%)' : '확대율 초기화 (100%)');
    };

    const fitZoom = () => {
      panX = 0;
      panY = 0;
      const vpW = canvasViewport ? canvasViewport.clientWidth - 40 : 360;
      const vpH = canvasViewport ? canvasViewport.clientHeight - 40 : 360;
      const scaleW = vpW / canvas.offsetWidth;
      const scaleH = vpH / canvas.offsetHeight;
      const fitScale = Math.min(1.0, Math.min(scaleW, scaleH));
      zoomTo(Math.max(0.5, fitScale), true);
    };

    zoomInBtn?.addEventListener('click', zoomIn);
    zoomOutBtn?.addEventListener('click', zoomOut);
    zoomResetBtn?.addEventListener('click', resetZoom);
    zoomFitBtn?.addEventListener('click', fitZoom);

    panToggleBtn?.addEventListener('click', () => {
      isHandToolActive = !isHandToolActive;
      panToggleBtn.classList.toggle('active', isHandToolActive);
      if (isHandToolActive) {
        canvas.classList.add('is-hand-mode');
        canvas.style.cursor = 'grab';
        if (brushCursor) brushCursor.style.display = 'none';
        showToast(isEn ? 'Hand Tool: Drag to pan canvas' : '화면 이동 도구: 캔버스를 드래그하여 이동');
      } else {
        canvas.classList.remove('is-hand-mode');
        canvas.style.cursor = 'none';
        showToast(isEn ? 'Drawing Tool Active' : '그리기 도구 활성화');
      }
    });

    // Ctrl + Wheel Zoom on Viewport
    canvasViewport?.addEventListener('wheel', (e) => {
      if (e.ctrlKey || e.metaKey) {
        e.preventDefault();
        const factor = e.deltaY < 0 ? 1.15 : 0.87;
        zoomTo(currentZoom * factor, false);
      }
    }, { passive: false });

    // ── Brush Cursor Indicator ──
    const updateBrushCursorColorAndSize = () => {
      if (!brushCursor) return;
      const bKey = engine.activeBrush;
      const curColor = engine.paletteTable[engine.activeColorIndex] || PALETTE[2];
      const rgb = curColor.rgb || [255, 0, 85];
      const hex = curColor.hex || '#FF0055';
      const isSquare = engine.tipShape === 'square' || bKey === 'pixel';
      const opacity = engine.brushOpacity;

      const scale = canvas.offsetWidth / engine.width;
      let diameter = Math.max(3, engine.brushSize * scale);
      if (bKey === 'spray') {
        diameter = Math.max(6, engine.brushSize * 2.5 * scale);
      }
      brushCursor.style.width = `${diameter}px`;
      brushCursor.style.height = `${diameter}px`;
      brushCursor.style.borderRadius = isSquare ? '2px' : '50%';

      if (bKey === 'bucket') {
        brushCursor.style.display = 'none';
        canvas.style.cursor = 'cell';
        return;
      }

      canvas.style.cursor = isHandToolActive ? 'grab' : 'none';

      const previewAlpha = Math.max(0.12, opacity * 0.45);

      if (bKey === 'eraser') {
        brushCursor.style.background = `rgba(255, 255, 255, ${previewAlpha})`;
        brushCursor.style.borderColor = '#ffffff';
        brushCursor.style.borderStyle = 'solid';
      } else if (bKey === 'cutout') {
        brushCursor.style.background = `rgba(239, 68, 68, ${previewAlpha})`;
        brushCursor.style.borderColor = '#f87171';
        brushCursor.style.borderStyle = 'dashed';
      } else if (bKey === 'rainbow') {
        brushCursor.style.background = `radial-gradient(circle, rgba(255,0,128,${previewAlpha}) 0%, rgba(0,255,200,${previewAlpha}) 100%)`;
        brushCursor.style.borderColor = '#38bdf8';
        brushCursor.style.borderStyle = 'solid';
      } else if (bKey === 'spray') {
        brushCursor.style.background = `rgba(${rgb[0]}, ${rgb[1]}, ${rgb[2]}, ${previewAlpha * 0.7})`;
        brushCursor.style.borderColor = hex;
        brushCursor.style.borderStyle = 'dashed';
      } else {
        brushCursor.style.background = `rgba(${rgb[0]}, ${rgb[1]}, ${rgb[2]}, ${previewAlpha})`;
        brushCursor.style.borderColor = '#ffffff';
        brushCursor.style.borderStyle = 'solid';
      }
    };

    const updateBrushCursorPos = (pos: { x: number; y: number }) => {
      if (!brushCursor) return;
      if (isHandToolActive || isSpacePressed || engine.activeBrush === 'bucket') {
        brushCursor.style.display = 'none';
        return;
      }
      const cursorX = pos.x * (canvas.offsetWidth / engine.width);
      const cursorY = pos.y * (canvas.offsetHeight / engine.height);
      brushCursor.style.left = `${cursorX}px`;
      brushCursor.style.top = `${cursorY}px`;
      brushCursor.style.display = 'block';
    };

    // ── Pointer Draw & Pan Events ──
    const getPos = (e: PointerEvent) => {
      const rect = canvas.getBoundingClientRect();
      const scaleX = engine.width / rect.width;
      const scaleY = engine.height / rect.height;
      return {
        x: (e.clientX - rect.left) * scaleX,
        y: (e.clientY - rect.top) * scaleY
      };
    };

    canvas.addEventListener('pointerenter', (e) => {
      if (engine.activeBrush === 'bucket') {
        canvas.style.cursor = 'cell';
        if (brushCursor) brushCursor.style.display = 'none';
        return;
      }
      if (!isHandToolActive && !isSpacePressed && e.pointerType !== 'touch') {
        canvas.style.cursor = 'none';
        const pos = getPos(e);
        updateBrushCursorPos(pos);
      }
    });

    canvas.addEventListener('pointerleave', () => {
      if (!engine.isDrawing) {
        if (brushCursor) brushCursor.style.display = 'none';
      }
    });

    canvas.addEventListener('pointerdown', (e) => {
      // Check if Pan action (Hand tool, Space held, or middle click button 1)
      if (isHandToolActive || isSpacePressed || e.button === 1) {
        isPanning = true;
        panStartX = e.clientX - panX;
        panStartY = e.clientY - panY;
        canvas.setPointerCapture(e.pointerId);
        canvas.style.cursor = 'grabbing';
        if (brushCursor) brushCursor.style.display = 'none';
        e.preventDefault();
        return;
      }

      if (e.button !== 0 && e.pointerType === 'mouse') return;

      const pos = getPos(e);

      if (engine.activeBrush === 'bucket') {
        engine.floodFill(pos.x, pos.y);
        e.preventDefault();
        return;
      }

      canvas.setPointerCapture(e.pointerId);
      engine.startStroke(pos.x, pos.y);
      updateBrushCursorPos(pos);
      e.preventDefault();
    });

    canvas.addEventListener('pointermove', (e) => {
      if (isPanning) {
        panX = e.clientX - panStartX;
        panY = e.clientY - panStartY;
        spaceDragDistance += 1;
        updateCanvasTransform(false);
        e.preventDefault();
        return;
      }

      const pos = getPos(e);
      updateBrushCursorPos(pos);
      if (engine.isDrawing) {
        engine.moveStroke(pos.x, pos.y);
      }
      e.preventDefault();
    });

    const handlePointerEnd = (e: PointerEvent) => {
      try { canvas.releasePointerCapture(e.pointerId); } catch {}
      if (isPanning) {
        isPanning = false;
        canvas.style.cursor = (isHandToolActive || isSpacePressed) ? 'grab' : 'none';
        return;
      }
      engine.endStroke();
      if (e.pointerType === 'touch' && brushCursor) {
        brushCursor.style.display = 'none';
      }
      e.preventDefault();
    };

    canvas.addEventListener('pointerup', handlePointerEnd);
    canvas.addEventListener('pointercancel', handlePointerEnd);

    // Keyboard shortcuts
    window.addEventListener('keydown', (e) => {
      if (e.target instanceof HTMLInputElement || e.target instanceof HTMLTextAreaElement) return;
      if (e.code === 'Space') {
        e.preventDefault();
        if (!isSpacePressed) {
          isSpacePressed = true;
          spaceDragDistance = 0;
          canvas.style.cursor = 'grab';
          if (brushCursor) brushCursor.style.display = 'none';
        }
      } else if ((e.ctrlKey || e.metaKey) && (e.key === '=' || e.key === '+')) {
        e.preventDefault();
        zoomIn();
      } else if ((e.ctrlKey || e.metaKey) && (e.key === '-' || e.key === '_')) {
        e.preventDefault();
        zoomOut();
      } else if ((e.ctrlKey || e.metaKey) && e.key === '0') {
        e.preventDefault();
        resetZoom();
      } else if ((e.ctrlKey || e.metaKey) && e.key === 'z') {
        e.preventDefault();
        engine.undo();
      } else if ((e.ctrlKey || e.metaKey) && (e.key === 'y' || (e.shiftKey && e.key === 'Z'))) {
        e.preventDefault();
        engine.redo();
      }
    });

    window.addEventListener('keyup', (e) => {
      if (e.code === 'Space') {
        e.preventDefault();
        isSpacePressed = false;
        if (!isHandToolActive) {
          canvas.style.cursor = 'none';
          if (spaceDragDistance < 5) {
            // Quick tap without dragging -> toggle animation!
            toggleAnimation();
          }
        } else {
          canvas.style.cursor = 'grab';
        }
      }
    });

    // ── Export Modal System (GIF & PNG) ──
    const exportGifBtn = document.getElementById('export-gif-btn');
    const exportPngBtn = document.getElementById('export-png-btn');
    const exportModal = document.getElementById('export-modal');
    const modalTitle = document.getElementById('export-modal-title');
    const modalCloseBtn = document.getElementById('modal-close-btn');
    const previewImg = document.getElementById('export-preview-img') as HTMLImageElement;
    const downloadLink = document.getElementById('file-download-link') as HTMLAnchorElement;
    const copyBtn = document.getElementById('modal-copy-btn');
    const modalSizeBadge = document.getElementById('modal-size-badge');
    const modalTypeBadge = document.getElementById('modal-type-badge');
    const modalHint = document.getElementById('modal-hint');

    let currentExportBlob: Blob | null = null;
    let currentExportType: 'gif' | 'png' = 'gif';

    // 1. Export GIF Action
    exportGifBtn?.addEventListener('click', () => {
      exportGifBtn.classList.add('loading');
      setTimeout(() => {
        try {
          const gifBlob = engine.generateGif();
          currentExportBlob = gifBlob;
          currentExportType = 'gif';
          const url = URL.createObjectURL(gifBlob);

          if (modalTitle) modalTitle.textContent = isEn ? '🎉 Animated GIF Ready!' : '🎉 움직이는 GIF 완성!';
          if (previewImg) previewImg.src = url;
          if (modalSizeBadge) modalSizeBadge.textContent = `${engine.width} × ${engine.height} px`;
          if (modalTypeBadge) modalTypeBadge.textContent = `GIF (${engine.fps} FPS)`;
          if (modalHint) modalHint.textContent = isEn
            ? `Encoded at ${engine.fps} FPS. Share directly to Discord, Twitch, or chat!`
            : '실시간 루프로 인코딩되었습니다. 디스코드나 메신저에 바로 공유하세요!';
          if (downloadLink) {
            downloadLink.href = url;
            downloadLink.download = `stream-doodle-${engine.width}x${engine.height}-${Date.now().toString(36)}.gif`;
          }
          if (exportModal) exportModal.style.display = 'flex';
          sound.playChime();
        } catch (err) {
          alert('GIF 생성 중 오류가 발생했습니다: ' + err);
        } finally {
          exportGifBtn.classList.remove('loading');
        }
      }, 50);
    });

    // 2. Export PNG Action
    exportPngBtn?.addEventListener('click', async () => {
      try {
        const pngBlob = await engine.generatePngBlob();
        currentExportBlob = pngBlob;
        currentExportType = 'png';
        const url = URL.createObjectURL(pngBlob);

        if (modalTitle) modalTitle.textContent = isEn ? '📷 High-Res PNG Ready!' : '📷 고화질 PNG 완성!';
        if (previewImg) previewImg.src = url;
        if (modalSizeBadge) modalSizeBadge.textContent = `${engine.width} × ${engine.height} px`;
        if (modalTypeBadge) modalTypeBadge.textContent = isEn ? 'Static Image (PNG)' : '정지 이미지 (PNG)';
        if (modalHint) modalHint.textContent = isEn
          ? 'Transparent background preserved. Ready for custom Discord emotes or stickers!'
          : '투명 배경이 유지된 원본 규격 이미지입니다. 이모티콘 업로드나 짤방으로 바로 활용하세요!';
        if (downloadLink) {
          downloadLink.href = url;
          downloadLink.download = `stream-doodle-${engine.width}x${engine.height}-${Date.now().toString(36)}.png`;
        }
        if (exportModal) exportModal.style.display = 'flex';
        sound.playChime();
      } catch (err) {
        alert('PNG 생성 중 오류가 발생했습니다: ' + err);
      }
    });

    modalCloseBtn?.addEventListener('click', () => {
      if (exportModal) exportModal.style.display = 'none';
    });

    exportModal?.addEventListener('click', (e) => {
      if (e.target === exportModal) exportModal.style.display = 'none';
    });

    copyBtn?.addEventListener('click', async () => {
      if (!currentExportBlob) return;
      try {
        if (currentExportType === 'png') {
          if (navigator.clipboard && (window as any).ClipboardItem) {
            const item = new (window as any).ClipboardItem({ 'image/png': currentExportBlob });
            await navigator.clipboard.write([item]);
            showToast(isEn ? 'PNG image copied to clipboard!' : '클립보드에 PNG 이미지가 복사되었습니다!');
          } else {
            showToast(isEn ? 'Please use the download button.' : '파일 다운로드 버튼을 이용해 주세요.');
          }
        } else {
          // GIF copy
          if (navigator.clipboard && (window as any).ClipboardItem) {
            const item = new (window as any).ClipboardItem({ 'image/gif': currentExportBlob });
            await navigator.clipboard.write([item]);
            showToast(isEn ? 'GIF copied to clipboard!' : '클립보드에 GIF가 복사되었습니다!');
          } else {
            showToast(isEn ? 'Please use the download button.' : '파일 다운로드 버튼을 이용해 주세요.');
          }
        }
      } catch (e) {
        showToast(isEn ? 'Please use the download button.' : '파일 다운로드 버튼을 이용해 주세요.');
      }
    });

    // ── Main Animation Render Loop ──
    const loop = () => {
      engine.tick();
      requestAnimationFrame(loop);
    };
    requestAnimationFrame(loop);

    // Initial preset
    engine.loadPreset('cat');
  });
</script>

