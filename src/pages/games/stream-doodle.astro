---
import GameLayout from '../../layouts/GameLayout.astro';
import { getEntry } from 'astro:content';

const gameEntry = await getEntry('games', 'stream-doodle');
const data = gameEntry?.data || {
  title: '스트림 두들 (Stream Doodle)',
  tagline: '살아 숨쉬는 12 FPS 애니메이션 GIF 드로잉 스튜디오',
  description: '그리는 모든 선이 마법처럼 춤추고 꿈틀거리는 실시간 애니메이션 그림판. 8가지 브러시, OBS 크로마키/투명 모드, 대칭 만다라 모드, 찰진 사운드와 원클릭 GIF/PNG 내보내기를 무료로 즐겨보세요.',
  icon: '🎨',
  category: 'stream',
  badge: '✨ 신규 도구',
  players: '1인 (방송/소셜 창작)',
  playTime: '자유 (1분~)',
  controls: [
    '마우스 클릭 & 드래그 또는 터치/스타일러스 펜으로 자유롭게 그리기 (반투명 크기·모양 미리보기)',
    '브러시 모양(● 원형 / ■ 사각 픽셀) 선택으로 매끄러운 곡선 및 레트로 도트 아트 손쉬운 드로잉',
    '페인트통(🪣) 도구로 닫힌 영역이나 배경을 원클릭으로 간편하게 단색 채우기',
    '투명도(10%~100%) 조절로 부드러운 형광펜·수채화 느낌의 반투명 오버레이 레이어링',
    '우측 하단 [− / + / 100%] 줌 컨트롤 또는 Ctrl+휠로 캔버스 자유 확대·축소 & Space/손도구로 이동',
    '상단 [📐 크기] 메뉴에서 트위치(112px), 디스코드(128/256px) 등 맞춤 캔버스 크기 지정',
    '사진 덧그리기 후 [✕ 사진 제거] 버튼으로 언제든 깔끔하게 원클릭 삭제',
    '[📷 PNG 저장] 또는 [✨ GIF 내보내기]로 원하는 규격의 이미지 즉시 다운로드'
  ],
  rules: [
    '선을 그으면 3개 프레임에 걸쳐 미세한 지터 오프셋이 적용되어 실시간으로 선이 꿈틀거립니다.',
    '지정한 FPS(6~24)에 맞추어 실시간 렌더링 및 GIF 프레임 딜레이가 정확히 동기화됩니다.',
    '페인트통 도구는 3개 프레임의 라인에 맞춰 실시간으로 영역을 채워 경계면이 자연스럽게 꿈틀거립니다.',
    '투명 오려내기 브러시를 쓰면 배경 사진과 낙서가 투명하게 뚫려 나만의 스티커를 만들 수 있습니다.',
    '모든 데이터는 브라우저 내부에서만 처리되며 외부 서버로 그림이 업로드되지 않아 100% 안전합니다.'
  ],
  faqItems: [
    {
      q: '디스코드나 트위치 이모티콘 규격으로 바로 만들 수 있나요?',
      a: '네! 상단의 [📐 360×360] 크기 버튼을 눌러 112×112(트위치/치지직), 128×128(디스코드 이모지), 256×256(디스코드 스티커)를 선택하면 번거로운 리사이징 없이 규격에 딱 맞는 GIF/PNG로 즉시 제작됩니다.'
    },
    {
      q: '픽셀 아트(도트 그래픽)나 각진 스타일로도 그릴 수 있나요?',
      a: '네! 좌측 툴바에서 [🔲 픽셀] 펜을 선택하거나 [■ 사각] 팁을 선택하면 가장자리가 둥글지 않은 정사각 픽셀 블록 브러시로 깔끔한 레트로 도트 아트를 그릴 수 있습니다.'
    },
    {
      q: '페인트통(영역 채우기) 도구는 어떻게 작동하나요?',
      a: '좌측 툴바에서 [🪣 페인트통]을 선택한 후 닫힌 도형 안쪽이나 빈 배경을 클릭하면, 3개 애니메이션 프레임 전체에 걸쳐 색상이 즉시 채워지며 외곽선과 함께 생동감 있게 꿈틀거립니다.'
    },
    {
      q: '형광펜처럼 반투명하게 색을 덧칠할 수 있나요?',
      a: '네! 하단 팔레트 또는 좌측 도구 설정의 [투명도] 슬라이더와 퀵 버튼(30%, 50%, 75%, 100%)을 조절하면 밑바탕의 선이나 사진이 비쳐 보이는 고품질 형광펜 효과를 낼 수 있습니다.'
    },
    {
      q: '캔버스 확대/축소 및 화면 이동(패닝)은 어떻게 하나요?',
      a: '우측 하단의 [− / + / 100%] 줌 버튼을 클릭하거나 Ctrl+마우스 휠로 확대·축소할 수 있습니다. 확대된 상태에서는 Space 키를 누른 채 드래그하거나 손도구(✋)를 눌러 자유롭게 화면을 이동할 수 있습니다.'
    },
    {
      q: '불러온 배경 사진은 어떻게 제거하나요?',
      a: '사진을 불러오면 캔버스 좌측 상단에 [🖼️ 사진 레이어 (✕ 제거)] 배지와 좌측 툴바에 [❌ 사진 제거] 버튼이 나타나 원클릭으로 언제든 깔끔하게 제거할 수 있습니다.'
    }
  ]
};
---

<GameLayout
  title={data.title}
  description={data.description}
  tagline={data.tagline}
  icon={data.icon}
  category={data.category}
  badge={data.badge}
  players={data.players}
  playTime={data.playTime}
  controls={data.controls}
  rules={data.rules}
  faqItems={data.faqItems}
  layoutMode="full"
  hideStageHeader={true}
  hideFooter={false}
>
  <div class="doodle-app-root" id="doodle-root">
    <!-- Top Action Bar -->
    <header class="doodle-topbar">
      <div class="topbar-left">
        <div class="app-brand">
          <span class="brand-icon">🎨</span>
          <span class="brand-name">스트림 두들</span>
        </div>

        <!-- Canvas Size Dropdown Button -->
        <div class="size-dropdown-wrapper">
          <button type="button" class="tool-btn size-selector-btn" id="canvas-size-btn" title="캔버스 규격 변경 (이모티콘/스티커)">
            📐 <span id="current-size-label">360×360</span> <span class="chevron">▼</span>
          </button>
          <div class="size-dropdown-menu" id="size-dropdown-menu" style="display: none;">
            <div class="dropdown-header">이모티콘 & 캔버스 규격</div>
            <button type="button" class="dropdown-item" data-w="112" data-h="112">
              <span class="item-title">112 × 112 px</span>
              <span class="item-desc">치지직·트위치 이모티콘</span>
            </button>
            <button type="button" class="dropdown-item" data-w="128" data-h="128">
              <span class="item-title">128 × 128 px</span>
              <span class="item-desc">디스코드·슬랙 이모지</span>
            </button>
            <button type="button" class="dropdown-item" data-w="256" data-h="256">
              <span class="item-title">256 × 256 px</span>
              <span class="item-desc">디스코드 대형 스티커</span>
            </button>
            <button type="button" class="dropdown-item active" data-w="360" data-h="360">
              <span class="item-title">360 × 360 px</span>
              <span class="item-desc">스튜디오 기본 정방형</span>
            </button>
            <button type="button" class="dropdown-item" data-w="512" data-h="512">
              <span class="item-title">512 × 512 px</span>
              <span class="item-desc">고화질 스티커 규격</span>
            </button>
            <div class="dropdown-custom-row">
              <input type="number" id="custom-w" min="64" max="1024" value="360" placeholder="가로" />
              <span>×</span>
              <input type="number" id="custom-h" min="64" max="1024" value="360" placeholder="세로" />
              <button type="button" id="apply-custom-size-btn">적용</button>
            </div>
          </div>
        </div>

        <!-- FPS Speed Selector -->
        <div class="fps-control-wrapper">
          <label for="fps-select" class="fps-label">속도</label>
          <select id="fps-select" class="fps-select" title="꿈틀거림 애니메이션 FPS 조절">
            <option value="6">6 FPS (느린 춤)</option>
            <option value="8">8 FPS (빈티지)</option>
            <option value="12" selected>12 FPS (기본)</option>
            <option value="16">16 FPS (빠름)</option>
            <option value="24">24 FPS (매끄러움)</option>
          </select>
        </div>
      </div>

      <div class="topbar-center">
        <!-- OBS Background Toggle -->
        <div class="btn-group obs-group" role="group" aria-label="배경 모드">
          <button type="button" class="tool-btn active" id="bg-dark-btn" title="다크 아케이드 배경">
            <span class="btn-dot bg-dot-dark"></span> 다크
          </button>
          <button type="button" class="tool-btn" id="bg-green-btn" title="OBS 크로마키 그린 배경">
            <span class="btn-dot bg-dot-green"></span> 크로마키
          </button>
          <button type="button" class="tool-btn" id="bg-trans-btn" title="투명 배경 (디스코드/오버레이용)">
            <span class="btn-dot bg-dot-trans"></span> 투명
          </button>
        </div>

        <!-- Animation Pause/Play Toggle -->
        <button type="button" class="tool-btn" id="anim-toggle-btn" title="애니메이션 켜기/끄기 (Space)">
          <span id="anim-icon">⏸</span> <span id="anim-label">꿈틀 정지</span>
        </button>
      </div>

      <div class="topbar-right">
        <!-- History Controls -->
        <button type="button" class="tool-btn icon-only-btn" id="undo-btn" title="실행 취소 (Ctrl+Z)" disabled>
          ↩
        </button>
        <button type="button" class="tool-btn icon-only-btn" id="redo-btn" title="다시 실행 (Ctrl+Y)" disabled>
          ↪
        </button>
        <!-- Clear Canvas (Instant with Undo Toast) -->
        <button type="button" class="tool-btn danger-btn" id="clear-btn" title="캔버스 전체 비우기">
          🗑 비우기
        </button>
        <!-- Static PNG Export -->
        <button type="button" class="tool-btn png-export-btn" id="export-png-btn" title="정지 이미지(PNG)로 저장">
          📷 PNG 저장
        </button>
        <!-- Primary Animated GIF Export -->
        <button type="button" class="tool-btn export-btn" id="export-gif-btn" title="움직이는 애니메이션 GIF로 저장">
          <span class="export-sparkle">✨</span> GIF 내보내기
        </button>
      </div>
    </header>

    <!-- Main Workspace Layout -->
    <div class="doodle-workspace">
      <!-- Left Floating Toolbar -->
      <aside class="doodle-sidebar" aria-label="그리기 도구">
        <div class="toolbar-section-label">브러시</div>
        <div class="brushes-list" id="brushes-list">
          <button type="button" class="brush-btn active" data-brush="pen" title="펜 (원형 팁 - 부드러운 드로잉)">
            <span class="brush-icon">🖊️</span>
            <span class="brush-name">펜</span>
          </button>
          <button type="button" class="brush-btn" data-brush="pixel" title="픽셀 펜 (정사각 팁 - 레트로 도트·픽셀아트)">
            <span class="brush-icon">🔲</span>
            <span class="brush-name">픽셀</span>
          </button>
          <button type="button" class="brush-btn" data-brush="bucket" title="페인트통 (닫힌 영역 클릭하여 채우기)">
            <span class="brush-icon">🪣</span>
            <span class="brush-name">페인트통</span>
          </button>
          <button type="button" class="brush-btn" data-brush="pencil" title="스케치 연필 (거친 흑연 질감)">
            <span class="brush-icon">✏️</span>
            <span class="brush-name">연필</span>
          </button>
          <button type="button" class="brush-btn" data-brush="spray" title="에어 스프레이 (흩뿌리는 도트 입자)">
            <span class="brush-icon">💨</span>
            <span class="brush-name">스프레이</span>
          </button>
          <button type="button" class="brush-btn" data-brush="rainbow" title="무지개 펜 (그릴 때마다 색상 변화)">
            <span class="brush-icon">🌈</span>
            <span class="brush-name">무지개</span>
          </button>
          <button type="button" class="brush-btn" data-brush="behind" title="밑그림 덧칠 (기존 선 뒤로 채우기)">
            <span class="brush-icon">🎨</span>
            <span class="brush-name">덧칠</span>
          </button>
          <button type="button" class="brush-btn" data-brush="eraser" title="지우개 (배경색으로 지우기)">
            <span class="brush-icon">🧼</span>
            <span class="brush-name">지우개</span>
          </button>
          <button type="button" class="brush-btn special-brush" data-brush="cutout" title="투명 오려내기 (사진/배경을 투명하게 구멍 뚫기)">
            <span class="brush-icon">🕳️</span>
            <span class="brush-name">투명 오리기</span>
          </button>
        </div>

        <!-- Dedicated Active Brush Controller on Sidebar -->
        <div class="sidebar-brush-control">
          <div class="toolbar-section-label" id="sidebar-tool-label">현재 도구 설정</div>
          <div class="active-tool-card" id="active-tool-card">
            <div class="tool-card-header">
              <span class="tool-card-icon" id="tool-card-icon">🖊️</span>
              <span class="tool-card-name" id="tool-card-name">펜</span>
            </div>
            <!-- Tip Shape (Round vs Square) -->
            <div class="sidebar-row" id="sidebar-tip-row">
              <div class="sidebar-row-label">
                <span id="sidebar-tip-title">팁 모양</span>
              </div>
              <div class="tip-shape-toggle">
                <button type="button" class="tip-btn active" data-tip="round" title="원형 팁">● 원형</button>
                <button type="button" class="tip-btn" data-tip="square" title="사각 팁 (픽셀아트)">■ 사각</button>
              </div>
            </div>
            <!-- Brush Size on Sidebar -->
            <div class="sidebar-row" id="sidebar-size-row">
              <div class="sidebar-row-label">
                <span id="sidebar-size-title">굵기</span>
                <span class="sidebar-val" id="sidebar-size-val">3px</span>
              </div>
              <input type="range" class="sidebar-slider" id="sidebar-size-slider" min="1" max="64" value="3" />
            </div>
            <!-- Brush Opacity on Sidebar -->
            <div class="sidebar-row" id="sidebar-opacity-row">
              <div class="sidebar-row-label">
                <span id="sidebar-opacity-title">투명도</span>
                <span class="sidebar-val" id="sidebar-opacity-val">100%</span>
              </div>
              <input type="range" class="sidebar-slider" id="sidebar-opacity-slider" min="10" max="100" step="5" value="100" />
            </div>
            <!-- Brush Color on Sidebar -->
            <div class="sidebar-row" id="sidebar-color-row">
              <div class="sidebar-row-label">
                <span id="sidebar-color-title">색상</span>
                <span class="sidebar-val" id="sidebar-color-hex">#FF3366</span>
              </div>
              <div class="sidebar-color-swatch-wrap">
                <label class="sidebar-color-swatch" id="sidebar-swatch-label" title="RGB 색상 선택기">
                  <input type="color" id="sidebar-color-input" value="#FF3366" />
                </label>
                <span class="sidebar-color-note" id="sidebar-color-note">클릭하여 RGB 선택</span>
              </div>
            </div>
          </div>
        </div>

        <div class="toolbar-divider"></div>

        <div class="toolbar-section-label">대칭 그리기</div>
        <div class="symmetry-list">
          <button type="button" class="sym-btn" id="sym-h-btn" title="좌우 수평 대칭">
            <span>🪞</span> <span class="sym-label">좌우</span>
          </button>
          <button type="button" class="sym-btn" id="sym-v-btn" title="상하 수직 대칭">
            <span>↕️</span> <span class="sym-label">상하</span>
          </button>
          <button type="button" class="sym-btn" id="sym-quad-btn" title="4방향 만다라 대칭">
            <span>💠</span> <span class="sym-label">4방향</span>
          </button>
        </div>

        <div class="toolbar-divider"></div>

        <!-- Photo upload / background helper -->
        <div class="photo-tools-block">
          <label class="photo-upload-label" title="배경에 사진/짤방을 깔고 그리기 또는 누끼 오려내기">
            <span>🖼️ 사진 덧그리기</span>
            <input type="file" id="photo-upload-input" accept="image/*" style="display:none;" />
          </label>
          <button type="button" class="tool-btn mini-btn" id="remove-photo-btn" style="display: none;" title="배경 사진 제거">
            ❌ 사진 제거
          </button>
        </div>
      </aside>

      <!-- Center Stage: The Animated Canvas -->
      <main class="doodle-stage">
        <div class="canvas-viewport" id="canvas-viewport">
          <!-- Floating Zoom Controls Bar -->
          <div class="canvas-zoom-bar" id="canvas-zoom-bar" role="toolbar" aria-label="줌 컨트롤">
            <button type="button" class="zoom-btn" id="zoom-out-btn" title="축소 (Zoom Out)">
              <span>−</span>
            </button>
            <button type="button" class="zoom-level-btn" id="zoom-reset-btn" title="100% 원래 크기로 (클릭하여 리셋)">
              <span id="zoom-level-text">100%</span>
            </button>
            <button type="button" class="zoom-btn" id="zoom-in-btn" title="확대 (Zoom In)">
              <span>+</span>
            </button>
            <button type="button" class="zoom-btn" id="zoom-fit-btn" title="화면에 맞추기 (Fit)">
              <span>⊡</span>
            </button>
            <div class="zoom-divider"></div>
            <button type="button" class="zoom-btn" id="pan-toggle-btn" title="화면 이동 도구 (Space 드래그 가능)">
              <span id="pan-icon">✋</span>
            </button>
          </div>

          <div class="canvas-frame" id="canvas-frame">
            <!-- Floating Active Photo Layer Overlay Badge -->
            <div class="photo-overlay-bar" id="photo-overlay-bar" style="display: none;">
              <span class="photo-badge-label" id="photo-badge-label">🖼️ 사진 레이어</span>
              <button type="button" class="photo-badge-del-btn" id="photo-overlay-remove-btn" title="배경 사진 제거">
                ✕ 제거
              </button>
            </div>

            <!-- Background Layer Canvas for Imported Photo (Allows cutout erasing!) -->
            <canvas id="photo-canvas" width="360" height="360" class="photo-canvas" style="display: none;"></canvas>

            <!-- The Active Multi-Frame Animated Canvas -->
            <canvas id="doodle-canvas" width="360" height="360" class="doodle-canvas"></canvas>

            <!-- Brush Cursor Preview Circle -->
            <div id="brush-cursor" class="brush-cursor" style="display: none;"></div>

            <!-- Guide grid overlay for transparent mode -->
            <div class="checker-bg" id="checker-bg" style="display: none;"></div>
