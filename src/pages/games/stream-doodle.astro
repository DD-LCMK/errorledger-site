  .active-tool-card {
    background: rgba(30, 41, 59, 0.75);
    border: 1px solid rgba(99, 102, 241, 0.35);
    border-radius: 10px;
    padding: 0.5rem 0.55rem;
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
    box-shadow: 0 4px 14px rgba(0, 0, 0, 0.25);
  }

  .tool-card-header {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.8rem;
    font-weight: 700;
    color: #f1f5f9;
    padding-bottom: 0.3rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
  }

  .tool-card-icon {
    font-size: 1.05rem;
  }

  .tool-card-name {
    flex: 1;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .sidebar-row {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }

  .sidebar-row-label {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 0.68rem;
    color: #94a3b8;
    font-weight: 600;
  }

  .sidebar-val {
    color: #38bdf8;
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    font-size: 0.68rem;
    font-weight: 700;
  }

  .sidebar-slider {
    width: 100%;
    height: 4px;
    -webkit-appearance: none;
    appearance: none;
    background: rgba(255, 255, 255, 0.15);
    border-radius: 4px;
    outline: none;
    cursor: pointer;
  }

  .sidebar-slider::-webkit-slider-thumb {
    -webkit-appearance: none;
    appearance: none;
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background: #38bdf8;
    border: 2px solid #ffffff;
    cursor: pointer;
    box-shadow: 0 0 6px rgba(56, 189, 248, 0.8);
  }

  .sidebar-color-swatch-wrap {
    display: flex;
    align-items: center;
    gap: 0.4rem;
  }

  .sidebar-color-swatch {
    position: relative;
    width: 22px;
    height: 22px;
    border-radius: 6px;
    background-color: #FF0055;
    border: 1.5px solid #ffffff;
    cursor: pointer;
    overflow: hidden;
    flex-shrink: 0;
    box-shadow: 0 0 8px rgba(255, 0, 85, 0.5);
  }

  .sidebar-color-swatch input[type="color"] {
    position: absolute;
    top: -50%;
    left: -50%;
    width: 200%;
    height: 200%;
    opacity: 0;
    cursor: pointer;
  }

  .sidebar-color-note {
    font-size: 0.62rem;
    color: #64748b;
    white-space: nowrap;
  }

  .toolbar-section-label {
    font-size: 0.675rem;
    font-weight: 700;
    color: #64748b;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin: 0.35rem 0.2rem 0.15rem;
  }

  .toolbar-divider {
    height: 1px;
    background: rgba(255, 255, 255, 0.06);
    margin: 0.4rem 0;
  }

  .brushes-list {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .brush-btn {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.45rem 0.55rem;
    background: rgba(255, 255, 255, 0.02);
    border: 1px solid transparent;
    border-radius: 8px;
    color: #94a3b8;
    font-size: 0.775rem;
    font-weight: 600;
    cursor: pointer;
    text-align: left;
    transition: all 0.15s ease;
  }

  .brush-btn:hover {
    background: rgba(255, 255, 255, 0.06);
    color: #f8fafc;
  }

  .brush-btn.active {
    background: rgba(99, 102, 241, 0.2);
    border-color: #6366f1;
    color: #c7d2fe;
    box-shadow: 0 0 12px rgba(99, 102, 241, 0.25);
  }

  .special-brush.active {
    background: rgba(244, 114, 182, 0.2);
    border-color: #f472b6;
    color: #fbcfe8;
  }

  .brush-icon {
    font-size: 1rem;
  }

  .symmetry-list {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.35rem;
  }

  .sym-btn {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.15rem;
    padding: 0.4rem 0.25rem;
    background: rgba(255, 255, 255, 0.02);
    border: 1px solid rgba(255, 255, 255, 0.06);
    border-radius: 8px;
    color: #94a3b8;
    font-size: 0.7rem;
    cursor: pointer;
    transition: all 0.15s ease;
  }

  .sym-btn:hover {
    background: rgba(255, 255, 255, 0.06);
    color: #f8fafc;
  }

  .sym-btn.active {
    background: rgba(34, 197, 94, 0.2);
    border-color: #22c55e;
    color: #86efac;
  }

  .sym-label {
    font-size: 0.65rem;
  }

  .photo-tools-block {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .photo-upload-label {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.35rem;
    padding: 0.45rem 0.35rem;
    background: rgba(255, 255, 255, 0.03);
    border: 1px dashed rgba(255, 255, 255, 0.15);
    border-radius: 8px;
    font-size: 0.725rem;
    font-weight: 600;
    color: #94a3b8;
    cursor: pointer;
    text-align: center;
    transition: all 0.15s ease;
  }

  .photo-upload-label:hover {
    background: rgba(255, 255, 255, 0.07);
    color: #f8fafc;
    border-color: rgba(255, 255, 255, 0.3);
  }

  .mini-btn {
    padding: 0.25rem 0.4rem;
    font-size: 0.675rem;
    width: 100%;
  }

  /* ── Center Stage & Canvas Viewport ── */
  .doodle-stage {
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: space-between;
    padding: 1rem;
    position: relative;
    overflow: hidden;
  }

  .canvas-viewport {
    flex: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    min-height: 380px;
    position: relative;
    overflow: hidden;
    touch-action: none;
  }

  .canvas-frame {
    position: relative;
    width: 460px;
    height: 460px;
    max-width: 90vw;
    max-height: 58vh;
    aspect-ratio: 1 / 1;
    border-radius: 12px;
    box-shadow: 0 20px 50px rgba(0, 0, 0, 0.7), 0 0 0 1px rgba(255, 255, 255, 0.1);
    background: #0b0f19;
    overflow: hidden;
    transform-origin: center center;
    will-change: transform;
  }

  .doodle-canvas {
    width: 100%;
    height: 100%;
    display: block;
    image-rendering: pixelated;
    touch-action: none;
    cursor: none;
    position: relative;
    z-index: 2;
  }

  .doodle-canvas.is-hand-mode {
    cursor: grab !important;
  }

  /* ── Semi-transparent Brush Cursor Preview ── */
  .brush-cursor {
    position: absolute;
    pointer-events: none;
    border-radius: 50%;
    border: 1.5px solid rgba(255, 255, 255, 0.95);
    box-shadow: 0 0 0 1px rgba(0, 0, 0, 0.75), inset 0 0 0 1px rgba(0, 0, 0, 0.3);
    background: rgba(255, 0, 85, 0.35);
    transform: translate(-50%, -50%);
    z-index: 25;
    display: none;
    box-sizing: border-box;
    will-change: left, top, width, height;
  }

  .brush-cursor::after {
    content: '';
    position: absolute;
    top: 50%;
    left: 50%;
    width: 2px;
    height: 2px;
    background: rgba(255, 255, 255, 0.95);
    box-shadow: 0 0 1px #000;
    border-radius: 50%;
    transform: translate(-50%, -50%);
  }

  /* ── Floating Active Photo Layer Overlay Badge ── */
  .photo-overlay-bar {
    position: absolute;
    top: 10px;
    left: 10px;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: rgba(15, 23, 42, 0.92);
    backdrop-filter: blur(10px);
    border: 1px solid rgba(255, 255, 255, 0.15);
    border-radius: 20px;
    padding: 4px 10px 4px 12px;
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.6);
    z-index: 30;
    user-select: none;
  }

  .photo-badge-label {
    font-size: 0.725rem;
    font-weight: 600;
    color: #cbd5e1;
  }

  .photo-badge-del-btn {
    background: rgba(239, 68, 68, 0.2);
    border: 1px solid rgba(239, 68, 68, 0.5);
    border-radius: 12px;
    padding: 2px 8px;
    font-size: 0.675rem;
    font-weight: 700;
    color: #fca5a5;
    cursor: pointer;
    transition: all 0.15s ease;
  }

  .photo-badge-del-btn:hover {
    background: rgba(239, 68, 68, 0.45);
    color: #ffffff;
    border-color: #ef4444;
    box-shadow: 0 0 10px rgba(239, 68, 68, 0.4);
  }

  /* ── Floating Zoom & Pan Controls ── */
  .canvas-zoom-bar {
    position: absolute;
    bottom: 14px;
    right: 16px;
    display: flex;
    align-items: center;
    gap: 2px;
    background: rgba(15, 23, 42, 0.88);
    backdrop-filter: blur(12px);
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 10px;
    padding: 3px 4px;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.5), 0 0 0 1px rgba(0, 0, 0, 0.3);
    z-index: 25;
    user-select: none;
  }

  .zoom-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 28px;
    height: 28px;
    background: transparent;
    border: none;
    border-radius: 6px;
    color: #94a3b8;
    font-size: 0.9rem;
    font-weight: 700;
    cursor: pointer;
    transition: all 0.15s ease;
  }

  .zoom-btn:hover {
    background: rgba(255, 255, 255, 0.1);
    color: #f8fafc;
  }

  .zoom-btn.active {
    background: rgba(0, 234, 200, 0.2);
    color: #00eac8;
    box-shadow: 0 0 8px rgba(0, 234, 200, 0.4);
  }

  .zoom-level-btn {
    background: transparent;
    border: none;
    border-radius: 6px;
    padding: 0 6px;
    height: 28px;
    color: #cbd5e1;
    font-size: 0.725rem;
    font-weight: 700;
    font-family: monospace;
    cursor: pointer;
    transition: all 0.15s ease;
  }

  .zoom-level-btn:hover {
    background: rgba(255, 255, 255, 0.1);
    color: #38bdf8;
  }

  .zoom-level-btn.is-custom {
    color: #00eac8;
  }

  .zoom-divider {
    width: 1px;
    height: 16px;
    background: rgba(255, 255, 255, 0.12);
    margin: 0 2px;
  }

  .photo-canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: 1;
    pointer-events: none;
  }

  .checker-bg {
    position: absolute;
    inset: 0;
    background: repeating-conic-gradient(#1e293b 0% 25%, #0f172a 0% 50%) 50% / 16px 16px;
    z-index: 0;
  }

  /* ── Bottom Palette Bar ── */
  .doodle-palette-bar {
    width: 100%;
    max-width: 980px;
    background: rgba(15, 23, 42, 0.85);
    backdrop-filter: blur(12px);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 14px;
    padding: 0.6rem 0.9rem;
    display: flex !important;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    box-shadow: 0 8px 30px rgba(0, 0, 0, 0.4);
    flex-wrap: wrap;
    z-index: 5;
    margin-top: 0.5rem;
  }

  /* Custom Color Picker */
  .custom-picker-group {
    display: flex;
    align-items: center;
    gap: 0.4rem;
  }

  .custom-color-swatch {
    position: relative;
    display: inline-block;
    width: 28px;
    height: 28px;
    border-radius: 8px;
    background-color: #FF0055;
    border: 2px solid #ffffff;
    box-shadow: 0 0 10px rgba(255, 0, 85, 0.6);
    cursor: pointer;
    overflow: hidden;
  }

  .custom-color-swatch input[type="color"] {
    position: absolute;
    inset: -10px;
    width: 50px;
    height: 50px;
    opacity: 0;
    cursor: pointer;
  }

  .custom-picker-meta {
    display: flex;
    flex-direction: column;
  }

  .custom-picker-title {
    font-size: 0.65rem;
    font-weight: 700;
    color: #94a3b8;
  }

  .custom-hex-label {
    font-size: 0.725rem;
    font-family: monospace;
    font-weight: 700;
    color: #f8fafc;
  }

  .palette-separator {
    width: 1px;
    height: 26px;
    background: rgba(255, 255, 255, 0.08);
  }

  .swatches-container {
    display: flex;
    align-items: center;
    gap: 0.3rem;
    flex-wrap: wrap;
  }

  .color-swatch {
    width: 22px;
    height: 22px;
    border-radius: 6px;
    border: 2px solid transparent;
    cursor: pointer;
    transition: transform 0.12s ease, border-color 0.12s ease;
    padding: 0;
    box-shadow: 0 2px 5px rgba(0, 0, 0, 0.3);
  }

  .color-swatch:hover {
    transform: scale(1.18);
  }

  .color-swatch.active {
    transform: scale(1.25);
    border-color: #ffffff;
    box-shadow: 0 0 10px rgba(255, 255, 255, 0.8);
  }

  .size-control-group {
    display: flex;
    align-items: center;
    gap: 0.4rem;
  }

  .size-label {
    font-size: 0.75rem;
    font-weight: 700;
    color: #94a3b8;
  }

  .size-slider {
    width: 75px;
    accent-color: #6366f1;
    cursor: pointer;
  }

  .size-value {
    font-size: 0.725rem;
    font-weight: 700;
    color: #cbd5e1;
    min-width: 28px;
  }

  .quick-sizes {
    display: flex;
    gap: 0.2rem;
  }

  .size-pill {
    padding: 0.15rem 0.35rem;
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 4px;
    color: #94a3b8;
    font-size: 0.65rem;
    font-weight: 700;
    cursor: pointer;
  }

  .size-pill:hover, .size-pill.active {
    background: rgba(99, 102, 241, 0.3);
    color: #c7d2fe;
    border-color: #6366f1;
  }

  .preset-templates-group {
    display: flex;
    align-items: center;
    gap: 0.25rem;
  }

  .preset-btn {
    padding: 0.25rem 0.5rem;
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 6px;
    font-size: 0.7rem;
    font-weight: 600;
    color: #cbd5e1;
    cursor: pointer;
    transition: all 0.15s ease;
  }

  .preset-btn:hover {
    background: rgba(255, 255, 255, 0.1);
    color: #f8fafc;
  }

  /* ── Tip Shape Toggle & Opacity Controls ── */
  .tip-shape-toggle {
    display: flex;
    gap: 4px;
    width: 100%;
  }

  .tip-btn {
    flex: 1;
    padding: 0.28rem 0.4rem;
    font-size: 0.675rem;
    font-weight: 700;
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 6px;
    color: #94a3b8;
    cursor: pointer;
    transition: all 0.15s ease;
  }

  .tip-btn:hover {
    background: rgba(255, 255, 255, 0.08);
    color: #f8fafc;
  }

  .tip-btn.active {
    background: rgba(0, 234, 200, 0.2);
    border-color: #00eac8;
    color: #00eac8;
    box-shadow: 0 0 8px rgba(0, 234, 200, 0.3);
  }

  .opacity-control-group {
    display: flex;
    align-items: center;
    gap: 0.45rem;
  }

  .opacity-slider {
    width: 80px;
  }

  .opacity-pill {
    padding: 0.2rem 0.38rem;
    border-radius: 6px;
    font-size: 0.65rem;
    font-weight: 700;
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.1);
    color: #94a3b8;
    cursor: pointer;
    transition: all 0.15s ease;
  }

  .opacity-pill:hover {
    background: rgba(255, 255, 255, 0.1);
    color: #f8fafc;
  }

  .opacity-pill.active {
    background: rgba(255, 0, 85, 0.25);
    border-color: #ff0055;
    color: #ff0055;
    box-shadow: 0 0 6px rgba(255, 0, 85, 0.4);
  }

  /* ── Export Modal ── */
  .export-modal-backdrop {
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, 0.75);
    backdrop-filter: blur(8px);
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 100;
  }

  .export-modal-card {
    background: #0f172a;
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 16px;
    width: 380px;
    max-width: 90vw;
    box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.75);
    overflow: hidden;
  }

  .modal-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.875rem 1.25rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
  }

  .modal-header h3 {
    margin: 0;
    font-size: 1.05rem;
    font-weight: 700;
    color: #f8fafc;
  }

  .modal-close-btn {
    background: none;
    border: none;
    color: #94a3b8;
    font-size: 1.5rem;
    cursor: pointer;
    line-height: 1;
  }

  .modal-close-btn:hover {
    color: #f8fafc;
  }

  .modal-body {
    padding: 1.25rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.85rem;
  }

  .modal-preview-box {
    width: 200px;
    height: 200px;
    background: #020617;
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 10px;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
  }

  .export-preview-img {
    max-width: 100%;
    max-height: 100%;
    image-rendering: pixelated;
  }

  .modal-meta-info {
    display: flex;
    gap: 0.5rem;
  }

  .modal-size-badge, .modal-type-badge {
    padding: 0.2rem 0.5rem;
    border-radius: 4px;
    font-size: 0.7rem;
    font-weight: 700;
    background: rgba(99, 102, 241, 0.15);
    color: #a5b4fc;
    border: 1px solid rgba(99, 102, 241, 0.3);
  }

  .modal-hint {
    margin: 0;
    font-size: 0.775rem;
    color: #94a3b8;
    text-align: center;
    line-height: 1.4;
  }

  .modal-actions {
    display: flex;
    gap: 0.75rem;
    width: 100%;
  }

  .modal-btn {
    flex: 1;
    padding: 0.65rem 0.75rem;
    border-radius: 8px;
    font-size: 0.85rem;
    font-weight: 700;
    cursor: pointer;
    text-align: center;
    text-decoration: none;
    transition: all 0.15s ease;
  }

  .download-btn {
    background: linear-gradient(135deg, #6366f1, #a855f7);
    color: #ffffff;
    border: none;
  }

  .copy-btn {
    background: rgba(30, 41, 59, 0.8);
    color: #f1f5f9;
    border: 1px solid rgba(255, 255, 255, 0.1);
  }

  /* ── Toast with Undo ── */
  .toast-popup {
    position: absolute;
    bottom: 2rem;
    left: 50%;
    transform: translateX(-50%);
    background: rgba(15, 23, 42, 0.95);
    color: #4ade80;
    border: 1px solid rgba(74, 222, 128, 0.3);
    padding: 0.55rem 1.15rem;
    border-radius: 9999px;
    font-size: 0.825rem;
    font-weight: 700;
    box-shadow: 0 10px 25px rgba(0, 0, 0, 0.5);
    z-index: 200;
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }

  .toast-undo-btn {
    background: rgba(255, 255, 255, 0.1);
    border: 1px solid rgba(255, 255, 255, 0.2);
    border-radius: 9999px;
    color: #ffffff;
    padding: 0.15rem 0.5rem;
    font-size: 0.75rem;
    cursor: pointer;
  }

  .toast-undo-btn:hover {
    background: rgba(255, 255, 255, 0.2);
  }

  /* ── Mobile Responsive ── */
  @media (max-width: 768px) {
    .doodle-topbar {
      padding: 0.5rem 0.65rem;
      gap: 0.35rem;
    }

    .brand-name {
      font-size: 0.9rem;
    }

    .doodle-workspace {
      flex-direction: column;
    }

    .doodle-sidebar {
      width: 100%;
      height: auto;
      flex-direction: row;
      align-items: center;
      padding: 0.35rem 0.5rem;
      overflow-x: auto;
      border-right: none;
      border-bottom: 1px solid rgba(255, 255, 255, 0.06);
    }

    .toolbar-section-label, .toolbar-divider {
      display: none;
    }

    .brushes-list {
      flex-direction: row;
      gap: 0.2rem;
    }

    .brush-btn {
      padding: 0.35rem 0.45rem;
      font-size: 0.725rem;
    }

    .brush-name {
      display: none;
    }

    .symmetry-list {
      display: flex;
      gap: 0.2rem;
    }

    .sym-btn {
      padding: 0.35rem 0.45rem;
    }

    .sym-label {
      display: none;
    }

    .photo-upload-label {
      padding: 0.35rem 0.45rem;
      white-space: nowrap;
    }

    .doodle-stage {
