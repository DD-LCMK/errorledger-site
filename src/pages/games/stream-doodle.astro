<script>
  // =========================================================================
  // 1. ENGINE CONFIG & PALETTE
  // =========================================================================
  let CANVAS_WIDTH = 360;
  let CANVAS_HEIGHT = 360;
  const FRAMES_COUNT = 3;
  const MAX_HISTORY = 32;

  // Curated 16 Neon/Retro Palette
  const PALETTE = [
    { hex: '#000000', rgb: [0, 0, 0], name: '검정' },
    { hex: '#FFFFFF', rgb: [255, 255, 255], name: '화이트' },
    { hex: '#FF0055', rgb: [255, 0, 85], name: '네온 핑크' },
    { hex: '#FF3366', rgb: [255, 51, 102], name: '로즈' },
    { hex: '#FF6600', rgb: [255, 102, 0], name: '오렌지' },
    { hex: '#FFD700', rgb: [255, 215, 0], name: '골드' },
    { hex: '#00FF66', rgb: [0, 255, 102], name: '라임' },
    { hex: '#00EAC8', rgb: [0, 234, 200], name: '민트' },
    { hex: '#00CCFF', rgb: [0, 204, 255], name: '스카이' },
    { hex: '#0066FF', rgb: [0, 102, 255], name: '네온 블루' },
    { hex: '#9933FF', rgb: [153, 51, 255], name: '퍼플' },
    { hex: '#FF00CC', rgb: [255, 0, 204], name: '마젠타' },
    { hex: '#8B4513', rgb: [139, 69, 19], name: '초코' },
    { hex: '#64748B', rgb: [100, 116, 139], name: '슬레이트' },
    { hex: '#94A3B8', rgb: [148, 163, 184], name: '실버' },
    { hex: '#FFFBEB', rgb: [255, 251, 235], name: '크림' },
  ];

  const BRUSH_CONFIGS: Record<string, { amplitude: number; spacing: number; blend: string }> = {
    pen:     { amplitude: 1.2, spacing: 1, blend: 'normal' },
    pixel:   { amplitude: 0.0, spacing: 1, blend: 'pixel' },
    bucket:  { amplitude: 0.0, spacing: 0, blend: 'bucket' },
    pencil:  { amplitude: 1.5, spacing: 1, blend: 'dither' },
    spray:   { amplitude: 3.5, spacing: 3, blend: 'spray' },
    rainbow: { amplitude: 2.0, spacing: 2, blend: 'rainbow' },
    behind:  { amplitude: 1.5, spacing: 1, blend: 'behind' },
    eraser:  { amplitude: 1.0, spacing: 1, blend: 'erase' },
    cutout:  { amplitude: 1.0, spacing: 1, blend: 'cutout' }
  };

  // =========================================================================
  // 2. WEB AUDIO ASMR (Synchronized with Header sound state)
  // =========================================================================
  class SoundEngine {
    private ctx: AudioContext | null = null;
    private lastPlayTime: number = 0;

    private isMuted(): boolean {
      try {
        return localStorage.getItem('arcade_sound_muted') === 'true';
      } catch (e) {
        return false;
      }
    }

    private init() {
      if (!this.ctx && typeof window !== 'undefined') {
        const AudioCtx = window.AudioContext || (window as any).webkitAudioContext;
        if (AudioCtx) this.ctx = new AudioCtx();
      }
      if (this.ctx && this.ctx.state === 'suspended') {
        this.ctx.resume();
      }
    }

    public playBrush(brush: string) {
      if (this.isMuted()) return;
      const now = performance.now();
      if (now - this.lastPlayTime < 45) return;
      this.lastPlayTime = now;
      this.init();
      if (!this.ctx) return;

      try {
        const osc = this.ctx.createOscillator();
        const gain = this.ctx.createGain();

        if (brush === 'spray') {
          const bufferSize = this.ctx.sampleRate * 0.04;
          const buffer = this.ctx.createBuffer(1, bufferSize, this.ctx.sampleRate);
          const data = buffer.getChannelData(0);
          for (let i = 0; i < bufferSize; i++) data[i] = Math.random() * 2 - 1;
          const noise = this.ctx.createBufferSource();
          noise.buffer = buffer;
          gain.gain.setValueAtTime(0.03, this.ctx.currentTime);
          gain.gain.exponentialRampToValueAtTime(0.001, this.ctx.currentTime + 0.04);
          noise.connect(gain);
          gain.connect(this.ctx.destination);
          noise.start();
          return;
        }

        if (brush === 'pixel') {
          osc.type = 'square';
          osc.frequency.setValueAtTime(580, this.ctx.currentTime);
          osc.frequency.exponentialRampToValueAtTime(420, this.ctx.currentTime + 0.02);
          gain.gain.setValueAtTime(0.012, this.ctx.currentTime);
          gain.gain.exponentialRampToValueAtTime(0.001, this.ctx.currentTime + 0.02);
          osc.connect(gain);
          gain.connect(this.ctx.destination);
          osc.start();
          osc.stop(this.ctx.currentTime + 0.02);
          return;
        }

        const freq = brush === 'eraser' || brush === 'cutout' ? 200 : brush === 'pencil' ? 560 : 360 + Math.random() * 80;
        osc.type = brush === 'eraser' || brush === 'cutout' ? 'triangle' : 'sine';
        osc.frequency.setValueAtTime(freq, this.ctx.currentTime);
        osc.frequency.exponentialRampToValueAtTime(freq * 0.8, this.ctx.currentTime + 0.03);

        gain.gain.setValueAtTime(0.025, this.ctx.currentTime);
        gain.gain.exponentialRampToValueAtTime(0.001, this.ctx.currentTime + 0.03);

        osc.connect(gain);
        gain.connect(this.ctx.destination);
        osc.start();
        osc.stop(this.ctx.currentTime + 0.03);
      } catch (e) {}
    }

    public playBucket() {
      if (this.isMuted()) return;
      this.init();
      if (!this.ctx) return;
      try {
        const osc = this.ctx.createOscillator();
        const gain = this.ctx.createGain();
        osc.type = 'sine';
        osc.frequency.setValueAtTime(320, this.ctx.currentTime);
        osc.frequency.exponentialRampToValueAtTime(740, this.ctx.currentTime + 0.08);
        gain.gain.setValueAtTime(0.04, this.ctx.currentTime);
        gain.gain.exponentialRampToValueAtTime(0.001, this.ctx.currentTime + 0.12);
        osc.connect(gain);
        gain.connect(this.ctx.destination);
        osc.start();
        osc.stop(this.ctx.currentTime + 0.12);
      } catch (e) {}
    }

    public playChime() {
      if (this.isMuted()) return;
      this.init();
      if (!this.ctx) return;
      try {
        [523.25, 659.25, 783.99].forEach((freq, idx) => {
          const osc = this.ctx!.createOscillator();
          const gain = this.ctx!.createGain();
          osc.type = 'sine';
          osc.frequency.setValueAtTime(freq, this.ctx!.currentTime + idx * 0.06);
          gain.gain.setValueAtTime(0.05, this.ctx!.currentTime + idx * 0.06);
          gain.gain.exponentialRampToValueAtTime(0.001, this.ctx!.currentTime + idx * 0.06 + 0.2);
          osc.connect(gain);
          gain.connect(this.ctx!.destination);
          osc.start(this.ctx!.currentTime + idx * 0.06);
          osc.stop(this.ctx!.currentTime + idx * 0.06 + 0.2);
        });
      } catch (e) {}
    }
  }

  const sound = new SoundEngine();

  // =========================================================================
  // 3. LZW GIF89a ENCODER
  // =========================================================================
  function encodeGif89a(
    framesPixels: Uint8Array[],
    width: number,
    height: number,
    paletteRgb: number[][],
    transparentIdx: number = -1,
    delayHundredths: number = 8
  ): Uint8Array {
    const bytes: number[] = [];
    const writeByte = (b: number) => bytes.push(b & 0xff);
    const writeWord = (w: number) => {
      writeByte(w & 0xff);
      writeByte((w >> 8) & 0xff);
    };
    const writeString = (s: string) => {
      for (let i = 0; i < s.length; i++) writeByte(s.charCodeAt(i));
    };

    writeString("GIF89a");
    writeWord(width);
    writeWord(height);

    const palSize = Math.max(2, 2 ** Math.ceil(Math.log2(paletteRgb.length)));
    const colorRes = Math.log2(palSize) - 1;
    writeByte(0x80 | (colorRes << 4) | colorRes);
    writeByte(0);
    writeByte(0);

    for (let i = 0; i < palSize; i++) {
      if (i < paletteRgb.length) {
        writeByte(paletteRgb[i][0]);
        writeByte(paletteRgb[i][1]);
        writeByte(paletteRgb[i][2]);
      } else {
        writeByte(0); writeByte(0); writeByte(0);
      }
    }

    writeByte(0x21);
    writeByte(0xff);
    writeByte(11);
    writeString("NETSCAPE2.0");
    writeByte(3);
    writeByte(1);
    writeWord(0);
    writeByte(0);

    function lzwEncode(pixels: Uint8Array, minCodeSize: number): number[] {
      const out: number[] = [];
      let curBit = 0;
      let curByte = 0;

      const emitBit = (bit: number) => {
        if (bit) curByte |= (1 << curBit);
        curBit++;
        if (curBit === 8) {
          blockBuffer.push(curByte);
          curByte = 0;
          curBit = 0;
          if (blockBuffer.length === 254) flushBlock();
        }
      };

      const emitBits = (val: number, bits: number) => {
        for (let b = 0; b < bits; b++) emitBit((val >> b) & 1);
      };

      let blockBuffer: number[] = [];
      const flushBlock = () => {
        if (blockBuffer.length > 0) {
          out.push(blockBuffer.length);
          for (let b = 0; b < blockBuffer.length; b++) out.push(blockBuffer[b]);
          blockBuffer = [];
        }
      };

      const clearCode = 1 << minCodeSize;
      const eoiCode = clearCode + 1;
      let codeSize = minCodeSize + 1;
      let nextCode = eoiCode + 1;
      let dict = new Map<string, number>();

      const resetDict = () => {
        dict.clear();
        codeSize = minCodeSize + 1;
        nextCode = eoiCode + 1;
      };

      emitBits(clearCode, codeSize);
      let s = "";

      for (let i = 0; i < pixels.length; i++) {
        const c = String.fromCharCode(pixels[i]);
        const sc = s + c;
        if (dict.has(sc) || (s === "" && sc.charCodeAt(0) < clearCode)) {
          s = sc;
        } else {
          const emitCode = s.length === 1 ? s.charCodeAt(0) : (dict.get(s) ?? 0);
          emitBits(emitCode, codeSize);

          if (nextCode < 4096) {
            dict.set(sc, nextCode++);
            if (nextCode > (1 << codeSize) && codeSize < 12) codeSize++;
          } else {
            emitBits(clearCode, codeSize);
            resetDict();
          }
          s = c;
        }
      }

      if (s.length > 0) {
        const emitCode = s.length === 1 ? s.charCodeAt(0) : (dict.get(s) ?? 0);
        emitBits(emitCode, codeSize);
      }

      emitBits(eoiCode, codeSize);
      if (curBit > 0) blockBuffer.push(curByte);
      flushBlock();
      out.push(0);
      return out;
    }

    for (let f = 0; f < framesPixels.length; f++) {
      writeByte(0x21);
      writeByte(0xf9);
      writeByte(4);
      writeByte(transparentIdx >= 0 ? 0x09 : 0x08);
      writeWord(delayHundredths);
      writeByte(transparentIdx >= 0 ? transparentIdx : 0);
      writeByte(0);

      writeByte(0x2c);
      writeWord(0); writeWord(0);
      writeWord(width); writeWord(height);
      writeByte(0);

      const minCodeSize = Math.max(2, Math.ceil(Math.log2(palSize)));
      writeByte(minCodeSize);

      const lzwData = lzwEncode(framesPixels[f], minCodeSize);
      for (let b = 0; b < lzwData.length; b++) writeByte(lzwData[b]);
    }

    writeByte(0x3b);
    return new Uint8Array(bytes);
  }

  function hslToRgb(h: number, s: number, l: number): [number, number, number] {
    const c = (1 - Math.abs(2 * l - 1)) * s;
    const x = c * (1 - Math.abs(((h / 60) % 2) - 1));
    const m = l - c / 2;
    let r = 0, g = 0, b = 0;
    if (h < 60) { r = c; g = x; }
    else if (h < 120) { r = x; g = c; }
    else if (h < 180) { g = c; b = x; }
    else if (h < 240) { g = x; b = c; }
    else if (h < 300) { r = x; b = c; }
    else { r = c; b = x; }
    return [Math.round((r + m) * 255), Math.round((g + m) * 255), Math.round((b + m) * 255)];
  }

  // =========================================================================
  // 4. STREAM DOODLE ENGINE
  // =========================================================================
  class StreamDoodleEngine {
    public width: number = CANVAS_WIDTH;
    public height: number = CANVAS_HEIGHT;
    public frames: Uint8Array[];
    public activeBrush: string = 'pen';
    public activeColorIndex: number = 2; // Default pink
    public customRgb: [number, number, number] = [255, 0, 85];
    public isCustomColor: boolean = false;
    public brushSize: number = 3;
    public mirrorH: boolean = false;
    public mirrorV: boolean = false;
    public mirrorQuad: boolean = false;
    public bgMode: 'dark' | 'green' | 'trans' = 'dark';
    public isPlaying: boolean = true;
    public fps: number = 12;

    public paletteTable: { hex: string; rgb: [number, number, number]; name: string; alpha?: number }[] = [...PALETTE];
    public brushSizes: Record<string, number> = {
      pen: 3,
      pixel: 4,
      bucket: 1,
      pencil: 3,
      spray: 16,
      rainbow: 6,
      behind: 12,
      eraser: 16,
      cutout: 16
    };
    public brushColors: Record<string, number> = {
      pen: 2,
      pixel: 2,
      bucket: 2,
      pencil: 14,
      spray: 6,
      rainbow: 2,
      behind: 5,
      eraser: 0,
      cutout: 0
    };
    public brushOpacity: number = 1.0;
    public tipShape: 'round' | 'square' = 'round';

    public currentFrameIndex: number = 0;
    private lastFrameTime: number = 0;
    private isDrawing: boolean = false;
    private lastX: number = 0;
    private lastY: number = 0;
    private rainbowHue: number = 0;

    private history: Uint8Array[][] = [];
    private redoHistory: Uint8Array[][] = [];

    private canvas: HTMLCanvasElement;
    private ctx: CanvasRenderingContext2D;
    private imgData: ImageData;
    public photoCanvas: HTMLCanvasElement | null = null;
    public photoCtx: CanvasRenderingContext2D | null = null;
    public hasPhoto: boolean = false;

    constructor(canvas: HTMLCanvasElement, photoCanvas: HTMLCanvasElement) {
      this.canvas = canvas;
      this.photoCanvas = photoCanvas;
      const context = canvas.getContext('2d', { willReadFrequently: true });
      if (!context) throw new Error('Could not get 2D context');
      this.ctx = context;
      this.ctx.imageSmoothingEnabled = false;

      if (photoCanvas) {
        this.photoCtx = photoCanvas.getContext('2d', { willReadFrequently: true });
      }

      this.frames = [
        new Uint8Array(this.width * this.height),
        new Uint8Array(this.width * this.height),
        new Uint8Array(this.width * this.height),
      ];
      this.imgData = this.ctx.createImageData(this.width, this.height);

      this.pushHistory();
    }

    public setDimensions(newW: number, newH: number) {
      this.width = newW;
      this.height = newH;
      CANVAS_WIDTH = newW;
      CANVAS_HEIGHT = newH;

      this.canvas.width = newW;
      this.canvas.height = newH;
      if (this.photoCanvas) {
        this.photoCanvas.width = newW;
        this.photoCanvas.height = newH;
      }
      this.imgData = this.ctx.createImageData(newW, newH);

      this.frames = [
        new Uint8Array(newW * newH),
        new Uint8Array(newW * newH),
        new Uint8Array(newW * newH),
      ];
      this.history = [];
      this.redoHistory = [];
      this.pushHistory();
      this.render();
    }

    public getOrCreateColorIndex(r: number, g: number, b: number, hex?: string, alpha: number = 255): number {
      for (let i = 0; i < this.paletteTable.length; i++) {
        const p = this.paletteTable[i];
        const pAlpha = p.alpha !== undefined ? p.alpha : 255;
        if (p.rgb[0] === r && p.rgb[1] === g && p.rgb[2] === b && pAlpha === alpha) {
          return i;
        }
      }
      const h = hex || `#${((1 << 24) + (r << 16) + (g << 8) + b).toString(16).slice(1).toUpperCase()}`;
      if (this.paletteTable.length < 255) {
        const idx = this.paletteTable.length;
        this.paletteTable.push({ hex: h, rgb: [r, g, b], name: h, alpha: alpha });
        return idx;
      }
      let closestIdx = 1;
      let minDist = Infinity;
      for (let i = 1; i < this.paletteTable.length; i++) {
        const p = this.paletteTable[i];
        const pAlpha = p.alpha !== undefined ? p.alpha : 255;
        const dist = (p.rgb[0] - r) ** 2 + (p.rgb[1] - g) ** 2 + (p.rgb[2] - b) ** 2 + (pAlpha - alpha) ** 2;
        if (dist < minDist) {
          minDist = dist;
          closestIdx = i;
        }
      }
      return closestIdx;
    }

    public floodFill(startX: number, startY: number) {
      const w = this.width;
      const h = this.height;
      const total = w * h;
      const sx = Math.floor(startX);
      const sy = Math.floor(startY);
      if (sx < 0 || sx >= w || sy < 0 || sy >= h) return;

      this.pushHistory();

      let fillColorIdx = this.activeColorIndex;
      const alpha = Math.max(15, Math.round(255 * this.brushOpacity));
      const curColor = this.paletteTable[this.activeColorIndex] || PALETTE[2];
      if (this.brushOpacity < 1.0) {
        fillColorIdx = this.getOrCreateColorIndex(curColor.rgb[0], curColor.rgb[1], curColor.rgb[2], curColor.hex, alpha);
      }

      // Flood fill each frame across animated boiling lines
      for (let f = 0; f < FRAMES_COUNT; f++) {
        const frame = this.frames[f];
        const targetIdx = frame[sy * w + sx];
        if (targetIdx === fillColorIdx) continue;

        const queue = new Int32Array(total * 2);
        let head = 0;
        let tail = 0;

        queue[tail++] = sx;
        queue[tail++] = sy;
        frame[sy * w + sx] = fillColorIdx;

        while (head < tail) {
          const cx = queue[head++];
          const cy = queue[head++];

          if (cx + 1 < w && frame[cy * w + (cx + 1)] === targetIdx) {
            frame[cy * w + (cx + 1)] = fillColorIdx;
            queue[tail++] = cx + 1;
            queue[tail++] = cy;
          }
          if (cx - 1 >= 0 && frame[cy * w + (cx - 1)] === targetIdx) {
            frame[cy * w + (cx - 1)] = fillColorIdx;
            queue[tail++] = cx - 1;
            queue[tail++] = cy;
          }
          if (cy + 1 < h && frame[(cy + 1) * w + cx] === targetIdx) {
            frame[(cy + 1) * w + cx] = fillColorIdx;
            queue[tail++] = cx;
            queue[tail++] = cy + 1;
          }
          if (cy - 1 >= 0 && frame[(cy - 1) * w + cx] === targetIdx) {
            frame[(cy - 1) * w + cx] = fillColorIdx;
            queue[tail++] = cx;
            queue[tail++] = cy - 1;
          }
        }
      }

      this.render();
      sound.playBucket();
    }

    public setCustomColor(hex: string) {
      const r = parseInt(hex.slice(1, 3), 16) || 0;
      const g = parseInt(hex.slice(3, 5), 16) || 0;
      const b = parseInt(hex.slice(5, 7), 16) || 0;
      this.customRgb = [r, g, b];
      this.isCustomColor = true;
      this.activeColorIndex = this.getOrCreateColorIndex(r, g, b, hex);
      if (this.activeBrush !== 'eraser' && this.activeBrush !== 'cutout') {
        this.brushColors[this.activeBrush] = this.activeColorIndex;
      }
    }

    public pushHistory() {
      if (this.history.length >= MAX_HISTORY) this.history.shift();
      this.history.push(this.frames.map(f => new Uint8Array(f)));
      this.redoHistory = [];
      this.updateUndoRedoUI();
    }

    public undo(): boolean {
      if (this.history.length <= 1) return false;
      const current = this.history.pop()!;
      this.redoHistory.push(current);
      const prev = this.history[this.history.length - 1];
      for (let i = 0; i < FRAMES_COUNT; i++) {
        this.frames[i].set(prev[i]);
      }
      this.updateUndoRedoUI();
      this.render();
      return true;
    }

    public redo(): boolean {
      if (this.redoHistory.length === 0) return false;
      const next = this.redoHistory.pop()!;
      this.history.push(next);
      for (let i = 0; i < FRAMES_COUNT; i++) {
        this.frames[i].set(next[i]);
      }
      this.updateUndoRedoUI();
      this.render();
      return true;
    }

    public clear() {
      this.pushHistory();
      for (let i = 0; i < FRAMES_COUNT; i++) {
        this.frames[i].fill(0);
      }
      this.render();
      sound.playChime();
    }

    private updateUndoRedoUI() {
      const undoBtn = document.getElementById('undo-btn') as HTMLButtonElement;
      const redoBtn = document.getElementById('redo-btn') as HTMLButtonElement;
      if (undoBtn) undoBtn.disabled = this.history.length <= 1;
      if (redoBtn) redoBtn.disabled = this.redoHistory.length === 0;
    }

    // ── Rasterization with Procedural Jitter ──
    public startStroke(x: number, y: number) {
      this.pushHistory();
      this.isDrawing = true;
      this.lastX = x;
      this.lastY = y;
      this.drawPointMirrored(x, y);
      sound.playBrush(this.activeBrush);
    }

    public moveStroke(x: number, y: number) {
      if (!this.isDrawing) return;
      this.drawLineMirrored(this.lastX, this.lastY, x, y);
      this.lastX = x;
      this.lastY = y;
      sound.playBrush(this.activeBrush);
    }

    public endStroke() {
      this.isDrawing = false;
    }

    private drawPointMirrored(x: number, y: number) {
      this.drawStrokeSegment(x, y, x, y);
      if (this.mirrorH || this.mirrorQuad) {
        this.drawStrokeSegment(this.width - 1 - x, y, this.width - 1 - x, y);
      }
      if (this.mirrorV || this.mirrorQuad) {
        this.drawStrokeSegment(x, this.height - 1 - y, x, this.height - 1 - y);
      }
      if (this.mirrorQuad) {
        this.drawStrokeSegment(this.width - 1 - x, this.height - 1 - y, this.width - 1 - x, this.height - 1 - y);
      }
    }

    private drawLineMirrored(x0: number, y0: number, x1: number, y1: number) {
      this.drawStrokeSegment(x0, y0, x1, y1);
      if (this.mirrorH || this.mirrorQuad) {
        this.drawStrokeSegment(this.width - 1 - x0, y0, this.width - 1 - x1, y1);
      }
      if (this.mirrorV || this.mirrorQuad) {
        this.drawStrokeSegment(x0, this.height - 1 - y0, x1, this.height - 1 - y1);
      }
      if (this.mirrorQuad) {
        this.drawStrokeSegment(this.width - 1 - x0, this.height - 1 - y0, this.width - 1 - x1, this.height - 1 - y1);
      }
    }

    private drawStrokeSegment(x0: number, y0: number, x1: number, y1: number) {
      if (this.activeBrush === 'bucket') return;

      const cfg = BRUSH_CONFIGS[this.activeBrush] || BRUSH_CONFIGS.pen;
      const amp = cfg.amplitude;
      const r = Math.max(1, Math.round(this.brushSize / 2));
      const blend = cfg.blend;
      const isSquare = this.tipShape === 'square' || this.activeBrush === 'pixel';
      const curColor = this.paletteTable[this.activeColorIndex] || PALETTE[2];

      let colorIndex = this.activeColorIndex;
      const alpha = Math.max(15, Math.round(255 * this.brushOpacity));
      if (this.brushOpacity < 1.0 && blend !== 'erase' && blend !== 'cutout') {
        colorIndex = this.getOrCreateColorIndex(curColor.rgb[0], curColor.rgb[1], curColor.rgb[2], curColor.hex, alpha);
      }

      if (blend === 'rainbow') {
        this.rainbowHue = (this.rainbowHue + 1) % 36;
        const h = (this.rainbowHue * 10) % 360;
        const rgb = hslToRgb(h, 0.95, 0.55);
        colorIndex = this.getOrCreateColorIndex(rgb[0], rgb[1], rgb[2], undefined, alpha);
      } else if (blend === 'erase' || blend === 'cutout') {
        colorIndex = 0;
      }

      // If cutout brush is used on a photo layer, erase the photo layer too!
      if (blend === 'cutout' && this.photoCtx && this.hasPhoto) {
        this.photoCtx.save();
        this.photoCtx.globalCompositeOperation = 'destination-out';
        this.photoCtx.beginPath();
        if (isSquare) {
          this.photoCtx.rect(x1 - r, y1 - r, r * 2, r * 2);
        } else {
          this.photoCtx.arc(x1, y1, r, 0, Math.PI * 2);
        }
        this.photoCtx.fill();
        this.photoCtx.restore();
      }

      for (let f = 0; f < FRAMES_COUNT; f++) {
        const frameBuf = this.frames[f];
        const jx0 = x0 + (Math.random() * 2 - 1) * amp;
        const jy0 = y0 + (Math.random() * 2 - 1) * amp;
        const jx1 = x1 + (Math.random() * 2 - 1) * amp;
        const jy1 = y1 + (Math.random() * 2 - 1) * amp;

        this.bresenhamLine(jx0, jy0, jx1, jy1, (cx, cy) => {
          if (blend === 'spray') {
            const drops = Math.max(3, r * 2);
            for (let d = 0; d < drops; d++) {
              const ang = Math.random() * Math.PI * 2;
              const dist = Math.random() * r * 2.5;
              const px = Math.round(cx + Math.cos(ang) * dist);
              const py = Math.round(cy + Math.sin(ang) * dist);
              if (px >= 0 && px < this.width && py >= 0 && py < this.height) {
                frameBuf[py * this.width + px] = colorIndex;
              }
            }
          } else if (blend === 'dither') {
            for (let dy = -r; dy <= r; dy++) {
              for (let dx = -r; dx <= r; dx++) {
                const inShape = isSquare ? true : (dx * dx + dy * dy <= r * r);
                if (inShape && (cx + dx + cy + dy) % 2 === 0) {
                  const px = Math.round(cx + dx);
                  const py = Math.round(cy + dy);
                  if (px >= 0 && px < this.width && py >= 0 && py < this.height) {
                    frameBuf[py * this.width + px] = colorIndex;
                  }
                }
              }
            }
          } else {
            for (let dy = -r; dy <= r; dy++) {
              for (let dx = -r; dx <= r; dx++) {
                const inShape = isSquare ? true : (dx * dx + dy * dy <= r * r);
                if (inShape) {
                  const px = Math.round(cx + dx);
                  const py = Math.round(cy + dy);
                  if (px >= 0 && px < this.width && py >= 0 && py < this.height) {
                    const idx = py * this.width + px;
                    if (blend === 'behind') {
                      if (frameBuf[idx] === 0) frameBuf[idx] = colorIndex;
                    } else {
                      if (this.brushOpacity < 1.0 && frameBuf[idx] !== 0 && frameBuf[idx] !== colorIndex) {
                        const prevColor = this.paletteTable[frameBuf[idx]] || this.paletteTable[1];
                        const a = this.brushOpacity;
                        const blendedR = Math.round(curColor.rgb[0] * a + prevColor.rgb[0] * (1 - a));
                        const blendedG = Math.round(curColor.rgb[1] * a + prevColor.rgb[1] * (1 - a));
                        const blendedB = Math.round(curColor.rgb[2] * a + prevColor.rgb[2] * (1 - a));
                        const blendedAlpha = Math.round((curColor.alpha ?? 255) * a + (prevColor.alpha ?? 255) * (1 - a));
                        const blendIdx = this.getOrCreateColorIndex(blendedR, blendedG, blendedB, undefined, blendedAlpha);
                        frameBuf[idx] = blendIdx;
                      } else {
                        frameBuf[idx] = colorIndex;
                      }
                    }
                  }
                }
              }
            }
          }
        });
      }
    }

    private bresenhamLine(x0: number, y0: number, x1: number, y1: number, plot: (x: number, y: number) => void) {
      let x = Math.round(x0);
      let y = Math.round(y0);
      const targetX = Math.round(x1);
      const targetY = Math.round(y1);

      const dx = Math.abs(targetX - x);
      const dy = -Math.abs(targetY - y);
      const sx = x < targetX ? 1 : -1;
      const sy = y < targetY ? 1 : -1;
      let err = dx + dy;

      while (true) {
        plot(x, y);
        if (x === targetX && y === targetY) break;
        const e2 = 2 * err;
        if (e2 >= dy) { err += dy; x += sx; }
        if (e2 <= dx) { err += dx; y += sy; }
      }
    }

    // ── Precise FPS Tick & Render ──
    public tick() {
      if (this.isPlaying) {
        const now = performance.now();
        const interval = 1000 / this.fps;
        if (now - this.lastFrameTime >= interval) {
          this.currentFrameIndex = (this.currentFrameIndex + 1) % FRAMES_COUNT;
          this.lastFrameTime = now;
          this.render();
        }
      } else {
        this.render();
      }
    }

    public render() {
      const activeFrame = this.frames[this.currentFrameIndex];
      const data = this.imgData.data;
      const total = this.width * this.height;

      let bgR = 11, bgG = 15, bgB = 25, bgA = 255;
      if (this.bgMode === 'green') {
        bgR = 0; bgG = 255; bgB = 0; bgA = 255;
      } else if (this.bgMode === 'trans' || this.hasPhoto) {
        bgR = 0; bgG = 0; bgB = 0; bgA = 0;
      }

      for (let i = 0; i < total; i++) {
        const colorIdx = activeFrame[i];
        const offset = i * 4;

        if (colorIdx === 0) {
          data[offset] = bgR;
          data[offset + 1] = bgG;
          data[offset + 2] = bgB;
          data[offset + 3] = bgA;
        } else {
          const c = this.paletteTable[colorIdx] || this.paletteTable[1];
          data[offset] = c.rgb[0];
          data[offset + 1] = c.rgb[1];
          data[offset + 2] = c.rgb[2];
          data[offset + 3] = 255;
        }
      }

      this.ctx.putImageData(this.imgData, 0, 0);
    }

    // ── GIF & PNG Exporters ──
    public generateGif(): Blob {
      const paletteRgb: number[][] = [];
      let transIdx = -1;

      if (this.bgMode === 'trans' || this.hasPhoto) {
        paletteRgb.push([0, 0, 0]);
        transIdx = 0;
      } else if (this.bgMode === 'green') {
        paletteRgb.push([0, 255, 0]);
      } else {
        paletteRgb.push([11, 15, 25]);
      }

      for (let i = 1; i < this.paletteTable.length; i++) {
        const p = this.paletteTable[i];
        const a = (p.alpha !== undefined ? p.alpha : 255) / 255;
        const rgb: [number, number, number] = [
          Math.round(p.rgb[0] * a + (1 - a) * (this.bgMode === 'green' ? 0 : 11)),
          Math.round(p.rgb[1] * a + (1 - a) * (this.bgMode === 'green' ? 255 : 15)),
          Math.round(p.rgb[2] * a + (1 - a) * (this.bgMode === 'green' ? 0 : 25))
        ];
        paletteRgb.push(rgb);
      }

      const delayHundredths = Math.max(2, Math.round(100 / this.fps));

      const gifBytes = encodeGif89a(
        this.frames,
        this.width,
        this.height,
        paletteRgb,
        transIdx,
        delayHundredths
      );

      return new Blob([gifBytes.buffer as ArrayBuffer], { type: 'image/gif' });
    }

    public generatePngBlob(): Promise<Blob> {
      return new Promise((resolve, reject) => {
        // Create composite canvas to merge photo layer (if any) and current frame
        const comp = document.createElement('canvas');
        comp.width = this.width;
        comp.height = this.height;
        const compCtx = comp.getContext('2d');
        if (!compCtx) return reject('No context');

        if (this.bgMode === 'dark') {
          compCtx.fillStyle = '#0b0f19';
          compCtx.fillRect(0, 0, this.width, this.height);
        } else if (this.bgMode === 'green') {
          compCtx.fillStyle = '#00ff00';
          compCtx.fillRect(0, 0, this.width, this.height);
        }

        if (this.hasPhoto && this.photoCanvas) {
          compCtx.drawImage(this.photoCanvas, 0, 0);
        }

        compCtx.drawImage(this.canvas, 0, 0);

        comp.toBlob((blob) => {
          if (blob) resolve(blob);
          else reject('Blob creation failed');
        }, 'image/png');
      });
    }

    // ── Preset Sticker Loading ──
    public loadPreset(name: string) {
      this.clear();
      const cx = this.width / 2;
      const cy = this.height / 2;
      const scale = Math.min(this.width, this.height) / 360;

      if (name === 'cat') {
        this.activeColorIndex = 2; // Pink
        this.brushSize = Math.max(2, Math.round(5 * scale));
        for (let a = 0; a < Math.PI * 2; a += 0.05) {
          const x = cx + Math.cos(a) * 70 * scale;
          const y = cy + 10 * scale + Math.sin(a) * 60 * scale;
          this.drawPointMirrored(x, y);
        }
        this.drawLineMirrored(cx - 50 * scale, cy - 40 * scale, cx - 65 * scale, cy - 100 * scale);
        this.drawLineMirrored(cx - 65 * scale, cy - 100 * scale, cx - 20 * scale, cy - 50 * scale);
        this.drawLineMirrored(cx + 50 * scale, cy - 40 * scale, cx + 65 * scale, cy - 100 * scale);
        this.drawLineMirrored(cx + 65 * scale, cy - 100 * scale, cx + 20 * scale, cy - 50 * scale);
        this.activeColorIndex = 8; // Sky blue
        this.drawPointMirrored(cx - 25 * scale, cy);
        this.drawPointMirrored(cx + 25 * scale, cy);
        this.activeColorIndex = 5; // Gold
        this.drawPointMirrored(cx, cy + 20 * scale);
      } else if (name === 'heart') {
        this.activeColorIndex = 2;
        this.brushSize = Math.max(3, Math.round(6 * scale));
        for (let t = 0; t < Math.PI * 2; t += 0.03) {
          const x = cx + 16 * Math.pow(Math.sin(t), 3) * 6 * scale;
          const y = cy - (13 * Math.cos(t) - 5 * Math.cos(2 * t) - 2 * Math.cos(3 * t) - Math.cos(4 * t)) * 6 * scale;
          this.drawPointMirrored(x, y);
        }
      } else if (name === 'star') {
        this.activeColorIndex = 5; // Gold
        this.brushSize = Math.max(2, Math.round(5 * scale));
        const pts: [number, number][] = [];
        for (let i = 0; i < 10; i++) {
          const r = (i % 2 === 0 ? 80 : 35) * scale;
          const a = (i * Math.PI) / 5 - Math.PI / 2;
          pts.push([cx + Math.cos(a) * r, cy + Math.sin(a) * r]);
        }
        for (let i = 0; i < pts.length; i++) {
          const p0 = pts[i];
          const p1 = pts[(i + 1) % pts.length];
          this.drawLineMirrored(p0[0], p0[1], p1[0], p1[1]);
        }
      } else if (name === 'smile') {
        this.activeColorIndex = 5; // Gold
        this.brushSize = Math.max(3, Math.round(6 * scale));
        // Circle face
        for (let a = 0; a < Math.PI * 2; a += 0.04) {
          const x = cx + Math.cos(a) * 90 * scale;
          const y = cy + Math.sin(a) * 90 * scale;
          this.drawPointMirrored(x, y);
        }
        // Eyes
        this.activeColorIndex = 9; // Blue
        this.brushSize = Math.max(4, Math.round(12 * scale));
        this.drawPointMirrored(cx - 35 * scale, cy - 20 * scale);
        this.drawPointMirrored(cx + 35 * scale, cy - 20 * scale);
        // Smile arc
        this.activeColorIndex = 2; // Pink
        this.brushSize = Math.max(3, Math.round(6 * scale));
        for (let a = 0.2; a < Math.PI - 0.2; a += 0.05) {
          const x = cx + Math.cos(a) * 50 * scale;
          const y = cy + 15 * scale + Math.sin(a) * 45 * scale;
          this.drawPointMirrored(x, y);
        }
      }
      this.render();
      sound.playChime();
    }
  }

