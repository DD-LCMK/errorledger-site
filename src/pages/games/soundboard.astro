</style>

<script is:inline>
  // ============================================================================
  // BROADCAST SOUNDBOARD AUDIO ENGINE & CONTROLLER (100% Client-Side)
  // ============================================================================
  (function () {
    // State
    let audioCtx = null;
    let masterGainNode = null;
    let analyserNode = null;
    let masterVolume = 0.5;
    let polyphonyMode = 'cut'; // 'overlap' | 'cut'
    let triggerMode = 'hold';   // 'oneshot' | 'hold'
    const activeInstances = new Set(); // Tracks active sounds
    const heldPadInstances = new Map(); // Tracks currently held sounds in Hold mode (padId -> instance)

    // Audio Caches
    let noiseBufferCache = null;
    let applauseBufferCache = null;
    let distortionCurveCache = null;

    // Custom Slots Decoded Buffers
    const customBuffers = [null, null];
    const customMeta = [null, null];

    // DOM Elements
    const root = document.getElementById('soundboard-root');
    const overlay = document.getElementById('audio-unlock-overlay');
    const unlockBtn = document.getElementById('unlock-start-btn');
    const volSlider = document.getElementById('master-volume');
    const volDisplay = document.getElementById('vol-display');
    const volIcon = document.getElementById('vol-icon');
    const btnOverlap = document.getElementById('btn-mode-overlap');
    const btnCut = document.getElementById('btn-mode-cut');
    const btnTrigOneshot = document.getElementById('btn-trig-oneshot');
    const btnTrigHold = document.getElementById('btn-trig-hold');
    const panicStopBtn = document.getElementById('panic-stop-btn');
    const btnFocus = document.getElementById('btn-focus-mode');
    const btnObsCopy = document.getElementById('btn-obs-copy');
    const btnFullscreen = document.getElementById('btn-fullscreen');
    const visualizerCanvas = document.getElementById('visualizer-canvas');
    const statusDot = document.getElementById('audio-status-dot');
    const statusText = document.getElementById('audio-status-text');
    const toast = document.getElementById('sb-toast');

    // --------------------------------------------------------------------------
    // 1. Audio Engine Initialization
    // --------------------------------------------------------------------------
    function ensureAudioContext() {
      if (!audioCtx) {
        const AudioContextClass = window.AudioContext || window.webkitAudioContext;
        audioCtx = new AudioContextClass();

        // Master Gain
        masterGainNode = audioCtx.createGain();
        masterGainNode.gain.setValueAtTime(masterVolume, audioCtx.currentTime);

        // Analyser for real-time visualizer
        analyserNode = audioCtx.createAnalyser();
        analyserNode.fftSize = 128;
        analyserNode.smoothingTimeConstant = 0.8;

        masterGainNode.connect(analyserNode);
        analyserNode.connect(audioCtx.destination);

        // Pre-generate noise buffer & physical applause buffer
        generateNoiseBuffer();
        generateApplauseBuffer();

        // Start Canvas Visualizer
        startVisualizerLoop();
      }

      if (audioCtx.state === 'suspended') {
        audioCtx.resume();
      }

      // Hide interaction overlay
      if (overlay && overlay.classList.contains('active')) {
        overlay.classList.remove('active');
      }

      if (statusDot) statusDot.classList.add('active');
      if (statusText) statusText.textContent = 'AUDIO ENGINE ACTIVE';
    }

    function generateNoiseBuffer() {
      if (!audioCtx) return;
      const bufferSize = audioCtx.sampleRate * 3.5; // 3.5 seconds
      noiseBufferCache = audioCtx.createBuffer(1, bufferSize, audioCtx.sampleRate);
      const data = noiseBufferCache.getChannelData(0);
      for (let i = 0; i < bufferSize; i++) {
        data[i] = Math.random() * 2 - 1;
      }
    }

    // Soft-clipping saturation curve for punchy game show buzzers and impacts
    function getDistortionCurve(k = 3.5) {
      if (distortionCurveCache) return distortionCurveCache;
      const n = 1024;
      const curve = new Float32Array(n);
      for (let i = 0; i < n; ++i) {
        const x = (i * 2) / n - 1;
        curve[i] = Math.tanh(k * x);
      }
      distortionCurveCache = curve;
      return curve;
    }

    // High-Fidelity Granular Physical-Model Crowd Applause Buffer
    // Synthesizes 42 realistic audience members with individual handclaps,
    // micro-flams, Helmholtz palm resonances, and dynamic stereo panning.
    function generateApplauseBuffer() {
      if (!audioCtx || applauseBufferCache) return;
      const sr = audioCtx.sampleRate;
      const dur = 3.2;
      const nSamples = Math.floor(sr * dur);
      const left = new Float32Array(nSamples);
      const right = new Float32Array(nSamples);

      function makeClap(centerFreq, palmPitch, vol) {
        const len = Math.floor(sr * 0.065);
        const buf = new Float32Array(len);
        const times = [0, 0.007, 0.015, 0.022];
        const amps = [0.35 * vol, 0.5 * vol, 0.7 * vol, 1.2 * vol];
        const durs = [0.004, 0.005, 0.006, 0.035];

        const w0 = 2 * Math.PI * centerFreq / sr;
        const alpha = Math.sin(w0) / (2 * 2.2);
        const b0 = alpha / (1 + alpha);
        const b2 = -alpha / (1 + alpha);
        const a1 = -2 * Math.cos(w0) / (1 + alpha);
        const a2 = (1 - alpha) / (1 + alpha);

        let x1 = 0, x2 = 0, y1 = 0, y2 = 0;
        const filtered = new Float32Array(len);
        for (let i = 0; i < len; i++) {
          const x0 = Math.random() * 2 - 1;
          const y0 = b0 * x0 + b2 * x2 - a1 * y1 - a2 * y2;
          filtered[i] = y0;
          x2 = x1; x1 = x0;
          y2 = y1; y1 = y0;
        }

        for (let b = 0; b < 4; b++) {
          const start = Math.floor(times[b] * sr);
          const durSamples = Math.floor(durs[b] * sr);
          const end = Math.min(len, start + durSamples);
          const segLen = end - start;
          for (let i = 0; i < segLen; i++) {
            const env = Math.exp(- (i / segLen) * 5.0);
            buf[start + i] += filtered[start + i] * env * amps[b];
          }
        }

        // Helmholtz palm cavity resonance
        const palmLen = Math.floor(0.025 * sr);
        const palmStart = Math.floor(0.022 * sr);
        for (let i = 0; i < palmLen && (palmStart + i) < len; i++) {
          const t = i / sr;
          buf[palmStart + i] += Math.sin(2 * Math.PI * palmPitch * t) * Math.exp(-t * 90) * 0.4 * vol;
        }
        return buf;
      }

      // Simulate 42 people clapping in an audience
      const numPeople = 42;
      for (let p = 0; p < numPeople; p++) {
        const rate = 3.0 + Math.random() * 1.6;
        const pan = Math.random() * 2 - 1;
        const lg = Math.cos((pan + 1) * Math.PI / 4);
        const rg = Math.sin((pan + 1) * Math.PI / 4);
        const cf = 1000 + Math.random() * 1400;
        const pf = 500 + Math.random() * 350;
        const clap = makeClap(cf, pf, 0.5 + Math.random() * 0.7);
        const cLen = clap.length;

        let t = 0.02 + Math.random() * 0.35;
        while (t < dur - 0.08) {
          const idx = Math.floor(t * sr);
          const copyLen = Math.min(cLen, nSamples - idx);
          for (let i = 0; i < copyLen; i++) {
            left[idx + i] += clap[i] * lg;
            right[idx + i] += clap[i] * rg;
          }
          t += (1.0 / rate) + (Math.random() - 0.5) * 0.045;
        }
      }

      // Master envelope & normalization
      let maxVal = 0;
      for (let i = 0; i < nSamples; i++) {
        const t = i / sr;
        let env = 1.0;
        if (t < 0.25) env = t / 0.25;
        else if (t > 2.4) env = Math.max(0, 1 - (t - 2.4) / 0.8);
        left[i] *= env;
        right[i] *= env;
        if (Math.abs(left[i]) > maxVal) maxVal = Math.abs(left[i]);
        if (Math.abs(right[i]) > maxVal) maxVal = Math.abs(right[i]);
      }

      const norm = maxVal > 0 ? (0.92 / maxVal) : 1;
      for (let i = 0; i < nSamples; i++) {
        left[i] *= norm;
        right[i] *= norm;
      }

      applauseBufferCache = audioCtx.createBuffer(2, nSamples, sr);
      applauseBufferCache.getChannelData(0).set(left);
      applauseBufferCache.getChannelData(1).set(right);
    }

    // --------------------------------------------------------------------------
    // 2. Sound Instance Registration & Stopping
    // --------------------------------------------------------------------------
    function registerInstance(gainNode, sources, padElement) {
      const instance = { gainNode, sources, padElement };
      activeInstances.add(instance);

      if (padElement) {
        padElement.classList.add('playing');
      }
      if (statusDot) statusDot.classList.add('playing');

      return instance;
    }

    function unregisterInstance(instance) {
      if (!instance) return;
      activeInstances.delete(instance);

      if (instance.padElement) {
        let hasOther = false;
        activeInstances.forEach(it => {
          if (it.padElement === instance.padElement) hasOther = true;
        });
        if (!hasOther) {
          instance.padElement.classList.remove('playing');
        }
      }

      if (activeInstances.size === 0 && statusDot) {
        statusDot.classList.remove('playing');
      }
    }

    // Stop a single instance smoothly without clicks
    function stopSingleInstance(instance) {
      if (!instance || !audioCtx) return;
      const now = audioCtx.currentTime;
      try {
        if (instance.gainNode) {
          instance.gainNode.gain.cancelScheduledValues(now);
          instance.gainNode.gain.setValueAtTime(instance.gainNode.gain.value, now);
          instance.gainNode.gain.linearRampToValueAtTime(0.0001, now + 0.015);
        }
        if (instance.sources) {
          instance.sources.forEach(src => {
            try { src.stop(now + 0.02); } catch (e) {}
          });
        }
      } catch (e) {}

      unregisterInstance(instance);
    }

    // Global Panic Stop (Space / Esc)
    function panicStop(showFeedback = true) {
      if (!audioCtx) return;
      const now = audioCtx.currentTime;

      activeInstances.forEach(instance => {
        try {
          if (instance.gainNode) {
            instance.gainNode.gain.cancelScheduledValues(now);
            instance.gainNode.gain.setValueAtTime(instance.gainNode.gain.value, now);
            instance.gainNode.gain.linearRampToValueAtTime(0.0001, now + 0.015);
          }
          if (instance.sources) {
            instance.sources.forEach(src => {
              try { src.stop(now + 0.02); } catch (e) {}
            });
          }
        } catch (e) {}
      });

      activeInstances.clear();
      heldPadInstances.clear();

      document.querySelectorAll('.sound-pad').forEach(el => {
        el.classList.remove('playing', 'pressed');
      });

      if (statusDot) statusDot.classList.remove('playing');
      if (showFeedback) showToast('🛑 ALL SOUNDS STOPPED (긴급 정지)', 'warning');
    }

    // --------------------------------------------------------------------------
    // 3. Procedural Audio Synthesis (Pads 1 ~ 9)
    // --------------------------------------------------------------------------

    // Pad 1: 땡! (TV Game Show Dissonant Saturation Buzzer)
    function playBuzzer(isHold = false) {
      ensureAudioContext();
      if (polyphonyMode === 'cut') panicStop(false);

      const now = audioCtx.currentTime;
      const padEl = document.getElementById('pad-1');

      const voiceGain = audioCtx.createGain();
      voiceGain.connect(masterGainNode);

      // Waveshaper distortion for aggressive TV game show buzzer bite
      const shaper = audioCtx.createWaveShaper();
      shaper.curve = getDistortionCurve(3.5);
      shaper.oversample = '2x';

      // Lowpass filter to shape harmonics (crisp bite, not muffled)
      const filter = audioCtx.createBiquadFilter();
      filter.type = 'lowpass';
      filter.frequency.setValueAtTime(2800, now);
      filter.Q.setValueAtTime(1.8, now);

      shaper.connect(filter);
      filter.connect(voiceGain);

      // Dissonant dual-tone: Eb3 (155.56Hz) + E3 (164.81Hz) - harsh minor second discord
      const osc1 = audioCtx.createOscillator();
      osc1.type = 'sawtooth';
      osc1.frequency.setValueAtTime(155.56, now);

      const osc2 = audioCtx.createOscillator();
      osc2.type = 'square';
      osc2.frequency.setValueAtTime(164.81, now);

      // Sub-bass oscillator for physical chest punch (Eb2 = 77.78Hz)
      const sub = audioCtx.createOscillator();
      sub.type = 'sine';
      sub.frequency.setValueAtTime(77.78, now);

      const mixGain = audioCtx.createGain();
      mixGain.gain.setValueAtTime(0.55, now);

      osc1.connect(mixGain);
      osc2.connect(mixGain);
      sub.connect(mixGain);
      mixGain.connect(shaper);

      // Attack punch click transient
      const click = audioCtx.createOscillator();
      const clickGain = audioCtx.createGain();
      click.frequency.setValueAtTime(280, now);
      click.frequency.exponentialRampToValueAtTime(60, now + 0.02);
      clickGain.gain.setValueAtTime(0.7, now);
      clickGain.gain.exponentialRampToValueAtTime(0.001, now + 0.025);
      click.connect(clickGain);
      clickGain.connect(voiceGain);
      click.start(now);
      click.stop(now + 0.03);

      const maxDur = isHold ? 12 : 0.55;
      voiceGain.gain.setValueAtTime(0.0001, now);
      voiceGain.gain.linearRampToValueAtTime(0.9, now + 0.008);

      if (!isHold) {
        voiceGain.gain.setValueAtTime(0.9, now + 0.48);
        voiceGain.gain.linearRampToValueAtTime(0.0001, now + 0.55);
      }

      osc1.start(now);
      osc2.start(now);
      sub.start(now);
      osc1.stop(now + maxDur);
      osc2.stop(now + maxDur);
      sub.stop(now + maxDur);

      const instance = registerInstance(voiceGain, [osc1, osc2, sub, click], padEl);
      if (!isHold) {
        setTimeout(() => unregisterInstance(instance), 580);
      }
      return instance;
    }

    // Pad 2: 딩동댕! (Korean Quiz Glockenspiel Bell Chime)
    function playChime() {
      ensureAudioContext();
      if (polyphonyMode === 'cut') panicStop(false);

      const now = audioCtx.currentTime;
      const padEl = document.getElementById('pad-2');

      const voiceGain = audioCtx.createGain();
      voiceGain.connect(masterGainNode);

      // Authentic Korean Quiz "딩 - 동 - 댕~!"
      // G5 (783.99Hz), E5 (659.25Hz), High C6 (1046.50Hz)
      const notes = [
        { t: 0.00, freq: 783.99, dur: 0.85, amp: 0.65 }, // 딩!
        { t: 0.22, freq: 659.25, dur: 0.85, amp: 0.65 }, // 동!
        { t: 0.44, freq: 1046.50, dur: 1.60, amp: 0.85 } // 댕~~!
      ];
      const sources = [];

      notes.forEach(note => {
        const noteStart = now + note.t;

        // 1. Fundamental
        const osc = audioCtx.createOscillator();
        osc.type = 'sine';
        osc.frequency.setValueAtTime(note.freq, noteStart);

        // 2. Glockenspiel Inharmonic Mode 2 (2.757x)
        const mode2 = audioCtx.createOscillator();
        mode2.type = 'sine';
        mode2.frequency.setValueAtTime(note.freq * 2.757, noteStart);

        // 3. Glockenspiel Inharmonic Mode 3 (5.404x)
        const mode3 = audioCtx.createOscillator();
        mode3.type = 'sine';
        mode3.frequency.setValueAtTime(note.freq * 5.404, noteStart);

        const noteGain = audioCtx.createGain();
        noteGain.gain.setValueAtTime(0.0001, noteStart);
        noteGain.gain.linearRampToValueAtTime(note.amp, noteStart + 0.006);
        noteGain.gain.exponentialRampToValueAtTime(0.0001, noteStart + note.dur);

        const mode2Gain = audioCtx.createGain();
        mode2Gain.gain.setValueAtTime(0.0001, noteStart);
        mode2Gain.gain.linearRampToValueAtTime(note.amp * 0.4, noteStart + 0.006);
        mode2Gain.gain.exponentialRampToValueAtTime(0.0001, noteStart + note.dur * 0.45);

        const mode3Gain = audioCtx.createGain();
        mode3Gain.gain.setValueAtTime(0.0001, noteStart);
        mode3Gain.gain.linearRampToValueAtTime(note.amp * 0.18, noteStart + 0.004);
        mode3Gain.gain.exponentialRampToValueAtTime(0.0001, noteStart + note.dur * 0.25);

        // Mallet Strike Transient (wooden/brass hammer impact)
        if (noiseBufferCache) {
          const click = audioCtx.createBufferSource();
          click.buffer = noiseBufferCache;
          const clickFilter = audioCtx.createBiquadFilter();
          clickFilter.type = 'bandpass';
          clickFilter.frequency.setValueAtTime(note.freq * 3.5, noteStart);
          clickFilter.Q.setValueAtTime(2.0, noteStart);
          const clickGain = audioCtx.createGain();
          clickGain.gain.setValueAtTime(0.35, noteStart);
          clickGain.gain.exponentialRampToValueAtTime(0.001, noteStart + 0.015);
          click.connect(clickFilter);
          clickFilter.connect(clickGain);
          clickGain.connect(voiceGain);
          click.start(noteStart);
          click.stop(noteStart + 0.02);
          sources.push(click);
        }

        osc.connect(noteGain);
        mode2.connect(mode2Gain);
        mode3.connect(mode3Gain);
        noteGain.connect(voiceGain);
        mode2Gain.connect(voiceGain);
        mode3Gain.connect(voiceGain);

        osc.start(noteStart);
        mode2.start(noteStart);
        mode3.start(noteStart);
        osc.stop(noteStart + note.dur + 0.05);
        mode2.stop(noteStart + note.dur * 0.5);
        mode3.stop(noteStart + note.dur * 0.3);

        sources.push(osc, mode2, mode3);
      });

      const instance = registerInstance(voiceGain, sources, padEl);
      setTimeout(() => unregisterInstance(instance), 2100);
      return instance;
    }

    // Pad 3: 두둥탁! (Ba-Dum-Tss Punchline)
    function playPunchline() {
      ensureAudioContext();
      if (polyphonyMode === 'cut') panicStop(false);

      const now = audioCtx.currentTime;
      const padEl = document.getElementById('pad-3');

      const voiceGain = audioCtx.createGain();
      voiceGain.connect(masterGainNode);
      const sources = [];

      // Kick 1: "두" (t=0.0s)
      const kick1 = audioCtx.createOscillator();
      const kickGain1 = audioCtx.createGain();
      kick1.frequency.setValueAtTime(140, now);
      kick1.frequency.exponentialRampToValueAtTime(45, now + 0.12);
      kickGain1.gain.setValueAtTime(0.85, now);
      kickGain1.gain.exponentialRampToValueAtTime(0.001, now + 0.14);
      kick1.connect(kickGain1);
      kickGain1.connect(voiceGain);
      kick1.start(now);
      kick1.stop(now + 0.15);
      sources.push(kick1);

      // Kick 2: "둥" (t=0.17s)
      const kickTime2 = now + 0.17;
      const kick2 = audioCtx.createOscillator();
      const kickGain2 = audioCtx.createGain();
      kick2.frequency.setValueAtTime(160, kickTime2);
      kick2.frequency.exponentialRampToValueAtTime(48, kickTime2 + 0.13);
      kickGain2.gain.setValueAtTime(0.9, kickTime2);
      kickGain2.gain.exponentialRampToValueAtTime(0.001, kickTime2 + 0.15);
      kick2.connect(kickGain2);
      kickGain2.connect(voiceGain);
      kick2.start(kickTime2);
      kick2.stop(kickTime2 + 0.16);
      sources.push(kick2);

      // Snare + Cymbal Hit: "탁!" (t=0.34s)
      const hitTime = now + 0.34;
      const snareBody = audioCtx.createOscillator();
      snareBody.type = 'triangle';
      snareBody.frequency.setValueAtTime(210, hitTime);
      snareBody.frequency.exponentialRampToValueAtTime(70, hitTime + 0.1);
      const snareBodyGain = audioCtx.createGain();
      snareBodyGain.gain.setValueAtTime(0.7, hitTime);
      snareBodyGain.gain.exponentialRampToValueAtTime(0.001, hitTime + 0.12);
      snareBody.connect(snareBodyGain);
      snareBodyGain.connect(voiceGain);
      snareBody.start(hitTime);
      snareBody.stop(hitTime + 0.13);
      sources.push(snareBody);

      if (noiseBufferCache) {
        const noise = audioCtx.createBufferSource();
        noise.buffer = noiseBufferCache;

        const cymbalFilter = audioCtx.createBiquadFilter();
        cymbalFilter.type = 'highpass';
        cymbalFilter.frequency.setValueAtTime(4500, hitTime);

        const cymbalGain = audioCtx.createGain();
        cymbalGain.gain.setValueAtTime(0.75, hitTime);
        cymbalGain.gain.exponentialRampToValueAtTime(0.0001, hitTime + 1.1);

        noise.connect(cymbalFilter);
        cymbalFilter.connect(cymbalGain);
        cymbalGain.connect(voiceGain);

        noise.start(hitTime);
        noise.stop(hitTime + 1.15);
        sources.push(noise);
      }

      const instance = registerInstance(voiceGain, sources, padEl);
      setTimeout(() => unregisterInstance(instance), 1500);
      return instance;
    }

    // Pad 4: 삐-! (1kHz Pure Sine Censor Tone)
    function playCensorBeep(isHold = false) {
      ensureAudioContext();
      if (polyphonyMode === 'cut') panicStop(false);

      const now = audioCtx.currentTime;
      const padEl = document.getElementById('pad-4');

      const voiceGain = audioCtx.createGain();
      voiceGain.connect(masterGainNode);

      const osc = audioCtx.createOscillator();
      osc.type = 'sine';
      osc.frequency.setValueAtTime(1000, now);

      voiceGain.gain.setValueAtTime(0.0001, now);
      voiceGain.gain.linearRampToValueAtTime(0.75, now + 0.015);

      const maxDur = isHold ? 15 : 0.9;
      if (!isHold) {
        voiceGain.gain.setValueAtTime(0.75, now + 0.85);
        voiceGain.gain.linearRampToValueAtTime(0.0001, now + 0.88);
      }

      osc.connect(voiceGain);
      osc.start(now);
      osc.stop(now + maxDur);

      const instance = registerInstance(voiceGain, [osc], padEl);
      if (!isHold) {
        setTimeout(() => unregisterInstance(instance), 900);
      }
      return instance;
    }

    // Pad 5: 쾅! (Deep Cinematic Variety Shock Impact)
    function playExplosion() {
      ensureAudioContext();
      if (polyphonyMode === 'cut') panicStop(false);

      const now = audioCtx.currentTime;
      const padEl = document.getElementById('pad-5');

      const voiceGain = audioCtx.createGain();
      voiceGain.connect(masterGainNode);
      const sources = [];

      // 1. Initial High-Frequency Slap / Crack (metal/wood impact)
      const crackOsc = audioCtx.createOscillator();
      crackOsc.type = 'triangle';
      crackOsc.frequency.setValueAtTime(380, now);
      crackOsc.frequency.exponentialRampToValueAtTime(75, now + 0.035);

      const crackGain = audioCtx.createGain();
      crackGain.gain.setValueAtTime(0.9, now);
      crackGain.gain.exponentialRampToValueAtTime(0.001, now + 0.04);
      crackOsc.connect(crackGain);
      crackGain.connect(voiceGain);
      crackOsc.start(now);
      crackOsc.stop(now + 0.045);
      sources.push(crackOsc);

      // 2. Cinematic 808 Sub-Bass Dive (150Hz -> 38Hz)
      const sub = audioCtx.createOscillator();
      sub.type = 'sine';
      sub.frequency.setValueAtTime(150, now);
      sub.frequency.exponentialRampToValueAtTime(38, now + 0.22);
      sub.frequency.linearRampToValueAtTime(30, now + 1.4);

      const subGain = audioCtx.createGain();
      subGain.gain.setValueAtTime(1.0, now);
      subGain.gain.exponentialRampToValueAtTime(0.001, now + 1.4);
      sub.connect(subGain);
      subGain.connect(voiceGain);
      sub.start(now);
      sub.stop(now + 1.45);
      sources.push(sub);

      // 3. Fireball blast noise with sweeping lowpass/bandpass
      if (noiseBufferCache) {
        const noise = audioCtx.createBufferSource();
        noise.buffer = noiseBufferCache;

        const filter = audioCtx.createBiquadFilter();
        filter.type = 'lowpass';
        filter.frequency.setValueAtTime(2200, now);
        filter.frequency.exponentialRampToValueAtTime(80, now + 1.2);
        filter.Q.setValueAtTime(3.5, now);

        const noiseGain = audioCtx.createGain();
        noiseGain.gain.setValueAtTime(1.0, now);
        noiseGain.gain.exponentialRampToValueAtTime(0.0001, now + 1.5);

        noise.connect(filter);
        filter.connect(noiseGain);
        noiseGain.connect(voiceGain);

        noise.start(now);
        noise.stop(now + 1.55);
        sources.push(noise);

        // Crack noise burst
        const crackNoise = audioCtx.createBufferSource();
        crackNoise.buffer = noiseBufferCache;
        const crackFilter = audioCtx.createBiquadFilter();
        crackFilter.type = 'highpass';
        crackFilter.frequency.setValueAtTime(1400, now);
        const crackNoiseGain = audioCtx.createGain();
        crackNoiseGain.gain.setValueAtTime(0.8, now);
        crackNoiseGain.gain.exponentialRampToValueAtTime(0.001, now + 0.05);

        crackNoise.connect(crackFilter);
        crackFilter.connect(crackNoiseGain);
        crackNoiseGain.connect(voiceGain);

        crackNoise.start(now);
        crackNoise.stop(now + 0.06);
        sources.push(crackNoise);
      }

      const instance = registerInstance(voiceGain, sources, padEl);
      setTimeout(() => unregisterInstance(instance), 1600);
      return instance;
    }

    // Pad 6: 풀벌레 (Natural Awkward Silence Crickets Chirp)
    function playCrickets(isHold = false) {
      ensureAudioContext();
      if (polyphonyMode === 'cut') panicStop(false);

      const now = audioCtx.currentTime;
      const padEl = document.getElementById('pad-6');

      const voiceGain = audioCtx.createGain();
      voiceGain.connect(masterGainNode);
      const sources = [];

      // Pattern of cricket chirps: rhythmic stridulation pulse bursts
      const pulseLen = 0.018;
      const bursts = [
        [0.00, 0.024, 0.048],
        [0.16, 0.184, 0.208],
        [0.78, 0.804, 0.828],
        [0.94, 0.964, 0.988],
        [1.58, 1.604, 1.628],
        [1.74, 1.764, 1.788]
      ];

      bursts.forEach(group => {
        group.forEach(tOffset => {
          const tStart = now + tOffset;

          // Carrier at 4850Hz + slight 9700Hz overtone
          const osc1 = audioCtx.createOscillator();
          osc1.type = 'sine';
          osc1.frequency.setValueAtTime(4850, tStart);

          // Subtle pitch vibrato
          const fm = audioCtx.createOscillator();
          fm.type = 'sine';
          fm.frequency.setValueAtTime(130, tStart);
          const fmGain = audioCtx.createGain();
          fmGain.gain.setValueAtTime(45, tStart);
          fm.connect(fmGain);
          fmGain.connect(osc1.frequency);

          const pulseGain = audioCtx.createGain();
          pulseGain.gain.setValueAtTime(0.0001, tStart);
          pulseGain.gain.linearRampToValueAtTime(0.45, tStart + 0.005);
          pulseGain.gain.exponentialRampToValueAtTime(0.0001, tStart + pulseLen);

          osc1.connect(pulseGain);
          pulseGain.connect(voiceGain);

          osc1.start(tStart);
          fm.start(tStart);
          osc1.stop(tStart + pulseLen + 0.005);
          fm.stop(tStart + pulseLen + 0.005);
          sources.push(osc1, fm);

          // Wing friction noise texture
          if (noiseBufferCache) {
            const noise = audioCtx.createBufferSource();
            noise.buffer = noiseBufferCache;
            const bpf = audioCtx.createBiquadFilter();
            bpf.type = 'bandpass';
            bpf.frequency.setValueAtTime(5200, tStart);
            bpf.Q.setValueAtTime(3.0, tStart);
            const ng = audioCtx.createGain();
            ng.gain.setValueAtTime(0.08, tStart);
            ng.gain.exponentialRampToValueAtTime(0.001, tStart + pulseLen);
            noise.connect(bpf);
            bpf.connect(ng);
            ng.connect(voiceGain);
            noise.start(tStart);
            noise.stop(tStart + pulseLen + 0.005);
            sources.push(noise);
          }
        });
      });

      const maxDur = isHold ? 15 : 2.1;
      voiceGain.gain.setValueAtTime(0.0001, now);
      voiceGain.gain.linearRampToValueAtTime(0.85, now + 0.02);

      const instance = registerInstance(voiceGain, sources, padEl);
      if (!isHold) {
        setTimeout(() => unregisterInstance(instance), 2150);
      }
      return instance;
    }

    // Pad 7: 드럼롤 (Suspense Snare Roll & Grand Finale Crash)
    function playDrumRoll(isHold = false) {
      ensureAudioContext();
      if (polyphonyMode === 'cut') panicStop(false);

      const now = audioCtx.currentTime;
      const padEl = document.getElementById('pad-7');

      const voiceGain = audioCtx.createGain();
      voiceGain.connect(masterGainNode);
      const sources = [];

      const rollDuration = 2.15;
      let tCurr = 0.0;
      let step = 0.034; // Accelerates from 34ms to 20ms

      while (tCurr < rollDuration) {
        const hitTime = now + tCurr;
        const progress = tCurr / rollDuration;
        const hitAmp = 0.15 + progress * 0.75; // Crescendo

        // 1. Snare drum shell resonance (195Hz with fast drop)
        const shell = audioCtx.createOscillator();
        shell.type = 'triangle';
        shell.frequency.setValueAtTime(230, hitTime);
        shell.frequency.exponentialRampToValueAtTime(185, hitTime + 0.02);
        const shellGain = audioCtx.createGain();
        shellGain.gain.setValueAtTime(hitAmp * 0.35, hitTime);
        shellGain.gain.exponentialRampToValueAtTime(0.001, hitTime + 0.022);
        shell.connect(shellGain);
        shellGain.connect(voiceGain);
        shell.start(hitTime);
        shell.stop(hitTime + 0.025);
        sources.push(shell);

        // 2. Snare wire sizzle (highpass noise)
        if (noiseBufferCache) {
          const noise = audioCtx.createBufferSource();
          noise.buffer = noiseBufferCache;
          const filter = audioCtx.createBiquadFilter();
          filter.type = 'highpass';
          filter.frequency.setValueAtTime(2400 + progress * 600, hitTime);
          const tapGain = audioCtx.createGain();
          tapGain.gain.setValueAtTime(hitAmp * 0.65, hitTime);
          tapGain.gain.exponentialRampToValueAtTime(0.001, hitTime + 0.02);
          noise.connect(filter);
          filter.connect(tapGain);
          tapGain.connect(voiceGain);
          noise.start(hitTime);
          noise.stop(hitTime + 0.022);
          sources.push(noise);
        }

        step = 0.034 - progress * 0.014;
        tCurr += step + (Math.random() - 0.5) * 0.003;
      }

      // 3. Grand Finale Hit (Crash Cymbal + Bass Kick) at t=2.18s
      const finaleTime = now + rollDuration + 0.02;

      // Bass Kick
      const kick = audioCtx.createOscillator();
      const kickGain = audioCtx.createGain();
      kick.frequency.setValueAtTime(140, finaleTime);
      kick.frequency.exponentialRampToValueAtTime(45, finaleTime + 0.16);
      kickGain.gain.setValueAtTime(0.95, finaleTime);
      kickGain.gain.exponentialRampToValueAtTime(0.001, finaleTime + 0.2);
      kick.connect(kickGain);
      kickGain.connect(voiceGain);
      kick.start(finaleTime);
      kick.stop(finaleTime + 0.22);
      sources.push(kick);

      // Shimmering Crash Cymbal
      if (noiseBufferCache) {
        const crash = audioCtx.createBufferSource();
        crash.buffer = noiseBufferCache;
        const crashFilter = audioCtx.createBiquadFilter();
        crashFilter.type = 'highpass';
        crashFilter.frequency.setValueAtTime(3800, finaleTime);
        const crashGain = audioCtx.createGain();
        crashGain.gain.setValueAtTime(0.9, finaleTime);
        crashGain.gain.exponentialRampToValueAtTime(0.0001, finaleTime + 1.8);
        crash.connect(crashFilter);
        crashFilter.connect(crashGain);
        crashGain.connect(voiceGain);
        crash.start(finaleTime);
        crash.stop(finaleTime + 1.85);
        sources.push(crash);

        // Cymbal Ringing Resonator (4.8kHz bell ring)
        const ring = audioCtx.createOscillator();
        ring.type = 'sine';
        ring.frequency.setValueAtTime(4800, finaleTime);
        const ringGain = audioCtx.createGain();
        ringGain.gain.setValueAtTime(0.2, finaleTime);
        ringGain.gain.exponentialRampToValueAtTime(0.0001, finaleTime + 1.2);
        ring.connect(ringGain);
        ringGain.connect(voiceGain);
        ring.start(finaleTime);
        ring.stop(finaleTime + 1.25);
        sources.push(ring);
      }

      const instance = registerInstance(voiceGain, sources, padEl);
      setTimeout(() => unregisterInstance(instance), 3800);
      return instance;
    }

    // Pad 8: 팡파르 (Majestic Brass Section Fanfare)
    function playFanfare() {
      ensureAudioContext();
      if (polyphonyMode === 'cut') panicStop(false);

      const now = audioCtx.currentTime;
      const padEl = document.getElementById('pad-8');

      const voiceGain = audioCtx.createGain();
      voiceGain.connect(masterGainNode);
      const sources = [];

      // Brass Fanfare Melody + Grand Triumphant Final Chord
      const notes = [
        { t: 0.00, dur: 0.13, freqs: [392.00] }, // G4
        { t: 0.16, dur: 0.13, freqs: [523.25] }, // C5
        { t: 0.32, dur: 0.13, freqs: [659.25] }, // E5
        { t: 0.48, dur: 0.38, freqs: [783.99] }, // G5 (High)
        // Grand Final Major Chord (Full Brass Section!)
        { t: 0.94, dur: 1.50, freqs: [130.81, 196.00, 261.63, 329.63, 392.00, 523.25] }
      ];

      notes.forEach(item => {
        const start = now + item.t;
        const isChord = item.freqs.length > 1;

        item.freqs.forEach(freq => {
          // Dual detuned sawtooths for rich brass chorus (+/- 5 cents)
          const osc1 = audioCtx.createOscillator();
          osc1.type = 'sawtooth';
          osc1.frequency.setValueAtTime(freq, start);

          const osc2 = audioCtx.createOscillator();
          osc2.type = 'sawtooth';
          osc2.frequency.setValueAtTime(freq * 1.004, start); // +7 cents chorus

          // Dynamic Brass Filter Envelope ("BWAH!" brass articulation)
          const filter = audioCtx.createBiquadFilter();
          filter.type = 'lowpass';
          filter.Q.setValueAtTime(2.2, start);
          filter.frequency.setValueAtTime(450, start);
          filter.frequency.linearRampToValueAtTime(3800, start + 0.025);
          filter.frequency.exponentialRampToValueAtTime(2200, start + item.dur * 0.5);

          const noteGain = audioCtx.createGain();
          const amp = isChord ? 0.22 : 0.48;
          noteGain.gain.setValueAtTime(0.0001, start);
          noteGain.gain.linearRampToValueAtTime(amp, start + 0.015);
          noteGain.gain.setValueAtTime(amp, start + item.dur - 0.05);
          noteGain.gain.exponentialRampToValueAtTime(0.0001, start + item.dur);

          osc1.connect(filter);
          osc2.connect(filter);
          filter.connect(noteGain);
          noteGain.connect(voiceGain);

          osc1.start(start);
          osc2.start(start);
          osc1.stop(start + item.dur + 0.05);
          osc2.stop(start + item.dur + 0.05);
          sources.push(osc1, osc2);
        });
      });

      const instance = registerInstance(voiceGain, sources, padEl);
      setTimeout(() => unregisterInstance(instance), 2600);
      return instance;
    }

    // Pad 9: 박수 갈채 (Authentic Granular Crowd Applause & Cheers)
    function playApplause(isHold = false) {
      ensureAudioContext();
      if (!applauseBufferCache) generateApplauseBuffer();
      if (polyphonyMode === 'cut') panicStop(false);

      const now = audioCtx.currentTime;
      const padEl = document.getElementById('pad-9');

      const voiceGain = audioCtx.createGain();
      voiceGain.connect(masterGainNode);

      const source = audioCtx.createBufferSource();
      source.buffer = applauseBufferCache;

      if (isHold) {
        source.loop = true;
        source.loopStart = 0.3;
        source.loopEnd = 2.4;
      }

      voiceGain.gain.setValueAtTime(0.001, now);
      voiceGain.gain.linearRampToValueAtTime(0.95, now + 0.08);

      source.connect(voiceGain);
      source.start(now);

      const instance = registerInstance(voiceGain, [source], padEl);
      if (!isHold) {
        setTimeout(() => unregisterInstance(instance), 3250);
      }
      return instance;
    }

    // Sound Dispatcher
    function startSound(padNumber, isHold = false) {
      switch (parseInt(padNumber, 10)) {
        case 1: return playBuzzer(isHold);
        case 2: return playChime();
        case 3: return playPunchline();
        case 4: return playCensorBeep(isHold);
        case 5: return playExplosion();
        case 6: return playCrickets(isHold);
        case 7: return playDrumRoll(isHold);
        case 8: return playFanfare();
        case 9: return playApplause(isHold);
        default: return null;
      }
    }

    // --------------------------------------------------------------------------
    // 4. Custom User Audio Upload Slots (Slots A & B)
    // --------------------------------------------------------------------------
    function playCustomSlot(slotIndex) {
      ensureAudioContext();
      if (!customBuffers[slotIndex]) {
        // Open file dialog if empty
        const fileInput = document.getElementById(`file-input-${slotIndex}`);
        if (fileInput) fileInput.click();
        return null;
      }

      if (polyphonyMode === 'cut') panicStop(false);

      const now = audioCtx.currentTime;
      const cardEl = document.getElementById(`slot-card-${slotIndex}`);

      const voiceGain = audioCtx.createGain();
      voiceGain.gain.setValueAtTime(0.9, now);
      voiceGain.connect(masterGainNode);

      const source = audioCtx.createBufferSource();
      source.buffer = customBuffers[slotIndex];
      source.connect(voiceGain);

      source.start(now);

      const instance = registerInstance(voiceGain, [source], cardEl);
      const durationMs = Math.min(customBuffers[slotIndex].duration * 1000, 30000);
      setTimeout(() => unregisterInstance(instance), durationMs);
      return instance;
    }

    function handleAudioFileUpload(file, slotIndex) {
      if (!file) return;
      ensureAudioContext();

      const reader = new FileReader();
      reader.onload = function (e) {
        const arrayBuffer = e.target.result;
        audioCtx.decodeAudioData(arrayBuffer, function (decoded) {
          customBuffers[slotIndex] = decoded;
          customMeta[slotIndex] = {
            name: file.name,
            duration: decoded.duration.toFixed(1)
          };
          updateCustomSlotUI(slotIndex);
          showToast(`슬롯 ${slotIndex === 0 ? 'A' : 'B'} 등록 완료: ${file.name}`);

          // LocalStorage caching if < 1.5MB
          if (file.size < 1.5 * 1024 * 1024) {
            try {
              const base64Reader = new FileReader();
              base64Reader.onload = function (b64Evt) {
                try {
                  localStorage.setItem(`errorledger_sound_slot_${slotIndex}`, b64Evt.target.result);
                  localStorage.setItem(`errorledger_sound_meta_${slotIndex}`, JSON.stringify(customMeta[slotIndex]));
                } catch (quotaErr) {}
              };
              base64Reader.readAsDataURL(file);
            } catch (e) {}
          }
        }, function () {
          showToast('오디오 디코딩 실패 (지원되지 않는 오디오 코덱)', 'warning');
        });
      };
      reader.readAsArrayBuffer(file);
    }

    function updateCustomSlotUI(slotIndex) {
      const card = document.getElementById(`slot-card-${slotIndex}`);
      if (!card) return;
      const emptyView = card.querySelector('.slot-view-empty');
      const loadedView = card.querySelector('.slot-view-loaded');
      const tagEl = document.getElementById(`slot-tag-${slotIndex}`);
      const nameEl = document.getElementById(`slot-name-${slotIndex}`);
      const metaEl = document.getElementById(`slot-meta-${slotIndex}`);
      const deleteBtn = document.getElementById(`slot-delete-${slotIndex}`);

      if (customBuffers[slotIndex] && customMeta[slotIndex]) {
        emptyView.classList.add('hidden');
        loadedView.classList.remove('hidden');
        if (tagEl) {
          tagEl.textContent = '등록됨';
          tagEl.classList.add('loaded');
        }
        if (nameEl) nameEl.textContent = customMeta[slotIndex].name;
        if (metaEl) metaEl.textContent = `${customMeta[slotIndex].duration}s • 클릭 / 단축키 재생`;
        if (deleteBtn) deleteBtn.classList.remove('hidden');
      } else {
        emptyView.classList.remove('hidden');
        loadedView.classList.add('hidden');
        if (tagEl) {
          tagEl.textContent = '미등록';
          tagEl.classList.remove('loaded');
        }
        if (deleteBtn) deleteBtn.classList.add('hidden');
      }
    }

    function clearCustomSlot(slotIndex) {
      customBuffers[slotIndex] = null;
      customMeta[slotIndex] = null;
      try {
        localStorage.removeItem(`errorledger_sound_slot_${slotIndex}`);
        localStorage.removeItem(`errorledger_sound_meta_${slotIndex}`);
      } catch (e) {}
      updateCustomSlotUI(slotIndex);
      showToast(`슬롯 ${slotIndex === 0 ? 'A' : 'B'} 초기화 완료`);
    }

    function restoreCachedCustomSlots() {
      [0, 1].forEach(slotIndex => {
        try {
          const cachedData = localStorage.getItem(`errorledger_sound_slot_${slotIndex}`);
          const metaStr = localStorage.getItem(`errorledger_sound_meta_${slotIndex}`);
          if (cachedData && metaStr) {
            const meta = JSON.parse(metaStr);
            fetch(cachedData)
              .then(res => res.arrayBuffer())
              .then(buf => {
                if (!audioCtx) {
                  const AudioContextClass = window.AudioContext || window.webkitAudioContext;
                  audioCtx = new AudioContextClass();
                }
                return audioCtx.decodeAudioData(buf);
              })
              .then(decoded => {
                customBuffers[slotIndex] = decoded;
                customMeta[slotIndex] = meta;
                updateCustomSlotUI(slotIndex);
              })
              .catch(() => {});
          }
        } catch (e) {}
      });
    }

    // --------------------------------------------------------------------------
    // 5. Trigger Handler: One-Shot vs Hold-To-Play
    // --------------------------------------------------------------------------
    function handlePadDown(padKey) {
      ensureAudioContext();

      // If already holding this pad, avoid re-triggering
      if (heldPadInstances.has(padKey)) return;

      const isHold = (triggerMode === 'hold');
      let instance = null;

      if (padKey.startsWith('slot-')) {
        const slotIdx = parseInt(padKey.replace('slot-', ''), 10);
        instance = playCustomSlot(slotIdx);
      } else {
        instance = startSound(padKey, isHold);
      }

      if (instance && isHold) {
        heldPadInstances.set(padKey, instance);
      }
    }

    function handlePadUp(padKey) {
      if (triggerMode === 'hold' && heldPadInstances.has(padKey)) {
        const instance = heldPadInstances.get(padKey);
        stopSingleInstance(instance);
        heldPadInstances.delete(padKey);
      }

      // Remove visual pressed state
      let padEl = null;
      if (padKey.startsWith('slot-')) {
        padEl = document.getElementById(`slot-card-${padKey.replace('slot-', '')}`);
      } else {
        padEl = document.getElementById(`pad-${padKey}`);
      }
      if (padEl) padEl.classList.remove('pressed');
    }

    // --------------------------------------------------------------------------
    // 6. Visualizer Canvas
    // --------------------------------------------------------------------------
    function startVisualizerLoop() {
      if (!visualizerCanvas || !analyserNode) return;
      const ctx = visualizerCanvas.getContext('2d');
      const bufferLength = analyserNode.frequencyBinCount;
      const dataArray = new Uint8Array(bufferLength);

      function draw() {
        requestAnimationFrame(draw);

        visualizerCanvas.width = visualizerCanvas.offsetWidth;
        const width = visualizerCanvas.width;
        const height = visualizerCanvas.height;

        analyserNode.getByteTimeDomainData(dataArray);

        ctx.clearRect(0, 0, width, height);
        ctx.lineWidth = 2;

        const isPlaying = activeInstances.size > 0;
        ctx.strokeStyle = isPlaying ? '#00ffcc' : '#26334d';
        ctx.shadowColor = isPlaying ? '#00ffcc' : 'transparent';
        ctx.shadowBlur = isPlaying ? 8 : 0;

        ctx.beginPath();
        const sliceWidth = width / bufferLength;
        let x = 0;

        for (let i = 0; i < bufferLength; i++) {
          const v = dataArray[i] / 128.0;
          const y = (v * height) / 2;

          if (i === 0) {
            ctx.moveTo(x, y);
          } else {
            ctx.lineTo(x, y);
          }
          x += sliceWidth;
        }

        ctx.lineTo(width, height / 2);
        ctx.stroke();
      }

      draw();
    }

    // --------------------------------------------------------------------------
    // 7. Event Setup
    // --------------------------------------------------------------------------
    function setupEvents() {
      // 1. Overlay Unlock
      if (unlockBtn) {
        unlockBtn.addEventListener('click', function () {
          ensureAudioContext();
        });
      }

      window.addEventListener('click', function () {
        ensureAudioContext();
      }, { once: true });

      // 2. 3x3 Tactile Sound Pads Pointer Events (PointerDown & PointerUp for Hold Mode)
      document.querySelectorAll('.sound-pad[data-pad]').forEach(pad => {
        const padNum = pad.getAttribute('data-pad');

        pad.addEventListener('pointerdown', function (e) {
          pad.classList.add('pressed');
          handlePadDown(padNum);
        });

        pad.addEventListener('pointerup', function () {
          handlePadUp(padNum);
        });

        pad.addEventListener('pointerleave', function () {
          handlePadUp(padNum);
        });

        pad.addEventListener('pointercancel', function () {
          handlePadUp(padNum);
        });
      });

      // 3. Custom Slot Pads
      [0, 1].forEach(slotIndex => {
        const card = document.getElementById(`slot-card-${slotIndex}`);
        const fileInput = document.getElementById(`file-input-${slotIndex}`);
        const deleteBtn = document.getElementById(`slot-delete-${slotIndex}`);
        const slotKey = `slot-${slotIndex}`;

        if (!card) return;

        card.addEventListener('pointerdown', function (e) {
          if (e.target.closest('.slot-delete-btn')) return;
          card.classList.add('pressed');
          handlePadDown(slotKey);
        });

        card.addEventListener('pointerup', function () {
          handlePadUp(slotKey);
        });

        card.addEventListener('pointerleave', function () {
          handlePadUp(slotKey);
        });

        card.addEventListener('pointercancel', function () {
          handlePadUp(slotKey);
        });

        // File picker
        if (fileInput) {
          fileInput.addEventListener('change', function () {
            if (this.files && this.files[0]) {
              handleAudioFileUpload(this.files[0], slotIndex);
            }
          });
        }

        // Delete button
        if (deleteBtn) {
          deleteBtn.addEventListener('click', function (e) {
            e.stopPropagation();
            clearCustomSlot(slotIndex);
          });
        }

        // Drag & Drop
        card.addEventListener('dragover', function (e) {
          e.preventDefault();
          this.classList.add('drag-over');
        });

        card.addEventListener('dragleave', function () {
          this.classList.remove('drag-over');
        });

        card.addEventListener('drop', function (e) {
          e.preventDefault();
          this.classList.remove('drag-over');
          if (e.dataTransfer && e.dataTransfer.files && e.dataTransfer.files[0]) {
            handleAudioFileUpload(e.dataTransfer.files[0], slotIndex);
          }
        });
      });

      // 4. Keyboard Shortcuts: Keydown & Keyup (Exact Numpad 789, 456, 123, 0, .)
      const keyToPadMap = {
        'Digit7': '7', 'Numpad7': '7', '7': '7',
        'Digit8': '8', 'Numpad8': '8', '8': '8',
        'Digit9': '9', 'Numpad9': '9', '9': '9',
        'Digit4': '4', 'Numpad4': '4', '4': '4',
        'Digit5': '5', 'Numpad5': '5', '5': '5',
        'Digit6': '6', 'Numpad6': '6', '6': '6',
        'Digit1': '1', 'Numpad1': '1', '1': '1',
        'Digit2': '2', 'Numpad2': '2', '2': '2',
        'Digit3': '3', 'Numpad3': '3', '3': '3',
        'Digit0': 'slot-0', 'Numpad0': 'slot-0', '0': 'slot-0', 'KeyQ': 'slot-0', 'q': 'slot-0',
        'Period': 'slot-1', 'NumpadDecimal': 'slot-1', '.': 'slot-1', 'KeyW': 'slot-1', 'w': 'slot-1'
      };

      window.addEventListener('keydown', function (e) {
        if (e.target.tagName === 'INPUT' && e.target.type !== 'range') return;
        ensureAudioContext();

        // Panic Stop: Space or Escape
        if (e.code === 'Space' || e.key === ' ' || e.key === 'Escape') {
          e.preventDefault();
          panicStop(true);
          return;
        }

        const padKey = keyToPadMap[e.code] || keyToPadMap[e.key];
        if (padKey) {
          if (e.repeat && triggerMode === 'hold') return; // ignore OS key repeat in hold mode

          let padEl = null;
          if (padKey.startsWith('slot-')) {
            padEl = document.getElementById(`slot-card-${padKey.replace('slot-', '')}`);
          } else {
            padEl = document.getElementById(`pad-${padKey}`);
          }

          if (padEl) padEl.classList.add('pressed');
          handlePadDown(padKey);
        }
      });

      window.addEventListener('keyup', function (e) {
        if (e.target.tagName === 'INPUT' && e.target.type !== 'range') return;

        const padKey = keyToPadMap[e.code] || keyToPadMap[e.key];
        if (padKey) {
          handlePadUp(padKey);
        }
      });

      // 5. Master Volume Slider (With Dynamic Track Fill)
      if (volSlider) {
        function updateVolVisual(val) {
          const pct = Math.round(val);
          masterVolume = pct / 100;
          if (volDisplay) volDisplay.textContent = `${pct}%`;

          // Update visible track line gradient fill
          const fillPercent = (pct / 150) * 100;
          volSlider.style.background = `linear-gradient(to right, #00ffcc 0%, #00ffcc ${fillPercent}%, #233147 ${fillPercent}%, #233147 100%)`;

          if (volIcon) {
            if (pct === 0) volIcon.textContent = '🔇';
            else if (pct < 50) volIcon.textContent = '🔉';
            else volIcon.textContent = '🔊';
          }

          if (masterGainNode && audioCtx) {
            masterGainNode.gain.setValueAtTime(masterVolume, audioCtx.currentTime);
          }
        }

        volSlider.addEventListener('input', function () {
          updateVolVisual(this.value);
        });

        // Initialize track visuals
        updateVolVisual(volSlider.value);
      }

      // 6. Polyphony Mode (Overlap vs Cut)
      if (btnOverlap && btnCut) {
        btnOverlap.addEventListener('click', function () {
          polyphonyMode = 'overlap';
          btnOverlap.classList.add('active');
          btnCut.classList.remove('active');
          showToast('재생 모드: 동시 재생 (Overlap Mode)');
        });

        btnCut.addEventListener('click', function () {
          polyphonyMode = 'cut';
          btnCut.classList.add('active');
          btnOverlap.classList.remove('active');
          showToast('재생 모드: 단일 컷 (Cut Mode - 새 소리 재생 시 이전 소리 컷)');
        });
      }

      // 7. Trigger Mode (One-Shot vs Hold)
      if (btnTrigOneshot && btnTrigHold) {
        btnTrigOneshot.addEventListener('click', function () {
          triggerMode = 'oneshot';
          btnTrigOneshot.classList.add('active');
          btnTrigHold.classList.remove('active');
          showToast('트리거 모드: 1회 전체 재생 (One-Shot)');
        });

        btnTrigHold.addEventListener('click', function () {
          triggerMode = 'hold';
          btnTrigHold.classList.add('active');
          btnTrigOneshot.classList.remove('active');
          showToast('트리거 모드: 누르는 동안만 재생 (Hold to Play)');
        });
      }

      // 8. Panic Stop Button
      if (panicStopBtn) {
        panicStopBtn.addEventListener('click', function () {
          panicStop(true);
        });
      }

      // 9. Stream Utilities: Focus Mode
      if (btnFocus) {
        btnFocus.addEventListener('click', function () {
          root.classList.toggle('focus-mode');
          const isFocus = root.classList.contains('focus-mode');
          btnFocus.classList.toggle('active', isFocus);
          showToast(isFocus ? '📺 집중 모드 활성화' : '집중 모드 해제');
        });
      }

      // 10. Stream Utilities: Fullscreen
      if (btnFullscreen) {
        btnFullscreen.addEventListener('click', function () {
          if (!document.fullscreenElement) {
            document.documentElement.requestFullscreen().catch(() => {});
            btnFullscreen.classList.add('active');
          } else {
            document.exitFullscreen().catch(() => {});
            btnFullscreen.classList.remove('active');
          }
        });
      }

      // 11. Stream Utilities: OBS Copy
      if (btnObsCopy) {
        btnObsCopy.addEventListener('click', function () {
          const obsUrl = `${window.location.origin}${window.location.pathname}?stream=true`;
          navigator.clipboard.writeText(obsUrl).then(function () {
            showToast('🎥 OBS 오버레이 URL 복사 완료! (?stream=true)');
          }).catch(function () {
            prompt('OBS 브라우저 소스용 URL을 복사하세요:', obsUrl);
          });
        });
      }
    }

    // --------------------------------------------------------------------------
    // 8. OBS / Stream Mode Detection
    // --------------------------------------------------------------------------
    function checkStreamMode() {
      const params = new URLSearchParams(window.location.search);
      if (params.get('stream') === 'true' || params.get('obs') === 'true' || params.get('bare') === '1') {
        document.body.classList.add('obs-stream-mode');
        if (root) root.classList.add('focus-mode');
      }
    }

    // --------------------------------------------------------------------------
    // 9. Toast Notification
    // --------------------------------------------------------------------------
    let toastTimeout = null;
    function showToast(msg, type = 'info') {
      if (!toast) return;
      toast.textContent = msg;
      toast.className = 'sb-toast show';
      if (type === 'warning') toast.classList.add('warning');

      clearTimeout(toastTimeout);
      toastTimeout = setTimeout(() => {
        toast.className = 'sb-toast';
      }, 2000);
    }

    // --------------------------------------------------------------------------
    // 10. Boot Initialization
    // --------------------------------------------------------------------------
    function init() {
      checkStreamMode();
      setupEvents();
      restoreCachedCustomSlots();
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', init);
    } else {
      init();
    }
  })();
</script>
