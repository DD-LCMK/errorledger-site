</style>

<script is:inline>
  // ============================================================================
  // BROADCAST SOUNDBOARD AUDIO ENGINE & CONTROLLER (100% Client-Side)
  // ============================================================================
  (function () {
    // State
    let audioCtx = null;
    let masterGainNode = null;
    let analyserNode = null;
    let masterVolume = 0.5;
    let polyphonyMode = 'cut'; // 'overlap' | 'cut'
    let triggerMode = 'hold';   // 'oneshot' | 'hold'
    const activeInstances = new Set(); // Tracks active sounds
    const heldPadInstances = new Map(); // Tracks currently held sounds in Hold mode (padId -> instance)

    // Audio Caches
    let noiseBufferCache = null;
    let distortionCurveCache = null;

    // Custom Slots Decoded Buffers
    const customBuffers = [null, null];
    const customMeta = [null, null];

    // DOM Elements
    const root = document.getElementById('soundboard-root');
    const overlay = document.getElementById('audio-unlock-overlay');
    const unlockBtn = document.getElementById('unlock-start-btn');
    const volSlider = document.getElementById('master-volume');
    const volDisplay = document.getElementById('vol-display');
    const volIcon = document.getElementById('vol-icon');
    const btnOverlap = document.getElementById('btn-mode-overlap');
    const btnCut = document.getElementById('btn-mode-cut');
    const btnTrigOneshot = document.getElementById('btn-trig-oneshot');
    const btnTrigHold = document.getElementById('btn-trig-hold');
    const panicStopBtn = document.getElementById('panic-stop-btn');
    const btnFocus = document.getElementById('btn-focus-mode');
    const btnObsCopy = document.getElementById('btn-obs-copy');
    const btnFullscreen = document.getElementById('btn-fullscreen');
    const visualizerCanvas = document.getElementById('visualizer-canvas');
    const statusDot = document.getElementById('audio-status-dot');
    const statusText = document.getElementById('audio-status-text');
    const toast = document.getElementById('sb-toast');

    // --------------------------------------------------------------------------
    // 1. Audio Engine Initialization
    // --------------------------------------------------------------------------
    function ensureAudioContext() {
      if (!audioCtx) {
        const AudioContextClass = window.AudioContext || window.webkitAudioContext;
        audioCtx = new AudioContextClass();

        // Master Gain
        masterGainNode = audioCtx.createGain();
        masterGainNode.gain.setValueAtTime(masterVolume, audioCtx.currentTime);

        // Analyser for real-time visualizer
        analyserNode = audioCtx.createAnalyser();
        analyserNode.fftSize = 128;
        analyserNode.smoothingTimeConstant = 0.8;

        masterGainNode.connect(analyserNode);
        analyserNode.connect(audioCtx.destination);

        // Pre-generate noise buffer
        generateNoiseBuffer();

        // Start Canvas Visualizer
        startVisualizerLoop();
      }

      if (audioCtx.state === 'suspended') {
        audioCtx.resume();
      }

      // Hide interaction overlay
      if (overlay && overlay.classList.contains('active')) {
        overlay.classList.remove('active');
      }

      if (statusDot) statusDot.classList.add('active');
      if (statusText) statusText.textContent = 'AUDIO ENGINE ACTIVE';
    }

    function generateNoiseBuffer() {
      if (!audioCtx) return;
      const bufferSize = audioCtx.sampleRate * 3.5; // 3.5 seconds
      noiseBufferCache = audioCtx.createBuffer(1, bufferSize, audioCtx.sampleRate);
      const data = noiseBufferCache.getChannelData(0);
      for (let i = 0; i < bufferSize; i++) {
        data[i] = Math.random() * 2 - 1;
      }
    }

    // Soft-clipping saturation curve for punchy game show buzzers and impacts
    function getDistortionCurve(k = 3.5) {
      if (distortionCurveCache) return distortionCurveCache;
      const n = 1024;
      const curve = new Float32Array(n);
      for (let i = 0; i < n; ++i) {
        const x = (i * 2) / n - 1;
        curve[i] = Math.tanh(k * x);
      }
      distortionCurveCache = curve;
      return curve;
    }

    // --------------------------------------------------------------------------
    // 2. Sound Instance Registration & Stopping
    // --------------------------------------------------------------------------
    function registerInstance(gainNode, sources, padElement) {
      const instance = { gainNode, sources, padElement };
      activeInstances.add(instance);

      if (padElement) {
        padElement.classList.add('playing');
      }
      if (statusDot) statusDot.classList.add('playing');

      return instance;
    }

    function unregisterInstance(instance) {
      if (!instance) return;
      activeInstances.delete(instance);

      if (instance.padElement) {
        let hasOther = false;
        activeInstances.forEach(it => {
          if (it.padElement === instance.padElement) hasOther = true;
        });
        if (!hasOther) {
          instance.padElement.classList.remove('playing');
        }
      }

      if (activeInstances.size === 0 && statusDot) {
        statusDot.classList.remove('playing');
      }
    }

    // Stop a single instance smoothly without clicks
    function stopSingleInstance(instance) {
      if (!instance || !audioCtx) return;
      const now = audioCtx.currentTime;
      try {
        if (instance.gainNode) {
          instance.gainNode.gain.cancelScheduledValues(now);
          instance.gainNode.gain.setValueAtTime(instance.gainNode.gain.value, now);
          instance.gainNode.gain.linearRampToValueAtTime(0.0001, now + 0.015);
        }
        if (instance.sources) {
          instance.sources.forEach(src => {
            try { src.stop(now + 0.02); } catch (e) {}
          });
        }
      } catch (e) {}

      unregisterInstance(instance);
    }

    // Global Panic Stop (Space / Esc)
    function panicStop(showFeedback = true) {
      if (!audioCtx) return;
      const now = audioCtx.currentTime;

      activeInstances.forEach(instance => {
        try {
          if (instance.gainNode) {
            instance.gainNode.gain.cancelScheduledValues(now);
            instance.gainNode.gain.setValueAtTime(instance.gainNode.gain.value, now);
            instance.gainNode.gain.linearRampToValueAtTime(0.0001, now + 0.015);
          }
          if (instance.sources) {
            instance.sources.forEach(src => {
              try { src.stop(now + 0.02); } catch (e) {}
            });
          }
        } catch (e) {}
      });

      activeInstances.clear();
      heldPadInstances.clear();

      document.querySelectorAll('.sound-pad').forEach(el => {
        el.classList.remove('playing', 'pressed');
      });

      if (statusDot) statusDot.classList.remove('playing');
      if (showFeedback) showToast('🛑 ALL SOUNDS STOPPED (긴급 정지)', 'warning');
    }

    // --------------------------------------------------------------------------
    // 3. Procedural Audio Synthesis (Pads 1 ~ 9)
    // --------------------------------------------------------------------------

    // Pad 1: 땡! (예능 오답 버저 - Resonant Variety Quiz Show Buzzer)
    function playBuzzer(isHold = false) {
      ensureAudioContext();
      if (polyphonyMode === 'cut') panicStop(false);

      const now = audioCtx.currentTime;
      const padEl = document.getElementById('pad-1');

      const voiceGain = audioCtx.createGain();
      voiceGain.connect(masterGainNode);

      // Bandpass horn formant filter for authentic nasal TV quiz buzzer character
      const hornFilter = audioCtx.createBiquadFilter();
      hornFilter.type = 'bandpass';
      hornFilter.frequency.setValueAtTime(950, now);
      hornFilter.Q.setValueAtTime(2.2, now);

      const shaper = audioCtx.createWaveShaper();
      shaper.curve = getDistortionCurve(3.2);

      // Dual detuned tones for dissonant buzzer buzz: F#3 (185Hz) + G3 (196Hz)
      const osc1 = audioCtx.createOscillator();
      osc1.type = 'sawtooth';
      osc1.frequency.setValueAtTime(185, now);

      const osc2 = audioCtx.createOscillator();
      osc2.type = 'sawtooth';
      osc2.frequency.setValueAtTime(196, now);

      // Sub punch
      const sub = audioCtx.createOscillator();
      sub.type = 'sine';
      sub.frequency.setValueAtTime(92, now);

      const mixGain = audioCtx.createGain();
      mixGain.gain.setValueAtTime(0.7, now);

      osc1.connect(mixGain);
      osc2.connect(mixGain);
      sub.connect(mixGain);
      mixGain.connect(shaper);
      shaper.connect(hornFilter);
      hornFilter.connect(voiceGain);

      // Attack mallet strike transient
      const click = audioCtx.createOscillator();
      const clickGain = audioCtx.createGain();
      click.type = 'triangle';
      click.frequency.setValueAtTime(320, now);
      click.frequency.exponentialRampToValueAtTime(80, now + 0.025);
      clickGain.gain.setValueAtTime(0.75, now);
      clickGain.gain.exponentialRampToValueAtTime(0.001, now + 0.03);
      click.connect(clickGain);
      clickGain.connect(voiceGain);
      click.start(now);
      click.stop(now + 0.035);

      const maxDur = isHold ? 12 : 0.65;
      voiceGain.gain.setValueAtTime(0.001, now);
      voiceGain.gain.linearRampToValueAtTime(1.1, now + 0.012);

      if (!isHold) {
        voiceGain.gain.setValueAtTime(1.1, now + 0.52);
        voiceGain.gain.linearRampToValueAtTime(0.0001, now + 0.65);
      }

      osc1.start(now);
      osc2.start(now);
      sub.start(now);
      osc1.stop(now + maxDur);
      osc2.stop(now + maxDur);
      sub.stop(now + maxDur);

      const instance = registerInstance(voiceGain, [osc1, osc2, sub, click], padEl);
      if (!isHold) {
        setTimeout(() => unregisterInstance(instance), 680);
      }
      return instance;
    }

    // Pad 2: 띵-! (성공 코인 / 레벨업 - Crystalline Arcade Reward Chime)
    function playCoinChime() {
      ensureAudioContext();
      if (polyphonyMode === 'cut') panicStop(false);

      const now = audioCtx.currentTime;
      const padEl = document.getElementById('pad-2');

      const voiceGain = audioCtx.createGain();
      voiceGain.connect(masterGainNode);
      const sources = [];

      // 2-step sparkling arcade reward chime: Note 1 (B5, 987.77Hz) -> Note 2 (E6, 1318.51Hz)
      const notes = [
        { t: 0.00, freq: 987.77, dur: 0.45, amp: 0.6 },
        { t: 0.085, freq: 1318.51, dur: 0.85, amp: 0.8 }
      ];

      notes.forEach(n => {
        const start = now + n.t;

        const osc = audioCtx.createOscillator();
        osc.type = 'sine';
        osc.frequency.setValueAtTime(n.freq, start);

        const sparkle = audioCtx.createOscillator();
        sparkle.type = 'sine';
        sparkle.frequency.setValueAtTime(n.freq * 2, start);

        const shimmer = audioCtx.createOscillator();
        shimmer.type = 'sine';
        shimmer.frequency.setValueAtTime(n.freq * 2.756, start);

        const gain = audioCtx.createGain();
        gain.gain.setValueAtTime(0.0001, start);
        gain.gain.linearRampToValueAtTime(n.amp, start + 0.004);
        gain.gain.exponentialRampToValueAtTime(0.0001, start + n.dur);

        const sparkleGain = audioCtx.createGain();
        sparkleGain.gain.setValueAtTime(0.0001, start);
        sparkleGain.gain.linearRampToValueAtTime(n.amp * 0.35, start + 0.004);
        sparkleGain.gain.exponentialRampToValueAtTime(0.0001, start + n.dur * 0.6);

        const shimmerGain = audioCtx.createGain();
        shimmerGain.gain.setValueAtTime(0.0001, start);
        shimmerGain.gain.linearRampToValueAtTime(n.amp * 0.15, start + 0.003);
        shimmerGain.gain.exponentialRampToValueAtTime(0.0001, start + n.dur * 0.35);

        osc.connect(gain);
        sparkle.connect(sparkleGain);
        shimmer.connect(shimmerGain);

        gain.connect(voiceGain);
        sparkleGain.connect(voiceGain);
        shimmerGain.connect(voiceGain);

        osc.start(start);
        sparkle.start(start);
        shimmer.start(start);
        osc.stop(start + n.dur + 0.02);
        sparkle.stop(start + n.dur * 0.65);
        shimmer.stop(start + n.dur * 0.4);

        sources.push(osc, sparkle, shimmer);
      });

      const instance = registerInstance(voiceGain, sources, padEl);
      setTimeout(() => unregisterInstance(instance), 1050);
      return instance;
    }

    // Pad 3: 두둥탁! (Ba-Dum-Tss Punchline) - KEPT
    function playPunchline() {
      ensureAudioContext();
      if (polyphonyMode === 'cut') panicStop(false);

      const now = audioCtx.currentTime;
      const padEl = document.getElementById('pad-3');

      const voiceGain = audioCtx.createGain();
      voiceGain.connect(masterGainNode);
      const sources = [];

      // Kick 1: "두" (t=0.0s)
      const kick1 = audioCtx.createOscillator();
      const kickGain1 = audioCtx.createGain();
      kick1.frequency.setValueAtTime(140, now);
      kick1.frequency.exponentialRampToValueAtTime(45, now + 0.12);
      kickGain1.gain.setValueAtTime(0.85, now);
      kickGain1.gain.exponentialRampToValueAtTime(0.001, now + 0.14);
      kick1.connect(kickGain1);
      kickGain1.connect(voiceGain);
      kick1.start(now);
      kick1.stop(now + 0.15);
      sources.push(kick1);

      // Kick 2: "둥" (t=0.17s)
      const kickTime2 = now + 0.17;
      const kick2 = audioCtx.createOscillator();
      const kickGain2 = audioCtx.createGain();
      kick2.frequency.setValueAtTime(160, kickTime2);
      kick2.frequency.exponentialRampToValueAtTime(48, kickTime2 + 0.13);
      kickGain2.gain.setValueAtTime(0.9, kickTime2);
      kickGain2.gain.exponentialRampToValueAtTime(0.001, kickTime2 + 0.15);
      kick2.connect(kickGain2);
      kickGain2.connect(voiceGain);
      kick2.start(kickTime2);
      kick2.stop(kickTime2 + 0.16);
      sources.push(kick2);

      // Snare + Cymbal Hit: "탁!" (t=0.34s)
      const hitTime = now + 0.34;
      const snareBody = audioCtx.createOscillator();
      snareBody.type = 'triangle';
      snareBody.frequency.setValueAtTime(210, hitTime);
      snareBody.frequency.exponentialRampToValueAtTime(70, hitTime + 0.1);
      const snareBodyGain = audioCtx.createGain();
      snareBodyGain.gain.setValueAtTime(0.7, hitTime);
      snareBodyGain.gain.exponentialRampToValueAtTime(0.001, hitTime + 0.12);
      snareBody.connect(snareBodyGain);
      snareBodyGain.connect(voiceGain);
      snareBody.start(hitTime);
      snareBody.stop(hitTime + 0.13);
      sources.push(snareBody);

      if (noiseBufferCache) {
        const noise = audioCtx.createBufferSource();
        noise.buffer = noiseBufferCache;

        const cymbalFilter = audioCtx.createBiquadFilter();
        cymbalFilter.type = 'highpass';
        cymbalFilter.frequency.setValueAtTime(4500, hitTime);

        const cymbalGain = audioCtx.createGain();
        cymbalGain.gain.setValueAtTime(0.75, hitTime);
        cymbalGain.gain.exponentialRampToValueAtTime(0.0001, hitTime + 1.1);

        noise.connect(cymbalFilter);
        cymbalFilter.connect(cymbalGain);
        cymbalGain.connect(voiceGain);

        noise.start(hitTime);
        noise.stop(hitTime + 1.15);
        sources.push(noise);
      }

      const instance = registerInstance(voiceGain, sources, padEl);
      setTimeout(() => unregisterInstance(instance), 1500);
      return instance;
    }

    // Pad 4: 삐-! (1kHz Pure Sine Censor Tone) - KEPT
    function playCensorBeep(isHold = false) {
      ensureAudioContext();
      if (polyphonyMode === 'cut') panicStop(false);

      const now = audioCtx.currentTime;
      const padEl = document.getElementById('pad-4');

      const voiceGain = audioCtx.createGain();
      voiceGain.connect(masterGainNode);

      const osc = audioCtx.createOscillator();
      osc.type = 'sine';
      osc.frequency.setValueAtTime(1000, now);

      voiceGain.gain.setValueAtTime(0.0001, now);
      voiceGain.gain.linearRampToValueAtTime(0.75, now + 0.015);

      const maxDur = isHold ? 15 : 0.9;
      if (!isHold) {
        voiceGain.gain.setValueAtTime(0.75, now + 0.85);
        voiceGain.gain.linearRampToValueAtTime(0.0001, now + 0.88);
      }

      osc.connect(voiceGain);
      osc.start(now);
      osc.stop(now + maxDur);

      const instance = registerInstance(voiceGain, [osc], padEl);
      if (!isHold) {
        setTimeout(() => unregisterInstance(instance), 900);
      }
      return instance;
    }

    // Pad 5: 에어혼 (텐션 폭발! - Hype DJ Airhorn Chord)
    function playAirhorn(isHold = false) {
      ensureAudioContext();
      if (polyphonyMode === 'cut') panicStop(false);

      const now = audioCtx.currentTime;
      const padEl = document.getElementById('pad-5');

      const voiceGain = audioCtx.createGain();
      voiceGain.connect(masterGainNode);
      const sources = [];

      // Authentic DJ Airhorn chord: F#4 (370Hz), A#4 (466Hz), C#5 (554Hz)
      const chordFreqs = [370.0, 466.16, 554.37];

      // Horn body filter
      const filter = audioCtx.createBiquadFilter();
      filter.type = 'bandpass';
      filter.frequency.setValueAtTime(1850, now);
      filter.Q.setValueAtTime(1.8, now);

      const hornDist = audioCtx.createWaveShaper();
      hornDist.curve = getDistortionCurve(2.2);

      filter.connect(voiceGain);

      // If hold mode: single continuous blast while key is held down
      // If trigger mode: iconic 4-burst DJ rhythm: [0.0, 0.13, 0.26, 0.39]
      const bursts = isHold ? [{ t: 0, dur: 12 }] : [
        { t: 0.00, dur: 0.10 },
        { t: 0.13, dur: 0.10 },
        { t: 0.26, dur: 0.10 },
        { t: 0.39, dur: 0.48 }
      ];

      bursts.forEach(b => {
        const bStart = now + b.t;
        const bDur = b.dur;

        const burstGain = audioCtx.createGain();
        burstGain.gain.setValueAtTime(0.0001, bStart);
        burstGain.gain.linearRampToValueAtTime(0.55, bStart + 0.008);

        if (!isHold) {
          burstGain.gain.setValueAtTime(0.55, bStart + bDur - 0.015);
          burstGain.gain.exponentialRampToValueAtTime(0.0001, bStart + bDur);
        }

        burstGain.connect(hornDist);

        chordFreqs.forEach(freq => {
          // Detuned pair for brassy stadium pressure
          const osc1 = audioCtx.createOscillator();
          osc1.type = 'sawtooth';
          // Pitch drop bend at the start of each horn blast
          osc1.frequency.setValueAtTime(freq * 1.04, bStart);
          osc1.frequency.exponentialRampToValueAtTime(freq, bStart + 0.025);

          const osc2 = audioCtx.createOscillator();
          osc2.type = 'sawtooth';
          osc2.frequency.setValueAtTime(freq * 1.008, bStart);

          osc1.connect(burstGain);
          osc2.connect(burstGain);

          osc1.start(bStart);
          osc2.start(bStart);
          osc1.stop(bStart + bDur + 0.02);
          osc2.stop(bStart + bDur + 0.02);
          sources.push(osc1, osc2);
        });
      });

      hornDist.connect(filter);

      const instance = registerInstance(voiceGain, sources, padEl);
      if (!isHold) {
        setTimeout(() => unregisterInstance(instance), 950);
      }
      return instance;
    }

    // Pad 6: 쉭- 끽! (레코드 스크래치 - Vinyl Turntable Needle Scratch)
    function playRecordScratch() {
      ensureAudioContext();
      if (polyphonyMode === 'cut') panicStop(false);

      const now = audioCtx.currentTime;
      const padEl = document.getElementById('pad-6');

      const voiceGain = audioCtx.createGain();
      voiceGain.connect(masterGainNode);
      const sources = [];

      // Scratch stroke 1: Quick pull ("쉭-", t=0 to 0.09s)
      if (noiseBufferCache) {
        const noise1 = audioCtx.createBufferSource();
        noise1.buffer = noiseBufferCache;
        const bpf1 = audioCtx.createBiquadFilter();
        bpf1.type = 'bandpass';
        bpf1.frequency.setValueAtTime(1400, now);
        bpf1.frequency.linearRampToValueAtTime(3600, now + 0.08);
        bpf1.Q.setValueAtTime(4.5, now);

        const gain1 = audioCtx.createGain();
        gain1.gain.setValueAtTime(0.001, now);
        gain1.gain.linearRampToValueAtTime(0.75, now + 0.02);
        gain1.gain.linearRampToValueAtTime(0.001, now + 0.09);

        noise1.connect(bpf1);
        bpf1.connect(gain1);
        gain1.connect(voiceGain);
        noise1.start(now);
        noise1.stop(now + 0.10);
        sources.push(noise1);

        // Scratch stroke 2: Sharp vinyl screech cut ("끽-!", t=0.09s to 0.32s)
        const t2 = now + 0.09;
        const noise2 = audioCtx.createBufferSource();
        noise2.buffer = noiseBufferCache;
        const bpf2 = audioCtx.createBiquadFilter();
        bpf2.type = 'bandpass';
        bpf2.frequency.setValueAtTime(4200, t2);
        bpf2.frequency.exponentialRampToValueAtTime(650, t2 + 0.20);
        bpf2.Q.setValueAtTime(6.0, t2);

        const gain2 = audioCtx.createGain();
        gain2.gain.setValueAtTime(0.001, t2);
        gain2.gain.linearRampToValueAtTime(0.9, t2 + 0.015);
        gain2.gain.exponentialRampToValueAtTime(0.0001, t2 + 0.22);

        noise2.connect(bpf2);
        bpf2.connect(gain2);
        gain2.connect(voiceGain);
        noise2.start(t2);
        noise2.stop(t2 + 0.23);
        sources.push(noise2);
      }

      // Tonal needle vinyl tone underneath scratch
      const tone = audioCtx.createOscillator();
      tone.type = 'triangle';
      const t2 = now + 0.09;
      tone.frequency.setValueAtTime(850, t2);
      tone.frequency.exponentialRampToValueAtTime(140, t2 + 0.18);

      const toneGain = audioCtx.createGain();
      toneGain.gain.setValueAtTime(0.001, t2);
      toneGain.gain.linearRampToValueAtTime(0.4, t2 + 0.02);
      toneGain.gain.exponentialRampToValueAtTime(0.001, t2 + 0.19);

      tone.connect(toneGain);
      toneGain.connect(voiceGain);
      tone.start(t2);
      tone.stop(t2 + 0.20);
      sources.push(tone);

      const instance = registerInstance(voiceGain, sources, padEl);
      setTimeout(() => unregisterInstance(instance), 360);
      return instance;
    }

    // Pad 7: 띠용~ (코믹 스프링 - Classic Cartoon Boing)
    function playBoing() {
      ensureAudioContext();
      if (polyphonyMode === 'cut') panicStop(false);

      const now = audioCtx.currentTime;
      const padEl = document.getElementById('pad-7');

      const voiceGain = audioCtx.createGain();
      voiceGain.connect(masterGainNode);
      const sources = [];

      // Cartoon comic spring: pitch ascends rapidly while vibrating with a metallic spring wobble
      const carrier = audioCtx.createOscillator();
      carrier.type = 'triangle';
      carrier.frequency.setValueAtTime(180, now);
      carrier.frequency.exponentialRampToValueAtTime(540, now + 0.24);
      carrier.frequency.exponentialRampToValueAtTime(420, now + 0.7);

      // Metallic wobble LFO (17Hz spring vibration)
      const lfo = audioCtx.createOscillator();
      lfo.frequency.setValueAtTime(17, now);
      const lfoGain = audioCtx.createGain();
      lfoGain.gain.setValueAtTime(65, now);
      lfoGain.gain.exponentialRampToValueAtTime(2, now + 0.65);
      lfo.connect(lfoGain);
      lfoGain.connect(carrier.frequency);

      // High metallic harmonic for spring ping
      const ping = audioCtx.createOscillator();
      ping.type = 'sine';
      ping.frequency.setValueAtTime(1080, now);
      ping.frequency.exponentialRampToValueAtTime(3240, now + 0.24);

      const pingGain = audioCtx.createGain();
      pingGain.gain.setValueAtTime(0.2, now);
      pingGain.gain.exponentialRampToValueAtTime(0.001, now + 0.28);
      ping.connect(pingGain);
      pingGain.connect(voiceGain);

      const carrierGain = audioCtx.createGain();
      carrierGain.gain.setValueAtTime(0.001, now);
      carrierGain.gain.linearRampToValueAtTime(0.85, now + 0.015);
      carrierGain.gain.exponentialRampToValueAtTime(0.0001, now + 0.72);

      carrier.connect(carrierGain);
      carrierGain.connect(voiceGain);

      carrier.start(now);
      lfo.start(now);
      ping.start(now);
      carrier.stop(now + 0.75);
      lfo.stop(now + 0.75);
      ping.stop(now + 0.30);
      sources.push(carrier, lfo, ping);

      const instance = registerInstance(voiceGain, sources, padEl);
      setTimeout(() => unregisterInstance(instance), 780);
      return instance;
    }

    // Pad 8: 쿠구궁! (충격 반전 - Dramatic Variety Show Shock Impact)
    function playDramaticShock() {
      ensureAudioContext();
      if (polyphonyMode === 'cut') panicStop(false);

      const now = audioCtx.currentTime;
      const padEl = document.getElementById('pad-8');

      const voiceGain = audioCtx.createGain();
      voiceGain.connect(masterGainNode);
      const sources = [];

      // 1. Initial shock hit transient
      const hit = audioCtx.createOscillator();
      hit.type = 'triangle';
      hit.frequency.setValueAtTime(320, now);
      hit.frequency.exponentialRampToValueAtTime(60, now + 0.06);
      const hitGain = audioCtx.createGain();
      hitGain.gain.setValueAtTime(0.9, now);
      hitGain.gain.exponentialRampToValueAtTime(0.001, now + 0.08);
      hit.connect(hitGain);
      hitGain.connect(voiceGain);
      hit.start(now);
      hit.stop(now + 0.09);
      sources.push(hit);

      // 2. Cinematic 808 Sub-Bass Dive (110Hz -> 38Hz)
      const sub = audioCtx.createOscillator();
      sub.type = 'sine';
      sub.frequency.setValueAtTime(110, now);
      sub.frequency.exponentialRampToValueAtTime(38, now + 0.35);
      const subGain = audioCtx.createGain();
      subGain.gain.setValueAtTime(1.0, now);
      subGain.gain.exponentialRampToValueAtTime(0.001, now + 1.6);
      sub.connect(subGain);
      subGain.connect(voiceGain);
      sub.start(now);
      sub.stop(now + 1.65);
      sources.push(sub);

      // 3. Dark dramatic dissonant variety chord: C3 (130.8Hz) + Db3 (138.6Hz) + Gb3 (185.0Hz)
      const chordFreqs = [130.81, 138.59, 184.99];
      chordFreqs.forEach(freq => {
        const osc = audioCtx.createOscillator();
        osc.type = 'sawtooth';
        osc.frequency.setValueAtTime(freq, now);

        const filter = audioCtx.createBiquadFilter();
        filter.type = 'lowpass';
        filter.frequency.setValueAtTime(650, now);
        filter.frequency.exponentialRampToValueAtTime(180, now + 1.2);
        filter.Q.setValueAtTime(3.0, now);

        const cGain = audioCtx.createGain();
        cGain.gain.setValueAtTime(0.001, now);
        cGain.gain.linearRampToValueAtTime(0.4, now + 0.04);
        cGain.gain.exponentialRampToValueAtTime(0.0001, now + 1.4);

        osc.connect(filter);
        filter.connect(cGain);
        cGain.connect(voiceGain);

        osc.start(now);
        osc.stop(now + 1.45);
        sources.push(osc);
      });

      const instance = registerInstance(voiceGain, sources, padEl);
      setTimeout(() => unregisterInstance(instance), 1700);
      return instance;
    }

    // Pad 9: 와와와~ (새드 트롬본 - Legendary Comedy Fail Trombone)
    function playSadTrombone() {
      ensureAudioContext();
      if (polyphonyMode === 'cut') panicStop(false);

      const now = audioCtx.currentTime;
      const padEl = document.getElementById('pad-9');

      const voiceGain = audioCtx.createGain();
      voiceGain.connect(masterGainNode);
      const sources = [];

      // Legendary 4-note descending comedy fail trombone:
      // D4 (293.66) -> C#4 (277.18) -> C4 (261.63) -> B3 slide down to A3 (220Hz)
      const notes = [
        { t: 0.00, freq: 293.66, dur: 0.28, isFinal: false },
        { t: 0.32, freq: 277.18, dur: 0.28, isFinal: false },
        { t: 0.64, freq: 261.63, dur: 0.28, isFinal: false },
        { t: 0.96, freq: 246.94, dur: 1.35, isFinal: true }
      ];

      notes.forEach(n => {
        const start = now + n.t;

        const osc1 = audioCtx.createOscillator();
        osc1.type = 'sawtooth';
        osc1.frequency.setValueAtTime(n.freq, start);

        const osc2 = audioCtx.createOscillator();
        osc2.type = 'sawtooth';
        osc2.frequency.setValueAtTime(n.freq * 1.006, start);

        // Mute plunger filter ("Wah-Wah" formant sweep)
        const mute = audioCtx.createBiquadFilter();
        mute.type = 'bandpass';
        mute.Q.setValueAtTime(3.2, start);
        mute.frequency.setValueAtTime(420, start);
        mute.frequency.linearRampToValueAtTime(1450, start + 0.08);
        mute.frequency.exponentialRampToValueAtTime(480, start + n.dur);

        if (n.isFinal) {
          // Final sad slide and vibrato
          osc1.frequency.setValueAtTime(n.freq, start + 0.3);
          osc1.frequency.exponentialRampToValueAtTime(207.65, start + n.dur); // slide down to G#3
          osc2.frequency.setValueAtTime(n.freq * 1.006, start + 0.3);
          osc2.frequency.exponentialRampToValueAtTime(207.65 * 1.006, start + n.dur);

          const vib = audioCtx.createOscillator();
          vib.frequency.setValueAtTime(5.5, start + 0.3);
          const vibGain = audioCtx.createGain();
          vibGain.gain.setValueAtTime(6.0, start + 0.3);
          vib.connect(vibGain);
          vibGain.connect(osc1.frequency);
          vibGain.connect(osc2.frequency);
          vib.start(start + 0.3);
          vib.stop(start + n.dur + 0.05);
          sources.push(vib);
        }

        const noteGain = audioCtx.createGain();
        noteGain.gain.setValueAtTime(0.0001, start);
        noteGain.gain.linearRampToValueAtTime(0.85, start + 0.02);
        noteGain.gain.setValueAtTime(0.85, start + n.dur - 0.06);
        noteGain.gain.exponentialRampToValueAtTime(0.0001, start + n.dur);

        osc1.connect(mute);
        osc2.connect(mute);
        mute.connect(noteGain);
        noteGain.connect(voiceGain);

        osc1.start(start);
        osc2.start(start);
        osc1.stop(start + n.dur + 0.05);
        osc2.stop(start + n.dur + 0.05);
        sources.push(osc1, osc2);
      });

      const instance = registerInstance(voiceGain, sources, padEl);
      setTimeout(() => unregisterInstance(instance), 2400);
      return instance;
    }

    // Sound Dispatcher
    function startSound(padNumber, isHold = false) {
      switch (parseInt(padNumber, 10)) {
        case 1: return playBuzzer(isHold);
        case 2: return playCoinChime();
        case 3: return playPunchline();
        case 4: return playCensorBeep(isHold);
        case 5: return playAirhorn(isHold);
        case 6: return playRecordScratch();
        case 7: return playBoing();
        case 8: return playDramaticShock();
        case 9: return playSadTrombone();
        default: return null;
      }
    }

    // --------------------------------------------------------------------------
    // 4. Custom User Audio Upload Slots (Slots A & B)
    // --------------------------------------------------------------------------
    function playCustomSlot(slotIndex) {
      ensureAudioContext();
      if (!customBuffers[slotIndex]) {
        // Open file dialog if empty
        const fileInput = document.getElementById(`file-input-${slotIndex}`);
        if (fileInput) fileInput.click();
        return null;
      }

      if (polyphonyMode === 'cut') panicStop(false);

      const now = audioCtx.currentTime;
      const cardEl = document.getElementById(`slot-card-${slotIndex}`);

      const voiceGain = audioCtx.createGain();
      voiceGain.gain.setValueAtTime(0.9, now);
      voiceGain.connect(masterGainNode);

      const source = audioCtx.createBufferSource();
      source.buffer = customBuffers[slotIndex];
      source.connect(voiceGain);

      source.start(now);

      const instance = registerInstance(voiceGain, [source], cardEl);
      const durationMs = Math.min(customBuffers[slotIndex].duration * 1000, 30000);
      setTimeout(() => unregisterInstance(instance), durationMs);
      return instance;
    }

    function handleAudioFileUpload(file, slotIndex) {
      if (!file) return;
      ensureAudioContext();

      const reader = new FileReader();
      reader.onload = function (e) {
        const arrayBuffer = e.target.result;
        audioCtx.decodeAudioData(arrayBuffer, function (decoded) {
          customBuffers[slotIndex] = decoded;
          customMeta[slotIndex] = {
            name: file.name,
            duration: decoded.duration.toFixed(1)
          };
          updateCustomSlotUI(slotIndex);
          showToast(`슬롯 ${slotIndex === 0 ? 'A' : 'B'} 등록 완료: ${file.name}`);

          // LocalStorage caching if < 1.5MB
          if (file.size < 1.5 * 1024 * 1024) {
            try {
              const base64Reader = new FileReader();
              base64Reader.onload = function (b64Evt) {
                try {
                  localStorage.setItem(`errorledger_sound_slot_${slotIndex}`, b64Evt.target.result);
                  localStorage.setItem(`errorledger_sound_meta_${slotIndex}`, JSON.stringify(customMeta[slotIndex]));
                } catch (quotaErr) {}
              };
              base64Reader.readAsDataURL(file);
            } catch (e) {}
          }
        }, function () {
          showToast('오디오 디코딩 실패 (지원되지 않는 오디오 코덱)', 'warning');
        });
      };
      reader.readAsArrayBuffer(file);
    }

    function updateCustomSlotUI(slotIndex) {
      const card = document.getElementById(`slot-card-${slotIndex}`);
      if (!card) return;
      const emptyView = card.querySelector('.slot-view-empty');
      const loadedView = card.querySelector('.slot-view-loaded');
      const tagEl = document.getElementById(`slot-tag-${slotIndex}`);
      const nameEl = document.getElementById(`slot-name-${slotIndex}`);
      const metaEl = document.getElementById(`slot-meta-${slotIndex}`);
      const deleteBtn = document.getElementById(`slot-delete-${slotIndex}`);

      if (customBuffers[slotIndex] && customMeta[slotIndex]) {
        emptyView.classList.add('hidden');
        loadedView.classList.remove('hidden');
        if (tagEl) {
          tagEl.textContent = '등록됨';
          tagEl.classList.add('loaded');
        }
        if (nameEl) nameEl.textContent = customMeta[slotIndex].name;
        if (metaEl) metaEl.textContent = `${customMeta[slotIndex].duration}s • 클릭 / 단축키 재생`;
        if (deleteBtn) deleteBtn.classList.remove('hidden');
      } else {
        emptyView.classList.remove('hidden');
        loadedView.classList.add('hidden');
        if (tagEl) {
          tagEl.textContent = '미등록';
          tagEl.classList.remove('loaded');
        }
        if (deleteBtn) deleteBtn.classList.add('hidden');
      }
    }

    function clearCustomSlot(slotIndex) {
      customBuffers[slotIndex] = null;
      customMeta[slotIndex] = null;
      try {
        localStorage.removeItem(`errorledger_sound_slot_${slotIndex}`);
        localStorage.removeItem(`errorledger_sound_meta_${slotIndex}`);
      } catch (e) {}
      updateCustomSlotUI(slotIndex);
      showToast(`슬롯 ${slotIndex === 0 ? 'A' : 'B'} 초기화 완료`);
    }

    function restoreCachedCustomSlots() {
      [0, 1].forEach(slotIndex => {
        try {
          const cachedData = localStorage.getItem(`errorledger_sound_slot_${slotIndex}`);
          const metaStr = localStorage.getItem(`errorledger_sound_meta_${slotIndex}`);
          if (cachedData && metaStr) {
            const meta = JSON.parse(metaStr);
            fetch(cachedData)
              .then(res => res.arrayBuffer())
              .then(buf => {
                if (!audioCtx) {
                  const AudioContextClass = window.AudioContext || window.webkitAudioContext;
                  audioCtx = new AudioContextClass();
                }
                return audioCtx.decodeAudioData(buf);
              })
              .then(decoded => {
                customBuffers[slotIndex] = decoded;
                customMeta[slotIndex] = meta;
                updateCustomSlotUI(slotIndex);
              })
              .catch(() => {});
          }
        } catch (e) {}
      });
    }

    // --------------------------------------------------------------------------
    // 5. Trigger Handler: One-Shot vs Hold-To-Play
    // --------------------------------------------------------------------------
    function handlePadDown(padKey) {
      ensureAudioContext();

      // If already holding this pad, avoid re-triggering
      if (heldPadInstances.has(padKey)) return;

      const isHold = (triggerMode === 'hold');
      let instance = null;

      if (padKey.startsWith('slot-')) {
        const slotIdx = parseInt(padKey.replace('slot-', ''), 10);
        instance = playCustomSlot(slotIdx);
      } else {
        instance = startSound(padKey, isHold);
      }

      if (instance && isHold) {
        heldPadInstances.set(padKey, instance);
      }
    }

    function handlePadUp(padKey) {
      if (triggerMode === 'hold' && heldPadInstances.has(padKey)) {
        const instance = heldPadInstances.get(padKey);
        stopSingleInstance(instance);
        heldPadInstances.delete(padKey);
      }

      // Remove visual pressed state
      let padEl = null;
      if (padKey.startsWith('slot-')) {
        padEl = document.getElementById(`slot-card-${padKey.replace('slot-', '')}`);
      } else {
        padEl = document.getElementById(`pad-${padKey}`);
      }
      if (padEl) padEl.classList.remove('pressed');
    }

    // --------------------------------------------------------------------------
    // 6. Visualizer Canvas
    // --------------------------------------------------------------------------
    function startVisualizerLoop() {
      if (!visualizerCanvas || !analyserNode) return;
      const ctx = visualizerCanvas.getContext('2d');
      const bufferLength = analyserNode.frequencyBinCount;
      const dataArray = new Uint8Array(bufferLength);

      function draw() {
        requestAnimationFrame(draw);

        visualizerCanvas.width = visualizerCanvas.offsetWidth;
        const width = visualizerCanvas.width;
        const height = visualizerCanvas.height;

        analyserNode.getByteTimeDomainData(dataArray);

        ctx.clearRect(0, 0, width, height);
        ctx.lineWidth = 2;

        const isPlaying = activeInstances.size > 0;
        ctx.strokeStyle = isPlaying ? '#00ffcc' : '#26334d';
        ctx.shadowColor = isPlaying ? '#00ffcc' : 'transparent';
        ctx.shadowBlur = isPlaying ? 8 : 0;

        ctx.beginPath();
        const sliceWidth = width / bufferLength;
        let x = 0;

        for (let i = 0; i < bufferLength; i++) {
          const v = dataArray[i] / 128.0;
          const y = (v * height) / 2;

          if (i === 0) {
            ctx.moveTo(x, y);
          } else {
            ctx.lineTo(x, y);
          }
          x += sliceWidth;
        }

        ctx.lineTo(width, height / 2);
        ctx.stroke();
      }

      draw();
    }

    // --------------------------------------------------------------------------
    // 7. Event Setup
    // --------------------------------------------------------------------------
    function setupEvents() {
      // 1. Overlay Unlock
      if (unlockBtn) {
        unlockBtn.addEventListener('click', function () {
          ensureAudioContext();
        });
      }

      window.addEventListener('click', function () {
        ensureAudioContext();
      }, { once: true });

      // 2. 3x3 Tactile Sound Pads Pointer Events (PointerDown & PointerUp for Hold Mode)
      document.querySelectorAll('.sound-pad[data-pad]').forEach(pad => {
        const padNum = pad.getAttribute('data-pad');

        pad.addEventListener('pointerdown', function (e) {
          pad.classList.add('pressed');
          handlePadDown(padNum);
        });

        pad.addEventListener('pointerup', function () {
          handlePadUp(padNum);
        });

        pad.addEventListener('pointerleave', function () {
          handlePadUp(padNum);
        });

        pad.addEventListener('pointercancel', function () {
          handlePadUp(padNum);
        });
      });

      // 3. Custom Slot Pads
      [0, 1].forEach(slotIndex => {
        const card = document.getElementById(`slot-card-${slotIndex}`);
        const fileInput = document.getElementById(`file-input-${slotIndex}`);
        const deleteBtn = document.getElementById(`slot-delete-${slotIndex}`);
        const slotKey = `slot-${slotIndex}`;

        if (!card) return;

        card.addEventListener('pointerdown', function (e) {
          if (e.target.closest('.slot-delete-btn')) return;
          card.classList.add('pressed');
          handlePadDown(slotKey);
        });

        card.addEventListener('pointerup', function () {
          handlePadUp(slotKey);
        });

        card.addEventListener('pointerleave', function () {
          handlePadUp(slotKey);
        });

        card.addEventListener('pointercancel', function () {
          handlePadUp(slotKey);
        });

        // File picker
        if (fileInput) {
          fileInput.addEventListener('change', function () {
            if (this.files && this.files[0]) {
              handleAudioFileUpload(this.files[0], slotIndex);
            }
          });
        }

        // Delete button
        if (deleteBtn) {
          deleteBtn.addEventListener('click', function (e) {
            e.stopPropagation();
            clearCustomSlot(slotIndex);
          });
        }

        // Drag & Drop
        card.addEventListener('dragover', function (e) {
          e.preventDefault();
          this.classList.add('drag-over');
        });

        card.addEventListener('dragleave', function () {
          this.classList.remove('drag-over');
        });

        card.addEventListener('drop', function (e) {
          e.preventDefault();
          this.classList.remove('drag-over');
          if (e.dataTransfer && e.dataTransfer.files && e.dataTransfer.files[0]) {
            handleAudioFileUpload(e.dataTransfer.files[0], slotIndex);
          }
        });
      });

      // 4. Keyboard Shortcuts: Keydown & Keyup (Exact Numpad 789, 456, 123, 0, .)
      const keyToPadMap = {
        'Digit7': '7', 'Numpad7': '7', '7': '7',
        'Digit8': '8', 'Numpad8': '8', '8': '8',
        'Digit9': '9', 'Numpad9': '9', '9': '9',
        'Digit4': '4', 'Numpad4': '4', '4': '4',
        'Digit5': '5', 'Numpad5': '5', '5': '5',
        'Digit6': '6', 'Numpad6': '6', '6': '6',
        'Digit1': '1', 'Numpad1': '1', '1': '1',
        'Digit2': '2', 'Numpad2': '2', '2': '2',
        'Digit3': '3', 'Numpad3': '3', '3': '3',
        'Digit0': 'slot-0', 'Numpad0': 'slot-0', '0': 'slot-0', 'KeyQ': 'slot-0', 'q': 'slot-0',
        'Period': 'slot-1', 'NumpadDecimal': 'slot-1', '.': 'slot-1', 'KeyW': 'slot-1', 'w': 'slot-1'
      };

      window.addEventListener('keydown', function (e) {
        if (e.target.tagName === 'INPUT' && e.target.type !== 'range') return;
        ensureAudioContext();

        // Panic Stop: Space or Escape
        if (e.code === 'Space' || e.key === ' ' || e.key === 'Escape') {
          e.preventDefault();
          panicStop(true);
          return;
        }

        const padKey = keyToPadMap[e.code] || keyToPadMap[e.key];
        if (padKey) {
          if (e.repeat && triggerMode === 'hold') return; // ignore OS key repeat in hold mode

          let padEl = null;
          if (padKey.startsWith('slot-')) {
            padEl = document.getElementById(`slot-card-${padKey.replace('slot-', '')}`);
          } else {
            padEl = document.getElementById(`pad-${padKey}`);
          }

          if (padEl) padEl.classList.add('pressed');
          handlePadDown(padKey);
        }
      });

      window.addEventListener('keyup', function (e) {
        if (e.target.tagName === 'INPUT' && e.target.type !== 'range') return;

        const padKey = keyToPadMap[e.code] || keyToPadMap[e.key];
        if (padKey) {
          handlePadUp(padKey);
        }
      });

      // 5. Master Volume Slider (With Dynamic Track Fill)
      if (volSlider) {
        function updateVolVisual(val) {
          const pct = Math.round(val);
          masterVolume = pct / 100;
          if (volDisplay) volDisplay.textContent = `${pct}%`;

          // Update visible track line gradient fill
          const fillPercent = (pct / 150) * 100;
          volSlider.style.background = `linear-gradient(to right, #00ffcc 0%, #00ffcc ${fillPercent}%, #233147 ${fillPercent}%, #233147 100%)`;

          if (volIcon) {
            if (pct === 0) volIcon.textContent = '🔇';
            else if (pct < 50) volIcon.textContent = '🔉';
            else volIcon.textContent = '🔊';
          }

          if (masterGainNode && audioCtx) {
            masterGainNode.gain.setValueAtTime(masterVolume, audioCtx.currentTime);
          }
        }

        volSlider.addEventListener('input', function () {
          updateVolVisual(this.value);
        });

        // Initialize track visuals
        updateVolVisual(volSlider.value);
      }

      // 6. Polyphony Mode (Overlap vs Cut)
      if (btnOverlap && btnCut) {
        btnOverlap.addEventListener('click', function () {
          polyphonyMode = 'overlap';
          btnOverlap.classList.add('active');
          btnCut.classList.remove('active');
          showToast('재생 모드: 동시 재생 (Overlap Mode)');
        });

        btnCut.addEventListener('click', function () {
          polyphonyMode = 'cut';
          btnCut.classList.add('active');
          btnOverlap.classList.remove('active');
          showToast('재생 모드: 단일 컷 (Cut Mode - 새 소리 재생 시 이전 소리 컷)');
        });
      }

      // 7. Trigger Mode (One-Shot vs Hold)
      if (btnTrigOneshot && btnTrigHold) {
        btnTrigOneshot.addEventListener('click', function () {
          triggerMode = 'oneshot';
          btnTrigOneshot.classList.add('active');
          btnTrigHold.classList.remove('active');
          showToast('트리거 모드: 1회 전체 재생 (One-Shot)');
        });

        btnTrigHold.addEventListener('click', function () {
          triggerMode = 'hold';
          btnTrigHold.classList.add('active');
          btnTrigOneshot.classList.remove('active');
          showToast('트리거 모드: 누르는 동안만 재생 (Hold to Play)');
        });
      }

      // 8. Panic Stop Button
      if (panicStopBtn) {
        panicStopBtn.addEventListener('click', function () {
          panicStop(true);
        });
      }

      // 9. Stream Utilities: Focus Mode
      if (btnFocus) {
        btnFocus.addEventListener('click', function () {
          root.classList.toggle('focus-mode');
          const isFocus = root.classList.contains('focus-mode');
          btnFocus.classList.toggle('active', isFocus);
          showToast(isFocus ? '📺 집중 모드 활성화' : '집중 모드 해제');
        });
      }

      // 10. Stream Utilities: Fullscreen
      if (btnFullscreen) {
        btnFullscreen.addEventListener('click', function () {
          if (!document.fullscreenElement) {
            document.documentElement.requestFullscreen().catch(() => {});
            btnFullscreen.classList.add('active');
          } else {
            document.exitFullscreen().catch(() => {});
            btnFullscreen.classList.remove('active');
          }
        });
      }

      // 11. Stream Utilities: OBS Copy
      if (btnObsCopy) {
        btnObsCopy.addEventListener('click', function () {
          const obsUrl = `${window.location.origin}${window.location.pathname}?stream=true`;
          navigator.clipboard.writeText(obsUrl).then(function () {
            showToast('🎥 OBS 오버레이 URL 복사 완료! (?stream=true)');
          }).catch(function () {
            prompt('OBS 브라우저 소스용 URL을 복사하세요:', obsUrl);
          });
        });
      }
    }

    // --------------------------------------------------------------------------
    // 8. OBS / Stream Mode Detection
    // --------------------------------------------------------------------------
    function checkStreamMode() {
      const params = new URLSearchParams(window.location.search);
      if (params.get('stream') === 'true' || params.get('obs') === 'true' || params.get('bare') === '1') {
        document.body.classList.add('obs-stream-mode');
        if (root) root.classList.add('focus-mode');
      }
    }

    // --------------------------------------------------------------------------
    // 9. Toast Notification
    // --------------------------------------------------------------------------
    let toastTimeout = null;
    function showToast(msg, type = 'info') {
      if (!toast) return;
      toast.textContent = msg;
      toast.className = 'sb-toast show';
      if (type === 'warning') toast.classList.add('warning');

      clearTimeout(toastTimeout);
      toastTimeout = setTimeout(() => {
        toast.className = 'sb-toast';
      }, 2000);
    }

    // --------------------------------------------------------------------------
    // 10. Boot Initialization
    // --------------------------------------------------------------------------
    function init() {
      checkStreamMode();
      setupEvents();
      restoreCachedCustomSlots();
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', init);
    } else {
      init();
    }
  })();
</script>
