  /* Pad Ripple Animation */
  .pad-ripple {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 10px;
    height: 10px;
    background: radial-gradient(circle, rgba(0, 255, 204, 0.5) 0%, transparent 70%);
    border-radius: 50%;
    transform: translate(-50%, -50%) scale(0);
    pointer-events: none;
    z-index: 1;
    opacity: 0;
  }

  .sound-pad.playing .pad-ripple {
    animation: pad-pulse-ripple 0.9s cubic-bezier(0, 0.2, 0.8, 1) infinite;
  }

  @keyframes pad-pulse-ripple {
    0% { transform: translate(-50%, -50%) scale(0); opacity: 0.9; }
    100% { transform: translate(-50%, -50%) scale(35); opacity: 0; }
