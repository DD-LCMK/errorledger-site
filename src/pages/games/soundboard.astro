    const unlockBtn = document.getElementById('unlock-start-btn');
    const volSlider = document.getElementById('master-volume');
    const volDisplay = document.getElementById('vol-display');
    const volIcon = document.getElementById('vol-icon');
    const btnOverlap = document.getElementById('btn-mode-overlap');
    const btnCut = document.getElementById('btn-mode-cut');
    const panicStopBtn = document.getElementById('panic-stop-btn');
    const btnFocus = document.getElementById('btn-focus-mode');
    const btnObsCopy = document.getElementById('btn-obs-copy');
    const btnFullscreen = document.getElementById('btn-fullscreen');
    const visualizerCanvas = document.getElementById('visualizer-canvas');
    const statusDot = document.getElementById('audio-status-dot');
    const statusText = document.getElementById('audio-status-text');
    const toast = document.getElementById('sb-toast');

    // --------------------------------------------------------------------------
    // 1. Audio Engine Initialization
    // --------------------------------------------------------------------------
    function ensureAudioContext() {
      if (!audioCtx) {
        const AudioContextClass = window.AudioContext || window.webkitAudioContext;
        audioCtx = new AudioContextClass();

        // Master Gain
        masterGainNode = audioCtx.createGain();
        masterGainNode.gain.setValueAtTime(masterVolume, audioCtx.currentTime);

        // Analyser for real-time visualizer
        analyserNode = audioCtx.createAnalyser();
        analyserNode.fftSize = 128;
        analyserNode.smoothingTimeConstant = 0.8;

        masterGainNode.connect(analyserNode);
        analyserNode.connect(audioCtx.destination);

        // Pre-generate noise buffer
        generateNoiseBuffer();

        // Start Canvas Visualizer
        startVisualizerLoop();
      }

      if (audioCtx.state === 'suspended') {
        audioCtx.resume();
      }

      // Hide interaction overlay
      if (overlay && overlay.classList.contains('active')) {
        overlay.classList.remove('active');
      }

      if (statusDot) statusDot.classList.add('active');
      if (statusText) statusText.textContent = 'AUDIO ENGINE ACTIVE';
    }

    function generateNoiseBuffer() {
      if (!audioCtx) return;
      const bufferSize = audioCtx.sampleRate * 3.5; // 3.5 seconds
      noiseBufferCache = audioCtx.createBuffer(1, bufferSize, audioCtx.sampleRate);
      const data = noiseBufferCache.getChannelData(0);
      for (let i = 0; i < bufferSize; i++) {
        data[i] = Math.random() * 2 - 1;
      }
    }

    // --------------------------------------------------------------------------
    // 2. Panic Stop & Sound Tracking
    // --------------------------------------------------------------------------
    function registerInstance(gainNode, sources, padElement) {
      const instance = { gainNode, sources, padElement };
      activeInstances.add(instance);

      if (padElement) {
        padElement.classList.add('playing');
      }
      if (statusDot) statusDot.classList.add('playing');

      return instance;
    }

    function unregisterInstance(instance) {
      activeInstances.delete(instance);
      if (instance.padElement) {
        // If no other instance is currently using this pad, remove 'playing'
        let hasOther = false;
        activeInstances.forEach(it => {
          if (it.padElement === instance.padElement) hasOther = true;
        });
        if (!hasOther) {
          instance.padElement.classList.remove('playing');
        }
      }

      if (activeInstances.size === 0 && statusDot) {
        statusDot.classList.remove('playing');
      }
    }

    function panicStop(showFeedback = true) {
      if (!audioCtx) return;
      const now = audioCtx.currentTime;

      activeInstances.forEach(instance => {
        try {
          if (instance.gainNode) {
            instance.gainNode.gain.cancelScheduledValues(now);
            instance.gainNode.gain.setValueAtTime(instance.gainNode.gain.value, now);
            instance.gainNode.gain.linearRampToValueAtTime(0.0001, now + 0.02);
          }
          if (instance.sources) {
            instance.sources.forEach(src => {
              try { src.stop(now + 0.025); } catch (e) {}
            });
          }
        } catch (e) {
          // ignore
        }
      });

      activeInstances.clear();

      // Clear visual ripples & playing classes
      document.querySelectorAll('.sound-pad, .custom-slot-card').forEach(el => {
        el.classList.remove('playing', 'pressed');
      });

      if (statusDot) statusDot.classList.remove('playing');
      if (showFeedback) showToast('🛑 ALL SOUNDS STOPPED (긴급 정지)', 'warning');
    }

    // --------------------------------------------------------------------------
    // 3. Procedural Audio Synthesis (Pads 1 ~ 9)
    // --------------------------------------------------------------------------

    // Pad 1: 땡! (Harsh Low Square Buzzer)
    function playBuzzer() {
      ensureAudioContext();
      if (polyphonyMode === 'cut') panicStop(false);

      const now = audioCtx.currentTime;
      const padEl = document.getElementById('pad-1');

      const voiceGain = audioCtx.createGain();
      voiceGain.connect(masterGainNode);

      // Lowpass filter for punchy analog tone
      const filter = audioCtx.createBiquadFilter();
      filter.type = 'lowpass';
      filter.frequency.setValueAtTime(1400, now);
      filter.Q.setValueAtTime(3, now);
      filter.connect(voiceGain);

      // Two slightly detuned oscillators for buzzy dissonance
      const osc1 = audioCtx.createOscillator();
      osc1.type = 'sawtooth';
      osc1.frequency.setValueAtTime(125, now);

      const osc2 = audioCtx.createOscillator();
      osc2.type = 'square';
      osc2.frequency.setValueAtTime(131, now);

      osc1.connect(filter);
      osc2.connect(filter);

      // Volume envelope: fast attack, steady buzz, sharp decay
      voiceGain.gain.setValueAtTime(0.001, now);
      voiceGain.gain.linearRampToValueAtTime(0.85, now + 0.015);
      voiceGain.gain.setValueAtTime(0.85, now + 0.45);
      voiceGain.gain.exponentialRampToValueAtTime(0.0001, now + 0.65);

      osc1.start(now);
      osc2.start(now);
      osc1.stop(now + 0.66);
      osc2.stop(now + 0.66);

      const instance = registerInstance(voiceGain, [osc1, osc2], padEl);
      setTimeout(() => unregisterInstance(instance), 660);
    }

    // Pad 2: 딩동댕! (Crystal Bell Arpeggio Chime)
    function playChime() {
      ensureAudioContext();
      if (polyphonyMode === 'cut') panicStop(false);

      const now = audioCtx.currentTime;
      const padEl = document.getElementById('pad-2');

      const voiceGain = audioCtx.createGain();
      voiceGain.connect(masterGainNode);

      // 4 ascending notes: C5 (523Hz), E5 (659Hz), G5 (784Hz), C6 (1046Hz)
      const freqs = [523.25, 659.25, 783.99, 1046.50];
      const sources = [];

      freqs.forEach((freq, idx) => {
        const noteStart = now + idx * 0.09;

        const osc = audioCtx.createOscillator();
        osc.type = 'sine';
        osc.frequency.setValueAtTime(freq, noteStart);

        // Soft harmonic overtone for chime sparkle
        const overtone = audioCtx.createOscillator();
        overtone.type = 'sine';
        overtone.frequency.setValueAtTime(freq * 2.76, noteStart);

        const noteGain = audioCtx.createGain();
        noteGain.gain.setValueAtTime(0.0001, noteStart);
        noteGain.gain.linearRampToValueAtTime(0.45, noteStart + 0.01);
        noteGain.gain.exponentialRampToValueAtTime(0.0001, noteStart + 1.1);

        const overtoneGain = audioCtx.createGain();
        overtoneGain.gain.setValueAtTime(0.0001, noteStart);
        overtoneGain.gain.linearRampToValueAtTime(0.12, noteStart + 0.01);
        overtoneGain.gain.exponentialRampToValueAtTime(0.0001, noteStart + 0.45);

        osc.connect(noteGain);
        overtone.connect(overtoneGain);
        noteGain.connect(voiceGain);
        overtoneGain.connect(voiceGain);

        osc.start(noteStart);
        overtone.start(noteStart);
        osc.stop(noteStart + 1.15);
        overtone.stop(noteStart + 0.5);

        sources.push(osc, overtone);
      });

      const instance = registerInstance(voiceGain, sources, padEl);
      setTimeout(() => unregisterInstance(instance), 1400);
    }

    // Pad 3: 두둥탁! (Ba-Dum-Tss Punchline)
    function playPunchline() {
      ensureAudioContext();
      if (polyphonyMode === 'cut') panicStop(false);

      const now = audioCtx.currentTime;
      const padEl = document.getElementById('pad-3');

      const voiceGain = audioCtx.createGain();
      voiceGain.connect(masterGainNode);
      const sources = [];

      // Kick 1: "두" (t=0.0s)
      const kick1 = audioCtx.createOscillator();
      const kickGain1 = audioCtx.createGain();
      kick1.frequency.setValueAtTime(140, now);
      kick1.frequency.exponentialRampToValueAtTime(45, now + 0.12);
      kickGain1.gain.setValueAtTime(0.85, now);
      kickGain1.gain.exponentialRampToValueAtTime(0.001, now + 0.14);
      kick1.connect(kickGain1);
      kickGain1.connect(voiceGain);
      kick1.start(now);
      kick1.stop(now + 0.15);
      sources.push(kick1);

      // Kick 2: "둥" (t=0.17s)
      const kickTime2 = now + 0.17;
      const kick2 = audioCtx.createOscillator();
      const kickGain2 = audioCtx.createGain();
      kick2.frequency.setValueAtTime(160, kickTime2);
      kick2.frequency.exponentialRampToValueAtTime(48, kickTime2 + 0.13);
      kickGain2.gain.setValueAtTime(0.9, kickTime2);
      kickGain2.gain.exponentialRampToValueAtTime(0.001, kickTime2 + 0.15);
      kick2.connect(kickGain2);
      kickGain2.connect(voiceGain);
      kick2.start(kickTime2);
      kick2.stop(kickTime2 + 0.16);
      sources.push(kick2);

      // Snare + Cymbal Hit: "탁!" (t=0.34s)
      const hitTime = now + 0.34;

      // Snare body
      const snareBody = audioCtx.createOscillator();
      snareBody.type = 'triangle';
      snareBody.frequency.setValueAtTime(210, hitTime);
      snareBody.frequency.exponentialRampToValueAtTime(70, hitTime + 0.1);
      const snareBodyGain = audioCtx.createGain();
      snareBodyGain.gain.setValueAtTime(0.7, hitTime);
      snareBodyGain.gain.exponentialRampToValueAtTime(0.001, hitTime + 0.12);
      snareBody.connect(snareBodyGain);
      snareBodyGain.connect(voiceGain);
      snareBody.start(hitTime);
      snareBody.stop(hitTime + 0.13);
      sources.push(snareBody);

      // Cymbal Crash (Filtered Noise)
      if (noiseBufferCache) {
        const noise = audioCtx.createBufferSource();
        noise.buffer = noiseBufferCache;

        const cymbalFilter = audioCtx.createBiquadFilter();
        cymbalFilter.type = 'highpass';
        cymbalFilter.frequency.setValueAtTime(4500, hitTime);

        const cymbalGain = audioCtx.createGain();
        cymbalGain.gain.setValueAtTime(0.75, hitTime);
        cymbalGain.gain.exponentialRampToValueAtTime(0.0001, hitTime + 1.1);

        noise.connect(cymbalFilter);
        cymbalFilter.connect(cymbalGain);
        cymbalGain.connect(voiceGain);

        noise.start(hitTime);
        noise.stop(hitTime + 1.15);
        sources.push(noise);
      }

      const instance = registerInstance(voiceGain, sources, padEl);
      setTimeout(() => unregisterInstance(instance), 1500);
    }

    // Pad 4: 삐-! (1kHz Pure Sine Censor Tone)
    function playCensorBeep() {
      ensureAudioContext();
      if (polyphonyMode === 'cut') panicStop(false);

      const now = audioCtx.currentTime;
      const padEl = document.getElementById('pad-4');

      const voiceGain = audioCtx.createGain();
      voiceGain.connect(masterGainNode);

      const osc = audioCtx.createOscillator();
      osc.type = 'sine';
      osc.frequency.setValueAtTime(1000, now);

      // Smooth attack/release to eliminate click
      voiceGain.gain.setValueAtTime(0.0001, now);
      voiceGain.gain.linearRampToValueAtTime(0.7, now + 0.015);
      voiceGain.gain.setValueAtTime(0.7, now + 0.85);
      voiceGain.gain.linearRampToValueAtTime(0.0001, now + 0.88);

      osc.connect(voiceGain);
      osc.start(now);
      osc.stop(now + 0.9);

      const instance = registerInstance(voiceGain, [osc], padEl);
      setTimeout(() => unregisterInstance(instance), 900);
    }

    // Pad 5: 쾅! (Filtered Low-Pass Explosion Boom)
    function playExplosion() {
      ensureAudioContext();
      if (polyphonyMode === 'cut') panicStop(false);

      const now = audioCtx.currentTime;
      const padEl = document.getElementById('pad-5');

      const voiceGain = audioCtx.createGain();
      voiceGain.connect(masterGainNode);
      const sources = [];

      // Sub Bass Drop
      const sub = audioCtx.createOscillator();
      sub.type = 'sine';
      sub.frequency.setValueAtTime(120, now);
      sub.frequency.exponentialRampToValueAtTime(28, now + 0.6);

      const subGain = audioCtx.createGain();
      subGain.gain.setValueAtTime(0.9, now);
      subGain.gain.exponentialRampToValueAtTime(0.001, now + 0.8);
      sub.connect(subGain);
      subGain.connect(voiceGain);
      sub.start(now);
      sub.stop(now + 0.85);
      sources.push(sub);

      // Resonant Noise Explosion Sweep
      if (noiseBufferCache) {
        const noise = audioCtx.createBufferSource();
        noise.buffer = noiseBufferCache;

        const filter = audioCtx.createBiquadFilter();
        filter.type = 'lowpass';
        filter.frequency.setValueAtTime(1100, now);
        filter.frequency.exponentialRampToValueAtTime(45, now + 1.6);
        filter.Q.setValueAtTime(4.5, now);

        const noiseGain = audioCtx.createGain();
        noiseGain.gain.setValueAtTime(1.0, now);
        noiseGain.gain.exponentialRampToValueAtTime(0.0001, now + 1.7);

        noise.connect(filter);
        filter.connect(noiseGain);
        noiseGain.connect(voiceGain);

        noise.start(now);
        noise.stop(now + 1.75);
        sources.push(noise);
      }

      const instance = registerInstance(voiceGain, sources, padEl);
      setTimeout(() => unregisterInstance(instance), 1800);
    }

    // Pad 6: 풀벌레 (High-Frequency Cricket Chirps)
    function playCrickets() {
      ensureAudioContext();
      if (polyphonyMode === 'cut') panicStop(false);

      const now = audioCtx.currentTime;
      const padEl = document.getElementById('pad-6');

      const voiceGain = audioCtx.createGain();
      voiceGain.connect(masterGainNode);

      // 4600Hz Sine carrier
      const carrier = audioCtx.createOscillator();
      carrier.type = 'sine';
      carrier.frequency.setValueAtTime(4600, now);

      // AM Modulator (40Hz wing flutter)
      const modulator = audioCtx.createOscillator();
      modulator.type = 'sine';
      modulator.frequency.setValueAtTime(40, now);

      const modGain = audioCtx.createGain();
      modGain.gain.setValueAtTime(0.5, now);

      // Pulse pattern for crickets
      const chirps = [
        { t: 0.00, dur: 0.09 },
        { t: 0.12, dur: 0.09 },
        { t: 0.24, dur: 0.11 },
        { t: 0.55, dur: 0.09 },
        { t: 0.67, dur: 0.09 },
        { t: 0.79, dur: 0.11 },
        { t: 1.10, dur: 0.09 },
        { t: 1.22, dur: 0.09 }
      ];

      voiceGain.gain.setValueAtTime(0.0001, now);
      chirps.forEach(c => {
        const start = now + c.t;
        voiceGain.gain.setValueAtTime(0.0001, start);
        voiceGain.gain.linearRampToValueAtTime(0.65, start + 0.015);
        voiceGain.gain.exponentialRampToValueAtTime(0.0001, start + c.dur);
      });

      carrier.connect(voiceGain);
      modulator.connect(modGain);
      modGain.connect(voiceGain.gain);

      carrier.start(now);
      modulator.start(now);
      carrier.stop(now + 1.45);
      modulator.stop(now + 1.45);

      const instance = registerInstance(voiceGain, [carrier, modulator], padEl);
      setTimeout(() => unregisterInstance(instance), 1500);
    }

    // Pad 7: 드럼롤 (Rapid Noise-Burst Snare Roll & Crash)
    function playDrumRoll() {
      ensureAudioContext();
      if (polyphonyMode === 'cut') panicStop(false);

      const now = audioCtx.currentTime;
      const padEl = document.getElementById('pad-7');

      const voiceGain = audioCtx.createGain();
      voiceGain.connect(masterGainNode);
      const sources = [];

      // 18 Rapid Micro-hits accelerating in gain
      const numHits = 18;
      const step = 0.038;

      for (let i = 0; i < numHits; i++) {
        const hitTime = now + i * step;
        const progress = i / numHits;
        const hitVol = 0.15 + progress * 0.7;

        if (noiseBufferCache) {
          const noise = audioCtx.createBufferSource();
          noise.buffer = noiseBufferCache;

          const filter = audioCtx.createBiquadFilter();
          filter.type = 'bandpass';
          filter.frequency.setValueAtTime(2200 + progress * 800, hitTime);
          filter.Q.setValueAtTime(1.5, hitTime);

          const tapGain = audioCtx.createGain();
          tapGain.gain.setValueAtTime(hitVol, hitTime);
          tapGain.gain.exponentialRampToValueAtTime(0.001, hitTime + 0.035);

          noise.connect(filter);
          filter.connect(tapGain);
          tapGain.connect(voiceGain);

          noise.start(hitTime);
          noise.stop(hitTime + 0.036);
          sources.push(noise);
        }
      }

      // Finale Hit at t = 0.72s
      const finaleTime = now + numHits * step + 0.02;

      // Punch kick
      const kick = audioCtx.createOscillator();
      const kickGain = audioCtx.createGain();
      kick.frequency.setValueAtTime(150, finaleTime);
      kick.frequency.exponentialRampToValueAtTime(45, finaleTime + 0.15);
      kickGain.gain.setValueAtTime(0.9, finaleTime);
      kickGain.gain.exponentialRampToValueAtTime(0.001, finaleTime + 0.18);
      kick.connect(kickGain);
      kickGain.connect(voiceGain);
      kick.start(finaleTime);
      kick.stop(finaleTime + 0.2);
      sources.push(kick);

      // Finale Crash Cymbal
      if (noiseBufferCache) {
        const crash = audioCtx.createBufferSource();
        crash.buffer = noiseBufferCache;

        const crashFilter = audioCtx.createBiquadFilter();
        crashFilter.type = 'highpass';
        crashFilter.frequency.setValueAtTime(4200, finaleTime);

        const crashGain = audioCtx.createGain();
        crashGain.gain.setValueAtTime(0.85, finaleTime);
        crashGain.gain.exponentialRampToValueAtTime(0.0001, finaleTime + 1.3);

        crash.connect(crashFilter);
        crashFilter.connect(crashGain);
        crashGain.connect(voiceGain);

        crash.start(finaleTime);
        crash.stop(finaleTime + 1.35);
        sources.push(crash);
      }

      const instance = registerInstance(voiceGain, sources, padEl);
      setTimeout(() => unregisterInstance(instance), 2100);
    }

    // Pad 8: 팡파르 (Victorious Brass Fanfare Chords)
    function playFanfare() {
      ensureAudioContext();
      if (polyphonyMode === 'cut') panicStop(false);

      const now = audioCtx.currentTime;
      const padEl = document.getElementById('pad-8');

      const voiceGain = audioCtx.createGain();
      voiceGain.connect(masterGainNode);
      const sources = [];

      // Notes: G4(392), C5(523), E5(659), G5(784), Triad Chord
      const notes = [
        { t: 0.00, dur: 0.12, freqs: [392.00] },
        { t: 0.14, dur: 0.12, freqs: [523.25] },
        { t: 0.28, dur: 0.12, freqs: [659.25] },
        { t: 0.42, dur: 0.45, freqs: [783.99] },
        // Grand Finish Triad
        { t: 0.95, dur: 1.25, freqs: [261.63, 523.25, 659.25, 783.99, 1046.50] }
      ];

      notes.forEach(item => {
        const start = now + item.t;
        item.freqs.forEach(freq => {
          const osc = audioCtx.createOscillator();
          osc.type = 'sawtooth';
          osc.frequency.setValueAtTime(freq, start);

          // Warm brass lowpass filter
          const filter = audioCtx.createBiquadFilter();
          filter.type = 'lowpass';
          filter.frequency.setValueAtTime(2400, start);
          filter.Q.setValueAtTime(2.5, start);

          const noteGain = audioCtx.createGain();
          const amp = item.freqs.length > 1 ? 0.22 : 0.45;
          noteGain.gain.setValueAtTime(0.0001, start);
          noteGain.gain.linearRampToValueAtTime(amp, start + 0.02);
          noteGain.gain.setValueAtTime(amp, start + item.dur - 0.06);
          noteGain.gain.exponentialRampToValueAtTime(0.0001, start + item.dur);

          osc.connect(filter);
          filter.connect(noteGain);
          noteGain.connect(voiceGain);

          osc.start(start);
          osc.stop(start + item.dur + 0.05);
          sources.push(osc);
        });
      });

      const instance = registerInstance(voiceGain, sources, padEl);
      setTimeout(() => unregisterInstance(instance), 2300);
    }

    // Pad 9: 박수 갈채 (Shaped Bandpass Applause Burst)
    function playApplause() {
      ensureAudioContext();
      if (polyphonyMode === 'cut') panicStop(false);

      const now = audioCtx.currentTime;
      const padEl = document.getElementById('pad-9');

      const voiceGain = audioCtx.createGain();
      voiceGain.connect(masterGainNode);
      const sources = [];

      if (noiseBufferCache) {
        // Dual filtered noise sources for width
        const noise = audioCtx.createBufferSource();
        noise.buffer = noiseBufferCache;

        const filter = audioCtx.createBiquadFilter();
        filter.type = 'bandpass';
        filter.frequency.setValueAtTime(1750, now);
        filter.Q.setValueAtTime(1.2, now);

        // AM flutter to simulate thousands of clapping hands
        const tremolo = audioCtx.createOscillator();
        tremolo.type = 'sine';
        tremolo.frequency.setValueAtTime(14, now);

        const tremoloGain = audioCtx.createGain();
        tremoloGain.gain.setValueAtTime(0.25, now);
        tremolo.connect(tremoloGain);

        // Amplitude Envelope: Swells in, sustains, fades smoothly
        voiceGain.gain.setValueAtTime(0.001, now);
        voiceGain.gain.linearRampToValueAtTime(0.8, now + 0.35);
        voiceGain.gain.setValueAtTime(0.8, now + 2.0);
        voiceGain.gain.exponentialRampToValueAtTime(0.0001, now + 2.75);

        noise.connect(filter);
        filter.connect(voiceGain);
        tremoloGain.connect(voiceGain.gain);

        noise.start(now);
        tremolo.start(now);
        noise.stop(now + 2.8);
        tremolo.stop(now + 2.8);

        sources.push(noise, tremolo);
      }

      const instance = registerInstance(voiceGain, sources, padEl);
      setTimeout(() => unregisterInstance(instance), 2850);
    }

    // Dispatcher for Pads 1 to 9
    function triggerPad(padNumber) {
      switch (parseInt(padNumber, 10)) {
        case 1: playBuzzer(); break;
        case 2: playChime(); break;
        case 3: playPunchline(); break;
        case 4: playCensorBeep(); break;
        case 5: playExplosion(); break;
        case 6: playCrickets(); break;
        case 7: playDrumRoll(); break;
        case 8: playFanfare(); break;
        case 9: playApplause(); break;
        default: break;
      }
    }

    // --------------------------------------------------------------------------
    // 4. Custom User Audio Upload Slots (Slots A & B)
    // --------------------------------------------------------------------------
    function playCustomSlot(slotIndex) {
      ensureAudioContext();
      if (!customBuffers[slotIndex]) {
        showToast(`슬롯 ${slotIndex === 0 ? 'A' : 'B'}에 등록된 오디오가 없습니다`, 'warning');
        return;
      }

      if (polyphonyMode === 'cut') panicStop(false);

      const now = audioCtx.currentTime;
      const cardEl = document.getElementById(`slot-card-${slotIndex}`);

      const voiceGain = audioCtx.createGain();
      voiceGain.gain.setValueAtTime(0.9, now);
      voiceGain.connect(masterGainNode);

      const source = audioCtx.createBufferSource();
      source.buffer = customBuffers[slotIndex];
      source.connect(voiceGain);

      source.start(now);

      const instance = registerInstance(voiceGain, [source], cardEl);
      const durationMs = Math.min(customBuffers[slotIndex].duration * 1000, 30000);
      setTimeout(() => unregisterInstance(instance), durationMs);
    }

    function handleAudioFileUpload(file, slotIndex) {
      if (!file) return;
      ensureAudioContext();

      const reader = new FileReader();
      reader.onload = function (e) {
        const arrayBuffer = e.target.result;
        audioCtx.decodeAudioData(arrayBuffer, function (decoded) {
          customBuffers[slotIndex] = decoded;
          customMeta[slotIndex] = {
            name: file.name,
            duration: decoded.duration.toFixed(1)
          };
          updateCustomSlotUI(slotIndex);
          showToast(`슬롯 ${slotIndex === 0 ? 'A' : 'B'} 등록 완료: ${file.name}`);

          // Try caching in localStorage if < 1.5MB
          if (file.size < 1.5 * 1024 * 1024) {
            try {
              const base64Reader = new FileReader();
              base64Reader.onload = function (b64Evt) {
                try {
                  localStorage.setItem(`errorledger_sound_slot_${slotIndex}`, b64Evt.target.result);
                  localStorage.setItem(`errorledger_sound_meta_${slotIndex}`, JSON.stringify(customMeta[slotIndex]));
                } catch (quotaErr) {}
              };
              base64Reader.readAsDataURL(file);
            } catch (e) {}
          }
        }, function (decodeErr) {
          showToast('오디오 디코딩 실패 (지원되지 않는 코덱/파일)', 'warning');
        });
      };
      reader.readAsArrayBuffer(file);
    }

    function updateCustomSlotUI(slotIndex) {
      const card = document.getElementById(`slot-card-${slotIndex}`);
      const emptyView = card.querySelector('.slot-empty-view');
      const loadedView = card.querySelector('.slot-loaded-view');
      const nameEl = document.getElementById(`slot-name-${slotIndex}`);
      const metaEl = document.getElementById(`slot-meta-${slotIndex}`);
      const triggerBtn = document.getElementById(`btn-play-slot-${slotIndex}`);

      if (customBuffers[slotIndex] && customMeta[slotIndex]) {
        emptyView.classList.add('hidden');
        loadedView.classList.remove('hidden');
        nameEl.textContent = customMeta[slotIndex].name;
        metaEl.textContent = `${customMeta[slotIndex].duration}s • Ready`;
        triggerBtn.disabled = false;
      } else {
        emptyView.classList.remove('hidden');
        loadedView.classList.add('hidden');
        triggerBtn.disabled = true;
      }
    }

    function clearCustomSlot(slotIndex) {
      customBuffers[slotIndex] = null;
      customMeta[slotIndex] = null;
      try {
        localStorage.removeItem(`errorledger_sound_slot_${slotIndex}`);
        localStorage.removeItem(`errorledger_sound_meta_${slotIndex}`);
      } catch (e) {}
      updateCustomSlotUI(slotIndex);
      showToast(`슬롯 ${slotIndex === 0 ? 'A' : 'B'} 초기화 완료`);
    }

    // Restore cached slots on startup
    function restoreCachedCustomSlots() {
      [0, 1].forEach(slotIndex => {
        try {
          const cachedData = localStorage.getItem(`errorledger_sound_slot_${slotIndex}`);
          const metaStr = localStorage.getItem(`errorledger_sound_meta_${slotIndex}`);
          if (cachedData && metaStr) {
            const meta = JSON.parse(metaStr);
            // Fetch blob from data URI
            fetch(cachedData)
              .then(res => res.arrayBuffer())
              .then(buf => {
                if (!audioCtx) {
                  const AudioContextClass = window.AudioContext || window.webkitAudioContext;
                  audioCtx = new AudioContextClass();
                }
                return audioCtx.decodeAudioData(buf);
              })
              .then(decoded => {
                customBuffers[slotIndex] = decoded;
                customMeta[slotIndex] = meta;
                updateCustomSlotUI(slotIndex);
              })
              .catch(() => {});
          }
        } catch (e) {}
      });
    }

    // --------------------------------------------------------------------------
    // 5. Canvas Real-time Oscilloscope / Spectrum Ribbon
    // --------------------------------------------------------------------------
    function startVisualizerLoop() {
      if (!visualizerCanvas || !analyserNode) return;
      const ctx = visualizerCanvas.getContext('2d');
      const bufferLength = analyserNode.frequencyBinCount;
      const dataArray = new Uint8Array(bufferLength);

      function draw() {
        requestAnimationFrame(draw);

        visualizerCanvas.width = visualizerCanvas.offsetWidth;
        const width = visualizerCanvas.width;
        const height = visualizerCanvas.height;

        analyserNode.getByteTimeDomainData(dataArray);

        ctx.clearRect(0, 0, width, height);
        ctx.lineWidth = 2;

        const isPlaying = activeInstances.size > 0;
        ctx.strokeStyle = isPlaying ? '#00ffcc' : '#26334d';
        ctx.shadowColor = isPlaying ? '#00ffcc' : 'transparent';
        ctx.shadowBlur = isPlaying ? 8 : 0;

        ctx.beginPath();
        const sliceWidth = width / bufferLength;
        let x = 0;

        for (let i = 0; i < bufferLength; i++) {
          const v = dataArray[i] / 128.0;
          const y = (v * height) / 2;

          if (i === 0) {
            ctx.moveTo(x, y);
          } else {
            ctx.lineTo(x, y);
          }
          x += sliceWidth;
        }

        ctx.lineTo(width, height / 2);
        ctx.stroke();
      }

      draw();
    }

    // --------------------------------------------------------------------------
    // 6. UI & Keyboard Event Listeners
    // --------------------------------------------------------------------------
    function setupEvents() {
      // 1. Overlay Unlock
      if (unlockBtn) {
        unlockBtn.addEventListener('click', function () {
          ensureAudioContext();
        });
      }

      // Any first click or touch resumes audio context
      window.addEventListener('click', function () {
        ensureAudioContext();
      }, { once: true });

      // 2. Click on 3x3 Pads
      document.querySelectorAll('.sound-pad').forEach(pad => {
        pad.addEventListener('click', function () {
          const padNum = this.getAttribute('data-pad');
          triggerPad(padNum);
        });
      });

      // 3. Custom Slot Interactions
      [0, 1].forEach(slotIndex => {
        const card = document.getElementById(`slot-card-${slotIndex}`);
        const contentBox = card.querySelector('.slot-content');
        const fileInput = document.getElementById(`file-input-${slotIndex}`);
        const playBtn = document.getElementById(`btn-play-slot-${slotIndex}`);
        const clearBtn = card.querySelector('.slot-clear-btn');

        // Click to browse file when empty
        contentBox.addEventListener('click', function (e) {
          if (!customBuffers[slotIndex]) {
            fileInput.click();
          } else {
            playCustomSlot(slotIndex);
          }
        });

        fileInput.addEventListener('change', function () {
          if (this.files && this.files[0]) {
            handleAudioFileUpload(this.files[0], slotIndex);
          }
        });

        // Drag & Drop
        card.addEventListener('dragover', function (e) {
          e.preventDefault();
          this.classList.add('drag-over');
        });

        card.addEventListener('dragleave', function () {
          this.classList.remove('drag-over');
        });

        card.addEventListener('drop', function (e) {
          e.preventDefault();
          this.classList.remove('drag-over');
          if (e.dataTransfer && e.dataTransfer.files && e.dataTransfer.files[0]) {
            handleAudioFileUpload(e.dataTransfer.files[0], slotIndex);
          }
        });

        // Play button click
        playBtn.addEventListener('click', function () {
          playCustomSlot(slotIndex);
        });

        // Clear button
        clearBtn.addEventListener('click', function (e) {
          e.stopPropagation();
          clearCustomSlot(slotIndex);
        });
      });

      // 4. Keyboard Shortcuts Mapping
      window.addEventListener('keydown', function (e) {
        // If typing in input, ignore
        if (e.target.tagName === 'INPUT' && e.target.type !== 'range') return;

        ensureAudioContext();

        // Panic Stop: Space or Escape
        if (e.code === 'Space' || e.key === ' ' || e.key === 'Escape') {
          e.preventDefault();
          panicStop(true);
          return;
        }

        // Numpad 1 ~ 9 & Standard 1 ~ 9
        const keyMap = {
          'Digit1': 1, 'Numpad1': 1, '1': 1,
          'Digit2': 2, 'Numpad2': 2, '2': 2,
          'Digit3': 3, 'Numpad3': 3, '3': 3,
          'Digit4': 4, 'Numpad4': 4, '4': 4,
          'Digit5': 5, 'Numpad5': 5, '5': 5,
          'Digit6': 6, 'Numpad6': 6, '6': 6,
          'Digit7': 7, 'Numpad7': 7, '7': 7,
          'Digit8': 8, 'Numpad8': 8, '8': 8,
          'Digit9': 9, 'Numpad9': 9, '9': 9,
        };

        if (keyMap[e.code] || keyMap[e.key]) {
          const padNum = keyMap[e.code] || keyMap[e.key];
          const padEl = document.getElementById(`pad-${padNum}`);
          if (padEl) {
            padEl.classList.add('pressed');
            setTimeout(() => padEl.classList.remove('pressed'), 120);
          }
          triggerPad(padNum);
          return;
        }

        // Custom Slot A: '0', 'Numpad0', 'KeyQ', 'q'
        if (e.code === 'Digit0' || e.code === 'Numpad0' || e.key === '0' || e.code === 'KeyQ' || e.key.toLowerCase() === 'q') {
          const slotCard = document.getElementById('slot-card-0');
          if (slotCard) {
            slotCard.classList.add('pressed');
            setTimeout(() => slotCard.classList.remove('pressed'), 120);
          }
          playCustomSlot(0);
          return;
        }

        // Custom Slot B: 'Period', 'NumpadDecimal', 'KeyW', 'w'
        if (e.code === 'Period' || e.code === 'NumpadDecimal' || e.key === '.' || e.code === 'KeyW' || e.key.toLowerCase() === 'w') {
          const slotCard = document.getElementById('slot-card-1');
          if (slotCard) {
            slotCard.classList.add('pressed');
            setTimeout(() => slotCard.classList.remove('pressed'), 120);
          }
          playCustomSlot(1);
          return;
        }
      });

      // 5. Master Volume Slider
      if (volSlider) {
        volSlider.addEventListener('input', function () {
          const pct = parseInt(this.value, 10);
          masterVolume = pct / 100;
          if (volDisplay) volDisplay.textContent = `${pct}%`;

          if (volIcon) {
            if (pct === 0) volIcon.textContent = '🔇';
            else if (pct < 50) volIcon.textContent = '🔉';
            else volIcon.textContent = '🔊';
          }

          if (masterGainNode && audioCtx) {
            masterGainNode.gain.setValueAtTime(masterVolume, audioCtx.currentTime);
          }
        });
      }

      // 6. Polyphony Mode (Overlap vs Cut)
      if (btnOverlap && btnCut) {
        btnOverlap.addEventListener('click', function () {
          polyphonyMode = 'overlap';
          btnOverlap.classList.add('active');
          btnCut.classList.remove('active');
          showToast('재생 모드: 동시 재생 (Overlap Mode)');
        });

        btnCut.addEventListener('click', function () {
          polyphonyMode = 'cut';
          btnCut.classList.add('active');
          btnOverlap.classList.remove('active');
          showToast('재생 모드: 단일 컷 (Cut Mode - 새 소리 시 이전 소리 정지)');
        });
      }

      // 7. Panic Stop Button
      if (panicStopBtn) {
        panicStopBtn.addEventListener('click', function () {
          panicStop(true);
        });
      }

      // 8. Stream Utilities: Focus Mode
      if (btnFocus) {
        btnFocus.addEventListener('click', function () {
          root.classList.toggle('focus-mode');
          const isFocus = root.classList.contains('focus-mode');
          btnFocus.classList.toggle('active', isFocus);
          showToast(isFocus ? '📺 집중 모드 활성화' : '집중 모드 해제');
        });
      }

      // 9. Stream Utilities: Fullscreen
      if (btnFullscreen) {
        btnFullscreen.addEventListener('click', function () {
          if (!document.fullscreenElement) {
            document.documentElement.requestFullscreen().catch(() => {});
            btnFullscreen.classList.add('active');
          } else {
            document.exitFullscreen().catch(() => {});
            btnFullscreen.classList.remove('active');
          }
        });
      }

      // 10. Stream Utilities: OBS Copy
      if (btnObsCopy) {
        btnObsCopy.addEventListener('click', function () {
          const obsUrl = `${window.location.origin}${window.location.pathname}?stream=true`;
          navigator.clipboard.writeText(obsUrl).then(function () {
            showToast('🎥 OBS 오버레이 URL 복사 완료! (?stream=true)');
          }).catch(function () {
            prompt('OBS 브라우저 소스용 URL을 복사하세요:', obsUrl);
          });
        });
      }
    }

    // --------------------------------------------------------------------------
    // 7. OBS / Stream Mode Detection (?stream=true)
    // --------------------------------------------------------------------------
    function checkStreamMode() {
      const params = new URLSearchParams(window.location.search);
      if (params.get('stream') === 'true' || params.get('obs') === 'true' || params.get('bare') === '1') {
        document.body.classList.add('obs-stream-mode');
        if (root) root.classList.add('focus-mode');
      }
    }

    // --------------------------------------------------------------------------
    // 8. Toast Helper
    // --------------------------------------------------------------------------
    let toastTimeout = null;
    function showToast(msg, type = 'info') {
      if (!toast) return;
      toast.textContent = msg;
      toast.className = 'sb-toast show';
      if (type === 'warning') toast.classList.add('warning');

      clearTimeout(toastTimeout);
      toastTimeout = setTimeout(() => {
        toast.className = 'sb-toast';
      }, 2000);
    }

    // --------------------------------------------------------------------------
    // 9. Boot Initialization
    // --------------------------------------------------------------------------
    function init() {
      checkStreamMode();
      setupEvents();
      restoreCachedCustomSlots();
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', init);
    } else {
      init();
    }
  })();
</script>
