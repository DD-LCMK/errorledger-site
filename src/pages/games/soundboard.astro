  /* --------------------------------------------------------------------------
     Keypad Grid: 3x3 + 2 Custom Slots (Exact Physical Numpad Layout)
     Row 1: 7, 8, 9
     Row 2: 4, 5, 6
     Row 3: 1, 2, 3
     Row 4: 0 (2 cols), . (1 col)
     -------------------------------------------------------------------------- */
  .sb-main-stage {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    width: 100%;
  }

  .pad-grid-keypad {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0.9rem;
    width: 100%;
  }

  .sound-pad {
    position: relative;
    background: radial-gradient(circle at 50% 20%, #1e2a42 0%, #131b2c 100%);
    border: 1.5px solid var(--border-color);
    border-radius: 14px;
    padding: 1.15rem 1rem;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    justify-content: space-between;
    min-height: 135px;
    cursor: pointer;
    overflow: hidden;
    transition: transform 0.1s cubic-bezier(0.175, 0.885, 0.32, 1.275), 
                box-shadow 0.15s ease, 
                border-color 0.15s ease,
                background 0.15s ease;
    box-shadow: 0 6px 18px rgba(0, 0, 0, 0.3), inset 0 1px 1px rgba(255, 255, 255, 0.08);
  }

  .sound-pad:hover {
    transform: translateY(-2px);
    border-color: #3b4e73;
    box-shadow: 0 10px 24px rgba(0, 0, 0, 0.45);
  }

  .sound-pad:active,
  .sound-pad.pressed {
    transform: translateY(2px) scale(0.975);
    box-shadow: 0 2px 6px rgba(0, 0, 0, 0.6);
  }

  .pad-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    margin-bottom: 0.4rem;
    z-index: 2;
