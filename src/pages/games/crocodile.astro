---
import GameLayout from '../../layouts/GameLayout.astro';
import { getEntry } from 'astro:content';

const gameEntry = await getEntry('games', 'crocodile');
const data = gameEntry?.data || {
  title: '악어 이빨 복불복',
  tagline: '언제 물릴지 모르는 심장 쫄깃 원클릭 복불복 벌칙 게임',
  description: '고전 명작 악어 룰렛을 웹으로 완벽 구현! 한 명씩 돌아가며 악어 이빨을 누르면 랜덤으로 입이 쾅 닫히며 깜짝 리액션을 유발합니다.',
  icon: '🐊',
  category: 'stream',
  badge: '🐊 벌칙 복불복',
  players: '1~10인 (돌아가며 클릭)',
  playTime: '30초',
  controls: [
    '마우스로 악어의 아래 이빨을 하나씩 클릭합니다',
    '안전한 이빨은 딸깍 소리와 함께 내려갑니다',
    '함정 이빨을 누르는 순간 악어 입이 쾅 닫히며 물립니다!',
    '스페이스바(Space) 또는 [다시 하기] 버튼으로 즉시 새 판 시작'
  ],
  rules: [
    '판마다 단 하나의 무작위 이빨에 함정이 설치됩니다.',
    '물린 사람이 벌칙을 수행하거나 꼴찌가 됩니다!'
  ],
  faqItems: [
    {
      q: '이빨 개수를 조절할 수 있나요?',
      a: '네! 상단 메뉴에서 8개, 10개, 12개, 14개로 이빨 개수를 설정하여 난이도와 참여 인원을 맞출 수 있습니다.'
    }
  ]
};
---

<GameLayout
  title={data.title}
  description={data.description}
  tagline={data.tagline}
  icon={data.icon}
  category={data.category}
  badge={data.badge}
  players={data.players}
  playTime={data.playTime}
  controls={data.controls}
  rules={data.rules}
  faqItems={data.faqItems}
>
  <div class="crocodile-app-root" id="croc-root">
    
    <!-- Top Action Bar -->
    <div class="croc-toolbar">
      <div class="tool-left">
        <span class="croc-title">🐊 악어 이빨 복불복</span>
        <div class="teeth-count-picker">
          <label>이빨 수:</label>
          <button class="t-btn" data-teeth="8">8개</button>
          <button class="t-btn active" data-teeth="10">10개</button>
          <button class="t-btn" data-teeth="12">12개</button>
          <button class="t-btn" data-teeth="14">14개</button>
        </div>
      </div>

      <div class="tool-right">
        <span class="status-indicator" id="status-text">이빨을 하나씩 눌러보세요!</span>
        <button id="reset-croc-btn" class="btn-reset">
          <span>🔄 다시 시작 (Space)</span>
        </button>
      </div>
    </div>

    <!-- Crocodile Stage -->
    <div class="croc-stage-wrapper">
      
      <!-- Big Crocodile Visual -->
      <div class="croc-face" id="croc-face">
        <!-- Eyes -->
        <div class="croc-eyes-row">
          <div class="croc-eye left-eye">
            <div class="eye-pupil" id="eye-l"></div>
          </div>
          <div class="croc-eye right-eye">
            <div class="eye-pupil" id="eye-r"></div>
          </div>
        </div>

        <!-- Upper Jaw (Animates down on Chomp) -->
        <div class="upper-jaw" id="upper-jaw">
          <div class="jaw-skin">
            <div class="nostrils">
              <span class="nostril"></span>
              <span class="nostril"></span>
            </div>
          </div>
          <!-- Upper sharp teeth decoration -->
          <div class="upper-teeth-row">
            <span class="u-tooth"></span>
            <span class="u-tooth"></span>
            <span class="u-tooth"></span>
            <span class="u-tooth"></span>
            <span class="u-tooth"></span>
            <span class="u-tooth"></span>
          </div>
        </div>

        <!-- Lower Jaw containing Clickable Teeth -->
        <div class="lower-jaw" id="lower-jaw">
          <!-- Red mouth interior -->
          <div class="mouth-throat"></div>
          <!-- Interactive Teeth Arc -->
          <div class="teeth-container" id="teeth-container">
            <!-- Dynamically populated teeth -->
          </div>
        </div>
      </div>

      <!-- Chomp Alert Banner Overlay -->
      <div class="chomp-banner hidden" id="chomp-banner">
        <div class="chomp-card">
          <div class="chomp-icon">🚨 💥 🚨</div>
          <div class="chomp-text">물렸다!! (CHOMP!)</div>
          <div class="chomp-sub">벌칙 당첨자 탄생!</div>
          <button id="modal-retry-btn" class="btn-retry">한 판 더! (Retry)</button>
        </div>
      </div>
    </div>
  </div>

  <div slot="guide">
    <h2>악어 이빨 복불복 방송 진행 팁</h2>
    <p>
      참가자들(스트리머, 합방 게스트, 시청자 미션)이 순서를 정해 번갈아가며 이빨을 누르게 하세요. 
      남은 이빨이 3개 이하로 줄어들었을 때의 극적인 BGM과 심장 박동 사운드가 방송 텐션을 폭발시킵니다!
    </p>
  </div>
</GameLayout>

<style>
  .crocodile-app-root {
    background: #090d16;
    border-radius: 16px;
    padding: 1.5rem;
    min-height: 640px;
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    user-select: none;
  }

  /* Toolbar */
  .croc-toolbar {
    background: #0f172a;
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 14px;
    padding: 0.85rem 1.25rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .tool-left {
    display: flex;
    align-items: center;
    gap: 1.25rem;
  }

  .croc-title {
    font-size: 1.15rem;
    font-weight: 900;
    color: #f8fafc;
  }

  .teeth-count-picker {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    font-size: 0.8rem;
    color: #94a3b8;
    font-weight: 800;
  }

  .t-btn {
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid rgba(255, 255, 255, 0.1);
    color: #cbd5e1;
    padding: 0.25rem 0.55rem;
    border-radius: 6px;
    font-size: 0.78rem;
    font-weight: 800;
    cursor: pointer;
  }

  .t-btn.active {
    background: #10b981;
    color: #ffffff;
    border-color: transparent;
  }

  .tool-right {
    display: flex;
    align-items: center;
    gap: 0.85rem;
  }

  .status-indicator {
    font-size: 0.88rem;
    font-weight: 800;
    color: #facc15;
  }

  .btn-reset {
    background: linear-gradient(135deg, #10b981, #059669);
    color: #ffffff;
    border: none;
    padding: 0.45rem 1rem;
    border-radius: 8px;
    font-size: 0.85rem;
    font-weight: 800;
    cursor: pointer;
    box-shadow: 0 0 15px rgba(16, 185, 129, 0.3);
  }

  /* Crocodile Visual Stage */
  .croc-stage-wrapper {
    position: relative;
    background: #0f172a;
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 16px;
    padding: 2rem 1rem;
    display: flex;
    align-items: center;
    justify-content: center;
    flex: 1;
    min-height: 480px;
    overflow: hidden;
  }

  .croc-face {
    position: relative;
    width: 440px;
    height: 400px;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  /* Eyes */
  .croc-eyes-row {
    position: absolute;
    top: 0;
    width: 200px;
    display: flex;
    justify-content: space-between;
    z-index: 5;
  }

  .croc-eye {
    width: 64px;
    height: 64px;
    background: #ffffff;
    border: 4px solid #064e3b;
    border-radius: 50%;
    position: relative;
    box-shadow: 0 4px 10px rgba(0, 0, 0, 0.4);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .eye-pupil {
    width: 22px;
    height: 22px;
    background: #020617;
    border-radius: 50%;
    transition: transform 0.1s ease;
  }

  /* Upper Jaw */
  .upper-jaw {
    position: relative;
    width: 380px;
    height: 180px;
    background: #059669;
    border: 5px solid #064e3b;
    border-radius: 190px 190px 20px 20px;
    margin-top: 30px;
    z-index: 10;
    transform-origin: top center;
    transition: transform 0.12s cubic-bezier(0.36, 0.07, 0.19, 0.97);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    align-items: center;
    box-shadow: 0 10px 25px rgba(0, 0, 0, 0.5);
  }

  .upper-jaw.chomped {
    transform: translateY(110px) rotateX(15deg);
  }

  .nostrils {
    display: flex;
    gap: 40px;
    margin-top: 40px;
  }

  .nostril {
    width: 14px;
    height: 14px;
    background: #064e3b;
    border-radius: 50%;
  }

  .upper-teeth-row {
    display: flex;
    gap: 16px;
    margin-bottom: -10px;
  }

  .u-tooth {
    width: 0;
    height: 0;
    border-left: 12px solid transparent;
    border-right: 12px solid transparent;
    border-top: 24px solid #f8fafc;
    filter: drop-shadow(0 2px 4px rgba(0, 0, 0, 0.3));
  }

  /* Lower Jaw */
  .lower-jaw {
    position: relative;
    width: 400px;
    height: 190px;
    background: #047857;
    border: 5px solid #064e3b;
    border-radius: 20px 20px 200px 200px;
    margin-top: -20px;
    z-index: 8;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: flex-end;
    padding-bottom: 25px;
    box-shadow: 0 15px 35px rgba(0, 0, 0, 0.6);
  }

  .mouth-throat {
    position: absolute;
    top: 0;
    width: 80%;
    height: 80%;
    background: radial-gradient(circle at 50% 30%, #be123c 0%, #881337 100%);
    border-radius: 50%;
  }

  /* Teeth Container */
  .teeth-container {
    position: relative;
    width: 320px;
    height: 110px;
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 12;
  }

  :global(.tooth-btn) {
    position: absolute;
    width: 26px;
    height: 38px;
    background: #ffffff;
    border: 2px solid #cbd5e1;
    border-radius: 12px 12px 6px 6px;
    box-shadow: 0 4px 8px rgba(0, 0, 0, 0.4), inset 0 2px 4px rgba(255, 255, 255, 0.8);
    cursor: pointer;
    transition: transform 0.15s ease, background 0.15s ease;
  }

  :global(.tooth-btn:hover:not(.pressed)) {
    transform: scale(1.15) !important;
    background: #fef08a;
    box-shadow: 0 0 12px #facc15;
  }

  :global(.tooth-btn.pressed) {
    transform: scale(0.6) translateY(12px) !important;
    background: #64748b !important;
    border-color: #475569 !important;
    box-shadow: inset 0 2px 6px rgba(0, 0, 0, 0.6) !important;
    cursor: default;
  }

  /* Chomp Overlay */
  .chomp-banner {
    position: absolute;
    inset: 0;
    background: rgba(185, 28, 28, 0.35);
    backdrop-filter: blur(4px);
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 30;
    animation: flashRed 0.3s ease-out;
  }

  @keyframes flashRed {
    0% { background: rgba(239, 68, 68, 0.8); }
    100% { background: rgba(185, 28, 28, 0.35); }
  }

  .chomp-card {
    background: #0f172a;
    border: 3px solid #ef4444;
    border-radius: 20px;
    padding: 2rem 2.5rem;
    text-align: center;
    box-shadow: 0 0 50px rgba(239, 68, 68, 0.6);
    animation: popChomp 0.25s cubic-bezier(0.34, 1.56, 0.64, 1);
  }

  @keyframes popChomp {
    0% { transform: scale(0.6); }
    100% { transform: scale(1); }
  }

  .chomp-icon {
    font-size: 2rem;
    margin-bottom: 0.4rem;
  }

  .chomp-text {
    font-size: 2.2rem;
    font-weight: 900;
    color: #ef4444;
    letter-spacing: -0.02em;
    text-shadow: 0 0 20px rgba(239, 68, 68, 0.6);
  }

  .chomp-sub {
    font-size: 1rem;
    font-weight: 800;
    color: #f8fafc;
    margin: 0.5rem 0 1.5rem;
  }

  .btn-retry {
    background: linear-gradient(135deg, #ef4444, #f97316);
    color: #ffffff;
    font-size: 1.05rem;
    font-weight: 900;
    padding: 0.75rem 2rem;
    border-radius: 10px;
    border: none;
    cursor: pointer;
    box-shadow: 0 0 20px rgba(239, 68, 68, 0.5);
  }

  .hidden {
    display: none !important;
  }
</style>

<script>
  // Web Audio Synth for clicks & chomp
  class CrocAudio {
    private ctx: AudioContext | null = null;
    init() {
      if (!this.ctx) {
        const AudioCtx = window.AudioContext || (window as any).webkitAudioContext;
        if (AudioCtx) this.ctx = new AudioCtx();
      }
      if (this.ctx && this.ctx.state === 'suspended') this.ctx.resume();
    }
    playSafeClick() {
      this.init();
      if (!this.ctx) return;
      const osc = this.ctx.createOscillator();
      const gain = this.ctx.createGain();
      osc.type = 'triangle';
      osc.frequency.setValueAtTime(800, this.ctx.currentTime);
      osc.frequency.exponentialRampToValueAtTime(300, this.ctx.currentTime + 0.05);
      gain.gain.setValueAtTime(0.3, this.ctx.currentTime);
      gain.gain.exponentialRampToValueAtTime(0.01, this.ctx.currentTime + 0.05);
      osc.connect(gain);
      gain.connect(this.ctx.destination);
      osc.start();
      osc.stop(this.ctx.currentTime + 0.05);
    }
    playChomp() {
      this.init();
      if (!this.ctx) return;
      // Low boom
      const osc = this.ctx.createOscillator();
      const gain = this.ctx.createGain();
      osc.type = 'sawtooth';
      osc.frequency.setValueAtTime(140, this.ctx.currentTime);
      osc.frequency.exponentialRampToValueAtTime(40, this.ctx.currentTime + 0.35);
      gain.gain.setValueAtTime(0.6, this.ctx.currentTime);
      gain.gain.exponentialRampToValueAtTime(0.01, this.ctx.currentTime + 0.35);
      osc.connect(gain);
      gain.connect(this.ctx.destination);
      osc.start();
      osc.stop(this.ctx.currentTime + 0.35);
    }
  }

  const audio = new CrocAudio();

  let totalTeeth = 10;
  let trapToothIndex = -1;
  let isGameOver = false;

  const teethContainer = document.getElementById('teeth-container');
  const upperJaw = document.getElementById('upper-jaw');
  const chompBanner = document.getElementById('chomp-banner');
  const statusText = document.getElementById('status-text');
  const resetBtn = document.getElementById('reset-croc-btn');
  const retryBtn = document.getElementById('modal-retry-btn');
  const teethCountBtns = document.querySelectorAll('.t-btn');

  function initGame() {
    isGameOver = false;
    trapToothIndex = Math.floor(Math.random() * totalTeeth);
    upperJaw?.classList.remove('chomped');
    chompBanner?.classList.add('hidden');
    if (statusText) statusText.textContent = `이빨 ${totalTeeth}개 중 1개 함정!`;

    renderTeeth();
  }

  function renderTeeth() {
    if (!teethContainer) return;
    teethContainer.innerHTML = '';

    const radiusX = 140;
    const radiusY = 45;
    const startAngle = Math.PI * 0.15;
    const endAngle = Math.PI * 0.85;
    const angleStep = (endAngle - startAngle) / (totalTeeth - 1);

    for (let i = 0; i < totalTeeth; i++) {
      const angle = startAngle + i * angleStep;
      const x = Math.cos(angle) * radiusX;
      const y = Math.sin(angle) * radiusY;

      const tooth = document.createElement('button');
      tooth.className = 'tooth-btn';
      tooth.style.left = `calc(50% + ${x}px - 13px)`;
      tooth.style.top = `calc(60% + ${y}px - 19px)`;
      tooth.style.transform = `rotate(${(angle - Math.PI / 2) * 35}deg)`;

      tooth.addEventListener('click', () => {
        if (isGameOver || tooth.classList.contains('pressed')) return;
        handleToothClick(i, tooth);
      });

      teethContainer.appendChild(tooth);
    }
  }

  function handleToothClick(index: number, toothElem: HTMLElement) {
    if (index === trapToothIndex) {
      // Trigger Chomp!
      isGameOver = true;
      audio.playChomp();
      upperJaw?.classList.add('chomped');
      toothElem.classList.add('pressed');
      setTimeout(() => {
        chompBanner?.classList.remove('hidden');
      }, 150);
    } else {
      // Safe tooth
      audio.playSafeClick();
      toothElem.classList.add('pressed');
      if (statusText) statusText.textContent = '휴... 세이프! 다음 사람!';
    }
  }

  // Count buttons
  teethCountBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      teethCountBtns.forEach(b => b.classList.remove('active'));
      btn.classList.add('active');
      totalTeeth = parseInt(btn.getAttribute('data-teeth') || '10', 10);
      initGame();
    });
  });

  resetBtn?.addEventListener('click', initGame);
  retryBtn?.addEventListener('click', initGame);

  // Spacebar to reset
  window.addEventListener('keydown', (e) => {
    if (e.code === 'Space') {
      e.preventDefault();
      initGame();
    }
  });

  initGame();
</script>
