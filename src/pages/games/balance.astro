---
import GameLayout from '../../layouts/GameLayout.astro';
import { getEntry } from 'astro:content';

const gameEntry = await getEntry('games', 'balance');
const data = gameEntry?.data || {
  title: '스트리머 밸런스 게임',
  tagline: '저챗·소통 방송 치트키! 꿀잼 극단적 양자택일',
  description: '시청자와 도네이션 채팅창이 폭발하는 밸런스 게임. 난감하고 유쾌한 100가지 이상의 방송용 질문과 실시간 투표 게이지 제공.',
  icon: '⚖️',
  category: 'stream',
  badge: '🔥 저챗 필수',
  players: '스트리머 & 시청자',
  playTime: '자유',
  controls: [
    '왼쪽(A) 또는 오른쪽(B)을 클릭하여 선택',
    '단축키: 숫자 [1] 키는 A, 숫자 [2] 키는 B 선택',
    '스페이스바(Space)를 누르면 다음 질문으로 넘어갑니다',
    '상단 카테고리(매운맛, 직장, 연애, 황당)로 질문 필터링'
  ],
  rules: [
    '피하고 싶거나 탐나는 극단적인 두 선택지 중 무조건 하나만 골라야 합니다.',
    '기권이나 둘 다 고르기는 절대 불가!'
  ],
  faqItems: [
    {
      q: '직접 질문 세트를 만들어 공유할 수 있나요?',
      a: '네! [📦 질문 관리 & 세트 공유] 버튼을 통해 대량 질문을 붙여넣고 나만의 세트를 저장하거나, URL 공유 링크를 복사해 시청자/디스코드에 바로 공유할 수 있습니다.'
    }
  ]
};
---

<GameLayout
  title={data.title}
  description={data.description}
  tagline={data.tagline}
  icon={data.icon}
  category={data.category}
  badge={data.badge}
  players={data.players}
  playTime={data.playTime}
  controls={data.controls}
  rules={data.rules}
  faqItems={data.faqItems}
>
  <div class="balance-app-root" id="balance-root">
    
    <!-- Header Control Bar -->
    <div class="balance-nav-bar">
      <div class="category-pills" id="category-pills">
        <button class="cat-pill active" data-cat="all">전체 질문</button>
        <button class="cat-pill" data-cat="spicy">🌶️ 매운맛/현실</button>
        <button class="cat-pill" data-cat="life">💼 직장 & 돈</button>
        <button class="cat-pill" data-cat="love">💖 연애 & 친구</button>
        <button class="cat-pill" data-cat="funny">🤡 황당 & 엽기</button>
        <button class="cat-pill" data-cat="custom" id="custom-cat-pill">⭐ 내 질문 세트 (<span id="custom-q-badge">0</span>)</button>
      </div>

      <div class="timer-display-box" id="timer-box">
        <span class="timer-icon">⏱️</span>
        <span class="timer-digits" id="timer-text">30</span>초
      </div>

      <div class="nav-actions">
        <button id="shuffle-btn" class="mini-btn highlight-gold" title="질문 순서를 무작위로 섞습니다">🔀 무작위 섞기</button>
        <button id="pack-manager-btn" class="mini-btn highlight-purple" title="질문 목록 관리, 대량 추가, 세트 저장 및 링크 공유">📦 질문 관리 & 세트 공유</button>
        <button id="next-btn" class="primary-action-btn">
          <span>다음 질문 ▶ [Space]</span>
        </button>
      </div>
    </div>

    <!-- Floating Toast Notification -->
    <div class="balance-toast hidden" id="balance-toast"></div>

    <!-- Main Dual Cards Arena -->
    <div class="cards-arena">
      <div class="vs-divider-circle">VS</div>

      <!-- Card A -->
      <button class="balance-choice-card choice-a" id="choice-a-btn">
        <div class="card-tag">CHOICE A [키 1]</div>
        <div class="card-icon-preview" id="icon-a">🍗</div>
        <div class="choice-text" id="text-a">평생 치킨만 먹기</div>
        <div class="vote-result-box hidden" id="result-a">
          <div class="vote-percent" id="pct-a">50%</div>
          <div class="vote-label">선택 비율</div>
        </div>
      </button>

      <!-- Card B -->
      <button class="balance-choice-card choice-b" id="choice-b-btn">
        <div class="card-tag">CHOICE B [키 2]</div>
        <div class="card-icon-preview" id="icon-b">🍕</div>
        <div class="choice-text" id="text-b">평생 피자만 먹기</div>
        <div class="vote-result-box hidden" id="result-b">
          <div class="vote-percent" id="pct-b">50%</div>
          <div class="vote-label">선택 비율</div>
        </div>
      </button>
    </div>

    <!-- Bottom Gauge Vote Bar -->
    <div class="vote-gauge-container hidden" id="vote-gauge">
      <div class="gauge-fill-a" id="gauge-fill-a" style="width: 50%;">A (50%)</div>
      <div class="gauge-fill-b" id="gauge-fill-b" style="width: 50%;">B (50%)</div>
    </div>

    <!-- Question Pack Manager & Share Modal -->
    <div class="pack-modal-overlay hidden" id="pack-modal">
      <div class="pack-modal-card">
        <div class="pack-modal-header">
          <div class="pack-title-row">
            <span class="modal-icon">📦</span>
            <h3>질문 세트 관리 & 공유</h3>
          </div>
          <button id="close-pack-modal-btn" class="btn-close-modal">✕</button>
        </div>

        <!-- Modal Tabs -->
        <div class="pack-tabs">
          <button class="pack-tab-btn active" data-tab="list">📋 질문 목록 (<span id="total-q-count">0</span>)</button>
          <button class="pack-tab-btn" data-tab="bulk">➕ 대량 추가 (Bulk)</button>
          <button class="pack-tab-btn" data-tab="share">💾 저장 & 🔗 링크 공유</button>
        </div>

        <!-- Tab 1: Current List -->
        <div class="tab-pane active" id="pane-list">
          <div class="list-action-toolbar">
            <button id="modal-shuffle-btn" class="sub-btn">🔀 무작위 섞기</button>
            <button id="reset-default-btn" class="sub-btn danger">🔄 기본 질문으로 리셋</button>
          </div>
          <div class="questions-scroll-list" id="questions-scroll-list">
            <!-- Dynamic question rows -->
          </div>
        </div>

        <!-- Tab 2: Bulk Add -->
        <div class="tab-pane" id="pane-bulk">
          <p class="bulk-guide">줄바꿈으로 <code>A vs B</code> 형태로 질문들을 한 번에 붙여넣으세요!</p>
          <textarea id="bulk-textarea" rows="7" placeholder="예시:
월 250 백수 vs 월 1200 대기업 주7일 야근
평생 라면만 먹기 vs 평생 치킨만 먹기
스마트폰 없이 1년 살기 vs 친구 연락 끊고 1년 살기
짜장면 vs 짬뽕"></textarea>
          <div class="bulk-btn-row">
            <button id="bulk-append-btn" class="btn-confirm">➕ 현재 목록 뒤에 추가</button>
            <button id="bulk-replace-btn" class="btn-replace">⚠️ 현재 목록 전체 교체</button>
          </div>
        </div>

        <!-- Tab 3: Save & Share -->
        <div class="tab-pane" id="pane-share">
          <div class="share-box">
            <h4>🔗 시청자 / 스트리머 공유 링크</h4>
            <p class="share-desc">현재 질문 목록이 담긴 고유 URL을 복사하여 방송 채팅창이나 디스코드에 공유하세요. 링크를 클릭하면 즉시 이 질문들로 게임이 시작됩니다!</p>
            <div class="share-input-group">
              <input type="text" id="share-url-input" readonly />
              <button id="copy-share-url-btn" class="btn-copy">링크 복사</button>
            </div>
            <span id="copy-feedback" class="copy-feedback hidden">✅ 공유 링크가 클립보드에 복사되었습니다!</span>
          </div>

          <hr class="modal-hr" />

          <div class="save-box">
            <h4>💾 내 브라우저에 세트 저장</h4>
            <div class="save-input-group">
              <input type="text" id="save-pack-name" placeholder="세트 이름 (예: 침착맨 합방용 질문 세트)" />
              <button id="save-pack-btn" class="btn-save">저장하기</button>
            </div>
            <div class="saved-packs-container">
              <span class="saved-packs-title">저장된 세트 목록:</span>
              <div class="saved-packs-list" id="saved-packs-list">
                <!-- Saved packs injected dynamically -->
              </div>
            </div>
          </div>
        </div>

      </div>
    </div>
  </div>

  <div slot="guide">
    <h2>스트리머 밸런스 게임 방송 꿀팁 & 소통 가이드</h2>
    <p>
      <strong>스트리머 밸런스 게임</strong>은 치지직(CHZZK), SOOP, 유튜브 라이브 방송에서 침묵이 흐르거나 저챗(Just Chatting) 콘텐츠를 진행할 때 시청자들의 실시간 채팅 참여를 폭발적으로 이끌어내는 최고의 소통 도구입니다.
    </p>
    <ul>
      <li><strong>키보드 단축키 지원:</strong> PC 환경에서 숫자 <code>1</code>(A 선택), 숫자 <code>2</code>(B 선택), <code>Space</code>(다음 질문) 단축키를 통해 마우스 조작 없이 자연스러운 리액션 방송이 가능합니다.</li>
      <li><strong>나만의 질문 세트 공유:</strong> 스트리머가 직접 작성한 밸런스 질문 목록을 URL 링크 하나로 압축하여 동료 스트리머나 시청자에게 원클릭 공유할 수 있습니다.</li>
      <li><strong>랜덤 셔플 엔진:</strong> 무작위 섞기를 통해 매 방송마다 새로운 질문 순서로 신선한 긴장감을 유지하세요.</li>
    </ul>
  </div>
</GameLayout>

<style>
  .balance-app-root {
    background: #090d16;
    border-radius: 16px;
    padding: 1.5rem;
    min-height: 650px;
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    position: relative;
    user-select: none;
  }

  /* Nav Bar */
  .balance-nav-bar {
    background: #0f172a;
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 14px;
    padding: 0.85rem 1.25rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .category-pills {
    display: flex;
    gap: 0.35rem;
    flex-wrap: wrap;
  }

  .cat-pill {
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid rgba(255, 255, 255, 0.1);
    color: #cbd5e1;
    padding: 0.3rem 0.65rem;
    border-radius: 6px;
    font-size: 0.78rem;
    font-weight: 800;
    cursor: pointer;
    transition: all 0.15s ease;
  }

  .cat-pill:hover {
    background: rgba(255, 255, 255, 0.12);
  }

  .cat-pill.active {
    background: linear-gradient(135deg, #a855f7, #38bdf8);
    color: #ffffff;
    border-color: transparent;
  }

  .timer-display-box {
    display: flex;
    align-items: center;
    gap: 0.3rem;
    font-size: 0.95rem;
    font-weight: 900;
    color: #facc15;
    background: rgba(234, 179, 8, 0.12);
    border: 1px solid rgba(234, 179, 8, 0.25);
    padding: 0.3rem 0.75rem;
    border-radius: 8px;
  }

  .nav-actions {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .mini-btn {
    background: rgba(255, 255, 255, 0.08);
    border: 1px solid rgba(255, 255, 255, 0.12);
    color: #e2e8f0;
    padding: 0.45rem 0.75rem;
    border-radius: 8px;
    font-size: 0.8rem;
    font-weight: 800;
    cursor: pointer;
    transition: all 0.15s ease;
  }

  .mini-btn.highlight-gold {
    background: rgba(234, 179, 8, 0.15);
    border-color: rgba(234, 179, 8, 0.35);
    color: #facc15;
  }

  .mini-btn.highlight-gold:hover {
    background: rgba(234, 179, 8, 0.25);
  }

  .mini-btn.highlight-purple {
    background: rgba(168, 85, 247, 0.15);
    border-color: rgba(168, 85, 247, 0.35);
    color: #e9d5ff;
  }

  .mini-btn.highlight-purple:hover {
    background: rgba(168, 85, 247, 0.25);
  }

  .primary-action-btn {
    background: linear-gradient(135deg, #38bdf8, #2563eb);
    color: #ffffff;
    border: none;
    padding: 0.5rem 1.1rem;
    border-radius: 8px;
    font-size: 0.88rem;
    font-weight: 900;
    cursor: pointer;
    box-shadow: 0 0 15px rgba(56, 189, 248, 0.4);
    transition: transform 0.15s ease;
  }

  .primary-action-btn:hover {
    transform: scale(1.04);
  }

  /* Floating Toast */
  .balance-toast {
    position: absolute;
    top: 5rem;
    left: 50%;
    transform: translateX(-50%);
    background: #0f172a;
    border: 1px solid #38bdf8;
    color: #f8fafc;
    padding: 0.6rem 1.25rem;
    border-radius: 30px;
    font-size: 0.88rem;
    font-weight: 800;
    box-shadow: 0 10px 25px rgba(0, 0, 0, 0.6), 0 0 20px rgba(56, 189, 248, 0.4);
    z-index: 50;
    pointer-events: none;
    transition: opacity 0.25s ease;
  }

  /* Main Cards Arena */
  .cards-arena {
    position: relative;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.5rem;
    flex: 1;
    min-height: 420px;
  }

  .vs-divider-circle {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 68px;
    height: 68px;
    border-radius: 50%;
    background: #020617;
    border: 4px solid #ffffff;
    color: #facc15;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.25rem;
    font-weight: 900;
    z-index: 10;
    box-shadow: 0 0 30px rgba(0, 0, 0, 0.8), 0 0 20px rgba(250, 204, 21, 0.6);
    pointer-events: none;
  }

  .balance-choice-card {
    background: #0f172a;
    border-radius: 20px;
    border: 3px solid rgba(255, 255, 255, 0.1);
    padding: 2.5rem 2rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    cursor: pointer;
    transition: transform 0.2s cubic-bezier(0.34, 1.56, 0.64, 1), border-color 0.2s ease, box-shadow 0.2s ease;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.5);
  }

  .choice-a {
    border-color: rgba(56, 189, 248, 0.35);
  }

  .choice-a:hover {
    transform: translateY(-8px) scale(1.02);
    border-color: #38bdf8;
    box-shadow: 0 0 35px rgba(56, 189, 248, 0.4);
  }

  .choice-b {
    border-color: rgba(244, 63, 94, 0.35);
  }

  .choice-b:hover {
    transform: translateY(-8px) scale(1.02);
    border-color: #f43f5e;
    box-shadow: 0 0 35px rgba(244, 63, 94, 0.4);
  }

  .card-tag {
    font-size: 0.85rem;
    font-weight: 900;
    letter-spacing: 0.08em;
    color: #94a3b8;
    margin-bottom: 1rem;
  }

  .choice-a .card-tag { color: #38bdf8; }
  .choice-b .card-tag { color: #f43f5e; }

  .card-icon-preview {
    font-size: 3.5rem;
    margin-bottom: 1.25rem;
    filter: drop-shadow(0 4px 8px rgba(0,0,0,0.4));
  }

  .choice-text {
    font-size: 1.6rem;
    font-weight: 900;
    color: #f8fafc;
    line-height: 1.35;
    word-break: keep-all;
    max-width: 380px;
  }

  .vote-result-box {
    margin-top: 1.5rem;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .vote-percent {
    font-size: 2.8rem;
    font-weight: 900;
  }

  .choice-a .vote-percent { color: #38bdf8; text-shadow: 0 0 15px rgba(56, 189, 248, 0.5); }
  .choice-b .vote-percent { color: #f43f5e; text-shadow: 0 0 15px rgba(244, 63, 94, 0.5); }

  .vote-label {
    font-size: 0.82rem;
    font-weight: 800;
    color: #94a3b8;
  }

  /* Bottom Gauge Vote Bar */
  .vote-gauge-container {
    height: 38px;
    background: #020617;
    border-radius: 12px;
    overflow: hidden;
    display: flex;
    border: 2px solid rgba(255, 255, 255, 0.1);
    box-shadow: 0 4px 15px rgba(0, 0, 0, 0.4);
  }

  .gauge-fill-a {
    background: linear-gradient(90deg, #0284c7, #38bdf8);
    color: #ffffff;
    font-weight: 900;
    font-size: 0.88rem;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: width 0.4s ease;
  }

  .gauge-fill-b {
    background: linear-gradient(90deg, #e11d48, #f43f5e);
    color: #ffffff;
    font-weight: 900;
    font-size: 0.88rem;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: width 0.4s ease;
  }

  /* Pack Manager Modal */
  .pack-modal-overlay {
    position: fixed;
    inset: 0;
    background: rgba(9, 13, 22, 0.85);
    backdrop-filter: blur(10px);
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 100;
  }

  .pack-modal-card {
    background: #0f172a;
    border: 1px solid rgba(255, 255, 255, 0.15);
    border-radius: 18px;
    padding: 1.75rem;
    width: 92%;
    max-width: 580px;
    max-height: 90vh;
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    box-shadow: 0 20px 50px rgba(0, 0, 0, 0.8);
  }

  .pack-modal-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .pack-title-row {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .modal-icon {
    font-size: 1.4rem;
  }

  .pack-modal-header h3 {
    margin: 0;
    font-size: 1.25rem;
    font-weight: 900;
    color: #f8fafc;
  }

  .btn-close-modal {
    background: transparent;
    border: none;
    color: #94a3b8;
    font-size: 1.2rem;
    cursor: pointer;
  }

  .btn-close-modal:hover {
    color: #f8fafc;
  }

  /* Pack Tabs */
  .pack-tabs {
    display: flex;
    gap: 0.5rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
    padding-bottom: 0.5rem;
  }

  .pack-tab-btn {
    background: transparent;
    border: none;
    color: #94a3b8;
    font-size: 0.85rem;
    font-weight: 800;
    padding: 0.4rem 0.75rem;
    border-radius: 6px;
    cursor: pointer;
    transition: all 0.15s ease;
  }

  .pack-tab-btn.active {
    background: rgba(56, 189, 248, 0.15);
    color: #38bdf8;
  }

  .tab-pane {
    display: none;
    flex-direction: column;
    gap: 0.85rem;
    overflow-y: auto;
    max-height: 420px;
  }

  .tab-pane.active {
    display: flex;
  }

  /* Tab 1: List */
  .list-action-toolbar {
    display: flex;
    justify-content: space-between;
    gap: 0.5rem;
  }

  .sub-btn {
    background: rgba(255, 255, 255, 0.08);
    border: 1px solid rgba(255, 255, 255, 0.12);
    color: #cbd5e1;
    padding: 0.4rem 0.8rem;
    border-radius: 6px;
    font-size: 0.8rem;
    font-weight: 800;
    cursor: pointer;
  }

  .sub-btn.danger {
    color: #f87171;
