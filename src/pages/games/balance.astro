  }

  .saved-packs-container {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    margin-top: 0.3rem;
  }

  .saved-packs-title {
    font-size: 0.78rem;
    color: #94a3b8;
    font-weight: 800;
  }

  .saved-packs-list {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    max-height: 120px;
    overflow-y: auto;
  }

  :global(.saved-pack-row) {
    display: flex;
    align-items: center;
    justify-content: space-between;
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 6px;
    padding: 0.4rem 0.6rem;
    font-size: 0.8rem;
  }

  :global(.pack-load-btn) {
    background: rgba(56, 189, 248, 0.15);
    border: 1px solid rgba(56, 189, 248, 0.3);
    color: #38bdf8;
    border-radius: 4px;
    padding: 0.2rem 0.5rem;
    font-size: 0.72rem;
    font-weight: 800;
    cursor: pointer;
  }

  :global(.pack-del-btn) {
    background: transparent;
    border: none;
    color: #64748b;
    cursor: pointer;
    padding: 0.2rem 0.4rem;
  }

  :global(.pack-del-btn:hover) {
    color: #ef4444;
  }

  .hidden {
    display: none !important;
  }

  @media (max-width: 768px) {
    .cards-arena {
      grid-template-columns: 1fr;
      min-height: auto;
    }
    .vs-divider-circle {
      position: static;
      transform: none;
      margin: 0 auto;
    }
  }
</style>

<script>
  interface Question {
    cat: string;
    iconA: string;
    textA: string;
    iconB: string;
    textB: string;
    ratioA: number; // default baseline percent
  }

  const DEFAULT_QUESTIONS: Question[] = [
    { cat: 'life', iconA: '💰', textA: '평생 월 250만원 백수로 살기', iconB: '🏢', textB: '월 1200만원 대기업 주7일 야근', ratioA: 58 },
    { cat: 'spicy', iconA: '🍜', textA: '평생 라면만 먹기 (밥/반찬 금지)', iconB: '🍚', textB: '평생 밥 없이 반찬만 먹기', ratioA: 44 },
    { cat: 'love', iconA: '🥰', textA: '내가 미치도록 짝사랑하는 사람', iconB: '💖', textB: '나를 목숨 걸고 사랑해주는 사람', ratioA: 36 },
    { cat: 'spicy', iconA: '📱', textA: '스마트폰 없이 1년 살기', iconB: '👥', textB: '친구/지인과 1년간 연락 끊기', ratioA: 41 },
    { cat: 'funny', iconA: '🛁', textA: '양치 안 하고 1주일 버티기', iconB: '🚿', textB: '머리 안 감고 2주일 버티기', ratioA: 28 },
    { cat: 'life', iconA: '⏳', textA: '과거로 돌아가기 (기억 유지)', iconB: '🚀', textB: '미래로 10년 워프 (100억 지급)', ratioA: 62 },
    { cat: 'love', iconA: '💬', textA: '카톡 읽씹 당하기', iconB: '📴', textB: '카톡 1초도 안 읽고 안읽씹 당하기', ratioA: 47 },
    { cat: 'spicy', iconA: '🍗', textA: '평생 치킨 못 먹기', iconB: '🥩', textB: '평생 삼겹살 못 먹기', ratioA: 52 },
    { cat: 'funny', iconA: '🦘', textA: '평생 걸을 때 무조건 캥거루처럼 점프', iconB: '🦀', textB: '평생 옆으로 게걸음으로만 걷기', ratioA: 49 },
    { cat: 'life', iconA: '🏖️', textA: '1년 동안 무인도 혼자 살기 (식량 완비)', iconB: '🏢', textB: '1년 동안 꼰대 상사와 한집 동거', ratioA: 71 },
    { cat: 'funny', iconA: '🤡', textA: '모든 사람의 생각이 귓가에 들리기', iconB: '🙈', textB: '내 모든 생각이 전광판에 실시간 중계', ratioA: 82 },
    { cat: 'spicy', iconA: '❄️', textA: '한겨울 영하 15도에 에어컨 풀가동', iconB: '🔥', textB: '한여름 38도 폭염에 보일러 풀가동', ratioA: 54 },
    { cat: 'love', iconA: '🧠', textA: '애인의 전 애인이 내 절친', iconB: '💔', textB: '내 절친의 전 애인이 내 애인', ratioA: 33 }
  ];

  let currentQuestions: Question[] = [...DEFAULT_QUESTIONS];
  let currentCategory = 'all';
  let currentIndex = 0;
  let timerInterval: any = null;
  let timeLeft = 30;

  // DOM Elements
  const choiceABtn = document.getElementById('choice-a-btn');
  const choiceBBtn = document.getElementById('choice-b-btn');
  const iconA = document.getElementById('icon-a');
  const textA = document.getElementById('text-a');
  const iconB = document.getElementById('icon-b');
  const textB = document.getElementById('text-b');
  const resultA = document.getElementById('result-a');
  const resultB = document.getElementById('result-b');
  const pctA = document.getElementById('pct-a');
  const pctB = document.getElementById('pct-b');
  const voteGauge = document.getElementById('vote-gauge');
  const gaugeFillA = document.getElementById('gauge-fill-a');
  const gaugeFillB = document.getElementById('gauge-fill-b');

  const nextBtn = document.getElementById('next-btn');
  const shuffleBtn = document.getElementById('shuffle-btn');
  const timerText = document.getElementById('timer-text');
  const catPills = document.querySelectorAll('.cat-pill');
  const customQBadge = document.getElementById('custom-q-badge');
  const toastElem = document.getElementById('balance-toast');

  // Pack Modal Elements
  const packModal = document.getElementById('pack-modal');
  const packManagerBtn = document.getElementById('pack-manager-btn');
  const closePackModalBtn = document.getElementById('close-pack-modal-btn');
  const packTabBtns = document.querySelectorAll('.pack-tab-btn');
  const totalQCount = document.getElementById('total-q-count');
  const questionsScrollList = document.getElementById('questions-scroll-list');
  const modalShuffleBtn = document.getElementById('modal-shuffle-btn');
  const resetDefaultBtn = document.getElementById('reset-default-btn');

  const bulkTextarea = document.getElementById('bulk-textarea') as HTMLTextAreaElement | null;
  const bulkAppendBtn = document.getElementById('bulk-append-btn');
  const bulkReplaceBtn = document.getElementById('bulk-replace-btn');

  const shareUrlInput = document.getElementById('share-url-input') as HTMLInputElement | null;
  const copyShareUrlBtn = document.getElementById('copy-share-url-btn');
  const copyFeedback = document.getElementById('copy-feedback');
  const savePackName = document.getElementById('save-pack-name') as HTMLInputElement | null;
  const savePackBtn = document.getElementById('save-pack-btn');
  const savedPacksList = document.getElementById('saved-packs-list');

  // UTF-8 safe base64 URL encoding
  function encodePackToURL(questions: Question[]): string {
    try {
      const compact = questions.map(q => [q.textA, q.textB, q.iconA || '✨', q.iconB || '🔥']);
      const jsonStr = JSON.stringify(compact);
      const base64 = btoa(encodeURIComponent(jsonStr).replace(/%([0-9A-F]{2})/g, (_, p1) => String.fromCharCode(parseInt(p1, 16))));
      const url = new URL(window.location.href);
      url.searchParams.set('pack', base64);
      return url.toString();
    } catch {
      return window.location.href;
    }
  }

  function decodePackFromURL(base64Str: string): Question[] | null {
    try {
      const jsonStr = decodeURIComponent(Array.prototype.map.call(atob(base64Str), (c: string) => '%' + ('00' + c.charCodeAt(0).toString(16)).slice(-2)).join(''));
      const compact = JSON.parse(jsonStr);
      if (!Array.isArray(compact)) return null;
      return compact.map((item: any) => ({
        cat: 'custom',
        textA: String(item[0] || ''),
        textB: String(item[1] || ''),
        iconA: String(item[2] || '✨'),
        iconB: String(item[3] || '🔥'),
        ratioA: 50
      })).filter(q => q.textA.length > 0 && q.textB.length > 0);
    } catch (e) {
      console.error('Failed to decode pack from URL', e);
      return null;
    }
  }

  function showToast(msg: string) {
    if (!toastElem) return;
    toastElem.textContent = msg;
    toastElem.classList.remove('hidden');
    setTimeout(() => {
      toastElem.classList.add('hidden');
    }, 2800);
  }

  function getFilteredQuestions(): Question[] {
    if (currentCategory === 'all') return currentQuestions;
    return currentQuestions.filter(q => q.cat === currentCategory);
  }

  function updateCustomBadge() {
    const customCount = currentQuestions.filter(q => q.cat === 'custom').length;
    if (customQBadge) customQBadge.textContent = String(customCount);
    if (totalQCount) totalQCount.textContent = String(currentQuestions.length);
    if (shareUrlInput) shareUrlInput.value = encodePackToURL(currentQuestions);
  }

  function loadQuestion() {
    const list = getFilteredQuestions();
    if (list.length === 0) {
      if (textA) textA.textContent = '해당 카테고리에 질문이 없습니다.';
      if (textB) textB.textContent = '질문 관리를 열어 질문을 추가해보세요!';
      return;
    }
    const q = list[currentIndex % list.length];

    if (iconA) iconA.textContent = q.iconA;
    if (textA) textA.textContent = q.textA;
    if (iconB) iconB.textContent = q.iconB;
    if (textB) textB.textContent = q.textB;

    // Reset results view
    resultA?.classList.add('hidden');
    resultB?.classList.add('hidden');
    voteGauge?.classList.add('hidden');

    resetTimer();
  }

  function revealChoice(chosen: 'A' | 'B') {
    const list = getFilteredQuestions();
    if (list.length === 0) return;
    const q = list[currentIndex % list.length];

    const rA = q.ratioA;
    const rB = 100 - rA;

    if (pctA) pctA.textContent = `${rA}%`;
    if (pctB) pctB.textContent = `${rB}%`;

    resultA?.classList.remove('hidden');
    resultB?.classList.remove('hidden');

    if (voteGauge && gaugeFillA && gaugeFillB) {
      voteGauge.classList.remove('hidden');
      gaugeFillA.style.width = `${rA}%`;
      gaugeFillA.textContent = `A (${rA}%)`;
      gaugeFillB.style.width = `${rB}%`;
      gaugeFillB.textContent = `B (${rB}%)`;
    }

    clearInterval(timerInterval);
  }

  function nextQuestion() {
    const list = getFilteredQuestions();
    if (list.length === 0) return;
    currentIndex = (currentIndex + 1) % list.length;
    loadQuestion();
  }

  // Fisher-Yates Shuffle
  function shuffleQuestions() {
    for (let i = currentQuestions.length - 1; i > 0; i--) {
      const j = Math.floor(Math.random() * (i + 1));
      [currentQuestions[i], currentQuestions[j]] = [currentQuestions[j], currentQuestions[i]];
    }
    currentIndex = 0;
    loadQuestion();
    renderQuestionsList();
    showToast('🔀 질문 순서가 무작위로 섞였습니다!');
  }

  function resetTimer() {
    clearInterval(timerInterval);
    timeLeft = 30;
    if (timerText) timerText.textContent = String(timeLeft);

    timerInterval = setInterval(() => {
      timeLeft--;
      if (timerText) timerText.textContent = String(timeLeft);
      if (timeLeft <= 0) {
        clearInterval(timerInterval);
      }
    }, 1000);
  }

  // Render questions list inside modal
  function renderQuestionsList() {
    if (!questionsScrollList) return;
    questionsScrollList.innerHTML = '';
    currentQuestions.forEach((q, idx) => {
      const row = document.createElement('div');
      row.className = 'q-row';
      row.innerHTML = `
        <div class="q-text-box">
          <span>${q.iconA} ${q.textA}</span>
          <span class="q-vs">VS</span>
          <span>${q.iconB} ${q.textB}</span>
        </div>
        <button class="btn-del-q" data-idx="${idx}" title="삭제">🗑️</button>
      `;
      row.querySelector('.btn-del-q')?.addEventListener('click', () => {
        currentQuestions.splice(idx, 1);
        updateCustomBadge();
        renderQuestionsList();
        loadQuestion();
      });
      questionsScrollList.appendChild(row);
    });
    updateCustomBadge();
  }

  // Bulk parser (A vs B)
  function parseBulkText(text: string): Question[] {
    const lines = text.split('\n').map(l => l.trim()).filter(l => l.length > 0);
    const parsed: Question[] = [];

    for (const line of lines) {
      // Look for " vs " or " VS " or " / " or " 대 "
      const parts = line.split(/\s+(?:vs|VS|대|\/)\s+/);
      if (parts.length >= 2) {
        parsed.push({
          cat: 'custom',
          iconA: '✨',
          textA: parts[0].trim(),
          iconB: '🔥',
          textB: parts[1].trim(),
          ratioA: 50
        });
      }
    }
    return parsed;
  }

  // Saved packs in LocalStorage
  function getSavedPacks(): Record<string, Question[]> {
    try {
      return JSON.parse(localStorage.getItem('balance_saved_packs') || '{}');
    } catch {
      return {};
    }
  }

  function renderSavedPacks() {
    if (!savedPacksList) return;
    const packs = getSavedPacks();
    savedPacksList.innerHTML = '';

    const keys = Object.keys(packs);
    if (keys.length === 0) {
      savedPacksList.innerHTML = '<span style="color:#64748b; font-size:0.75rem;">저장된 세트가 없습니다.</span>';
      return;
    }

    keys.forEach(k => {
      const row = document.createElement('div');
      row.className = 'saved-pack-row';
      row.innerHTML = `
        <span>📁 <strong>${k}</strong> (${packs[k].length}개)</span>
        <div>
          <button class="pack-load-btn" data-key="${k}">불러오기</button>
          <button class="pack-del-btn" data-key="${k}">🗑️</button>
        </div>
      `;
      row.querySelector('.pack-load-btn')?.addEventListener('click', () => {
        currentQuestions = [...packs[k]];
        currentIndex = 0;
        updateCustomBadge();
        renderQuestionsList();
        loadQuestion();
        showToast(`📁 "${k}" 질문 세트가 로드되었습니다!`);
      });
      row.querySelector('.pack-del-btn')?.addEventListener('click', () => {
        delete packs[k];
        localStorage.setItem('balance_saved_packs', JSON.stringify(packs));
        renderSavedPacks();
      });
      savedPacksList.appendChild(row);
    });
  }

  // Event Listeners
  choiceABtn?.addEventListener('click', () => revealChoice('A'));
  choiceBBtn?.addEventListener('click', () => revealChoice('B'));
  nextBtn?.addEventListener('click', nextQuestion);
  shuffleBtn?.addEventListener('click', shuffleQuestions);
  modalShuffleBtn?.addEventListener('click', shuffleQuestions);

  catPills.forEach(pill => {
    pill.addEventListener('click', () => {
      catPills.forEach(p => p.classList.remove('active'));
      pill.classList.add('active');
      currentCategory = pill.getAttribute('data-cat') || 'all';
      currentIndex = 0;
      loadQuestion();
    });
  });

  // Modal open/close & tabs
  packManagerBtn?.addEventListener('click', () => {
    packModal?.classList.remove('hidden');
    renderQuestionsList();
    renderSavedPacks();
    if (shareUrlInput) shareUrlInput.value = encodePackToURL(currentQuestions);
  });

  closePackModalBtn?.addEventListener('click', () => packModal?.classList.add('hidden'));

  packTabBtns.forEach(tabBtn => {
    tabBtn.addEventListener('click', () => {
      packTabBtns.forEach(t => t.classList.remove('active'));
      tabBtn.classList.add('active');
      const target = tabBtn.getAttribute('data-tab');
      document.querySelectorAll('.tab-pane').forEach(p => p.classList.remove('active'));
      document.getElementById(`pane-${target}`)?.classList.add('active');
    });
  });

  // Reset to default questions
  resetDefaultBtn?.addEventListener('click', () => {
    if (confirm('기본 질문 목록으로 리셋하시겠습니까?')) {
      currentQuestions = [...DEFAULT_QUESTIONS];
      currentIndex = 0;
      updateCustomBadge();
      renderQuestionsList();
      loadQuestion();
      showToast('🔄 기본 질문으로 리셋되었습니다.');
    }
  });

  // Bulk add buttons
  bulkAppendBtn?.addEventListener('click', () => {
    if (!bulkTextarea) return;
    const parsed = parseBulkText(bulkTextarea.value);
    if (parsed.length === 0) {
      alert("'A vs B' 형식으로 최소 1개 이상의 질문을 입력해주세요.");
      return;
    }
    currentQuestions.push(...parsed);
    bulkTextarea.value = '';
    updateCustomBadge();
    renderQuestionsList();
    showToast(`➕ ${parsed.length}개 질문이 추가되었습니다!`);
  });

  bulkReplaceBtn?.addEventListener('click', () => {
    if (!bulkTextarea) return;
    const parsed = parseBulkText(bulkTextarea.value);
    if (parsed.length === 0) {
      alert("'A vs B' 형식으로 최소 1개 이상의 질문을 입력해주세요.");
      return;
    }
    if (confirm(`현재 질문 목록을 지우고 ${parsed.length}개 질문으로 전체 교체하시겠습니까?`)) {
      currentQuestions = [...parsed];
      currentIndex = 0;
      bulkTextarea.value = '';
      updateCustomBadge();
      renderQuestionsList();
      loadQuestion();
      showToast(`⚠️ 질문 목록이 ${parsed.length}개로 교체되었습니다!`);
    }
  });

  // Copy share URL
  copyShareUrlBtn?.addEventListener('click', () => {
    if (!shareUrlInput) return;
    shareUrlInput.select();
    navigator.clipboard.writeText(shareUrlInput.value).then(() => {
      copyFeedback?.classList.remove('hidden');
      setTimeout(() => copyFeedback?.classList.add('hidden'), 2500);
      showToast('🔗 공유 링크가 복사되었습니다!');
    });
  });

  // Save pack to LocalStorage
  savePackBtn?.addEventListener('click', () => {
    const name = savePackName?.value.trim();
    if (!name) {
      alert('세트 이름을 입력해주세요!');
      return;
    }
    const packs = getSavedPacks();
    packs[name] = [...currentQuestions];
    localStorage.setItem('balance_saved_packs', JSON.stringify(packs));
    if (savePackName) savePackName.value = '';
    renderSavedPacks();
    showToast(`💾 "${name}" 세트가 저장되었습니다!`);
  });

  // Keyboard Shortcuts: 1 (A), 2 (B), Space (Next)
  window.addEventListener('keydown', (e) => {
    if (packModal && !packModal.classList.contains('hidden')) return;

    if (e.key === '1') {
      revealChoice('A');
    } else if (e.key === '2') {
      revealChoice('B');
    } else if (e.code === 'Space') {
      e.preventDefault();
      nextQuestion();
    }
  });

  // Check URL on startup for shared pack
  const urlParams = new URLSearchParams(window.location.search);
  const sharedPack = urlParams.get('pack');
  if (sharedPack) {
    const decoded = decodePackFromURL(sharedPack);
    if (decoded && decoded.length > 0) {
      currentQuestions = decoded;
      currentIndex = 0;
      currentCategory = 'all';
      showToast(`✨ 공유받은 질문 세트 (${decoded.length}개 질문) 로드됨!`);
    }
  }

  updateCustomBadge();
  loadQuestion();
</script>
