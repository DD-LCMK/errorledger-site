---
import GameLayout from '../../layouts/GameLayout.astro';
import { getEntry } from 'astro:content';
import { getLang, t } from '../../i18n';

const lang = getLang(Astro.url);
const isEn = lang === 'en';

const gameEntry = await getEntry('games', 'stream-emoji');

const data = gameEntry?.data || {
  title: '스트림 이모지 (Stream Emoji)',
  tagline: '트위치·디스코드·치지직 맞춤형 멀티프레임 움직이는 이모티콘 제작기',
  description: '프레임 수(2~16F)를 자유롭게 설정하고 어니언 스킨으로 프레임별로 직접 그려 만드는 애니메이션 이모티콘 스튜디오. 픽셀 도트 펜, 페인트통, 1x 실제 채팅창 크기 미리보기와 디스코드/트위치 규격 최적화 GIF 내보내기를 무료로 즐겨보세요.',
  controls: [
    '하단 타임라인에서 [+] 프레임 추가, [❐] 복제, [🗑️] 삭제로 프레임 관리',
    '타임라인 프레임 썸네일을 클릭하여 해당 프레임으로 즉시 이동 후 드로잉',
    '[▶ 재생 / ⏸ 정지] (또는 Space 키)로 실시간 루프 애니메이션 재생',
    '[🧅 어니언 스킨] 버튼으로 이전/다음 프레임의 잔상을 보며 자연스러운 동작 잇기',
    '상단 규격 메뉴에서 112×112(트위치/치지직), 128×128(디스코드 이모지), 256×256(디스코드 스티커) 맞춤 크기 선택',
    '우측 상단 [✨ GIF 내보내기] 또는 [🎞️ 스프라이트시트 저장]으로 완성된 이모티콘 즉시 다운로드'
  ],
  rules: [
    '각 프레임은 독립된 캔버스 버퍼로 관리되며, 프레임별 실행 취소(Undo/Redo)가 완벽히 지원됩니다.',
    '어니언 스킨을 켜면 이전 프레임은 붉은 잔상, 다음 프레임은 푸른 잔상으로 은은하게 비쳐 보입니다.',
    '재생 중에는 실시간 FPS(1~24 FPS)에 맞춰 매끄러운 루프 프리뷰가 실행됩니다.',
    '우측 상단 실제 채팅창 크기(1x) 미니 위젯에서 실제 디스코드/치지직 채팅창에 입력되었을 때의 시각적 느낌을 실시간으로 확인할 수 있습니다.',
    '모든 데이터는 브라우저 내부에서만 처리되며 외부 서버로 그림이 업로드되지 않아 100% 안전합니다.'
  ],
  faqItems: [
    {
      q: '디스코드나 트위치, 치지직 구독자 이모티콘으로 바로 등록할 수 있나요?',
      a: '네! 상단에서 112×112(트위치/치지직) 또는 128×128(디스코드) 규격을 선택하고 제작한 뒤 [GIF 내보내기]를 누르면 규격과 투명 배경이 완벽히 유지된 최적화된 .gif 파일로 다운로드되어 바로 업로드할 수 있습니다.'
    },
    {
      q: '어니언 스킨(Onion Skin) 기능은 무엇인가요?',
      a: '애니메이션 제작 시 앞뒤 프레임의 그림을 반투명한 잔상으로 비춰주는 기능입니다. 손을 흔들거나 눈을 깜빡이는 등 연속된 동작을 그릴 때 이전 위치를 정확히 확인하며 그릴 수 있어 누구나 쉽게 생동감 넘치는 모션을 만들 수 있습니다.'
    },
    {
      q: '프레임 복제는 어떻게 활용하나요?',
      a: '타임라인에서 [❐ 복제]를 누르면 현재 프레임의 그림이 그대로 새 프레임으로 복사됩니다. 전체를 다시 그릴 필요 없이 입꼬리나 눈동자 위치만 살짝 수정하고 싶을 때 매우 유용합니다.'
    },
    {
      q: '스프라이트시트(Spritesheet) 내보내기는 무엇인가요?',
      a: '모든 프레임을 가로 한 줄의 투명 PNG 이미지로 이어 붙여 저장하는 기능입니다. 웹 개발이나 게임 엔진(Unity, Godot), OBS 브라우저 소스 등에서 스프라이트 애니메이션으로 활용할 때 유용합니다.'
    }
  ]
};
---

<GameLayout
  title={data.title}
  description={data.description}
  category="stream"
  badge={isEn ? "🎬 Studio" : "🎬 스튜디오"}
  icon="🎬"
  activeNav="games"
  hideStageHeader={true}
  guideToggleText={t(lang, 'game.guide.toggle')}
  tipsTitle={t(lang, 'game.tips.title')}
  faqTitle={t(lang, 'game.faq.title')}
  controls={data.controls}
  rules={data.rules}
  faqItems={data.faqItems}
>
  <div class="stream-emoji-wrapper" id="emoji-app">
    <!-- Top Utility Bar -->
    <header class="emoji-header-bar">
      <div class="header-left-group">
        <div class="brand-badge">
          <span class="brand-emoji">🎬</span>
          <span class="brand-title">스트림 이모지</span>
          <span class="brand-sub">애니메이션 스튜디오</span>
        </div>

        <!-- Cross-link to Stream Doodle -->
        <a href={isEn ? "/en/games/stream-doodle" : "/games/stream-doodle"} class="crosslink-pill" title="3프레임 손그림 라인보일 낙서장으로 전환">
          <span class="pill-icon">🎨</span>
          <span class="pill-text">{isEn ? "Stream Doodle (3F Boil) →" : "스트림 두들 (3F 손그림) ↗"}</span>
        </a>

        <!-- Canvas Preset Size Selector -->
        <div class="canvas-size-picker-wrap">
          <button type="button" class="size-dropdown-btn" id="canvas-size-btn" aria-haspopup="true" aria-expanded="false" title="이모티콘 캔버스 해상도 규격 선택">
            <span class="size-icon">📐</span>
            <span class="size-label" id="current-size-label">128×128 (디스코드)</span>
            <span class="dropdown-chevron">▼</span>
          </button>
          <div class="size-dropdown-menu" id="size-dropdown-menu" role="menu">
            <div class="dropdown-header">플랫폼 맞춤 이모티콘 규격</div>
            <button type="button" class="size-opt-btn" data-w="112" data-h="112" data-name="112×112 (트위치·치지직)">
              <span class="opt-badge twitch">CHZZK/TWITCH</span>
              <span class="opt-title">112 × 112 px</span>
              <span class="opt-desc">치지직 / 트위치 구독자 이모티콘 표준 규격</span>
            </button>
            <button type="button" class="size-opt-btn active" data-w="128" data-h="128" data-name="128×128 (디스코드)">
              <span class="opt-badge discord">DISCORD</span>
              <span class="opt-title">128 × 128 px</span>
              <span class="opt-desc">디스코드 움직이는 이모지 (Nitro) 표준 규격</span>
            </button>
            <button type="button" class="size-opt-btn" data-w="256" data-h="256" data-name="256×256 (디스코드 스티커)">
              <span class="opt-badge sticker">STICKER</span>
              <span class="opt-title">256 × 256 px</span>
              <span class="opt-desc">디스코드 서버 맞춤 스티커 규격</span>
            </button>
            <button type="button" class="size-opt-btn" data-w="64" data-h="64" data-name="64×64 (픽셀 도트)">
              <span class="opt-badge pixel">PIXEL ART</span>
              <span class="opt-title">64 × 64 px</span>
              <span class="opt-desc">레트로 픽셀 도트 그래픽 전용 캔버스</span>
            </button>
            <button type="button" class="size-opt-btn" data-w="320" data-h="320" data-name="320×320 (표준 HD)">
              <span class="opt-badge square">HD STUDIO</span>
              <span class="opt-title">320 × 320 px</span>
              <span class="opt-desc">고해상도 작업용 정사각 캔버스</span>
            </button>
          </div>
        </div>

        <!-- Background Mode Selector -->
        <div class="bg-mode-group">
          <button type="button" class="bg-pill active" data-bg="dark" title="다크 모드 배경">● 다크</button>
          <button type="button" class="bg-pill" data-bg="chroma" title="방송 크로마키 그린 배경">● 크로마키</button>
          <button type="button" class="bg-pill" data-bg="transparent" title="배경 투명 (GIF 투명도 적용)">▨ 투명</button>
        </div>
      </div>

      <div class="header-right-group">
        <!-- Undo / Redo -->
        <button type="button" class="tool-btn icon-btn" id="undo-btn" title="실행 취소 (Ctrl+Z)" disabled>
          <span class="icon">↩</span>
        </button>
        <button type="button" class="tool-btn icon-btn" id="redo-btn" title="다시 실행 (Ctrl+Y)" disabled>
          <span class="icon">↪</span>
        </button>

        <!-- Clear Current Frame -->
        <button type="button" class="tool-btn" id="clear-frame-btn" title="현재 프레임 그림 지우기">
          <span class="icon">🗑️</span> 현재 프레임 비우기
        </button>

        <!-- Export Buttons -->
        <button type="button" class="tool-btn" id="export-png-btn" title="현재 프레임 PNG로 저장">
          📷 PNG
        </button>
        <button type="button" class="tool-btn" id="export-sheet-btn" title="모든 프레임 가로 스프라이트시트 PNG로 저장">
          🎞️ 스프라이트시트
        </button>
        <button type="button" class="tool-btn export-btn" id="export-gif-btn" title="움직이는 애니메이션 GIF로 저장">
          <span class="export-sparkle">✨</span> GIF 내보내기
        </button>
      </div>
    </header>

    <!-- Main Workspace -->
    <div class="emoji-workspace">
      <!-- Left Sidebar: Brushes & Tool Settings -->
      <aside class="emoji-sidebar">
        <div class="sidebar-section-title">도구 (Tools)</div>
        <div class="brushes-list">
          <button type="button" class="brush-btn active" data-brush="pen" title="펜 (원형/사각 팁 지원)">
            <span class="brush-icon">🖊️</span>
            <span class="brush-name">펜</span>
          </button>
          <button type="button" class="brush-btn" data-brush="bucket" title="페인트통 (원클릭 영역 채우기)">
            <span class="brush-icon">🪣</span>
            <span class="brush-name">페인트통</span>
          </button>
          <button type="button" class="brush-btn" data-brush="pencil" title="연필 (거친 흑연 텍스처)">
            <span class="brush-icon">✏️</span>
            <span class="brush-name">연필</span>
          </button>
          <button type="button" class="brush-btn" data-brush="spray" title="스프레이 (도트 입자 뿌리기)">
            <span class="brush-icon">💨</span>
            <span class="brush-name">스프레이</span>
          </button>
          <button type="button" class="brush-btn special-brush" data-brush="rainbow" title="무지개 펜 (그릴 때마다 색상 변화)">
            <span class="brush-icon">🌈</span>
            <span class="brush-name">무지개</span>
          </button>
          <button type="button" class="brush-btn" data-brush="eraser" title="지우개 (투명하게 지우기)">
            <span class="brush-icon">🧼</span>
            <span class="brush-name">지우개</span>
          </button>
          <button type="button" class="brush-btn" data-brush="cutout" title="투명 오리기 (알파 홀 뚫기)">
            <span class="brush-icon">🕳️</span>
            <span class="brush-name">투명 오리기</span>
          </button>
        </div>

        <div class="sidebar-divider"></div>

        <!-- Active Tool Card -->
        <div class="sidebar-section-title">현재 도구 설정</div>
        <div class="active-tool-card" id="active-tool-card">
          <div class="tool-card-header">
            <span class="tool-card-icon" id="tool-card-icon">🖊️</span>
            <span class="tool-card-name" id="tool-card-name">펜</span>
          </div>

          <!-- Tip Shape Toggle -->
          <div class="sidebar-control-row" id="sidebar-tip-row">
            <span class="sidebar-control-label">팁 모양</span>
            <div class="tip-shape-toggle">
              <button type="button" class="tip-btn active" data-tip="round" title="원형 팁 (자연스러운 곡선)">● 원형</button>
              <button type="button" class="tip-btn" data-tip="square" title="사각 팁 (레트로 픽셀 아트 / 도트)">■ 사각</button>
            </div>
          </div>

          <!-- Brush Size Slider -->
          <div class="sidebar-control-row" id="sidebar-size-row">
            <div class="sidebar-label-val">
              <span class="sidebar-control-label">굵기</span>
              <span class="sidebar-control-val" id="sidebar-size-val">4px</span>
            </div>
            <input type="range" id="sidebar-size-slider" min="1" max="40" value="4" class="sidebar-slider" />
          </div>

          <!-- Brush Opacity Slider -->
          <div class="sidebar-control-row" id="sidebar-opacity-row">
            <div class="sidebar-label-val">
              <span class="sidebar-control-label">투명도</span>
              <span class="sidebar-control-val" id="sidebar-opacity-val">100%</span>
            </div>
            <input type="range" id="sidebar-opacity-slider" min="10" max="100" value="100" class="sidebar-slider" />
          </div>

          <!-- Color Swatch & RGB Picker -->
          <div class="sidebar-control-row" id="sidebar-color-row">
            <div class="sidebar-label-val">
              <span class="sidebar-control-label">색상</span>
              <span class="sidebar-control-val" id="sidebar-color-hex">#FF0055</span>
            </div>
            <div class="sidebar-color-swatch-wrap">
              <label class="sidebar-color-swatch" id="sidebar-swatch-label" title="RGB 컬러 피커 열기">
                <input type="color" id="sidebar-color-input" value="#FF0055" />
              </label>
              <span class="sidebar-color-note">클릭하여 RGB 선택</span>
            </div>
          </div>
        </div>

        <div class="sidebar-divider"></div>

        <!-- Symmetry Section -->
        <div class="sidebar-section-title">대칭 그리기</div>
        <div class="symmetry-grid">
          <button type="button" class="sym-btn" id="sym-h-btn" title="좌우 수평 대칭">
            <span class="sym-icon">🪞</span>
            <span class="sym-label">좌우</span>
          </button>
          <button type="button" class="sym-btn" id="sym-v-btn" title="상하 수직 대칭">
            <span class="sym-icon">🔃</span>
            <span class="sym-label">상하</span>
          </button>
          <button type="button" class="sym-btn" id="sym-quad-btn" title="4방향 만다라 대칭">
            <span class="sym-icon">💠</span>
            <span class="sym-label">4방향</span>
          </button>
        </div>

        <div class="sidebar-divider"></div>

        <!-- Photo Underlay Section -->
        <div class="photo-import-wrap">
          <label class="photo-btn" for="photo-file-input" title="참조 사진을 캔버스 아래에 불러와 트레이싱">
            <span class="btn-icon">🖼️</span> 사진 덧그리기
            <input type="file" id="photo-file-input" accept="image/*" class="sr-only" />
          </label>
          <button type="button" class="photo-remove-btn" id="remove-photo-btn" title="불러온 사진 레이어 제거" style="display: none;">
            ✕ 사진 제거
          </button>
        </div>
      </aside>

      <!-- Center Drawing Area -->
      <main class="emoji-canvas-viewport" id="canvas-viewport">
        <!-- Floating Photo Remove Badge -->
        <div class="photo-overlay-badge" id="photo-overlay-badge" style="display: none;">
          <span class="photo-badge-icon">🖼️</span>
          <span>사진 레이어</span>
          <button type="button" class="photo-overlay-remove-btn" id="photo-overlay-remove-btn" title="사진 레이어 제거">✕ 제거</button>
        </div>

        <!-- Canvas Container with Zoom Transform -->
        <div class="canvas-frame-container" id="canvas-frame">
          <!-- Onion Skin Overlays -->
          <canvas id="onion-prev-canvas" class="onion-canvas prev"></canvas>
          <canvas id="onion-next-canvas" class="onion-canvas next"></canvas>
          <!-- Active Drawing Canvas -->
          <canvas id="emoji-canvas" class="main-drawing-canvas"></canvas>
          <!-- Brush Cursor Indicator -->
          <div id="brush-cursor" class="brush-cursor-indicator"></div>
        </div>

        <!-- Floating 1x Mini Emote Chat Preview Widget -->
        <div class="mini-emote-widget" id="mini-emote-widget" title="실제 채팅창 크기 1x 실시간 루프 프리뷰">
          <div class="widget-header">
            <span class="widget-title">💬 채팅 1x 프리뷰</span>
            <div class="widget-scale-toggles">
              <button type="button" class="scale-toggle active" data-scale="112">112p</button>
              <button type="button" class="scale-toggle" data-scale="48">48p</button>
              <button type="button" class="scale-toggle" data-scale="32">32p</button>
            </div>
          </div>
          <div class="chat-preview-box">
            <div class="chat-msg">
              <div class="chat-avatar">🐱</div>
              <div class="chat-content">
                <span class="chat-user">Viewer</span>
                <div class="chat-bubble">
                  <span>이모지 귀여워요!</span>
                  <canvas id="mini-preview-canvas" width="112" height="112" class="mini-preview-canvas"></canvas>
                </div>
              </div>
            </div>
          </div>
        </div>

        <!-- Floating Zoom & Pan Controls -->
        <div class="zoom-floating-controls" id="zoom-controls">
          <button type="button" class="zoom-btn" id="zoom-out-btn" title="축소 (Ctrl + 휠 아래)">−</button>
          <button type="button" class="zoom-level-btn" id="zoom-reset-btn" title="100% 초기화">
            <span id="zoom-level-text">100%</span>
          </button>
          <button type="button" class="zoom-btn" id="zoom-in-btn" title="확대 (Ctrl + 휠 위)">+</button>
          <button type="button" class="zoom-btn" id="zoom-fit-btn" title="화면에 맞추기">⛶</button>
          <button type="button" class="zoom-btn pan-toggle-btn" id="pan-toggle-btn" title="화면 이동 손도구 (Space 누른 채 드래그)">✋</button>
        </div>
      </main>
    </div>

    <!-- Bottom Dock: Color Palette & Multi-Frame Timeline -->
    <footer class="emoji-bottom-dock">
      <!-- Row 1: Color Palette Bar -->
      <div class="emoji-palette-bar">
        <div class="color-picker-group">
          <label class="custom-color-swatch" id="custom-swatch-label" title="RGB 컬러 피커">
            <input type="color" id="custom-color-input" value="#FF0055" />
          </label>
          <span class="custom-hex-label" id="custom-hex-label">#FF0055</span>
        </div>

        <div class="palette-swatches" id="palette-swatches">
          <!-- Curated 16 Neon & Retro Colors -->
        </div>

        <div class="palette-divider"></div>

        <!-- Quick Brush Controls -->
        <div class="quick-brush-controls">
          <div class="size-control-group">
            <span class="control-label" id="palette-size-label">굵기</span>
            <input type="range" id="brush-size-slider" min="1" max="40" value="4" class="quick-slider" />
            <span class="control-val" id="brush-size-val">4</span>
