<script>
  // ── Types & Palettes ──
  interface PaletteColor {
    rgb: [number, number, number];
    hex: string;
    alpha?: number;
  }

  const PALETTE: PaletteColor[] = [
    { rgb: [0, 0, 0],       hex: '#000000' }, // 0: Transparent background
    { rgb: [255, 255, 255], hex: '#FFFFFF' }, // 1: White
    { rgb: [255, 0, 85],    hex: '#FF0055' }, // 2: Neon Red/Pink
    { rgb: [255, 102, 0],   hex: '#FF6600' }, // 3: Orange
    { rgb: [255, 230, 0],   hex: '#FFE600' }, // 4: Yellow
    { rgb: [0, 255, 102],   hex: '#00FF66' }, // 5: Neon Green
    { rgb: [0, 234, 200],   hex: '#00EAC8' }, // 6: Cyan
    { rgb: [0, 153, 255],   hex: '#0099FF' }, // 7: Blue
    { rgb: [153, 51, 255],  hex: '#9933FF' }, // 8: Purple
    { rgb: [255, 0, 204],   hex: '#FF00CC' }, // 9: Magenta
    { rgb: [255, 179, 209], hex: '#FFB3D1' }, // 10: Pastel Pink
    { rgb: [204, 255, 204], hex: '#CCFFCC' }, // 11: Pastel Green
    { rgb: [204, 230, 255], hex: '#CCE6FF' }, // 12: Pastel Blue
    { rgb: [136, 136, 136], hex: '#888888' }, // 13: Gray
    { rgb: [102, 51, 0],    hex: '#663300' }, // 14: Brown
    { rgb: [255, 218, 185], hex: '#FFDAB9' }  // 15: Skin Tone
  ];

  // ── LZW GIF89a ENCODER ──
  function encodeGif89a(
    framesPixels: Uint8Array[],
    width: number,
    height: number,
    paletteRgb: number[][],
    transparentIdx: number = -1,
    delayHundredths: number = 8
  ): Uint8Array {
    const bytes: number[] = [];
    const writeByte = (b: number) => bytes.push(b & 0xff);
    const writeWord = (w: number) => {
      writeByte(w & 0xff);
      writeByte((w >> 8) & 0xff);
    };
    const writeString = (s: string) => {
      for (let i = 0; i < s.length; i++) writeByte(s.charCodeAt(i));
    };

    writeString("GIF89a");
    writeWord(width);
    writeWord(height);

    const palSize = Math.max(2, 2 ** Math.ceil(Math.log2(paletteRgb.length)));
    const colorRes = Math.log2(palSize) - 1;
    writeByte(0x80 | (colorRes << 4) | colorRes);
    writeByte(0);
    writeByte(0);

    for (let i = 0; i < palSize; i++) {
      if (i < paletteRgb.length) {
        writeByte(paletteRgb[i][0]);
        writeByte(paletteRgb[i][1]);
        writeByte(paletteRgb[i][2]);
      } else {
        writeByte(0); writeByte(0); writeByte(0);
      }
    }

    // Netscape 2.0 Loop Block
    writeByte(0x21);
    writeByte(0xff);
    writeByte(11);
    writeString("NETSCAPE2.0");
    writeByte(3);
    writeByte(1);
    writeWord(0); // Loop forever
    writeByte(0);

    function lzwEncode(pixels: Uint8Array, minCodeSize: number): number[] {
      const out: number[] = [];
      let curBit = 0;
      let curByte = 0;

      const emitBit = (bit: number) => {
        if (bit) curByte |= (1 << curBit);
        curBit++;
        if (curBit === 8) {
          blockBuffer.push(curByte);
          curByte = 0;
          curBit = 0;
          if (blockBuffer.length === 254) flushBlock();
        }
      };

      const emitBits = (val: number, bits: number) => {
        for (let b = 0; b < bits; b++) emitBit((val >> b) & 1);
      };

      let blockBuffer: number[] = [];
      const flushBlock = () => {
        if (blockBuffer.length > 0) {
          out.push(blockBuffer.length);
          for (let b = 0; b < blockBuffer.length; b++) out.push(blockBuffer[b]);
          blockBuffer = [];
        }
      };

      const clearCode = 1 << minCodeSize;
      const eoiCode = clearCode + 1;
      let codeSize = minCodeSize + 1;
      let nextCode = eoiCode + 1;
      let dict = new Map<string, number>();

      const resetDict = () => {
        dict.clear();
        codeSize = minCodeSize + 1;
        nextCode = eoiCode + 1;
      };

      emitBits(clearCode, codeSize);
      let s = "";

      for (let i = 0; i < pixels.length; i++) {
        const c = String.fromCharCode(pixels[i]);
        const sc = s + c;
        if (dict.has(sc) || (s === "" && sc.charCodeAt(0) < clearCode)) {
          s = sc;
        } else {
          const emitCode = s.length === 1 ? s.charCodeAt(0) : (dict.get(s) ?? 0);
          emitBits(emitCode, codeSize);

          if (nextCode < 4096) {
            dict.set(sc, nextCode++);
            if (nextCode > (1 << codeSize) && codeSize < 12) codeSize++;
          } else {
            emitBits(clearCode, codeSize);
            resetDict();
          }
          s = c;
        }
      }

      if (s.length > 0) {
        const emitCode = s.length === 1 ? s.charCodeAt(0) : (dict.get(s) ?? 0);
        emitBits(emitCode, codeSize);
      }

      emitBits(eoiCode, codeSize);
      if (curBit > 0) blockBuffer.push(curByte);
      flushBlock();
      out.push(0);
      return out;
    }

    const minCode = Math.max(2, Math.ceil(Math.log2(palSize)));

    for (let f = 0; f < framesPixels.length; f++) {
      writeByte(0x21); // Extension Introducer
      writeByte(0xf9); // Graphic Control Extension
      writeByte(4);    // Byte size
      const hasAlpha = transparentIdx >= 0;
      writeByte(hasAlpha ? 0x09 : 0x08); // Disposal: Restore to background (0x08) + Transparency flag
      writeWord(delayHundredths);
      writeByte(hasAlpha ? transparentIdx : 0);
      writeByte(0);

      writeByte(0x2c); // Image Descriptor
      writeWord(0); writeWord(0);
      writeWord(width); writeWord(height);
      writeByte(0);

      writeByte(minCode);
      const lzwData = lzwEncode(framesPixels[f], minCode);
      for (let b = 0; b < lzwData.length; b++) bytes.push(lzwData[b]);
    }

    writeByte(0x3b); // Trailer
    return new Uint8Array(bytes);
  }

  // ── Multi-Frame Engine (`StreamEmojiEngine`) ──
  class StreamEmojiEngine {
    public width: number = 128;
    public height: number = 128;
    public fps: number = 8;
    public isPlaying: boolean = false;
    public onionSkin: boolean = true;
    public onionOpacity: number = 0.35;

    public frames: Uint8Array[] = [];
    public activeFrameIndex: number = 0;
    public currentPlayFrame: number = 0;

    public paletteTable: PaletteColor[] = [];
    public activeColorIndex: number = 2; // Default Neon Red
    public activeBrush: string = 'pen';
    public tipShape: 'round' | 'square' = 'round';
    public brushSize: number = 4;
    public brushOpacity: number = 1.0;
    public bgMode: 'dark' | 'chroma' | 'transparent' = 'dark';
    public symmetryMode: 'none' | 'h' | 'v' | 'quad' = 'none';

    public undoStacks: Uint8Array[][] = [];
    public redoStacks: Uint8Array[][] = [];

    public photoCanvas: HTMLCanvasElement | null = null;
    public photoOpacity: number = 0.5;

    private playTimer: number = 0;
    private lastFrameTime: number = 0;

    constructor(w = 128, h = 128) {
      this.width = w;
      this.height = h;
      this.resetPalette();
      this.initFrames(4); // Default 4-frame walk/bob animation
    }

    public resetPalette() {
      this.paletteTable = PALETTE.map(c => ({ rgb: [...c.rgb], hex: c.hex, alpha: 255 }));
    }

    public initFrames(count: number) {
      this.frames = [];
      this.undoStacks = [];
      this.redoStacks = [];
      for (let i = 0; i < count; i++) {
        this.frames.push(new Uint8Array(this.width * this.height));
        this.undoStacks.push([]);
        this.redoStacks.push([]);
      }
      this.activeFrameIndex = 0;
      this.currentPlayFrame = 0;
    }

    public resize(w: number, h: number) {
      this.width = w;
      this.height = h;
      for (let i = 0; i < this.frames.length; i++) {
        this.frames[i] = new Uint8Array(w * h);
        this.undoStacks[i] = [];
        this.redoStacks[i] = [];
      }
    }

    public addFrame(): number {
      if (this.frames.length >= 16) return this.activeFrameIndex;
      this.saveUndo();
      const newFrame = new Uint8Array(this.width * this.height);
      this.frames.splice(this.activeFrameIndex + 1, 0, newFrame);
      this.undoStacks.splice(this.activeFrameIndex + 1, 0, []);
      this.redoStacks.splice(this.activeFrameIndex + 1, 0, []);
      this.activeFrameIndex++;
      return this.activeFrameIndex;
    }

    public duplicateFrame(): number {
      if (this.frames.length >= 16) return this.activeFrameIndex;
      this.saveUndo();
      const cur = this.frames[this.activeFrameIndex];
      const dup = new Uint8Array(cur.length);
      dup.set(cur);
      this.frames.splice(this.activeFrameIndex + 1, 0, dup);
      this.undoStacks.splice(this.activeFrameIndex + 1, 0, []);
      this.redoStacks.splice(this.activeFrameIndex + 1, 0, []);
      this.activeFrameIndex++;
      return this.activeFrameIndex;
    }

    public deleteFrame(): boolean {
      if (this.frames.length <= 2) return false;
      this.frames.splice(this.activeFrameIndex, 1);
      this.undoStacks.splice(this.activeFrameIndex, 1);
      this.redoStacks.splice(this.activeFrameIndex, 1);
      if (this.activeFrameIndex >= this.frames.length) {
        this.activeFrameIndex = this.frames.length - 1;
      }
      return true;
    }

    public clearActiveFrame() {
      this.saveUndo();
      this.frames[this.activeFrameIndex].fill(0);
    }

    public saveUndo() {
      const cur = this.frames[this.activeFrameIndex];
      const stack = this.undoStacks[this.activeFrameIndex];
      if (stack.length >= 24) stack.shift();
      const snapshot = new Uint8Array(cur.length);
      snapshot.set(cur);
      stack.push(snapshot);
      this.redoStacks[this.activeFrameIndex] = [];
    }

    public undo(): boolean {
      const stack = this.undoStacks[this.activeFrameIndex];
      if (!stack || stack.length === 0) return false;
      const cur = this.frames[this.activeFrameIndex];
      const prev = stack.pop()!;
      const rStack = this.redoStacks[this.activeFrameIndex];
      const currentSnap = new Uint8Array(cur.length);
      currentSnap.set(cur);
      rStack.push(currentSnap);
      cur.set(prev);
      return true;
    }

    public redo(): boolean {
      const rStack = this.redoStacks[this.activeFrameIndex];
      if (!rStack || rStack.length === 0) return false;
      const cur = this.frames[this.activeFrameIndex];
      const next = rStack.pop()!;
      const uStack = this.undoStacks[this.activeFrameIndex];
      const currentSnap = new Uint8Array(cur.length);
      currentSnap.set(cur);
      uStack.push(currentSnap);
      cur.set(next);
      return true;
    }

    public getOrCreateColorIndex(rgb: [number, number, number], alpha: number = 255): number {
      const match = this.paletteTable.findIndex(p => 
        p.rgb[0] === rgb[0] && p.rgb[1] === rgb[1] && p.rgb[2] === rgb[2] && (p.alpha ?? 255) === alpha
      );
      if (match !== -1) return match;
      if (this.paletteTable.length < 255) {
        const hex = `#${((1 << 24) + (rgb[0] << 16) + (rgb[1] << 8) + rgb[2]).toString(16).slice(1).toUpperCase()}`;
        this.paletteTable.push({ rgb: [...rgb], hex, alpha });
        return this.paletteTable.length - 1;
      }
      return 2; // fallback
    }

    // ── Drawing Operations ──
    public drawStroke(x0: number, y0: number, x1: number, y1: number, isInitial: boolean = false) {
      if (isInitial) this.saveUndo();
      const frame = this.frames[this.activeFrameIndex];
      const bKey = this.activeBrush;
      const size = Math.max(1, this.brushSize);
      const isSquare = this.tipShape === 'square';
      const opacity = this.brushOpacity;

      const points = this.getSymmetryPoints(x0, y0, x1, y1);
      for (const [sx0, sy0, sx1, sy1] of points) {
        if (bKey === 'spray') {
          this.drawSpray(frame, sx1, sy1, size);
        } else if (bKey === 'cutout' || bKey === 'eraser') {
          this.drawLineSegment(frame, sx0, sy0, sx1, sy1, 0, size, isSquare);
        } else if (bKey === 'rainbow') {
          const shiftRgb = this.getRainbowColor();
          const colorIdx = this.getOrCreateColorIndex(shiftRgb, Math.round(opacity * 255));
          this.drawLineSegment(frame, sx0, sy0, sx1, sy1, colorIdx, size, isSquare);
        } else {
          // Pen or Pencil
          let cIdx = this.activeColorIndex;
          if (opacity < 0.99) {
            const curP = this.paletteTable[cIdx] || PALETTE[2];
            cIdx = this.getOrCreateColorIndex(curP.rgb, Math.round(opacity * 255));
          }
          this.drawLineSegment(frame, sx0, sy0, sx1, sy1, cIdx, size, isSquare);
        }
      }
    }

    private drawLineSegment(
      frame: Uint8Array,
      x0: number, y0: number, x1: number, y1: number,
      colorIdx: number, size: number, isSquare: boolean
    ) {
      const dx = Math.abs(x1 - x0);
      const dy = Math.abs(y1 - y0);
      const sx = x0 < x1 ? 1 : -1;
      const sy = y0 < y1 ? 1 : -1;
      let err = dx - dy;
      let cx = x0;
      let cy = y0;
      const rad = Math.floor(size / 2);

      while (true) {
        this.stamp(frame, cx, cy, rad, colorIdx, isSquare);
        if (cx === x1 && cy === y1) break;
        const e2 = 2 * err;
        if (e2 > -dy) { err -= dy; cx += sx; }
        if (e2 < dx) { err += dx; cy += sy; }
      }
    }

    private stamp(frame: Uint8Array, cx: number, cy: number, r: number, colorIdx: number, isSquare: boolean) {
      const w = this.width;
      const h = this.height;
      const minX = Math.max(0, cx - r);
      const maxX = Math.min(w - 1, cx + r);
      const minY = Math.max(0, cy - r);
      const maxY = Math.min(h - 1, cy + r);

      for (let y = minY; y <= maxY; y++) {
        for (let x = minX; x <= maxX; x++) {
          if (!isSquare && (x - cx) ** 2 + (y - cy) ** 2 > r * r + 0.5) continue;
          frame[y * w + x] = colorIdx;
        }
      }
    }

    private drawSpray(frame: Uint8Array, cx: number, cy: number, size: number) {
      const w = this.width;
      const h = this.height;
      const r = Math.max(2, size * 2);
      const count = Math.max(4, Math.floor(r * 2.5));
      const cIdx = this.activeColorIndex;

      for (let i = 0; i < count; i++) {
        const angle = Math.random() * Math.PI * 2;
        const dist = Math.random() * r;
        const px = Math.round(cx + Math.cos(angle) * dist);
        const py = Math.round(cy + Math.sin(angle) * dist);
        if (px >= 0 && px < w && py >= 0 && py < h) {
          frame[py * w + px] = cIdx;
        }
      }
    }

    public floodFill(startX: number, startY: number) {
      this.saveUndo();
      const w = this.width;
      const h = this.height;
      const frame = this.frames[this.activeFrameIndex];
      if (startX < 0 || startX >= w || startY < 0 || startY >= h) return;

      const targetIdx = frame[startY * w + startX];
      const fillIdx = this.activeColorIndex;
      if (targetIdx === fillIdx) return;

      const queue: number[] = [startX, startY];
      const visited = new Uint8Array(w * h);
      visited[startY * w + startX] = 1;

      while (queue.length > 0) {
        const cy = queue.pop()!;
        const cx = queue.pop()!;
        frame[cy * w + cx] = fillIdx;

        const neighbors = [
          [cx + 1, cy], [cx - 1, cy],
          [cx, cy + 1], [cx, cy - 1]
        ];
        for (let n = 0; n < neighbors.length; n++) {
          const nx = neighbors[n][0];
          const ny = neighbors[n][1];
          if (nx >= 0 && nx < w && ny >= 0 && ny < h) {
            const p = ny * w + nx;
            if (!visited[p] && frame[p] === targetIdx) {
              visited[p] = 1;
              queue.push(nx, ny);
            }
          }
        }
      }
    }

    private getSymmetryPoints(x0: number, y0: number, x1: number, y1: number): [number, number, number, number][] {
      const mode = this.symmetryMode;
      if (mode === 'none') return [[x0, y0, x1, y1]];
      const w = this.width;
      const h = this.height;
      const res: [number, number, number, number][] = [[x0, y0, x1, y1]];

      if (mode === 'h' || mode === 'quad') {
        res.push([w - 1 - x0, y0, w - 1 - x1, y1]);
      }
      if (mode === 'v' || mode === 'quad') {
        res.push([x0, h - 1 - y0, x1, h - 1 - y1]);
      }
      if (mode === 'quad') {
        res.push([w - 1 - x0, h - 1 - y0, w - 1 - x1, h - 1 - y1]);
      }
      return res;
    }

    private rainbowHue: number = 0;
    private getRainbowColor(): [number, number, number] {
      this.rainbowHue = (this.rainbowHue + 12) % 360;
      const h = this.rainbowHue / 60;
      const c = 255;
      const x = Math.round(c * (1 - Math.abs((h % 2) - 1)));
      if (h < 1) return [c, x, 0];
      if (h < 2) return [x, c, 0];
      if (h < 3) return [0, c, x];
      if (h < 4) return [0, x, c];
      if (h < 5) return [x, 0, c];
      return [c, 0, x];
    }

    // ── Exporters ──
    public generateGif(): Blob {
      const bgRgb: [number, number, number] = this.bgMode === 'chroma'
        ? [0, 255, 0]
        : this.bgMode === 'transparent'
          ? [0, 0, 0]
          : [15, 23, 42];

      const palList: number[][] = this.paletteTable.map(p => [...p.rgb]);
      const transIdx = this.bgMode === 'transparent' ? 0 : -1;
      const delay = Math.max(2, Math.round(100 / this.fps));

      const processedFrames: Uint8Array[] = this.frames.map(f => {
        const copy = new Uint8Array(f.length);
        copy.set(f);
        return copy;
      });

      const gifBytes = encodeGif89a(processedFrames, this.width, this.height, palList, transIdx, delay);
      return new Blob([gifBytes.buffer as ArrayBuffer], { type: 'image/gif' });
    }

    public generateSpritesheet(): Promise<Blob> {
      return new Promise((resolve, reject) => {
        const sheetCanvas = document.createElement('canvas');
        sheetCanvas.width = this.width * this.frames.length;
        sheetCanvas.height = this.height;
        const ctx = sheetCanvas.getContext('2d');
        if (!ctx) return reject('No 2d context');

        for (let f = 0; f < this.frames.length; f++) {
          const fCanvas = document.createElement('canvas');
          fCanvas.width = this.width;
          fCanvas.height = this.height;
          const fCtx = fCanvas.getContext('2d')!;
          const imgData = fCtx.createImageData(this.width, this.height);
          const frame = this.frames[f];

          for (let i = 0; i < frame.length; i++) {
            const idx = frame[i];
            const p = i * 4;
            if (idx === 0) {
              imgData.data[p + 3] = 0;
            } else {
              const col = this.paletteTable[idx] || PALETTE[2];
              imgData.data[p] = col.rgb[0];
              imgData.data[p + 1] = col.rgb[1];
              imgData.data[p + 2] = col.rgb[2];
              imgData.data[p + 3] = col.alpha ?? 255;
            }
          }
          fCtx.putImageData(imgData, 0, 0);
          ctx.drawImage(fCanvas, f * this.width, 0);
        }

        sheetCanvas.toBlob(blob => {
          if (blob) resolve(blob);
          else reject('Blob generation failed');
        }, 'image/png');
      });
    }

    public generatePng(): Promise<Blob> {
      return new Promise((resolve, reject) => {
        const c = document.createElement('canvas');
        c.width = this.width;
        c.height = this.height;
        const ctx = c.getContext('2d');
        if (!ctx) return reject('No context');
        const imgData = ctx.createImageData(this.width, this.height);
        const frame = this.frames[this.activeFrameIndex];

        for (let i = 0; i < frame.length; i++) {
          const idx = frame[i];
          const p = i * 4;
          if (idx === 0) {
            imgData.data[p + 3] = 0;
          } else {
            const col = this.paletteTable[idx] || PALETTE[2];
            imgData.data[p] = col.rgb[0];
            imgData.data[p + 1] = col.rgb[1];
            imgData.data[p + 2] = col.rgb[2];
            imgData.data[p + 3] = col.alpha ?? 255;
          }
        }
        ctx.putImageData(imgData, 0, 0);
        c.toBlob(blob => {
          if (blob) resolve(blob);
          else reject('Blob failed');
        }, 'image/png');
      });
    }

    // ── Built-in Presets ──
    public loadPreset(name: string) {
      this.initFrames(4);
      const w = this.width;
      const h = this.height;
      const cx = Math.floor(w / 2);
      const cy = Math.floor(h / 2);

      if (name === 'blink') {
        // Blinking Cat Face across 4 frames
        for (let f = 0; f < 4; f++) {
          const frame = this.frames[f];
          // Head outline (Yellow)
          const cYel = 4;
          const r = Math.floor(w * 0.35);
          for (let a = 0; a < 360; a += 2) {
            const rad = a * Math.PI / 180;
            const px = Math.round(cx + Math.cos(rad) * r);
            const py = Math.round(cy + Math.sin(rad) * r);
            if (px >= 0 && px < w && py >= 0 && py < h) frame[py * w + px] = cYel;
          }
          // Ears
          for (let d = 0; d < 20; d++) {
            const lx = cx - r + d;
            const ly = cy - r + d * 0.7;
            const rx = cx + r - d;
            const ry = cy - r + d * 0.7;
            if (lx >= 0 && lx < w && ly >= 0 && ly < h) frame[Math.floor(ly) * w + Math.floor(lx)] = cYel;
            if (rx >= 0 && rx < w && ry >= 0 && ry < h) frame[Math.floor(ry) * w + Math.floor(rx)] = cYel;
          }
          // Eyes: Frame 2 is closed blink!
          const eyeY = cy - 4;
          const isBlink = f === 2;
          if (isBlink) {
            // Closed horizontal slits
            for (let dx = -8; dx <= -2; dx++) frame[eyeY * w + (cx + dx)] = 1;
            for (let dx = 2; dx <= 8; dx++) frame[eyeY * w + (cx + dx)] = 1;
          } else {
            // Open circle eyes
            for (let dy = -3; dy <= 3; dy++) {
              for (let dx = -3; dx <= 3; dx++) {
                if (dx * dx + dy * dy <= 9) {
                  frame[(eyeY + dy) * w + (cx - 6 + dx)] = 6; // Cyan eye
                  frame[(eyeY + dy) * w + (cx + 6 + dx)] = 6;
                }
              }
            }
          }
          // Smile
          const mouthY = cy + 10;
          for (let mx = -6; mx <= 6; mx++) {
            const my = mouthY + Math.abs(mx) * 0.3;
            frame[Math.floor(my) * w + (cx + mx)] = 2; // Pink smile
          }
        }
      } else if (name === 'wave') {
        // Waving Hand across 4 frames
        for (let f = 0; f < 4; f++) {
          const frame = this.frames[f];
          const angle = [-15, 0, 15, 0][f] * Math.PI / 180;
          const armLen = Math.floor(w * 0.38);
          // Draw waving stick arm + round hand
          for (let step = 0; step < armLen; step++) {
            const px = Math.round(cx + Math.sin(angle) * step);
            const py = Math.round(cy + armLen / 2 - Math.cos(angle) * step);
            if (px >= 0 && px < w && py >= 0 && py < h) {
              frame[py * w + px] = 5; // Neon green arm
            }
          }
          const hx = Math.round(cx + Math.sin(angle) * armLen);
          const hy = Math.round(cy + armLen / 2 - Math.cos(angle) * armLen);
          this.stamp(frame, hx, hy, 6, 2, false); // Pink palm
        }
      } else if (name === 'heart') {
        // Beating Heart Bounce across 4 frames
        const scales = [0.8, 1.15, 0.95, 1.05];
        for (let f = 0; f < 4; f++) {
          const frame = this.frames[f];
          const sc = scales[f];
          const r = Math.floor(w * 0.22 * sc);
          // Draw heart using parametric formula
          for (let t = 0; t < Math.PI * 2; t += 0.05) {
            const hx = cx + Math.round(sc * 16 * Math.sin(t) ** 3 * (w / 40));
            const hy = cy - Math.round(sc * (13 * Math.cos(t) - 5 * Math.cos(2*t) - 2 * Math.cos(3*t) - Math.cos(4*t)) * (h / 40));
            this.stamp(frame, hx, hy, Math.max(1, Math.floor(2 * sc)), 2, false);
          }
        }
      }
    }
  }

  // ── Web Audio Sound Engine ──
  class EmojiAudio {
    private ctx: AudioContext | null = null;
    public muted: boolean = false;

    private getContext(): AudioContext {
      if (!this.ctx) {
        this.ctx = new (window.AudioContext || (window as any).webkitAudioContext)();
      }
      if (this.ctx.state === 'suspended') this.ctx.resume();
      return this.ctx;
    }

    public playBlip(freq: number = 440) {
      if (this.muted) return;
      try {
        const c = this.getContext();
        const osc = c.createOscillator();
        const g = c.createGain();
        osc.type = 'sine';
        osc.frequency.setValueAtTime(freq, c.currentTime);
        g.gain.setValueAtTime(0.05, c.currentTime);
        g.gain.exponentialRampToValueAtTime(0.001, c.currentTime + 0.08);
        osc.connect(g);
        g.connect(c.destination);
        osc.start();
        osc.stop(c.currentTime + 0.08);
      } catch {}
    }

    public playSquareBlip() {
      if (this.muted) return;
      try {
        const c = this.getContext();
        const osc = c.createOscillator();
        const g = c.createGain();
        osc.type = 'square';
        osc.frequency.setValueAtTime(320, c.currentTime);
        g.gain.setValueAtTime(0.03, c.currentTime);
        g.gain.exponentialRampToValueAtTime(0.001, c.currentTime + 0.05);
        osc.connect(g);
        g.connect(c.destination);
        osc.start();
        osc.stop(c.currentTime + 0.05);
      } catch {}
    }

    public playBucket() {
      if (this.muted) return;
      try {
        const c = this.getContext();
        const osc = c.createOscillator();
        const g = c.createGain();
        osc.type = 'triangle';
        osc.frequency.setValueAtTime(180, c.currentTime);
        osc.frequency.exponentialRampToValueAtTime(520, c.currentTime + 0.12);
        g.gain.setValueAtTime(0.08, c.currentTime);
        g.gain.exponentialRampToValueAtTime(0.001, c.currentTime + 0.12);
        osc.connect(g);
        g.connect(c.destination);
        osc.start();
        osc.stop(c.currentTime + 0.12);
      } catch {}
    }
  }

  // ── Main UI Initialization ──
  function initStreamEmoji() {
    const isEn = document.documentElement.lang === 'en';
    const canvas = document.getElementById('emoji-canvas') as HTMLCanvasElement;
    const onionPrevCanvas = document.getElementById('onion-prev-canvas') as HTMLCanvasElement;
    const onionNextCanvas = document.getElementById('onion-next-canvas') as HTMLCanvasElement;
    const miniPreviewCanvas = document.getElementById('mini-preview-canvas') as HTMLCanvasElement;
    const canvasViewport = document.getElementById('canvas-viewport');
    const canvasFrame = document.getElementById('canvas-frame');
    const brushCursor = document.getElementById('brush-cursor');

    if (!canvas || !onionPrevCanvas || !onionNextCanvas || !miniPreviewCanvas) return;

    const engine = new StreamEmojiEngine(128, 128);
    const audio = new EmojiAudio();

    // Canvas contexts
    const ctx = canvas.getContext('2d', { willReadFrequently: true })!;
    const prevCtx = onionPrevCanvas.getContext('2d')!;
    const nextCtx = onionNextCanvas.getContext('2d')!;
    const miniCtx = miniPreviewCanvas.getContext('2d')!;

    const resizeCanvases = (w: number, h: number) => {
      canvas.width = w;
      canvas.height = h;
      onionPrevCanvas.width = w;
      onionPrevCanvas.height = h;
      nextCtx.canvas.width = w;
      nextCtx.canvas.height = h;
      if (canvasFrame) {
        canvasFrame.style.width = `${w}px`;
        canvasFrame.style.height = `${h}px`;
      }
    };
    resizeCanvases(128, 128);

    // ── Toast Notification ──
    const showToast = (msg: string) => {
      let t = document.getElementById('emoji-toast');
      if (!t) {
        t = document.createElement('div');
        t.id = 'emoji-toast';
        t.className = 'emoji-toast';
        document.body.appendChild(t);
      }
      t.textContent = msg;
      t.classList.add('show');
      setTimeout(() => t?.classList.remove('show'), 1600);
    };

    // ── Render Pipeline ──
    const render = () => {
      const w = engine.width;
      const h = engine.height;
      const pal = engine.paletteTable;

      // 1. If playing, render current play frame to main canvas and mini preview
      if (engine.isPlaying) {
        onionPrevCanvas.style.display = 'none';
        onionNextCanvas.style.display = 'none';

        const frame = engine.frames[engine.currentPlayFrame];
        const imgData = ctx.createImageData(w, h);
        for (let i = 0; i < frame.length; i++) {
          const idx = frame[i];
          const p = i * 4;
          if (idx === 0) {
            imgData.data[p + 3] = 0;
          } else {
            const c = pal[idx] || PALETTE[2];
            imgData.data[p] = c.rgb[0];
            imgData.data[p + 1] = c.rgb[1];
            imgData.data[p + 2] = c.rgb[2];
            imgData.data[p + 3] = c.alpha ?? 255;
          }
        }
        ctx.putImageData(imgData, 0, 0);

        // Mini preview render
        miniCtx.clearRect(0, 0, miniPreviewCanvas.width, miniPreviewCanvas.height);
        miniCtx.drawImage(canvas, 0, 0, miniPreviewCanvas.width, miniPreviewCanvas.height);
        return;
      }

      // 2. Paused / Drawing Mode:
      // A. Onion Skinning (Previous frame in red ghost, Next frame in cyan ghost)
      if (engine.onionSkin && engine.frames.length > 1) {
        onionPrevCanvas.style.display = 'block';
        onionNextCanvas.style.display = 'block';

        const prevIdx = (engine.activeFrameIndex - 1 + engine.frames.length) % engine.frames.length;
        const nextIdx = (engine.activeFrameIndex + 1) % engine.frames.length;

        // Render previous frame (tinted coral/red)
        const prevFrame = engine.frames[prevIdx];
        const prevData = prevCtx.createImageData(w, h);
        for (let i = 0; i < prevFrame.length; i++) {
          const idx = prevFrame[i];
          const p = i * 4;
          if (idx > 0) {
            prevData.data[p] = 255;
            prevData.data[p + 1] = 68;
            prevData.data[p + 2] = 68;
            prevData.data[p + 3] = Math.round(255 * engine.onionOpacity);
          }
        }
        prevCtx.putImageData(prevData, 0, 0);

        // Render next frame (tinted cyan/blue)
        const nextFrame = engine.frames[nextIdx];
        const nextData = nextCtx.createImageData(w, h);
        for (let i = 0; i < nextFrame.length; i++) {
          const idx = nextFrame[i];
          const p = i * 4;
          if (idx > 0) {
            nextData.data[p] = 0;
            nextData.data[p + 1] = 234;
            nextData.data[p + 2] = 200;
            nextData.data[p + 3] = Math.round(255 * engine.onionOpacity * 0.85);
          }
        }
        nextCtx.putImageData(nextData, 0, 0);
      } else {
        onionPrevCanvas.style.display = 'none';
        onionNextCanvas.style.display = 'none';
      }

      // B. Render active frame
      const frame = engine.frames[engine.activeFrameIndex];
      const imgData = ctx.createImageData(w, h);
      for (let i = 0; i < frame.length; i++) {
        const idx = frame[i];
        const p = i * 4;
        if (idx === 0) {
          imgData.data[p + 3] = 0;
        } else {
          const c = pal[idx] || PALETTE[2];
          imgData.data[p] = c.rgb[0];
          imgData.data[p + 1] = c.rgb[1];
          imgData.data[p + 2] = c.rgb[2];
          imgData.data[p + 3] = c.alpha ?? 255;
        }
      }
      ctx.putImageData(imgData, 0, 0);

      // Mini preview update
      miniCtx.clearRect(0, 0, miniPreviewCanvas.width, miniPreviewCanvas.height);
      miniCtx.drawImage(canvas, 0, 0, miniPreviewCanvas.width, miniPreviewCanvas.height);

      // Update undo/redo button states
      const undoBtn = document.getElementById('undo-btn') as HTMLButtonElement;
      const redoBtn = document.getElementById('redo-btn') as HTMLButtonElement;
      if (undoBtn) undoBtn.disabled = engine.undoStacks[engine.activeFrameIndex]?.length === 0;
      if (redoBtn) redoBtn.disabled = engine.redoStacks[engine.activeFrameIndex]?.length === 0;
    };

    // ── Animation Loop (RAF) ──
    let rafId = 0;
    let lastTick = 0;
    const animLoop = (time: number) => {
      if (engine.isPlaying) {
        const frameInterval = 1000 / engine.fps;
        if (time - lastTick >= frameInterval) {
          engine.currentPlayFrame = (engine.currentPlayFrame + 1) % engine.frames.length;
          lastTick = time;
          updateTimelineStrip();
          render();
        }
      }
      rafId = requestAnimationFrame(animLoop);
    };
    rafId = requestAnimationFrame(animLoop);

    // ── Timeline UI Strip Synchronization ──
    const frameStrip = document.getElementById('frame-strip');
    const curFrameNum = document.getElementById('current-frame-num');
    const totFrameNum = document.getElementById('total-frame-num');
    const playBtn = document.getElementById('timeline-play-btn');
    const playIcon = document.getElementById('play-icon');
    const playLabel = document.getElementById('play-label');

    const updateTimelineStrip = () => {
      if (!frameStrip) return;
      if (curFrameNum) curFrameNum.textContent = (engine.activeFrameIndex + 1).toString();
      if (totFrameNum) totFrameNum.textContent = engine.frames.length.toString();

      // If strip children count mismatch, re-create thumbnails
      if (frameStrip.children.length !== engine.frames.length) {
        frameStrip.innerHTML = '';
        engine.frames.forEach((_, idx) => {
          const thumbCard = document.createElement('div');
          thumbCard.className = `frame-thumb-card ${idx === engine.activeFrameIndex ? 'active' : ''}`;
          thumbCard.dataset.index = idx.toString();

          const miniC = document.createElement('canvas');
          miniC.width = 36;
          miniC.height = 36;
          miniC.className = 'thumb-canvas';
          thumbCard.appendChild(miniC);

          const badge = document.createElement('span');
          badge.className = 'thumb-num';
          badge.textContent = `${idx + 1}`;
          thumbCard.appendChild(badge);

          thumbCard.addEventListener('click', () => {
            if (engine.isPlaying) togglePlay();
            engine.activeFrameIndex = idx;
            audio.playBlip(380);
            updateTimelineStrip();
            render();
          });
          frameStrip.appendChild(thumbCard);
        });
      }

      // Update thumbnail canvas pixels & active class
      Array.from(frameStrip.children).forEach((child, idx) => {
        const isSelected = engine.isPlaying ? idx === engine.currentPlayFrame : idx === engine.activeFrameIndex;
        child.classList.toggle('active', isSelected);
        const tCanvas = child.querySelector('canvas');
        if (tCanvas) {
          const tCtx = tCanvas.getContext('2d');
          if (tCtx) {
            tCtx.clearRect(0, 0, 36, 36);
            // Draw thumbnail from frame data
            const w = engine.width;
            const h = engine.height;
            const frame = engine.frames[idx];
            const tempC = document.createElement('canvas');
            tempC.width = w;
            tempC.height = h;
            const tempCtx = tempC.getContext('2d')!;
            const imgData = tempCtx.createImageData(w, h);
            for (let i = 0; i < frame.length; i++) {
              const pIdx = frame[i];
              const p = i * 4;
              if (pIdx > 0) {
                const c = engine.paletteTable[pIdx] || PALETTE[2];
                imgData.data[p] = c.rgb[0];
                imgData.data[p + 1] = c.rgb[1];
                imgData.data[p + 2] = c.rgb[2];
                imgData.data[p + 3] = c.alpha ?? 255;
              }
            }
            tempCtx.putImageData(imgData, 0, 0);
            tCtx.drawImage(tempC, 0, 0, 36, 36);
          }
        }
      });
    };

    const togglePlay = () => {
      engine.isPlaying = !engine.isPlaying;
      if (playBtn) playBtn.classList.toggle('is-playing', engine.isPlaying);
      if (playIcon) playIcon.textContent = engine.isPlaying ? '⏸' : '▶';
      if (playLabel) playLabel.textContent = engine.isPlaying ? (isEn ? 'Pause' : '정지') : (isEn ? 'Play' : '재생');
      if (engine.isPlaying) {
        audio.playBlip(560);
      } else {
        audio.playBlip(340);
        engine.currentPlayFrame = engine.activeFrameIndex;
        render();
      }
    };

    playBtn?.addEventListener('click', togglePlay);

    // ── Timeline Action Buttons ──
    document.getElementById('add-frame-btn')?.addEventListener('click', () => {
      if (engine.frames.length >= 16) {
        showToast(isEn ? 'Max 16 frames reached' : '최대 16프레임까지 추가할 수 있습니다');
        return;
      }
      engine.addFrame();
      audio.playBlip(480);
      updateTimelineStrip();
      render();
      showToast(isEn ? `Frame ${engine.activeFrameIndex + 1} added` : `${engine.activeFrameIndex + 1}번 프레임 추가`);
    });

    document.getElementById('dup-frame-btn')?.addEventListener('click', () => {
      if (engine.frames.length >= 16) {
        showToast(isEn ? 'Max 16 frames reached' : '최대 16프레임까지 추가할 수 있습니다');
        return;
      }
      engine.duplicateFrame();
      audio.playBlip(520);
      updateTimelineStrip();
      render();
      showToast(isEn ? `Frame duplicated to ${engine.activeFrameIndex + 1}` : `${engine.activeFrameIndex + 1}번으로 프레임 복제 완료`);
    });

    document.getElementById('del-frame-btn')?.addEventListener('click', () => {
      if (engine.frames.length <= 2) {
        showToast(isEn ? 'Min 2 frames required for animation' : '최소 2개 이상의 프레임이 필요합니다');
        return;
      }
      engine.deleteFrame();
      audio.playBlip(280);
      updateTimelineStrip();
      render();
      showToast(isEn ? 'Frame deleted' : '프레임 삭제 완료');
    });

    // ── Onion Skin Toggle ──
    const onionBtn = document.getElementById('onion-skin-btn');
    onionBtn?.addEventListener('click', () => {
      engine.onionSkin = !engine.onionSkin;
      onionBtn.classList.toggle('active', engine.onionSkin);
      audio.playBlip(engine.onionSkin ? 500 : 300);
      render();
      showToast(engine.onionSkin ? (isEn ? 'Onion Skin: ON' : '어니언 스킨: 켜짐') : (isEn ? 'Onion Skin: OFF' : '어니언 스킨: 꺼짐'));
    });

    // ── FPS Selector ──
    const fpsSelect = document.getElementById('fps-select') as HTMLSelectElement;
    fpsSelect?.addEventListener('change', () => {
      engine.fps = parseInt(fpsSelect.value, 10) || 8;
      audio.playBlip(440);
    });

    // ── Canvas Size Dropdown Setup ──
    const sizeBtn = document.getElementById('canvas-size-btn');
    const sizeDropdown = document.getElementById('size-dropdown-menu');
    const currentSizeLabel = document.getElementById('current-size-label');

    sizeBtn?.addEventListener('click', (e) => {
      e.stopPropagation();
      sizeDropdown?.classList.toggle('open');
    });

    document.addEventListener('click', () => sizeDropdown?.classList.remove('open'));

    document.querySelectorAll('.size-opt-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        const w = parseInt((btn as HTMLElement).dataset.w || '128', 10);
        const h = parseInt((btn as HTMLElement).dataset.h || '128', 10);
        const name = (btn as HTMLElement).dataset.name || `${w}×${h}`;

        document.querySelectorAll('.size-opt-btn').forEach(b => b.classList.remove('active'));
        btn.classList.add('active');
        if (currentSizeLabel) currentSizeLabel.textContent = name;
        sizeDropdown?.classList.remove('open');

        engine.resize(w, h);
        resizeCanvases(w, h);
        updateTimelineStrip();
        render();
        showToast(isEn ? `Canvas changed to ${name}` : `캔버스 규격: ${name}`);
      });
    });

    // ── Background Mode Toggles ──
    document.querySelectorAll('.bg-pill').forEach(btn => {
      btn.addEventListener('click', () => {
        document.querySelectorAll('.bg-pill').forEach(b => b.classList.remove('active'));
        btn.classList.add('active');
        const mode = (btn as HTMLElement).dataset.bg as 'dark' | 'chroma' | 'transparent';
        engine.bgMode = mode;

        if (canvasViewport) {
          canvasViewport.classList.remove('bg-chroma', 'bg-transparent');
          if (mode === 'chroma') canvasViewport.classList.add('bg-chroma');
          if (mode === 'transparent') canvasViewport.classList.add('bg-transparent');
        }
        render();
      });
    });

    // ── 1x Mini Emote Widget Scale Toggles ──
    document.querySelectorAll('.scale-toggle').forEach(btn => {
      btn.addEventListener('click', () => {
        document.querySelectorAll('.scale-toggle').forEach(b => b.classList.remove('active'));
        btn.classList.add('active');
        const sc = parseInt((btn as HTMLElement).dataset.scale || '112', 10);
        miniPreviewCanvas.style.width = `${sc}px`;
        miniPreviewCanvas.style.height = `${sc}px`;
      });
    });

    // ── Zoom & Pan System ──
    const ZOOM_LEVELS = [0.5, 0.75, 1.0, 1.5, 2.0, 3.0, 4.0, 6.0, 8.0];
    let currentZoom = 3.0; // Emotes look great starting zoomed in at 300%
    let panX = 0;
    let panY = 0;
    let isPanning = false;
    let panStartX = 0;
    let panStartY = 0;
    let isSpacePressed = false;
    let isHandToolActive = false;

    const zoomLevelText = document.getElementById('zoom-level-text');
    const zoomResetBtn = document.getElementById('zoom-reset-btn');
    const zoomInBtn = document.getElementById('zoom-in-btn');
    const zoomOutBtn = document.getElementById('zoom-out-btn');
    const zoomFitBtn = document.getElementById('zoom-fit-btn');
    const panToggleBtn = document.getElementById('pan-toggle-btn');

    const updateCanvasTransform = (animate: boolean = false) => {
      if (!canvasFrame) return;
      canvasFrame.style.transition = animate ? 'transform 0.16s cubic-bezier(0.2, 0.8, 0.2, 1)' : 'none';
      canvasFrame.style.transform = `translate(${panX}px, ${panY}px) scale(${currentZoom})`;
      if (zoomLevelText) zoomLevelText.textContent = `${Math.round(currentZoom * 100)}%`;
      updateBrushCursor();
    };

    const zoomTo = (newZoom: number, animate: boolean = true) => {
      currentZoom = Math.max(0.5, Math.min(8.0, Math.round(newZoom * 100) / 100));
      updateCanvasTransform(animate);
    };

    zoomInBtn?.addEventListener('click', () => {
      const next = ZOOM_LEVELS.find(lvl => lvl > currentZoom + 0.05) || 8.0;
      zoomTo(next, true);
    });
    zoomOutBtn?.addEventListener('click', () => {
      const prev = [...ZOOM_LEVELS].reverse().find(lvl => lvl < currentZoom - 0.05) || 0.5;
      zoomTo(prev, true);
    });
    zoomResetBtn?.addEventListener('click', () => {
      panX = 0;
      panY = 0;
      zoomTo(1.0, true);
      showToast('100%');
    });
    zoomFitBtn?.addEventListener('click', () => {
      panX = 0;
      panY = 0;
      const vpW = canvasViewport ? canvasViewport.clientWidth - 80 : 360;
      const vpH = canvasViewport ? canvasViewport.clientHeight - 80 : 360;
      const sc = Math.min(vpW / engine.width, vpH / engine.height);
      zoomTo(Math.max(1.0, sc), true);
    });

    panToggleBtn?.addEventListener('click', () => {
      isHandToolActive = !isHandToolActive;
      panToggleBtn.classList.toggle('active', isHandToolActive);
      canvas.style.cursor = isHandToolActive ? 'grab' : 'none';
      if (brushCursor) brushCursor.style.display = isHandToolActive ? 'none' : 'block';
    });

    window.addEventListener('keydown', (e) => {
      if (e.code === 'Space' && (e.target as HTMLElement).tagName !== 'INPUT') {
        e.preventDefault();
        if (!isSpacePressed) {
          isSpacePressed = true;
          canvas.style.cursor = 'grab';
          if (brushCursor) brushCursor.style.display = 'none';
        }
      }
      if (e.code === 'KeyO' && (e.target as HTMLElement).tagName !== 'INPUT') {
        onionBtn?.click();
      }
      if (e.ctrlKey && e.key === 'z') {
        e.preventDefault();
        if (engine.undo()) {
          audio.playBlip(320);
          updateTimelineStrip();
          render();
        }
      }
      if (e.ctrlKey && (e.key === 'y' || (e.shiftKey && e.key === 'z'))) {
        e.preventDefault();
        if (engine.redo()) {
          audio.playBlip(360);
          updateTimelineStrip();
          render();
        }
      }
    });

    window.addEventListener('keyup', (e) => {
      if (e.code === 'Space') {
        isSpacePressed = false;
        canvas.style.cursor = isHandToolActive ? 'grab' : 'none';
        if (brushCursor) brushCursor.style.display = isHandToolActive ? 'none' : 'block';
      }
    });

    canvasViewport?.addEventListener('wheel', (e) => {
      if (e.ctrlKey) {
        e.preventDefault();
        const delta = e.deltaY < 0 ? 0.3 : -0.3;
        zoomTo(currentZoom + delta, false);
      }
    }, { passive: false });

    // ── Brush Cursor Indicator ──
    const updateBrushCursor = () => {
      if (!brushCursor) return;
      if (isHandToolActive || isSpacePressed || engine.activeBrush === 'bucket') {
        brushCursor.style.display = 'none';
        canvas.style.cursor = engine.activeBrush === 'bucket' ? 'cell' : isHandToolActive ? 'grab' : 'none';
        return;
      }
      canvas.style.cursor = 'none';
      brushCursor.style.display = 'block';

      const scale = (canvas.offsetWidth / engine.width) * currentZoom;
      const diam = Math.max(3, engine.brushSize * scale);
      brushCursor.style.width = `${diam}px`;
      brushCursor.style.height = `${diam}px`;
      brushCursor.style.borderRadius = engine.tipShape === 'square' ? '2px' : '50%';

      const curColor = engine.paletteTable[engine.activeColorIndex] || PALETTE[2];
      const alpha = Math.max(0.2, engine.brushOpacity * 0.5);
      brushCursor.style.background = `rgba(${curColor.rgb[0]}, ${curColor.rgb[1]}, ${curColor.rgb[2]}, ${alpha})`;
      brushCursor.style.borderColor = curColor.hex;
    };

    // ── Pointer Draw & Events ──
    let isDrawing = false;
    let lastX = 0;
    let lastY = 0;

    const getPos = (e: PointerEvent) => {
      const rect = canvas.getBoundingClientRect();
      const clientX = e.clientX - rect.left;
      const clientY = e.clientY - rect.top;
      const px = Math.floor((clientX / rect.width) * engine.width);
      const py = Math.floor((clientY / rect.height) * engine.height);
      return {
        x: Math.max(0, Math.min(engine.width - 1, px)),
        y: Math.max(0, Math.min(engine.height - 1, py)),
        screenX: e.clientX,
        screenY: e.clientY
      };
    };

    canvas.addEventListener('pointerdown', (e) => {
      // Pan handling
      if (isHandToolActive || isSpacePressed || e.button === 1) {
        isPanning = true;
        panStartX = e.clientX - panX;
        panStartY = e.clientY - panY;
        canvas.style.cursor = 'grabbing';
        return;
      }

      if (e.button !== 0) return;
      if (engine.isPlaying) togglePlay(); // Pause immediately when drawing

      const pos = getPos(e);
      if (engine.activeBrush === 'bucket') {
        engine.floodFill(pos.x, pos.y);
        audio.playBucket();
        updateTimelineStrip();
        render();
        return;
      }

      isDrawing = true;
      lastX = pos.x;
      lastY = pos.y;
      canvas.setPointerCapture(e.pointerId);

      if (engine.tipShape === 'square') {
        audio.playSquareBlip();
      } else {
        audio.playBlip(320);
      }
      engine.drawStroke(pos.x, pos.y, pos.x, pos.y, true);
      render();
    });

    canvas.addEventListener('pointermove', (e) => {
      if (isPanning) {
        panX = e.clientX - panStartX;
        panY = e.clientY - panStartY;
        updateCanvasTransform(false);
        return;
      }

      const pos = getPos(e);
      if (brushCursor && !isHandToolActive && !isSpacePressed) {
        const rect = canvas.getBoundingClientRect();
        const cursorScale = canvas.offsetWidth / engine.width;
        brushCursor.style.left = `${pos.x * cursorScale}px`;
        brushCursor.style.top = `${pos.y * cursorScale}px`;
      }

      if (!isDrawing) return;
      engine.drawStroke(lastX, lastY, pos.x, pos.y, false);
      lastX = pos.x;
      lastY = pos.y;
      render();
    });

    const endDraw = (e: PointerEvent) => {
      if (isPanning) {
        isPanning = false;
        canvas.style.cursor = isHandToolActive ? 'grab' : 'none';
        return;
      }
      if (isDrawing) {
        isDrawing = false;
        try { canvas.releasePointerCapture(e.pointerId); } catch {}
        updateTimelineStrip();
        render();
      }
    };

    canvas.addEventListener('pointerup', endDraw);
    canvas.addEventListener('pointercancel', endDraw);

    // ── Brushes & Tool Selection ──
    const toolCardIcon = document.getElementById('tool-card-icon');
    const toolCardName = document.getElementById('tool-card-name');
    const BRUSH_NAMES: Record<string, { icon: string; ko: string; en: string }> = {
      pen: { icon: '🖊️', ko: '펜', en: 'Pen' },
      bucket: { icon: '🪣', ko: '페인트통', en: 'Bucket' },
      pencil: { icon: '✏️', ko: '연필', en: 'Pencil' },
      spray: { icon: '💨', ko: '스프레이', en: 'Spray' },
      rainbow: { icon: '🌈', ko: '무지개', en: 'Rainbow' },
      eraser: { icon: '🧼', ko: '지우개', en: 'Eraser' },
      cutout: { icon: '🕳️', ko: '투명 오리기', en: 'Cutout' }
    };

    document.querySelectorAll('.brush-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        document.querySelectorAll('.brush-btn').forEach(b => b.classList.remove('active'));
        btn.classList.add('active');
        const b = (btn as HTMLElement).dataset.brush || 'pen';
        engine.activeBrush = b;

        const info = BRUSH_NAMES[b] || BRUSH_NAMES.pen;
        if (toolCardIcon) toolCardIcon.textContent = info.icon;
        if (toolCardName) toolCardName.textContent = isEn ? info.en : info.ko;

        audio.playBlip(420);
        updateBrushCursor();
      });
    });

    // ── Tip Shape Toggle ──
    document.querySelectorAll('.tip-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        const tip = (btn as HTMLElement).dataset.tip as 'round' | 'square';
        engine.tipShape = tip;
        document.querySelectorAll('.tip-btn').forEach(b => {
          b.classList.toggle('active', (b as HTMLElement).dataset.tip === tip);
        });
        if (tip === 'square') {
          audio.playSquareBlip();
        } else {
          audio.playBlip(360);
        }
        updateBrushCursor();
        showToast(tip === 'square' ? (isEn ? 'Square Tip (Pixel)' : '사각 팁 (픽셀 아트)') : (isEn ? 'Round Tip' : '원형 팁'));
      });
    });

    // ── Brush Size Controls ──
    const sizeSlider = document.getElementById('brush-size-slider') as HTMLInputElement;
    const sidebarSizeSlider = document.getElementById('sidebar-size-slider') as HTMLInputElement;
    const sizeVal = document.getElementById('brush-size-val');
    const sidebarSizeVal = document.getElementById('sidebar-size-val');

    const updateSize = (val: number) => {
      engine.brushSize = val;
      if (sizeSlider) sizeSlider.value = val.toString();
      if (sidebarSizeSlider) sidebarSizeSlider.value = val.toString();
      if (sizeVal) sizeVal.textContent = val.toString();
      if (sidebarSizeVal) sidebarSizeVal.textContent = `${val}px`;
      document.querySelectorAll('.size-pill').forEach(pill => {
        pill.classList.toggle('active', (pill as HTMLElement).dataset.size === val.toString());
      });
      updateBrushCursor();
    };

    sizeSlider?.addEventListener('input', () => updateSize(parseInt(sizeSlider.value, 10)));
    sidebarSizeSlider?.addEventListener('input', () => updateSize(parseInt(sidebarSizeSlider.value, 10)));
    document.querySelectorAll('.size-pill').forEach(p => {
      p.addEventListener('click', () => updateSize(parseInt((p as HTMLElement).dataset.size || '4', 10)));
    });

    // ── Opacity Controls ──
    const opacitySlider = document.getElementById('brush-opacity-slider') as HTMLInputElement;
    const sidebarOpacitySlider = document.getElementById('sidebar-opacity-slider') as HTMLInputElement;
    const opacityVal = document.getElementById('brush-opacity-val');
    const sidebarOpacityVal = document.getElementById('sidebar-opacity-val');

    const updateOpacity = (pct: number) => {
      engine.brushOpacity = pct / 100;
      if (opacitySlider) opacitySlider.value = pct.toString();
      if (sidebarOpacitySlider) sidebarOpacitySlider.value = pct.toString();
      if (opacityVal) opacityVal.textContent = `${pct}%`;
      if (sidebarOpacityVal) sidebarOpacityVal.textContent = `${pct}%`;
      document.querySelectorAll('.opacity-pill').forEach(pill => {
        pill.classList.toggle('active', (pill as HTMLElement).dataset.opacity === pct.toString());
      });
      updateBrushCursor();
    };

    opacitySlider?.addEventListener('input', () => updateOpacity(parseInt(opacitySlider.value, 10)));
    sidebarOpacitySlider?.addEventListener('input', () => updateOpacity(parseInt(sidebarOpacitySlider.value, 10)));
    document.querySelectorAll('.opacity-pill').forEach(p => {
      p.addEventListener('click', () => updateOpacity(parseInt((p as HTMLElement).dataset.opacity || '100', 10)));
    });

    // ── Palette Swatches & RGB Pickers ──
    const swatchesContainer = document.getElementById('palette-swatches');
    const customColorInput = document.getElementById('custom-color-input') as HTMLInputElement;
    const sidebarColorInput = document.getElementById('sidebar-color-input') as HTMLInputElement;
    const customHexLabel = document.getElementById('custom-hex-label');
    const sidebarColorHex = document.getElementById('sidebar-color-hex');
    const customSwatchLabel = document.getElementById('custom-swatch-label');
    const sidebarSwatchLabel = document.getElementById('sidebar-swatch-label');

    const updateColor = (hex: string) => {
      // Parse RGB from hex
      const r = parseInt(hex.slice(1, 3), 16) || 0;
      const g = parseInt(hex.slice(3, 5), 16) || 0;
      const b = parseInt(hex.slice(5, 7), 16) || 0;
      const idx = engine.getOrCreateColorIndex([r, g, b], Math.round(engine.brushOpacity * 255));
      engine.activeColorIndex = idx;

      if (customHexLabel) customHexLabel.textContent = hex.toUpperCase();
      if (sidebarColorHex) sidebarColorHex.textContent = hex.toUpperCase();
      if (customColorInput) customColorInput.value = hex;
      if (sidebarColorInput) sidebarColorInput.value = hex;
      if (customSwatchLabel) customSwatchLabel.style.backgroundColor = hex;
      if (sidebarSwatchLabel) sidebarSwatchLabel.style.backgroundColor = hex;

      document.querySelectorAll('.color-swatch').forEach(sw => {
        sw.classList.toggle('active', (sw as HTMLElement).dataset.hex === hex.toUpperCase());
      });
      audio.playBlip(480);
      updateBrushCursor();
    };

    PALETTE.forEach((color, idx) => {
      if (idx === 0) return; // Skip transparent index 0
      const sw = document.createElement('button');
      sw.type = 'button';
      sw.className = `color-swatch ${idx === 2 ? 'active' : ''}`;
      sw.style.backgroundColor = color.hex;
      sw.dataset.hex = color.hex.toUpperCase();
      sw.title = color.hex;
      sw.addEventListener('click', () => updateColor(color.hex));
      swatchesContainer?.appendChild(sw);
    });

    customColorInput?.addEventListener('input', () => updateColor(customColorInput.value));
    sidebarColorInput?.addEventListener('input', () => updateColor(sidebarColorInput.value));

    // ── Symmetry Controls ──
    const symHBtn = document.getElementById('sym-h-btn');
    const symVBtn = document.getElementById('sym-v-btn');
    const symQuadBtn = document.getElementById('sym-quad-btn');

    const setSymmetry = (mode: 'none' | 'h' | 'v' | 'quad') => {
      engine.symmetryMode = engine.symmetryMode === mode ? 'none' : mode;
      symHBtn?.classList.toggle('active', engine.symmetryMode === 'h');
      symVBtn?.classList.toggle('active', engine.symmetryMode === 'v');
      symQuadBtn?.classList.toggle('active', engine.symmetryMode === 'quad');
      audio.playBlip(380);
      showToast(engine.symmetryMode === 'none' ? '대칭 끄기' : `대칭 모드: ${engine.symmetryMode.toUpperCase()}`);
    };

    symHBtn?.addEventListener('click', () => setSymmetry('h'));
    symVBtn?.addEventListener('click', () => setSymmetry('v'));
    symQuadBtn?.addEventListener('click', () => setSymmetry('quad'));

    // ── Inspiration Presets ──
    document.querySelectorAll('.preset-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        const p = (btn as HTMLElement).dataset.preset;
        if (!p) return;
        if (confirm(isEn ? 'Load preset animation? (Replaces existing frames)' : '프리셋 애니메이션을 불러오시겠습니까? (현재 프레임이 대체됩니다)')) {
          engine.loadPreset(p);
          audio.playBlip(600);
          updateTimelineStrip();
          render();
          showToast(isEn ? 'Preset loaded!' : '프리셋 불러오기 완료!');
        }
      });
    });

    // ── Clear Frame & Undo/Redo Buttons ──
    document.getElementById('clear-frame-btn')?.addEventListener('click', () => {
      engine.clearActiveFrame();
      audio.playBlip(240);
      updateTimelineStrip();
      render();
      showToast(isEn ? 'Frame cleared' : '현재 프레임 지우기 완료');
    });

    document.getElementById('undo-btn')?.addEventListener('click', () => {
      if (engine.undo()) {
        audio.playBlip(320);
        updateTimelineStrip();
        render();
      }
    });

    document.getElementById('redo-btn')?.addEventListener('click', () => {
      if (engine.redo()) {
        audio.playBlip(360);
        updateTimelineStrip();
        render();
      }
    });

    // ── Export Modal System ──
    const exportModal = document.getElementById('export-modal');
    const modalTitle = document.getElementById('modal-title');
    const modalTypeBadge = document.getElementById('modal-type-badge');
    const modalSizeBadge = document.getElementById('modal-size-badge');
    const modalFileSize = document.getElementById('modal-file-size');
    const modalPreview = document.getElementById('modal-export-preview') as HTMLImageElement;
    const downloadLink = document.getElementById('file-download-link') as HTMLAnchorElement;
    const copyBtn = document.getElementById('modal-copy-btn');
    const modalCloseBtn = document.getElementById('modal-close-btn');

    let currentExportBlob: Blob | null = null;

    modalCloseBtn?.addEventListener('click', () => {
      if (exportModal) exportModal.style.display = 'none';
    });

    // Export GIF
    document.getElementById('export-gif-btn')?.addEventListener('click', () => {
      const blob = engine.generateGif();
      currentExportBlob = blob;
      const url = URL.createObjectURL(blob);

      if (modalTitle) modalTitle.textContent = isEn ? '🎉 Animated GIF Emote Ready!' : '🎉 움직이는 GIF 이모티콘 완성!';
      if (modalTypeBadge) modalTypeBadge.textContent = `GIF (${engine.fps} FPS)`;
      if (modalSizeBadge) modalSizeBadge.textContent = `${engine.width}×${engine.height} px`;
      if (modalFileSize) modalFileSize.textContent = `${Math.round(blob.size / 1024 * 10) / 10} KB`;
      if (modalPreview) modalPreview.src = url;
      if (downloadLink) {
        downloadLink.href = url;
        downloadLink.download = `stream-emoji-${engine.width}x${engine.height}-${Date.now().toString(36)}.gif`;
      }
      if (exportModal) exportModal.style.display = 'flex';
      audio.playBlip(640);
    });

    // Export PNG Spritesheet
    document.getElementById('export-sheet-btn')?.addEventListener('click', async () => {
      try {
        const blob = await engine.generateSpritesheet();
        currentExportBlob = blob;
        const url = URL.createObjectURL(blob);

        if (modalTitle) modalTitle.textContent = isEn ? '🎞️ PNG Spritesheet Ready!' : '🎞️ 스프라이트시트 PNG 완성!';
        if (modalTypeBadge) modalTypeBadge.textContent = `Spritesheet (${engine.frames.length}F)`;
        if (modalSizeBadge) modalSizeBadge.textContent = `${engine.width * engine.frames.length}×${engine.height} px`;
        if (modalFileSize) modalFileSize.textContent = `${Math.round(blob.size / 1024 * 10) / 10} KB`;
        if (modalPreview) modalPreview.src = url;
        if (downloadLink) {
          downloadLink.href = url;
          downloadLink.download = `stream-emoji-sheet-${engine.frames.length}F-${Date.now().toString(36)}.png`;
        }
        if (exportModal) exportModal.style.display = 'flex';
        audio.playBlip(640);
      } catch (err) {
        alert('Error generating spritesheet: ' + err);
      }
    });

    // Export Current Frame PNG
    document.getElementById('export-png-btn')?.addEventListener('click', async () => {
      try {
        const blob = await engine.generatePng();
        currentExportBlob = blob;
        const url = URL.createObjectURL(blob);

        if (modalTitle) modalTitle.textContent = isEn ? '📷 Current Frame PNG Ready!' : '📷 현재 프레임 PNG 완성!';
        if (modalTypeBadge) modalTypeBadge.textContent = 'PNG (Frame ' + (engine.activeFrameIndex + 1) + ')';
        if (modalSizeBadge) modalSizeBadge.textContent = `${engine.width}×${engine.height} px`;
        if (modalFileSize) modalFileSize.textContent = `${Math.round(blob.size / 1024 * 10) / 10} KB`;
        if (modalPreview) modalPreview.src = url;
        if (downloadLink) {
          downloadLink.href = url;
          downloadLink.download = `stream-emoji-frame-${engine.activeFrameIndex + 1}.png`;
        }
        if (exportModal) exportModal.style.display = 'flex';
        audio.playBlip(640);
      } catch (err) {
        alert('Error generating PNG: ' + err);
      }
    });

    // Copy to clipboard
    copyBtn?.addEventListener('click', async () => {
      if (!currentExportBlob) return;
      try {
        const item = new (window as any).ClipboardItem({ [currentExportBlob.type]: currentExportBlob });
        await navigator.clipboard.write([item]);
        showToast(isEn ? 'Copied to clipboard!' : '클립보드에 복사되었습니다!');
      } catch {
        showToast(isEn ? 'Right click on image and select Copy' : '미리보기 이미지를 우클릭하여 복사하세요');
      }
    });

    // Initial preset & render
    engine.loadPreset('blink');
    updateTimelineStrip();
    render();
    updateCanvasTransform(false);
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initStreamEmoji);
  } else {
    initStreamEmoji();
  }
</script>

<style>
  /* ── Layout & Variables ── */
  .stream-emoji-wrapper {
    display: flex;
    flex-direction: column;
    min-height: max(calc(100vh - 64px), 820px);
    background: #090d16;
    color: #f8fafc;
    user-select: none;
    -webkit-user-select: none;
  }

  /* ── Top Header Bar ── */
  .emoji-header-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 48px;
    padding: 0 1rem;
    background: rgba(15, 23, 42, 0.95);
    backdrop-filter: blur(12px);
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    z-index: 20;
    gap: 0.75rem;
    flex-shrink: 0;
  }

  .header-left-group, .header-right-group {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .brand-badge {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    margin-right: 0.25rem;
  }

  .brand-emoji { font-size: 1.15rem; }
  .brand-title { font-size: 0.95rem; font-weight: 800; color: #f8fafc; }
  .brand-sub { font-size: 0.65rem; color: #94a3b8; font-weight: 600; }

  .crosslink-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.25rem 0.6rem;
    background: rgba(99, 102, 241, 0.15);
    border: 1px solid rgba(99, 102, 241, 0.3);
    border-radius: 9999px;
    color: #c7d2fe;
    font-size: 0.725rem;
    font-weight: 700;
    text-decoration: none;
    transition: all 0.15s ease;
  }
  .crosslink-pill:hover {
    background: rgba(99, 102, 241, 0.25);
    color: #ffffff;
    border-color: #818cf8;
    box-shadow: 0 0 10px rgba(99, 102, 241, 0.3);
  }

  /* ── Canvas Preset Dropdown ── */
  .canvas-size-picker-wrap {
    position: relative;
  }

  .size-dropdown-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.28rem 0.65rem;
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 8px;
    color: #e2e8f0;
    font-size: 0.75rem;
    font-weight: 700;
    cursor: pointer;
    transition: all 0.15s ease;
  }
  .size-dropdown-btn:hover {
    background: rgba(255, 255, 255, 0.09);
    border-color: rgba(255, 255, 255, 0.2);
  }

  .size-dropdown-menu {
    position: absolute;
    top: calc(100% + 6px);
    left: 0;
    width: 250px;
    background: #0f172a;
    border: 1px solid rgba(255, 255, 255, 0.15);
    border-radius: 12px;
    box-shadow: 0 12px 30px rgba(0, 0, 0, 0.6);
    padding: 0.5rem;
    display: none;
    flex-direction: column;
    gap: 0.35rem;
    z-index: 50;
  }
  .size-dropdown-menu.open { display: flex; }

  .dropdown-header {
    font-size: 0.65rem;
    font-weight: 700;
    color: #64748b;
    padding: 0.25rem 0.4rem;
    text-transform: uppercase;
  }

  .size-opt-btn {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    padding: 0.45rem 0.6rem;
    background: transparent;
    border: 1px solid transparent;
    border-radius: 8px;
    color: #e2e8f0;
    cursor: pointer;
    text-align: left;
    transition: all 0.15s ease;
  }
  .size-opt-btn:hover {
    background: rgba(255, 255, 255, 0.05);
  }
  .size-opt-btn.active {
    background: rgba(0, 234, 200, 0.12);
    border-color: rgba(0, 234, 200, 0.4);
    color: #00eac8;
  }

  .opt-badge {
    font-size: 0.575rem;
    font-weight: 800;
    padding: 0.1rem 0.35rem;
    border-radius: 4px;
    margin-bottom: 0.2rem;
  }
  .opt-badge.twitch { background: #9146ff; color: #fff; }
  .opt-badge.discord { background: #5865f2; color: #fff; }
  .opt-badge.sticker { background: #ec4899; color: #fff; }
  .opt-badge.pixel { background: #10b981; color: #fff; }
  .opt-badge.square { background: #64748b; color: #fff; }

  .opt-title { font-size: 0.775rem; font-weight: 700; }
  .opt-desc { font-size: 0.625rem; color: #94a3b8; }

  /* ── BG Modes ── */
  .bg-mode-group {
    display: flex;
    gap: 3px;
    background: rgba(0, 0, 0, 0.3);
    padding: 2px;
    border-radius: 8px;
  }
  .bg-pill {
    padding: 0.2rem 0.5rem;
    font-size: 0.675rem;
    font-weight: 700;
    background: transparent;
    border: none;
    border-radius: 6px;
    color: #94a3b8;
    cursor: pointer;
    transition: all 0.15s ease;
  }
  .bg-pill.active {
    background: rgba(255, 255, 255, 0.12);
    color: #f8fafc;
  }

  /* ── Header Tool Buttons ── */
  .tool-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.32rem 0.65rem;
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 8px;
    color: #cbd5e1;
    font-size: 0.725rem;
    font-weight: 700;
    cursor: pointer;
    transition: all 0.15s ease;
  }
  .tool-btn:hover:not(:disabled) {
    background: rgba(255, 255, 255, 0.1);
    color: #ffffff;
  }
  .tool-btn:disabled {
    opacity: 0.4;
    cursor: not-allowed;
  }
  .tool-btn.icon-btn {
    padding: 0.32rem 0.5rem;
    font-size: 0.85rem;
  }

  .export-btn {
    background: linear-gradient(135deg, #ec4899 0%, #8b5cf6 100%);
    border: none;
    color: #ffffff;
    box-shadow: 0 0 14px rgba(236, 72, 153, 0.4);
  }
  .export-btn:hover {
    box-shadow: 0 0 20px rgba(236, 72, 153, 0.6);
    transform: translateY(-1px);
  }

  /* ── Workspace ── */
  .emoji-workspace {
    display: flex;
    flex: 1;
    min-height: 700px;
    position: relative;
  }

  /* ── Sidebar ── */
  .emoji-sidebar {
    width: 230px;
    background: rgba(15, 23, 42, 0.85);
    border-right: 1px solid rgba(255, 255, 255, 0.08);
    display: flex;
    flex-direction: column;
    padding: 0.75rem 0.65rem;
    flex-shrink: 0;
    gap: 0.45rem;
    z-index: 10;
  }

  .sidebar-section-title {
    font-size: 0.65rem;
    font-weight: 800;
    color: #64748b;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin: 0.2rem 0.25rem 0.1rem;
  }

  .sidebar-divider {
    height: 1px;
    background: rgba(255, 255, 255, 0.06);
    margin: 0.35rem 0;
  }

  .brushes-list {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 4px;
  }

  .brush-btn {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.4rem 0.6rem;
    background: transparent;
    border: 1px solid transparent;
    border-radius: 8px;
    color: #94a3b8;
    font-size: 0.75rem;
    font-weight: 700;
    cursor: pointer;
    text-align: left;
    transition: all 0.15s ease;
  }
  .brush-btn:hover {
    background: rgba(255, 255, 255, 0.05);
    color: #f8fafc;
  }
  .brush-btn.active {
    background: rgba(0, 234, 200, 0.15);
    border-color: rgba(0, 234, 200, 0.4);
    color: #00eac8;
    box-shadow: 0 0 10px rgba(0, 234, 200, 0.2);
  }

  /* ── Active Tool Card ── */
  .active-tool-card {
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 10px;
    padding: 0.6rem;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .tool-card-header {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.8rem;
    font-weight: 800;
    color: #00eac8;
  }

  .sidebar-control-row {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }
  .sidebar-label-val {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 0.65rem;
    font-weight: 700;
    color: #94a3b8;
  }

  .tip-shape-toggle {
    display: flex;
    gap: 4px;
  }
  .tip-btn {
    flex: 1;
    padding: 0.25rem;
    font-size: 0.65rem;
    font-weight: 700;
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 6px;
    color: #94a3b8;
    cursor: pointer;
  }
  .tip-btn.active {
    background: rgba(0, 234, 200, 0.2);
    border-color: #00eac8;
    color: #00eac8;
  }

  .sidebar-slider, .quick-slider {
    width: 100%;
    accent-color: #00eac8;
    cursor: pointer;
  }

  .sidebar-color-swatch-wrap {
    display: flex;
    align-items: center;
    gap: 0.4rem;
  }
  .sidebar-color-swatch {
    position: relative;
    width: 24px;
    height: 24px;
    border-radius: 6px;
    background: #FF0055;
    border: 1.5px solid #fff;
    cursor: pointer;
    overflow: hidden;
  }
  .sidebar-color-swatch input[type="color"] {
    position: absolute;
    top: -50%; left: -50%; width: 200%; height: 200%; opacity: 0; cursor: pointer;
  }
  .sidebar-color-note { font-size: 0.6rem; color: #64748b; }

  /* ── Symmetry Grid ── */
  .symmetry-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 4px;
  }
  .sym-btn {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 2px;
    padding: 0.35rem 0.2rem;
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 6px;
    color: #94a3b8;
    cursor: pointer;
    font-size: 0.625rem;
    font-weight: 700;
  }
  .sym-btn.active {
    background: rgba(99, 102, 241, 0.25);
    border-color: #6366f1;
    color: #c7d2fe;
  }

  /* ── Photo Underlay ── */
  .photo-import-wrap {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
  }
  .photo-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.4rem;
    padding: 0.4rem;
    background: rgba(255, 255, 255, 0.05);
    border: 1px dashed rgba(255, 255, 255, 0.2);
    border-radius: 8px;
    color: #94a3b8;
    font-size: 0.725rem;
    font-weight: 700;
    cursor: pointer;
  }
  .photo-remove-btn {
    padding: 0.25rem;
    background: rgba(239, 68, 68, 0.15);
    border: 1px solid rgba(239, 68, 68, 0.3);
    border-radius: 6px;
    color: #f87171;
    font-size: 0.65rem;
    cursor: pointer;
  }

  /* ── Canvas Viewport ── */
  .emoji-canvas-viewport {
    flex: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
    background: #060911;
    overflow: hidden;
  }
  .emoji-canvas-viewport.bg-chroma { background: #00FF00 !important; }
  .emoji-canvas-viewport.bg-transparent {
    background-image: linear-gradient(45deg, #1e293b 25%, transparent 25%),
      linear-gradient(-45deg, #1e293b 25%, transparent 25%),
      linear-gradient(45deg, transparent 75%, #1e293b 75%),
      linear-gradient(-45deg, transparent 75%, #1e293b 75%);
    background-size: 16px 16px;
    background-position: 0 0, 0 8px, 8px -8px, -8px 0px;
  }

  .canvas-frame-container {
    position: relative;
    box-shadow: 0 10px 40px rgba(0, 0, 0, 0.8), 0 0 0 1px rgba(255, 255, 255, 0.1);
    transform-origin: center center;
  }

  .main-drawing-canvas {
    position: relative;
    display: block;
    width: 100%;
    height: 100%;
    image-rendering: pixelated;
    touch-action: none;
    z-index: 2;
  }

  .onion-canvas {
    position: absolute;
    top: 0; left: 0;
    width: 100%; height: 100%;
    image-rendering: pixelated;
    pointer-events: none;
    z-index: 1;
  }

  .brush-cursor-indicator {
    position: absolute;
    pointer-events: none;
    border: 1.5px solid #fff;
    transform: translate(-50%, -50%);
    box-shadow: 0 0 6px rgba(0,0,0,0.6);
    z-index: 5;
    display: none;
  }

  /* ── Floating 1x Mini Emote Preview Widget ── */
  .mini-emote-widget {
    position: absolute;
    top: 1rem;
    right: 1rem;
    width: 220px;
    background: rgba(15, 23, 42, 0.92);
    backdrop-filter: blur(10px);
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 12px;
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.6);
    padding: 0.6rem;
    z-index: 15;
  }

  .widget-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 0.4rem;
  }
  .widget-title {
    font-size: 0.675rem;
    font-weight: 800;
    color: #e2e8f0;
  }
  .widget-scale-toggles {
    display: flex;
    gap: 2px;
  }
  .scale-toggle {
    padding: 0.15rem 0.35rem;
    font-size: 0.575rem;
    font-weight: 700;
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 4px;
    color: #94a3b8;
    cursor: pointer;
  }
  .scale-toggle.active {
    background: rgba(0, 234, 200, 0.2);
    border-color: #00eac8;
    color: #00eac8;
  }

  .chat-preview-box {
    background: #181f2a;
    border-radius: 8px;
    padding: 0.5rem;
  }
  .chat-msg {
    display: flex;
    gap: 0.4rem;
  }
  .chat-avatar { font-size: 1rem; }
  .chat-content { display: flex; flex-direction: column; gap: 2px; }
  .chat-user { font-size: 0.625rem; font-weight: 700; color: #38bdf8; }
  .chat-bubble {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.675rem;
    color: #cbd5e1;
  }
  .mini-preview-canvas {
    width: 48px;
    height: 48px;
    image-rendering: pixelated;
    background: rgba(0, 0, 0, 0.2);
    border-radius: 4px;
    flex-shrink: 0;
  }

  /* ── Zoom Controls ── */
  .zoom-floating-controls {
    position: absolute;
    bottom: 1rem;
    right: 1rem;
    display: flex;
    align-items: center;
    gap: 2px;
    background: rgba(15, 23, 42, 0.88);
    backdrop-filter: blur(8px);
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 10px;
    padding: 3px;
    box-shadow: 0 4px 16px rgba(0,0,0,0.5);
    z-index: 15;
  }
  .zoom-btn, .zoom-level-btn {
    background: transparent;
    border: none;
    border-radius: 6px;
    color: #cbd5e1;
    font-size: 0.75rem;
    font-weight: 700;
    padding: 0.25rem 0.45rem;
    cursor: pointer;
  }
  .zoom-btn:hover, .zoom-level-btn:hover { background: rgba(255, 255, 255, 0.1); color: #fff; }
  .pan-toggle-btn.active { background: rgba(0, 234, 200, 0.25); color: #00eac8; }

  /* ── Bottom Dock (Palette + Timeline) ── */
  .emoji-bottom-dock {
    display: flex;
    flex-direction: column;
    background: rgba(15, 23, 42, 0.95);
    backdrop-filter: blur(12px);
    border-top: 1px solid rgba(255, 255, 255, 0.08);
    z-index: 20;
    flex-shrink: 0;
  }

  /* ── Palette Bar ── */
  .emoji-palette-bar {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    padding: 0.45rem 1rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.05);
    overflow-x: auto;
  }

  .color-picker-group {
    display: flex;
    align-items: center;
    gap: 0.35rem;
  }
  .custom-color-swatch {
    position: relative;
    width: 22px; height: 22px;
    border-radius: 6px;
    background: #FF0055;
    border: 1.5px solid #fff;
    cursor: pointer;
    overflow: hidden;
  }
  .custom-color-swatch input[type="color"] {
    position: absolute; top: -50%; left: -50%; width: 200%; height: 200%; opacity: 0; cursor: pointer;
  }
  .custom-hex-label { font-size: 0.675rem; font-weight: 800; color: #cbd5e1; }

  .palette-swatches {
    display: flex;
    gap: 4px;
  }
  .color-swatch {
    width: 18px; height: 18px;
    border-radius: 4px;
    border: 1px solid rgba(255, 255, 255, 0.15);
    cursor: pointer;
    transition: transform 0.12s;
  }
  .color-swatch:hover { transform: scale(1.18); }
  .color-swatch.active { border-color: #fff; transform: scale(1.15); box-shadow: 0 0 6px #fff; }

  .palette-divider, .timeline-divider {
    width: 1px;
    height: 24px;
    background: rgba(255, 255, 255, 0.08);
    flex-shrink: 0;
  }

  .quick-brush-controls {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }
  .size-control-group, .tip-control-group, .opacity-control-group {
    display: flex;
    align-items: center;
    gap: 0.35rem;
  }
  .control-label { font-size: 0.65rem; font-weight: 700; color: #94a3b8; }
  .control-val { font-size: 0.65rem; font-weight: 800; color: #38bdf8; min-width: 24px; }
  .quick-slider { width: 65px; }

  .size-pills, .opacity-pills { display: flex; gap: 2px; }
  .size-pill, .opacity-pill {
    padding: 0.15rem 0.35rem;
    font-size: 0.625rem;
    font-weight: 700;
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 4px;
    color: #94a3b8;
    cursor: pointer;
  }
  .size-pill.active, .opacity-pill.active {
    background: rgba(0, 234, 200, 0.2);
    border-color: #00eac8;
    color: #00eac8;
  }

  .preset-badges-group { display: flex; gap: 4px; }
  .preset-btn {
    padding: 0.2rem 0.5rem;
    font-size: 0.65rem;
    font-weight: 700;
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 6px;
    color: #cbd5e1;
    cursor: pointer;
  }
  .preset-btn:hover { background: rgba(255, 255, 255, 0.1); color: #fff; }

  /* ── Multi-Frame Timeline Bar ── */
  .emoji-timeline-bar {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.5rem 1rem;
    background: rgba(10, 15, 28, 0.98);
  }

  .timeline-playback-group {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .play-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.35rem 0.85rem;
    background: #10b981;
    border: none;
    border-radius: 8px;
    color: #fff;
    font-size: 0.75rem;
    font-weight: 800;
    cursor: pointer;
    box-shadow: 0 0 10px rgba(16, 185, 129, 0.4);
    transition: all 0.15s ease;
  }
  .play-btn:hover { transform: translateY(-1px); box-shadow: 0 0 16px rgba(16, 185, 129, 0.6); }
  .play-btn.is-playing {
    background: #f59e0b;
    box-shadow: 0 0 12px rgba(245, 158, 11, 0.4);
  }

  .fps-select-wrap {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    background: rgba(30, 41, 59, 0.95);
    border: 1.5px solid rgba(56, 189, 248, 0.35);
    border-radius: 8px;
    padding: 0.25rem 0.6rem;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.3);
  }
  .fps-label {
    font-size: 0.75rem;
    font-weight: 800;
    color: #38bdf8;
    letter-spacing: 0.02em;
  }
  .fps-select {
    background: transparent;
    border: none;
    color: #ffffff;
    font-size: 0.825rem;
    font-weight: 800;
    cursor: pointer;
    outline: none;
    padding: 0.1rem 0.2rem;
  }
  .fps-select option {
    background-color: #0f172a;
    color: #f8fafc;
    font-size: 0.85rem;
    font-weight: 600;
    padding: 6px 12px;
  }

  .onion-toggle-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.3rem 0.6rem;
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 6px;
    color: #94a3b8;
    font-size: 0.675rem;
    font-weight: 700;
    cursor: pointer;
  }
  .onion-toggle-btn.active {
    background: rgba(234, 179, 8, 0.15);
    border-color: #eab308;
    color: #fef08a;
  }

  /* ── Frame Strip ── */
  .timeline-strip-wrap {
    flex: 1;
    overflow-x: auto;
    display: flex;
    align-items: center;
  }
  .timeline-frame-strip {
    display: flex;
    gap: 6px;
    align-items: center;
    padding: 2px 0;
  }

  .frame-thumb-card {
    position: relative;
    width: 44px;
    height: 44px;
    background: #020617;
    border: 2px solid rgba(255, 255, 255, 0.12);
    border-radius: 8px;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all 0.12s ease;
    flex-shrink: 0;
  }
  .frame-thumb-card:hover {
    border-color: rgba(255, 255, 255, 0.3);
  }
  .frame-thumb-card.active {
    border-color: #00eac8;
    box-shadow: 0 0 10px rgba(0, 234, 200, 0.5);
    background: #0f172a;
  }

  .thumb-canvas {
