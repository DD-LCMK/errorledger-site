    box-shadow: 0 20px 50px rgba(0, 0, 0, 0.5);
  }

  .summary-hero {
    text-align: center;
    margin-bottom: 2rem;
  }

  .summary-badge-wrap {
    margin-bottom: 0.85rem;
  }

  .summary-rank-badge {
    display: inline-block;
    padding: 0.4rem 1.25rem;
    font-size: 0.85rem;
    font-weight: 800;
    border-radius: 9999px;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    transition: all 0.3s ease;
  }

  .summary-rank-badge.rank-s {
    color: #fbbf24;
    background: rgba(251, 191, 36, 0.15);
    border: 1px solid rgba(251, 191, 36, 0.4);
    box-shadow: 0 0 20px rgba(251, 191, 36, 0.35);
  }

  .summary-rank-badge.rank-a {
    color: #f97316;
    background: rgba(249, 115, 22, 0.15);
    border: 1px solid rgba(249, 115, 22, 0.4);
    box-shadow: 0 0 20px rgba(249, 115, 22, 0.35);
  }

  .summary-rank-badge.rank-b {
    color: #38bdf8;
    background: rgba(56, 189, 248, 0.15);
    border: 1px solid rgba(56, 189, 248, 0.4);
    box-shadow: 0 0 20px rgba(56, 189, 248, 0.35);
  }

  .summary-rank-badge.rank-c {
    color: #a855f7;
    background: rgba(168, 85, 247, 0.15);
    border: 1px solid rgba(168, 85, 247, 0.4);
    box-shadow: 0 0 20px rgba(168, 85, 247, 0.35);
  }

  .summary-title {
    font-size: 2.2rem;
    font-weight: 900;
    margin: 0 0 0.5rem;
    background: linear-gradient(135deg, #ffffff 30%, #38bdf8 70%, #818cf8 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .summary-desc {
    font-size: 1rem;
    color: #94a3b8;
    margin: 0 0 1.75rem;
  }

  /* Score Dashboard Card */
  .summary-score-dashboard {
    background: rgba(30, 41, 59, 0.5);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 20px;
    padding: 1.75rem;
    margin-bottom: 2rem;
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.05);
  }

  .score-main-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    flex-wrap: wrap;
    margin-bottom: 1.25rem;
  }

  .score-display-box {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.5rem;
  }

  .score-number-wrap {
    display: flex;
    align-items: baseline;
    gap: 0.3rem;
    line-height: 1;
  }

  .big-score {
    font-size: 4rem;
    font-weight: 900;
    color: #38bdf8;
    text-shadow: 0 0 30px rgba(56, 189, 248, 0.5);
  }

  .score-divider {
    font-size: 2.2rem;
    color: #475569;
    font-weight: 700;
  }

  .total-score {
    font-size: 2.2rem;
    font-weight: 800;
