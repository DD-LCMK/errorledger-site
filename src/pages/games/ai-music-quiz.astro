    border: 1px solid rgba(255, 255, 255, 0.05);
  }

  .guide-icon {
    font-size: 1.6rem;
    line-height: 1;
    flex-shrink: 0;
  }

  .guide-text strong {
    display: block;
    font-size: 0.95rem;
    color: #38bdf8;
    margin-bottom: 0.25rem;
  }

  .guide-text p {
    font-size: 0.85rem;
    color: #94a3b8;
    margin: 0;
    line-height: 1.4;
  }

  /* Settings Box */
  .settings-box {
    background: rgba(30, 41, 59, 0.4);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 16px;
    padding: 1.5rem;
    margin-bottom: 2rem;
  }

  .settings-label {
    display: block;
    font-size: 0.95rem;
    font-weight: 700;
    color: #cbd5e1;
    margin-bottom: 1rem;
  }

  .round-options-group {
    display: flex;
    justify-content: center;
    gap: 0.75rem;
    flex-wrap: wrap;
    margin-bottom: 1rem;
  }

  .round-btn {
    padding: 0.65rem 1.4rem;
    font-size: 0.95rem;
    font-weight: 700;
    color: #cbd5e1;
    background: rgba(15, 23, 42, 0.6);
    border: 1px solid rgba(255, 255, 255, 0.15);
    border-radius: 10px;
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .round-btn:hover {
    background: rgba(56, 189, 248, 0.15);
    border-color: #38bdf8;
    color: #38bdf8;
  }

  .round-btn.active {
    background: linear-gradient(135deg, #0284c7, #38bdf8);
