    cursor: pointer;
  }

  .checkbox-label input {
    accent-color: #38bdf8;
    cursor: pointer;
  }

  /* Volume Controls (Lobby & In-Game) */
  .lobby-volume-option {
    margin-top: 1rem;
    padding-top: 1rem;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
  }

  .volume-label {
    display: block;
    font-size: 0.85rem;
    font-weight: 700;
    color: #94a3b8;
    margin-bottom: 0.6rem;
  }

  .volume-control-pill,
  .master-volume-control {
    display: inline-flex;
    align-items: center;
    gap: 0.65rem;
    background: rgba(15, 23, 42, 0.85);
