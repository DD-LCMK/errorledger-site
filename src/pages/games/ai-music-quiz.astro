  }

  .volume-control-pill:hover,
  .master-volume-control:hover {
    border-color: rgba(56, 189, 248, 0.5);
    box-shadow: 0 0 16px rgba(56, 189, 248, 0.2);
  }

  .vol-mute-btn {
    background: transparent;
    border: none;
    font-size: 1.05rem;
    cursor: pointer;
    padding: 0.1rem 0.2rem;
    line-height: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 6px;
    transition: transform 0.15s ease;
  }

  .vol-mute-btn:hover {
    transform: scale(1.15);
  }

  .vol-slider-wrap {
    position: relative;
    width: 100px;
    height: 18px;
    display: flex;
    align-items: center;
  }

  .vol-slider {
    -webkit-appearance: none;
    appearance: none;
    width: 100%;
    height: 6px;
    border-radius: 3px;
    background: rgba(255, 255, 255, 0.15);
    outline: none;
    cursor: pointer;
    position: relative;
    z-index: 2;
  }

  .vol-slider::-webkit-slider-thumb {
    -webkit-appearance: none;
    appearance: none;
    width: 14px;
    height: 14px;
    border-radius: 50%;
    background: #38bdf8;
    box-shadow: 0 0 8px rgba(56, 189, 248, 0.9);
    cursor: pointer;
    transition: transform 0.1s ease;
  }

  .vol-slider::-webkit-slider-thumb:hover {
    transform: scale(1.25);
  }

  .vol-slider-fill {
    position: absolute;
    left: 0;
    top: 50%;
    transform: translateY(-50%);
    height: 6px;
    border-radius: 3px;
    background: linear-gradient(90deg, #0284c7, #38bdf8);
    pointer-events: none;
    z-index: 1;
  }

  .vol-percent-text {
    font-size: 0.8rem;
    font-family: monospace;
    font-weight: 700;
    color: #e2e8f0;
    min-width: 38px;
    text-align: right;
  }

  .glow-start-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 1rem 3rem;
    font-size: 1.25rem;
    font-weight: 900;
    color: #ffffff;
    background: linear-gradient(135deg, #0284c7 0%, #38bdf8 50%, #818cf8 100%);
    border: none;
    border-radius: 9999px;
    cursor: pointer;
    box-shadow: 0 0 25px rgba(56, 189, 248, 0.5);
    transition: all 0.25s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .glow-start-btn:hover {
    transform: translateY(-2px) scale(1.03);
    box-shadow: 0 0 35px rgba(56, 189, 248, 0.8);
  }

  /* 2. PLAYING SCREEN STYLES */
  .quiz-top-bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    padding: 0.85rem 1.25rem;
    background: rgba(15, 23, 42, 0.7);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 14px;
    margin-bottom: 1.25rem;
  }

  .round-indicator {
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }

  .round-badge {
    font-size: 0.75rem;
    font-weight: 800;
    color: #38bdf8;
    background: rgba(56, 189, 248, 0.15);
    padding: 0.2rem 0.6rem;
    border-radius: 6px;
  }

  .round-number {
    font-size: 1.1rem;
    font-weight: 800;
    color: #ffffff;
  }

  .score-indicator {
    font-size: 0.95rem;
    color: #cbd5e1;
  }

  .score-indicator strong {
    color: #4ade80;
    font-size: 1.15rem;
    margin-left: 0.3rem;
  }

  /* Audio Stage Card */
  .audio-stage-card {
    background: rgba(15, 23, 42, 0.75);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 20px;
    padding: 2.5rem 1.5rem 2rem;
    text-align: center;
    backdrop-filter: blur(12px);
    box-shadow: 0 16px 36px rgba(0, 0, 0, 0.4);
    margin-bottom: 1.5rem;
  }

  .disc-visualizer-wrap {
    position: relative;
    width: 140px;
    height: 140px;
    margin: 0 auto 1.5rem;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .disc-glow {
    position: absolute;
    inset: -10px;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(56, 189, 248, 0.35) 0%, transparent 70%);
    opacity: 0.4;
    transition: all 0.3s ease;
  }

  .disc-glow.pulsing {
    opacity: 1;
    animation: discPulse 1.5s infinite alternate;
  }

  @keyframes discPulse {
    0% { transform: scale(0.95); opacity: 0.5; }
    100% { transform: scale(1.15); opacity: 1; }
  }

  .speaker-action-btn {
    position: relative;
    width: 120px;
    height: 120px;
    border-radius: 50%;
    background: linear-gradient(135deg, #1e293b, #0f172a);
    border: 2px solid #38bdf8;
    box-shadow: 0 0 25px rgba(56, 189, 248, 0.35);
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all 0.25s ease;
    z-index: 2;
  }

  .speaker-action-btn:hover {
    transform: scale(1.06);
    box-shadow: 0 0 35px rgba(56, 189, 248, 0.6);
  }

  .speaker-icon {
    font-size: 3rem;
    line-height: 1;
    filter: drop-shadow(0 0 8px rgba(56, 189, 248, 0.5));
  }

  /* Equalizer Animation */
  .equalizer-bars {
    display: flex;
    align-items: flex-end;
    justify-content: center;
    gap: 6px;
    height: 28px;
    margin-bottom: 1rem;
    opacity: 0.3;
    transition: opacity 0.3s ease;
  }

  .equalizer-bars.active {
    opacity: 1;
  }

  .equalizer-bars .bar {
    width: 4px;
    height: 6px;
    background: #38bdf8;
    border-radius: 2px;
  }

  .equalizer-bars.active .bar {
    animation: eqBounce 1s infinite alternate ease-in-out;
  }

  .equalizer-bars.active .bar:nth-child(1) { animation-delay: 0.1s; }
  .equalizer-bars.active .bar:nth-child(2) { animation-delay: 0.3s; }
  .equalizer-bars.active .bar:nth-child(3) { animation-delay: 0.2s; }
  .equalizer-bars.active .bar:nth-child(4) { animation-delay: 0.5s; }
  .equalizer-bars.active .bar:nth-child(5) { animation-delay: 0.15s; }
  .equalizer-bars.active .bar:nth-child(6) { animation-delay: 0.4s; }
  .equalizer-bars.active .bar:nth-child(7) { animation-delay: 0.25s; }
  .equalizer-bars.active .bar:nth-child(8) { animation-delay: 0.35s; }

  @keyframes eqBounce {
    0% { height: 6px; }
    100% { height: 26px; }
  }

  .player-status-text {
    font-size: 0.95rem;
    font-weight: 600;
    color: #94a3b8;
    margin-bottom: 1.5rem;
  }

  /* Scrubber Control Group */
  .scrubber-control-group {
    display: flex;
    align-items: center;
    gap: 1rem;
    max-width: 600px;
    margin: 0 auto 1.25rem;
  }

  .time-label {
    font-size: 0.85rem;
    font-family: monospace;
    color: #cbd5e1;
    min-width: 42px;
  }

  .scrubber-wrapper {
    position: relative;
    flex: 1;
    display: flex;
    align-items: center;
  }

  .audio-scrubber {
    -webkit-appearance: none;
    appearance: none;
    width: 100%;
    height: 8px;
    border-radius: 4px;
    background: rgba(255, 255, 255, 0.15);
    outline: none;
    cursor: pointer;
    position: relative;
    z-index: 2;
  }

  .audio-scrubber::-webkit-slider-thumb {
    -webkit-appearance: none;
    appearance: none;
    width: 18px;
    height: 18px;
    border-radius: 50%;
    background: #38bdf8;
    box-shadow: 0 0 10px rgba(56, 189, 248, 0.8);
    cursor: pointer;
    transition: transform 0.1s ease;
  }

  .audio-scrubber::-webkit-slider-thumb:hover {
    transform: scale(1.2);
  }

  .audio-quick-controls {
    display: flex;
    justify-content: center;
    gap: 0.75rem;
    margin-bottom: 1.5rem;
  }

  .quick-ctl-btn {
    padding: 0.45rem 0.9rem;
    font-size: 0.85rem;
    font-weight: 700;
    color: #cbd5e1;
    background: rgba(30, 41, 59, 0.6);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 8px;
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .quick-ctl-btn:hover {
    background: rgba(56, 189, 248, 0.15);
    border-color: #38bdf8;
    color: #38bdf8;
  }

  /* Hint Display */
  .hint-container {
    display: inline-block;
  }

  .hint-toggle-btn {
    padding: 0.4rem 1rem;
    font-size: 0.85rem;
    font-weight: 700;
    color: #f59e0b;
    background: rgba(245, 158, 11, 0.1);
    border: 1px solid rgba(245, 158, 11, 0.3);
    border-radius: 20px;
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .hint-toggle-btn:hover {
    background: rgba(245, 158, 11, 0.2);
    box-shadow: 0 0 12px rgba(245, 158, 11, 0.3);
  }

  .hint-display-box {
    margin-top: 0.75rem;
    padding: 0.75rem 1.25rem;
    background: rgba(30, 41, 59, 0.7);
    border: 1px solid rgba(245, 158, 11, 0.3);
    border-radius: 12px;
    display: flex;
    gap: 1.5rem;
    justify-content: center;
  }

  .hint-display-box.hidden {
    display: none;
  }

  .hint-tag {
    font-size: 0.75rem;
    color: #94a3b8;
    margin-right: 0.4rem;
  }

  .hint-val {
    font-size: 0.95rem;
    color: #fbbf24;
    font-weight: 800;
    letter-spacing: 0.05em;
  }

  /* Answer Input Card */
  .answer-card {
    background: rgba(15, 23, 42, 0.75);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 16px;
    padding: 1.5rem;
    box-shadow: 0 12px 28px rgba(0, 0, 0, 0.4);
  }

  .input-row {
    display: flex;
    gap: 0.75rem;
    margin-bottom: 0.75rem;
  }

  .answer-input {
    flex: 1;
    padding: 0.9rem 1.25rem;
    font-size: 1.1rem;
    color: #ffffff;
    background: rgba(30, 41, 59, 0.7);
    border: 2px solid rgba(255, 255, 255, 0.15);
    border-radius: 12px;
    outline: none;
    transition: all 0.2s ease;
  }

  .answer-input:focus {
    border-color: #38bdf8;
    box-shadow: 0 0 16px rgba(56, 189, 248, 0.4);
  }

  .btn-submit {
    padding: 0 1.75rem;
    font-size: 1rem;
    font-weight: 800;
    color: #ffffff;
    background: linear-gradient(135deg, #0284c7, #38bdf8);
    border: none;
    border-radius: 12px;
    cursor: pointer;
    box-shadow: 0 0 16px rgba(56, 189, 248, 0.4);
    transition: all 0.2s ease;
    white-space: nowrap;
  }

  .btn-submit:hover {
    transform: translateY(-1px);
    box-shadow: 0 0 24px rgba(56, 189, 248, 0.6);
  }

  .form-bottom-actions {
    display: flex;
    justify-content: flex-end;
  }

  .btn-skip {
    background: none;
    border: none;
    color: #94a3b8;
    font-size: 0.9rem;
    font-weight: 600;
    cursor: pointer;
    padding: 0.3rem 0.6rem;
    border-radius: 6px;
    transition: color 0.2s;
  }

  .btn-skip:hover {
    color: #f87171;
    background: rgba(248, 113, 113, 0.1);
  }

  /* 3. REVEAL SCREEN STYLES */
  .reveal-banner {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    padding: 1.25rem 2rem;
    border-radius: 16px;
    margin-bottom: 2rem;
    backdrop-filter: blur(12px);
  }

  .reveal-banner.correct {
    background: rgba(34, 197, 94, 0.15);
    border: 1px solid rgba(34, 197, 94, 0.4);
    box-shadow: 0 0 25px rgba(34, 197, 94, 0.25);
  }

  .reveal-banner.incorrect {
    background: rgba(239, 68, 68, 0.15);
    border: 1px solid rgba(239, 68, 68, 0.4);
    box-shadow: 0 0 25px rgba(239, 68, 68, 0.25);
  }

  .result-icon {
    font-size: 2.75rem;
    line-height: 1;
  }

  .result-headline {
    font-size: 1.75rem;
    font-weight: 900;
    margin: 0 0 0.25rem;
  }

  .reveal-banner.correct .result-headline { color: #4ade80; }
  .reveal-banner.incorrect .result-headline { color: #f87171; }

  .result-subline {
    font-size: 1.1rem;
    color: #f1f5f9;
    margin: 0;
    font-weight: 700;
  }

  /* Comparison Grid (Side by Side) */
  .comparison-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.5rem;
    margin-bottom: 2rem;
  }

  @media (max-width: 768px) {
    .comparison-grid {
      grid-template-columns: 1fr;
    }
  }

  .video-compare-card {
    background: rgba(15, 23, 42, 0.8);
    border-radius: 16px;
    overflow: hidden;
    border: 1px solid rgba(255, 255, 255, 0.1);
    box-shadow: 0 12px 28px rgba(0, 0, 0, 0.4);
    display: flex;
    flex-direction: column;
  }

  .video-compare-card.ai-card {
    border-color: rgba(56, 189, 248, 0.4);
  }

  .video-compare-card.original-card {
    border-color: rgba(168, 85, 247, 0.4);
  }

  .card-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 0.9rem 1.25rem;
    background: rgba(30, 41, 59, 0.6);
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
  }

  .card-header .badge {
    padding: 0.3rem 0.75rem;
    font-size: 0.85rem;
    font-weight: 800;
    border-radius: 6px;
  }

  .ai-badge {
    background: rgba(56, 189, 248, 0.2);
    color: #38bdf8;
    border: 1px solid rgba(56, 189, 248, 0.4);
  }

  .original-badge {
    background: rgba(168, 85, 247, 0.2);
    color: #c084fc;
    border: 1px solid rgba(168, 85, 247, 0.4);
  }

  .audio-cue {
    font-size: 0.8rem;
    color: #94a3b8;
  }

  .iframe-embed-wrap {
    position: relative;
    width: 100%;
    padding-top: 56.25%; /* 16:9 Aspect Ratio */
    background: #000000;
  }

  .reveal-iframe {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    border: none;
  }

  .card-footer {
    padding: 0.75rem 1rem;
    background: rgba(15, 23, 42, 0.6);
    text-align: center;
  }

  .info-note {
    font-size: 0.75rem;
    color: #94a3b8;
  }

  .reveal-action-bar {
    text-align: center;
  }

  .glow-next-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 1rem 3.5rem;
    font-size: 1.2rem;
    font-weight: 800;
    color: #ffffff;
    background: linear-gradient(135deg, #059669, #10b981);
    border: none;
    border-radius: 9999px;
    cursor: pointer;
    box-shadow: 0 0 25px rgba(16, 185, 129, 0.5);
    transition: all 0.2s ease;
  }

  .glow-next-btn:hover {
    transform: translateY(-2px) scale(1.02);
    box-shadow: 0 0 35px rgba(16, 185, 129, 0.7);
  }

  /* 4. SUMMARY SCREEN STYLES */
  .summary-card {
    background: rgba(15, 23, 42, 0.75);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 24px;
    padding: 2.5rem 2rem;
