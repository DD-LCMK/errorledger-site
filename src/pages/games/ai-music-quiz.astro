  .total-icon { background: rgba(56, 189, 248, 0.15); color: #38bdf8; }

  .stat-info {
    display: flex;
    flex-direction: column;
  }

  .stat-label {
    font-size: 0.75rem;
    color: #94a3b8;
    font-weight: 600;
  }

  .stat-val {
    font-size: 1.3rem;
    font-weight: 800;
    color: #ffffff;
