---
import GameLayout from '../../layouts/GameLayout.astro';
import { getEntry } from 'astro:content';

const gameEntry = await getEntry('games', 'sword-enhance');
const data = gameEntry?.data || {
  title: '전설의 +20강 무기 강화 (Sword Enhancer)',
  tagline: '+0강 나뭇가지에서 +20강 우주파괴 신검까지! 무기 보관함·파괴방지권 자금 운영 강화 시뮬레이터',
  description: '한국 게이머들의 영원한 도파민! 무기를 강화해 판매하거나 보관함에 백업하고, 골드를 모아 파괴방지 주문서를 구매하며 전설의 +20강 우주파괴 신검에 도전하세요.',
  icon: '🗡️',
  category: 'arcade',
  badge: '🗡️ 도파민 강화',
  players: '1인 하드코어 강화',
  playTime: '3~15분 (큐 대기용)',
  controls: [
    '[🔨 강화 도전] 버튼 클릭 또는 스페이스바(Space)로 강화 시도',
    '[📥 보관함 저장]으로 고강화 무기를 인벤토리에 백업하고 +0강부터 새 무기 제작',
    '[💰 감정가 판매]로 무기를 팔아 강화 자금 및 파괴방지 주문서 구매 골드 확보',
    '별캐치(Star Catch) 활성화 시 황금 구간 클릭 시 +3%p 보너스 (빗나갈 경우 -2%p 페널티!)'
  ],
  rules: [
    '+0강부터 +20강까지 총 21단계의 무기가 존재하며, +4강부터 하락 위험이, +9강부터 무기 파괴(증발) 확률이 등장합니다.',
    '무기를 보관함(최대 6슬롯)에 저장하거나 판매하면 모루 위에 새로운 +0강 나뭇가지가 지급되며, 보관함의 무기는 언제든 다시 꺼내 이어서 강화할 수 있습니다.',
    '파괴방지 주문서는 상점에서 골드로 직접 구매해야 하며(구매할수록 가격 상승), 고등급일수록 1회 강화에 더 많은 주문서가 소모됩니다 (+18강 이상은 주문서 사용 불가).',
    '파산 구제금(+1,000 G)은 보유 골드 부족 + 현재 무기 +0강 + 보관함이 완전히 비어있는 진짜 파산 상태에서만 신청할 수 있습니다.'
  ],
  faqItems: [
    {
      q: '골드와 파괴방지 주문서는 어떻게 모으나요?',
      a: '무기를 +6강~+11강까지 띄운 뒤 [💰 감정가 판매]로 익절하여 종잣돈을 모으세요. 예비용 고강화 검을 [📥 보관함]에 넣어두고 다른 검으로 골드를 파밍하는 것이 핵심 공략입니다.'
    },
    {
      q: '파괴방지 주문서를 쓰면 어떻게 되나요?',
      a: '강화 시도에 필요한 개수만큼 주문서가 즉시 소모되며, 만약 파괴 확률에 걸리더라도 무기가 증발하지 않고 -1강 하락으로 방어됩니다. 단, +18강 이상 초월 구간에서는 주문서가 통하지 않습니다.'
    },
    {
      q: '지원금 리필(파산 구제)이 왜 비활성화되어 있나요?',
      a: '무한 리필 악용을 막기 위해, 현재 무기가 +0강이고 보관함에 저장된 무기가 하나도 없으며 보유 골드가 100 G 미만인 완전 파산 상태에서만 1,000 G 긴급 구제금이 지급됩니다.'
    }
  ]
};
---

<GameLayout
  title={data.title}
  description={data.description}
  tagline={data.tagline}
  icon={data.icon}
  category={data.category}
  badge={data.badge}
  players={data.players}
  playTime={data.playTime}
  controls={data.controls}
  rules={data.rules}
  faqItems={data.faqItems}
  layoutMode="full"
  hideStageHeader={true}
  hideFooter={false}
>
  <div class="enhance-root" id="enhance-root">
    <!-- Main 2-Column Layout -->
    <div class="enhance-main-grid">
      <!-- Left: Forge Canvas Stage, Action Controls & Weapon Inventory -->
      <section class="forge-stage-col">
        <div class="forge-canvas-card" id="forge-canvas-card">
          <!-- Top HUD Overlay inside Canvas -->
          <div class="forge-hud-top">
            <div class="weapon-tier-chip" id="weapon-tier-chip">일반 (COMMON)</div>
            <div class="sword-stack-chip" id="sword-stack-chip" title="이 무기로 10연속 강화 실패 시마다 이 무기에 영구 성공률 +1%p가 누적됩니다 (보관함 이동 시에도 유지)">
              🔥 무기 스택: <strong id="sword-stack-val">+0%p (0/10)</strong>
            </div>
            <div class="best-record-chip">
              <span id="ui-best-label">🏆 최고 기록:</span>
              <strong id="best-level-val">+0강</strong>
            </div>
          </div>

          <!-- Weapon Title & Level Display -->
          <div class="weapon-header-overlay">
            <div class="weapon-level-big" id="weapon-level-big">+0</div>
            <h2 class="weapon-name-title" id="weapon-name-title">부러진 나뭇가지</h2>
            <p class="weapon-flavor-desc" id="weapon-flavor-desc">앞마당에서 주운 흔한 나뭇가지. 무기를 키워 팔거나 보관함에 백업하세요!</p>
          </div>

          <!-- Forge & Weapon Canvas -->
          <canvas id="forge-canvas" width="680" height="390"></canvas>

          <!-- Star Catch Timing Mini-Game Bar -->
          <div class="starcatch-overlay hidden" id="starcatch-overlay">
            <div class="starcatch-title" id="ui-starcatch-title">🌟 황금 구간 클릭/Space: +3%p 보너스 | 빗나가면 -2%p 페널티!</div>
            <div class="starcatch-track">
              <div class="starcatch-zone-blue"></div>
              <div class="starcatch-zone-gold"></div>
              <div class="starcatch-cursor" id="starcatch-cursor">⭐</div>
            </div>
          </div>

          <!-- Result Toast Banner -->
          <div class="forge-result-banner hidden" id="forge-result-banner"></div>

          <!-- Memorial Portrait Modal (Shown when Weapon is Destroyed!) -->
          <div class="memorial-overlay hidden" id="memorial-overlay">
            <div class="memorial-frame">
              <div class="memorial-ribbon-left"></div>
              <div class="memorial-ribbon-right"></div>
              <div class="memorial-badge" id="ui-memorial-badge">🕯️ 삼가 무기의 명복을 빕니다 🕯️</div>
              <div class="memorial-sword-icon" id="memorial-sword-icon">🗡️</div>
              <h3 class="memorial-weapon-name" id="memorial-weapon-name">고(故) +12강 심연의 뇌전검</h3>
              <p class="memorial-epitaph" id="memorial-epitaph">찬란하게 빛나던 검신이 욕망의 망치질을 견디지 못하고 별가루가 되어 흩어졌습니다...</p>
              <div class="memorial-candles">🕯️ 🌼 🕯️</div>
              <button type="button" class="btn-memorial-restart" id="btn-memorial-restart">
                <span>🙏 묵념 후 +0강 나뭇가지로 다시 시작 (Space)</span>
              </button>
            </div>
          </div>

          <!-- Bottom Appraisal & Next Odds Strip -->
          <div class="forge-odds-strip">
            <div class="odds-item success">
              <span class="odds-label" id="ui-odds-success">✨ 성공 확률</span>
              <strong class="odds-val" id="odds-success-val">95%</strong>
            </div>
            <div class="odds-item keep">
              <span class="odds-label" id="ui-odds-keep">💨 유지(미끄러짐)</span>
              <strong class="odds-val" id="odds-keep-val">5%</strong>
            </div>
            <div class="odds-item down">
              <span class="odds-label" id="ui-odds-down">📉 하락(-1~-2강)</span>
              <strong class="odds-val" id="odds-down-val">0%</strong>
            </div>
            <div class="odds-item destroy">
              <span class="odds-label" id="ui-odds-destroy">💀 파괴(증발)</span>
              <strong class="odds-val" id="odds-destroy-val">0%</strong>
            </div>
          </div>
        </div>

        <!-- Forge Action Buttons Bar -->
        <div class="forge-actions-bar">
          <!-- Protection Scroll & Star Catch Toggles -->
          <div class="forge-toggles-row">
            <label class="forge-toggle-pill protect-pill" id="protect-toggle-label">
              <input type="checkbox" id="chk-protect-scroll" />
              <span id="ui-protect-text">🛡️ 파괴방지 주문서 적용 (보유: 0장)</span>
            </label>

            <label class="forge-toggle-pill starcatch-pill" title="황금 구간 명중 시 +3%p, 푸른 구간 +1%p, 빗나갈 시 -2%p">
              <input type="checkbox" id="chk-starcatch" checked />
              <span id="ui-starcatch-toggle">🌟 별캐치 손컨 (성공 +3%p / 실패 -2%p)</span>
            </label>
          </div>

          <!-- Primary Enhance, Store in Inventory, & Sell Buttons -->
          <div class="forge-main-btns">
            <button type="button" class="btn-enhance-main" id="btn-enhance-main">
              <span class="btn-hammer-icon">🔨</span>
              <div class="btn-enhance-texts">
                <span class="enhance-main-title" id="btn-enhance-title">+1강 강화 도전하기 (Space)</span>
                <span class="enhance-cost-sub" id="btn-enhance-cost">소모 비용: 100 G</span>
              </div>
            </button>

            <button type="button" class="btn-store-weapon" id="btn-store-weapon" title="현재 무기를 보관함에 저장하고 +0강 나뭇가지부터 새로 키웁니다">
              <span class="store-icon">📥</span>
              <div class="store-texts">
                <span class="store-title" id="ui-store-title">보관함에 저장</span>
                <span class="store-sub" id="store-slot-sub">새 무기(+0) 시작</span>
              </div>
            </button>

            <button type="button" class="btn-sell-weapon" id="btn-sell-weapon" title="현재 무기를 감정가에 판매하고 +0강부터 새로 시작합니다">
              <span class="sell-icon">💰</span>
              <div class="sell-texts">
                <span class="sell-title" id="ui-sell-title">감정가 판매 (익절)</span>
                <span class="sell-price" id="sell-price-val">+0 G</span>
              </div>
            </button>
          </div>
        </div>

        <!-- Weapon Inventory Section (Save / Equip / Sell Backup Swords) -->
        <div class="inventory-card">
          <div class="inventory-head">
            <div class="inventory-title-wrap">
              <span class="inv-icon">🎒</span>
              <h3 class="inv-title" id="ui-inv-title">무기 보관함 (인벤토리)</h3>
              <span class="inv-count-badge" id="inv-count-badge">0 / 6</span>
            </div>
            <span class="inv-hint" id="ui-inv-hint">고강화 무기를 백업해두고 새 무기로 골드를 파밍하거나 언제든 꺼내서 이어 강화하세요!</span>
          </div>
          <div class="inventory-grid" id="inventory-grid">
            <!-- Populated by JS -->
          </div>
        </div>
      </section>

      <!-- Right: Economy, Scroll Shop, Stats, Probability Table & Live Log -->
      <aside class="forge-sidebar-col">
        <!-- Header & Utility Buttons -->
        <div class="sidebar-card utility-top-card">
          <div class="sidebar-brand">
            <span class="brand-sword">🗡️</span>
            <span class="brand-title" id="ui-sidebar-title">대장간 상황실</span>
          </div>
          <div class="sidebar-util-btns">
            <button type="button" class="btn-util-mini" id="btn-sound-toggle" title="효과음 켜기/끄기">🔊</button>
            <button type="button" class="btn-util-mini" id="btn-copy-obs" title="OBS 브라우저 소스 URL 복사">🎥 OBS</button>
            <button type="button" class="btn-util-mini" id="btn-fullscreen" title="전체화면 전환">⛶</button>
          </div>
        </div>

        <!-- Gold, Protection Scroll Shop & Bankruptcy Bailout Card -->
        <div class="sidebar-card wallet-card">
          <div class="wallet-row">
            <div>
              <span class="wallet-label" id="ui-gold-label">🪙 보유 골드</span>
              <div class="wallet-amount" id="gold-amount-val">3,000 G</div>
            </div>
            <button
              type="button"
              class="btn-free-bailout"
              id="btn-free-bailout"
              title="보유 골드 100 G 미만 + 현재 무기 +0강 + 보관함이 비어있을 때만 1,000 G 파산 구제금을 지급합니다"
            >
              <span id="ui-bailout-btn">🆘 파산 구제 (+1,000 G)</span>
            </button>
          </div>

          <!-- Protection Scroll Shop Box -->
          <div class="scroll-shop-box">
            <div class="scroll-shop-info">
              <div class="scroll-shop-title">
                <span id="ui-scroll-label">🛡️ 파괴방지 주문서</span>
                <strong class="scroll-count-badge" id="scroll-count-val">0장 보유</strong>
              </div>
              <span class="scroll-shop-desc" id="ui-scroll-desc">+9→+10 이상 파괴 방어 (구매할수록 가격 상승 · +18 이상 사용불가)</span>
            </div>
            <button type="button" class="btn-buy-scroll" id="btn-buy-scroll">
              <span id="btn-buy-scroll-txt">🛒 1장 구매 (25,000 G)</span>
            </button>
          </div>

          <div class="stats-mini-grid">
            <div class="stat-box">
              <span class="stat-k" id="ui-stat-tries">누적 망치질</span>
              <strong class="stat-v" id="stat-tries-val">0회</strong>
            </div>
            <div class="stat-box">
              <span class="stat-k" id="ui-stat-success">성공 횟수</span>
              <strong class="stat-v text-green" id="stat-success-val">0회</strong>
            </div>
            <div class="stat-box">
              <span class="stat-k" id="ui-stat-booms">누적 파괴(펑)</span>
              <strong class="stat-v text-red" id="stat-booms-val">0회</strong>
            </div>
            <div class="stat-box">
              <span class="stat-k" id="ui-stat-appraise">현재 무기 감정가</span>
              <strong class="stat-v text-amber" id="stat-value-val">0 G</strong>
            </div>
          </div>

          <button type="button" class="btn-share-stats" id="btn-share-stats">
            <span id="ui-share-btn">📋 내 강화 성적표 클립보드 복사</span>
          </button>
        </div>

        <!-- Live Forge History Log -->
        <div class="sidebar-card log-card">
          <div class="card-head-row">
            <span class="card-head-title" id="ui-log-title">📜 실시간 대장간 기록</span>
            <button type="button" class="btn-clear-log" id="btn-reset-all" title="골드와 무기를 초기 상태로 완전히 리셋">🔄 전체 초기화</button>
          </div>
          <div class="forge-log-list" id="forge-log-list">
            <div class="log-entry info">🔥 대장간 화로에 불이 지펴졌습니다. (초기 자금 3,000 G)</div>
          </div>
        </div>

        <!-- Tier Guide Collapsible -->
        <details class="sidebar-card tier-guide-card">
          <summary class="tier-guide-summary">
            <span id="ui-guide-summary">📊 +0강 ~ +20강 하드코어 확률 & 주문서 소모표</span>
            <span>▾</span>
          </summary>
          <div class="tier-table-wrap">
            <table class="tier-odds-table">
              <thead>
                <tr>
                  <th>단계</th>
                  <th>성공</th>
                  <th>하락</th>
                  <th>파괴</th>
                  <th>방지권</th>
                </tr>
              </thead>
              <tbody id="tier-odds-tbody">
                <!-- Populated by JS -->
              </tbody>
            </table>
          </div>
        </details>
      </aside>
    </div>
  </div>
</GameLayout>

<style>
  .enhance-root {
    width: 100%;
    max-width: 1280px;
    margin: 0 auto;
    padding: 0.5rem 1rem 2rem;
    box-sizing: border-box;
    font-family: 'Pretendard', -apple-system, BlinkMacSystemFont, system-ui, sans-serif;
    color: #f8fafc;
  }

  /* Main Grid */
  .enhance-main-grid {
    display: grid;
    grid-template-columns: 1fr 370px;
    gap: 1rem;
    align-items: start;
  }

  /* Forge Canvas Stage */
  .forge-stage-col {
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
  }

  .forge-canvas-card {
    position: relative;
    background: radial-gradient(circle at 50% 45%, #1e1b4b 0%, #090d16 75%);
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 18px;
    overflow: hidden;
    box-shadow: 0 15px 40px rgba(0, 0, 0, 0.55);
  }

  .forge-hud-top {
    position: absolute;
    top: 0.85rem;
    left: 1rem;
    right: 1rem;
    display: flex;
    justify-content: space-between;
    align-items: center;
    z-index: 4;
    pointer-events: none;
  }

  .weapon-tier-chip {
    background: rgba(255, 255, 255, 0.1);
    border: 1px solid rgba(255, 255, 255, 0.25);
    color: #f8fafc;
    font-size: 0.76rem;
    font-weight: 800;
    padding: 0.28rem 0.7rem;
    border-radius: 999px;
    letter-spacing: 0.04em;
    backdrop-filter: blur(6px);
  }

  .best-record-chip {
    background: rgba(245, 158, 11, 0.15);
    border: 1px solid rgba(245, 158, 11, 0.4);
    color: #fde68a;
    font-size: 0.8rem;
    padding: 0.28rem 0.75rem;
    border-radius: 999px;
  }

  .sword-stack-chip {
    background: rgba(56, 189, 248, 0.14);
    border: 1px solid rgba(56, 189, 248, 0.42);
    color: #bae6fd;
    font-size: 0.76rem;
    font-weight: 700;
    padding: 0.26rem 0.7rem;
    border-radius: 999px;
    backdrop-filter: blur(6px);
  }

  .sword-stack-chip strong {
    color: #38bdf8;
    font-weight: 900;
  }

  .btn-sell-weapon.greed-jackpot {
    background: linear-gradient(135deg, rgba(250, 204, 21, 0.28) 0%, rgba(234, 88, 12, 0.28) 100%);
    border: 2px solid #facc15;
    color: #fef08a;
    box-shadow: 0 0 22px rgba(250, 204, 21, 0.45);
    animation: pulseGreed 1.2s infinite alternate;
  }

  @keyframes pulseGreed {
    0% { transform: scale(1); box-shadow: 0 0 14px rgba(250, 204, 21, 0.35); }
    100% { transform: scale(1.03); box-shadow: 0 0 26px rgba(250, 204, 21, 0.7); }
  }

  .inv-stack-pill {
    font-size: 0.68rem;
    font-weight: 800;
    color: #38bdf8;
    background: rgba(56, 189, 248, 0.12);
    border: 1px solid rgba(56, 189, 248, 0.28);
    border-radius: 5px;
    padding: 0.1rem 0.4rem;
    display: inline-block;
    width: fit-content;
  }

  .weapon-header-overlay {
    position: absolute;
    top: 2.8rem;
    left: 0;
    right: 0;
    text-align: center;
    z-index: 4;
    pointer-events: none;
    padding: 0 1rem;
  }

  .weapon-level-big {
    font-size: 2.35rem;
    font-weight: 900;
    line-height: 1;
    color: #fef08a;
    text-shadow: 0 0 20px rgba(250, 204, 21, 0.6);
  }

  .weapon-name-title {
    font-size: 1.5rem;
    font-weight: 900;
    margin: 0.2rem 0 0.2rem;
    color: #ffffff;
