      }, 1500);
    }

    function canUseProtection(spec: WeaponSpec): boolean {
      return spec.destroy > 0 && spec.reqScrolls > 0 && state.scrolls >= spec.reqScrolls;
    }

    function renderInventory() {
      if (!inventoryGrid) return;
      if (invCountBadge) {
        invCountBadge.textContent = `${state.inventory.length} / ${MAX_INV_SLOTS}`;
      }

      const slotsHtml: string[] = [];
      for (let i = 0; i < MAX_INV_SLOTS; i++) {
        const storedItem = state.inventory[i];
        if (storedItem && typeof storedItem.lv === 'number') {
          const w = WEAPON_DATA[storedItem.lv] || WEAPON_DATA[0];
          const wName = isEn ? w.nameEn : w.nameKo;
          const stackBadge = isEn
            ? `🔥 Stack: +${storedItem.bonusPct}%p (${storedItem.failStreak}/10)`
            : `🔥 성공률 스택: +${storedItem.bonusPct}%p (실패 ${storedItem.failStreak}/10)`;
          slotsHtml.push(`
            <div class="inv-slot" style="border-color: ${w.color}66">
              <div class="inv-slot-top">
                <span class="inv-lv-badge" style="color: ${w.color}">🗡️ +${w.lv}${isEn ? '' : '강'}</span>
                <span class="inv-sell-tag">💰 ${formatGold(w.sell)}</span>
              </div>
              <div class="inv-weapon-name" title="+${w.lv} ${wName}">${wName}</div>
              <div class="inv-stack-pill">${stackBadge}</div>
              <div class="inv-slot-actions">
                <button type="button" class="btn-inv-equip" data-inv-equip="${i}">
                  ${isEn ? '🔨 Equip' : '🔨 꺼내서 강화'}
                </button>
                <button type="button" class="btn-inv-sell" data-inv-sell="${i}">
                  ${isEn ? '💰 Sell' : '💰 판매'}
                </button>
              </div>
            </div>
          `);
        } else {
          slotsHtml.push(`
            <div class="inv-slot empty">
              <span>${isEn ? `Empty Slot #${i + 1}` : `빈 보관함 #${i + 1}`}</span>
            </div>
          `);
        }
      }
      inventoryGrid.innerHTML = slotsHtml.join('');

      // Attach listeners for Equip & Sell inside Inventory
      inventoryGrid.querySelectorAll('[data-inv-equip]').forEach((btn) => {
        btn.addEventListener('click', () => {
          const idx = Number(btn.getAttribute('data-inv-equip'));
          if (isNaN(idx) || idx < 0 || idx >= state.inventory.length) return;
          const targetSword = state.inventory[idx];
          const currentAnvilSword: StoredSword = {
            lv: state.level,
            failStreak: state.anvilFailStreak,
            bonusPct: state.anvilBonusPct
          };

          if (currentAnvilSword.lv > 0 || currentAnvilSword.bonusPct > 0 || currentAnvilSword.failStreak > 0) {
            // Swap current anvil weapon (including its failure stack!) with the inventory slot
            state.inventory[idx] = currentAnvilSword;
            state.level = targetSword.lv;
            state.anvilFailStreak = targetSword.failStreak;
            state.anvilBonusPct = targetSword.bonusPct;
            addLog(
              isEn
                ? `🔄 [INVENTORY] Swapped +${currentAnvilSword.lv} (+${currentAnvilSword.bonusPct}%p) with +${targetSword.lv} (+${targetSword.bonusPct}%p).`
                : `🔄 [보관함 교체] 현재 +${currentAnvilSword.lv}강(+${currentAnvilSword.bonusPct}%p)을 보관하고 +${targetSword.lv}강(+${targetSword.bonusPct}%p) 무기를 꺼냈습니다.`,
              'info'
            );
          } else {
            // Current weapon is a fresh +0 twig with 0 stack, just replace it with stored sword
            state.inventory.splice(idx, 1);
            state.level = targetSword.lv;
            state.anvilFailStreak = targetSword.failStreak;
            state.anvilBonusPct = targetSword.bonusPct;
            addLog(
              isEn
                ? `🔨 [EQUIP] Equipped +${targetSword.lv} (Stack +${targetSword.bonusPct}%p, ${targetSword.failStreak}/10) to the anvil!`
                : `🔨 [꺼내기] 보관함에서 +${targetSword.lv}강 (성공률 스택 +${targetSword.bonusPct}%p, 실패 ${targetSword.failStreak}/10) 무기를 모루로 꺼냈습니다!`,
              'info'
            );
          }
          saveState();
          renderUI();
        });
      });

      inventoryGrid.querySelectorAll('[data-inv-sell]').forEach((btn) => {
        btn.addEventListener('click', () => {
          const idx = Number(btn.getAttribute('data-inv-sell'));
          if (isNaN(idx) || idx < 0 || idx >= state.inventory.length) return;
          const soldItem = state.inventory[idx];
          const soldLv = soldItem.lv;
          const spec = WEAPON_DATA[soldLv] || WEAPON_DATA[0];
          state.inventory.splice(idx, 1);
          state.gold += spec.sell;
          playSuccessFanfare(soldLv >= 7);
          showResultBanner(
            isEn ? `💰 Sold stored +${soldLv} for +${formatGold(spec.sell)}!` : `💰 보관함 +${soldLv}강 판매! (+${formatGold(spec.sell)})`,
            'res-success'
          );
          addLog(
            isEn
              ? `💰 [INVENTORY SALE] Sold stored +${soldLv} ${spec.nameEn} for ${formatGold(spec.sell)}!`
              : `💰 [보관함 판매] 보관 중이던 +${soldLv}강 ${spec.nameKo} 판매하여 ${formatGold(spec.sell)} 획득!`,
            'info'
          );
          saveState();
          renderUI();
        });
      });
    }

    function renderUI() {
      const spec = WEAPON_DATA[state.level] || WEAPON_DATA[0];

      if (tierChipEl) {
        tierChipEl.textContent = isEn ? spec.tierEn : spec.tierKo;
        tierChipEl.style.borderColor = spec.color;
        tierChipEl.style.color = spec.color;
      }
      if (swordStackChipEl) {
        swordStackChipEl.innerHTML = isEn
          ? `🔥 Sword Stack: <strong>+${state.anvilBonusPct}%p (${state.anvilFailStreak}/10)</strong>`
          : `🔥 무기 스택: <strong>+${state.anvilBonusPct}%p (${state.anvilFailStreak}/10)</strong>`;
      }
      if (bestLevelEl) bestLevelEl.textContent = `+${state.bestLevel}${isEn ? '' : '강'}`;
      if (levelBigEl) {
        levelBigEl.textContent = `+${spec.lv}`;
        levelBigEl.style.color = spec.color;
      }
      if (nameTitleEl) nameTitleEl.textContent = isEn ? spec.nameEn : spec.nameKo;
      if (flavorDescEl) flavorDescEl.textContent = isEn ? spec.descEn : spec.descKo;

      // Protection Scroll Checkbox Status
      if (chkProtect) {
        if (spec.lv >= 18) {
          chkProtect.checked = false;
          chkProtect.disabled = true;
          if (uiProtectText) {
            uiProtectText.textContent = isEn
              ? `🚫 Protection Forbidden at +18/+19 (Owned: ${state.scrolls})`
              : `🚫 +18강 이상은 파괴방지 주문서 사용 불가! (보유: ${state.scrolls}장)`;
          }
        } else if (spec.reqScrolls === 0) {
          chkProtect.checked = false;
          chkProtect.disabled = true;
          if (uiProtectText) {
            uiProtectText.textContent = isEn
              ? `🛡️ Safe from Destruction up to +9 (Scrolls: ${state.scrolls})`
              : `🛡️ +9강까지는 파괴 확률 없음 (보유 주문서: ${state.scrolls}장)`;
          }
        } else {
          const enough = state.scrolls >= spec.reqScrolls;
          chkProtect.disabled = !enough;
          if (!enough) chkProtect.checked = false;
          if (uiProtectText) {
            uiProtectText.textContent = isEn
              ? `🛡️ Use Protection (${spec.reqScrolls} Scroll${spec.reqScrolls > 1 ? 's' : ''} req · Owned: ${state.scrolls})`
              : `🛡️ 파괴방지 주문서 적용 (${spec.reqScrolls}장 소모 / 보유: ${state.scrolls}장)`;
          }
        }
      }

      const useProtect = Boolean(chkProtect && chkProtect.checked && canUseProtection(spec));
      const totalBaseSuccess = Math.min(100, spec.success + state.anvilBonusPct);
      if (oddsSuccessEl) {
        oddsSuccessEl.textContent = state.anvilBonusPct > 0
          ? `${totalBaseSuccess}% (+${state.anvilBonusPct}%p)`
          : `${spec.success}%`;
      }
      if (oddsKeepEl) oddsKeepEl.textContent = `${spec.keep}%`;
      if (oddsDownEl) oddsDownEl.textContent = `${useProtect ? spec.down + spec.destroy : spec.down}%`;
      if (oddsDestroyEl) oddsDestroyEl.textContent = `${useProtect ? 0 : spec.destroy}%`;

      if (btnEnhance) {
        if (state.level >= 20) {
          btnEnhance.disabled = true;
          if (btnEnhanceTitle) btnEnhanceTitle.textContent = isEn ? '👑 MAX LEVEL (+20) ACHIEVED!' : '👑 최고 등급(+20강) 달성 완료!';
          if (btnEnhanceCost) btnEnhanceCost.textContent = isEn ? 'Store in Inventory or Sell!' : '보관함에 영구 소장하거나 판매하세요!';
        } else {
          btnEnhance.disabled = false;
          if (btnEnhanceTitle) {
            btnEnhanceTitle.textContent = isEn
              ? `Enhance to +${state.level + 1} (Space)`
              : `+${state.level + 1}강 강화 도전하기 (Space)`;
          }
          if (btnEnhanceCost) {
            btnEnhanceCost.textContent = isEn
              ? `Cost: ${formatGold(spec.cost)}${useProtect ? ` + ${spec.reqScrolls} Scroll(s)` : ''}`
              : `소모 비용: ${formatGold(spec.cost)}${useProtect ? ` + 방지권 ${spec.reqScrolls}장` : ''}`;
          }
        }
      }

      // Store in Inventory button (allowed if lv > 0 OR sword has accumulated failure stack/progress)
      const canStore = (state.level > 0 || state.anvilBonusPct > 0 || state.anvilFailStreak > 0) && state.inventory.length < MAX_INV_SLOTS;
      if (btnStore) {
        btnStore.disabled = !canStore;
      }
      if (storeSlotSub) {
        if (state.inventory.length >= MAX_INV_SLOTS) {
          storeSlotSub.textContent = isEn ? 'Inventory Full (6/6)' : '보관함 가득 참 (6/6)';
        } else {
          storeSlotSub.textContent = isEn
            ? `Save +${state.level} (+${state.anvilBonusPct}%p) & Start +0`
            : `+${state.level}강(+${state.anvilBonusPct}%p) 보관 후 +0 시작`;
        }
      }

      // Sell button (Highlight when +7 Sword of Greed is on the anvil!)
      if (btnSell) {
        btnSell.disabled = state.level === 0;
        if (state.level === 7) {
          btnSell.classList.add('greed-jackpot');
        } else {
          btnSell.classList.remove('greed-jackpot');
        }
      }
      const uiSellTitle = document.getElementById('ui-sell-title');
      if (uiSellTitle) {
        if (state.level === 7) {
          uiSellTitle.textContent = isEn ? '👑 SELL GREED SWORD!' : '👑 황금검 대박 익절!';
        } else {
          uiSellTitle.textContent = isEn ? 'Sell Weapon' : '감정가 판매 (익절)';
        }
      }
      if (sellPriceVal) sellPriceVal.textContent = `+${formatGold(spec.sell)}`;

      // Wallet, Scroll Shop, and Bankruptcy Aid
      if (goldAmountEl) goldAmountEl.textContent = formatGold(state.gold);
      if (scrollCountVal) {
        scrollCountVal.textContent = isEn ? `${state.scrolls} Owned` : `${state.scrolls}장 보유`;
      }
      const scrollPrice = getScrollShopPrice();
      if (btnBuyScroll) {
        btnBuyScroll.disabled = state.gold < scrollPrice;
      }
      if (btnBuyScrollTxt) {
        btnBuyScrollTxt.textContent = isEn
          ? `🛒 Buy 1 Scroll (${formatGold(scrollPrice)})`
          : `🛒 주문서 1장 구매 (${formatGold(scrollPrice)})`;
      }

      if (btnBailout) {
        const bankrupt = isTrulyBankrupt();
        btnBailout.disabled = !bankrupt;
      }

      if (statTriesEl) statTriesEl.textContent = `${state.tries}${isEn ? '' : '회'}`;
      if (statSuccessEl) statSuccessEl.textContent = `${state.successes}${isEn ? '' : '회'}`;
      if (statBoomsEl) statBoomsEl.textContent = `${state.booms}${isEn ? '' : '회'}`;
      if (statValueEl) statValueEl.textContent = formatGold(spec.sell);

      renderInventory();
    }

    // ─── Star-Catch & Enhancement Execution ─────────────────────────────────
    let isStarCatchActive = false;
    let starCatchPos = 50;
    let starCatchDir = 1;
    let hammerAnimProgress = 0;
    let sparks: { x: number; y: number; vx: number; vy: number; color: string; life: number }[] = [];

    function spawnSparks(color: string, count: number) {
      for (let i = 0; i < count; i++) {
        const angle = Math.random() * Math.PI * 2;
        const speed = 2 + Math.random() * 7;
        sparks.push({
          x: 340,
          y: 230,
          vx: Math.cos(angle) * speed,
          vy: Math.sin(angle) * speed - 2,
          color,
          life: 1.0
        });
      }
    }

    function addSwordFailProgress() {
      state.anvilFailStreak += 1;
      if (state.anvilFailStreak >= 10) {
        state.anvilFailStreak = 0;
        state.anvilBonusPct += 1;
        addLog(
          isEn
            ? `🔥 [LOSS STREAK BONUS] 10 consecutive failures on this sword! Gained permanent +1%p enhancement chance (Total: +${state.anvilBonusPct}%p)!`
            : `🔥 [무기 숙련 스택 발동!] 이 무기로 10연속 강화에 실패하여 무기 고유 성공률이 영구적으로 +1%p 상승했습니다! (누적 +${state.anvilBonusPct}%p)`,
          'info'
        );
      }
    }

    function executeEnhanceRoll(bonusPct: number, bonusLabel: string) {
      const spec = WEAPON_DATA[state.level];
      if (!spec || state.level >= 20) return;

      if (state.gold < spec.cost) {
        const msg = isTrulyBankrupt()
          ? (isEn ? '⚠️ Bankrupt! Click [Bankruptcy Aid (+1,000 G)] on the right.' : '⚠️ 파산 상태입니다! 우측 [🆘 파산 구제 (+1,000 G)]를 신청하세요.')
          : (isEn ? '⚠️ Not enough Gold! Sell your current or stored sword.' : '⚠️ 강화 골드가 부족합니다! 현재 무기나 보관함의 무기를 판매하세요.');
        showResultBanner(msg, 'res-down');
        return;
      }

      const useProtect = Boolean(chkProtect && chkProtect.checked && canUseProtection(spec));
      if (useProtect) {
        state.scrolls -= spec.reqScrolls;
      }

      state.gold -= spec.cost;
      state.tries += 1;
      hammerAnimProgress = 1.0;
      playHammerHit();

      const effSuccess = Math.max(1, Math.min(100, spec.success + state.anvilBonusPct + bonusPct));
      const rawDestroy = spec.destroy;
      const effDown = spec.down;

      const arr = new Uint32Array(1);
      crypto.getRandomValues(arr);
      const roll = (arr[0] / (0xffffffff + 1)) * 100;

      if (roll < effSuccess) {
        // SUCCESS! (Resets 0..9 streak counter, but keeps permanent anvilBonusPct on this sword!)
        state.level += 1;
        state.anvilFailStreak = 0;
        state.successes += 1;
        if (state.level > state.bestLevel) {
          state.bestLevel = state.level;
        }
        const nextSpec = WEAPON_DATA[state.level];
        spawnSparks(state.level === 7 ? '#facc15' : '#00ffa3', 48);
        playSuccessFanfare(state.level >= 7);
        showResultBanner(
          state.level === 7
            ? (isEn ? `👑 +7 SWORD OF GREED FORGED! (Sell: 45,000 G!)` : `👑 +7 황금빛 탐욕의 검 연성! (판매가 45,000 G 대박!)`)
            : (isEn ? `✨ SUCCESS! +${state.level} ${nextSpec.nameEn}` : `✨ 강화 성공! +${state.level}강 달성!`),
          'res-success'
        );
        addLog(
          isEn
            ? `✨ [SUCCESS] Enhanced to +${state.level} ${nextSpec.nameEn}! ${bonusLabel}`
            : `✨ [성공] +${state.level}강 ${nextSpec.nameKo} 진화 성공! ${bonusLabel}`,
          'success'
        );
      } else if (roll < effSuccess + rawDestroy) {
        // HIT DESTRUCTION ROLL!
        if (useProtect) {
          // Saved by Protection Scroll, drops -1 level and counts toward 10-fail streak!
          state.level = Math.max(0, state.level - 1);
          addSwordFailProgress();
          spawnSparks('#38bdf8', 35);
          playFailSound(true);
          showResultBanner(
            isEn
              ? `🛡️ SCROLL SAVED SWORD! (Dropped to +${state.level})`
              : `🛡️ 파괴방지 주문서가 무기를 지켰습니다! (-1강 하락 → +${state.level}강)`,
            'res-down'
          );
          addLog(
            isEn
              ? `🛡️ [PROTECTED] Used ${spec.reqScrolls} Scroll(s) to prevent shatter! Dropped to +${state.level}.`
              : `🛡️ [파괴 방어] 주문서 ${spec.reqScrolls}장이 대신 불타며 증발을 막았습니다! (+${state.level}강으로 하락)`,
            'down'
          );
        } else {
          // DESTROYED (BOOM)! Sword and its stacked bonus are lost!
          const deadLevel = state.level;
          const deadBonus = state.anvilBonusPct;
          const deadName = isEn ? spec.nameEn : spec.nameKo;
          state.booms += 1;
          state.level = 0;
          state.anvilFailStreak = 0;
          state.anvilBonusPct = 0;
          spawnSparks('#f43f5e', 55);
          playDestroyMemorialSound();
          if (memorialOverlay && memorialWeaponName && memorialEpitaph) {
            memorialWeaponName.textContent = isEn
              ? `R.I.P. +${deadLevel} ${deadName}${deadBonus > 0 ? ` (+${deadBonus}%p)` : ''}`
              : `고(故) +${deadLevel}강 ${deadName}${deadBonus > 0 ? ` (스택 +${deadBonus}%p)` : ''}`;
            memorialEpitaph.textContent = isEn
              ? `Shattered into stardust while attempting +${deadLevel + 1} (${spec.destroy}% destruction odds)...`
              : `+${deadLevel + 1}강 도전 중 ${spec.destroy}%의 파괴 확률을 피하지 못하고 별가루로 산화했습니다...`;
            memorialOverlay.classList.remove('hidden');
          }
          addLog(
            isEn
              ? `💀 [SHATTERED] +${deadLevel} ${deadName} was destroyed! Reset to fresh +0.`
              : `💀 [무기 파괴] +${deadLevel}강 ${deadName} 완파(증발)! (+0강으로 초기화)`,
            'destroy'
          );
        }
      } else if (roll < effSuccess + rawDestroy + effDown && state.level > 0) {
        // DOWNGRADE (-1, or -2 at +15 and above!)
        const dropAmt = state.level >= 15 ? 2 : 1;
        state.level = Math.max(0, state.level - dropAmt);
        addSwordFailProgress();
        spawnSparks('#f59e0b', 22);
        playFailSound(true);
        showResultBanner(
          isEn ? `📉 DOWNGRADED (-${dropAmt}) to +${state.level}` : `📉 강화 실패 (-${dropAmt}강 하락 → +${state.level}강)`,
          'res-down'
        );
        addLog(
          isEn
            ? `📉 [DOWNGRADE] Dropped by -${dropAmt} to +${state.level}. (Fail Streak: ${state.anvilFailStreak}/10) ${bonusLabel}`
            : `📉 [등급 하락] -${dropAmt}강 하락하여 +${state.level}강이 되었습니다. (연속 실패: ${state.anvilFailStreak}/10) ${bonusLabel}`,
          'down'
        );
      } else {
        // KEEP (SLIP)
        addSwordFailProgress();
        spawnSparks('#94a3b8', 16);
        playFailSound(false);
        showResultBanner(
          isEn ? `💨 SLIPPED! Stayed at +${state.level}` : `💨 손이 미끄러졌습니다! (+${state.level}강 유지)`,
          'res-keep'
        );
        addLog(
          isEn
            ? `💨 [KEEP] Enhancement slipped, level kept at +${state.level}. (Fail Streak: ${state.anvilFailStreak}/10) ${bonusLabel}`
            : `💨 [유지] 강화에 실패했으나 +${state.level}강이 보존되었습니다. (연속 실패: ${state.anvilFailStreak}/10) ${bonusLabel}`,
          'keep'
        );
      }

      saveState();
      renderUI();
    }

    function triggerEnhanceAction() {
      if (memorialOverlay && !memorialOverlay.classList.contains('hidden')) {
        memorialOverlay.classList.add('hidden');
        return;
      }
      if (state.level >= 20) return;

      const spec = WEAPON_DATA[state.level];
      if (state.gold < spec.cost) {
        const msg = isTrulyBankrupt()
          ? (isEn ? '⚠️ Bankrupt! Click [Bankruptcy Aid (+1,000 G)] on the right.' : '⚠️ 파산 상태입니다! 우측 [🆘 파산 구제 (+1,000 G)]를 신청하세요.')
          : (isEn ? '⚠️ Not enough Gold! Sell your current or stored sword.' : '⚠️ 강화 골드가 부족합니다! 현재 무기나 보관함의 무기를 판매하세요.');
        showResultBanner(msg, 'res-down');
        return;
      }

      if (chkStarCatch && chkStarCatch.checked) {
        if (!isStarCatchActive) {
          isStarCatchActive = true;
          starCatchPos = 10;
          starCatchDir = 1;
          if (starcatchOverlay) starcatchOverlay.classList.remove('hidden');
          if (btnEnhanceTitle) {
            btnEnhanceTitle.textContent = isEn ? '🌟 STOP STAR CATCH! (Space)' : '🌟 지금 스페이스바/클릭으로 별캐치! (Space)';
          }
          return;
        } else {
          isStarCatchActive = false;
          if (starcatchOverlay) starcatchOverlay.classList.add('hidden');
          let bonus = 0;
          let label = '';
          if (starCatchPos >= 46 && starCatchPos <= 54) {
            bonus = 3;
            label = isEn ? '(🌟 PERFECT +3%p)' : '(🌟 퍼펙트 별캐치 +3%p)';
          } else if (starCatchPos >= 36 && starCatchPos <= 64) {
            bonus = 1;
            label = isEn ? '(⭐ GREAT +1%p)' : '(⭐ 그레이트 별캐치 +1%p)';
          } else {
            bonus = -2;
            label = isEn ? '(💥 MISS -2%p)' : '(💥 별캐치 삐끗 -2%p)';
          }
          executeEnhanceRoll(bonus, label);
          return;
        }
      } else {
        executeEnhanceRoll(0, '');
      }
    }

    // ─── Event Listeners ────────────────────────────────────────────────────
    if (btnEnhance) {
      btnEnhance.addEventListener('click', triggerEnhanceAction);
    }

    if (starcatchOverlay) {
      starcatchOverlay.addEventListener('click', triggerEnhanceAction);
    }

    if (btnMemorialRestart) {
      btnMemorialRestart.addEventListener('click', () => {
        if (memorialOverlay) memorialOverlay.classList.add('hidden');
      });
    }

    window.addEventListener('keydown', (e) => {
      if (e.code === 'Space') {
        const activeTag = document.activeElement?.tagName.toLowerCase();
        if (activeTag === 'input' || activeTag === 'textarea') return;
        e.preventDefault();
        triggerEnhanceAction();
      }
    });

    if (chkProtect) {
      chkProtect.addEventListener('change', renderUI);
    }

    // Store Current Sword in Inventory & Reset Anvil to +0
    if (btnStore) {
      btnStore.addEventListener('click', () => {
        if (state.level <= 0 && state.anvilBonusPct <= 0 && state.anvilFailStreak <= 0) return;
        if (state.inventory.length >= MAX_INV_SLOTS) {
          showResultBanner(isEn ? '⚠️ Inventory is full (Max 6)!' : '⚠️ 보관함이 가득 찼습니다 (최대 6슬롯)!', 'res-down');
          return;
        }
        const savedLv = state.level;
        const savedBonus = state.anvilBonusPct;
        const savedStreak = state.anvilFailStreak;
        const spec = WEAPON_DATA[savedLv];
        state.inventory.push({
          lv: savedLv,
          failStreak: savedStreak,
          bonusPct: savedBonus
        });
        state.level = 0;
        state.anvilFailStreak = 0;
        state.anvilBonusPct = 0;
        showResultBanner(
          isEn
            ? `📥 Stored +${savedLv} (+${savedBonus}%p) in Inventory!`
            : `📥 +${savedLv}강 (+${savedBonus}%p 스택) 무기를 보관함에 저장!`,
          'res-keep'
        );
        addLog(
          isEn
            ? `📥 [STORED] Saved +${savedLv} ${spec.nameEn} (Stack +${savedBonus}%p, ${savedStreak}/10) in Inventory. Started fresh +0.`
            : `📥 [보관함 저장] +${savedLv}강 ${spec.nameKo} (스택 +${savedBonus}%p, 실패 ${savedStreak}/10) 보관 완료! 새로운 +0강으로 시작합니다.`,
          'info'
        );
        saveState();
        renderUI();
      });
    }

    // Sell Current Sword on Anvil & Reset Anvil to +0
    if (btnSell) {
      btnSell.addEventListener('click', () => {
        if (state.level <= 0) return;
        const spec = WEAPON_DATA[state.level];
        const soldLv = state.level;
        const soldGold = spec.sell;
        state.gold += soldGold;
        state.level = 0;
        state.anvilFailStreak = 0;
        state.anvilBonusPct = 0;
        playSuccessFanfare(soldLv >= 7);
        showResultBanner(
          isEn ? `💰 Sold +${soldLv} for ${formatGold(soldGold)}!` : `💰 +${soldLv}강 무기 판매 완료! (+${formatGold(soldGold)})`,
          'res-success'
        );
        addLog(
          isEn
            ? `💰 [CASH OUT] Sold +${soldLv} ${spec.nameEn} for ${formatGold(soldGold)}! Started fresh +0.`
            : `💰 [익절 성공] +${soldLv}강 ${spec.nameKo} 판매하여 ${formatGold(soldGold)} 획득! (+0강 새로 시작)`,
          'info'
        );
        saveState();
        renderUI();
      });
    }

    // Buy Protection Scroll
    if (btnBuyScroll) {
      btnBuyScroll.addEventListener('click', () => {
        const price = getScrollShopPrice();
        if (state.gold < price) {
          showResultBanner(isEn ? '⚠️ Not enough Gold for Scroll!' : '⚠️ 주문서 구매 골드가 부족합니다!', 'res-down');
          return;
        }
        state.gold -= price;
        state.scrolls += 1;
        state.scrollsBought += 1;
        playSuccessFanfare(false);
        showResultBanner(
          isEn ? `🛡️ Purchased 1 Protection Scroll! (Owned: ${state.scrolls})` : `🛡️ 파괴방지 주문서 1장 구매 완료! (보유: ${state.scrolls}장)`,
          'res-keep'
        );
        addLog(
          isEn
            ? `🛒 [SHOP] Bought 1 Protection Scroll for ${formatGold(price)}. (Next scroll: ${formatGold(getScrollShopPrice())})`
            : `🛒 [상점] ${formatGold(price)}를 지불하고 파괴방지 주문서 1장 구매! (다음 가격: ${formatGold(getScrollShopPrice())})`,
          'info'
        );
        saveState();
        renderUI();
      });
    }

    // Strict Bankruptcy Bailout (+1,000 G only when 100% broke & 0 weapons)
    if (btnBailout) {
      btnBailout.addEventListener('click', () => {
        if (!isTrulyBankrupt()) {
          showResultBanner(
            isEn
              ? '⚠️ Only available when Gold < 100G, Weapon is +0, and Inventory is empty!'
              : '⚠️ 골드 100G 미만 + 현재 무기 +0강 + 보관함이 비어있을 때만 구제 가능합니다!',
            'res-down'
          );
          return;
        }
        state.gold += 1000;
        state.bankruptcies += 1;
        saveState();
        renderUI();
        showResultBanner(
          isEn ? '🆘 Emergency Bankruptcy Aid +1,000 G granted!' : '🆘 긴급 파산 구제금 +1,000 G가 지급되었습니다!',
          'res-keep'
        );
        addLog(
          isEn
            ? `🆘 [BANKRUPTCY #${state.bankruptcies}] Received +1,000 G emergency starter aid.`
            : `🆘 [파산 구제 #${state.bankruptcies}회] 완전 파산이 확인되어 긴급 재기 자금 +1,000 G를 지원받았습니다.`,
          'info'
        );
      });
    }

    const btnResetAll = document.getElementById('btn-reset-all');
    if (btnResetAll) {
      btnResetAll.addEventListener('click', () => {
        state = {
          level: 0,
          anvilFailStreak: 0,
          anvilBonusPct: 0,
          bestLevel: state.bestLevel,
          gold: 3000,
          scrolls: 0,
          scrollsBought: 0,
          inventory: [],
          tries: 0,
          successes: 0,
          booms: 0,
          bankruptcies: 0
        };
        saveState();
        renderUI();
        addLog(
          isEn ? '🔄 Reset to fresh start (3,000 G, empty inventory).' : '🔄 초기 상태(자금 3,000 G, 빈 보관함)로 리셋되었습니다.',
          'info'
        );
      });
    }

    const btnShare = document.getElementById('btn-share-stats');
    if (btnShare) {
      btnShare.addEventListener('click', async () => {
        const spec = WEAPON_DATA[state.level];
        const invSummary = state.inventory.length > 0
          ? state.inventory.map(item => `+${item.lv}(+${item.bonusPct}%p)`).join(', ')
          : (isEn ? 'Empty' : '없음');
        const shareText = isEn
          ? `🗡️ [ErrorLedger Hardcore Sword Enhancer]\n• Anvil Weapon: +${state.level} ${spec.nameEn} (Stack +${state.anvilBonusPct}%p)\n• Inventory: ${invSummary}\n• Personal Best: +${state.bestLevel}\n• Gold: ${formatGold(state.gold)} | Scrolls: ${state.scrolls}\n• Strikes: ${state.tries} (Shattered: ${state.booms}, Bankruptcies: ${state.bankruptcies})\nhttps://errorledger.com/en/games/sword-enhance`
          : `🗡️ [전설의 +20강 하드코어 무기 강화 성적표]\n• 현재 모루 무기: +${state.level}강 ${spec.nameKo} (스택 +${state.anvilBonusPct}%p)\n• 보관함 보유 무기: ${invSummary}\n• 최고 달성 기록: +${state.bestLevel}강\n• 보유 골드: ${formatGold(state.gold)} | 방지권: ${state.scrolls}장\n• 누적 망치질: ${state.tries}회 (파괴: ${state.booms}회 / 파산: ${state.bankruptcies}회)\nhttps://errorledger.com/games/sword-enhance`;
        try {
          await navigator.clipboard.writeText(shareText);
          showResultBanner(isEn ? '📋 Scorecard Copied!' : '📋 강화 성적표가 복사되었습니다!', 'res-success');
        } catch (e) {}
      });
    }

    // Utility buttons (Sound, OBS, Fullscreen)
    const btnSound = document.getElementById('btn-sound-toggle');
    if (btnSound) {
      btnSound.textContent = isMuted ? '🔇' : '🔊';
      btnSound.addEventListener('click', () => {
        isMuted = !isMuted;
        localStorage.setItem('sound-muted', String(isMuted));
        btnSound.textContent = isMuted ? '🔇' : '🔊';
      });
    }

    const btnObs = document.getElementById('btn-copy-obs');
    if (btnObs) {
      btnObs.addEventListener('click', async () => {
        const u = new URL(window.location.href);
        u.searchParams.set('stream', 'true');
        try {
          await navigator.clipboard.writeText(u.href);
          showResultBanner(isEn ? '🎥 OBS Overlay URL Copied!' : '🎥 OBS 브라우저 소스 URL이 복사되었습니다!', 'res-success');
        } catch (e) {}
      });
    }

    const btnFs = document.getElementById('btn-fullscreen');
    if (btnFs) {
      btnFs.addEventListener('click', () => {
        if (!document.fullscreenElement) {
          document.documentElement.requestFullscreen().catch(() => {});
        } else {
          document.exitFullscreen().catch(() => {});
        }
      });
    }

    // ─── Canvas Procedural Forge & Weapon Renderer ──────────────────────────
    const canvas = document.getElementById('forge-canvas') as HTMLCanvasElement | null;
    const ctx = canvas ? canvas.getContext('2d') : null;
    let tick = 0;

    function drawForgeLoop() {
      requestAnimationFrame(drawForgeLoop);
      tick += 1;

      if (isStarCatchActive && starcatchCursor) {
        const speed = 1.9 + Math.min(2.2, state.level * 0.11);
        starCatchPos += starCatchDir * speed;
        if (starCatchPos >= 94) {
          starCatchPos = 94;
          starCatchDir = -1;
        } else if (starCatchPos <= 6) {
          starCatchPos = 6;
          starCatchDir = 1;
        }
        starcatchCursor.style.left = `${starCatchPos}%`;
      }

      if (!canvas || !ctx) return;
      const W = canvas.width;
      const H = canvas.height;
      ctx.clearRect(0, 0, W, H);

      const spec = WEAPON_DATA[state.level] || WEAPON_DATA[0];
      const cx = W / 2;
      const cy = 225;

      // 1. Background Aura & Magic Circle for +6 and above
      if (state.level >= 6) {
        ctx.save();
        ctx.translate(cx, cy);
        ctx.rotate(tick * 0.012);
        const radius = 85 + state.level * 2.5;
        ctx.strokeStyle = spec.color;
        ctx.globalAlpha = 0.25 + Math.sin(tick * 0.06) * 0.1;
        ctx.lineWidth = 2;
        ctx.beginPath();
        ctx.arc(0, 0, radius, 0, Math.PI * 2);
        ctx.stroke();

        if (state.level >= 10) {
          const pts = 6;
          ctx.beginPath();
          for (let i = 0; i <= pts; i++) {
            const a = (i * 2 * Math.PI) / pts;
            const px = Math.cos(a) * (radius * 0.82);
            const py = Math.sin(a) * (radius * 0.82);
            if (i === 0) ctx.moveTo(px, py);
            else ctx.lineTo(px, py);
          }
          ctx.stroke();
        }
        ctx.restore();
      }

      // 2. Forging Anvil at Bottom Center
      ctx.save();
      ctx.fillStyle = '#1e293b';
      ctx.strokeStyle = '#475569';
      ctx.lineWidth = 2;
      ctx.beginPath();
      ctx.roundRect(cx - 95, cy + 62, 190, 28, 6);
      ctx.fill();
      ctx.stroke();
      ctx.fillStyle = '#0f172a';
      ctx.fillRect(cx - 65, cy + 90, 130, 32);
      ctx.restore();

      // 3. Procedural Sword / Weapon Rendering
      ctx.save();
      ctx.translate(cx, cy);
      const floatY = Math.sin(tick * 0.05) * 6;
      ctx.translate(0, floatY);
      ctx.rotate(-Math.PI / 6);

      ctx.shadowColor = spec.color;
      ctx.shadowBlur = 12 + state.level * 2.2;

      if (state.level <= 1) {
        ctx.fillStyle = spec.color;
        ctx.beginPath();
        ctx.roundRect(-14, -75, 28, 150, 10);
        ctx.fill();
      } else {
        const bladeLen = 115 + Math.min(55, state.level * 3);
        const bladeWidth = 22 + Math.min(18, Math.floor(state.level * 0.8));

        const grad = ctx.createLinearGradient(0, -bladeLen, 0, 30);
        grad.addColorStop(0, '#ffffff');
        grad.addColorStop(0.35, spec.color);
        grad.addColorStop(1, spec.glow);
        ctx.fillStyle = grad;

        ctx.beginPath();
        ctx.moveTo(0, -bladeLen - 24);
        ctx.lineTo(bladeWidth / 2, -bladeLen + 10);
        ctx.lineTo(bladeWidth / 2, 25);
        ctx.lineTo(-bladeWidth / 2, 25);
        ctx.lineTo(-bladeWidth / 2, -bladeLen + 10);
        ctx.closePath();
        ctx.fill();

        ctx.strokeStyle = '#ffffff';
        ctx.lineWidth = 2;
        ctx.beginPath();
        ctx.moveTo(0, -bladeLen + 5);
        ctx.lineTo(0, 18);
        ctx.stroke();

        ctx.fillStyle = (state.level >= 10 || state.level === 7) ? '#facc15' : '#94a3b8';
        ctx.beginPath();
        ctx.roundRect(-bladeWidth * 1.35, 22, bladeWidth * 2.7, 12, 4);
        ctx.fill();

        ctx.fillStyle = state.level === 7 ? '#ca8a04' : '#475569';
        ctx.fillRect(-7, 34, 14, 34);
        ctx.fillStyle = spec.color;
        ctx.beginPath();
        ctx.arc(0, 72, 11, 0, Math.PI * 2);
        ctx.fill();
      }
      ctx.restore();

      // 3.5 Special Orbiting Gold Coins for +7 Sword of Greed!
      if (state.level === 7) {
        ctx.save();
        ctx.translate(cx, cy + Math.sin(tick * 0.05) * 6);
        ctx.font = '20px sans-serif';
        ctx.textAlign = 'center';
        ctx.textBaseline = 'middle';
        for (let i = 0; i < 4; i++) {
          const angle = tick * 0.04 + (i * Math.PI) / 2;
          const ox = Math.cos(angle) * 105;
          const oy = Math.sin(angle) * 42 - 15;
          ctx.fillText(i % 2 === 0 ? '🪙' : '💰', ox, oy);
        }
        ctx.restore();
      }

      // 4. Hammer Strike Animation
      if (hammerAnimProgress > 0) {
        hammerAnimProgress = Math.max(0, hammerAnimProgress - 0.08);
        ctx.save();
        ctx.translate(cx + 75, cy - 35);
        const swingAngle = -Math.sin(hammerAnimProgress * Math.PI) * 0.95;
        ctx.rotate(swingAngle);
        ctx.font = '56px sans-serif';
        ctx.textAlign = 'center';
        ctx.textBaseline = 'middle';
        ctx.fillText('🔨', 0, 0);
        ctx.restore();
      }

      // 5. Sparks Particle System
      for (let i = sparks.length - 1; i >= 0; i--) {
        const p = sparks[i];
        p.x += p.vx;
        p.y += p.vy;
        p.vy += 0.22;
        p.life -= 0.032;
        if (p.life <= 0) {
          sparks.splice(i, 1);
          continue;
        }
        ctx.save();
        ctx.globalAlpha = p.life;
        ctx.fillStyle = p.color;
        ctx.beginPath();
        ctx.arc(p.x, p.y, 3.2, 0, Math.PI * 2);
        ctx.fill();
        ctx.restore();
      }
    }

    renderUI();
    requestAnimationFrame(drawForgeLoop);
  })();
</script>
