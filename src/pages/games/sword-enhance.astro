              if (typeof item === 'number') {
                return { lv: item, failStreak: 0, bonusPct: 0 };
              }
              return {
                lv: Number(item?.lv) || 0,
                failStreak: Number(item?.failStreak) || 0,
                bonusPct: Number(item?.bonusPct) || 0
              };
            })
          : [];
        state = {
          ...state,
          ...parsed,
          anvilFailStreak: Number(parsed.anvilFailStreak) || 0,
          anvilBonusPct: Number(parsed.anvilBonusPct) || 0,
          inventory: migratedInv
        };
      }
    } catch (e) {}

    function saveState() {
      try {
        localStorage.setItem(STORAGE_KEY, JSON.stringify(state));
      } catch (e) {}
    }

