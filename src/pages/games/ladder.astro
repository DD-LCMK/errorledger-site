</style>

<script>
  // Extended 24 distinct neon colors and avatars for up to 20+ players
  const PLAYER_COLORS = [
    '#38bdf8', '#f43f5e', '#10b981', '#facc15',
    '#a855f7', '#f97316', '#06b6d4', '#ec4899',
    '#84cc16', '#6366f1', '#14b8a6', '#e11d48',
    '#eab308', '#8b5cf6', '#3b82f6', '#d946ef',
    '#22c55e', '#fb923c', '#0284c7', '#f472b6',
    '#a3e635', '#c084fc', '#2dd4bf', '#fb7185'
  ];

  const EMOJIS = [
    '🦊', '🐼', '🐯', '🐰', '🦁', '🐨', '🐸', '🦄',
    '🐵', '🐧', '🐶', '🐱', '🐮', '🐷', '🐙', '🐺',
    '🐹', '🐻', '🦝', '🐗', '🦉', '🦋', '🐥', '🐲'
  ];

  // Presets Data Generator supporting dynamic player counts
  const PRESET_TEMPLATES: Record<string, { title: string; defaultOutcome: string; penalties: string[] }> = {
    coffee: {
      title: '커피 쏘기',
      defaultOutcome: '통과 🎉',
      penalties: ['커피 쏘기 ☕', '디저트 쏘기 🍰', '커피 쏘기 ☕']
    },
    chicken: {
      title: '치킨 내기',
      defaultOutcome: '생존 ✨',
      penalties: ['치킨 쏘기 🍗', '피자 쏘기 🍕', '치킨 쏘기 🍗']
    },
    penalty: {
      title: '벌칙 뽑기',
      defaultOutcome: '벌칙 면제 🎉',
      penalties: [
        '애교 3종 💖', '물 원샷 💧', '팔굽혀펴기 10개',
        '노래 한 곡 🎤', '음료수 쏘기 🥤', '엉덩이로 이름쓰기 🍑',
        '막춤 30초 💃', '다음 게임 심판 👮'
      ]
    },
    duty: {
      title: '청소/당번',
      defaultOutcome: '휴식 (면제) 🛋️',
      penalties: [
        '청소 당번 🧹', '설거지 당번 🧼', '분리수거 당번 ♻️',
        '간식 사오기 🍪', '회의록 작성 ✍️', '정리 당번 📦'
      ]
    }
  };

  // Speed Durations in milliseconds
  const SPEED_DURATIONS = {
    slow: 6200,   // ~6.2s for maximum suspense
    normal: 4000, // ~4.0s for clear, enjoyable pacing
    fast: 2000    // ~2.0s for quick resolution
  };

  let speedMode: 'slow' | 'normal' | 'fast' = 'normal';
  let playerCount = 4;
  let participantNames: string[] = ['참가자 1', '참가자 2', '참가자 3', '참가자 4'];
  let outcomeNames: string[] = ['당첨 🍗', '꽝 💨', '커피 ☕', '생존 ✨'];
  let bridges: { poleA: number; poleB: number; y: number }[] = [];
  let isTracing = false;
  let animFrameId: number | null = null;
  let ladderHeight = 500;

  // Web Audio Synth for footsteps and turns
  class StepAudio {
    private ctx: AudioContext | null = null;
    private lastStepTime = 0;

    private isMuted(): boolean {
      try {
        return localStorage.getItem('aether_sound_muted') === 'true';
      } catch {
        return false;
      }
    }

    private getContext(): AudioContext | null {
      if (this.isMuted()) return null;
      if (!this.ctx) {
        const AudioCtx = window.AudioContext || (window as any).webkitAudioContext;
        if (AudioCtx) this.ctx = new AudioCtx();
      }
      if (this.ctx && this.ctx.state === 'suspended') {
        this.ctx.resume();
      }
      return this.ctx;
    }

    playStep(freq = 400) {
      const now = performance.now();
      if (now - this.lastStepTime < 50) return; // Throttle sound playback
      this.lastStepTime = now;

      const ctx = this.getContext();
      if (!ctx) return;
      const osc = ctx.createOscillator();
      const gain = ctx.createGain();
      osc.type = 'sine';
      osc.frequency.setValueAtTime(freq, ctx.currentTime);
      gain.gain.setValueAtTime(0.12, ctx.currentTime);
      gain.gain.exponentialRampToValueAtTime(0.005, ctx.currentTime + 0.05);
      osc.connect(gain);
      gain.connect(ctx.destination);
      osc.start();
      osc.stop(ctx.currentTime + 0.05);
    }

    playTurn(freq = 550) {
      const ctx = this.getContext();
      if (!ctx) return;
      const osc = ctx.createOscillator();
      const gain = ctx.createGain();
      osc.type = 'triangle';
      osc.frequency.setValueAtTime(freq, ctx.currentTime);
      gain.gain.setValueAtTime(0.18, ctx.currentTime);
      gain.gain.exponentialRampToValueAtTime(0.005, ctx.currentTime + 0.08);
      osc.connect(gain);
      gain.connect(ctx.destination);
      osc.start();
      osc.stop(ctx.currentTime + 0.08);
    }

    playWin() {
      const ctx = this.getContext();
      if (!ctx) return;
      const notes = [440, 554.37, 659.25, 880];
      notes.forEach((f, i) => {
        const osc = ctx.createOscillator();
        const gain = ctx.createGain();
        osc.type = 'triangle';
        osc.frequency.setValueAtTime(f, ctx.currentTime + i * 0.09);
        gain.gain.setValueAtTime(0.22, ctx.currentTime + i * 0.09);
        gain.gain.exponentialRampToValueAtTime(0.01, ctx.currentTime + i * 0.09 + 0.25);
        osc.connect(gain);
        gain.connect(ctx.destination);
        osc.start(ctx.currentTime + i * 0.09);
        osc.stop(ctx.currentTime + i * 0.09 + 0.25);
      });
    }
  }

  const audio = new StepAudio();

  // DOM Elements
  const ladderStageInner = document.getElementById('ladder-stage-inner');
  const participantsRow = document.getElementById('participants-row');
  const outcomesRow = document.getElementById('outcomes-row');
  const ladderSvg = document.getElementById('ladder-svg') as SVGSVGElement | null;
  const ladderContainer = document.getElementById('ladder-container');

  const countDisplay = document.getElementById('count-display');
  const countDecBtn = document.getElementById('count-dec-btn');
  const countIncBtn = document.getElementById('count-inc-btn');
  const countBtns = document.querySelectorAll('.count-btn');
  const speedBtns = document.querySelectorAll('.speed-btn');

  const startAllBtn = document.getElementById('start-all-btn');
  const revealAllBtn = document.getElementById('reveal-all-btn');
  const rerollBtn = document.getElementById('reroll-ladder-btn');

  const ladderBlind = document.getElementById('ladder-blind');
  const toggleBlindBtn = document.getElementById('toggle-blind-btn');
  const blindBtnText = document.getElementById('blind-btn-text');
  const blindUnveilCenterBtn = document.getElementById('blind-unveil-center-btn');

  const resultModal = document.getElementById('result-modal');
  const resultSummaryList = document.getElementById('result-summary-list');
  const closeResultBtn = document.getElementById('close-result-btn');

  let isBlindActive = true;

  function cancelActiveAnimation() {
    if (animFrameId !== null) {
      cancelAnimationFrame(animFrameId);
      animFrameId = null;
    }
    isTracing = false;
  }

  function coverBlind() {
    isBlindActive = true;
    ladderBlind?.classList.remove('unveiled');
    toggleBlindBtn?.classList.remove('off');
    if (blindBtnText) blindBtnText.textContent = '🔒 가림막 ON';
    renderLadderSVG();
  }

  function unveilBlind() {
    isBlindActive = false;
    ladderBlind?.classList.add('unveiled');
    toggleBlindBtn?.classList.add('off');
    if (blindBtnText) blindBtnText.textContent = '👁️ 가림막 OFF';
    renderLadderSVG();
  }

  function toggleBlind() {
    if (isBlindActive) {
      unveilBlind();
    } else {
      coverBlind();
    }
  }

  // Ensure names and outcomes match playerCount
  function syncArrays() {
    while (participantNames.length < playerCount) {
      participantNames.push(`참가자 ${participantNames.length + 1}`);
    }
    while (outcomeNames.length < playerCount) {
      outcomeNames.push(`결과 ${outcomeNames.length + 1}`);
    }
  }

  function initLadder() {
    cancelActiveAnimation();
    syncArrays();

    // Scale stage width and SVG height based on player count so all participants fit in 1 screen
    const stageContainer = ladderContainer?.parentElement?.parentElement || document.getElementById('ladder-stage');
    const containerWidth = stageContainer?.clientWidth ? (stageContainer.clientWidth - 24) : 1000;
    const idealWidth = playerCount <= 6 
      ? Math.min(containerWidth, Math.max(460, playerCount * 125))
      : Math.min(containerWidth, Math.max(640, playerCount * (playerCount >= 16 ? 46 : (playerCount >= 11 ? 54 : 68))));

    if (ladderStageInner) {
      let densityClass = 'density-normal';
      if (playerCount >= 16) {
        densityClass = 'density-micro';
      } else if (playerCount >= 11) {
        densityClass = 'density-dense';
      } else if (playerCount >= 7) {
        densityClass = 'density-compact';
      }
      ladderStageInner.className = `ladder-stage-inner ${densityClass}`;
      ladderStageInner.style.width = '100%';
      ladderStageInner.style.maxWidth = `${idealWidth}px`;
      ladderStageInner.style.minWidth = '0';
    }

    // Determine row count and discrete spacing
    const numRows = Math.min(32, Math.max(12, Math.floor(playerCount * 1.3) + 5));
    ladderHeight = Math.min(580, Math.max(480, 420 + numRows * 5.5));
    if (ladderContainer) {
      ladderContainer.style.height = `${ladderHeight}px`;
    }

    bridges = [];
    const rowSpacing = ladderHeight / (numRows + 1);

    // Track occupied poles per row to mathematically guarantee 100% Bijection (Transposition)
    // In any valid Amidakuji, NO TWO BRIDGES ON THE SAME ROW CAN SHARE AN ENDPOINT.
    const occupiedAtRow: Set<number>[] = Array.from({ length: numRows + 1 }, () => new Set<number>());

    // Phase 1: Ensure every adjacent pair (p, p+1) has at least 1 connecting bridge
    for (let p = 0; p < playerCount - 1; p++) {
      const candidates: number[] = [];
      for (let r = 1; r <= numRows; r++) {
        if (!occupiedAtRow[r].has(p) && !occupiedAtRow[r].has(p + 1)) {
          candidates.push(r);
        }
      }
      if (candidates.length > 0) {
        const chosenRow = candidates[Math.floor(Math.random() * candidates.length)];
        occupiedAtRow[chosenRow].add(p);
        occupiedAtRow[chosenRow].add(p + 1);
        bridges.push({ poleA: p, poleB: p + 1, y: chosenRow * rowSpacing });
      }
    }

    // Phase 2: Add additional randomized bridges with strict disjointness
    for (let r = 1; r <= numRows; r++) {
      let p = 0;
      while (p < playerCount - 1) {
        if (!occupiedAtRow[r].has(p) && !occupiedAtRow[r].has(p + 1)) {
          if (Math.random() < 0.5) {
            occupiedAtRow[r].add(p);
            occupiedAtRow[r].add(p + 1);
            bridges.push({ poleA: p, poleB: p + 1, y: r * rowSpacing });
            p += 2; // Jump past p+1 to prevent any adjacent collision at the exact same row
            continue;
          }
        }
        p += 1;
      }
    }

    // Mathematical Invariant Assertion: Verify all player destinations are 100% unique (Strict 1-to-1 Bijection)
    const testDestinations = new Set<number>();
    for (let p = 0; p < playerCount; p++) {
      const { destPole } = calculatePath(p, 800, ladderHeight);
      if (testDestinations.has(destPole)) {
        console.warn(`[Amidakuji Invariant Check] Duplicate at pole ${destPole}. Re-generating ladder...`);
        initLadder();
        return;
      }
      testDestinations.add(destPole);
    }

    // Reset outcome cards
    for (let d = 0; d < playerCount; d++) {
      const card = document.getElementById(`outcome-card-${d}`);
      card?.classList.remove('revealed');
      const badge = document.getElementById(`outcome-badge-${d}`);
      if (badge) badge.textContent = '';
    }

    renderUI();
    renderLadderSVG();
    coverBlind();
  }

  function renderUI() {
    if (!participantsRow || !outcomesRow) return;

    // Update count display and button active classes
    if (countDisplay) countDisplay.textContent = `${playerCount}명`;
    countBtns.forEach(btn => {
      btn.classList.toggle('active', btn.getAttribute('data-count') === String(playerCount));
    });

    // Render Top Participants
    participantsRow.innerHTML = '';
    for (let i = 0; i < playerCount; i++) {
      const color = PLAYER_COLORS[i % PLAYER_COLORS.length];
      const emoji = EMOJIS[i % EMOJIS.length];
      const name = participantNames[i] || `참가자 ${i + 1}`;

      const slot = document.createElement('div');
      slot.className = 'participant-slot';

      const card = document.createElement('div');
      card.className = 'participant-card';
      card.style.borderColor = `${color}40`;

      card.innerHTML = `
        <div class="participant-avatar" style="background: ${color}25; border: 2px solid ${color};">
          ${emoji}
        </div>
        <input type="text" class="participant-name-input" data-idx="${i}" value="${name}" spellcheck="false" />
        <button class="participant-trace-btn" data-idx="${i}">출발 ▶</button>
      `;

      card.querySelector('.participant-trace-btn')?.addEventListener('click', (e) => {
        e.stopPropagation();
        tracePlayer(i);
      });

      card.querySelector('.participant-name-input')?.addEventListener('input', (e) => {
        participantNames[i] = (e.target as HTMLInputElement).value;
      });

      slot.appendChild(card);
      participantsRow.appendChild(slot);
    }

    // Render Bottom Outcomes
    outcomesRow.innerHTML = '';
    for (let i = 0; i < playerCount; i++) {
      const name = outcomeNames[i] || `결과 ${i + 1}`;
      const slot = document.createElement('div');
      slot.className = 'outcome-slot';

      const card = document.createElement('div');
      card.className = 'outcome-card';
      card.id = `outcome-card-${i}`;

      card.innerHTML = `
        <input type="text" class="outcome-name-input" data-idx="${i}" value="${name}" spellcheck="false" />
        <span class="outcome-winner-badge" id="outcome-badge-${i}"></span>
      `;

      card.querySelector('.outcome-name-input')?.addEventListener('input', (e) => {
        outcomeNames[i] = (e.target as HTMLInputElement).value;
      });

      slot.appendChild(card);
      outcomesRow.appendChild(slot);
    }
  }

  function getPoleX(poleIdx: number, totalPoles: number, width: number): number {
    return (poleIdx + 0.5) * (width / totalPoles);
  }

  function renderLadderSVG(
    activePaths: { points: { x: number; y: number }[]; color: string; head?: { x: number; y: number } }[] = []
  ) {
    if (!ladderSvg || !ladderContainer) return;
    const width = ladderContainer.clientWidth || 800;
    const height = ladderHeight;
    ladderSvg.setAttribute('viewBox', `0 0 ${width} ${height}`);

    let svgContent = '';

    const isMicro = playerCount >= 16;
    const isDense = playerCount >= 11;
    const poleStroke = isMicro ? 2.2 : (isDense ? 3 : 4);
    const bridgeStroke = isMicro ? 2.2 : (isDense ? 3 : 4);
    const pathStroke = isMicro ? 3.4 : (isDense ? 4.2 : 5);
    const headRadius = isMicro ? 5.5 : (isDense ? 6.5 : 8);

    // Draw Vertical Poles
    for (let i = 0; i < playerCount; i++) {
      const x = getPoleX(i, playerCount, width);
      svgContent += `
        <line x1="${x}" y1="0" x2="${x}" y2="${height}" 
              stroke="#334155" stroke-width="${poleStroke}" stroke-linecap="round" />
      `;
    }

    // Draw Horizontal Bridges (Only rendered when blind is OFF to prevent any peeking)
    if (!isBlindActive) {
      for (const b of bridges) {
        const x1 = getPoleX(b.poleA, playerCount, width);
        const x2 = getPoleX(b.poleB, playerCount, width);
        svgContent += `
          <line x1="${x1}" y1="${b.y}" x2="${x2}" y2="${b.y}" 
                stroke="#475569" stroke-width="${bridgeStroke}" stroke-linecap="round" />
        `;
      }
    }

    // Draw Active Traced Paths
    for (const path of activePaths) {
      if (path.points.length > 1) {
        let d = `M ${path.points[0].x} ${path.points[0].y}`;
        for (let j = 1; j < path.points.length; j++) {
          d += ` L ${path.points[j].x} ${path.points[j].y}`;
        }
        svgContent += `
          <path d="${d}" fill="none" stroke="${path.color}" stroke-width="${pathStroke}" 
                stroke-linecap="round" stroke-linejoin="round"
                filter="drop-shadow(0 0 8px ${path.color})" />
        `;
      }

      // Draw Glowing Runner Head
      if (path.head) {
        svgContent += `
          <circle cx="${path.head.x}" cy="${path.head.y}" r="${headRadius}" fill="#ffffff" stroke="${path.color}" stroke-width="2.5" 
                  filter="drop-shadow(0 0 10px ${path.color})" />
        `;
      }
    }

    ladderSvg.innerHTML = svgContent;
  }

  // Calculate full discrete vertex path and exact integer destination pole for a given start pole
  function calculatePath(startPole: number, width: number, height: number): { points: { x: number; y: number }[]; destPole: number } {
    const points: { x: number; y: number }[] = [];
    let curPole = startPole;
    let curY = 0;

    points.push({ x: getPoleX(curPole, playerCount, width), y: curY });

    const sortedBridges = [...bridges].sort((a, b) => a.y - b.y);

    for (const b of sortedBridges) {
      if (b.y > curY) {
        if (b.poleA === curPole) {
          // Move down to bridge
          points.push({ x: getPoleX(curPole, playerCount, width), y: b.y });
          // Cross bridge to poleB
          curPole = b.poleB;
          points.push({ x: getPoleX(curPole, playerCount, width), y: b.y });
          curY = b.y;
        } else if (b.poleB === curPole) {
          // Move down to bridge
          points.push({ x: getPoleX(curPole, playerCount, width), y: b.y });
          // Cross bridge to poleA
          curPole = b.poleA;
          points.push({ x: getPoleX(curPole, playerCount, width), y: b.y });
          curY = b.y;
        }
      }
    }

    // Move to bottom
    points.push({ x: getPoleX(curPole, playerCount, width), y: height });
    return { points, destPole: curPole };
  }

  // Precompute cumulative lengths along a discrete path for smooth interpolation
  function computePathSegments(points: { x: number; y: number }[]) {
    const cumulative: number[] = [0];
    let total = 0;
    for (let i = 0; i < points.length - 1; i++) {
      const p1 = points[i];
      const p2 = points[i + 1];
      const segLen = Math.abs(p2.x - p1.x) + Math.abs(p2.y - p1.y);
      total += segLen;
      cumulative.push(total);
    }
    return { points, cumulative, totalLength: total };
  }

  // Interpolate along path at a given distance d
  function getSubPathAtDistance(
    pathData: { points: { x: number; y: number }[]; cumulative: number[]; totalLength: number },
    dist: number
  ): { subPoints: { x: number; y: number }[]; head: { x: number; y: number }; segmentIndex: number } {
    const { points, cumulative, totalLength } = pathData;
    const clampedDist = Math.max(0, Math.min(totalLength, dist));

    let segIdx = 0;
    while (segIdx < cumulative.length - 1 && cumulative[segIdx + 1] < clampedDist) {
      segIdx++;
    }

    const segStartDist = cumulative[segIdx];
    const segEndDist = cumulative[segIdx + 1] || segStartDist + 1;
    const segLen = segEndDist - segStartDist;
    const u = segLen > 0 ? (clampedDist - segStartDist) / segLen : 0;

    const pA = points[segIdx];
    const pB = points[segIdx + 1] || pA;

    const head = {
      x: pA.x + u * (pB.x - pA.x),
      y: pA.y + u * (pB.y - pA.y)
    };

    const subPoints = points.slice(0, segIdx + 1);
    subPoints.push(head);

    return { subPoints, head, segmentIndex: segIdx };
  }

  // Trace one player path with buttery-smooth continuous animation
  function tracePlayer(playerIdx: number) {
    if (isTracing || !ladderContainer) return;
    cancelActiveAnimation();
    unveilBlind();
    isTracing = true;

    const width = ladderContainer.clientWidth || 800;
    const height = ladderHeight;
    const { points: fullPoints, destPole } = calculatePath(playerIdx, width, height);
    const pathData = computePathSegments(fullPoints);
    const color = PLAYER_COLORS[playerIdx % PLAYER_COLORS.length];

    const duration = SPEED_DURATIONS[speedMode];
    const startTime = performance.now();
    let lastSegIdx = 0;
    let lastStepDist = 0;

    function step() {
      const now = performance.now();
      const elapsed = now - startTime;
      const progress = Math.min(1.0, elapsed / duration);
      const currentDist = progress * pathData.totalLength;

      const { subPoints, head, segmentIndex } = getSubPathAtDistance(pathData, currentDist);

      // Play chime on bridge turn
      if (segmentIndex !== lastSegIdx) {
        audio.playTurn(520 + (segmentIndex % 6) * 40);
        lastSegIdx = segmentIndex;
      } else if (currentDist - lastStepDist > 45) {
        audio.playStep(380 + (Math.floor(currentDist / 45) % 6) * 30);
        lastStepDist = currentDist;
      }

      renderLadderSVG([{ points: subPoints, color, head }]);

      if (progress < 1.0) {
        animFrameId = requestAnimationFrame(step);
      } else {
        animFrameId = null;
        isTracing = false;
        audio.playWin();

        // Reveal exact destination card directly from destPole
        const outcomeCard = document.getElementById(`outcome-card-${destPole}`);
        if (outcomeCard) {
          outcomeCard.classList.add('revealed');
          const badge = document.getElementById(`outcome-badge-${destPole}`);
          if (badge) badge.textContent = `👑 ${participantNames[playerIdx]}`;
        }
      }
    }

    animFrameId = requestAnimationFrame(step);
  }

  // Trace ALL players simultaneously with synchronized smooth animation
  function startAll() {
    if (isTracing || !ladderContainer) return;
    cancelActiveAnimation();
    unveilBlind();
    isTracing = true;

    const width = ladderContainer.clientWidth || 800;
    const height = ladderHeight;

    const allPaths = [];
    const playerDestinations: number[] = [];
    const results: { player: string; outcome: string; color: string; emoji: string }[] = [];

    for (let p = 0; p < playerCount; p++) {
      const { points: pts, destPole } = calculatePath(p, width, height);
      allPaths.push(computePathSegments(pts));
      playerDestinations.push(destPole);

      results.push({
        player: participantNames[p],
        outcome: outcomeNames[destPole],
        color: PLAYER_COLORS[p % PLAYER_COLORS.length],
        emoji: EMOJIS[p % EMOJIS.length]
      });
    }

    // Reset previous revealed states
    for (let d = 0; d < playerCount; d++) {
      const card = document.getElementById(`outcome-card-${d}`);
      card?.classList.remove('revealed');
      const badge = document.getElementById(`outcome-badge-${d}`);
      if (badge) badge.textContent = '';
    }

    const duration = SPEED_DURATIONS[speedMode];
    const startTime = performance.now();
    let lastStepSoundTime = 0;

    function step() {
      const now = performance.now();
      const elapsed = now - startTime;
      const progress = Math.min(1.0, elapsed / duration);

      const activePaths = [];
      for (let p = 0; p < playerCount; p++) {
        const color = PLAYER_COLORS[p % PLAYER_COLORS.length];
        const pData = allPaths[p];
        const curDist = progress * pData.totalLength;
        const { subPoints, head } = getSubPathAtDistance(pData, curDist);
        activePaths.push({ points: subPoints, color, head });
      }

      if (now - lastStepSoundTime > 140) {
        audio.playStep(400 + (Math.floor(elapsed / 140) % 8) * 35);
        lastStepSoundTime = now;
      }

      renderLadderSVG(activePaths);

      if (progress < 1.0) {
        animFrameId = requestAnimationFrame(step);
      } else {
        animFrameId = null;
        isTracing = false;
        audio.playWin();

        // Reveal all outcome cards with unique 1-to-1 winner badges
        for (let p = 0; p < playerCount; p++) {
          const destPole = playerDestinations[p];
          const card = document.getElementById(`outcome-card-${destPole}`);
          if (card) {
            card.classList.add('revealed');
            const badge = document.getElementById(`outcome-badge-${destPole}`);
            if (badge) badge.textContent = `👑 ${participantNames[p]}`;
          }
        }

        setTimeout(() => {
          if (resultSummaryList && resultModal) {
            resultSummaryList.innerHTML = results.map(r => `
              <div class="summary-item" style="border-left: 4px solid ${r.color}">
                <div class="summary-player">
                  <span>${r.emoji}</span>
                  <strong>${r.player}</strong>
                </div>
                <div class="summary-arrow">➔</div>
                <div class="summary-outcome">${r.outcome}</div>
              </div>
            `).join('');
            resultModal.classList.remove('hidden');
          }
        }, 500);
      }
    }

    animFrameId = requestAnimationFrame(step);
  }

  // Reveal all paths at once (Instant)
  function revealAll() {
    cancelActiveAnimation();
    if (!ladderContainer) return;
    unveilBlind();
    const width = ladderContainer.clientWidth || 800;
    const height = ladderHeight;

    const allPaths: { points: { x: number; y: number }[]; color: string }[] = [];
    const results: { player: string; outcome: string; color: string; emoji: string }[] = [];

    // Reset previous revealed states
    for (let d = 0; d < playerCount; d++) {
      const card = document.getElementById(`outcome-card-${d}`);
      card?.classList.remove('revealed');
      const badge = document.getElementById(`outcome-badge-${d}`);
      if (badge) badge.textContent = '';
    }

    for (let p = 0; p < playerCount; p++) {
      const color = PLAYER_COLORS[p % PLAYER_COLORS.length];
      const emoji = EMOJIS[p % EMOJIS.length];
      const { points, destPole } = calculatePath(p, width, height);
      allPaths.push({ points, color });

      results.push({
        player: participantNames[p],
        outcome: outcomeNames[destPole],
        color,
        emoji
      });

      const outcomeCard = document.getElementById(`outcome-card-${destPole}`);
      if (outcomeCard) {
        outcomeCard.classList.add('revealed');
        const badge = document.getElementById(`outcome-badge-${destPole}`);
        if (badge) badge.textContent = `👑 ${participantNames[p]}`;
      }
    }

    renderLadderSVG(allPaths);
    audio.playWin();

    if (resultSummaryList && resultModal) {
      resultSummaryList.innerHTML = results.map(r => `
        <div class="summary-item" style="border-left: 4px solid ${r.color}">
          <div class="summary-player">
            <span>${r.emoji}</span>
            <strong>${r.player}</strong>
          </div>
          <div class="summary-arrow">➔</div>
          <div class="summary-outcome">${r.outcome}</div>
        </div>
      `).join('');
      resultModal.classList.remove('hidden');
    }
  }

  // Change Player Count
  function setPlayerCount(newCount: number) {
    newCount = Math.max(2, Math.min(20, newCount));
    if (newCount === playerCount) return;
    playerCount = newCount;
    initLadder();
  }

  countDecBtn?.addEventListener('click', () => setPlayerCount(playerCount - 1));
  countIncBtn?.addEventListener('click', () => setPlayerCount(playerCount + 1));

  countBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      const cnt = parseInt(btn.getAttribute('data-count') || '4', 10);
      setPlayerCount(cnt);
    });
  });

  // Speed selection
  speedBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      speedBtns.forEach(b => b.classList.remove('active'));
      btn.classList.add('active');
      speedMode = (btn.getAttribute('data-speed') || 'normal') as 'slow' | 'normal' | 'fast';
    });
  });

  // Presets with smart dynamic array generation for any player count
  document.querySelectorAll('.preset-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      const key = btn.getAttribute('data-preset') || 'coffee';
      const template = PRESET_TEMPLATES[key];
      if (template) {
        // Build outcomes tailored for current playerCount
        const newOutcomes: string[] = [];
        const penaltyCount = key === 'coffee' || key === 'chicken' ? 1 : Math.max(1, Math.floor(playerCount / 3));

        for (let i = 0; i < playerCount; i++) {
          if (i < penaltyCount) {
            newOutcomes.push(template.penalties[i % template.penalties.length]);
          } else {
            newOutcomes.push(template.defaultOutcome);
          }
        }

        // Shuffle outcomes so penalty isn't always at index 0
        for (let i = newOutcomes.length - 1; i > 0; i--) {
          const j = Math.floor(Math.random() * (i + 1));
          [newOutcomes[i], newOutcomes[j]] = [newOutcomes[j], newOutcomes[i]];
        }

        outcomeNames = newOutcomes;
        initLadder();
      }
    });
  });

  startAllBtn?.addEventListener('click', startAll);
  revealAllBtn?.addEventListener('click', revealAll);
  rerollBtn?.addEventListener('click', initLadder);
  closeResultBtn?.addEventListener('click', () => resultModal?.classList.add('hidden'));
  toggleBlindBtn?.addEventListener('click', toggleBlind);
  blindUnveilCenterBtn?.addEventListener('click', unveilBlind);

  // Window resize re-draw
  window.addEventListener('resize', () => {
    if (ladderStageInner) {
      const stageContainer = ladderContainer?.parentElement?.parentElement || document.getElementById('ladder-stage');
      const containerWidth = stageContainer?.clientWidth ? (stageContainer.clientWidth - 24) : 1000;
      const idealWidth = playerCount <= 6 
        ? Math.min(containerWidth, Math.max(460, playerCount * 125))
        : Math.min(containerWidth, Math.max(640, playerCount * (playerCount >= 16 ? 46 : (playerCount >= 11 ? 54 : 68))));
      ladderStageInner.style.maxWidth = `${idealWidth}px`;
    }
    renderLadderSVG();
  });

  // Launch
  initLadder();
</script>
