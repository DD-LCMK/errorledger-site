      penalties: [
        'Cleaning duty 🧹', 'Dishwashing 🧼', 'Recycling ♻️',
        'Snack errand 🍪', 'Meeting notes ✍️'
      ]
    }
  };

  // Speed Durations in milliseconds
  const SPEED_DURATIONS = {
    slow: 6200,   // ~6.2s for maximum suspense
    normal: 4000, // ~4.0s for clear, enjoyable pacing
    fast: 2000    // ~2.0s for quick resolution
  };

  let speedMode: 'slow' | 'normal' | 'fast' = 'normal';
  let playerCount = 4;
  let participantNames: string[] = isEn 
    ? ['Player 1', 'Player 2', 'Player 3', 'Player 4']
    : ['참가자 1', '참가자 2', '참가자 3', '참가자 4'];
  let outcomeNames: string[] = isEn
    ? ['Win 🍗', 'Pass 💨', 'Coffee ☕', 'Safe ✨']
    : ['당첨 🍗', '꽝 💨', '커피 ☕', '생존 ✨'];
  let bridges: { poleA: number; poleB: number; y: number }[] = [];
  let isTracing = false;
  let animFrameId: number | null = null;
  let ladderHeight = 500;

  // Web Audio Synth for footsteps and turns
  class StepAudio {
    private ctx: AudioContext | null = null;
    private lastStepTime = 0;

    private isMuted(): boolean {
      try {
        return localStorage.getItem('aether_sound_muted') === 'true';
      } catch {
        return false;
      }
    }

    private getContext(): AudioContext | null {
      if (this.isMuted()) return null;
      if (!this.ctx) {
        const AudioCtx = window.AudioContext || (window as any).webkitAudioContext;
        if (AudioCtx) this.ctx = new AudioCtx();
      }
      if (this.ctx && this.ctx.state === 'suspended') {
        this.ctx.resume();
      }
      return this.ctx;
    }

    playStep(freq = 400) {
      const now = performance.now();
      if (now - this.lastStepTime < 50) return; // Throttle sound playback
      this.lastStepTime = now;

      const ctx = this.getContext();
      if (!ctx) return;
      const osc = ctx.createOscillator();
      const gain = ctx.createGain();
      osc.type = 'sine';
      osc.frequency.setValueAtTime(freq, ctx.currentTime);
      gain.gain.setValueAtTime(0.12, ctx.currentTime);
      gain.gain.exponentialRampToValueAtTime(0.005, ctx.currentTime + 0.05);
      osc.connect(gain);
      gain.connect(ctx.destination);
      osc.start();
      osc.stop(ctx.currentTime + 0.05);
    }

    playTurn(freq = 550) {
      const ctx = this.getContext();
      if (!ctx) return;
      const osc = ctx.createOscillator();
      const gain = ctx.createGain();
      osc.type = 'triangle';
      osc.frequency.setValueAtTime(freq, ctx.currentTime);
      gain.gain.setValueAtTime(0.18, ctx.currentTime);
      gain.gain.exponentialRampToValueAtTime(0.005, ctx.currentTime + 0.08);
      osc.connect(gain);
      gain.connect(ctx.destination);
      osc.start();
      osc.stop(ctx.currentTime + 0.08);
    }

    playWin() {
      const ctx = this.getContext();
      if (!ctx) return;
      const notes = [440, 554.37, 659.25, 880];
      notes.forEach((f, i) => {
        const osc = ctx.createOscillator();
        const gain = ctx.createGain();
        osc.type = 'triangle';
        osc.frequency.setValueAtTime(f, ctx.currentTime + i * 0.09);
        gain.gain.setValueAtTime(0.22, ctx.currentTime + i * 0.09);
        gain.gain.exponentialRampToValueAtTime(0.01, ctx.currentTime + i * 0.09 + 0.25);
        osc.connect(gain);
        gain.connect(ctx.destination);
        osc.start(ctx.currentTime + i * 0.09);
        osc.stop(ctx.currentTime + i * 0.09 + 0.25);
      });
    }
  }

  const audio = new StepAudio();

  // DOM Elements
  const ladderStageInner = document.getElementById('ladder-stage-inner');
  const participantsRow = document.getElementById('participants-row');
  const outcomesRow = document.getElementById('outcomes-row');
  const ladderSvg = document.getElementById('ladder-svg') as SVGSVGElement | null;
  const ladderContainer = document.getElementById('ladder-container');

  const countDisplay = document.getElementById('count-display');
  const countDecBtn = document.getElementById('count-dec-btn');
  const countIncBtn = document.getElementById('count-inc-btn');
  const countBtns = document.querySelectorAll('.count-btn');
  const speedBtns = document.querySelectorAll('.speed-btn');

  const startAllBtn = document.getElementById('start-all-btn');
  const revealAllBtn = document.getElementById('reveal-all-btn');
  const rerollBtn = document.getElementById('reroll-ladder-btn');

  const ladderBlind = document.getElementById('ladder-blind');
  const toggleBlindBtn = document.getElementById('toggle-blind-btn');
  const blindBtnText = document.getElementById('blind-btn-text');
  const blindUnveilCenterBtn = document.getElementById('blind-unveil-center-btn');

  const resultModal = document.getElementById('result-modal');
  const resultSummaryList = document.getElementById('result-summary-list');
  const closeResultBtn = document.getElementById('close-result-btn');

  // Web Crypto SHA-256 Helper for Provably Fair Verification
  async function sha256Hex(str: string): Promise<string> {
    const encoder = new TextEncoder();
    const data = encoder.encode(str);
    const hashBuf = await window.crypto.subtle.digest('SHA-256', data);
    return Array.from(new Uint8Array(hashBuf))
      .map(b => b.toString(16).padStart(2, '0'))
      .join('');
  }

  interface LadderFairness {
    seed: string;
    timestamp: string;
    playerCount: number;
    rawSecret: string;
    hashHex: string;
    results: string[];
  }
  let currentLadderFairness: LadderFairness | null = null;

  let isBlindActive = true;

  function cancelActiveAnimation() {
    if (animFrameId !== null) {
      cancelAnimationFrame(animFrameId);
      animFrameId = null;
    }
    isTracing = false;
  }

  function coverBlind() {
    isBlindActive = true;
    ladderBlind?.classList.remove('unveiled');
    toggleBlindBtn?.classList.remove('off');
    if (blindBtnText) blindBtnText.textContent = isEn ? '🔒 Blind ON' : '🔒 가림막 ON';
    if (toggleBlindBtn) toggleBlindBtn.setAttribute('title', isEn ? 'Toggle ladder blind (hide/show rungs)' : '사다리 가림막 켜기/끄기');
    renderLadderSVG();
  }

  function unveilBlind() {
    isBlindActive = false;
    ladderBlind?.classList.add('unveiled');
    toggleBlindBtn?.classList.add('off');
    if (blindBtnText) blindBtnText.textContent = isEn ? '👁️ Blind OFF' : '👁️ 가림막 OFF';
    if (toggleBlindBtn) toggleBlindBtn.setAttribute('title', isEn ? 'Toggle ladder blind (hide/show rungs)' : '사다리 가림막 켜기/끄기');
    renderLadderSVG();
  }

  function toggleBlind() {
    if (isBlindActive) {
      unveilBlind();
    } else {
      coverBlind();
    }
  }

  // Ensure names and outcomes match playerCount
  function syncArrays() {
    while (participantNames.length < playerCount) {
      participantNames.push(isEn ? `Player ${participantNames.length + 1}` : `참가자 ${participantNames.length + 1}`);
    }
    while (outcomeNames.length < playerCount) {
      outcomeNames.push(isEn ? `Result ${outcomeNames.length + 1}` : `결과 ${outcomeNames.length + 1}`);
    }
  }

  function initLadder() {
    cancelActiveAnimation();
    syncArrays();

    // Scale stage width and SVG height based on player count so all participants fit in 1 screen
    const stageContainer = ladderContainer?.parentElement?.parentElement || document.getElementById('ladder-stage');
    const containerWidth = stageContainer?.clientWidth ? (stageContainer.clientWidth - 24) : 1000;
    const idealWidth = playerCount <= 6 
      ? Math.min(containerWidth, Math.max(460, playerCount * 125))
      : Math.min(containerWidth, Math.max(640, playerCount * (playerCount >= 16 ? 46 : (playerCount >= 11 ? 54 : 68))));

    if (ladderStageInner) {
      let densityClass = 'density-normal';
      if (playerCount >= 16) {
        densityClass = 'density-micro';
      } else if (playerCount >= 11) {
        densityClass = 'density-dense';
      } else if (playerCount >= 7) {
        densityClass = 'density-compact';
      }
      ladderStageInner.className = `ladder-stage-inner ${densityClass}`;
      ladderStageInner.style.width = '100%';
      ladderStageInner.style.maxWidth = `${idealWidth}px`;
      ladderStageInner.style.minWidth = '0';
    }

    // Determine row count and discrete spacing
    const numRows = Math.min(32, Math.max(12, Math.floor(playerCount * 1.3) + 5));
    ladderHeight = Math.min(580, Math.max(480, 420 + numRows * 5.5));
    if (ladderContainer) {
      ladderContainer.style.height = `${ladderHeight}px`;
    }

    bridges = [];
    const rowSpacing = ladderHeight / (numRows + 1);

    // Track occupied poles per row to mathematically guarantee 100% Bijection (Transposition)
    // In any valid Amidakuji, NO TWO BRIDGES ON THE SAME ROW CAN SHARE AN ENDPOINT.
    const occupiedAtRow: Set<number>[] = Array.from({ length: numRows + 1 }, () => new Set<number>());

    // Phase 1: Ensure every adjacent pair (p, p+1) has at least 1 connecting bridge
    for (let p = 0; p < playerCount - 1; p++) {
      const candidates: number[] = [];
      for (let r = 1; r <= numRows; r++) {
        if (!occupiedAtRow[r].has(p) && !occupiedAtRow[r].has(p + 1)) {
          candidates.push(r);
        }
      }
      if (candidates.length > 0) {
        const chosenRow = candidates[Math.floor(Math.random() * candidates.length)];
        occupiedAtRow[chosenRow].add(p);
        occupiedAtRow[chosenRow].add(p + 1);
        bridges.push({ poleA: p, poleB: p + 1, y: chosenRow * rowSpacing });
      }
    }

    // Phase 2: Add additional randomized bridges with strict disjointness
    for (let r = 1; r <= numRows; r++) {
      let p = 0;
      while (p < playerCount - 1) {
        if (!occupiedAtRow[r].has(p) && !occupiedAtRow[r].has(p + 1)) {
          if (Math.random() < 0.5) {
            occupiedAtRow[r].add(p);
            occupiedAtRow[r].add(p + 1);
            bridges.push({ poleA: p, poleB: p + 1, y: r * rowSpacing });
            p += 2; // Jump past p+1 to prevent any adjacent collision at the exact same row
            continue;
          }
        }
        p += 1;
      }
    }

    // Mathematical Invariant Assertion: Verify all player destinations are 100% unique (Strict 1-to-1 Bijection)
    const testDestinations = new Set<number>();
    for (let p = 0; p < playerCount; p++) {
      const { destPole } = calculatePath(p, 800, ladderHeight);
      if (testDestinations.has(destPole)) {
        console.warn(`[Amidakuji Invariant Check] Duplicate at pole ${destPole}. Re-generating ladder...`);
        initLadder();
        return;
      }
      testDestinations.add(destPole);
    }

    // Reset outcome cards
    for (let d = 0; d < playerCount; d++) {
      const card = document.getElementById(`outcome-card-${d}`);
      card?.classList.remove('revealed');
      const badge = document.getElementById(`outcome-badge-${d}`);
      if (badge) badge.textContent = '';
    }

    renderUI();
    renderLadderSVG();
    coverBlind();

    // Generate Provably Fair SHA-256 Pre-Hash of the generated ladder
    const ladderSeedArr = new Uint8Array(8);
    window.crypto.getRandomValues(ladderSeedArr);
    const ladderSeed = Array.from(ladderSeedArr, b => b.toString(16).padStart(2, '0')).join('');
    const timestamp = new Date().toISOString();
    const bridgeSig = bridges.map(b => `${b.poleA}-${b.poleB}@${Math.round(b.y)}`).join(';');
    const rawSecret = `seed=${ladderSeed}|time=${timestamp}|players=${playerCount}|bridges=${bridgeSig}|p0=${participantNames[0] || ''}`;

    sha256Hex(rawSecret).then(hashHex => {
      currentLadderFairness = {
        seed: ladderSeed,
        timestamp,
        playerCount,
        rawSecret,
        hashHex,
        results: []
      };
      const hashElem = document.getElementById('ladder-fairness-hash');
      if (hashElem) {
        hashElem.textContent = hashHex;
        hashElem.title = hashHex;
      }
      syncChannel?.postMessage({
        type: 'PRE_HASH_GENERATED',
        hashHex
      });
    });
  }

  function renderUI() {
    if (!participantsRow || !outcomesRow) return;

    // Update count display and button active classes
    if (countDisplay) countDisplay.textContent = isEn ? `${playerCount}P` : `${playerCount}명`;
    countBtns.forEach(btn => {
      btn.classList.toggle('active', btn.getAttribute('data-count') === String(playerCount));
    });

    // Render Top Participants
    participantsRow.innerHTML = '';
    for (let i = 0; i < playerCount; i++) {
      const color = PLAYER_COLORS[i % PLAYER_COLORS.length];
      const emoji = EMOJIS[i % EMOJIS.length];
      const name = participantNames[i] || (isEn ? `Player ${i + 1}` : `참가자 ${i + 1}`);

      const slot = document.createElement('div');
      slot.className = 'participant-slot';

      const card = document.createElement('div');
      card.className = 'participant-card';
      card.style.borderColor = `${color}40`;

      card.innerHTML = `
        <div class="participant-avatar" style="background: ${color}25; border: 2px solid ${color};">
          ${emoji}
        </div>
        <input type="text" class="participant-name-input" data-idx="${i}" value="${name}" spellcheck="false" />
        <button class="participant-trace-btn" data-idx="${i}">${isEn ? 'GO ▶' : '출발 ▶'}</button>
      `;

      card.querySelector('.participant-trace-btn')?.addEventListener('click', (e) => {
        e.stopPropagation();
        tracePlayer(i);
      });

      card.querySelector('.participant-name-input')?.addEventListener('input', (e) => {
        participantNames[i] = (e.target as HTMLInputElement).value;
      });

      slot.appendChild(card);
      participantsRow.appendChild(slot);
    }

    // Render Bottom Outcomes
    outcomesRow.innerHTML = '';
    for (let i = 0; i < playerCount; i++) {
      const name = outcomeNames[i] || (isEn ? `Result ${i + 1}` : `결과 ${i + 1}`);
      const slot = document.createElement('div');
      slot.className = 'outcome-slot';

      const card = document.createElement('div');
      card.className = 'outcome-card';
      card.id = `outcome-card-${i}`;

      card.innerHTML = `
        <input type="text" class="outcome-name-input" data-idx="${i}" value="${name}" spellcheck="false" />
        <span class="outcome-winner-badge" id="outcome-badge-${i}"></span>
      `;

      card.querySelector('.outcome-name-input')?.addEventListener('input', (e) => {
        outcomeNames[i] = (e.target as HTMLInputElement).value;
      });

      slot.appendChild(card);
      outcomesRow.appendChild(slot);
    }
  }

  function getPoleX(poleIdx: number, totalPoles: number, width: number): number {
    return (poleIdx + 0.5) * (width / totalPoles);
  }

  function renderLadderSVG(
    activePaths: { points: { x: number; y: number }[]; color: string; head?: { x: number; y: number } }[] = []
  ) {
    if (!ladderSvg || !ladderContainer) return;
    const width = ladderContainer.clientWidth || 800;
    const height = ladderHeight;
    ladderSvg.setAttribute('viewBox', `0 0 ${width} ${height}`);

    let svgContent = '';

    const isMicro = playerCount >= 16;
    const isDense = playerCount >= 11;
    const poleStroke = isMicro ? 2.2 : (isDense ? 3 : 4);
    const bridgeStroke = isMicro ? 2.2 : (isDense ? 3 : 4);
    const pathStroke = isMicro ? 3.4 : (isDense ? 4.2 : 5);
    const headRadius = isMicro ? 5.5 : (isDense ? 6.5 : 8);

    // Draw Vertical Poles
    for (let i = 0; i < playerCount; i++) {
      const x = getPoleX(i, playerCount, width);
      svgContent += `
        <line x1="${x}" y1="0" x2="${x}" y2="${height}" 
              stroke="#334155" stroke-width="${poleStroke}" stroke-linecap="round" />
      `;
    }

    // Draw Horizontal Bridges (Only rendered when blind is OFF to prevent any peeking)
    if (!isBlindActive) {
      for (const b of bridges) {
        const x1 = getPoleX(b.poleA, playerCount, width);
        const x2 = getPoleX(b.poleB, playerCount, width);
        svgContent += `
          <line x1="${x1}" y1="${b.y}" x2="${x2}" y2="${b.y}" 
                stroke="#475569" stroke-width="${bridgeStroke}" stroke-linecap="round" />
        `;
      }
    }

    // Draw Active Traced Paths
    for (const path of activePaths) {
      if (path.points.length > 1) {
        let d = `M ${path.points[0].x} ${path.points[0].y}`;
        for (let j = 1; j < path.points.length; j++) {
          d += ` L ${path.points[j].x} ${path.points[j].y}`;
        }
        svgContent += `
          <path d="${d}" fill="none" stroke="${path.color}" stroke-width="${pathStroke}" 
                stroke-linecap="round" stroke-linejoin="round"
                filter="drop-shadow(0 0 8px ${path.color})" />
        `;
      }

      // Draw Glowing Runner Head
      if (path.head) {
        svgContent += `
          <circle cx="${path.head.x}" cy="${path.head.y}" r="${headRadius}" fill="#ffffff" stroke="${path.color}" stroke-width="2.5" 
                  filter="drop-shadow(0 0 10px ${path.color})" />
        `;
      }
    }

    ladderSvg.innerHTML = svgContent;
  }

  // Calculate full discrete vertex path and exact integer destination pole for a given start pole
  function calculatePath(startPole: number, width: number, height: number): { points: { x: number; y: number }[]; destPole: number } {
    const points: { x: number; y: number }[] = [];
    let curPole = startPole;
    let curY = 0;

    points.push({ x: getPoleX(curPole, playerCount, width), y: curY });

    const sortedBridges = [...bridges].sort((a, b) => a.y - b.y);

    for (const b of sortedBridges) {
      if (b.y > curY) {
        if (b.poleA === curPole) {
          // Move down to bridge
          points.push({ x: getPoleX(curPole, playerCount, width), y: b.y });
          // Cross bridge to poleB
          curPole = b.poleB;
          points.push({ x: getPoleX(curPole, playerCount, width), y: b.y });
          curY = b.y;
        } else if (b.poleB === curPole) {
          // Move down to bridge
          points.push({ x: getPoleX(curPole, playerCount, width), y: b.y });
          // Cross bridge to poleA
          curPole = b.poleA;
          points.push({ x: getPoleX(curPole, playerCount, width), y: b.y });
          curY = b.y;
        }
      }
    }

    // Move to bottom
    points.push({ x: getPoleX(curPole, playerCount, width), y: height });
    return { points, destPole: curPole };
  }

  // Precompute cumulative lengths along a discrete path for smooth interpolation
  function computePathSegments(points: { x: number; y: number }[]) {
    const cumulative: number[] = [0];
    let total = 0;
    for (let i = 0; i < points.length - 1; i++) {
      const p1 = points[i];
      const p2 = points[i + 1];
      const segLen = Math.abs(p2.x - p1.x) + Math.abs(p2.y - p1.y);
      total += segLen;
      cumulative.push(total);
    }
    return { points, cumulative, totalLength: total };
  }

  // Interpolate along path at a given distance d
  function getSubPathAtDistance(
    pathData: { points: { x: number; y: number }[]; cumulative: number[]; totalLength: number },
    dist: number
  ): { subPoints: { x: number; y: number }[]; head: { x: number; y: number }; segmentIndex: number } {
    const { points, cumulative, totalLength } = pathData;
    const clampedDist = Math.max(0, Math.min(totalLength, dist));

    let segIdx = 0;
    while (segIdx < cumulative.length - 1 && cumulative[segIdx + 1] < clampedDist) {
      segIdx++;
    }

    const segStartDist = cumulative[segIdx];
    const segEndDist = cumulative[segIdx + 1] || segStartDist + 1;
    const segLen = segEndDist - segStartDist;
    const u = segLen > 0 ? (clampedDist - segStartDist) / segLen : 0;

    const pA = points[segIdx];
    const pB = points[segIdx + 1] || pA;

    const head = {
      x: pA.x + u * (pB.x - pA.x),
      y: pA.y + u * (pB.y - pA.y)
    };

    const subPoints = points.slice(0, segIdx + 1);
    subPoints.push(head);

    return { subPoints, head, segmentIndex: segIdx };
  }

  // Trace one player path with buttery-smooth continuous animation
  function tracePlayer(playerIdx: number) {
    if (isTracing || !ladderContainer) return;
    cancelActiveAnimation();
    unveilBlind();
    isTracing = true;

    const width = ladderContainer.clientWidth || 800;
    const height = ladderHeight;
    const { points: fullPoints, destPole } = calculatePath(playerIdx, width, height);
    const pathData = computePathSegments(fullPoints);
    const color = PLAYER_COLORS[playerIdx % PLAYER_COLORS.length];

    const duration = SPEED_DURATIONS[speedMode];
    const startTime = performance.now();
    let lastSegIdx = 0;
    let lastStepDist = 0;

    function step() {
      const now = performance.now();
      const elapsed = now - startTime;
      const progress = Math.min(1.0, elapsed / duration);
      const currentDist = progress * pathData.totalLength;

      const { subPoints, head, segmentIndex } = getSubPathAtDistance(pathData, currentDist);

      // Play chime on bridge turn
      if (segmentIndex !== lastSegIdx) {
        audio.playTurn(520 + (segmentIndex % 6) * 40);
        lastSegIdx = segmentIndex;
      } else if (currentDist - lastStepDist > 45) {
        audio.playStep(380 + (Math.floor(currentDist / 45) % 6) * 30);
        lastStepDist = currentDist;
      }

      renderLadderSVG([{ points: subPoints, color, head }]);

      if (progress < 1.0) {
        animFrameId = requestAnimationFrame(step);
      } else {
        animFrameId = null;
        isTracing = false;
        audio.playWin();

        // Reveal exact destination card directly from destPole
        const outcomeCard = document.getElementById(`outcome-card-${destPole}`);
        if (outcomeCard) {
          outcomeCard.classList.add('revealed');
          const badge = document.getElementById(`outcome-badge-${destPole}`);
          if (badge) badge.textContent = `👑 ${participantNames[playerIdx]}`;
        }
      }
    }

    animFrameId = requestAnimationFrame(step);
  }

  // Trace ALL players simultaneously with synchronized smooth animation
  function startAll() {
    if (isTracing || !ladderContainer) return;
    cancelActiveAnimation();
    unveilBlind();
    isTracing = true;

    const width = ladderContainer.clientWidth || 800;
    const height = ladderHeight;

    const allPaths = [];
    const playerDestinations: number[] = [];
    const results: { player: string; outcome: string; color: string; emoji: string }[] = [];

    for (let p = 0; p < playerCount; p++) {
      const { points: pts, destPole } = calculatePath(p, width, height);
      allPaths.push(computePathSegments(pts));
      playerDestinations.push(destPole);

      results.push({
        player: participantNames[p],
        outcome: outcomeNames[destPole],
        color: PLAYER_COLORS[p % PLAYER_COLORS.length],
        emoji: EMOJIS[p % EMOJIS.length]
      });
    }

    // Reset previous revealed states
    for (let d = 0; d < playerCount; d++) {
      const card = document.getElementById(`outcome-card-${d}`);
      card?.classList.remove('revealed');
      const badge = document.getElementById(`outcome-badge-${d}`);
      if (badge) badge.textContent = '';
    }

    const duration = SPEED_DURATIONS[speedMode];
    const startTime = performance.now();
    let lastStepSoundTime = 0;

    function step() {
      const now = performance.now();
      const elapsed = now - startTime;
      const progress = Math.min(1.0, elapsed / duration);

      const activePaths = [];
      for (let p = 0; p < playerCount; p++) {
        const color = PLAYER_COLORS[p % PLAYER_COLORS.length];
        const pData = allPaths[p];
        const curDist = progress * pData.totalLength;
        const { subPoints, head } = getSubPathAtDistance(pData, curDist);
        activePaths.push({ points: subPoints, color, head });
      }

      if (now - lastStepSoundTime > 140) {
        audio.playStep(400 + (Math.floor(elapsed / 140) % 8) * 35);
        lastStepSoundTime = now;
      }

      renderLadderSVG(activePaths);

      if (progress < 1.0) {
        animFrameId = requestAnimationFrame(step);
      } else {
        animFrameId = null;
        isTracing = false;
        audio.playWin();

        // Reveal all outcome cards with unique 1-to-1 winner badges
        for (let p = 0; p < playerCount; p++) {
          const destPole = playerDestinations[p];
          const card = document.getElementById(`outcome-card-${destPole}`);
          if (card) {
            card.classList.add('revealed');
            const badge = document.getElementById(`outcome-badge-${destPole}`);
            if (badge) badge.textContent = `👑 ${participantNames[p]}`;
          }
        }

        setTimeout(() => {
          showLadderResults(results);
        }, 500);
      }
    }

    animFrameId = requestAnimationFrame(step);
  }

  function showLadderResults(results: { player: string; outcome: string; color: string; emoji: string }[]) {
    if (!resultSummaryList || !resultModal) return;

    resultSummaryList.innerHTML = results.map(r => `
      <div class="summary-item" style="border-left: 4px solid ${r.color}">
        <div class="summary-player">
          <span>${r.emoji}</span>
          <strong>${r.player}</strong>
        </div>
        <div class="summary-arrow">➔</div>
        <div class="summary-outcome">${r.outcome}</div>
      </div>
    `).join('');

    // Update Provably Fair Verification Card
    if (currentLadderFairness) {
      currentLadderFairness.results = results.map(r => `${r.player} -> ${r.outcome}`);
      const verifyBox = document.getElementById('ladder-fairness-verify-box');
      const verifyRaw = document.getElementById('ladder-verify-raw');
      const verifyHash = document.getElementById('ladder-verify-hash');
      const verifyBadge = document.getElementById('ladder-verify-badge');
      const verifyMsg = document.getElementById('ladder-verify-status-msg');

      if (verifyBox) {
        verifyBox.classList.remove('hidden');
        if (verifyRaw) verifyRaw.textContent = currentLadderFairness.rawSecret;
        if (verifyHash) verifyHash.textContent = currentLadderFairness.hashHex;
        if (verifyBadge) {
          verifyBadge.className = 'verify-status-badge';
          verifyBadge.textContent = isEn ? 'Pre-Hash Match Pending' : '사전 검증 대기';
        }
        if (verifyMsg) verifyMsg.textContent = '';
      }
    }

    // Broadcast results to controller window
    syncChannel?.postMessage({
      type: 'LADDER_RESULTS',
      results
    });

    resultModal.classList.remove('hidden');
  }

  // Reveal all paths at once (Instant)
  function revealAll() {
    cancelActiveAnimation();
    if (!ladderContainer) return;
    unveilBlind();
    const width = ladderContainer.clientWidth || 800;
    const height = ladderHeight;

    const allPaths: { points: { x: number; y: number }[]; color: string }[] = [];
    const results: { player: string; outcome: string; color: string; emoji: string }[] = [];

    // Reset previous revealed states
    for (let d = 0; d < playerCount; d++) {
      const card = document.getElementById(`outcome-card-${d}`);
      card?.classList.remove('revealed');
      const badge = document.getElementById(`outcome-badge-${d}`);
      if (badge) badge.textContent = '';
    }

    for (let p = 0; p < playerCount; p++) {
      const color = PLAYER_COLORS[p % PLAYER_COLORS.length];
      const emoji = EMOJIS[p % EMOJIS.length];
      const { points, destPole } = calculatePath(p, width, height);
      allPaths.push({ points, color });

      results.push({
        player: participantNames[p],
        outcome: outcomeNames[destPole],
        color,
        emoji
      });

      const outcomeCard = document.getElementById(`outcome-card-${destPole}`);
      if (outcomeCard) {
        outcomeCard.classList.add('revealed');
        const badge = document.getElementById(`outcome-badge-${destPole}`);
        if (badge) badge.textContent = `👑 ${participantNames[p]}`;
      }
    }

    renderLadderSVG(allPaths);
    audio.playWin();
    showLadderResults(results);
  }

  // Change Player Count
  function setPlayerCount(newCount: number) {
    newCount = Math.max(2, Math.min(20, newCount));
    if (newCount === playerCount) return;
    playerCount = newCount;
    initLadder();
  }

  countDecBtn?.addEventListener('click', () => setPlayerCount(playerCount - 1));
  countIncBtn?.addEventListener('click', () => setPlayerCount(playerCount + 1));

  countBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      const cnt = parseInt(btn.getAttribute('data-count') || '4', 10);
      setPlayerCount(cnt);
    });
  });

  // Speed selection
  speedBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      speedBtns.forEach(b => b.classList.remove('active'));
      btn.classList.add('active');
      speedMode = (btn.getAttribute('data-speed') || 'normal') as 'slow' | 'normal' | 'fast';
    });
  });

  // Presets with smart dynamic array generation for any player count
  document.querySelectorAll('.preset-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      const key = btn.getAttribute('data-preset') || 'coffee';
      const template = isEn ? PRESET_TEMPLATES_EN[key] : PRESET_TEMPLATES[key];
      if (template) {
        // Build outcomes tailored for current playerCount
        const newOutcomes: string[] = [];
        const penaltyCount = key === 'coffee' || key === 'chicken' ? 1 : Math.max(1, Math.floor(playerCount / 3));

        for (let i = 0; i < playerCount; i++) {
          if (i < penaltyCount) {
            newOutcomes.push(template.penalties[i % template.penalties.length]);
          } else {
            newOutcomes.push(template.defaultOutcome);
          }
        }

        // Shuffle outcomes so penalty isn't always at index 0
        for (let i = newOutcomes.length - 1; i > 0; i--) {
          const j = Math.floor(Math.random() * (i + 1));
          [newOutcomes[i], newOutcomes[j]] = [newOutcomes[j], newOutcomes[i]];
        }

        outcomeNames = newOutcomes;
        initLadder();
      }
    });
  });

  startAllBtn?.addEventListener('click', startAll);
  revealAllBtn?.addEventListener('click', revealAll);
  rerollBtn?.addEventListener('click', initLadder);
  closeResultBtn?.addEventListener('click', () => resultModal?.classList.add('hidden'));
  toggleBlindBtn?.addEventListener('click', toggleBlind);
  blindUnveilCenterBtn?.addEventListener('click', unveilBlind);

  // Window resize re-draw
  window.addEventListener('resize', () => {
    if (ladderStageInner) {
      const stageContainer = ladderContainer?.parentElement?.parentElement || document.getElementById('ladder-stage');
      const containerWidth = stageContainer?.clientWidth ? (stageContainer.clientWidth - 24) : 1000;
      const idealWidth = playerCount <= 6 
        ? Math.min(containerWidth, Math.max(460, playerCount * 125))
        : Math.min(containerWidth, Math.max(640, playerCount * (playerCount >= 16 ? 46 : (playerCount >= 11 ? 54 : 68))));
      ladderStageInner.style.maxWidth = `${idealWidth}px`;
    }
    renderLadderSVG();
  });

  // Toast Helper
  function showLadderToast(msg: string) {
    const toast = document.getElementById('ladder-toast');
    if (!toast) return;
    toast.textContent = msg;
    toast.classList.remove('hidden');
    setTimeout(() => {
      toast.classList.add('hidden');
    }, 3200);
  }

  // 1. OBS Browser Source Copy
  const copyObsLadderBtn = document.getElementById('copy-obs-ladder-btn');
  copyObsLadderBtn?.addEventListener('click', () => {
    const url = new URL(window.location.href);
    url.searchParams.set('stream', 'true');
    const cleanUrl = url.href;
    if (navigator.clipboard && navigator.clipboard.writeText) {
      navigator.clipboard.writeText(cleanUrl).then(() => {
        showLadderToast(isEn ? '🎥 OBS Browser Source URL copied! (1920x1080 recommended)' : '🎥 OBS 브라우저 소스 URL 복사 완료! (1920x1080 권장)');
      }).catch(() => {
        prompt('OBS Browser URL:', cleanUrl);
      });
    } else {
      prompt('OBS Browser URL:', cleanUrl);
    }
  });

  // 2. Smart Nickname Bulk Input Modal
  const smartLadderModal = document.getElementById('smart-ladder-modal');
  const btnSmartInputLadder = document.getElementById('btn-smart-input-ladder');
  const btnCloseSmartLadder = document.getElementById('btn-close-smart-ladder');
  const smartLadderRawInput = document.getElementById('smart-ladder-raw-input') as HTMLTextAreaElement;
  const chkSmartLadderDedup = document.getElementById('chk-smart-ladder-dedup') as HTMLInputElement;
  const chkSmartLadderShuffle = document.getElementById('chk-smart-ladder-shuffle') as HTMLInputElement;
  const btnSmartLadderApply = document.getElementById('btn-smart-ladder-apply');

  btnSmartInputLadder?.addEventListener('click', () => {
    smartLadderModal?.classList.remove('hidden');
    smartLadderRawInput?.focus();
  });

  btnCloseSmartLadder?.addEventListener('click', () => {
    smartLadderModal?.classList.add('hidden');
  });

  smartLadderModal?.addEventListener('click', (e) => {
    if (e.target === smartLadderModal) smartLadderModal.classList.add('hidden');
  });

  btnSmartLadderApply?.addEventListener('click', () => {
    if (!smartLadderRawInput) return;
    let names = smartLadderRawInput.value
      .split(/[\r\n,\t/]+/)
      .map(s => s.trim())
      .filter(s => s.length > 0);

    if (chkSmartLadderDedup?.checked) {
      names = Array.from(new Set(names));
    }
    if (chkSmartLadderShuffle?.checked) {
      names.sort(() => Math.random() - 0.5);
    }
    if (names.length === 0) {
      showLadderToast(isEn ? 'Please enter participant names.' : '입력된 참가자 이름이 없습니다.');
      return;
    }

    const targetCount = Math.min(20, Math.max(2, names.length));
    playerCount = targetCount;
    participantNames = names.slice(0, targetCount);
    while (participantNames.length < playerCount) {
      participantNames.push(isEn ? `Player ${participantNames.length + 1}` : `참가자 ${participantNames.length + 1}`);
    }
    initLadder();
    smartLadderModal?.classList.add('hidden');
    smartLadderRawInput.value = '';
    showLadderToast(isEn ? `✨ ${targetCount} players applied to ladder!` : `✨ ${targetCount}명의 참가자로 사다리가 생성되었습니다!`);
  });

  // 3. Preset Export & Import (.json / .txt)
  const btnExportLadder = document.getElementById('btn-export-ladder');
  const fileImportLadder = document.getElementById('file-import-ladder') as HTMLInputElement;

  btnExportLadder?.addEventListener('click', () => {
    const exportData = {
      playerCount,
      participantNames: participantNames.slice(0, playerCount),
      outcomeNames: outcomeNames.slice(0, playerCount),
      speedMode,
      exportedAt: new Date().toISOString()
    };
    const blob = new Blob([JSON.stringify(exportData, null, 2)], { type: 'application/json' });
    const url = URL.createObjectURL(blob);
    const a = document.createElement('a');
    a.href = url;
    a.download = `errorledger-ladder-${Date.now()}.json`;
    a.click();
    URL.revokeObjectURL(url);
    showLadderToast(isEn ? '💾 Saved ladder setup to JSON file!' : '💾 사다리 설정이 .json 파일로 저장되었습니다!');
  });

  fileImportLadder?.addEventListener('change', (e) => {
    const file = (e.target as HTMLInputElement).files?.[0];
    if (!file) return;
    const reader = new FileReader();
    reader.onload = (ev) => {
      try {
        const content = ev.target?.result as string;
        if (file.name.endsWith('.json')) {
          const parsed = JSON.parse(content);
          if (parsed.playerCount) {
            playerCount = Math.min(20, Math.max(2, parseInt(parsed.playerCount, 10)));
          }
          if (Array.isArray(parsed.participantNames)) {
            participantNames = parsed.participantNames;
          }
          if (Array.isArray(parsed.outcomeNames)) {
            outcomeNames = parsed.outcomeNames;
          }
        } else {
          // Plain text (.txt)
          const lines = content.split(/[\r\n,]+/).map(s => s.trim()).filter(s => s.length > 0);
          if (lines.length > 0) {
            playerCount = Math.min(20, Math.max(2, lines.length));
            participantNames = lines.slice(0, playerCount);
          }
        }
        initLadder();
        showLadderToast(isEn ? '📂 Ladder file loaded successfully!' : '📂 사다리 파일을 성공적으로 불러왔습니다!');
      } catch (err) {
        showLadderToast(isEn ? 'Invalid file format.' : '파일 형식이 올바르지 않습니다.');
      }
      fileImportLadder.value = '';
    };
    reader.readAsText(file);
  });

  // 4. Provably Fair SHA-256 Verification & Proof Copy
  const ladderFairnessBar = document.getElementById('ladder-fairness-bar');
  const ladderFairnessHash = document.getElementById('ladder-fairness-hash');
  const btnCopyLadderHash = document.getElementById('btn-copy-ladder-hash');
  const ladderFairnessVerifyBox = document.getElementById('ladder-fairness-verify-box');
  const ladderVerifyRaw = document.getElementById('ladder-verify-raw');
  const ladderVerifyHash = document.getElementById('ladder-verify-hash');
  const ladderVerifyBadge = document.getElementById('ladder-verify-badge');
  const ladderVerifyStatusMsg = document.getElementById('ladder-verify-status-msg');
  const btnVerifyLadderCheck = document.getElementById('btn-verify-ladder-check');
  const btnVerifyLadderCopy = document.getElementById('btn-verify-ladder-copy');

  btnCopyLadderHash?.addEventListener('click', () => {
    const hash = ladderFairnessHash?.textContent || '';
    if (!hash || hash.includes('대기') || hash.includes('Waiting')) {
      showLadderToast(isEn ? 'Ladder hash will be generated upon creation.' : '사다리가 생성되면 사전 해시가 계산됩니다.');
      return;
    }
    navigator.clipboard.writeText(hash).then(() => {
      showLadderToast(isEn ? '📋 SHA-256 Pre-Hash copied!' : '📋 사다리 사전 SHA-256 해시가 복사되었습니다!');
    });
  });

  btnVerifyLadderCheck?.addEventListener('click', async () => {
    if (!currentLadderFairness) return;
    const computed = await sha256Hex(currentLadderFairness.rawSecret);
    const matches = computed === currentLadderFairness.hashHex;

    if (ladderVerifyBadge) {
      if (matches) {
        ladderVerifyBadge.className = 'verify-status-badge verified';
        ladderVerifyBadge.textContent = isEn ? '✅ 100% Match Verified' : '✅ 100% 무결함 검증 완료';
      } else {
        ladderVerifyBadge.className = 'verify-status-badge';
        ladderVerifyBadge.textContent = isEn ? '❌ Verification Failed' : '❌ 해시 불일치';
      }
    }

    if (ladderVerifyStatusMsg) {
      if (matches) {
        ladderVerifyStatusMsg.style.color = '#4ade80';
        ladderVerifyStatusMsg.textContent = isEn
          ? 'Passed: The pre-hash perfectly matches the generated rungs and secret parameters.'
          : '검증 성공: 사다리 생성 시 공개된 해시와 가로줄 구조가 완벽히 일치하여 임의 조작이 불가능함을 증명합니다.';
      } else {
        ladderVerifyStatusMsg.style.color = '#ef4444';
        ladderVerifyStatusMsg.textContent = isEn
          ? 'Failed: Hash mismatch detected.'
          : '검증 실패: 해시가 일치하지 않습니다.';
      }
    }
  });

  btnVerifyLadderCopy?.addEventListener('click', () => {
    if (!currentLadderFairness) return;
    const resultsStr = currentLadderFairness.results.join('\n');
    const proofText = isEn
      ? `[ErrorLedger Ladder Game Provably Fair Proof]\nPlayers: ${currentLadderFairness.playerCount}\nResults:\n${resultsStr}\nRaw Secret: ${currentLadderFairness.rawSecret}\nSHA-256 Pre-Hash: ${currentLadderFairness.hashHex}\nVerify online: Compute SHA-256("${currentLadderFairness.rawSecret}") on any 3rd party tool.`
      : `[에러레저 사다리타기 공정성 증명서]\n참여 인원: ${currentLadderFairness.playerCount}명\n결과 매핑:\n${resultsStr}\n사다리 생성 원문: ${currentLadderFairness.rawSecret}\nSHA-256 사전 해시: ${currentLadderFairness.hashHex}\n* 외부 SHA-256 계산기에 위 원문을 입력하면 사전 해시와 100% 일치함을 증명할 수 있습니다.`;
    navigator.clipboard.writeText(proofText).then(() => {
      showLadderToast(isEn ? '📋 Proof details copied to clipboard!' : '📋 공정성 증명 데이터가 클립보드에 복사되었습니다!');
    });
  });

  // 5. Dual-Window Real-time Sync (BroadcastChannel)
  const syncChannel = typeof BroadcastChannel !== 'undefined'
    ? new BroadcastChannel('errorledger_ladder_sync')
    : null;

  const urlParams = new URLSearchParams(window.location.search);
  const isControllerMode = urlParams.get('mode') === 'controller';

  if (isControllerMode) {
    document.body.classList.add('controller-mode');
    const banner = document.getElementById('ladder-ctrl-banner');
    if (banner) banner.classList.remove('hidden');
  }

  // Open Controller Window
  const openControllerLadderBtn = document.getElementById('open-controller-ladder-btn');
  openControllerLadderBtn?.addEventListener('click', () => {
    const controllerUrl = new URL(window.location.href);
    controllerUrl.searchParams.set('mode', 'controller');
    controllerUrl.searchParams.delete('stream');
    window.open(controllerUrl.toString(), 'errorledger_ladder_ctrl', 'width=520,height=840,menubar=no,toolbar=no');
    showLadderToast(isEn ? '🎛️ Dual-window controller opened!' : '🎛️ 듀얼 모니터용 리모컨 창이 열렸습니다!');
  });

  // Controller broadcast hooks
  startAllBtn?.addEventListener('click', () => {
    if (isControllerMode) syncChannel?.postMessage({ type: 'TRIGGER_START_ALL' });
  });

  revealAllBtn?.addEventListener('click', () => {
    if (isControllerMode) syncChannel?.postMessage({ type: 'TRIGGER_REVEAL_ALL' });
  });

  rerollBtn?.addEventListener('click', () => {
    if (isControllerMode) syncChannel?.postMessage({ type: 'TRIGGER_REROLL' });
  });

  toggleBlindBtn?.addEventListener('click', () => {
    if (isControllerMode) syncChannel?.postMessage({ type: 'TRIGGER_TOGGLE_BLIND' });
  });

  // Listen for broadcast messages from other windows
  if (syncChannel) {
    syncChannel.onmessage = (event) => {
      const data = event.data;
      if (!data) return;

      if (data.type === 'TRIGGER_START_ALL') {
        startAll();
      } else if (data.type === 'TRIGGER_REVEAL_ALL') {
        revealAll();
      } else if (data.type === 'TRIGGER_REROLL') {
        initLadder();
      } else if (data.type === 'TRIGGER_TOGGLE_BLIND') {
        toggleBlind();
      } else if (data.type === 'PRE_HASH_GENERATED') {
        const hashElem = document.getElementById('ladder-fairness-hash');
        if (hashElem && data.hashHex) {
          hashElem.textContent = data.hashHex;
          hashElem.title = data.hashHex;
        }
      } else if (data.type === 'LADDER_RESULTS') {
        if (isControllerMode && Array.isArray(data.results)) {
          showLadderToast(isEn ? `🎯 ${data.results.length} results revealed on main screen!` : `🎯 메인 화면에 ${data.results.length}개의 결과가 공개되었습니다!`);
        }
      }
    };
  }

  // English UI Localization
  if (isEn) {
    const panelTitle = document.getElementById('panel-title');
    if (panelTitle) panelTitle.textContent = 'Ladder Studio';

    const countLabel = document.getElementById('lbl-players') || document.querySelector('.player-count-select label');
    if (countLabel) countLabel.textContent = '👥 Players';

    const speedLabel = document.getElementById('lbl-speed') || document.querySelector('.speed-select label');
    if (speedLabel) speedLabel.textContent = '⏱️ Speed';

    const sSlow = document.querySelector('[data-speed="slow"]');
    if (sSlow) {
      sSlow.textContent = '🐢 Slow';
      sSlow.setAttribute('title', 'Maximum suspense (~6.2s)');
    }
    const sNormal = document.querySelector('[data-speed="normal"]');
    if (sNormal) {
      sNormal.textContent = '🚶 Normal';
      sNormal.setAttribute('title', 'Standard suspense (~4s)');
    }
    const sFast = document.querySelector('[data-speed="fast"]');
    if (sFast) {
      sFast.textContent = '⚡ Fast';
      sFast.setAttribute('title', 'Quick pace (~2s)');
    }

    const presetLabel = document.getElementById('lbl-presets') || document.querySelector('.toolbar-presets .preset-label');
    if (presetLabel) presetLabel.textContent = '🎨 Presets';

    const pCoffee = document.querySelector('[data-preset="coffee"]');
    if (pCoffee) pCoffee.textContent = '☕ Coffee Bet';
    const pChicken = document.querySelector('[data-preset="chicken"]');
    if (pChicken) pChicken.textContent = '🍗 Dinner Bet';
    const pPenalty = document.querySelector('[data-preset="penalty"]');
    if (pPenalty) pPenalty.textContent = '⚡ Penalties';
    const pDuty = document.querySelector('[data-preset="duty"]');
    if (pDuty) pDuty.textContent = '🧹 Chores';

    const countDecBtn = document.getElementById('count-dec-btn');
    if (countDecBtn) countDecBtn.setAttribute('title', 'Decrease player count');
    const countIncBtn = document.getElementById('count-inc-btn');
    if (countIncBtn) countIncBtn.setAttribute('title', 'Increase player count');

    const blindText = document.getElementById('blind-btn-text');
    if (blindText) blindText.textContent = '🔒 Blind ON';

    const startAllBtn = document.getElementById('start-all-btn');
    if (startAllBtn) {
      startAllBtn.setAttribute('title', 'Simultaneously start all player paths');
      const startAllSpan = startAllBtn.querySelector('span');
      if (startAllSpan) startAllSpan.textContent = '🚀 Start All';
    }

    const revealAllBtn = document.getElementById('reveal-all-btn');
    if (revealAllBtn) {
      revealAllBtn.setAttribute('title', 'Instantly calculate and show all results');
      const revealAllSpan = revealAllBtn.querySelector('span');
      if (revealAllSpan) revealAllSpan.textContent = '⚡ Instant';
    }

    const rerollBtn = document.getElementById('reroll-ladder-btn');
    if (rerollBtn) {
      rerollBtn.setAttribute('title', 'Generate new random ladder rungs');
      const rerollSpan = rerollBtn.querySelector('span');
      if (rerollSpan) rerollSpan.textContent = '🎲 Shuffle Ladder';
    }

    const tipsHeading = document.getElementById('tips-heading');
    if (tipsHeading) tipsHeading.textContent = 'Stream Tips & Guide';

    const tipsList = document.getElementById('tips-list');
    if (tipsList) {
      tipsList.innerHTML = `
        <li><strong>Click Avatar</strong>: Start individual player path</li>
        <li><strong>Edit Names</strong>: Click name or outcome to edit</li>
        <li><strong>Fullscreen</strong>: Press ⛶ for distraction-free view</li>
      `;
    }

    const blindTitle = document.querySelector('.ladder-blind-overlay .blind-title');
    if (blindTitle) blindTitle.textContent = 'Ladder Blind ON';

    const blindSub = document.querySelector('.ladder-blind-overlay .blind-sub');
    if (blindSub) blindSub.textContent = 'Rungs are hidden to keep results suspenseful (auto-revealed on start)';

    const blindUnveilBtn = document.getElementById('blind-unveil-center-btn');
    if (blindUnveilBtn) blindUnveilBtn.textContent = '👁️ Unveil Blind';

    const modalH2 = document.querySelector('.result-modal-card h2');
    if (modalH2) modalH2.textContent = 'Ladder Results';

    const closeResultBtn = document.getElementById('close-result-btn');
    if (closeResultBtn) closeResultBtn.textContent = 'Close';

    const obsBtn = document.getElementById('copy-obs-ladder-btn');
    if (obsBtn) {
      const span = obsBtn.querySelector('span');
      if (span) span.textContent = '🎥 Copy OBS';
      obsBtn.setAttribute('title', 'Copy clean OBS browser source URL without ads or headers');
    }

    const lblManage = document.getElementById('lbl-ladder-manage');
    if (lblManage) lblManage.textContent = '📋 Player & Preset Management';

    const btnSmart = document.getElementById('btn-smart-input-ladder');
    if (btnSmart) {
      const span = btnSmart.querySelector('span');
      if (span) span.textContent = '📋 Smart Nickname Paste';
    }

    const btnExp = document.getElementById('btn-export-ladder');
    if (btnExp) {
      const span = btnExp.querySelector('span');
      if (span) span.textContent = '💾 Save';
    }

    const uploadLabel = document.querySelector('.port-upload-label');
    if (uploadLabel) {
      const span = uploadLabel.querySelector('span');
      if (span) span.textContent = '📂 Load';
    }

    const smTitle = document.getElementById('smart-ladder-modal-title');
    if (smTitle) smTitle.textContent = 'Smart Bulk Nicknames Input';
    const smDesc = document.getElementById('smart-ladder-modal-desc');
    if (smDesc) smDesc.textContent = 'Paste participant names from Twitch/YouTube chat, Discord or notepad. Auto-adjusts player count up to 20.';
    const smDedup = document.getElementById('lbl-smart-ladder-dedup');
    if (smDedup) smDedup.textContent = 'Auto-remove duplicates';
    const smShuffle = document.getElementById('lbl-smart-ladder-shuffle');
    if (smShuffle) smShuffle.textContent = 'Random shuffle before applying';
    const smApply = document.getElementById('btn-smart-ladder-apply');
    if (smApply) {
      const span = smApply.querySelector('span');
      if (span) span.textContent = '✨ Apply Players & Generate Ladder';
    }

    const openCtrlBtn = document.getElementById('open-controller-ladder-btn');
    if (openCtrlBtn) {
      const span = openCtrlBtn.querySelector('span');
      if (span) span.textContent = '🎛️ Controller Remote';
      openCtrlBtn.setAttribute('title', 'Open dual-window streamer remote control');
    }
    const ctrlBannerTitle = document.getElementById('ctrl-ladder-banner-title');
    if (ctrlBannerTitle) ctrlBannerTitle.textContent = '🎛️ OBS Remote Controller Active';
    const ctrlBannerDesc = document.getElementById('ctrl-ladder-banner-desc');
    if (ctrlBannerDesc) ctrlBannerDesc.textContent = 'Real-time 0ms P2P sync with OBS browser source';

    const fairnessTitle = document.getElementById('ladder-fairness-title');
    if (fairnessTitle) fairnessTitle.textContent = 'Fairness (SHA-256):';
    const fairnessHashDisp = document.getElementById('ladder-fairness-hash');
    if (fairnessHashDisp && (!currentLadderFairness || !currentLadderFairness.hashHex)) {
      fairnessHashDisp.textContent = 'Waiting for generation...';
    }
    const btnCopyHash = document.getElementById('btn-copy-ladder-hash');
    if (btnCopyHash) btnCopyHash.textContent = '📋 Copy';

    const verifyTitle = document.getElementById('ladder-verify-title');
    if (verifyTitle) verifyTitle.textContent = '🛡️ Provably Fair SHA-256 Verification';
    const verifyKRaw = document.getElementById('ladder-verify-k-raw');
    if (verifyKRaw) verifyKRaw.textContent = 'Generation Secret:';
    const verifyKHash = document.getElementById('ladder-verify-k-hash');
    if (verifyKHash) verifyKHash.textContent = 'Pre-Hash:';
    const btnVerifyCheck = document.getElementById('btn-verify-ladder-check');
    if (btnVerifyCheck) btnVerifyCheck.textContent = '🔍 Verify Hash Match';
    const btnVerifyCopy = document.getElementById('btn-verify-ladder-copy');
    if (btnVerifyCopy) btnVerifyCopy.textContent = '📋 Copy Proof';
  }

  // Enchanted Night Fireflies Background Animation
  function initFireflies() {
    const bgCanvas = document.getElementById('firefly-canvas') as HTMLCanvasElement;
    if (!bgCanvas) return;
    const bgCtx = bgCanvas.getContext('2d');
    if (!bgCtx) return;

    function resize() {
      if (!bgCanvas) return;
      bgCanvas.width = window.innerWidth;
      bgCanvas.height = window.innerHeight;
    }
    window.addEventListener('resize', resize);
    resize();

    interface Firefly {
      x: number;
      y: number;
      radius: number;
      baseAlpha: number;
      pulsePhase: number;
      pulseSpeed: number;
      speedY: number;
      speedX: number;
      wobbleSpeed: number;
      color: string;
      glowColor: string;
    }

    const fireflyColors = [
      { core: '#34d399', glow: 'rgba(52, 211, 153, 0.4)' },
      { core: '#38bdf8', glow: 'rgba(56, 189, 248, 0.4)' },
      { core: '#a3e635', glow: 'rgba(163, 230, 53, 0.4)' },
      { core: '#facc15', glow: 'rgba(250, 204, 21, 0.4)' },
    ];

    const fireflies: Firefly[] = [];
    const count = 32;

    for (let i = 0; i < count; i++) {
      const c = fireflyColors[Math.floor(Math.random() * fireflyColors.length)];
      fireflies.push({
        x: Math.random() * bgCanvas.width,
        y: Math.random() * bgCanvas.height,
        radius: Math.random() * 2.8 + 1.5,
        baseAlpha: Math.random() * 0.4 + 0.35,
        pulsePhase: Math.random() * Math.PI * 2,
        pulseSpeed: Math.random() * 0.025 + 0.015,
        speedY: -(Math.random() * 0.5 + 0.15),
        speedX: Math.random() * 0.4 - 0.2,
        wobbleSpeed: Math.random() * 0.02 + 0.01,
        color: c.core,
        glowColor: c.glow,
      });
    }

    function renderFireflies() {
      if (!bgCtx || !bgCanvas) return;
      bgCtx.clearRect(0, 0, bgCanvas.width, bgCanvas.height);

      fireflies.forEach(f => {
        f.y += f.speedY;
        f.x += f.speedX + Math.sin(f.pulsePhase * 0.7) * 0.4;
        f.pulsePhase += f.pulseSpeed;

        if (f.y < -30) {
          f.y = bgCanvas.height + 20;
          f.x = Math.random() * bgCanvas.width;
        }
        if (f.x < -30) f.x = bgCanvas.width + 30;
        if (f.x > bgCanvas.width + 30) f.x = -30;

        const currentAlpha = Math.max(0.1, Math.min(0.9, f.baseAlpha + Math.sin(f.pulsePhase) * 0.35));

        bgCtx.save();
        bgCtx.translate(f.x, f.y);

        const g = bgCtx.createRadialGradient(0, 0, 0, 0, 0, f.radius * 3.5);
        g.addColorStop(0, f.color);
        g.addColorStop(0.35, f.glowColor);
        g.addColorStop(1, 'rgba(0, 0, 0, 0)');

        bgCtx.globalAlpha = currentAlpha;
        bgCtx.fillStyle = g;
        bgCtx.beginPath();
        bgCtx.arc(0, 0, f.radius * 3.5, 0, Math.PI * 2);
        bgCtx.fill();

        bgCtx.fillStyle = '#ffffff';
        bgCtx.globalAlpha = Math.min(1, currentAlpha * 1.3);
        bgCtx.beginPath();
        bgCtx.arc(0, 0, f.radius * 0.45, 0, Math.PI * 2);
        bgCtx.fill();

        bgCtx.restore();
      });

      requestAnimationFrame(renderFireflies);
    }
    requestAnimationFrame(renderFireflies);
  }

  // Launch
  initFireflies();
  initLadder();
</script>
