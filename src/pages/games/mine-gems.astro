</style>

<script is:inline>
(function () {
  const params = new URLSearchParams(window.location.search);
  const isEn = params.get('lang') === 'en' || window.location.pathname.startsWith('/en');

  function applyLang() {
    if (!isEn) return;
    document.querySelectorAll('[data-en]').forEach((el) => {
      el.textContent = el.getAttribute('data-en');
    });
  }
  applyLang();

  const ROWS = ['A', 'B', 'C', 'D', 'E'];
  const COLS = ['1', '2', '3', '4', '5'];
  const TOTAL_TILES = 25;
  const STORAGE_KEY = 'el_mine_gems_v1';

  // Persistent state
  let stats = {
    balance: 5000,
    bestMult: 1.0,
    bestWin: 0,
    curStreak: 0,
    bestStreak: 0,
    history: []
  };

  function loadStats() {
    try {
      const raw = localStorage.getItem(STORAGE_KEY);
      if (raw) {
        const parsed = JSON.parse(raw);
        stats = { ...stats, ...parsed };
      }
    } catch (_) {}
  }

  function saveStats() {
    try {
      localStorage.setItem(STORAGE_KEY, JSON.stringify(stats));
    } catch (_) {}
  }

  loadStats();

  // Game Round State
  let roundActive = false;
  let mineCount = 3;
  let stake = 500;
  let mineSet = new Set(); // indices 0..24
  let revealedSet = new Set(); // indices 0..24 picked by user
  let boomIndex = -1;
  let rawSeedString = '';
  let preHashHex = '';
  let lastShareText = '';

  // Audio Context
  let audioCtx = null;
  function getAudio() {
    if (!audioCtx) {
      const AC = window.AudioContext || window.webkitAudioContext;
      if (AC) audioCtx = new AC();
    }
    if (audioCtx && audioCtx.state === 'suspended') {
      audioCtx.resume();
    }
    return audioCtx;
  }

  function isMuted() {
    return localStorage.getItem('el_sound_muted') === '1';
  }

  function playGemSound(stepIndex) {
    if (isMuted()) return;
    const ctx = getAudio();
    if (!ctx) return;
    const now = ctx.currentTime;

    // Ascending crystalline chime
    const baseFreq = 420 * Math.pow(1.065, Math.min(stepIndex, 20));
    const osc = ctx.createOscillator();
    const gain = ctx.createGain();
    osc.type = 'triangle';
    osc.frequency.setValueAtTime(baseFreq, now);
    osc.frequency.exponentialRampToValueAtTime(baseFreq * 1.5, now + 0.14);

    gain.gain.setValueAtTime(0.18, now);
    gain.gain.exponentialRampToValueAtTime(0.001, now + 0.22);

    osc.connect(gain);
    gain.connect(ctx.destination);
    osc.start(now);
    osc.stop(now + 0.23);

    // Subtle heartbeat thump on higher steps
    if (stepIndex >= 3) {
      const beat = ctx.createOscillator();
      const bGain = ctx.createGain();
      beat.type = 'sine';
      beat.frequency.setValueAtTime(75, now);
      beat.frequency.exponentialRampToValueAtTime(38, now + 0.12);
      bGain.gain.setValueAtTime(0.15, now);
      bGain.gain.exponentialRampToValueAtTime(0.001, now + 0.13);
      beat.connect(bGain);
      bGain.connect(ctx.destination);
      beat.start(now);
      beat.stop(now + 0.14);
    }
  }

  function playCashoutSound() {
    if (isMuted()) return;
    const ctx = getAudio();
    if (!ctx) return;
    const now = ctx.currentTime;
    const notes = [523.25, 659.25, 783.99, 1046.5];
    notes.forEach((freq, idx) => {
      const osc = ctx.createOscillator();
      const gain = ctx.createGain();
      osc.type = 'triangle';
      osc.frequency.setValueAtTime(freq, now + idx * 0.065);
      gain.gain.setValueAtTime(0.18, now + idx * 0.065);
      gain.gain.exponentialRampToValueAtTime(0.001, now + idx * 0.065 + 0.25);
      osc.connect(gain);
      gain.connect(ctx.destination);
      osc.start(now + idx * 0.065);
      osc.stop(now + idx * 0.065 + 0.26);
    });
  }

  function playBoomSound() {
    if (isMuted()) return;
    const ctx = getAudio();
    if (!ctx) return;
    const now = ctx.currentTime;

    // Low explosion rumble
    const osc = ctx.createOscillator();
    const gain = ctx.createGain();
    osc.type = 'sawtooth';
    osc.frequency.setValueAtTime(130, now);
    osc.frequency.exponentialRampToValueAtTime(28, now + 0.42);
    gain.gain.setValueAtTime(0.28, now);
    gain.gain.exponentialRampToValueAtTime(0.001, now + 0.45);
    osc.connect(gain);
    gain.connect(ctx.destination);
    osc.start(now);
    osc.stop(now + 0.46);
  }

  // Combinatorics Multiplier Calculation
  // True odds with 99% RTP so 1st gem is always a meaningful boost
  function calcMultiplier(gemsOpened, mines) {
    if (gemsOpened <= 0) return 1.0;
    let prob = 1.0;
    for (let i = 0; i < gemsOpened; i++) {
      prob *= (TOTAL_TILES - mines - i) / (TOTAL_TILES - i);
    }
    const raw = (1.0 / prob) * 0.99;
    return Math.max(1.01, Math.round(raw * 100) / 100);
  }

  function idxToCoord(idx) {
    const r = Math.floor(idx / 5);
    const c = idx % 5;
    return ROWS[r] + COLS[c];
  }

  async function sha256Hex(str) {
    if (window.crypto && window.crypto.subtle) {
      const buf = new TextEncoder().encode(str);
      const hashBuf = await window.crypto.subtle.digest('SHA-256', buf);
      return Array.from(new Uint8Array(hashBuf))
        .map((b) => b.toString(16).padStart(2, '0'))
        .join('');
    }
    // Fallback deterministic hash if subtle crypto unavailable
    let h = 2166136261;
    for (let i = 0; i < str.length; i++) {
      h ^= str.charCodeAt(i);
      h = Math.imul(h, 16777619);
    }
    return (h >>> 0).toString(16).padStart(8, '0').repeat(8);
  }

  // DOM Elements
  const elBalance = document.getElementById('mg-balance');
  const elBestMult = document.getElementById('mg-best-mult');
  const elBestWin = document.getElementById('mg-best-win');
  const elStreak = document.getElementById('mg-streak');
  const elResetBtn = document.getElementById('mg-reset-btn');
  const elStatePill = document.getElementById('mg-state-pill');
  const elMineBtns = document.querySelectorAll('.mg-mine-btn');
  const elBetInput = document.getElementById('mg-bet-input');
  const elQuickBtns = document.querySelectorAll('.mg-q-btn');
  const elCurMult = document.getElementById('mg-cur-mult');
  const elNextMult = document.getElementById('mg-next-mult');
  const elSurvivalRate = document.getElementById('mg-survival-rate');
  const elRiskBar = document.getElementById('mg-risk-bar');
  const elGemsFound = document.getElementById('mg-gems-found');
  const elBtnStart = document.getElementById('mg-btn-start');
  const elBtnCashout = document.getElementById('mg-btn-cashout');
  const elCashoutVal = document.getElementById('mg-cashout-val');
  const elBtnRandom = document.getElementById('mg-btn-random');
  const elBtnAid = document.getElementById('mg-btn-aid');
  const elBoardCard = document.getElementById('mg-board-card');
  const elStatusBanner = document.getElementById('mg-status-banner');
  const elStatusIcon = document.getElementById('mg-status-icon');
  const elStatusText = document.getElementById('mg-status-text');
  const elCopyBtn = document.getElementById('mg-copy-btn');
  const elGrid = document.getElementById('mg-grid');
  const elHistList = document.getElementById('mg-hist-list');
  const elFairBadge = document.getElementById('mg-fair-badge');
  const elHashCode = document.getElementById('mg-hash-code');
  const elSeedRow = document.getElementById('mg-seed-row');
  const elSeedCode = document.getElementById('mg-seed-code');

  // Build 5x5 Grid DOM
  const tileButtons = [];
  function initGridDOM() {
    elGrid.innerHTML = '';
    tileButtons.length = 0;
    for (let r = 0; r < 5; r++) {
      const rowHdr = document.createElement('div');
      rowHdr.className = 'mg-row-hdr';
      rowHdr.textContent = ROWS[r];
      elGrid.appendChild(rowHdr);

      for (let c = 0; c < 5; c++) {
        const idx = r * 5 + c;
        const coord = ROWS[r] + COLS[c];
        const btn = document.createElement('button');
        btn.type = 'button';
        btn.className = 'mg-tile';
        btn.dataset.idx = String(idx);
        btn.innerHTML = `
          <span class="mg-tile-coord">${coord}</span>
          <span class="mg-tile-icon">❔</span>
          <span class="mg-tile-sub"></span>
        `;
        btn.addEventListener('click', () => onTileClick(idx));
        elGrid.appendChild(btn);
        tileButtons.push(btn);
      }
    }
  }

  function updateHUD() {
    elBalance.textContent = `${stats.balance.toLocaleString()} P`;
    elBestMult.textContent = `x${stats.bestMult.toFixed(2)}`;
    elBestWin.textContent = `${stats.bestWin.toLocaleString()} P`;
    elStreak.textContent = isEn
      ? `${stats.curStreak} (Best ${stats.bestStreak})`
      : `${stats.curStreak}연승 (최고 ${stats.bestStreak})`;

    // Bankruptcy aid button state
    elBtnAid.disabled = roundActive || stats.balance >= 100;

    // History pills
    if (!stats.history || stats.history.length === 0) {
      elHistList.innerHTML = `<span class="mg-hist-empty">${isEn ? 'No rounds played yet.' : '아직 탐사 기록이 없습니다.'}</span>`;
    } else {
      elHistList.innerHTML = stats.history
        .slice(0, 8)
        .map((h) => {
          if (h.win) {
            return `<span class="mg-hist-pill win">💰 x${h.mult.toFixed(2)} (+${h.payout.toLocaleString()}P)</span>`;
          }
          return `<span class="mg-hist-pill loss">💥 ${h.coord} (-${h.stake.toLocaleString()}P)</span>`;
        })
        .join('');
    }
  }

  function updateTelemetry() {
    const k = revealedSet.size;
    const maxGems = TOTAL_TILES - mineCount;
    const curM = calcMultiplier(k, mineCount);
    const nextM = k < maxGems ? calcMultiplier(k + 1, mineCount) : curM;

    elCurMult.textContent = `x${curM.toFixed(2)}`;
    elNextMult.textContent = k < maxGems ? `x${nextM.toFixed(2)}` : 'MAX';

    const remainingTotal = TOTAL_TILES - k;
    const remainingSafe = Math.max(0, maxGems - k);
    const survPct = remainingTotal > 0 ? (remainingSafe / remainingTotal) * 100 : 0;

    elSurvivalRate.textContent = `${survPct.toFixed(1)}% (${remainingSafe}/${remainingTotal})`;
    elRiskBar.style.width = `${Math.max(0, Math.min(100, survPct))}%`;

    if (survPct >= 70) {
      elRiskBar.style.background = 'linear-gradient(90deg, #10b981, #38bdf8)';
      elSurvivalRate.style.color = '#34d399';
    } else if (survPct >= 45) {
      elRiskBar.style.background = 'linear-gradient(90deg, #f59e0b, #fbbf24)';
      elSurvivalRate.style.color = '#fbbf24';
    } else {
      elRiskBar.style.background = 'linear-gradient(90deg, #ef4444, #f97316)';
      elSurvivalRate.style.color = '#f87171';
    }

    elGemsFound.textContent = `${k} / ${maxGems} 💎`;

    if (roundActive) {
      const payout = Math.round(stake * curM);
      elBtnCashout.disabled = k < 1;
      elCashoutVal.textContent =
        k < 1
          ? isEn
            ? 'Find at least 1 Gem (💎)'
            : '보석을 1개 이상 발굴하세요'
          : `+${payout.toLocaleString()} P (x${curM.toFixed(2)})`;
    }
  }

  function setControlsDisabled(disabled) {
    elMineBtns.forEach((b) => (b.disabled = disabled));
    elBetInput.disabled = disabled;
    elQuickBtns.forEach((b) => (b.disabled = disabled));
  }

  async function startRound() {
    if (roundActive) return;

    let rawBet = parseInt(elBetInput.value, 10);
    if (isNaN(rawBet) || rawBet < 100) rawBet = 100;
    if (rawBet > stats.balance) {
      if (stats.balance < 100) {
        alert(
          isEn
            ? 'Not enough points! Claim the +1,000 P Bankruptcy Relief on the left panel.'
            : '보유 포인트가 부족합니다! 좌측 하단의 [🚑 무료 파산 구제 지원금 +1,000 P]를 먼저 받아주세요.'
        );
        return;
      }
      rawBet = stats.balance;
    }
    elBetInput.value = String(rawBet);
    stake = rawBet;

    // Deduct stake upfront
    stats.balance -= stake;
    saveStats();

    roundActive = true;
    revealedSet.clear();
    mineSet.clear();
    boomIndex = -1;
    elCopyBtn.style.display = 'none';

    // Cryptographically fair mine placement
    const indices = Array.from({ length: TOTAL_TILES }, (_, i) => i);
    const randArr = new Uint32Array(TOTAL_TILES);
    if (window.crypto && window.crypto.getRandomValues) {
      window.crypto.getRandomValues(randArr);
    } else {
      for (let i = 0; i < TOTAL_TILES; i++) randArr[i] = Math.floor(Math.random() * 0xffffffff);
    }
    for (let i = TOTAL_TILES - 1; i > 0; i--) {
      const j = randArr[i] % (i + 1);
      const tmp = indices[i];
      indices[i] = indices[j];
      indices[j] = tmp;
    }
    for (let m = 0; m < mineCount; m++) {
      mineSet.add(indices[m]);
    }

    const sortedMineCoords = Array.from(mineSet)
      .sort((a, b) => a - b)
      .map(idxToCoord)
      .join(',');
    const nonce = Array.from(randArr.slice(0, 4))
      .map((n) => (n & 0xffff).toString(16).padStart(4, '0'))
      .join('');
    rawSeedString = `MINES(${mineCount}):[${sortedMineCoords}]|NONCE:${nonce}`;
    preHashHex = await sha256Hex(rawSeedString);

    // Update Provably Fair UI
    elFairBadge.className = 'mg-fair-badge locked';
    elFairBadge.textContent = isEn ? '🔒 HASH LOCKED' : '🔒 시드 해시 고정됨';
    elHashCode.textContent = preHashHex;
    elSeedRow.style.display = 'none';

    // Reset tiles UI
    tileButtons.forEach((btn) => {
      btn.className = 'mg-tile';
      btn.disabled = false;
      btn.querySelector('.mg-tile-icon').textContent = '❔';
      btn.querySelector('.mg-tile-sub').textContent = '';
    });

    // Toggle action buttons
    setControlsDisabled(true);
    elBtnStart.style.display = 'none';
    elBtnCashout.style.display = 'flex';
    elBtnRandom.style.display = 'block';

    elStatePill.className = 'mg-state-pill active';
    elStatePill.textContent = isEn ? 'MINING LIVE' : '탐사 진행 중';

    elStatusBanner.className = 'mg-status-banner';
    elStatusIcon.textContent = '⛏️';
    elStatusText.textContent = isEn
      ? `Exploring with ${stake.toLocaleString()} P (${mineCount} mines hidden). Pick a coordinate (A1–E5)!`
      : `투자금 ${stake.toLocaleString()} P • 지뢰 ${mineCount}개 매설 완료! 원하는 타일(A1~E5)을 클릭해 보석을 캐세요.`;

    updateHUD();
    updateTelemetry();
  }

  function revealFullBoard() {
    tileButtons.forEach((btn, idx) => {
      btn.disabled = true;
      if (revealedSet.has(idx)) return;
      if (idx === boomIndex) return;

      const iconEl = btn.querySelector('.mg-tile-icon');
      const subEl = btn.querySelector('.mg-tile-sub');
      if (mineSet.has(idx)) {
        btn.className = 'mg-tile missed-mine';
        iconEl.textContent = '💣';
        subEl.textContent = isEn ? 'MINE' : '지뢰';
      } else {
        btn.className = 'mg-tile missed-gem';
        iconEl.textContent = '💎';
        subEl.textContent = '';
      }
    });
  }

  function buildEmojiShareGrid(won, finalMult, payout) {
    let gridLines = [];
    for (let r = 0; r < 5; r++) {
      let rowStr = '';
      for (let c = 0; c < 5; c++) {
        const idx = r * 5 + c;
        if (idx === boomIndex) rowStr += '💥';
        else if (revealedSet.has(idx)) rowStr += '💎';
        else if (mineSet.has(idx)) rowStr += '💣';
        else rowStr += '⬛';
      }
      gridLines.push(rowStr);
    }
    const header = won
      ? isEn
        ? `💰 [Mine Gems] CASHED OUT at x${finalMult.toFixed(2)}! (+${payout.toLocaleString()} P | ${mineCount} Mines)`
        : `💰 [지뢰 보석 캐기] x${finalMult.toFixed(2)}배 칼익절 성공! (+${payout.toLocaleString()} P | 폭탄 ${mineCount}개)`
      : isEn
      ? `💥 [Mine Gems] BOOM at ${idxToCoord(boomIndex)}! Lost ${stake.toLocaleString()} P (${revealedSet.size} Gems | ${mineCount} Mines)`
      : `💥 [지뢰 보석 캐기] ${idxToCoord(boomIndex)} 지뢰 밟고 폭사! (-${stake.toLocaleString()} P | ${revealedSet.size}연속 보석 | 폭탄 ${mineCount}개)`;

    return `${header}\n${gridLines.join('\n')}\nhttps://errorledger.com/games/mine-gems`;
  }

  function finishRound(won) {
    roundActive = false;
    setControlsDisabled(false);
    elBtnStart.style.display = 'block';
    elBtnCashout.style.display = 'none';
    elBtnRandom.style.display = 'none';

    elStatePill.className = 'mg-state-pill';
    elStatePill.textContent = isEn ? 'FINISHED' : '탐사 종료';

    // Reveal Provably Fair Seed
    elFairBadge.className = 'mg-fair-badge verified';
    elFairBadge.textContent = isEn ? '✓ SHA-256 VERIFIED' : '✓ 무결성 검증 완료';
    elSeedRow.style.display = 'flex';
    elSeedCode.textContent = rawSeedString;

    revealFullBoard();

    const k = revealedSet.size;
    const finalMult = calcMultiplier(k, mineCount);
    const payout = won ? Math.round(stake * finalMult) : 0;

    if (won) {
      playCashoutSound();
      stats.balance += payout;
      stats.curStreak += 1;
      if (stats.curStreak > stats.bestStreak) stats.bestStreak = stats.curStreak;
      if (finalMult > stats.bestMult) stats.bestMult = finalMult;
      if (payout > stats.bestWin) stats.bestWin = payout;

      stats.history.unshift({
        win: true,
        mult: finalMult,
        payout,
        stake
      });

      elStatusBanner.className = 'mg-status-banner win';
      elStatusIcon.textContent = '🎉';
      elStatusText.textContent = isEn
        ? `CASHED OUT! ${k} Gems excavated for x${finalMult.toFixed(2)} → Received +${payout.toLocaleString()} P!`
        : `익절 대성공! 보석 ${k}개 연속 발굴 (x${finalMult.toFixed(2)}배) → 총 +${payout.toLocaleString()} P 획득!`;
    } else {
      playBoomSound();
      stats.curStreak = 0;
      const hitCoord = idxToCoord(boomIndex);

      stats.history.unshift({
        win: false,
        mult: finalMult,
        payout: 0,
        stake,
        coord: hitCoord
      });

      elBoardCard.classList.remove('shake');
      void elBoardCard.offsetWidth;
      elBoardCard.classList.add('shake');

      elStatusBanner.className = 'mg-status-banner boom';
      elStatusIcon.textContent = '💥';
      elStatusText.textContent = isEn
        ? `BOOM! Hit a mine at [${hitCoord}] after ${k} gems. Stake (${stake.toLocaleString()} P) lost!`
        : `콰광!! [${hitCoord}] 타일에서 지뢰가 폭발했습니다! (보석 ${k}개 발굴 후 폭사 • -${stake.toLocaleString()} P)`;
    }

    if (stats.history.length > 12) stats.history.length = 12;
    saveStats();

    lastShareText = buildEmojiShareGrid(won, finalMult, payout);
    elCopyBtn.style.display = 'inline-block';

    updateHUD();
    updateTelemetry();
  }

  function onTileClick(idx) {
    if (!roundActive) return;
    if (revealedSet.has(idx)) return;

    const btn = tileButtons[idx];
    const iconEl = btn.querySelector('.mg-tile-icon');
    const subEl = btn.querySelector('.mg-tile-sub');

    if (mineSet.has(idx)) {
      boomIndex = idx;
      btn.className = 'mg-tile boom';
      btn.disabled = true;
      iconEl.textContent = '💥';
      subEl.textContent = 'BOOM!';
      finishRound(false);
      return;
    }

    // Found a Gem!
    revealedSet.add(idx);
    const k = revealedSet.size;
    const stepMult = calcMultiplier(k, mineCount);

    playGemSound(k);

    btn.className = 'mg-tile gem';
    btn.disabled = true;
    iconEl.textContent = '💎';
    subEl.textContent = `x${stepMult.toFixed(2)}`;

    const maxGems = TOTAL_TILES - mineCount;
    if (k >= maxGems) {
      // Cleared all safe tiles! Auto jackpot cashout
      finishRound(true);
      return;
    }

    const nextMult = calcMultiplier(k + 1, mineCount);
    const curPayout = Math.round(stake * stepMult);
    elStatusBanner.className = 'mg-status-banner';
    elStatusIcon.textContent = '💎';
    elStatusText.textContent = isEn
      ? `[${idxToCoord(idx)}] Gem #${k} found! Cash out now for +${curPayout.toLocaleString()} P (x${stepMult.toFixed(2)}) or risk for x${nextMult.toFixed(2)}?`
      : `[${idxToCoord(idx)}] ${k}연속 보석 발굴 성공! 지금 익절하면 +${curPayout.toLocaleString()} P (x${stepMult.toFixed(2)}), 한 칸 더 열면 x${nextMult.toFixed(2)}배!`;

    updateTelemetry();
  }

  // Event Listeners
  elMineBtns.forEach((btn) => {
    btn.addEventListener('click', () => {
      if (roundActive) return;
      elMineBtns.forEach((b) => b.classList.remove('active'));
      btn.classList.add('active');
      mineCount = parseInt(btn.dataset.mines, 10) || 3;
      updateTelemetry();
    });
  });

  elQuickBtns.forEach((btn) => {
    btn.addEventListener('click', () => {
      if (roundActive) return;
      const mode = btn.dataset.bet;
      let cur = parseInt(elBetInput.value, 10) || 500;
      if (mode === 'half') cur = Math.max(100, Math.floor(cur / 2));
      else if (mode === 'double') cur = Math.min(Math.max(100, stats.balance), cur * 2);
      else if (mode === 'max') cur = Math.max(100, stats.balance);
      else cur = parseInt(mode, 10) || 500;
      elBetInput.value = String(cur);
    });
  });

  elBtnStart.addEventListener('click', () => startRound());

  elBtnCashout.addEventListener('click', () => {
    if (!roundActive || revealedSet.size < 1) return;
    finishRound(true);
  });

  elBtnRandom.addEventListener('click', () => {
    if (!roundActive) return;
    const unpicked = [];
    for (let i = 0; i < TOTAL_TILES; i++) {
      if (!revealedSet.has(i)) unpicked.push(i);
    }
    if (unpicked.length === 0) return;
    const pick = unpicked[Math.floor(Math.random() * unpicked.length)];
    onTileClick(pick);
  });

  elBtnAid.addEventListener('click', () => {
    if (roundActive || stats.balance >= 100) return;
    stats.balance += 1000;
    saveStats();
    updateHUD();
  });

  elResetBtn.addEventListener('click', () => {
    if (roundActive) return;
    const msg = isEn
      ? 'Reset points to 5,000 P and clear personal records?'
      : '보유 포인트를 5,000 P로 초기화하고 최고 기록을 리셋하시겠습니까?';
    if (!confirm(msg)) return;
    stats = {
      balance: 5000,
      bestMult: 1.0,
      bestWin: 0,
      curStreak: 0,
      bestStreak: 0,
      history: []
    };
    saveStats();
    updateHUD();
    updateTelemetry();
  });

  elCopyBtn.addEventListener('click', () => {
    if (!lastShareText) return;
    navigator.clipboard.writeText(lastShareText).then(() => {
      const orig = elCopyBtn.innerHTML;
      elCopyBtn.innerHTML = isEn ? '✅ Copied!' : '✅ 복사 완료!';
      setTimeout(() => {
        elCopyBtn.innerHTML = orig;
      }, 1600);
    });
  });

  window.addEventListener('keydown', (e) => {
    if (e.target && (e.target.tagName === 'INPUT' || e.target.tagName === 'TEXTAREA')) return;
    if (e.code === 'Space') {
      e.preventDefault();
      if (!roundActive) startRound();
      else if (revealedSet.size >= 1) finishRound(true);
    } else if (e.code === 'KeyR' && roundActive) {
      e.preventDefault();
      elBtnRandom.click();
    }
  });

  initGridDOM();
  updateHUD();
  updateTelemetry();
})();
</script>

