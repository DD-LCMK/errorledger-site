---
import GameLayout from '../../layouts/GameLayout.astro';
import { getEntry } from 'astro:content';

const entry = await getEntry('games', 'mine-gems');
if (!entry) throw new Error('mine-gems entry not found');
---

<GameLayout entry={entry}>
  <div class="mg-app" id="mg-app">
    <!-- Top Stats HUD -->
    <div class="mg-hud">
      <div class="mg-stat-card balance-card">
        <span class="mg-stat-label" data-ko="🪙 보유 포인트" data-en="🪙 BALANCE">🪙 보유 포인트</span>
        <strong class="mg-stat-val gold" id="mg-balance">5,000 P</strong>
      </div>
      <div class="mg-stat-card">
        <span class="mg-stat-label" data-ko="🏆 최고 익절 배율" data-en="🏆 BEST MULTIPLIER">🏆 최고 익절 배율</span>
        <strong class="mg-stat-val cyan" id="mg-best-mult">x1.00</strong>
      </div>
      <div class="mg-stat-card">
        <span class="mg-stat-label" data-ko="💰 최대 단일 수익" data-en="💰 MAX PAYOUT">💰 최대 단일 수익</span>
        <strong class="mg-stat-val emerald" id="mg-best-win">0 P</strong>
      </div>
      <div class="mg-stat-card">
        <span class="mg-stat-label" data-ko="🔥 연속 익절" data-en="🔥 WIN STREAK">🔥 연속 익절</span>
        <strong class="mg-stat-val amber" id="mg-streak">0연승 (최고 0)</strong>
      </div>
      <button type="button" class="mg-reset-btn" id="mg-reset-btn" title="기록 초기화">
        🔄 <span data-ko="초기화" data-en="Reset">초기화</span>
      </button>
    </div>

    <!-- Main 2-Column Layout -->
    <div class="mg-main-grid">
      <!-- Left Column: Controls & Telemetry -->
      <aside class="mg-sidebar">
        <div class="mg-panel">
          <div class="mg-panel-header">
            <span class="mg-panel-title" data-ko="⚙️ 광산 탐사 설정" data-en="⚙️ MINE SETUP">⚙️ 광산 탐사 설정</span>
            <span class="mg-state-pill" id="mg-state-pill" data-ko="대기 중" data-en="READY">대기 중</span>
          </div>

          <!-- Mine Count Selector -->
          <div class="mg-field">
            <label class="mg-label" data-ko="💣 숨겨진 지뢰(폭탄) 개수 (25칸 중)" data-en="💣 HIDDEN MINES (OUT OF 25 TILES)">💣 숨겨진 지뢰(폭탄) 개수 (25칸 중)</label>
            <div class="mg-mine-btns" id="mg-mine-btns">
              <button type="button" class="mg-mine-btn" data-mines="1">
                <span class="m-count">💣 1개</span>
                <span class="m-desc" data-ko="안전파 (입문)" data-en="Low Risk">안전파 (입문)</span>
              </button>
              <button type="button" class="mg-mine-btn active" data-mines="3">
                <span class="m-count">💣 3개</span>
                <span class="m-desc" data-ko="표준 밸런스" data-en="Balanced">표준 밸런스</span>
              </button>
              <button type="button" class="mg-mine-btn" data-mines="5">
                <span class="m-count">💣 5개</span>
                <span class="m-desc" data-ko="고위험 고수익" data-en="High Stakes">고위험 고수익</span>
              </button>
              <button type="button" class="mg-mine-btn beast" data-mines="10">
                <span class="m-count">🔥 10개</span>
                <span class="m-desc" data-ko="야수의 심장" data-en="Beast Mode">야수의 심장</span>
              </button>
            </div>
          </div>

          <!-- Bet / Stake Amount -->
          <div class="mg-field">
            <div class="mg-label-row">
              <label class="mg-label" for="mg-bet-input" data-ko="🪙 탐사 투자 포인트" data-en="🪙 STAKE POINTS">🪙 탐사 투자 포인트</label>
              <span class="mg-min-hint" data-ko="최소 100 P" data-en="Min 100 P">최소 100 P</span>
            </div>
            <div class="mg-bet-input-wrap">
              <input type="number" id="mg-bet-input" class="mg-bet-input" value="500" min="100" step="100" />
              <span class="mg-unit">P</span>
            </div>
            <div class="mg-bet-quick">
              <button type="button" class="mg-q-btn" data-bet="100">100</button>
              <button type="button" class="mg-q-btn" data-bet="500">500</button>
              <button type="button" class="mg-q-btn" data-bet="1000">1,000</button>
              <button type="button" class="mg-q-btn" data-bet="half">1/2</button>
              <button type="button" class="mg-q-btn" data-bet="double">2X</button>
              <button type="button" class="mg-q-btn allin" data-bet="max" data-ko="올인" data-en="MAX">올인</button>
            </div>
          </div>

          <!-- Live Multiplier & Survival Telemetry -->
          <div class="mg-telemetry-box">
            <div class="mg-tele-row main-mult-row">
              <div class="mg-tele-col">
                <span class="mg-tele-label" data-ko="현재 누적 배율" data-en="CURRENT MULTIPLIER">현재 누적 배율</span>
                <strong class="mg-tele-big" id="mg-cur-mult">x1.00</strong>
              </div>
              <div class="mg-tele-arrow">➜</div>
              <div class="mg-tele-col right">
                <span class="mg-tele-label" data-ko="다음 💎 발견 시" data-en="NEXT GEM MULTIPLIER">다음 💎 발견 시</span>
                <strong class="mg-tele-next" id="mg-next-mult">x1.13</strong>
              </div>
            </div>

            <div class="mg-tele-divider"></div>

            <div class="mg-tele-subrow">
              <span data-ko="🎯 다음 타일 생존 확률" data-en="🎯 Next Tile Survival Odds">🎯 다음 타일 생존 확률</span>
              <strong id="mg-survival-rate" class="mg-surv-val">88.0% (22/25)</strong>
            </div>
            <div class="mg-risk-bar-bg">
              <div class="mg-risk-bar-fill" id="mg-risk-bar" style="width: 88%;"></div>
            </div>

            <div class="mg-tele-subrow" style="margin-top: 0.45rem;">
              <span data-ko="💎 발굴한 다이아몬드" data-en="💎 Gems Excavated">💎 발굴한 다이아몬드</span>
              <strong id="mg-gems-found">0 / 22 💎</strong>
            </div>
          </div>

          <!-- Primary Action Buttons -->
          <div class="mg-actions">
            <button type="button" class="mg-btn-start" id="mg-btn-start">
              🚀 <span data-ko="보석 탐사 시작 (Space)" data-en="START MINING (Space)">보석 탐사 시작 (Space)</span>
            </button>

            <button type="button" class="mg-btn-cashout" id="mg-btn-cashout" style="display: none;" disabled>
              <span class="cashout-top">
                💰 <span data-ko="지금 익절하기 (Cash Out)" data-en="CASH OUT NOW">지금 익절하기 (Cash Out)</span>
              </span>
              <strong class="cashout-amount" id="mg-cashout-val">+500 P (x1.00)</strong>
            </button>

            <button type="button" class="mg-btn-random" id="mg-btn-random" style="display: none;">
              🎲 <span data-ko="시청자 운빨! 랜덤 1칸 열기 (R)" data-en="Lucky Random Tile Pick (R)">시청자 운빨! 랜덤 1칸 열기 (R)</span>
            </button>
          </div>

          <!-- Bankruptcy Aid -->
          <div class="mg-aid-box" id="mg-aid-box">
            <div class="mg-aid-info">
              <span class="mg-aid-title" data-ko="🚑 파산 구제 지원금" data-en="🚑 Bankruptcy Relief">🚑 파산 구제 지원금</span>
              <span class="mg-aid-desc" data-ko="잔액 100 P 미만일 때 무료 충전" data-en="Available when balance < 100 P">잔액 100 P 미만일 때 무료 충전</span>
            </div>
            <button type="button" class="mg-btn-aid" id="mg-btn-aid" disabled>
              +1,000 P <span data-ko="지원받기" data-en="Claim">지원받기</span>
            </button>
          </div>
        </div>
      </aside>

      <!-- Right Column: 5x5 Coordinate Grid & Provably Fair Box -->
      <section class="mg-arena-col">
        <div class="mg-board-card" id="mg-board-card">
          <!-- Live Status Banner -->
          <div class="mg-status-banner" id="mg-status-banner">
            <span class="mg-status-icon" id="mg-status-icon">💎</span>
            <p class="mg-status-text" id="mg-status-text" data-ko="폭탄 개수와 포인트를 설정한 뒤 [🚀 보석 탐사 시작]을 눌러주세요! 채팅창과 좌표(A1~E5)로 소통할 수 있습니다." data-en="Select mines and stake, then click [🚀 START MINING]! Viewers can call out coordinates (A1–E5).">
              폭탄 개수와 포인트를 설정한 뒤 [🚀 보석 탐사 시작]을 눌러주세요! 채팅창과 좌표(A1~E5)로 소통할 수 있습니다.
            </p>
            <button type="button" class="mg-copy-btn" id="mg-copy-btn" style="display: none;">
              📋 <span data-ko="결과 그리드 복사" data-en="Copy Grid">결과 그리드 복사</span>
            </button>
          </div>

          <!-- 5x5 Grid with A-E / 1-5 Coordinates -->
          <div class="mg-grid-wrapper">
            <!-- Top Column Headers (1 - 5) -->
            <div class="mg-col-headers">
              <div class="mg-corner-spacer"></div>
              <div class="mg-col-hdr">1</div>
              <div class="mg-col-hdr">2</div>
              <div class="mg-col-hdr">3</div>
              <div class="mg-col-hdr">4</div>
              <div class="mg-col-hdr">5</div>
            </div>

            <div class="mg-grid-body">
              <!-- Left Row Headers (A - E) + 25 Tiles -->
              <div class="mg-grid" id="mg-grid">
                <!-- Populated dynamically by JS with A1..E5 -->
              </div>
            </div>
          </div>

          <!-- Recent Rounds Strip -->
          <div class="mg-history-bar">
            <span class="mg-hist-label" data-ko="📜 최근 탐사" data-en="📜 RECENT">📜 최근 탐사</span>
            <div class="mg-hist-list" id="mg-hist-list">
              <span class="mg-hist-empty" data-ko="아직 탐사 기록이 없습니다." data-en="No rounds played yet.">아직 탐사 기록이 없습니다.</span>
            </div>
          </div>

          <!-- Provably Fair SHA-256 Verification Box -->
          <div class="mg-fair-box">
            <div class="mg-fair-header">
              <span class="mg-fair-title">🔒 <span data-ko="SHA-256 사전 시드 고정 (억까·조작 방지 검증)" data-en="Provably Fair SHA-256 Pre-Committed Seed">SHA-256 사전 시드 고정 (억까·조작 방지 검증)</span></span>
              <span class="mg-fair-badge" id="mg-fair-badge" data-ko="대기 중" data-en="STANDBY">대기 중</span>
            </div>
            <div class="mg-fair-row">
              <span class="mg-fair-key" data-ko="사전 공개 SHA-256 해시:" data-en="Pre-Round SHA-256 Hash:">사전 공개 SHA-256 해시:</span>
              <code class="mg-fair-code" id="mg-hash-code">라운드 시작 시 폭탄 좌표의 암호화 해시가 이곳에 사전 고정됩니다.</code>
            </div>
            <div class="mg-fair-row" id="mg-seed-row" style="display: none;">
              <span class="mg-fair-key" data-ko="라운드 종료 원본 시드:" data-en="Revealed Raw Seed:">라운드 종료 원본 시드:</span>
              <code class="mg-fair-code revealed" id="mg-seed-code">-</code>
            </div>
          </div>
        </div>
      </section>
    </div>
  </div>
</GameLayout>

<style is:global>
  .mg-app {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    color: #f8fafc;
    user-select: none;
  }

  /* Top HUD */
  .mg-hud {
    display: grid;
    grid-template-columns: repeat(4, 1fr) auto;
    gap: 0.75rem;
    align-items: stretch;
  }

  .mg-stat-card {
    background: rgba(15, 23, 42, 0.85);
    border: 1px solid rgba(148, 163, 184, 0.16);
    border-radius: 14px;
    padding: 0.75rem 1rem;
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .mg-stat-card.balance-card {
    border-color: rgba(250, 204, 21, 0.35);
    background: linear-gradient(135deg, rgba(30, 41, 59, 0.9), rgba(15, 23, 42, 0.95));
  }

  .mg-stat-label {
    font-size: 0.75rem;
    font-weight: 700;
    color: #94a3b8;
  }

  .mg-stat-val {
    font-size: 1.25rem;
    font-weight: 900;
    font-variant-numeric: tabular-nums;
  }

  .mg-stat-val.gold { color: #facc15; }
  .mg-stat-val.cyan { color: #38bdf8; }
  .mg-stat-val.emerald { color: #34d399; }
  .mg-stat-val.amber { color: #fb923c; font-size: 1.08rem; }

  .mg-reset-btn {
    background: rgba(30, 41, 59, 0.8);
    border: 1px solid rgba(148, 163, 184, 0.2);
    color: #cbd5e1;
    border-radius: 12px;
    padding: 0 1rem;
    font-size: 0.82rem;
    font-weight: 700;
    cursor: pointer;
    transition: all 0.15s ease;
  }

  .mg-reset-btn:hover {
    background: rgba(239, 68, 68, 0.15);
    border-color: rgba(239, 68, 68, 0.4);
    color: #fca5a5;
  }

  /* Main 2-Column Grid */
  .mg-main-grid {
    display: grid;
    grid-template-columns: 360px 1fr;
    gap: 1.15rem;
    align-items: start;
  }

  .mg-panel {
    background: rgba(15, 23, 42, 0.9);
    border: 1px solid rgba(148, 163, 184, 0.16);
    border-radius: 18px;
    padding: 1.2rem;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .mg-panel-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .mg-panel-title {
    font-size: 1rem;
    font-weight: 800;
    color: #f8fafc;
  }

  .mg-state-pill {
    font-size: 0.72rem;
    font-weight: 800;
    padding: 0.2rem 0.6rem;
    border-radius: 999px;
    background: rgba(148, 163, 184, 0.15);
    color: #cbd5e1;
  }

  .mg-state-pill.active {
    background: rgba(16, 185, 129, 0.2);
    color: #34d399;
    border: 1px solid rgba(16, 185, 129, 0.4);
    animation: mgPulse 1.5s infinite;
  }

  @keyframes mgPulse {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.65; }
  }

  .mg-field {
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
  }

  .mg-label-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .mg-label {
    font-size: 0.8rem;
    font-weight: 700;
    color: #cbd5e1;
  }

  .mg-min-hint {
    font-size: 0.72rem;
    color: #64748b;
    font-weight: 600;
  }

  /* Mine Selector Buttons */
  .mg-mine-btns {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 0.5rem;
  }

  .mg-mine-btn {
    background: rgba(30, 41, 59, 0.75);
    border: 1px solid rgba(148, 163, 184, 0.18);
    border-radius: 11px;
    padding: 0.55rem 0.65rem;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.12rem;
    cursor: pointer;
    transition: all 0.15s ease;
    color: #e2e8f0;
  }

  .mg-mine-btn:hover:not(:disabled) {
    border-color: rgba(56, 189, 248, 0.5);
    background: rgba(30, 41, 59, 0.95);
  }

  .mg-mine-btn.active {
    background: rgba(14, 165, 233, 0.18);
    border-color: #38bdf8;
    box-shadow: 0 0 14px rgba(56, 189, 248, 0.2);
  }

  .mg-mine-btn.beast.active {
    background: rgba(239, 68, 68, 0.2);
    border-color: #f87171;
    box-shadow: 0 0 14px rgba(239, 68, 68, 0.25);
  }

  .mg-mine-btn:disabled {
    opacity: 0.5;
    cursor: not-allowed;
  }

  .m-count {
    font-size: 0.9rem;
    font-weight: 800;
  }

  .m-desc {
    font-size: 0.7rem;
    color: #94a3b8;
  }

  /* Bet Input & Quick Buttons */
  .mg-bet-input-wrap {
    position: relative;
    display: flex;
    align-items: center;
  }

  .mg-bet-input {
    width: 100%;
    background: #090d16;
    border: 1px solid rgba(148, 163, 184, 0.25);
    border-radius: 10px;
    padding: 0.6rem 2.2rem 0.6rem 0.85rem;
    color: #facc15;
    font-size: 1.05rem;
    font-weight: 800;
    font-variant-numeric: tabular-nums;
    outline: none;
  }

  .mg-bet-input:focus {
    border-color: #facc15;
  }

  .mg-bet-input:disabled {
    opacity: 0.55;
  }

  .mg-unit {
    position: absolute;
    right: 0.85rem;
    font-weight: 800;
    color: #94a3b8;
    font-size: 0.85rem;
  }

  .mg-bet-quick {
    display: grid;
    grid-template-columns: repeat(6, 1fr);
    gap: 0.35rem;
  }

  .mg-q-btn {
    background: rgba(30, 41, 59, 0.8);
    border: 1px solid rgba(148, 163, 184, 0.16);
    border-radius: 7px;
    padding: 0.38rem 0.2rem;
    font-size: 0.73rem;
    font-weight: 700;
    color: #cbd5e1;
    cursor: pointer;
    transition: all 0.15s ease;
  }

  .mg-q-btn:hover:not(:disabled) {
    background: rgba(250, 204, 21, 0.15);
    border-color: rgba(250, 204, 21, 0.45);
    color: #fde047;
  }

  .mg-q-btn.allin {
    color: #fca5a5;
    border-color: rgba(239, 68, 68, 0.3);
  }

  .mg-q-btn:disabled {
    opacity: 0.45;
    cursor: not-allowed;
  }

  /* Telemetry Box */
  .mg-telemetry-box {
    background: rgba(9, 13, 22, 0.85);
    border: 1px solid rgba(56, 189, 248, 0.2);
    border-radius: 14px;
    padding: 0.9rem;
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
  }

  .mg-tele-row.main-mult-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .mg-tele-col {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }

  .mg-tele-col.right {
    text-align: right;
  }

  .mg-tele-label {
    font-size: 0.72rem;
    color: #94a3b8;
    font-weight: 700;
  }

  .mg-tele-big {
    font-size: 1.55rem;
    font-weight: 900;
    color: #38bdf8;
    font-variant-numeric: tabular-nums;
  }

  .mg-tele-next {
    font-size: 1.35rem;
    font-weight: 900;
    color: #34d399;
    font-variant-numeric: tabular-nums;
  }

  .mg-tele-arrow {
    color: #64748b;
    font-size: 1.1rem;
  }

  .mg-tele-divider {
    height: 1px;
    background: rgba(148, 163, 184, 0.12);
    margin: 0.25rem 0;
  }

  .mg-tele-subrow {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 0.78rem;
    color: #cbd5e1;
  }

  .mg-surv-val {
    color: #34d399;
    font-weight: 800;
  }

  .mg-risk-bar-bg {
    width: 100%;
    height: 7px;
    background: rgba(30, 41, 59, 0.9);
    border-radius: 999px;
    overflow: hidden;
  }

  .mg-risk-bar-fill {
    height: 100%;
    background: linear-gradient(90deg, #10b981, #38bdf8);
    border-radius: 999px;
    transition: width 0.25s ease, background 0.25s ease;
  }

  /* Primary Action Buttons */
  .mg-actions {
    display: flex;
    flex-direction: column;
    gap: 0.55rem;
  }

  .mg-btn-start {
    width: 100%;
    padding: 0.95rem 1rem;
    border-radius: 13px;
    border: none;
    background: linear-gradient(135deg, #0ea5e9 0%, #2563eb 100%);
    color: #ffffff;
    font-size: 1.02rem;
    font-weight: 900;
    cursor: pointer;
    box-shadow: 0 8px 22px rgba(14, 165, 233, 0.3);
    transition: transform 0.14s ease, box-shadow 0.14s ease;
  }

  .mg-btn-start:hover {
    transform: translateY(-2px);
    box-shadow: 0 12px 26px rgba(14, 165, 233, 0.42);
  }

  .mg-btn-cashout {
    width: 100%;
    padding: 0.8rem 1rem;
    border-radius: 13px;
    border: 2px solid #fde047;
    background: linear-gradient(135deg, #10b981 0%, #059669 100%);
    color: #ffffff;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.18rem;
