---
import GameLayout from '../../layouts/GameLayout.astro';
import { getEntry } from 'astro:content';

const entry = await getEntry('games', 'three-sec-quiz');
if (!entry) throw new Error('three-sec-quiz entry not found');
const { data } = entry;
---

<GameLayout
  entry={entry}
  title={data.title}
  description={data.description}
  tagline={data.tagline}
  icon={data.icon}
  category={data.category}
  badge={data.badge}
  players={data.players}
  playTime={data.playTime}
  controls={data.controls}
  rules={data.rules}
  faqItems={data.faqItems}
>
  <div class="tsq-shell" id="tsq-root">
    <!-- Top Bar: Play Mode, Timer Duration & Category Pack -->
    <div class="tsq-topbar">
      <div class="tsq-playstyle-group" role="tablist" aria-label="Play Style">
        <button type="button" class="tsq-style-btn active" data-style="choice" id="style-choice">
          <span>⚡</span>
          <span data-i18n="styleChoice">4지선다 스피드 어택 (1~4키)</span>
        </button>
        <button type="button" class="tsq-style-btn" data-style="voice" id="style-voice">
          <span>🎙️</span>
          <span data-i18n="styleVoice">예능 호스트 외치기 (O/X 판정)</span>
        </button>
      </div>

      <div class="tsq-top-right">
        <div class="tsq-timer-presets" role="group" aria-label="Countdown Seconds">
          <button type="button" class="tsq-sec-btn" data-sec="2">⚡ 2.0s</button>
          <button type="button" class="tsq-sec-btn active" data-sec="3">⏱️ 3.0s</button>
          <button type="button" class="tsq-sec-btn" data-sec="5">🐢 5.0s</button>
        </div>

        <button type="button" class="tsq-sound-btn active" id="btn-sound-toggle" title="효과음 켜기/끄기">
          <span id="sound-icon">🔊</span>
        </button>
      </div>
    </div>

    <!-- Category Pack Selector Tabs -->
    <div class="tsq-pack-bar" role="tablist" aria-label="Question Pack">
      <button type="button" class="tsq-pack-btn active" data-pack="all">
        <span>🔥</span>
        <span data-i18n="packAll">전체 랜덤 폭탄</span>
      </button>
      <button type="button" class="tsq-pack-btn" data-pack="idiom">
        <span>📜</span>
        <span data-i18n="packIdiom">사자성어 이어말하기</span>
      </button>
      <button type="button" class="tsq-pack-btn" data-pack="proverb">
        <span>🐯</span>
        <span data-i18n="packProverb">속담 이어말하기</span>
      </button>
      <button type="button" class="tsq-pack-btn" data-pack="chosung">
        <span>🔤</span>
        <span data-i18n="packChosung">테마 초성·단어</span>
      </button>
      <button type="button" class="tsq-pack-btn" data-pack="capital">
        <span>🌍</span>
        <span data-i18n="packCapital">세계 수도·상식</span>
      </button>
    </div>

    <!-- Main 2-Column Grid -->
    <div class="tsq-main-grid">
      <!-- Left: TV Variety Show Stage -->
      <section class="tsq-stage-card" id="stage-card">
        <!-- HUD Row -->
        <div class="tsq-hud-row">
          <div class="tsq-hud-box">
            <span class="hud-k" data-i18n="hudStreak">연속 정답 스트릭</span>
            <strong class="hud-v accent" id="hud-streak">0연속 🔥</strong>
            <span class="hud-sub" id="hud-max-streak">최고 0연속</span>
          </div>

          <div class="tsq-hud-box timer-hud-box">
            <div class="timer-top-row">
              <span class="hud-k" data-i18n="hudTimer">남은 시간 (COUNTDOWN)</span>
              <span class="lives-hearts" id="hud-lives">❤️❤️❤️</span>
            </div>
            <strong class="hud-v timer-digits" id="hud-timer">3.00s</strong>
            <div class="timer-gauge-track">
              <div class="timer-gauge-fill" id="timer-gauge-fill" style="width: 100%;"></div>
            </div>
          </div>

          <div class="tsq-hud-box">
            <span class="hud-k" data-i18n="hudScore">SCORE</span>
            <strong class="hud-v gold" id="hud-score">0</strong>
            <span class="hud-sub" id="hud-q-count">Q. 1</span>
          </div>
        </div>

        <!-- Giant TV Quiz Prompt Monitor -->
        <div class="tsq-monitor" id="tsq-monitor">
          <div class="monitor-top-badges">
            <span class="m-cat-badge" id="q-category-badge">📜 사자성어 이어말하기</span>
            <span class="m-hint-badge" id="q-subhint">앞 두 글자에 이어질 뒤 두 글자를 고르세요!</span>
          </div>

          <div class="monitor-prompt-area">
            <div class="prompt-call" id="q-prompt-text">동 문</div>
            <div class="prompt-arrow" id="q-prompt-arrow">➔</div>
            <div class="prompt-answer-slot" id="q-answer-slot">? ?</div>
          </div>

          <!-- Feedback / Trap Explanation Banner after answering -->
          <div class="monitor-feedback" id="q-feedback" hidden>
            <span class="fb-verdict" id="fb-verdict">🔔 딩동댕! 정답입니다!</span>
            <span class="fb-detail" id="fb-detail">동문서답 (東問西答): 동쪽을 묻는데 서쪽을 대답한다</span>
          </div>

          <!-- 4-Choice Speed Buttons (Shown in Choice Mode) -->
          <div class="tsq-choices-grid" id="choices-grid">
            <button type="button" class="tsq-choice-btn" data-idx="0">
              <span class="c-num">1</span>
              <span class="c-text">-</span>
            </button>
            <button type="button" class="tsq-choice-btn" data-idx="1">
              <span class="c-num">2</span>
              <span class="c-text">-</span>
            </button>
            <button type="button" class="tsq-choice-btn" data-idx="2">
              <span class="c-num">3</span>
              <span class="c-text">-</span>
            </button>
            <button type="button" class="tsq-choice-btn" data-idx="3">
              <span class="c-num">4</span>
              <span class="c-text">-</span>
            </button>
          </div>

          <!-- Voice Show-Host Judge Controls (Shown in Voice Mode) -->
          <div class="tsq-voice-controls" id="voice-controls" hidden>
            <button type="button" class="voice-btn reveal-btn" id="btn-voice-reveal">
              <span>👀</span>
              <span data-i18n="btnVoiceReveal">정답 공개 (Space)</span>
            </button>
            <button type="button" class="voice-btn pass-btn" id="btn-voice-pass" disabled>
              <span>⭕</span>
              <span data-i18n="btnVoicePass">정답 통과! (O / ←)</span>
            </button>
            <button type="button" class="voice-btn fail-btn" id="btn-voice-fail" disabled>
              <span>🚨</span>
              <span data-i18n="btnVoiceFail">땡! 오답 탈락 (X / →)</span>
            </button>
          </div>

          <!-- Start / Game Over Overlay -->
          <div class="tsq-overlay" id="tsq-overlay">
            <div class="tsq-ov-card">
              <div class="ov-badge" id="ov-badge">🗣️ 3-SECOND BRAIN REFLEX SHOW</div>
              <h2 class="ov-title" id="ov-title">3초 순발력 퀴즈: 사자성어·속담·초성·수도</h2>
              <p class="ov-desc" id="ov-desc">
                <strong>"동문!" → "...수학?!" (땡!!)</strong><br />
                3초 카운트다운 안에 함정 보기를 피해 정답을 맞히거나, 합방·시참 멤버와 마이크로 외치며 연속 정답 신기록에 도전하세요!
              </p>

              <div class="ov-stats-grid" id="ov-stats-grid" hidden>
                <div class="ov-stat">
                  <span class="ov-s-k" data-i18n="statMaxStreak">최고 연속 정답</span>
                  <strong class="ov-s-v accent" id="ov-final-streak">0연속</strong>
                </div>
                <div class="ov-stat">
                  <span class="ov-s-k" data-i18n="statGrade">순발력 등급</span>
                  <strong class="ov-s-v gold" id="ov-final-tier">👑 인간 자판기</strong>
                </div>
                <div class="ov-stat">
                  <span class="ov-s-k" data-i18n="statAvgSpeed">평균 대답 속도</span>
                  <strong class="ov-s-v" id="ov-final-speed">0.00s</strong>
                </div>
                <div class="ov-stat">
                  <span class="ov-s-k" data-i18n="statLastTrap">마지막 뇌정지 문제</span>
                  <strong class="ov-s-v danger" id="ov-last-missed">-</strong>
                </div>
              </div>

              <div class="ov-btn-row">
                <button type="button" class="tsq-btn-primary" id="btn-start-quiz">
                  <span>🚀</span>
                  <span id="btn-start-text" data-i18n="btnStart">퀴즈쇼 시작하기 (Space)</span>
                </button>
              </div>
            </div>
          </div>
        </div>

        <!-- Bottom Quick Bar -->
        <div class="tsq-bottom-bar">
          <div class="shortcut-tips">
            <span data-i18n="shortcutGuide">⌨️ 단축키: <strong>1·2·3·4</strong> 보기 선택 | <strong>O / X</strong> 호스트 판정 | <strong>R</strong> 즉시 재시작</span>
          </div>
          <button type="button" class="tsq-restart-btn" id="btn-restart-quiz">
            <span>🔄</span>
            <span data-i18n="btnRestart">처음부터 재시작 (R)</span>
          </button>
        </div>
      </section>

      <!-- Right Sidebar: Brain Reflex Report, Custom Question Maker & Leaderboard -->
      <aside class="tsq-sidebar">
        <!-- Reflex Diagnosis Report -->
        <div class="tsq-side-card">
          <div class="side-head">
            <span class="side-badge">🧠 BRAIN REFLEX REPORT</span>
            <h3 data-i18n="diagTitle">실시간 순발력 판독서</h3>
          </div>

          <div class="tier-box">
            <span class="tier-icon" id="diag-emoji">🗣️</span>
            <div class="tier-meta">
              <span class="tier-code" id="diag-code">READY</span>
              <strong class="tier-title" id="diag-title">퀴즈를 시작해 뇌 순발력을 측정하세요</strong>
            </div>
          </div>

          <div class="diag-grid">
            <div class="d-cell">
              <span data-i18n="diagCleared">통과 문제 수</span>
              <strong id="diag-cleared">0문제</strong>
            </div>
            <div class="d-cell">
              <span data-i18n="diagBestStreak">최고 스트릭</span>
              <strong id="diag-streak">0연속</strong>
            </div>
            <div class="d-cell">
              <span data-i18n="diagAvgReaction">평균 반응 시간</span>
              <strong id="diag-avg-sec">-</strong>
            </div>
            <div class="d-cell">
              <span data-i18n="diagAccuracy">정답률</span>
              <strong id="diag-acc">100%</strong>
            </div>
          </div>

          <button type="button" class="tsq-copy-btn" id="btn-copy-report">
            <span>📋</span>
            <span id="copy-report-text" data-i18n="btnCopyReport">방송 채팅창용 순발력 진단서 복사</span>
          </button>
        </div>

        <!-- Custom Question Adder -->
        <div class="tsq-side-card custom-q-card">
          <div class="side-head">
            <span class="side-badge emerald">✏️ CUSTOM STUDIO</span>
            <h3 data-i18n="customTitle">내 방송 커스텀 문제 추가</h3>
          </div>
          <form class="custom-q-form" id="custom-q-form" autocomplete="off">
            <input
              type="text"
              id="custom-prompt"
              class="cq-input"
              placeholder="제시어 (예: 치지직의 대표 색깔은?)"
              maxlength="40"
              required
            />
            <input
              type="text"
              id="custom-answer"
              class="cq-input"
              placeholder="정답 (예: 초록색)"
              maxlength="24"
              required
            />
            <input
              type="text"
              id="custom-trap"
              class="cq-input"
              placeholder="함정 오답 쉼표 구분 (예: 보라색, 파란색, 노란색)"
              maxlength="50"
            />
            <button type="submit" class="cq-add-btn" id="btn-add-custom" data-i18n="btnAddCustom">
              ➕ 문제 풀에 즉시 추가 (<span id="custom-cnt">0</span>개 등록됨)
            </button>
          </form>
        </div>

        <!-- Challenger Leaderboard -->
        <div class="tsq-side-card">
          <div class="side-head lb-head">
            <div>
              <span class="side-badge gold">🏆 HALL OF FAME</span>
              <h3 data-i18n="lbTitle">도전자 순위 전광판</h3>
            </div>
            <button type="button" class="lb-clear-btn" id="btn-clear-lb" data-i18n="btnClearLb">초기화</button>
          </div>

          <div class="challenger-row">
            <input
              type="text"
              id="challenger-name"
              class="challenger-input"
              placeholder="👤 도전자 닉네임 (예: 스트리머, 멤버A)"
              maxlength="18"
              value="스트리머"
            />
          </div>

          <ul class="lb-list" id="lb-list">
            <li class="lb-empty" data-i18n="lbEmpty">아직 등록된 기록이 없습니다. 첫 도전을 시작하세요!</li>
          </ul>
        </div>
      </aside>
    </div>
  </div>
</GameLayout>

<script>
  (function () {
    const urlParams = new URLSearchParams(window.location.search);
    const isEn = urlParams.get('lang') === 'en' || window.location.pathname.startsWith('/en');

    const I18N = {
      ko: {
        styleChoice: '4지선다 스피드 어택 (1~4키)',
        styleVoice: '예능 호스트 외치기 (O/X 판정)',
        packAll: '전체 랜덤 폭탄',
        packIdiom: '사자성어 이어말하기',
        packProverb: '속담 이어말하기',
        packChosung: '테마 초성·단어',
        packCapital: '세계 수도·상식',
        hudStreak: '연속 정답 스트릭',
        hudTimer: '남은 시간 (COUNTDOWN)',
        hudScore: 'SCORE',
        btnVoiceReveal: '정답 공개 (Space)',
        btnVoicePass: '정답 통과! (O / ←)',
        btnVoiceFail: '땡! 오답 탈락 (X / →)',
        statMaxStreak: '최고 연속 정답',
        statGrade: '순발력 등급',
        statAvgSpeed: '평균 대답 속도',
        statLastTrap: '마지막 뇌정지 문제',
        btnStart: '퀴즈쇼 시작하기 (Space)',
        btnRetry: '다시 도전하기 (Space)',
        shortcutGuide: '⌨️ 단축키: 1·2·3·4 보기 선택 | O / X 호스트 판정 | R 즉시 재시작',
        btnRestart: '처음부터 재시작 (R)',
        diagTitle: '실시간 순발력 판독서',
        diagCleared: '통과 문제 수',
        diagBestStreak: '최고 스트릭',
        diagAvgReaction: '평균 반응 시간',
        diagAccuracy: '정답률',
        btnCopyReport: '방송 채팅창용 순발력 진단서 복사',
        copiedReport: '✅ 클립보드에 진단서가 복사되었습니다!',
        customTitle: '내 방송 커스텀 문제 추가',
        btnAddCustom: '➕ 문제 풀에 즉시 추가',
        lbTitle: '도전자 순위 전광판',
        btnClearLb: '초기화',
        lbEmpty: '아직 등록된 기록이 없습니다. 첫 도전을 시작하세요!',
        defaultPlayer: '스트리머',
        verdictCorrect: '🔔 딩동댕! 칼같이 맞혔습니다!',
        verdictWrong: '🚨 땡!! 함정에 걸렸습니다!',
        verdictTimeout: '⏰ 시간 초과 땡!! (3초 뇌정지!)',
      },
      en: {
        styleChoice: '4-Choice Speed Attack (Keys 1–4)',
        styleVoice: 'Show Host Voice Mode (O/X Judge)',
        packAll: 'All-in-One Mix',
        packIdiom: 'Idiom Relay',
        packProverb: 'Proverb Relay',
        packChosung: 'Word & Category Clues',
        packCapital: 'World Capitals & Trivia',
        hudStreak: 'CURRENT STREAK',
        hudTimer: 'COUNTDOWN TIMER',
        hudScore: 'SCORE',
        btnVoiceReveal: 'Reveal Answer (Space)',
        btnVoicePass: 'Correct! Pass (O / ←)',
        btnVoiceFail: 'Buzzer! Wrong (X / →)',
        statMaxStreak: 'Best Streak',
        statGrade: 'Reflex Grade',
        statAvgSpeed: 'Avg Answer Speed',
        statLastTrap: 'Last Brain-Glitch Q',
        btnStart: 'Start 3-Sec Quiz Show (Space)',
        btnRetry: 'Play Again (Space)',
        shortcutGuide: '⌨️ Shortcuts: 1·2·3·4 Pick Choice | O / X Host Judge | R Restart',
        btnRestart: 'Restart (R)',
        diagTitle: 'Live Brain Reflex Report',
        diagCleared: 'Questions Cleared',
        diagBestStreak: 'Best Streak',
        diagAvgReaction: 'Avg Answer Time',
        diagAccuracy: 'Accuracy',
        btnCopyReport: 'Copy Reflex Report for Stream Chat',
        copiedReport: '✅ Copied Reflex Report to Clipboard!',
        customTitle: 'Add Custom Stream Questions',
        btnAddCustom: '➕ Add to Question Pool',
        lbTitle: 'Challenger Leaderboard',
        btnClearLb: 'Clear',
        lbEmpty: 'No records yet. Start your first challenge!',
        defaultPlayer: 'Streamer',
        verdictCorrect: '🔔 DING-DONG-DAENG! Correct!',
        verdictWrong: '🚨 BUZZER!! You fell for the trap!',
        verdictTimeout: '⏰ TIME UP BUZZER!! (3-Second Brain Freeze!)',
      }
    };

    const L = isEn ? I18N.en : I18N.ko;

    if (isEn) {
      document.querySelectorAll('[data-i18n]').forEach((el) => {
        const key = el.getAttribute('data-i18n') as keyof typeof L;
        if (key && typeof L[key] === 'string') {
          el.textContent = L[key] as string;
        }
      });
      const chInput = document.getElementById('challenger-name') as HTMLInputElement | null;
      if (chInput) chInput.value = L.defaultPlayer;
    }

    // Question Data Model
    type PackId = 'idiom' | 'proverb' | 'chosung' | 'capital' | 'custom';
    interface QuizItem {
      pack: PackId;
      catLabel: string;
      hint: string;
      prompt: string;
      answer: string;
      traps: string[];
      note: string;
    }

    const KO_QUESTIONS: QuizItem[] = [
      // 1. 사자성어 이어말하기 (Idiom Relay)
      { pack: 'idiom', catLabel: '📜 사자성어 2+2', hint: '앞 두 글자에 이어질 뒤 두 글자를 완성하세요!', prompt: '동 문', answer: '서답', traps: ['수학', '시장', '출구'], note: '동문서답: 동쪽을 묻는데 서쪽을 대답함 (레전드 오답: 동문수학!)' },
      { pack: 'idiom', catLabel: '📜 사자성어 2+2', hint: '앞 두 글자에 이어질 뒤 두 글자를 완성하세요!', prompt: '우 유', answer: '부단', traps: ['배달', '급식', '빛깔'], note: '우유부단: 어물거리며 결단성이 없음 (레전드 오답: 우유배달!)' },
      { pack: 'idiom', catLabel: '📜 사자성어 2+2', hint: '앞 두 글자에 이어질 뒤 두 글자를 완성하세요!', prompt: '유 비', answer: '무환', traps: ['관우', '장비', '통신'], note: '유비무환: 미리 준비가 되어 있으면 우환이 없음 (함정: 유비관우!)' },
