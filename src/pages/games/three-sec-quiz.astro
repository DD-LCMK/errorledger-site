    function shuffle<T>(arr: T[]): T[] {
      const a = [...arr];
      for (let i = a.length - 1; i > 0; i--) {
        const j = Math.floor(Math.random() * (i + 1));
        [a[i], a[j]] = [a[j], a[i]];
      }
      return a;
    }

    function buildDeck() {
      const basePool = isEn ? EN_QUESTIONS : KO_QUESTIONS;
      const combined = [...customQuestions, ...basePool];
      const filtered = state.pack === 'all'
        ? combined
        : combined.filter((q) => q.pack === state.pack || q.pack === 'custom');
      state.deck = shuffle(filtered.length > 0 ? filtered : combined);
      state.qIndex = 0;
    }

    function updateHud() {
      elHudStreak.textContent = isEn ? `${state.streak} 🔥` : `${state.streak}연속 🔥`;
      elHudMaxStreak.textContent = isEn ? `Best ${state.maxStreak}` : `최고 ${state.maxStreak}연속`;
      elHudLives.textContent = '❤️'.repeat(Math.max(0, state.lives)) + '🖤'.repeat(Math.max(0, 3 - state.lives));
      elHudScore.textContent = state.score.toLocaleString();
      elHudQCount.textContent = `Q. ${state.totalAsked + 1}`;

      const clamped = Math.max(0, state.timeLeft);
      elHudTimer.textContent = `${clamped.toFixed(2)}s`;
      const pct = Math.min(100, (clamped / state.limitSec) * 100);
      elTimerFill.style.width = `${pct}%`;

      if (clamped <= 1.0) {
        elTimerFill.style.background = 'linear-gradient(90deg, #ef4444, #f97316)';
        elHudTimer.classList.add('danger');
      } else {
        elTimerFill.style.background = 'linear-gradient(90deg, #10b981, #38bdf8)';
        elHudTimer.classList.remove('danger');
      }

      // Update live diagnosis
      const tier = getTier(state.maxStreak);
      elDiagEmoji.textContent = tier.emoji;
      elDiagCode.textContent = `GRADE ${tier.code}`;
      elDiagTitle.textContent = isEn ? tier.enTitle : tier.koTitle;
      elDiagCleared.textContent = isEn ? `${state.totalCorrect}` : `${state.totalCorrect}문제`;
      elDiagStreak.textContent = isEn ? `${state.maxStreak} Streak` : `${state.maxStreak}연속`;
      elDiagAvgSec.textContent = state.totalCorrect > 0
        ? `${(state.totalAnswerMs / state.totalCorrect / 1000).toFixed(2)}s`
        : '-';
      const acc = state.totalAsked > 0 ? Math.round((state.totalCorrect / state.totalAsked) * 100) : 100;
      elDiagAcc.textContent = `${acc}%`;
    }

    function nextQuestion() {
      clearInterval(state.timerId);
      if (state.qIndex >= state.deck.length) {
        buildDeck();
      }
      const q = state.deck[state.qIndex++];
      state.currentQ = q;
      state.awaitingJudge = false;
      state.timeLeft = state.limitSec;
      state.lastTickInt = Math.ceil(state.limitSec);
      state.qStartMs = performance.now();

      elMonitor.classList.remove('correct-glow', 'wrong-shake');
      elFeedback.hidden = true;
      elCatBadge.textContent = q.catLabel;
      elSubHint.textContent = q.hint;
      elPromptText.textContent = q.prompt;
      elAnswerSlot.textContent = '???';
      elAnswerSlot.className = 'prompt-answer-slot';

      if (state.style === 'choice') {
        elChoicesGrid.hidden = false;
        elVoiceControls.hidden = true;

        const allOpts = shuffle([q.answer, ...q.traps.slice(0, 3)]);
        state.currentChoices = allOpts;
        state.correctChoiceIdx = allOpts.indexOf(q.answer);

        const btns = elChoicesGrid.querySelectorAll<HTMLButtonElement>('.tsq-choice-btn');
        btns.forEach((btn, idx) => {
          btn.disabled = false;
          btn.className = 'tsq-choice-btn';
          const txtEl = btn.querySelector('.c-text')!;
          txtEl.textContent = allOpts[idx] || '-';
        });
      } else {
        elChoicesGrid.hidden = true;
        elVoiceControls.hidden = false;
        btnVoiceReveal.disabled = false;
        btnVoicePass.disabled = true;
        btnVoiceFail.disabled = true;
      }

      updateHud();
      playSfx('tick');

      let lastNow = performance.now();
      state.timerId = window.setInterval(() => {
        if (!state.running || state.awaitingJudge) return;
        const now = performance.now();
        const dt = (now - lastNow) / 1000;
        lastNow = now;
        state.timeLeft -= dt;

        const curCeil = Math.ceil(state.timeLeft);
        if (curCeil < state.lastTickInt && curCeil > 0) {
          state.lastTickInt = curCeil;
          playSfx('tick');
        }

        if (state.timeLeft <= 0) {
          state.timeLeft = 0;
          updateHud();
          handleTimeout();
        } else {
          updateHud();
        }
      }, 40);
    }

    function handleChoicePick(choiceIdx: number) {
      if (!state.running || state.awaitingJudge || state.style !== 'choice' || !state.currentQ) return;
      clearInterval(state.timerId);
      state.awaitingJudge = true;
      state.totalAsked++;

      const q = state.currentQ;
      const elapsedMs = performance.now() - state.qStartMs;
      const btns = elChoicesGrid.querySelectorAll<HTMLButtonElement>('.tsq-choice-btn');
      btns.forEach((b) => (b.disabled = true));

      elAnswerSlot.textContent = q.answer;

      if (choiceIdx === state.correctChoiceIdx) {
        // Correct!
        state.totalCorrect++;
        state.totalAnswerMs += elapsedMs;
        state.streak++;
        if (state.streak > state.maxStreak) state.maxStreak = state.streak;

        const speedBonus = Math.max(20, Math.round((state.limitSec * 1000 - elapsedMs) / 15));
        state.score += 200 + state.streak * 50 + speedBonus;

        btns[choiceIdx]?.classList.add('choice-correct');
        elAnswerSlot.classList.add('revealed-ok');
        elMonitor.classList.add('correct-glow');
        elFeedback.hidden = false;
        elFbVerdict.textContent = L.verdictCorrect;
        elFbVerdict.className = 'fb-verdict ok';
        elFbDetail.textContent = q.note;
        playSfx('correct');
        updateHud();

        setTimeout(() => {
          if (state.running) nextQuestion();
        }, 950);
      } else {
        // Wrong Trap Picked!
        state.streak = 0;
        state.lives--;
        state.lastMissedSummary = `${q.prompt} → ${q.answer}`;

        btns[choiceIdx]?.classList.add('choice-wrong');
        btns[state.correctChoiceIdx]?.classList.add('choice-correct');
        elAnswerSlot.classList.add('revealed-fail');
        elMonitor.classList.add('wrong-shake');
        elFeedback.hidden = false;
        elFbVerdict.textContent = L.verdictWrong;
        elFbVerdict.className = 'fb-verdict fail';
        elFbDetail.textContent = q.note;
        playSfx('wrong');
        updateHud();

        setTimeout(() => {
          if (!state.running) return;
          if (state.lives <= 0) finishQuizShow();
          else nextQuestion();
        }, 1500);
      }
    }

    function handleTimeout() {
      if (!state.currentQ) return;
      clearInterval(state.timerId);
      state.awaitingJudge = true;
      const q = state.currentQ;

      if (state.style === 'choice') {
        state.totalAsked++;
        state.streak = 0;
        state.lives--;
        state.lastMissedSummary = `${q.prompt} → ${q.answer}`;

        const btns = elChoicesGrid.querySelectorAll<HTMLButtonElement>('.tsq-choice-btn');
        btns.forEach((b) => (b.disabled = true));
        btns[state.correctChoiceIdx]?.classList.add('choice-correct');

        elAnswerSlot.textContent = q.answer;
        elAnswerSlot.classList.add('revealed-fail');
        elMonitor.classList.add('wrong-shake');
        elFeedback.hidden = false;
        elFbVerdict.textContent = L.verdictTimeout;
        elFbVerdict.className = 'fb-verdict fail';
        elFbDetail.textContent = q.note;
        playSfx('wrong');
        updateHud();

        setTimeout(() => {
          if (!state.running) return;
          if (state.lives <= 0) finishQuizShow();
          else nextQuestion();
        }, 1550);
      } else {
        // In Voice Host mode, timeout reveals the answer and lets the host judge O or X
        revealVoiceAnswer();
      }
    }

    function revealVoiceAnswer() {
      if (!state.currentQ) return;
      clearInterval(state.timerId);
      state.awaitingJudge = true;
      const q = state.currentQ;

      elAnswerSlot.textContent = q.answer;
      elAnswerSlot.classList.add('revealed-ok');
      elFeedback.hidden = false;
      elFbVerdict.textContent = isEn ? `👀 Answer: ${q.answer}` : `👀 정답 공개: [ ${q.answer} ]`;
      elFbVerdict.className = 'fb-verdict ok';
      elFbDetail.textContent = `${q.note} (함정 주의: ${q.traps.join(', ')})`;

      btnVoiceReveal.disabled = true;
      btnVoicePass.disabled = false;
      btnVoiceFail.disabled = false;
      playSfx('reveal');
    }

    function judgeVoiceResult(passed: boolean) {
      if (!state.running || state.style !== 'voice' || !state.currentQ) return;
      if (!state.awaitingJudge) {
        revealVoiceAnswer();
      }
      state.totalAsked++;
      const q = state.currentQ;

      if (passed) {
        state.totalCorrect++;
        state.totalAnswerMs += 1800;
        state.streak++;
        if (state.streak > state.maxStreak) state.maxStreak = state.streak;
        state.score += 250 + state.streak * 60;
        playSfx('correct');
        updateHud();
        nextQuestion();
      } else {
        state.streak = 0;
        state.lives--;
        state.lastMissedSummary = `${q.prompt} → ${q.answer}`;
        playSfx('wrong');
        updateHud();
        if (state.lives <= 0) {
          finishQuizShow();
        } else {
          nextQuestion();
        }
      }
    }

    function startQuizShow() {
      clearInterval(state.timerId);
      state.running = true;
      state.lives = 3;
      state.streak = 0;
      state.maxStreak = 0;
      state.score = 0;
      state.totalAsked = 0;
      state.totalCorrect = 0;
      state.totalAnswerMs = 0;
      state.lastMissedSummary = '-';

      buildDeck();
      elOverlay.classList.add('hidden');
      playSfx('start');
      nextQuestion();
    }

    function finishQuizShow() {
      state.running = false;
      clearInterval(state.timerId);
      const tier = getTier(state.maxStreak);
      const tierTitle = isEn ? tier.enTitle : tier.koTitle;
      const avgSec = state.totalCorrect > 0
        ? `${(state.totalAnswerMs / state.totalCorrect / 1000).toFixed(2)}s`
        : '-';

      elOvTitle.textContent = isEn
        ? `Best Streak: ${state.maxStreak}! [${tier.emoji} ${tier.code}]`
        : `최고 ${state.maxStreak}연속 정답! [${tier.emoji} ${tier.code}]`;
      elOvDesc.textContent = isEn ? tier.enTitle : tier.koTitle;

      elOvStatsGrid.hidden = false;
      elOvFinalStreak.textContent = isEn ? `${state.maxStreak} Streak (${state.score.toLocaleString()} pts)` : `${state.maxStreak}연속 (${state.score.toLocaleString()}점)`;
      elOvFinalTier.textContent = `${tier.emoji} ${tierTitle}`;
      elOvFinalSpeed.textContent = avgSec;
      elOvLastMissed.textContent = state.lastMissedSummary;

      btnStartText.textContent = L.btnRetry;
      elOverlay.classList.remove('hidden');

      saveRecordToLeaderboard(state.maxStreak, state.score, tier);
    }

    // Leaderboard Persistence
    const LB_KEY = 'el_three_sec_quiz_lb_v1';
    interface LbEntry {
      name: string;
      maxStreak: number;
      score: number;
      tierEmoji: string;
      tierCode: string;
    }

    function loadLb(): LbEntry[] {
      try {
        const raw = localStorage.getItem(LB_KEY);
        return raw ? JSON.parse(raw) : [];
      } catch {
        return [];
      }
    }

    function saveRecordToLeaderboard(maxStreak: number, score: number, tier: ReflexTier) {
      if (score <= 0 && maxStreak <= 0) return;
      const name = (elChallengerName.value || L.defaultPlayer).trim().slice(0, 18);
      const list = loadLb();
      list.push({
        name,
        maxStreak,
        score,
        tierEmoji: tier.emoji,
        tierCode: tier.code
      });
      list.sort((a, b) => b.maxStreak - a.maxStreak || b.score - a.score);
      try {
        localStorage.setItem(LB_KEY, JSON.stringify(list.slice(0, 12)));
      } catch {}
      renderLb();
    }

    function renderLb() {
      const list = loadLb();
      if (list.length === 0) {
        elLbList.innerHTML = `<li class="lb-empty">${L.lbEmpty}</li>`;
        return;
      }
      elLbList.innerHTML = list
        .map((item, idx) => {
          const medal = idx === 0 ? '🥇' : idx === 1 ? '🥈' : idx === 2 ? '🥉' : `${idx + 1}.`;
          return `
            <li class="lb-item ${idx === 0 ? 'top-1' : ''}">
              <span class="lb-rank">${medal}</span>
              <span class="lb-name">${escapeHtml(item.name)}</span>
              <span class="lb-stage">${isEn ? `${item.maxStreak} Streak` : `${item.maxStreak}연속`}</span>
              <span class="lb-tier">${item.tierEmoji} ${item.tierCode}</span>
            </li>
          `;
        })
        .join('');
    }

    function escapeHtml(s: string): string {
      return s.replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c] || c));
    }

    // Event Listeners
    document.querySelectorAll<HTMLButtonElement>('.tsq-style-btn').forEach((btn) => {
      btn.addEventListener('click', () => {
        const st = btn.dataset.style as PlayStyle;
        if (!st) return;
        state.style = st;
        document.querySelectorAll('.tsq-style-btn').forEach((b) => b.classList.remove('active'));
        btn.classList.add('active');
        startQuizShow();
      });
    });

    document.querySelectorAll<HTMLButtonElement>('.tsq-sec-btn').forEach((btn) => {
      btn.addEventListener('click', () => {
        const sec = parseFloat(btn.dataset.sec || '3');
        state.limitSec = sec;
        document.querySelectorAll('.tsq-sec-btn').forEach((b) => b.classList.remove('active'));
        btn.classList.add('active');
        startQuizShow();
      });
    });

    document.querySelectorAll<HTMLButtonElement>('.tsq-pack-btn').forEach((btn) => {
      btn.addEventListener('click', () => {
        const pk = btn.dataset.pack as 'all' | PackId;
        if (!pk) return;
        state.pack = pk;
        document.querySelectorAll('.tsq-pack-btn').forEach((b) => b.classList.remove('active'));
        btn.classList.add('active');
        startQuizShow();
      });
    });

    const btnSoundToggle = document.getElementById('btn-sound-toggle')!;
    const elSoundIcon = document.getElementById('sound-icon')!;
    btnSoundToggle.addEventListener('click', () => {
      soundEnabled = !soundEnabled;
      btnSoundToggle.classList.toggle('active', soundEnabled);
      elSoundIcon.textContent = soundEnabled ? '🔊' : '🔇';
    });

    elChoicesGrid.querySelectorAll<HTMLButtonElement>('.tsq-choice-btn').forEach((btn) => {
      btn.addEventListener('click', () => {
        const idx = parseInt(btn.dataset.idx || '0', 10);
        handleChoicePick(idx);
      });
    });

    btnVoiceReveal.addEventListener('click', () => revealVoiceAnswer());
    btnVoicePass.addEventListener('click', () => judgeVoiceResult(true));
    btnVoiceFail.addEventListener('click', () => judgeVoiceResult(false));

    btnStartQuiz.addEventListener('click', () => startQuizShow());
    btnRestartQuiz.addEventListener('click', () => startQuizShow());

    window.addEventListener('keydown', (e) => {
      const tag = document.activeElement?.tagName.toLowerCase();
      if (tag === 'input' || tag === 'textarea') return;

      if (e.code === 'Space') {
        e.preventDefault();
        if (!state.running) {
          startQuizShow();
        } else if (state.style === 'voice' && !state.awaitingJudge) {
          revealVoiceAnswer();
        }
      } else if (state.running && state.style === 'choice' && !state.awaitingJudge) {
        if (e.key === '1') handleChoicePick(0);
        else if (e.key === '2') handleChoicePick(1);
        else if (e.key === '3') handleChoicePick(2);
        else if (e.key === '4') handleChoicePick(3);
      } else if (state.running && state.style === 'voice') {
        if (e.key === 'o' || e.key === 'O' || e.key === 'ArrowLeft') {
          e.preventDefault();
          judgeVoiceResult(true);
        } else if (e.key === 'x' || e.key === 'X' || e.key === 'ArrowRight') {
          e.preventDefault();
          judgeVoiceResult(false);
        }
      } else if (e.key === 'r' || e.key === 'R') {
        e.preventDefault();
        startQuizShow();
      }
    });

    // Custom Question Form
    function updateCustomCountUI() {
      if (elCustomCnt) elCustomCnt.textContent = String(customQuestions.length);
    }

    customForm.addEventListener('submit', (e) => {
      e.preventDefault();
      const prompt = inputCustomPrompt.value.trim();
      const answer = inputCustomAnswer.value.trim();
      const rawTraps = inputCustomTrap.value
        .split(',')
        .map((s) => s.trim())
        .filter(Boolean);
      if (!prompt || !answer) return;

      const traps = rawTraps.length >= 3
        ? rawTraps.slice(0, 3)
        : [...rawTraps, '모르겠음!', '패스!', '선생님!'].slice(0, 3);

      const newQ: QuizItem = {
        pack: 'custom',
        catLabel: '✏️ 방송 커스텀 문제',
        hint: '스트리머가 직접 출제한 커스텀 순발력 문제!',
        prompt,
        answer,
        traps,
        note: `커스텀 정답: ${prompt} → ${answer}`
      };

      customQuestions.unshift(newQ);
      try {
        localStorage.setItem(CUSTOM_KEY, JSON.stringify(customQuestions.slice(0, 50)));
      } catch {}

      inputCustomPrompt.value = '';
      inputCustomAnswer.value = '';
      inputCustomTrap.value = '';
      updateCustomCountUI();
      buildDeck();
    });

    btnCopyReport.addEventListener('click', () => {
      const tier = getTier(state.maxStreak);
      const name = (elChallengerName.value || L.defaultPlayer).trim();
      const acc = state.totalAsked > 0 ? Math.round((state.totalCorrect / state.totalAsked) * 100) : 100;
      const avgSec = state.totalCorrect > 0
        ? `${(state.totalAnswerMs / state.totalCorrect / 1000).toFixed(2)}s`
        : '-';
      const text = isEn
        ? `🗣️ [3-Second Quiz Reflex Report] ${name} | Best Streak: ${state.maxStreak} (${state.score.toLocaleString()} pts) | Grade: ${tier.emoji} ${tier.code} (${tier.enTitle}) | Avg Speed: ${avgSec} | Accuracy: ${acc}% — https://errorledger.com/en/games/three-sec-quiz`
        : `🗣️ [3초 순발력 퀴즈 판독서] ${name}님 | 최고 연속정답: ${state.maxStreak}연속 (${state.score.toLocaleString()}점) | 등급: ${tier.emoji} ${tier.code} (${tier.koTitle}) | 평균 반응: ${avgSec} | 정답률: ${acc}% — https://errorledger.com/games/three-sec-quiz`;
      navigator.clipboard?.writeText(text).then(() => {
        const orig = L.btnCopyReport;
        elCopyReportText.textContent = L.copiedReport;
        setTimeout(() => {
          elCopyReportText.textContent = orig;
        }, 2000);
      });
    });

    btnClearLb.addEventListener('click', () => {
      localStorage.removeItem(LB_KEY);
      renderLb();
    });

    updateCustomCountUI();
    buildDeck();
    updateHud();
    renderLb();
  })();
</script>

