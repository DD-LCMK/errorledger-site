    // Left funnel slope
    segments.push({ x1: 20, y1: 7060, x2: 210, y2: 7360, type: 'ramp' });
    // Right funnel slope (from lucky hole divider down to throat)
    segments.push({ x1: 475, y1: 7120, x2: 310, y2: 7360, type: 'ramp' });

    // Central Throat Walls (x: 210 to 310, width 100px)
    // Right throat guide
    segments.push({ x1: 310, y1: 7360, x2: 310, y2: 7680, type: 'wall' });
    // Left throat lower guide
    segments.push({ x1: 210, y1: 7520, x2: 210, y2: 7680, type: 'wall' });
    // Deflector ramp below giant propeller hub (guides marbles from hub back into throat)
    segments.push({ x1: 90, y1: 7520, x2: 210, y2: 7560, type: 'ramp' });

    // Mid-funnel bumper pin: adds tension and deflection into lucky hole
    pins.push({ x: 260, y: 7220, radius: 9, isBumper: true });

    // 3. GIANT FINALE PROPELLER (REVERSE KEEPER BAT)
    // Placed at x: 170, y: 7450 (left of the throat x: 210..310)
    // Length: 140px (10%+ longer, wingspan 280px). Extends x: 170 - 140 = 30px to 170 + 140 = 310px.
    // Perfectly covers the entire 100px funnel throat width (x: 210 to 310) with zero gap!
    // Spinning ANTICLOCKWISE (speed: -0.013).
    // In the throat (x > 170), the blade ALWAYS sweeps UPWARDS, batting marbles BACK UP into the funnel!
    spinners.push({
      x: 170,
      y: 7450,
      length: 140,
      angle: 0,
      speed: -0.015,
      isFinaleKeeper: true,
      upwardBatPower: 14.8
    });

    // ZONE 11: 결승선 (FINISH_LINE_Y = 7730) & 피니시 베이슨 (y: 7730 - 8120)
    segments.push({ x1: 60, y1: 7740, x2: 20, y2: 7850, type: 'guide' });
    segments.push({ x1: COURSE_WIDTH - 60, y1: 7740, x2: COURSE_WIDTH - 20, y2: 7850, type: 'guide' });
    segments.push({ x1: 20, y1: 8080, x2: COURSE_WIDTH - 20, y2: 8080, type: 'wall' });
  }

  buildCourse();

  // State
  let marbles: Marble[] = [];
  let activeMarbleNames: string[] = [];
  let isRacing = false;
  let isCountingDown = false;
  let raceStartTime = 0;
  let finishRankCounter = 0;
  let timeScale = 1.5; // Default 1.5x speed
  let cameraY = 0;
  let winnerMode = 'last'; // 'last', 'first', 'multi', 'custom'
  let lastRunnerCountdown: number | null = null;

  // Camera & Viewport State
  let zoom = 0.5; // Default 0.5x: panorama view showing 1320px course width
  let camMode: 'auto' | 'first' | 'last' | 'runner' = 'auto';
  let focusedMarbleId: number | null = null;
  let isManualCam = false;

  // DOM Queries
  const canvas = document.getElementById('marble-canvas') as HTMLCanvasElement;
  const ctx = canvas?.getContext('2d');
  const canvasViewport = document.getElementById('canvas-viewport');
  const minimapCanvas = document.getElementById('minimap-canvas') as HTMLCanvasElement;
  const miniCtx = minimapCanvas?.getContext('2d');
  const minimapContainer = document.getElementById('minimap-container');
  const panHintChip = document.getElementById('pan-hint-chip');
  const camResumeBtn = document.getElementById('cam-resume-btn');

  const namesInput = document.getElementById('names-input') as HTMLTextAreaElement;
  const marbleCountBadge = document.getElementById('marble-count-badge');
  const raceToggleBtn = document.getElementById('race-toggle-btn');
  const winnerModeSelect = document.getElementById('winner-mode-select') as HTMLSelectElement | null;
  const shuffleBtn = document.getElementById('shuffle-btn');
  const applyBtn = document.getElementById('apply-btn');

  const leadNameElem = document.getElementById('lead-name');
  const finishProgressElem = document.getElementById('finish-progress');
  const finishListElem = document.getElementById('finish-list');

