---
import GameLayout from '../../layouts/GameLayout.astro';
import { getEntry } from 'astro:content';

const gameEntry = await getEntry('games', 'marble-roulette');
const data = gameEntry?.data || {
  title: '방송용 마블 룰렛 (구슬 레이스)',
  tagline: '물리 엔진 기반 구슬 굴리기 추첨기',
  description: '원판 룰렛보다 10배 더 쫄깃한 실시간 구슬 레이스! 1등 당첨부터 꼴찌 벌칙 뽑기, 다중 당첨까지 완벽 지원합니다.',
  icon: '🔮',
  category: 'stream',
  badge: '🔮 마블 레이스',
  players: '1~100인+ (무제한)',
  playTime: '30초~1분',
  controls: [
    '참가자 목록을 한 줄에 하나씩 입력 (홍길동 * 3 입력 시 구슬 3개 생성)',
    '당첨 방식 선택: 1등 당첨, 꼴찌(벌칙) 당첨, 다중 당첨, 특정 순위',
    '레이스 시작 또는 스페이스바를 눌러 출발 게이트 오픈',
    '배속 조절 버튼(1x / 1.5x / 2x)으로 레이스 속도 제어'
  ],
  rules: [
    '모든 참가자의 이름이 새겨진 고유 색상의 구슬이 상단 출발선에 배치됩니다.',
    '게이트가 열리면 중력과 충돌 물리 법칙에 따라 핀과 회전 장애물을 튕겨 내려옵니다.',
    '결승선을 통과한 순서에 따라 1등부터 꼴찌까지의 순위가 실시간 기록됩니다.',
    '설정한 당첨 조건(1등 또는 꼴찌 등)에 부합하는 참가자가 최종 당첨자로 선정됩니다.'
  ],
  faqItems: [
    {
      q: '구슬 레이스 결과는 조작 없이 공정한가요?',
      a: '네! 마블 룰렛은 매 프레임 순수한 2D 강체 물리 연산(중력, 탄성 계수, 충돌 반발력, 각운동량)에 의해 시뮬레이션되므로 누구도 결과를 예측하거나 임의 조작할 수 없습니다.'
    },
    {
      q: '벌칙용으로 꼴찌를 뽑고 싶을 때는 어떻게 하나요?',
      a: '상단 당첨자 설정에서 [💀 꼴찌(마지막) 당첨] 모드를 선택하시면 됩니다. 가장 마지막에 결승선을 통과하는 구슬이 당첨자로 선정되며, 후반부에는 꼴찌를 다투는 구슬을 카메라가 집중 조명합니다.'
    }
  ]
};
---

<GameLayout
  title={data.title}
  description={data.description}
  tagline={data.tagline}
  icon={data.icon}
  category={data.category}
  badge={data.badge}
  players={data.players}
  playTime={data.playTime}
  controls={data.controls}
  rules={data.rules}
  faqItems={data.faqItems}
  layoutMode="full"
  hideStageHeader={true}
  hideFooter={false}
>
  <div class="marble-app-root" id="marble-root">

    <!-- Main Game Container -->
    <div class="marble-main-layout">

      <!-- Left Column: Race Track Canvas & Minimap -->
      <div class="track-column">
        <div class="canvas-card">
          <!-- Live Overlay Header with Header Start/Reset Button followed by Camera Options -->
          <div class="track-hud-overlay">
            <div class="hud-left-items">
              <!-- Dynamic Start / Reset Toggle Button (Header Section) -->
              <button id="race-toggle-btn" class="hud-race-btn start-mode" title="레이스 시작 (단축키: Space)">
                <span class="btn-icon">🚀</span>
                <span class="btn-text">시작</span>
              </button>

              <!-- Camera View Options Follow Immediately -->
              <div class="cam-control-group">
                <button class="cam-btn active" data-cam="auto" title="선두 완주 전까지 선두 추적, 완주 후 모드별 동적 전환">🎥 자동</button>
                <button class="cam-btn" data-cam="first" title="선두 주자 집중 추적">🥇 선두</button>
                <button class="cam-btn" data-cam="last" title="후미/꼴찌 주자 집중 추적">💀 꼴찌</button>
                <button class="cam-resume-btn hidden" id="cam-resume-btn" title="자동 추적 카메라로 복귀">↩ 자동 복귀</button>
              </div>

              <div class="live-rank-chip" id="live-rank-chip">
                <span class="rank-dot">● LIVE</span>
                <span class="rank-text" id="lead-name">선두: 대기 중</span>
              </div>
            </div>
            
            <div class="hud-right-items">
              <div class="zoom-control-group">
                <button class="zoom-btn active" data-zoom="0.5" title="파노라마 뷰 (코스 1320px 표시)">0.5x</button>
                <button class="zoom-btn" data-zoom="0.75" title="표준 뷰 (코스 880px 표시)">0.75x</button>
                <button class="zoom-btn" data-zoom="1.0" title="1:1 실제 배율">1x</button>
              </div>
              <div class="speed-control-group">
                <button class="speed-btn" data-speed="0.5" title="0.5배속 (슬로우 모션)">0.5x</button>
                <button class="speed-btn" data-speed="1" title="1배속 (기본 속도)">1x</button>
                <button class="speed-btn active" data-speed="1.5" title="1.5배속 (빠른 진행)">1.5x</button>
              </div>
              <button class="sound-hud-btn" id="sound-toggle-hud-btn" title="음향 켜기/끄기" aria-label="음향 켜기/끄기">
                <span id="hud-sound-icon">🔊</span>
              </button>
              <button class="theater-btn" id="theater-toggle-btn" title="설정창 접기/펼치기 (게임 화면 집중 모드)">📺 집중 모드</button>
            </div>
          </div>

          <!-- Canvas Viewport -->
          <div class="canvas-viewport" id="canvas-viewport">
            <canvas id="marble-canvas" width="620" height="660"></canvas>

            <!-- Countdown Overlay -->
            <div class="countdown-overlay hidden" id="countdown-overlay">
              <span class="countdown-number" id="countdown-number">3</span>
            </div>

            <!-- Minimap Strip (Expanded for high-resolution course radar) -->
            <div class="minimap-container" id="minimap-container" title="코스 전체 미니맵 (클릭/드래그 시 시점 이동)">
              <canvas id="minimap-canvas" width="76" height="580"></canvas>
            </div>

            <!-- Pan hint badge -->
            <div class="pan-hint-chip" id="pan-hint-chip">
              <span>🖱️ 드래그/휠로 맵 자유 탐색</span>
            </div>
          </div>
        </div>
      </div>

      <!-- Right Column: Settings, Inputs & Live Log -->
      <div class="control-column">
        
        <!-- Winner Mode Dropdown Selection (Compact Space-Saving UI) -->
        <div class="panel-box">
          <div class="panel-header compact-header">
            <span class="panel-title">🎯 당첨 방식 설정</span>
          </div>
          <div class="mode-select-wrap">
            <select id="winner-mode-select" class="mode-select">
              <option value="last" selected>💀 꼴찌 당첨 (마지막 통과자 / 벌칙·내기)</option>
              <option value="first">🥇 1등 당첨 (가장 먼저 통과한 구슬)</option>
              <option value="multi">🏆 다중 당첨 (상위 N명 통과자)</option>
              <option value="custom">🎯 특정 순위 (지정 N번째 통과자)</option>
            </select>
          </div>

          <!-- Dynamic Mode Sub-settings -->
          <div class="mode-sub-row hidden" id="multi-settings-row">
            <label>당첨 인원수:</label>
            <input type="number" id="multi-count-input" value="3" min="1" max="20" class="sub-num-input" />
            <span>명 (1등부터 순서대로)</span>
          </div>

          <div class="mode-sub-row hidden" id="custom-settings-row">
            <label>지정 당첨 순위:</label>
            <input type="number" id="custom-rank-input" value="7" min="1" max="50" class="sub-num-input" />
            <span>등 통과자 당첨</span>
          </div>
        </div>

        <!-- Participant Names Input -->
        <div class="panel-box">
          <div class="panel-header">
            <span class="panel-title">👥 참가자 목록</span>
            <span class="marble-count-badge" id="marble-count-badge">총 8개 구슬 대기</span>
          </div>
          <textarea id="names-input" class="names-textarea" rows="6" placeholder="참가자 이름을 한 줄에 하나씩 입력하세요.&#10;예시:&#10;김팀장&#10;이대리&#10;박사원 * 2 (구슬 2개)&#10;최인턴"></textarea>
          <div class="input-actions-row">
            <button id="shuffle-btn" class="btn-small-action">🔀 무작위 섞기</button>
            <button id="apply-btn" class="btn-small-action primary">✓ 구슬 배치하기</button>
          </div>
        </div>

        <!-- Live Finish Order Board -->
        <div class="panel-box finish-log-box">
          <div class="panel-header">
            <span class="panel-title">🏁 완주 현황 (실시간 순위)</span>
            <span class="finish-progress-text" id="finish-progress">0 / 8 완주</span>
          </div>
          <div class="finish-list" id="finish-list">
            <div class="finish-empty-hint">레이스가 시작되면 결승선을 통과한 순서가 기록됩니다.</div>
          </div>
        </div>

        <!-- Energy Gauge Toggle -->
        <div class="panel-box">
          <div class="panel-header">
            <span class="panel-title">⚡ 에너지 게이지 설정</span>
          </div>
          <label class="energy-toggle-label">
            <input type="checkbox" id="energy-gauge-toggle" checked />
            <span class="energy-toggle-text">
              <strong>충돌 폭발 효과 활성화</strong>
              <span class="energy-toggle-desc">구슬이 충돌할수록 에너지가 차오르고, 가득 차면 주변 구슬을 밀어내는 충격파를 발사합니다.</span>
            </span>
          </label>
        </div>

      </div>
    </div>

    <!-- Final Result Modal -->
    <div class="marble-modal hidden" id="result-modal">
      <div class="modal-card">
        <div class="modal-confetti" id="modal-confetti"></div>
        <div class="modal-icon" id="modal-winner-icon">🎉</div>
        <h2 id="modal-winner-title">최종 당첨자 발표!</h2>
        
        <div class="winner-spotlight" id="winner-spotlight">
          <span class="spotlight-badge" id="spotlight-badge">당첨 (꼴찌)</span>
          <strong class="spotlight-name" id="spotlight-name">김팀장</strong>
          <p class="spotlight-sub" id="spotlight-sub">커피 당첨을 축하드립니다!</p>
        </div>

        <div class="modal-ranks-scroll" id="modal-ranks-scroll">
          <!-- Injected dynamically -->
        </div>

        <div class="modal-btn-row">
          <button id="modal-restart-btn" class="btn-modal-primary">🔄 다시 달리기</button>
          <button id="modal-close-btn" class="btn-modal-secondary">닫기</button>
        </div>
      </div>
    </div>

  </div>

  <div slot="guide">
    <h2>방송용 마블 룰렛 (구슬 레이스) 완벽 가이드</h2>
    <p>
      <strong>마블 룰렛</strong>은 실제 2D 물리 법칙을 바탕으로 구슬들이 7,200px 초대형 롱코스를 질주하는 방송용 실시간 구슬 추첨기입니다.
      단순히 먼저 떨어진 구슬이 이기는 것이 아니라, 트랙 곳곳의 <strong>역전의 스프링 바운서(Spring Bouncer)</strong>와 <strong>11개의 회전 스피너</strong>, <strong>도박의 갈림길</strong>을 통해 1등이 언제든 꼴찌로 뒤바뀌는 극강의 도파민을 제공합니다.
    </p>
    <ul>
      <li><strong>⚡ 역전의 스프링 바운서 (Comeback Bouncers):</strong> 최고 속도로 질주하는 선두 구슬이 바운서에 충돌하면 폭발적인 반발력으로 거꾸로 튕겨 올라가 후발 주자들과 뒤엉키게 됩니다!</li>
      <li><strong>🔀 도박의 갈림길 (지름길 vs 안전 외곽로):</strong> 중앙의 고속 지름길은 빠르지만 출구에 리버스 함정이 도사리고 있어 언제든 판도가 뒤집힙니다.</li>
      <li><strong>💀 꼴찌 당첨 모드:</strong> 가장 마지막까지 결승선을 넘지 못한 구슬이 당첨되는 모드로, 커피 쏘기·치킨 내기·벌칙 뽑기 방송에 제격입니다.</li>
      <li><strong>🥇 1등 당첨 모드:</strong> 치열한 난투극 끝에 가장 먼저 골인한 구슬이 우승하는 클래식 레이스 모드입니다.</li>
      <li><strong>다중 구슬 배정 (* N):</strong> 이름 뒤에 <code>* 3</code> 또는 <code>* 5</code>를 적으면 해당 참가자에게 구슬이 여러 개 지급되어 확률을 조절할 수 있습니다.</li>
      <li><strong>실시간 미니맵 & 카메라 워킹:</strong> 우측 7,200px 전체 코스 미니맵을 통해 구슬 분포를 파악하고, 선두와 꼴찌의 명승부를 실시간으로 추적합니다.</li>
    </ul>
  </div>
</GameLayout>

<style>
  .marble-app-root {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 0.5rem 0.25rem;
    user-select: none;
    gap: 0.75rem;
    width: 100%;
  }

  /* Main Two-Column Layout (68:32 Game Dominant Ratio) */
  .marble-main-layout {
    display: grid;
    grid-template-columns: minmax(620px, 1fr) 350px;
    gap: 1.25rem;
    width: 100%;
    max-width: 100%;
    align-items: start;
    transition: all 0.25s ease;
  }

  .marble-main-layout.theater-mode {
    grid-template-columns: 1fr;
    max-width: 980px;
    margin: 0 auto;
  }

  .marble-main-layout.theater-mode .control-column {
    display: none;
  }

  @media (max-width: 1100px) {
    .marble-main-layout {
      grid-template-columns: 1fr;
      justify-items: center;
    }
  }

  /* Left Track Column */
  .track-column {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    width: 100%;
    min-width: 0;
  }

  @media (max-width: 600px) {
    .track-column {
      width: 100%;
    }
  }

  .canvas-card {
    background: #090d16;
    border: 2px solid rgba(255, 255, 255, 0.12);
    border-radius: 16px;
    overflow: hidden;
    box-shadow: 0 12px 36px rgba(0, 0, 0, 0.7), 0 0 20px rgba(56, 189, 248, 0.15);
    display: flex;
    flex-direction: column;
  }

  /* Track HUD Top Bar - Fixed Height to prevent any row-shift or layout jump */
  .track-hud-overlay {
    display: flex;
    justify-content: space-between;
    align-items: center;
    background: #0f172a;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    padding: 0.35rem 0.65rem;
    gap: 0.35rem;
    height: 44px;
    min-height: 44px;
    max-height: 44px;
    box-sizing: border-box;
    flex-wrap: nowrap;
    overflow: hidden;
  }

  .hud-left-items {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    flex-wrap: nowrap;
    flex-shrink: 0;
  }

  .hud-right-items {
    display: flex;
    align-items: center;
    gap: 0.3rem;
    flex-wrap: nowrap;
    flex-shrink: 0;
  }

  .live-rank-chip {
    display: flex;
    align-items: center;
    gap: 0.3rem;
    font-size: 0.72rem;
    font-weight: 800;
    color: #f8fafc;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    max-width: 155px;
    flex-shrink: 1;
  }

  .live-rank-chip .rank-text {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .rank-dot {
    color: #ef4444;
    font-size: 0.7rem;
    animation: pulse 1s infinite;
    flex-shrink: 0;
  }

  @keyframes pulse {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.4; }
  }

  @media (max-width: 720px) {
    .track-hud-overlay {
      flex-wrap: wrap;
      height: auto;
      min-height: 76px;
      max-height: 76px;
      padding: 0.3rem 0.5rem;
      gap: 0.3rem;
    }
    .hud-left-items,
    .hud-right-items {
      width: 100%;
      justify-content: space-between;
    }
  }

  /* Camera Mode Controls */
  .cam-control-group {
    display: flex;
    align-items: center;
    gap: 0.2rem;
  }

  .cam-btn {
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid rgba(255, 255, 255, 0.12);
    color: #cbd5e1;
    font-size: 0.7rem;
    font-weight: 800;
    padding: 0.2rem 0.45rem;
    border-radius: 6px;
    cursor: pointer;
    transition: all 0.15s ease;
  }

  .cam-btn:hover {
    background: rgba(255, 255, 255, 0.12);
  }

  .cam-btn.active {
    background: rgba(250, 204, 21, 0.2);
    color: #facc15;
    border-color: #facc15;
    box-shadow: 0 0 8px rgba(250, 204, 21, 0.3);
  }

  .cam-resume-btn {
    background: #f59e0b;
    color: #020617;
    border: 1px solid #facc15;
    font-size: 0.7rem;
    font-weight: 900;
    padding: 0.2rem 0.5rem;
    border-radius: 6px;
    cursor: pointer;
    box-shadow: 0 0 8px rgba(245, 158, 11, 0.5);
  }

  /* Zoom Mode Controls */
  .zoom-control-group {
    display: flex;
    align-items: center;
    gap: 0.2rem;
  }

  .zoom-btn {
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.1);
    color: #94a3b8;
    font-size: 0.68rem;
    font-weight: 700;
    padding: 0.18rem 0.38rem;
    border-radius: 5px;
    cursor: pointer;
    transition: all 0.15s ease;
  }

  .zoom-btn:hover {
    color: #f8fafc;
  }

  .zoom-btn.active {
    background: #0284c7;
    color: #f8fafc;
    border-color: #38bdf8;
    box-shadow: 0 0 8px rgba(56, 189, 248, 0.3);
  }

  .speed-control-group {
    display: flex;
    gap: 0.2rem;
  }

  .speed-btn {
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid rgba(255, 255, 255, 0.12);
    color: #94a3b8;
    font-size: 0.7rem;
    font-weight: 800;
    padding: 0.18rem 0.45rem;
    border-radius: 6px;
    cursor: pointer;
  }

  .speed-btn.active {
    background: #38bdf8;
    color: #040813;
    border-color: #38bdf8;
  }

  .sound-hud-btn {
    background: rgba(14, 165, 233, 0.15);
    border: 1px solid rgba(14, 165, 233, 0.35);
    color: #e0f2fe;
    padding: 0.2rem 0.5rem;
    border-radius: 6px;
    font-size: 0.8rem;
    cursor: pointer;
    transition: all 0.15s ease;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 32px;
  }

