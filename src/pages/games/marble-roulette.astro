  const energyToggle = document.getElementById('energy-gauge-toggle') as HTMLInputElement | null;

  // Parse names and multipliers (e.g. "홍길동 * 3")
  function parseNamesList(): string[] {
    const raw = namesInput?.value || '';
    const lines = raw.split(/[,\n]/).map(s => s.trim()).filter(Boolean);
    const parsed: string[] = [];

    lines.forEach(line => {
      const match = line.match(/^(.+?)\s*\*\s*(\d+)$/);
      if (match) {
        const name = match[1].trim();
        const count = Math.min(50, Math.max(1, parseInt(match[2], 10)));
        for (let i = 0; i < count; i++) {
          parsed.push(name);
        }
      } else {
        parsed.push(line);
      }
    });

    return parsed.length > 0 ? parsed : PRESETS.coffee.names;
  }

  // Map each unique participant name to a stable dedicated color
  function getParticipantColorMap(): Map<string, string> {
    const raw = namesInput?.value || '';
    const lines = raw.split(/[,\n]/).map(s => s.trim()).filter(Boolean);
    const colorMap = new Map<string, string>();
    let colorIdx = 0;

    lines.forEach(line => {
      const match = line.match(/^(.+?)\s*\*\s*(\d+)$/);
      const name = match ? match[1].trim() : line.trim();
      if (name && !colorMap.has(name)) {
        colorMap.set(name, MARBLE_COLORS[colorIdx % MARBLE_COLORS.length]);
        colorIdx++;
      }
    });

    if (colorMap.size === 0) {
      PRESETS.coffee.names.forEach((name, i) => {
        if (!colorMap.has(name)) {
          colorMap.set(name, MARBLE_COLORS[i % MARBLE_COLORS.length]);
        }
      });
    }

    return colorMap;
  }

  function spawnMarbles() {
    if (activeMarbleNames.length === 0) {
      activeMarbleNames = parseNamesList();
    }
    const names = activeMarbleNames;
    const colorMap = getParticipantColorMap();
    let fallbackIdx = colorMap.size;

    marbles = [];
    shockwaves = [];
    finishRankCounter = 0;
    cameraY = 0;
    isGateOpen = false;
    isManualCam = false;
    focusedMarbleId = null;
    updateCamModeHUD();

    if (marbleCountBadge) {
      marbleCountBadge.textContent = isEn ? `Total ${names.length} marbles` : `총 ${names.length}개 구슬 대기`;
    }

    // Distribute in starting hopper (y: 65 - 200) with safe padding under ceiling y: 45
    const totalCount = names.length;
    const cols = Math.max(8, Math.min(16, Math.ceil(Math.sqrt(totalCount * 3.5))));
    const totalRows = Math.ceil(totalCount / cols);
    const startX = 65;
    const endX = COURSE_WIDTH - 65;
    const spacingX = cols > 1 ? (endX - startX) / (cols - 1) : 0;
    const rowSpacing = Math.min(26, Math.max(14, 125 / Math.max(1, totalRows)));

    names.forEach((name, idx) => {
      const row = Math.floor(idx / cols);
      const col = idx % cols;
      const staggerX = (row % 2 === 1) ? (spacingX * 0.25) : 0;
      const jitterX = (Math.random() - 0.5) * 4;
      const jitterY = (Math.random() - 0.5) * 3;
      const spawnX = Math.max(35, Math.min(COURSE_WIDTH - 35, startX + col * spacingX + staggerX + jitterX));
      const spawnY = Math.max(68, Math.min(200, 72 + row * rowSpacing + jitterY));

      let marbleColor = colorMap.get(name);
      if (!marbleColor) {
        marbleColor = MARBLE_COLORS[fallbackIdx % MARBLE_COLORS.length];
        colorMap.set(name, marbleColor);
        fallbackIdx++;
      }

      marbles.push({
        id: idx,
        name,
        x: spawnX,
        y: spawnY,
        vx: (Math.random() - 0.5) * 0.4,
        vy: 0,
        radius: 11.25, // 25% larger marbles (was 9)
        color: marbleColor,
        finished: false,
        finishTime: 0,
        finishRank: 0,
        energy: 0,
        lastShockwaveTime: 0,
        stuckTimer: 0,
        lastSampleX: spawnX,
        lastSampleY: spawnY
      });
    });

    if (finishListElem) {
      finishListElem.innerHTML = `<div class="finish-empty-hint">${isEn ? 'Finishing order will appear here live.' : '레이스가 시작되면 결승선을 통과한 순서가 기록됩니다.'}</div>`;
    }
    if (finishProgressElem) {
      finishProgressElem.textContent = isEn ? `0 / ${marbles.length} Finished` : `0 / ${marbles.length} 완주`;
    }
    if (leadNameElem) {
      leadNameElem.textContent = isEn ? 'Leader: Waiting' : '선두: 대기 중';
    }
    lastRunnerCountdown = null;
  }

  let countdownTimer: any = null;

  function updateRaceButton() {
    if (!raceToggleBtn) return;
    if (isRacing || isCountingDown) {
      raceToggleBtn.className = 'hud-race-btn reset-mode';
      raceToggleBtn.innerHTML = `<span class="btn-icon">🔄</span><span class="btn-text">${isEn ? 'Reset' : '리셋'}</span>`;
      raceToggleBtn.title = isEn ? 'Reset race' : '레이스 리셋 (처음 위치로 복귀)';
    } else {
      raceToggleBtn.className = 'hud-race-btn start-mode';
      raceToggleBtn.innerHTML = `<span class="btn-icon">🚀</span><span class="btn-text">${isEn ? 'Start' : '시작'}</span>`;
      raceToggleBtn.title = isEn ? 'Start race (Space)' : '레이스 시작 (단축키: Space)';
    }
  }

  function resetRace() {
    if (countdownTimer) {
      clearInterval(countdownTimer);
      countdownTimer = null;
    }
    isRacing = false;
    isCountingDown = false;
    lastRunnerCountdown = null;
    secretGate.locked = true;
    secretGate.unlockTimer = 0;
    cannonAlertTimer = 0;
    if (countdownOverlay) countdownOverlay.classList.add('hidden');
    spawnMarbles();
    updateRaceButton();
  }

  // Countdown & Start (always resets first before starting)
  function startRace() {
    resetRace();

    isCountingDown = true;
    lastRunnerCountdown = null;
    secretGate.locked = true;
    secretGate.unlockTimer = 0;
    cannonAlertTimer = 0;
    updateRaceButton();
    if (countdownOverlay) countdownOverlay.classList.remove('hidden');

    let count = 3;
    if (countdownNumber) countdownNumber.textContent = '3';
    sfx.playBeep(440, 0.15);

    countdownTimer = setInterval(() => {
      count--;
      if (count > 0) {
        if (countdownNumber) countdownNumber.textContent = String(count);
        sfx.playBeep(440, 0.15);
      } else if (count === 0) {
        if (countdownNumber) countdownNumber.textContent = 'GO!';
        sfx.playBeep(880, 0.3);
      } else {
        clearInterval(countdownTimer);
        countdownTimer = null;
        isCountingDown = false;
        if (countdownOverlay) countdownOverlay.classList.add('hidden');
        
        // Open gate!
        isGateOpen = true;
        isRacing = true;
        lastRunnerCountdown = null;
        raceStartTime = performance.now();
        updateRaceButton();
      }
    }, 700);
  }

  // Energy Shockwave Burst (Only allowed after passing Zone 4 at y: 3080)
  function triggerShockwave(src: Marble) {
    if (src.y < 3080) return; // Strictly restricted until passing Zone 4!
    const now = performance.now();
    if (now - src.lastShockwaveTime < 24000) {
      return; // Cooldown of 24 seconds per marble (much lesser occurrence)
    }
    src.lastShockwaveTime = now;
    sfx.playPop();

    const blastRadius = 200;
    shockwaves.push({
      x: src.x,
      y: src.y,
      radius: src.radius,
      maxRadius: blastRadius,
      color: src.color,
      alpha: 1.0
    });

    // 1. Radial push on nearby marbles (scaled by 0.65 for 35% slower marble dynamics)
    marbles.forEach(other => {
      if (other.id === src.id || other.finished) return;
      const dx = other.x - src.x;
      const dy = other.y - src.y;
      const dist = Math.hypot(dx, dy);
      if (dist < blastRadius && dist > 0.01) {
        const factor = (1 - dist / blastRadius) * 20.8;
        const nx = dx / dist;
        const ny = dy / dist;
        other.vx += nx * factor;
        other.vy += ny * factor;
      }
    });

    // 2. Obstacle Bounce: Marble bounces ITSELF away from nearby obstacles and walls (3x stronger repulsion)
    let repulseX = 0;
    let repulseY = 0;
    let obstacleNearCount = 0;

    // Check course segments (walls, ramps, dividers)
    segments.forEach(seg => {
      const res = distToSegment(src.x, src.y, seg.x1, seg.y1, seg.x2, seg.y2);
      if (res.d < 85) {
        const d = Math.max(res.d, 1);
        const nx = (src.x - res.px) / d;
        const ny = (src.y - res.py) / d;
        const weight = (85 - d) / 85;
        repulseX += nx * weight;
        repulseY += ny * weight;
        obstacleNearCount++;
      }
    });

    // Check static pins
    pins.forEach(p => {
      const dx = src.x - p.x;
      const dy = src.y - p.y;
      const dist = Math.hypot(dx, dy);
      if (dist < 85 && dist > 0.01) {
        const weight = (85 - dist) / 85;
        repulseX += (dx / dist) * weight;
        repulseY += (dy / dist) * weight;
        obstacleNearCount++;
      }
    });

    // Boundaries
    if (src.x < 55) {
      repulseX += (55 - src.x) / 55;
      obstacleNearCount++;
    } else if (src.x > COURSE_WIDTH - 55) {
      repulseX -= (src.x - (COURSE_WIDTH - 55)) / 55;
      obstacleNearCount++;
    }

    if (obstacleNearCount > 0) {
      const len = Math.hypot(repulseX, repulseY) || 1;
      src.vx += (repulseX / len) * 15.6;
      src.vy = Math.min(src.vy, 0) + (repulseY / len) * 10.4 + 5.85; // Downward escape launch (scaled 0.65x)
    } else {
      // General strong forward boost if triggered in open space
      src.vy += 6.5;
      src.vx += (Math.random() - 0.5) * 9.1;
    }
  }

  // Physics Update
  function updatePhysics(dt: number) {
    if (!isRacing) return;

    const gravity = 0.0586 * timeScale; // 35% slower marble acceleration (0.0902 * 0.65)
    const friction = Math.pow(0.976, timeScale); // balanced air drag
    const bounce = 0.36; // (was 0.38)

    // Spinners angular update (30% slower movement)
    spinners.forEach(sp => {
      sp.angle += sp.speed * 0.70 * timeScale;
    });

    // Shockwaves animation update (30% slower movement)
    for (let i = shockwaves.length - 1; i >= 0; i--) {
      const sw = shockwaves[i];
      sw.radius += 4.55 * timeScale;
      sw.alpha -= 0.0154 * timeScale;
      if (sw.alpha <= 0 || sw.radius >= sw.maxRadius) {
        shockwaves.splice(i, 1);
      }
    }

    // 1. Move Marbles
    marbles.forEach(m => {
      if (m.finished && m.y > FINISH_LINE_Y + 100) {
        // Gently settle finished marbles in catch basin
        m.vx *= 0.92;
        m.vy *= 0.92;
        m.x += m.vx;
        m.y += m.vy;
        return;
      }

      m.vy += gravity;
      m.vx *= friction;

      // Free-fall terminal velocity clamp (keeps normal rolling pace readable and suspenseful)
      if (m.vy > 5.2) {
        m.vy = 5.2;
      }
      // Safety speed clamp (allows powerful explosive bounces off red bubbles and finale propeller before friction naturally slows them)
      const currentSpeed = Math.hypot(m.vx, m.vy);
      if (currentSpeed > 16.0) {
        m.vx = (m.vx / currentSpeed) * 16.0;
        m.vy = (m.vy / currentSpeed) * 16.0;
      }

      m.x += m.vx * timeScale;
      m.y += m.vy * timeScale;

      // Top Ceiling Enclosure Constraint: never allow marble to bounce off or escape top (y = 45)
      if (m.y < 45 + m.radius) {
        m.y = 45 + m.radius;
        if (m.vy < 0) m.vy = -m.vy * 0.35;
      }
      // Lateral Boundary Enclosure Constraint
      if (m.x < 20 + m.radius) {
        m.x = 20 + m.radius;
        if (m.vx < 0) m.vx = -m.vx * 0.35;
      } else if (m.x > COURSE_WIDTH - 20 - m.radius) {
        m.x = COURSE_WIDTH - 20 - m.radius;
        if (m.vx > 0) m.vx = -m.vx * 0.35;
      }

      // Finish line check
      if (!m.finished && m.y >= FINISH_LINE_Y) {
        m.finished = true;
        finishRankCounter++;
        m.finishRank = finishRankCounter;
        m.finishTime = (performance.now() - raceStartTime) / 1000;
        onMarbleFinished(m);
      }

      // Energy Gauge Passive Trickle: very slowly fill up over time even when not bounced, only AFTER passing Zone 4 (y >= 3080)
      if (energyGaugeEnabled && !m.finished && m.y >= 3080) {
        m.energy = Math.min(1.0, m.energy + 0.00035 * timeScale);
        if (m.energy >= 1.0) {
          triggerShockwave(m);
          m.energy = 0;
        }
      }
    });

    // Active Anti-Stuck Watchdog
    marbles.forEach(m => {
      if (m.finished) return;
      const speed = Math.hypot(m.vx, m.vy);
      const movedDist = Math.hypot(m.x - m.lastSampleX, m.y - m.lastSampleY);

      if (speed < 0.18 && movedDist < 5) {
        m.stuckTimer += 0.016 * timeScale;
        if (m.stuckTimer > 0.8) {
          // Gentle nudge: lateral jiggle + downward push (scaled 0.65x)
          m.vx += (Math.random() - 0.5) * 2.6;
          m.vy += 1.62 + Math.random() * 1.17;
          m.stuckTimer = 0.3; // keep moving if still caught
        }
        if (m.stuckTimer > 1.8) {
          // Emergency escape burst: shockwave only if passed Zone 4
          if (m.y >= 3080) triggerShockwave(m);
          m.vy += 3.12;
          m.vx += (m.x < COURSE_WIDTH / 2 ? 2.6 : -2.6);
          m.stuckTimer = 0;
        }
      } else {
        m.stuckTimer = 0;
        m.lastSampleX = m.x;
        m.lastSampleY = m.y;
      }
    });

    // 2. Marble vs Marble Collision
    for (let i = 0; i < marbles.length; i++) {
      for (let j = i + 1; j < marbles.length; j++) {
        const m1 = marbles[i];
        const m2 = marbles[j];
        const dx = m2.x - m1.x;
        const dy = m2.y - m1.y;
        const dist = Math.hypot(dx, dy);
        const minDist = m1.radius + m2.radius;

        if (dist < minDist && dist > 0.01) {
          const overlap = minDist - dist;
          const nx = dx / dist;
          const ny = dy / dist;

          m1.x -= nx * overlap * 0.5;
          m1.y -= ny * overlap * 0.5;
          m2.x += nx * overlap * 0.5;
          m2.y += ny * overlap * 0.5;

          const kx = m1.vx - m2.vx;
          const ky = m1.vy - m2.vy;
          const p = 2 * (nx * kx + ny * ky) / 2;

          m1.vx -= p * nx * bounce;
          m1.vy -= p * ny * bounce;
          m2.vx += p * nx * bounce;
          m2.vy += p * ny * bounce;

          // Controlled collision energy charging: only after passing Zone 4 (y >= 3080)
          if (energyGaugeEnabled) {
            if (m1.y >= 3080) {
              m1.energy = Math.min(1.0, m1.energy + 0.003);
              if (m1.energy >= 1.0) {
                triggerShockwave(m1);
                m1.energy = 0;
              }
            }
            if (m2.y >= 3080) {
              m2.energy = Math.min(1.0, m2.energy + 0.003);
              if (m2.energy >= 1.0) {
                triggerShockwave(m2);
                m2.energy = 0;
              }
            }
          }
        }
      }
    }

    // Top Enclosure & Boundary Enforcement after dense circle-circle collision resolutions
    marbles.forEach(m => {
      if (m.y < 45 + m.radius) {
        m.y = 45 + m.radius;
        if (m.vy < 0) m.vy = -m.vy * 0.35;
      }
      if (m.x < 20 + m.radius) {
        m.x = 20 + m.radius;
        if (m.vx < 0) m.vx = -m.vx * 0.35;
      } else if (m.x > COURSE_WIDTH - 20 - m.radius) {
        m.x = COURSE_WIDTH - 20 - m.radius;
        if (m.vx > 0) m.vx = -m.vx * 0.35;
      }
    });

    // 3. Marble vs Static Pins
    marbles.forEach(m => {
      pins.forEach(pin => {
        const dx = m.x - pin.x;
        const dy = m.y - pin.y;
        const dist = Math.hypot(dx, dy);
        const minDist = m.radius + pin.radius;

        if (dist < minDist && dist > 0.001) {
          const nx = dx / dist;
          const ny = dy / dist;
          const overlap = minDist - dist;

          m.x += nx * overlap;
          m.y += ny * overlap;

          // Reflect velocity
          const dot = m.vx * nx + m.vy * ny;
          if (dot < 0) {
            const reboundMultiplier = pin.isBumper ? 1.7 : 1.5;
            m.vx -= reboundMultiplier * dot * nx;
            m.vy -= reboundMultiplier * dot * ny;
            if (Math.random() < 0.2) sfx.playPop();

            // Energy charge from pin bounce (+0.025 to +0.04)
            if (energyGaugeEnabled) {
              m.energy = Math.min(1.0, m.energy + (pin.isBumper ? 0.04 : 0.025));
              if (m.energy >= 1.0) {
                triggerShockwave(m);
                m.energy = 0;
              }
            }
          }
        }
      });
    });

    // 4. Marble vs Rotating Spinners (Non-bouncy physical contact & rotational sweep)
    marbles.forEach(m => {
      spinners.forEach(sp => {
        const cos = Math.cos(sp.angle);
        const sin = Math.sin(sp.angle);
        const x1 = sp.x - cos * sp.length;
        const y1 = sp.y - sin * sp.length;
        const x2 = sp.x + cos * sp.length;
        const y2 = sp.y + sin * sp.length;

        const dist = distToSegment(m.x, m.y, x1, y1, x2, y2);
        const contactRadius = m.radius + 4;
        if (dist.d < contactRadius) {
          const nx = (m.x - dist.px) / (dist.d || 1);
          const ny = (m.y - dist.py) / (dist.d || 1);
          m.x = dist.px + nx * contactRadius;
          m.y = dist.py + ny * contactRadius;

          // Zero-bounce contact: remove normal velocity moving into the blade (restitution = 0)
          const dot = m.vx * nx + m.vy * ny;
          if (dot < 0) {
            m.vx -= dot * nx;
            m.vy -= dot * ny;
          }

          // Linear velocity of the blade at the exact contact point (dist.px, dist.py) (30% slower)
          const rx = dist.px - sp.x;
          const ry = dist.py - sp.y;
          const bladeVx = -sp.speed * 0.70 * 60 * ry;
          const bladeVy = sp.speed * 0.70 * 60 * rx;

          // Special Finale Gatekeeper Propeller: High-Power Upward Bat Mechanism
          if (sp.isFinaleKeeper) {
            // Blade is sweeping UPWARDS through the funnel throat!
            // Launch the caught marble vigorously BACK UP into the funnel with powerful impact!
            const upwardPower = Math.max(13.5, (sp.upwardBatPower || 14.8));
            m.vy = -Math.abs(upwardPower);
            m.vx = (nx >= 0 ? 1 : -1) * (6.5 + Math.random() * 4.5);
            m.y = Math.min(m.y, dist.py - contactRadius - 10);

            sfx.playBlast();
            sfx.playBumper();
            shockwaves.push({
              x: m.x,
              y: m.y,
              radius: 18,
              maxRadius: 110,
              color: '#ea580c',
              alpha: 1.0
            });
            return;
          } else {
            // Normal rotational sweep for standard spinners
            m.vx += bladeVx * 0.008;
            if (bladeVy < 0) {
              m.vy += bladeVy * 0.010; // Upward batting
            } else if (m.y < sp.y) {
              m.vy = Math.min(m.vy, -0.39 * timeScale); // Deflect up rather than pulling down when hit from above
            }

            const bladeNormalPush = (bladeVx * nx + bladeVy * ny) * 0.015;
            if (bladeNormalPush > 0) {
              m.vx += nx * bladeNormalPush;
              m.vy += ny * bladeNormalPush;
            }
          }

          m.vx *= 0.98;
          m.vy *= 0.98;

          // Energy charge (only after Zone 4, tiny increment)
          if (energyGaugeEnabled && m.y >= 3080) {
            m.energy = Math.min(1.0, m.energy + 0.005);
            if (m.energy >= 1.0) {
              triggerShockwave(m);
              m.energy = 0;
            }
          }
        }
      });
    });

    // 5. Marble vs Spring Bouncers (Controlled, Natural Elastic Rebound - Less Bouncy)
    marbles.forEach(m => {
      bouncers.forEach(bn => {
        const dx = m.x - bn.x;
        const dy = m.y - bn.y;
        const dist = Math.hypot(dx, dy);
        const minDist = m.radius + bn.radius;

        if (dist < minDist && dist > 0.001) {
          const nx = dx / dist;
          const ny = dy / dist;
          const overlap = minDist - dist;

          m.x += nx * overlap;
          m.y += ny * overlap;

          const isTurbo = bn.label === 'TURBO';
          if (isTurbo) {
            sfx.playPop();
            shockwaves.push({
              x: bn.x,
              y: bn.y,
              radius: bn.radius,
              maxRadius: 42,
              color: '#06b6d4',
              alpha: 0.9
            });

            // Lateral catapult launch across into the next chute (scaled 0.65x)
            m.vx += nx * 4.42;
            m.vy += Math.abs(ny) * 1.82 + 1.62;

            const turboSpeed = Math.hypot(m.vx, m.vy);
            if (turboSpeed > 5.85) {
              m.vx = (m.vx / turboSpeed) * 5.85;
              m.vy = (m.vy / turboSpeed) * 5.85;
            }
          } else {
            bn.lastHitTime = performance.now();
            sfx.playSpring();
            shockwaves.push({
              x: bn.x,
              y: bn.y,
              radius: bn.radius,
              maxRadius: bn.radius * 2.2,
              color: '#f43f5e',
              alpha: 1.0
            });

            // HIGH-POWER ELASTIC REBOUND (Powerful Red Spring Bubble)
            const dot = m.vx * nx + m.vy * ny;
            if (dot < 0) {
              const restitution = 1.75;
              m.vx -= (1 + restitution) * dot * nx;
              m.vy -= (1 + restitution) * dot * ny;
            } else {
              m.vx += nx * 3.2;
              m.vy += ny * 2.8;
            }

            // Strong explosive outward launch proportional to bouncer power
            const launchPower = Math.max(6.5, bn.power * 1.55);
            m.vx += nx * launchPower;
            m.vy += ny * launchPower;

            // Extra upward spring kick if marble impacts top half of the red bubble
            if (ny < -0.25) {
              m.vy -= Math.abs(ny) * 2.8;
            }

            // Generous bounce speed ceiling (up to 11.5 px/frame) so marbles visibly rocket off
            const bounceSpeed = Math.hypot(m.vx, m.vy);
            if (bounceSpeed > 11.5) {
              m.vx = (m.vx / bounceSpeed) * 11.5;
              m.vy = (m.vy / bounceSpeed) * 11.5;
            }
          }

          if (energyGaugeEnabled && m.y >= 3080) {
            m.energy = Math.min(1.0, m.energy + 0.02);
            if (m.energy >= 1.0) {
              triggerShockwave(m);
              m.energy = 0;
            }
          }
        }
      });
    });

    // 6. Marble vs Course Segments (Walls, Ramps, Guides, Hyper Boosters)
    marbles.forEach(m => {
      if (!isGateOpen) {
        const gateDist = distToSegment(m.x, m.y, 210, 220, 350, 220);
        if (gateDist.d < m.radius + 2) {
          m.y = 220 - m.radius - 2;
          m.vy = -m.vy * 0.4;
        }
      }

      // Secret Gate barrier removed: Lucky Hole is always open direct to finish line

      segments.forEach(seg => {
        const res = distToSegment(m.x, m.y, seg.x1, seg.y1, seg.x2, seg.y2);
        if (res.d < m.radius + 2) {
          const nx = (m.x - res.px) / (res.d || 1);
          const ny = (m.y - res.py) / (res.d || 1);
          m.x = res.px + nx * (m.radius + 2);
          m.y = res.py + ny * (m.radius + 2);

          const dot = m.vx * nx + m.vy * ny;
          if (dot < 0) {
            // Soft restitution on ramps and boosters so balls smoothly roll instead of bouncing back
            const restitution = (seg.type === 'ramp' || seg.type === 'booster' || seg.type === 'guide') ? 0.10 : 0.35;
            m.vx -= (1 + restitution) * dot * nx;
            m.vy -= (1 + restitution) * dot * ny;
          }

          // Speed Booster: Injects smooth, controlled forward glide along the chute
          if (seg.type === 'booster') {
            const segDx = seg.x2 - seg.x1;
            const segDy = seg.y2 - seg.y1;
            const segLen = Math.hypot(segDx, segDy) || 1;
            const tx = segDx / segLen;
            const ty = segDy / segLen;

            const boost = (seg.boostPower || 0.6) * 0.65;
            m.vx += tx * boost;
            m.vy += ty * boost;

            // Controlled, brisk forward glide (2.73 px/frame, capped at 3.58 px/frame - 35% slower)
            const forwardSpeed = m.vx * tx + m.vy * ty;
            if (forwardSpeed < 2.73) {
              m.vx = tx * 2.73;
              m.vy = ty * 2.73;
            } else if (forwardSpeed > 3.58) {
              m.vx = tx * 3.58;
              m.vy = ty * 3.58;
            }

            // Small subtle cyan spark particles
            if (Math.random() < 0.12) {
              shockwaves.push({
                x: m.x,
                y: m.y,
                radius: m.radius,
                maxRadius: 18,
                color: '#06b6d4',
                alpha: 0.45
              });
            }
          }
        }
      });
    });

    // 5-Second Last Runner Auto-Finish Timer:
    // If only 1 marble is left running, automatically end the race in 5 seconds without waiting for it to cross the finish line
    const active = marbles.filter(m => !m.finished);
    if (isRacing && marbles.length > 1 && active.length === 1) {
      const loneRunner = active[0];
      if (lastRunnerCountdown === null) {
        lastRunnerCountdown = 5.0;
      } else {
        lastRunnerCountdown -= 0.016 * timeScale;
      }

      if (lastRunnerCountdown <= 0) {
        lastRunnerCountdown = null;
        loneRunner.finished = true;
        finishRankCounter++;
        loneRunner.finishRank = finishRankCounter;
        loneRunner.finishTime = (performance.now() - raceStartTime) / 1000;
        onMarbleFinished(loneRunner);
      }
    } else {
      lastRunnerCountdown = null;
    }

    // Secret Gate & Cannon Alert Timers
    if (!secretGate.locked) {
      secretGate.unlockTimer -= 0.016 * timeScale;
      if (secretGate.unlockTimer <= 0) {
        secretGate.locked = true;
      }
    }
    if (cannonAlertTimer > 0) {
      cannonAlertTimer -= 0.016 * timeScale;
    }

    // Camera tracking
    updateCamera();

    // Check race completion
    const allFinished = marbles.every(m => m.finished);
    if (allFinished && isRacing) {
      isRacing = false;
      updateRaceButton();
      setTimeout(() => {
        showFinalResults();
      }, 700);
    }
  }

  function distToSegment(px: number, py: number, x1: number, y1: number, x2: number, y2: number) {
    const l2 = (x2 - x1) * (x2 - x1) + (y2 - y1) * (y2 - y1);
    if (l2 === 0) return { d: Math.hypot(px - x1, py - y1), px: x1, py: y1 };
    let t = ((px - x1) * (x2 - x1) + (py - y1) * (y2 - y1)) / l2;
    t = Math.max(0, Math.min(1, t));
    const projX = x1 + t * (x2 - x1);
    const projY = y1 + t * (y2 - y1);
    return { d: Math.hypot(px - projX, py - projY), px: projX, py: projY };
  }

  // Smart Camera: Shows focus on first runner until first runner passes the goal, then focuses dynamically!
  function updateCamera() {
    const viewH = canvas.height / zoom;
    let targetY = 0;

    const active = marbles.filter(m => !m.finished);

    if (!isManualCam) {
      if (active.length === 0) {
        // Everyone has finished: settle camera smoothly at the finish line / catch basin
        targetY = FINISH_LINE_Y - viewH * 0.42;
      } else if (camMode === 'auto') {
        // SMART AUTO CAMERA:
        // 1. Focus on the first runner until the first runner passes the finish line (finishRankCounter === 0)
        // 2. Once the first runner has passed the finish line, focus on the most populated area of remaining marbles!

        const lead = active.reduce((prev, cur) => (cur.y > prev.y ? cur : prev), active[0]);

        if (finishRankCounter === 0) {
          // STAGE 1: Follow the 1st runner down the entire course until finish line!
          targetY = lead.y - viewH * 0.38;
        } else {
          // STAGE 2: 1st runner finished -> Focus on the most populated area (densest cluster)
          let bestClusterY = lead.y;
          let maxCount = -1;
          const clusterSpan = viewH * 0.45;

          for (let i = 0; i < active.length; i++) {
            const centerM = active[i];
            let count = 0;
            let sumY = 0;
            for (let j = 0; j < active.length; j++) {
              const other = active[j];
              if (Math.abs(other.y - centerM.y) <= clusterSpan) {
                count++;
                sumY += other.y;
              }
            }
            if (count > maxCount) {
              maxCount = count;
              bestClusterY = sumY / count;
            }
          }

          targetY = bestClusterY - viewH * 0.40;
        }
      } else if (camMode === 'first') {
        // Explicitly focus foremost active runner
        const lead = active.reduce((prev, cur) => (cur.y > prev.y ? cur : prev), active[0]);
        targetY = lead.y - viewH * 0.38;
      } else if (camMode === 'last') {
        // Explicitly focus rearmost active runner
        const tail = active.reduce((prev, cur) => (cur.y < prev.y ? cur : prev), active[0]);
        targetY = tail.y - viewH * 0.42;
      } else if (camMode === 'runner' && focusedMarbleId !== null) {
        // Focus on a specific runner
        const target = marbles.find(m => m.id === focusedMarbleId);
        if (target) {
          targetY = target.y - viewH * 0.4;
        } else if (active.length > 0) {
          const lead = active.reduce((prev, cur) => (cur.y > prev.y ? cur : prev), active[0]);
          targetY = lead.y - viewH * 0.38;
        }
      }

      // Smooth camera lerp (30% slower tracking)
      targetY = Math.max(0, Math.min(COURSE_HEIGHT - viewH + 80, targetY));
      cameraY += (targetY - cameraY) * 0.060;
    } else {
      // Manual camera: strictly clamp bounds
      cameraY = Math.max(0, Math.min(COURSE_HEIGHT - viewH + 80, cameraY));
    }

    // Update live leader / status text
    if (active.length > 0) {
      if (lastRunnerCountdown !== null && active.length === 1) {
        const secsLeft = Math.max(1, Math.ceil(lastRunnerCountdown));
        if (leadNameElem) leadNameElem.textContent = isEn
          ? `⏱️ Last marble (${active[0].name})! ${secsLeft}s left`
          : `⏱️ 최후의 1명 (${active[0].name})! ${secsLeft}초 후 종료`;
      } else {
        const lead = active.reduce((prev, cur) => (cur.y > prev.y ? cur : prev), active[0]);
        const tail = active.reduce((prev, cur) => (cur.y < prev.y ? cur : prev), active[0]);

        if (camMode === 'auto') {
          if (finishRankCounter === 0) {
            if (leadNameElem) leadNameElem.textContent = isEn ? `Leader: ${lead.name}` : `선두: ${lead.name}`;
          } else {
            if (leadNameElem) leadNameElem.textContent = isEn ? `📍 Pack bunched (Lead: ${lead.name})` : `📍 메인 팩 밀집 (선두: ${lead.name})`;
          }
        } else if (camMode === 'first') {
          if (leadNameElem) leadNameElem.textContent = isEn ? `Leader: ${lead.name}` : `선두: ${lead.name}`;
        } else if (camMode === 'last') {
          if (leadNameElem) leadNameElem.textContent = isEn ? `💀 Last: ${tail.name}` : `💀 꼴찌: ${tail.name}`;
        } else if (camMode === 'runner' && focusedMarbleId !== null) {
          const target = marbles.find(m => m.id === focusedMarbleId);
          if (leadNameElem && target) leadNameElem.textContent = isEn ? `🎯 Tracking: ${target.name}` : `🎯 추적: ${target.name}`;
        }
      }
    } else {
      if (leadNameElem) leadNameElem.textContent = isEn ? '🏁 Race Finished!' : '🏁 레이스 종료!';
    }
  }

  function updateCamModeHUD() {
    document.querySelectorAll('.cam-btn').forEach(btn => {
      const mode = btn.getAttribute('data-cam');
      btn.classList.toggle('active', !isManualCam && camMode === mode);
    });

    if (camResumeBtn) {
      camResumeBtn.classList.toggle('hidden', !isManualCam);
    }
  }

  function onMarbleFinished(m: Marble) {
    sfx.playFinish();
    if (finishProgressElem) {
      finishProgressElem.textContent = isEn 
        ? `${finishRankCounter} / ${marbles.length} Finished` 
        : `${finishRankCounter} / ${marbles.length} 완주`;
    }

    if (finishListElem) {
      const emptyHint = finishListElem.querySelector('.finish-empty-hint');
      if (emptyHint) emptyHint.remove();

      const item = document.createElement('div');
      item.className = 'finish-item';
      item.style.cursor = 'pointer';
      item.title = isEn ? `Focus camera on ${m.name}` : `${m.name} 시점으로 카메라 이동`;
      item.innerHTML = `
        <span class="finish-rank">${isEn ? '#' + m.finishRank : m.finishRank + '위'}</span>
        <span class="finish-name"><span class="finish-color-dot" style="display:inline-block;width:9px;height:9px;border-radius:50%;background:${m.color};box-shadow:0 0 6px ${m.color};margin-right:6px;vertical-align:middle;"></span>${m.name}</span>
        <span class="finish-time">${m.finishTime.toFixed(2)}s</span>
      `;
      item.addEventListener('click', () => {
        focusedMarbleId = m.id;
        camMode = 'runner';
        isManualCam = false;
        updateCamModeHUD();
      });
      finishListElem.appendChild(item);
      finishListElem.scrollTop = finishListElem.scrollHeight;
    }
  }

  // Draw Course & Marbles with Zoom & Centered Track
  function render() {
    if (!ctx) return;
    ctx.clearRect(0, 0, canvas.width, canvas.height);

    ctx.save();
    // Apply zoom scale
    ctx.scale(zoom, zoom);
    // Center the 440px course within the zoomed canvas view
    const trackOffsetX = (canvas.width / zoom - COURSE_WIDTH) / 2;
    ctx.translate(trackOffsetX, -cameraY);

    // Subtle dashed track center-line
    ctx.save();
    ctx.strokeStyle = 'rgba(255, 255, 255, 0.04)';
    ctx.setLineDash([8, 12]);
    ctx.lineWidth = 1.5;
    ctx.beginPath();
    ctx.moveTo(COURSE_WIDTH / 2, 230);
    ctx.lineTo(COURSE_WIDTH / 2, FINISH_LINE_Y);
    ctx.stroke();
    ctx.restore();

    // Zone Background Markers
    (isEn ? ZONE_MARKERS_EN : ZONE_MARKERS).forEach(zm => {
      ctx.save();
      ctx.textAlign = 'center';
      ctx.font = '900 12px -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif';
      ctx.fillStyle = 'rgba(148, 163, 184, 0.22)';
      ctx.fillText(zm.title, COURSE_WIDTH / 2, zm.y);
      ctx.font = '700 9px -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif';
      ctx.fillStyle = 'rgba(148, 163, 184, 0.12)';
      ctx.fillText(zm.sub, COURSE_WIDTH / 2, zm.y + 13);
      ctx.restore();
    });

    // 1. Draw Course Walls & Ramps
    segments.forEach(seg => {
      ctx.beginPath();
      ctx.moveTo(seg.x1, seg.y1);
      ctx.lineTo(seg.x2, seg.y2);
      ctx.lineCap = 'round';

      if (seg.type === 'booster') {
        ctx.strokeStyle = '#06b6d4';
        ctx.lineWidth = 6;
        ctx.shadowColor = '#22d3ee';
        ctx.shadowBlur = 10;
        ctx.stroke();

        ctx.strokeStyle = '#cffafe';
        ctx.lineWidth = 2.5;
        ctx.shadowBlur = 0;
        ctx.stroke();

        // Draw animated moving chevrons along booster pad
        const segDx = seg.x2 - seg.x1;
        const segDy = seg.y2 - seg.y1;
        const segLen = Math.hypot(segDx, segDy);
        if (segLen > 40) {
          const tx = segDx / segLen;
          const ty = segDy / segLen;
          const numChevrons = Math.floor(segLen / 36);
          const animOffset = (Date.now() * 0.08) % 36;
          ctx.save();
          ctx.fillStyle = '#ffffff';
          ctx.font = '900 10px sans-serif';
          ctx.textAlign = 'center';
          ctx.textBaseline = 'middle';
          for (let i = 0; i < numChevrons; i++) {
            const dist = (i * 36 + animOffset) % segLen;
            const cx = seg.x1 + tx * dist;
            const cy = seg.y1 + ty * dist - 8;
            ctx.save();
            ctx.translate(cx, cy);
            ctx.rotate(Math.atan2(ty, tx));
            ctx.fillText('⏩', 0, 0);
            ctx.restore();
          }
          ctx.restore();
        }
      } else if (seg.type === 'ramp') {
        ctx.strokeStyle = '#38bdf8';
        ctx.lineWidth = 4.5;
        ctx.shadowColor = 'rgba(56, 189, 248, 0.35)';
        ctx.shadowBlur = 6;
        ctx.stroke();
        ctx.shadowBlur = 0;
      } else if (seg.type === 'guide') {
        ctx.strokeStyle = '#64748b';
        ctx.lineWidth = 3;
        ctx.stroke();
      } else {
        ctx.strokeStyle = '#334155';
        ctx.lineWidth = 4;
        ctx.stroke();
      }
    });

    // Hopper starting gate (140px wide opening across 210px - 350px)
    if (!isGateOpen) {
      ctx.strokeStyle = '#ef4444';
      ctx.lineWidth = 6;
      ctx.beginPath();
      ctx.moveTo(210, 220);
      ctx.lineTo(350, 220);
      ctx.stroke();
    }

    // Top Enclosure Roof Barrier Rendering (Glowing Enclosed Ceiling)
    ctx.save();
    ctx.strokeStyle = '#0284c7';
    ctx.lineWidth = 8;
    ctx.lineCap = 'round';
    ctx.shadowColor = 'rgba(56, 189, 248, 0.7)';
    ctx.shadowBlur = 10;
    ctx.beginPath();
    ctx.moveTo(18, 45);
    ctx.lineTo(COURSE_WIDTH - 18, 45);
    ctx.stroke();

    ctx.strokeStyle = '#38bdf8';
    ctx.lineWidth = 3;
    ctx.beginPath();
    ctx.moveTo(20, 45);
    ctx.lineTo(COURSE_WIDTH - 20, 45);
    ctx.stroke();

    ctx.textAlign = 'center';
    ctx.font = '800 10px -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif';
    ctx.fillStyle = 'rgba(186, 230, 253, 0.75)';
    ctx.shadowBlur = 0;
    ctx.fillText(isEn ? '⚡ UPPER BOUNDARY LOOP ⚡' : '⚡ 상단 이탈 방지 루프 ⚡', COURSE_WIDTH / 2, 38);
    ctx.restore();

    // 2. Draw Pins (Plinko & Neon Bumpers)
    pins.forEach(p => {
      ctx.beginPath();
      ctx.arc(p.x, p.y, p.radius, 0, Math.PI * 2);

      if (p.isBumper) {
        ctx.fillStyle = '#a855f7';
        ctx.shadowColor = '#c084fc';
        ctx.shadowBlur = 8;
        ctx.fill();
        ctx.shadowBlur = 0;
        ctx.strokeStyle = '#f3e8ff';
        ctx.lineWidth = 2;
        ctx.stroke();
      } else {
        ctx.fillStyle = '#64748b';
        ctx.shadowColor = '#38bdf8';
        ctx.shadowBlur = 5;
        ctx.fill();
        ctx.shadowBlur = 0;
        ctx.strokeStyle = '#94a3b8';
        ctx.lineWidth = 1.5;
        ctx.stroke();
      }
    });

    // 3. Draw Spinners (including Giant Finish Propeller)
    spinners.forEach(sp => {
      ctx.save();
      ctx.translate(sp.x, sp.y);
      ctx.rotate(sp.angle);

      const isKeeper = sp.isFinaleKeeper;
      const isGiant = sp.length >= 130;
      const bladeH = isKeeper ? 14 : (isGiant ? 15 : 12);

      if (isKeeper) {
        // High-stakes crimson/amber hazard styling for the reverse bat propeller
        ctx.fillStyle = '#dc2626';
        ctx.shadowColor = '#f97316';
        ctx.shadowBlur = 16;
        ctx.beginPath();
        ctx.roundRect(-sp.length, -bladeH / 2, sp.length * 2, bladeH, 6);
        ctx.fill();
        ctx.shadowBlur = 0;

        // Diagonal hazard stripes along the blades
        ctx.fillStyle = '#fef08a';
        for (let s = -sp.length + 12; s < sp.length - 12; s += 22) {
          ctx.fillRect(s, -bladeH / 2 + 2, 7, bladeH - 4);
        }

        // Blade tip beacons
        ctx.fillStyle = '#facc15';
        ctx.beginPath();
        ctx.arc(-sp.length + 6, 0, 4, 0, Math.PI * 2);
        ctx.arc(sp.length - 6, 0, 4, 0, Math.PI * 2);
        ctx.fill();

        // Metallic Center Hub with anticlockwise symbol
        ctx.beginPath();
        ctx.arc(0, 0, 10, 0, Math.PI * 2);
        ctx.fillStyle = '#1e293b';
        ctx.fill();
        ctx.strokeStyle = '#f97316';
        ctx.lineWidth = 3;
        ctx.stroke();

        ctx.fillStyle = '#facc15';
        ctx.font = '900 9px sans-serif';
        ctx.textAlign = 'center';
        ctx.textBaseline = 'middle';
        ctx.fillText('↺', 0, 0);
      } else {
        ctx.fillStyle = isGiant ? '#ea580c' : '#f59e0b';
        ctx.shadowColor = isGiant ? '#f97316' : '#f59e0b';
        ctx.shadowBlur = isGiant ? 16 : 10;
        ctx.beginPath();
        ctx.roundRect(-sp.length, -bladeH / 2, sp.length * 2, bladeH, 6);
        ctx.fill();
        ctx.shadowBlur = 0;

        // Glowing tip indicators
        ctx.fillStyle = '#fef08a';
        ctx.beginPath();
        ctx.arc(-sp.length + 6, 0, isGiant ? 4.5 : 3, 0, Math.PI * 2);
        ctx.arc(sp.length - 6, 0, isGiant ? 4.5 : 3, 0, Math.PI * 2);
        ctx.fill();

        // Center Hub
        ctx.beginPath();
        ctx.arc(0, 0, isGiant ? 10 : 8, 0, Math.PI * 2);
        ctx.fillStyle = '#ffffff';
        ctx.fill();
        ctx.strokeStyle = isGiant ? '#c2410c' : '#d97706';
        ctx.lineWidth = 2.5;
        ctx.stroke();
      }

      ctx.restore();
    });

    // 4. Draw Spring Bouncers & Turbo Kickers
    const timeNow = Date.now();
    bouncers.forEach(bn => {
      ctx.save();
      const isTurbo = bn.label === 'TURBO';
      const hitElapsed = bn.lastHitTime ? (timeNow - bn.lastHitTime) : 9999;
      const hitPop = hitElapsed < 240 ? Math.sin((hitElapsed / 240) * Math.PI) * 7 : 0;
      const pulse = Math.sin(timeNow * 0.0056 + bn.y * 0.1) * 3 + hitPop;

      ctx.beginPath();
      ctx.arc(bn.x, bn.y, bn.radius + pulse + 3, 0, Math.PI * 2);
      ctx.strokeStyle = isTurbo ? 'rgba(6, 182, 212, 0.5)' : (hitPop > 0 ? 'rgba(255, 255, 255, 0.9)' : 'rgba(244, 63, 94, 0.45)');
      ctx.lineWidth = hitPop > 0 ? 3.5 : 2;
      ctx.stroke();

      ctx.beginPath();
      ctx.arc(bn.x, bn.y, bn.radius + hitPop * 0.5, 0, Math.PI * 2);
      const grad = ctx.createRadialGradient(bn.x - 4, bn.y - 4, 2, bn.x, bn.y, bn.radius + hitPop);
      if (isTurbo) {
        grad.addColorStop(0, '#cffafe');
        grad.addColorStop(0.4, '#06b6d4');
        grad.addColorStop(1, '#0e7490');
        ctx.fillStyle = grad;
        ctx.shadowColor = '#06b6d4';
      } else {
        grad.addColorStop(0, hitPop > 0 ? '#ffffff' : '#fecdd3');
        grad.addColorStop(0.4, hitPop > 0 ? '#ff1e56' : '#f43f5e');
        grad.addColorStop(1, '#881337');
        ctx.fillStyle = grad;
        ctx.shadowColor = hitPop > 0 ? '#ff0055' : '#f43f5e';
      }
      ctx.shadowBlur = hitPop > 0 ? 28 : 14;
      ctx.fill();
      ctx.shadowBlur = 0;
      ctx.strokeStyle = hitPop > 0 ? '#fef08a' : '#ffffff';
      ctx.lineWidth = hitPop > 0 ? 3 : 2;
      ctx.stroke();

      ctx.fillStyle = '#ffffff';
      ctx.font = '900 11px -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif';
      ctx.textAlign = 'center';
      ctx.textBaseline = 'middle';
      ctx.fillText(isTurbo ? '⚡' : '⚡', bn.x, bn.y);
      ctx.restore();
    });

    // 4.5 Draw Final Zone: 1 Giant Funnel, Giant Reverse Keeper Propeller, and Lucky Side Hole
    ctx.save();

    // A. Lucky Side Hole & Chute (x: 475 to 540, y: 7060 to 7730)
    // Ambient lane fill
    ctx.fillStyle = 'rgba(6, 182, 212, 0.12)';
    ctx.fillRect(475, 7060, 65, 670);

    // Glowing Divider Wall at x=475
    ctx.strokeStyle = '#06b6d4';
    ctx.lineWidth = 3.5;
    ctx.shadowColor = '#06b6d4';
    ctx.shadowBlur = 10;
    ctx.beginPath();
    ctx.moveTo(475, 7120);
    ctx.lineTo(475, 7710);
    ctx.stroke();

    // Lucky Hole Mouth Target Ring at y: 7085
    ctx.beginPath();
    ctx.arc(507, 7085, 20, 0, Math.PI * 2);
    ctx.fillStyle = 'rgba(6, 182, 212, 0.28)';
    ctx.strokeStyle = '#22d3ee';
    ctx.lineWidth = 2.5;
    ctx.shadowBlur = 12;
    ctx.fill();
    ctx.stroke();
    ctx.shadowBlur = 0;

    // Lucky Chute Labels & Chevrons
    ctx.font = '900 11px -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif';
    ctx.fillStyle = '#67e8f9';
    ctx.textAlign = 'center';
    ctx.textBaseline = 'middle';
    ctx.fillText(isEn ? '★ LUCKY HOLE ★' : '★ 럭키 홀 ★', 507, 7085);
    ctx.font = '800 9px sans-serif';
    ctx.fillText(isEn ? 'Lucky Chute' : '행운의 홀', 507, 7140);
    ctx.fillText(isEn ? '⚡ DIRECT ⚡' : '⚡ 직행 ⚡', 507, 7260);
    ctx.fillText('⬇ ⬇ ⬇', 507, 7380);
    ctx.fillText(isEn ? '⚡ BOOST ⚡' : '⚡ 가속 ⚡', 507, 7500);
    ctx.fillText('⬇ ⬇ ⬇', 507, 7620);

    // B. Main Final Funnel (y: 7060 to 7360)
    ctx.strokeStyle = '#f59e0b';
    ctx.lineWidth = 3.5;
    ctx.shadowColor = '#f59e0b';
    ctx.shadowBlur = 10;
    ctx.beginPath();
    ctx.moveTo(20, 7060);
    ctx.lineTo(210, 7360);
    ctx.moveTo(475, 7120);
    ctx.lineTo(310, 7360);
    ctx.stroke();
    ctx.shadowBlur = 0;

    // Funnel Entrance Label
    ctx.font = '900 11px -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif';
    ctx.fillStyle = '#fbbf24';
    ctx.textAlign = 'center';
    ctx.fillText(isEn ? '⚡ FINALE FUNNEL ⚡' : '⚡ 최종 깔때기 (파이널 퍼널) ⚡', 260, 7180);

    // C. Central Throat & Giant Keeper Propeller (y: 7360 to 7700)
    ctx.strokeStyle = '#f97316';
    ctx.lineWidth = 3;
    ctx.beginPath();
    ctx.moveTo(310, 7360);
    ctx.lineTo(310, 7680);
    ctx.moveTo(210, 7520);
    ctx.lineTo(210, 7680);
    ctx.stroke();

    // Propeller Upward Bat Badge
    ctx.font = '900 10px -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif';
    ctx.fillStyle = '#fed7aa';
    ctx.textAlign = 'center';
    ctx.fillText(isEn ? '↺ GIANT REVERSE PROPELLER' : '↺ 자이언트 리버스 프로펠러 (역회전)', 260, 7430);
    ctx.font = '800 8.5px sans-serif';
    ctx.fillStyle = '#fdba74';
    ctx.fillText(isEn ? '(Knocks marbles up — time your pass)' : '(구슬을 위로 쳐올림 - 타이밍 통과)', 260, 7445);
    ctx.restore();

    // 5. Finish Line Banner
    ctx.save();
    ctx.fillStyle = 'rgba(250, 204, 21, 0.15)';
    ctx.fillRect(20, FINISH_LINE_Y - 15, COURSE_WIDTH - 40, 30);
    const squareSize = 15;
    for (let x = 20; x < COURSE_WIDTH - 20; x += squareSize * 2) {
      ctx.fillStyle = '#ffffff';
      ctx.fillRect(x, FINISH_LINE_Y - 15, squareSize, 15);
      ctx.fillRect(x + squareSize, FINISH_LINE_Y, squareSize, 15);
      ctx.fillStyle = '#020617';
      ctx.fillRect(x + squareSize, FINISH_LINE_Y - 15, squareSize, 15);
      ctx.fillRect(x, FINISH_LINE_Y, squareSize, 15);
    }
    ctx.font = '900 12px sans-serif';
    ctx.fillStyle = '#facc15';
    ctx.fillText(isEn ? '🏁 FINISH LINE' : '🏁 결승선 (FINISH LINE)', COURSE_WIDTH / 2 - 60, FINISH_LINE_Y - 22);
    ctx.restore();

    // 6. Draw Shockwaves (3x Stronger Visual Blast with Double Neon Ripple)
    shockwaves.forEach(sw => {
      ctx.save();
      ctx.beginPath();
      ctx.arc(sw.x, sw.y, sw.radius, 0, Math.PI * 2);
      ctx.strokeStyle = sw.color;
      ctx.globalAlpha = Math.max(0, sw.alpha);
      ctx.lineWidth = 5.0;
      ctx.shadowColor = sw.color;
      ctx.shadowBlur = 20;
      ctx.stroke();

      // Outer secondary ripple
      if (sw.radius > 20) {
        ctx.beginPath();
        ctx.arc(sw.x, sw.y, sw.radius * 0.75, 0, Math.PI * 2);
        ctx.strokeStyle = '#ffffff';
        ctx.globalAlpha = Math.max(0, sw.alpha * 0.6);
        ctx.lineWidth = 2.5;
        ctx.stroke();
      }
      ctx.restore();
    });

    // 7. Draw Marbles
    marbles.forEach(m => {
      ctx.save();

      // Focus spotlight ring if selected
      if (focusedMarbleId === m.id) {
        ctx.beginPath();
        ctx.arc(m.x, m.y, m.radius + 7, 0, Math.PI * 2);
        ctx.strokeStyle = '#facc15';
        ctx.lineWidth = 2;
        ctx.shadowColor = '#facc15';
        ctx.shadowBlur = 10;
        ctx.stroke();
        ctx.shadowBlur = 0;
      }

      // Energy Gauge Arc around marble
      if (energyGaugeEnabled && !m.finished && m.energy > 0.03) {
        ctx.beginPath();
        const startAngle = -Math.PI / 2;
        const endAngle = startAngle + (Math.PI * 2 * m.energy);
        ctx.arc(m.x, m.y, m.radius + 4.5, startAngle, endAngle);
        const isNearFull = m.energy >= 0.85;
        ctx.strokeStyle = isNearFull ? '#ef4444' : '#f59e0b';
        ctx.lineWidth = 2.5;
        ctx.shadowColor = ctx.strokeStyle;
        ctx.shadowBlur = isNearFull ? 8 : 4;
        ctx.stroke();
        ctx.shadowBlur = 0;
      }

      // Outer sphere
      ctx.beginPath();
      ctx.arc(m.x, m.y, m.radius, 0, Math.PI * 2);
      ctx.fillStyle = m.color;
      ctx.shadowColor = m.color;
      ctx.shadowBlur = 12;
      ctx.fill();
      ctx.shadowBlur = 0;
      ctx.strokeStyle = 'rgba(255, 255, 255, 0.85)';
      ctx.lineWidth = 1.5;
      ctx.stroke();

      // Specular shine highlight
      ctx.beginPath();
      ctx.arc(m.x - m.radius * 0.3, m.y - m.radius * 0.3, m.radius * 0.25, 0, Math.PI * 2);
      ctx.fillStyle = 'rgba(255, 255, 255, 0.7)';
      ctx.fill();

      // Name label tag
      ctx.font = '800 10px -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif';
      ctx.textAlign = 'center';
      ctx.textBaseline = 'bottom';
      ctx.fillStyle = '#f8fafc';
      ctx.shadowColor = '#000000';
      ctx.shadowBlur = 4;
      ctx.fillText(m.name, m.x, m.y - m.radius - 4);
      ctx.restore();
    });

    ctx.restore();

    // Screen-space Last Runner Auto-Finish Countdown Badge
    if (isRacing && lastRunnerCountdown !== null && lastRunnerCountdown > 0) {
      const active = marbles.filter(m => !m.finished);
      if (active.length === 1) {
        ctx.save();
        const secs = Math.max(1, Math.ceil(lastRunnerCountdown));
        const msg = isEn ? `⏱️ Last marble (${active[0].name}) locked! Race ends in ${secs}s` : `⏱️ 최후의 1명 (${active[0].name}) 확정! ${secs}초 후 레이스 종료`;
        ctx.font = '900 13px -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif';
        const tw = ctx.measureText(msg).width;
        const bw = tw + 36;
        const bh = 32;
        const bx = (canvas.width - bw) / 2;
        const by = 16;

        ctx.fillStyle = 'rgba(15, 23, 42, 0.9)';
        ctx.strokeStyle = '#f59e0b';
        ctx.lineWidth = 1.8;
        ctx.shadowColor = '#f59e0b';
        ctx.shadowBlur = 12;
        ctx.beginPath();
        if (typeof ctx.roundRect === 'function') {
          ctx.roundRect(bx, by, bw, bh, 16);
        } else {
          ctx.rect(bx, by, bw, bh);
        }
        ctx.fill();
        ctx.stroke();

        ctx.shadowBlur = 0;
        ctx.fillStyle = '#fde68a';
        ctx.textAlign = 'center';
        ctx.textBaseline = 'middle';
        ctx.fillText(msg, canvas.width / 2, by + bh / 2);
        ctx.restore();
      }
    }

    // Screen-space Lucky Cannon Unlocked Toast Alert
    if (cannonAlertTimer > 0) {
      ctx.save();
      const msg = isEn ? '⚡ Secret Lucky Cannon Tunnel Opened! ⏩' : '⚡ 행운의 비밀 캐논 터널 개방! ⏩';
      ctx.font = '900 13px -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif';
      const tw = ctx.measureText(msg).width;
      const bw = tw + 36;
      const bh = 32;
      const bx = (canvas.width - bw) / 2;
      const by = (isRacing && lastRunnerCountdown !== null && lastRunnerCountdown > 0) ? 54 : 16;

      ctx.fillStyle = 'rgba(8, 51, 68, 0.92)';
      ctx.strokeStyle = '#06b6d4';
      ctx.lineWidth = 2;
      ctx.shadowColor = '#06b6d4';
      ctx.shadowBlur = 14;
      ctx.beginPath();
      if (typeof ctx.roundRect === 'function') {
        ctx.roundRect(bx, by, bw, bh, 16);
      } else {
        ctx.rect(bx, by, bw, bh);
      }
      ctx.fill();
      ctx.stroke();

      ctx.shadowBlur = 0;
      ctx.fillStyle = '#cffafe';
      ctx.textAlign = 'center';
      ctx.textBaseline = 'middle';
      ctx.fillText(msg, canvas.width / 2, by + bh / 2);
      ctx.restore();
    }

    // Update oscillating pins (Zone 8 & Zone 9 neon bubbles - 30% slower oscillation)
    const animNow = performance.now();
    pins.forEach(p => {
      if (p.baseX !== undefined && p.oscAmp) {
        p.x = p.baseX + Math.sin(animNow * (p.oscSpeed || 0.0018) * 0.70 + (p.oscPhase || 0)) * p.oscAmp;
      }
    });

    // Render Minimap
    renderMinimap();

    try {
      updatePhysics(1);
    } catch (err) {
      console.error('[MarbleRoulette] Physics error:', err);
    }
    updateCamera();
    requestAnimationFrame(render);
  }

  function renderMinimap() {
    if (!miniCtx) return;
    miniCtx.clearRect(0, 0, minimapCanvas.width, minimapCanvas.height);

    const scaleY = minimapCanvas.height / COURSE_HEIGHT;
    const scaleX = minimapCanvas.width / COURSE_WIDTH;

    // 1. Zone boundary divider lines
    miniCtx.fillStyle = 'rgba(255, 255, 255, 0.07)';
    ZONE_MARKERS.forEach(zm => {
      miniCtx.fillRect(0, zm.y * scaleY, minimapCanvas.width, 1);
    });

    // 2. Course Walls, Ramps, Guides & Hyper Boosters
    segments.forEach(seg => {
      miniCtx.beginPath();
      miniCtx.moveTo(seg.x1 * scaleX, seg.y1 * scaleY);
      miniCtx.lineTo(seg.x2 * scaleX, seg.y2 * scaleY);
      if (seg.type === 'booster') {
        miniCtx.strokeStyle = '#06b6d4';
        miniCtx.lineWidth = 2.4;
      } else if (seg.type === 'ramp') {
        miniCtx.strokeStyle = '#38bdf8';
        miniCtx.lineWidth = 1.5;
      } else if (seg.type === 'guide') {
        miniCtx.strokeStyle = '#64748b';
        miniCtx.lineWidth = 1.1;
      } else {
        miniCtx.strokeStyle = 'rgba(255, 255, 255, 0.48)';
        miniCtx.lineWidth = 1.4;
      }
      miniCtx.stroke();
    });

    // Top Enclosure Roof & Starting Gate
    miniCtx.fillStyle = '#0284c7';
    miniCtx.fillRect(20 * scaleX, 45 * scaleY, (COURSE_WIDTH - 40) * scaleX, 2);
    if (!isGateOpen) {
      miniCtx.fillStyle = '#ef4444';
      miniCtx.fillRect(210 * scaleX, 220 * scaleY, 140 * scaleX, 2);
    }

    // 3. Static Pins & Neon Bumpers (Galton lattice, splitter pin, bumper wave field)
    pins.forEach(pin => {
      miniCtx.beginPath();
      miniCtx.arc(pin.x * scaleX, pin.y * scaleY, pin.isBumper ? 1.8 : 1.1, 0, Math.PI * 2);
      miniCtx.fillStyle = pin.isBumper ? '#c084fc' : 'rgba(148, 163, 184, 0.75)';
      miniCtx.fill();
    });

    // 4. Spring Bouncers & Kickbacks (Sized proportionally to radius)
    bouncers.forEach(bn => {
      miniCtx.beginPath();
      const bRad = Math.max(2.2, bn.radius * scaleX * 0.95);
      miniCtx.arc(bn.x * scaleX, bn.y * scaleY, bRad, 0, Math.PI * 2);
      miniCtx.fillStyle = '#f43f5e';
      miniCtx.fill();
      miniCtx.strokeStyle = '#fda4af';
      miniCtx.lineWidth = 0.6;
      miniCtx.stroke();
    });

    // 5. Rotating Spinners / Propellers (Drawing actual spinning blades)
    spinners.forEach(sp => {
      const cos = Math.cos(sp.angle);
      const sin = Math.sin(sp.angle);
      const isGiant = sp.length >= 130;

      miniCtx.beginPath();
      miniCtx.moveTo((sp.x - cos * sp.length) * scaleX, (sp.y - sin * sp.length) * scaleY);
      miniCtx.lineTo((sp.x + cos * sp.length) * scaleX, (sp.y + sin * sp.length) * scaleY);
      miniCtx.strokeStyle = isGiant ? '#ea580c' : '#f59e0b';
      miniCtx.lineWidth = isGiant ? 2.8 : 1.8;
      miniCtx.stroke();

      // Hub center dot
      miniCtx.beginPath();
      miniCtx.arc(sp.x * scaleX, sp.y * scaleY, isGiant ? 2.2 : 1.4, 0, Math.PI * 2);
      miniCtx.fillStyle = '#ffffff';
      miniCtx.fill();
    });

    // 6. Finish line indicator
    miniCtx.fillStyle = '#facc15';
    miniCtx.fillRect(0, FINISH_LINE_Y * scaleY, minimapCanvas.width, 3);

    // 7. Camera viewport box (scaled according to zoom)
    const viewH = canvas.height / zoom;
    miniCtx.strokeStyle = isManualCam ? 'rgba(250, 204, 21, 0.95)' : 'rgba(56, 189, 248, 0.95)';
    miniCtx.lineWidth = 1.6;
    miniCtx.strokeRect(0, cameraY * scaleY, minimapCanvas.width, viewH * scaleY);
    miniCtx.fillStyle = isManualCam ? 'rgba(250, 204, 21, 0.12)' : 'rgba(56, 189, 248, 0.12)';
    miniCtx.fillRect(0, cameraY * scaleY, minimapCanvas.width, viewH * scaleY);

    // 8. Marbles dots with high-contrast outlines
    marbles.forEach(m => {
      miniCtx.beginPath();
      miniCtx.arc(m.x * scaleX, m.y * scaleY, 3.0, 0, Math.PI * 2);
      miniCtx.fillStyle = m.color;
      miniCtx.fill();
      miniCtx.strokeStyle = '#ffffff';
      miniCtx.lineWidth = 0.8;
      miniCtx.stroke();
    });
  }

  // Show Final Results
  function showFinalResults() {
    if (!resultModal) return;

    const sorted = [...marbles].sort((a, b) => a.finishRank - b.finishRank);
    let winners: Marble[] = [];
    let spotlightTitle = '최종 결과';
    let badgeText = '당첨';

    if (winnerMode === 'first') {
      winners = [sorted[0]];
      spotlightTitle = isEn ? '🏆 1st Place Winner!' : '🏆 1등 우승 축하드립니다!';
      badgeText = isEn ? '🥇 1st Place' : '🥇 1등 당첨';
    } else if (winnerMode === 'last') {
      winners = [sorted[sorted.length - 1]];
      spotlightTitle = isEn ? '💀 Last Place Loser / Penalty!' : '💀 꼴찌 당첨! (벌칙/당번)';
      badgeText = isEn ? 'Last Place' : '꼴찌 당첨';
    } else if (winnerMode === 'multi') {
      const count = Math.min(sorted.length, Math.max(1, parseInt(multiCountInput.value, 10) || 3));
      winners = sorted.slice(0, count);
      spotlightTitle = isEn ? `🏆 Top ${count} Winners!` : `🏆 상위 ${count}명 당첨!`;
      badgeText = isEn ? 'Top Winners' : '다중 당첨';
    } else if (winnerMode === 'custom') {
      const targetRank = Math.min(sorted.length, Math.max(1, parseInt(customRankInput.value, 10) || 7));
      winners = [sorted[targetRank - 1]];
      spotlightTitle = isEn ? `🎯 Lucky #${targetRank} Winner!` : `🎯 행운의 ${targetRank}등 당첨!`;
      badgeText = isEn ? `#${targetRank} Finisher` : `${targetRank}등 당첨`;
    }

    if (modalWinnerTitle) modalWinnerTitle.textContent = spotlightTitle;
    if (spotlightBadge) spotlightBadge.textContent = badgeText;
    if (spotlightName) spotlightName.textContent = winners.map(w => w.name).join(', ');
    if (spotlightSub) {
      if (isEn) {
        spotlightSub.textContent = winnerMode === 'last' 
          ? 'Time to buy coffee/dinner or take the penalty! ☕🍕' 
          : 'Congratulations! You are the lucky winner!';
      } else {
        spotlightSub.textContent = winnerMode === 'last' 
          ? '치킨 또는 커피를 쏘실 시간입니다! ☕🍗' 
          : '축하합니다! 행운의 당첨자로 선정되셨습니다!';
      }
    }

    if (modalRanksScroll) {
      modalRanksScroll.innerHTML = sorted.map((m, idx) => {
        const isWinner = winners.some(w => w.id === m.id);
        const medal = idx === 0 ? '🥇' : idx === 1 ? '🥈' : idx === 2 ? '🥉' : (isEn ? '#' + (idx + 1) : `${idx + 1}위`);
        return `
          <div class="finish-item" style="${isWinner ? 'border: 1px solid #facc15; background: rgba(250, 204, 21, 0.15);' : ''}">
            <span class="finish-rank">${medal}</span>
            <span class="finish-name"><span class="finish-color-dot" style="display:inline-block;width:9px;height:9px;border-radius:50%;background:${m.color};box-shadow:0 0 6px ${m.color};margin-right:6px;vertical-align:middle;"></span>${m.name} ${isWinner ? '👑' : ''}</span>
            <span class="finish-time">${m.finishTime.toFixed(2)}s</span>
          </div>
        `;
      }).join('');
    }

    resultModal.classList.remove('hidden');
  }

  // --- Manual View Dragging & Minimap Navigation ---
  let isDragging = false;
  let dragStartY = 0;
  let dragStartCamY = 0;
  let totalDragDistance = 0;

  function onDragStart(clientY: number) {
    isDragging = true;
    dragStartY = clientY;
    dragStartCamY = cameraY;
    totalDragDistance = 0;
    canvasViewport?.classList.add('is-dragging');
  }

  function onDragMove(clientY: number) {
    if (!isDragging) return;
    const dy = (clientY - dragStartY) / zoom;
    totalDragDistance += Math.abs(clientY - dragStartY);
    dragStartY = clientY;
    const viewH = canvas.height / zoom;
    cameraY = Math.max(0, Math.min(COURSE_HEIGHT - viewH + 80, cameraY - dy));
    if (totalDragDistance > 6) {
      isManualCam = true;
      updateCamModeHUD();
    }
  }

  function onDragEnd() {
    isDragging = false;
    canvasViewport?.classList.remove('is-dragging');
  }

  // Canvas Mouse Drag
  canvas?.addEventListener('mousedown', (e) => {
    if (e.button !== 0) return;
    onDragStart(e.clientY);
  });

  window.addEventListener('mousemove', (e) => {
    if (isDragging) onDragMove(e.clientY);
  });

  window.addEventListener('mouseup', () => {
    if (isDragging) onDragEnd();
  });

  // Canvas Touch Drag
  canvas?.addEventListener('touchstart', (e) => {
    if (e.touches.length === 1) {
      onDragStart(e.touches[0].clientY);
    }
  }, { passive: true });

  canvas?.addEventListener('touchmove', (e) => {
    if (isDragging && e.touches.length === 1) {
      onDragMove(e.touches[0].clientY);
    }
  }, { passive: true });

  canvas?.addEventListener('touchend', () => {
    if (isDragging) onDragEnd();
  });

  // Canvas Wheel Scroll
  canvasViewport?.addEventListener('wheel', (e) => {
    e.preventDefault();
    const viewH = canvas.height / zoom;
    cameraY = Math.max(0, Math.min(COURSE_HEIGHT - viewH + 80, cameraY + e.deltaY * 0.9));
    isManualCam = true;
    updateCamModeHUD();
  }, { passive: false });

  // Minimap Click & Drag to Pan
  let isMinimapDragging = false;
  function handleMinimapEvent(clientY: number) {
    const rect = minimapCanvas.getBoundingClientRect();
    const relY = Math.max(0, Math.min(rect.height, clientY - rect.top));
    const courseY = (relY / rect.height) * COURSE_HEIGHT;
    const viewH = canvas.height / zoom;
    cameraY = Math.max(0, Math.min(COURSE_HEIGHT - viewH + 80, courseY - viewH / 2));
    isManualCam = true;
    updateCamModeHUD();
  }

  minimapCanvas?.addEventListener('mousedown', (e) => {
    isMinimapDragging = true;
    handleMinimapEvent(e.clientY);
  });

  window.addEventListener('mousemove', (e) => {
    if (isMinimapDragging) handleMinimapEvent(e.clientY);
  });

  window.addEventListener('mouseup', () => {
    isMinimapDragging = false;
  });

  minimapCanvas?.addEventListener('touchstart', (e) => {
    if (e.touches.length === 1) {
      isMinimapDragging = true;
      handleMinimapEvent(e.touches[0].clientY);
    }
  }, { passive: true });

  minimapCanvas?.addEventListener('touchmove', (e) => {
    if (isMinimapDragging && e.touches.length === 1) {
      handleMinimapEvent(e.touches[0].clientY);
    }
  }, { passive: true });

  minimapCanvas?.addEventListener('touchend', () => {
    isMinimapDragging = false;
  });

  // Canvas Click: Pick Runner to focus
  canvas?.addEventListener('click', (e) => {
    if (totalDragDistance > 8) return; // Was a drag, not a click
    const rect = canvas.getBoundingClientRect();
    const clickX = e.clientX - rect.left;
    const clickY = e.clientY - rect.top;

    const trackOffsetX = (canvas.width / zoom - COURSE_WIDTH) / 2;
    const worldX = clickX / zoom - trackOffsetX;
    const worldY = clickY / zoom + cameraY;

    const clicked = marbles.find(m => Math.hypot(m.x - worldX, m.y - worldY) < m.radius + 10);
    if (clicked) {
      focusedMarbleId = clicked.id;
      camMode = 'runner';
      isManualCam = false;
      updateCamModeHUD();
    }
  });

  // Camera Mode buttons
  document.querySelectorAll('.cam-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      const mode = btn.getAttribute('data-cam') as 'auto' | 'first' | 'last';
      camMode = mode;
      isManualCam = false;
      focusedMarbleId = null;
      updateCamModeHUD();
    });
  });

  // Resume Auto Camera button
  camResumeBtn?.addEventListener('click', () => {
    isManualCam = false;
    camMode = 'auto';
    focusedMarbleId = null;
    updateCamModeHUD();
  });

  // Zoom Buttons (0.5x, 0.75x, 1x)
  document.querySelectorAll('.zoom-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      document.querySelectorAll('.zoom-btn').forEach(b => b.classList.remove('active'));
      btn.classList.add('active');
      zoom = parseFloat(btn.getAttribute('data-zoom') || '0.5');
    });
  });

  // Theater Mode (집중 모드)
  const theaterBtn = document.getElementById('theater-toggle-btn');
  const mainLayout = document.querySelector('.marble-main-layout');
  let isTheater = false;
  theaterBtn?.addEventListener('click', () => {
    isTheater = !isTheater;
    mainLayout?.classList.toggle('theater-mode', isTheater);
    theaterBtn.classList.toggle('active', isTheater);
    theaterBtn.textContent = isTheater ? '⚙️ 설정창 보기' : '📺 집중 모드';
  });

  // Dynamic Race Toggle Button (Start <-> Reset)
  raceToggleBtn?.addEventListener('click', () => {
    if (isRacing || isCountingDown) {
      resetRace();
    } else {
      startRace();
    }
  });

  applyBtn?.addEventListener('click', () => {
    activeMarbleNames = [];
    resetRace();
  });

  namesInput?.addEventListener('input', () => {
    activeMarbleNames = [];
    resetRace();
  });

  shuffleBtn?.addEventListener('click', () => {
    if (activeMarbleNames.length === 0) {
      activeMarbleNames = parseNamesList();
    }
    for (let i = activeMarbleNames.length - 1; i > 0; i--) {
      const j = Math.floor(Math.random() * (i + 1));
      [activeMarbleNames[i], activeMarbleNames[j]] = [activeMarbleNames[j], activeMarbleNames[i]];
    }
    sfx.playPop();
    resetRace();
  });

  // Winner Mode Dropdown Select Change
  winnerModeSelect?.addEventListener('change', (e) => {
    winnerMode = (e.target as HTMLSelectElement).value;
    if (multiSettingsRow) {
      multiSettingsRow.classList.toggle('hidden', winnerMode !== 'multi');
    }
    if (customSettingsRow) {
      customSettingsRow.classList.toggle('hidden', winnerMode !== 'custom');
    }
  });

  // Energy Gauge Toggle
  energyToggle?.addEventListener('change', (e) => {
    energyGaugeEnabled = (e.target as HTMLInputElement).checked;
  });

  // Sound / Mute Toggle (HUD button synced with Header button)
  const soundHudBtn = document.getElementById('sound-toggle-hud-btn');
  const hudSoundIcon = document.getElementById('hud-sound-icon');

  function updateHudSoundUI() {
    const muted = sfx.isMuted();
    if (hudSoundIcon) hudSoundIcon.textContent = muted ? '🔇' : '🔊';
    if (soundHudBtn) {
      soundHudBtn.classList.toggle('muted', muted);
      soundHudBtn.setAttribute('title', muted ? '소리 켜기' : '소리 끄기');
      soundHudBtn.setAttribute('aria-label', muted ? '소리 켜기' : '소리 끄기');
    }
  }

  soundHudBtn?.addEventListener('click', () => {
    const current = sfx.isMuted();
    const nextMuted = !current;
    localStorage.setItem('aether_sound_muted', String(nextMuted));
    sfx.syncMute(nextMuted);
    updateHudSoundUI();
    window.dispatchEvent(new CustomEvent('sound-toggle', { detail: { muted: nextMuted } }));
  });

  window.addEventListener('sound-toggle', () => {
    updateHudSoundUI();
  });
  window.addEventListener('storage', (e) => {
    if (e.key === 'aether_sound_muted') updateHudSoundUI();
  });
  updateHudSoundUI();

  // Speed buttons (0.5x, 1x, 1.5x)
  document.querySelectorAll('.speed-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      document.querySelectorAll('.speed-btn').forEach(b => b.classList.remove('active'));
      btn.classList.add('active');
      timeScale = parseFloat(btn.getAttribute('data-speed') || '1.5');
    });
  });

  // Modal actions
  modalRestartBtn?.addEventListener('click', () => {
    resultModal?.classList.add('hidden');
    resetRace();
    startRace();
  });

  modalCloseBtn?.addEventListener('click', () => {
    resultModal?.classList.add('hidden');
  });

  // Spacebar hotkey
  window.addEventListener('keydown', (e) => {
    if (e.code === 'Space' && e.target !== namesInput) {
      e.preventDefault();
      if (isRacing || isCountingDown) {
        resetRace();
      } else {
        startRace();
      }
    }
  });

  // English UI Localization
  function applyEnglishMarbleUI() {
    // HUD
    const raceToggleBtn = document.getElementById('race-toggle-btn');
    if (raceToggleBtn) {
      const btnText = raceToggleBtn.querySelector('.btn-text');
      if (btnText) btnText.textContent = 'Start';
      raceToggleBtn.setAttribute('title', 'Start Race (Space)');
    }
    const camAuto = document.querySelector('.cam-btn[data-cam="auto"]');
    if (camAuto) {
      camAuto.textContent = '🎥 Auto';
      camAuto.setAttribute('title', 'Auto track leader, dynamic switch after finish');
    }
    const camFirst = document.querySelector('.cam-btn[data-cam="first"]');
    if (camFirst) {
      camFirst.textContent = '🥇 Lead';
      camFirst.setAttribute('title', 'Focus on race leader');
    }
    const camLast = document.querySelector('.cam-btn[data-cam="last"]');
    if (camLast) {
      camLast.textContent = '💀 Last';
      camLast.setAttribute('title', 'Focus on last place marble');
    }
    const camResume = document.getElementById('cam-resume-btn');
    if (camResume) {
      camResume.textContent = '↩ Resume';
      camResume.setAttribute('title', 'Resume auto tracking camera');
    }
    const leadName = document.getElementById('lead-name');
    if (leadName) leadName.textContent = 'Leader: Waiting';

    const theaterBtn = document.getElementById('theater-toggle-btn');
    if (theaterBtn) {
      theaterBtn.textContent = '📺 Focus Mode';
      theaterBtn.setAttribute('title', 'Collapse settings for focus mode');
    }

    const panHint = document.querySelector('#pan-hint-chip span');
    if (panHint) panHint.textContent = '🖱️ Drag / Wheel to explore map';

    // Zoom, Speed & Sound Tooltips
    const z05 = document.querySelector('.zoom-btn[data-zoom="0.5"]');
    if (z05) z05.setAttribute('title', 'Panorama View (Show 1320px course)');
    const z075 = document.querySelector('.zoom-btn[data-zoom="0.75"]');
    if (z075) z075.setAttribute('title', 'Standard View (Show 880px course)');
    const z10 = document.querySelector('.zoom-btn[data-zoom="1.0"]');
    if (z10) z10.setAttribute('title', '1:1 Actual Scale');

    const sp05 = document.querySelector('.speed-btn[data-speed="0.5"]');
    if (sp05) sp05.setAttribute('title', '0.5x Speed (Slow Motion)');
    const sp10 = document.querySelector('.speed-btn[data-speed="1"]');
    if (sp10) sp10.setAttribute('title', '1x Speed (Standard)');
    const sp15 = document.querySelector('.speed-btn[data-speed="1.5"]');
    if (sp15) sp15.setAttribute('title', '1.5x Speed (Fast Pace)');

    const soundBtn = document.getElementById('sound-toggle-hud-btn');
    if (soundBtn) {
      soundBtn.setAttribute('title', 'Toggle Sound On/Off');
      soundBtn.setAttribute('aria-label', 'Toggle Sound On/Off');
    }

    // Panels
    const panels = document.querySelectorAll('.control-column .panel-title');
    if (panels.length >= 4) {
      panels[0].textContent = '🎯 Winner Mode';
      panels[1].textContent = '👥 Participants';
      panels[2].textContent = '🏁 Finish Order (Live)';
      panels[3].textContent = '⚡ Energy Gauge Settings';
    }

    const modeSelect = document.getElementById('winner-mode-select') as HTMLSelectElement | null;
    if (modeSelect) {
      const optLast = modeSelect.querySelector('option[value="last"]');
      if (optLast) optLast.textContent = '💀 Last Place (Penalty / Bets)';
      const optFirst = modeSelect.querySelector('option[value="first"]');
      if (optFirst) optFirst.textContent = '🥇 1st Place (First to Finish)';
      const optMulti = modeSelect.querySelector('option[value="multi"]');
      if (optMulti) optMulti.textContent = '🏆 Top N Finishers';
      const optCustom = modeSelect.querySelector('option[value="custom"]');
      if (optCustom) optCustom.textContent = '🎯 Specific Rank (Nth to Finish)';
    }

    const multiRow = document.getElementById('multi-settings-row');
    if (multiRow) {
      const lbl = multiRow.querySelector('label');
      if (lbl) lbl.textContent = 'Winner count:';
      const sp = multiRow.querySelector('span');
      if (sp) sp.textContent = 'players (in order)';
    }

    const customRow = document.getElementById('custom-settings-row');
    if (customRow) {
      const lbl = customRow.querySelector('label');
      if (lbl) lbl.textContent = 'Rank to win:';
      const sp = customRow.querySelector('span');
      if (sp) sp.textContent = 'th finisher wins';
    }

    if (namesInput) {
      namesInput.value = PRESETS_EN.coffee.names.join('\n');
      namesInput.placeholder = 'Enter participant names, one per line.\nExample:\nAlice\nBob\nCharlie * 2 (2 marbles)\nDiana';
    }

    const shuffleBtn = document.getElementById('shuffle-btn');
    if (shuffleBtn) shuffleBtn.textContent = '🔀 Shuffle';

    const applyBtn = document.getElementById('apply-btn');
    if (applyBtn) applyBtn.textContent = '✓ Place Marbles';

    const finishEmptyHint = document.querySelector('.finish-empty-hint');
    if (finishEmptyHint) finishEmptyHint.textContent = 'Finishing order will appear here live.';

    const energyStrong = document.querySelector('.energy-toggle-text strong');
    if (energyStrong) energyStrong.textContent = 'Collision Blast Effect';

    const energyDesc = document.querySelector('.energy-toggle-desc');
    if (energyDesc) energyDesc.textContent = 'Marbles charge kinetic energy on collision and unleash shockwaves when full.';

    const restartBtn = document.getElementById('modal-restart-btn');
    if (restartBtn) restartBtn.textContent = '🔄 Race Again';

    const closeBtn = document.getElementById('modal-close-btn');
    if (closeBtn) closeBtn.textContent = 'Close';

    const supportLink = document.querySelector('.modal-support-link');
    if (supportLink) supportLink.textContent = '☕ Support StreamArcade';
  }

  // Init
  if (isEn) {
    applyEnglishMarbleUI();
  } else {
    if (namesInput) {
      namesInput.value = PRESETS.coffee.names.join('\n');
    }
  }
  spawnMarbles();
  requestAnimationFrame(render);
</script>
