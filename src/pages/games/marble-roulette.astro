<script>
  // Web Audio Synth for Marble FX
  class MarbleAudio {
    private ctx: AudioContext | null = null;
    constructor() {
      try {
        const AudioClass = window.AudioContext || (window as any).webkitAudioContext;
        if (AudioClass) this.ctx = new AudioClass();
      } catch {}
    }

    private resume() {
      if (this.ctx && this.ctx.state === 'suspended') {
        this.ctx.resume();
      }
    }

    playBeep(freq = 440, dur = 0.1) {
      if (!this.ctx) return;
      this.resume();
      const osc = this.ctx.createOscillator();
      const gain = this.ctx.createGain();
      osc.type = 'sine';
      osc.frequency.setValueAtTime(freq, this.ctx.currentTime);
      gain.gain.setValueAtTime(0.18, this.ctx.currentTime);
      gain.gain.exponentialRampToValueAtTime(0.01, this.ctx.currentTime + dur);
      osc.connect(gain);
      gain.connect(this.ctx.destination);
      osc.start();
      osc.stop(this.ctx.currentTime + dur);
    }

    playPop() {
      if (!this.ctx) return;
      this.resume();
      const osc = this.ctx.createOscillator();
      const gain = this.ctx.createGain();
      const freq = 350 + Math.random() * 300;
      osc.type = 'triangle';
      osc.frequency.setValueAtTime(freq, this.ctx.currentTime);
      osc.frequency.exponentialRampToValueAtTime(freq * 0.5, this.ctx.currentTime + 0.06);
      gain.gain.setValueAtTime(0.08, this.ctx.currentTime);
      gain.gain.exponentialRampToValueAtTime(0.005, this.ctx.currentTime + 0.06);
      osc.connect(gain);
      gain.connect(this.ctx.destination);
      osc.start();
      osc.stop(this.ctx.currentTime + 0.06);
    }

    playSpring() {
      if (!this.ctx) return;
      this.resume();
      const osc = this.ctx.createOscillator();
      const gain = this.ctx.createGain();
      osc.type = 'sine';
      const now = this.ctx.currentTime;
      osc.frequency.setValueAtTime(180, now);
      osc.frequency.exponentialRampToValueAtTime(850, now + 0.08);
      osc.frequency.exponentialRampToValueAtTime(280, now + 0.22);
      gain.gain.setValueAtTime(0.24, now);
      gain.gain.exponentialRampToValueAtTime(0.01, now + 0.22);
      osc.connect(gain);
      gain.connect(this.ctx.destination);
      osc.start();
      osc.stop(now + 0.22);
    }

    playFinish() {
      if (!this.ctx) return;
      this.resume();
      const notes = [523.25, 659.25, 783.99, 1046.50];
      notes.forEach((freq, i) => {
        setTimeout(() => {
          this.playBeep(freq, 0.25);
        }, i * 90);
      });
    }
  }

  const sfx = new MarbleAudio();

  // Presets Data (Streamer preset removed)
  const PRESETS: Record<string, { mode: string; names: string[] }> = {
    coffee: {
      mode: 'last',
      names: ['김팀장', '이대리', '박사원', '최인턴', '정부장', '강과장', '조선임', '윤연구원']
    },
    chicken: {
      mode: 'last',
      names: ['철수', '영희', '민수', '지은', '호스트', '게스트A', '게스트B', '시청자1']
    },
    lunch: {
      mode: 'first',
      names: ['돈까스', '제육볶음', '김치찌개', '짜장면', '초밥', '햄버거', '마라탕', '쌀국수']
    },
    penalty: {
      mode: 'last',
      names: ['애교 3종', '노래 1곡', '딱밤 한 대', '팔굽혀펴기 20개', '벌칙 면제', '음료수 쏘기', '엉덩이 춤', '물 원샷']
    }
  };

  const MARBLE_COLORS = [
    '#38bdf8', '#f43f5e', '#10b981', '#facc15', '#a855f7',
    '#f97316', '#06b6d4', '#ec4899', '#84cc16', '#6366f1'
  ];

  interface Marble {
    id: number;
    name: string;
    x: number;
    y: number;
    vx: number;
    vy: number;
    radius: number;
    color: string;
    finished: boolean;
    finishTime: number;
    finishRank: number;
    energy: number; // 0.0 to 1.0 (charges on collisions)
    lastShockwaveTime: number;
    stuckTimer: number;
    lastSampleX: number;
    lastSampleY: number;
  }

  interface Pin {
    x: number;
    y: number;
    radius: number;
    isBumper?: boolean;
  }

  interface Spinner {
    x: number;
    y: number;
    length: number;
    angle: number;
    speed: number;
  }

  interface Bouncer {
    x: number;
    y: number;
    radius: number;
    power: number;
    label?: string;
  }

  interface Segment {
    x1: number;
    y1: number;
    x2: number;
    y2: number;
    type?: 'wall' | 'ramp' | 'guide';
  }

  interface ZoneMarker {
    y: number;
    title: string;
    sub: string;
  }

  interface Shockwave {
    x: number;
    y: number;
    radius: number;
    maxRadius: number;
    color: string;
    alpha: number;
  }

  // Course Dimensions (Mega 7,200px track)
  const COURSE_WIDTH = 440;
  const COURSE_HEIGHT = 7200;
  const FINISH_LINE_Y = 6950;

  const ZONE_MARKERS: ZoneMarker[] = [
    { y: 260, title: 'ZONE 1 — 스타팅 핀 숲', sub: 'PLINKO FOREST FIELD' },
    { y: 800, title: 'ZONE 2 — 1차 쿼드 스피너', sub: 'QUAD SPINNER GAUNTLET' },
    { y: 1380, title: 'ZONE 3 — 1차 역전 스프링 트랩', sub: 'COMEBACK SPRING TRAP 1' },
    { y: 1920, title: 'ZONE 4 — 하이퍼 슬라럼 & 트랩 드롭', sub: 'HYPER SLALOM, SPINNERS & TRAPDROP' },
    { y: 2700, title: 'ZONE 5 — 소용돌이 퍼널 & 2차 스피너', sub: 'VORTEX CHUTE & SPINNERS' },
    { y: 3420, title: 'ZONE 6 — 도박의 갈림길', sub: 'SPLIT-PATH GAMBLE (HIGH RISK CHUTE)' },
    { y: 4160, title: 'ZONE 7 — 2차 역전 메가 볼텍스 & 킥백', sub: 'REVERSE VORTEX & KICKBACKS' },
    { y: 4860, title: 'ZONE 8 — 메가 네온 범퍼 슬라럼', sub: 'NEON BUMPER FOREST' },
    { y: 5560, title: 'ZONE 9 — 3차 트라이앵글 스피너', sub: 'TRIPLE SPINNER GAUNTLET' },
    { y: 6150, title: 'ZONE 10 — S-커브 고속 와인딩', sub: 'S-CURVE WINDING SLOPES' },
    { y: 6680, title: 'ZONE 11 — 최종 스퍼트 & 승부 결정 핀', sub: 'FINAL SPRINT & DECIDER PINS' },
    { y: 6940, title: 'ZONE 12 — 결승선 & 피니시', sub: 'FINISH LINE' }
  ];

  // Track Entities
  let pins: Pin[] = [];
  let spinners: Spinner[] = [];
  let bouncers: Bouncer[] = [];
  let segments: Segment[] = [];
  let shockwaves: Shockwave[] = [];
  let isGateOpen = false;
  let energyGaugeEnabled = true;

  function buildCourse() {
    pins = [];
    spinners = [];
    bouncers = [];
    segments = [];

    // Outer Boundary Walls (Left & Right)
    segments.push({ x1: 20, y1: 0, x2: 20, y2: COURSE_HEIGHT, type: 'wall' });
    segments.push({ x1: COURSE_WIDTH - 20, y1: 0, x2: COURSE_WIDTH - 20, y2: COURSE_HEIGHT, type: 'wall' });

    // Starting Hopper (y: 60 - 220)
    segments.push({ x1: 20, y1: 180, x2: 170, y2: 220, type: 'guide' });
    segments.push({ x1: COURSE_WIDTH - 20, y1: 180, x2: 270, y2: 220, type: 'guide' });

    // ZONE 1: 스타팅 핀 숲 (y: 280 - 750) - 10 dense rows
    for (let row = 0; row < 10; row++) {
      const y = 290 + row * 44;
      const count = (row % 2 === 0) ? 6 : 7;
      const spacing = (COURSE_WIDTH - 90) / (count - 1);
      const startX = (row % 2 === 0) ? 45 : 30;
      for (let c = 0; c < count; c++) {
        pins.push({ x: startX + c * spacing, y, radius: 7 });
      }
    }
    segments.push({ x1: 20, y1: 460, x2: 75, y2: 500, type: 'ramp' });
    segments.push({ x1: COURSE_WIDTH - 20, y1: 460, x2: COURSE_WIDTH - 75, y2: 500, type: 'ramp' });
