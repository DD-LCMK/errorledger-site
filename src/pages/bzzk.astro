---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import RectangleAd from '../components/ads/RectangleAd.astro';
import LeaderboardAd from '../components/ads/LeaderboardAd.astro';
import NativeAd from '../components/ads/NativeAd.astro';
import { SITE_TITLE } from '../consts';
import { getKoUrl, getEnUrl } from '../i18n';

const urlParams = Astro.url.searchParams;
const streamerMode = urlParams.has('stream') || urlParams.has('obs');

const PAGE_TITLE = `검지직 (Bzzk) - 치지직 실시간 악성 유저 탐지 & 방송 보호 레이더 | ${SITE_TITLE}`;
const PAGE_DESCRIPTION = "네이버 치지직(CHZZK) 다중 채널에서 동시다발적으로 제재된 악성 분탕 계정을 실시간으로 분석하고 방송을 안전하게 보호하는 검지직(Bzzk) 실시간 레이더.";
---

<!doctype html>
<html lang="ko" class="dark">
  <head>
    <BaseHead 
      title={PAGE_TITLE} 
      description={PAGE_DESCRIPTION}
      lang="ko"
      hreflangKo={getKoUrl((Astro.site || 'https://errorledger.com').toString(), Astro.url.pathname)}
      hreflangEn={getEnUrl((Astro.site || 'https://errorledger.com').toString(), Astro.url.pathname)}
    />
  </head>
  <body class="bzzk-page-body">
    <Header />

    <main class="bzzk-page-main">
      <!-- Hero Section -->
      <section class="bzzk-hero">
        <div class="hero-backdrop"></div>
        <div class="hero-content">
          <div class="hero-pill">
            <span class="pulse-dot"></span>
            <span>🛡️ 치지직 실시간 방송 보호 시스템</span>
          </div>
          <h1 class="hero-headline">
            검지직 <span class="gradient-text">(Bzzk)</span>
          </h1>
          <p class="hero-subtext">
            여러 방송에서 동시다발적으로 제재를 일으키는 악성 유저를 실시간으로 교차 분석합니다.<br />
            개인정보는 엄격히 마스킹 보호되며, 내 방송에 들어오기 전 사전에 방어할 수 있는 스마트 클린 레이더입니다.
          </p>

          <!-- Core Feature Highlights -->
          <div class="features-summary-row">
            <div class="summary-pill">
              <span class="pill-icon">📡</span>
              <span class="pill-text"><strong>크로스 채널 분석:</strong> 단일 채널이 아닌 다중 방송 동시 제재 패턴 포착</span>
            </div>
            <div class="summary-pill">
              <span class="pill-icon">⚡</span>
              <span class="pill-text"><strong>실시간 피드 동기화:</strong> 악성 행위 감지 즉시 레이더 목록 자동 업데이트</span>
            </div>
            <div class="summary-pill">
              <span class="pill-icon">🔒</span>
              <span class="pill-text"><strong>안심 개인정보 보호:</strong> 모든 닉네임과 계정 식별자 100% 자동 가명화</span>
            </div>
          </div>
        </div>
      </section>

      <!-- Live Embed Section -->
      <section class="bzzk-embed-section">
        <div class="section-header">
          <div class="header-left">
            <div class="live-tag">
              <span class="blinking-dot"></span>
              LIVE RADAR
            </div>
            <h2>최근 악성 활동 피드 (최신 25건)</h2>
          </div>
          <div class="header-right">
            <span class="auto-sync-badge">🔄 자동 실시간 동기화</span>
          </div>
        </div>

        <div class="embed-info-bar">
          <div class="info-icon">ℹ️</div>
          <div class="info-text">
            <strong>실시간 활동 피드 안내:</strong> 아래 목록은 전체 데이터베이스 중 <strong>가장 최근에 탐지된 25건의 악성 활동</strong>을 실시간으로 표시한 것입니다. 모든 닉네임과 계정 정보는 수식 연산을 통해 자동 마스킹(`**`) 처리되어 가명화 관리됩니다.
          </div>
        </div>

        <!-- Bzzk Security Grid Window -->
        <div class="bzzk-embed-wrapper">
          <div class="embed-window-header">
            <div class="window-buttons">
              <span class="win-btn red"></span>
              <span class="win-btn yellow"></span>
              <span class="win-btn green"></span>
            </div>
            <span class="window-title">Bzzk Security Radar — Recent 25 Activities</span>
            <div class="window-actions">
              <span class="status-indicator">● Active Feed</span>
            </div>
          </div>
          
          <div class="embed-content-box">
            <script src="https://lunadb.dbflex.net/secure/embed.js"
              data-url="/ev-15532349/db/86483/view.aspx"></script>
          </div>
        </div>
      </section>

      <!-- Content Rectangle Ad -->
      <RectangleAd streamerMode={streamerMode} />

      <!-- How It Works Section -->
      <section class="bzzk-guide-section">
        <h2 class="section-title">검지직(Bzzk)은 어떻게 동작하나요?</h2>
        <p class="section-subtext">스트리머가 분탕 걱정 없이 방송에만 온전히 집중할 수 있도록 교차 검증 시스템으로 설계되었습니다.</p>

        <div class="guide-cards-grid">
          <div class="guide-card">
            <div class="card-icon">🎯</div>
            <h3>1. 다중 채널 교차 검증</h3>
            <p>
              한 방송에서의 단순 말실수나 우발적 밴은 제외하고, 일정 시간 동안 여러 방송을 돌며 연속 제재 및 블라인드 처리된 명백한 악성 패턴만 정밀하게 필터링합니다.
            </p>
          </div>

          <div class="guide-card">
            <div class="card-icon">⚡</div>
            <h3>2. 실시간 클라우드 기록</h3>
            <p>
              감지된 계정은 즉시 데이터베이스에 기록되며, 제재 사유(단기 영차 스팸, 일일 급증, 블라인드 다발 등)와 후속 제재 횟수가 실시간으로 카운트됩니다.
            </p>
          </div>

          <div class="guide-card">
            <div class="card-icon">🛡️</div>
            <h3>3. 내 방송 사전 자동 방어</h3>
            <p>
              치지직 공식 오픈 API 연동을 통해 악성 유저가 내 방송 채팅방에 들어와 분란을 일으키기 전에 미리 '사전 차단 목록'에 등록되어 완벽한 방어가 이루어집니다.
            </p>
          </div>
        </div>
      </section>

      <!-- Streamer Auto-Ban Request Section -->
      <section class="bzzk-request-section">
        <div class="request-card">
          <div class="request-badge">
            <span>🚀 스트리머 전용</span>
          </div>
          <h2>내 치지직 방송에 검지직 자동 차단 연동하기</h2>
          <p class="request-desc">
            검지직 자동 차단 봇은 봇 오남용 및 무분별한 API 트래픽을 방지하기 위해,<br />
            <strong>사전 신청 및 검토를 거친 스트리머 채널에 한해 수동으로 개별 연동</strong>해 드리고 있습니다.
          </p>

          <div class="request-features">
            <div class="req-feature-item">
              <span class="check-icon">✓</span>
              <span>검지직 탐지 시 내 채널 채팅방에서도 신속하게 자동 사전 차단</span>
            </div>
            <div class="req-feature-item">
              <span class="check-icon">✓</span>
              <span>다중 방송 교차 검증을 거친 고위험 악성 분탕 계정만 안전하게 선별 차단</span>
            </div>
            <div class="req-feature-item">
              <span class="check-icon">✓</span>
              <span>내 방송 차단 내역 실시간 동기화 상태 유지</span>
            </div>
          </div>

          <div class="request-cta-wrap">
            <a href="mailto:contact@errorledger.com?subject=[검지직] 치지직 채널 자동차단 연동 신청&body=스트리머 활동명:%0D%0A치지직 채널 링크:%0D%0A연락처(디스코드 또는 이메일):" class="request-btn">
              📩 자동 차단 연동 신청하기
            </a>
            <span class="request-note">* 채널 확인 후 순차적으로 개별 안내 및 연동을 진행해 드립니다.</span>
          </div>
        </div>
      </section>

      <!-- Leaderboard Ad Banner -->
      <LeaderboardAd streamerMode={streamerMode} />

      <!-- FAQ Section -->
      <section class="bzzk-faq-section">
        <div class="faq-container">
          <h2 class="section-title">자주 묻는 질문 (FAQ)</h2>
          
          <div class="faq-item">
            <h3>Q. 일반 시청자가 장난이나 실수로 밴당한 경우도 등록되나요?</h3>
            <p>
              아닙니다. 특정 1개 채널의 단일 밴은 절대로 등록되지 않습니다. <strong>정해진 시간 내 여러 방송에서 동시다발적으로 영구차단 및 블라인드 처리된 악성 패턴</strong>만 엄격한 필터링을 거쳐 등록됩니다.
            </p>
          </div>

          <div class="faq-item">
            <h3>Q. 표에 표시된 목록이 전체 차단 목록인가요?</h3>
            <p>
              아닙니다. 웹사이트의 라이브 피드에는 <strong>가장 최근에 탐지된 최신 25건의 악성 활동</strong>만 실시간으로 표시됩니다. 내부 감지 엔진은 전체 누적 데이터베이스를 바탕으로 다중 채널 분탕 계정을 지속적으로 추적 및 방어합니다.
            </p>
          </div>

          <div class="faq-item">
            <h3>Q. 자동 차단 봇을 누구나 바로 쓸 수 없는 이유는 무엇인가요?</h3>
            <p>
              치지직 플랫폼의 API 정책을 철저히 준수하고, 봇 계정의 안정적인 운영과 오남용 방지를 위해 현재는 스트리머 본인 인증 및 수동 검토를 거쳐 안전하게 1:1로만 연동해 드리고 있습니다.
            </p>
          </div>
        </div>
      </section>

      <!-- Native Recommendation Widget Ad -->
      <NativeAd streamerMode={streamerMode} />
    </main>

    {!streamerMode && <Footer />}

    <style>
      .bzzk-page-body {
        margin: 0;
        padding: 0;
        background-color: #0b0d14;
        color: #f1f5f9;
        font-family: -apple-system, BlinkMacSystemFont, 'Pretendard', 'Segoe UI', Roboto, sans-serif;
        min-height: 100vh;
      }

      .bzzk-page-main {
        max-width: 1300px;
        margin: 0 auto;
        padding: 40px 20px 80px;
      }

      /* Hero */
      .bzzk-hero {
        position: relative;
        text-align: center;
        padding: 50px 20px 30px;
        overflow: hidden;
      }

      .hero-backdrop {
        position: absolute;
        top: -50%;
        left: 50%;
        transform: translateX(-50%);
        width: 800px;
        height: 500px;
        background: radial-gradient(circle, rgba(99, 102, 241, 0.2) 0%, rgba(236, 72, 153, 0.08) 50%, transparent 80%);
        filter: blur(60px);
        pointer-events: none;
        z-index: 0;
      }

      .hero-content {
        position: relative;
        z-index: 1;
      }

      .hero-pill {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 6px 18px;
        border-radius: 9999px;
        background: rgba(99, 102, 241, 0.12);
        border: 1px solid rgba(99, 102, 241, 0.3);
        font-size: 0.85rem;
        font-weight: 600;
        color: #a5b4fc;
        margin-bottom: 20px;
      }

      .pulse-dot {
        width: 8px;
        height: 8px;
        border-radius: 50%;
        background-color: #10b981;
        box-shadow: 0 0 10px #10b981;
        animation: pulse 2s infinite;
      }

      @keyframes pulse {
        0%, 100% { opacity: 1; transform: scale(1); }
        50% { opacity: 0.4; transform: scale(0.8); }
      }

      .hero-headline {
        font-size: 3rem;
        font-weight: 900;
        letter-spacing: -0.03em;
        margin: 0 0 16px;
        line-height: 1.2;
      }

      .gradient-text {
        background: linear-gradient(135deg, #38bdf8 0%, #818cf8 50%, #c084fc 100%);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
      }

      .hero-subtext {
        font-size: 1.15rem;
        color: #94a3b8;
        max-width: 720px;
        margin: 0 auto 32px;
        line-height: 1.65;
      }

      /* Features Summary Row */
      .features-summary-row {
        display: flex;
        flex-wrap: wrap;
        justify-content: center;
        gap: 12px;
        max-width: 1050px;
        margin: 0 auto 20px;
      }

      .summary-pill {
        display: inline-flex;
        align-items: center;
        gap: 10px;
        background: rgba(22, 27, 46, 0.8);
        border: 1px solid rgba(255, 255, 255, 0.08);
        border-radius: 12px;
        padding: 10px 18px;
        font-size: 0.9rem;
        color: #cbd5e1;
      }

      .summary-pill strong {
        color: #f1f5f9;
      }

      .pill-icon {
        font-size: 1.1rem;
      }

      /* Embed Section */
      .bzzk-embed-section {
        margin-top: 40px;
      }

      .section-header {
        display: flex;
        justify-content: space-between;
        align-items: flex-end;
        margin-bottom: 16px;
        flex-wrap: wrap;
        gap: 12px;
      }

      .header-left {
        display: flex;
        align-items: center;
        gap: 12px;
      }

      .section-header h2 {
        font-size: 1.35rem;
        font-weight: 700;
        margin: 0;
        color: #f8fafc;
      }

      .live-tag {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 4px 10px;
        border-radius: 6px;
        background: rgba(239, 68, 68, 0.15);
        border: 1px solid rgba(239, 68, 68, 0.3);
        color: #f87171;
        font-size: 0.75rem;
        font-weight: 700;
        letter-spacing: 0.05em;
      }

      .blinking-dot {
        width: 6px;
        height: 6px;
        border-radius: 50%;
        background-color: #ef4444;
        animation: pulse 1.2s infinite;
      }

      .auto-sync-badge {
        font-size: 0.85rem;
        color: #94a3b8;
        background: rgba(255, 255, 255, 0.05);
        padding: 6px 12px;
        border-radius: 8px;
        border: 1px solid rgba(255, 255, 255, 0.08);
      }

      .embed-info-bar {
        display: flex;
        align-items: flex-start;
        gap: 12px;
        background: rgba(30, 41, 59, 0.5);
        border: 1px solid rgba(59, 130, 246, 0.2);
        border-radius: 12px;
        padding: 12px 18px;
        margin-bottom: 18px;
        font-size: 0.9rem;
        color: #cbd5e1;
        line-height: 1.5;
      }

      .info-icon {
        font-size: 1.1rem;
        flex-shrink: 0;
      }

      /* Embed Window */
      .bzzk-embed-wrapper {
        background: #111420;
        border: 1px solid #232a42;
        border-radius: 16px;
        overflow: hidden;
        box-shadow: 0 20px 40px -15px rgba(0, 0, 0, 0.6);
      }

      .embed-window-header {
        background: #161b2c;
        border-bottom: 1px solid #232a42;
        padding: 12px 18px;
        display: flex;
        align-items: center;
        justify-content: space-between;
      }

      .window-buttons {
        display: flex;
        gap: 6px;
      }

      .win-btn {
        width: 10px;
        height: 10px;
        border-radius: 50%;
      }

      .win-btn.red { background-color: #ef4444; }
      .win-btn.yellow { background-color: #f59e0b; }
      .win-btn.green { background-color: #10b981; }

      .window-title {
        font-size: 0.85rem;
        color: #94a3b8;
        font-family: monospace;
      }

      .status-indicator {
        font-size: 0.8rem;
        color: #10b981;
        font-weight: 600;
      }

      /* Deep styling the embedded view to look sleek and dark */
      .embed-content-box {
        background: #0d101a;
        padding: 16px;
        min-height: 480px;
        overflow-x: auto;
      }

      /* TeamDesk injected element styling overrides */
      :global(.embed-content-box) {
        background: #0d101a !important;
        color: #f1f5f9 !important;
      }

      :global(.embed-content-box h1),
      :global(.embed-content-box h2),
      :global(.embed-content-box .fs-title),
      :global(.embed-content-box .fs-view-title),
      :global(.embed-content-box .fs-grid-caption) {
        display: none !important;
      }

      :global(.embed-content-box table.fs-grid),
      :global(.embed-content-box table) {
        background: #111420 !important;
        border-collapse: separate !important;
        border-spacing: 0 !important;
        width: 100% !important;
        border-radius: 8px !important;
        overflow: hidden !important;
        border: 1px solid #1e2438 !important;
      }

      :global(.embed-content-box th) {
        background: #161c2e !important;
        color: #93c5fd !important;
        font-weight: 700 !important;
        font-size: 0.85rem !important;
        text-transform: uppercase !important;
        letter-spacing: 0.03em !important;
        padding: 12px 14px !important;
        border-bottom: 2px solid #283252 !important;
        border-top: none !important;
        border-left: none !important;
        border-right: none !important;
      }

      :global(.embed-content-box td) {
        background-color: #111420 !important;
        color: #e2e8f0 !important;
        font-size: 0.9rem !important;
        padding: 12px 14px !important;
        border-bottom: 1px solid #1a2033 !important;
        border-top: none !important;
        border-left: none !important;
        border-right: none !important;
      }

      :global(.embed-content-box tr:hover td) {
        background-color: #1a2035 !important;
      }

      :global(.embed-content-box a) {
        color: #60a5fa !important;
      }

      :global(.embed-content-box .fs-pager),
      :global(.embed-content-box .fs-status) {
        color: #64748b !important;
        font-size: 0.85rem !important;
        padding-top: 10px !important;
      }

      /* Guides */
      .bzzk-guide-section {
        margin-top: 70px;
      }

      .section-title {
        font-size: 1.85rem;
        font-weight: 800;
        text-align: center;
        margin: 0 0 10px;
        letter-spacing: -0.02em;
      }

      .section-subtext {
        text-align: center;
        color: #94a3b8;
        margin: 0 auto 40px;
        max-width: 600px;
        font-size: 1rem;
      }

      .guide-cards-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
        gap: 20px;
      }

      .guide-card {
        background: rgba(22, 27, 46, 0.5);
        border: 1px solid rgba(255, 255, 255, 0.08);
        border-radius: 16px;
        padding: 28px 22px;
        transition: border-color 0.2s;
      }

      .guide-card:hover {
        border-color: rgba(99, 102, 241, 0.4);
      }

      .card-icon {
        font-size: 2rem;
        margin-bottom: 16px;
      }

      .guide-card h3 {
        font-size: 1.2rem;
        font-weight: 700;
        margin: 0 0 10px;
        color: #f1f5f9;
      }

      .guide-card p {
        font-size: 0.95rem;
        color: #94a3b8;
        line-height: 1.6;
        margin: 0;
      }

      /* Streamer Request Card */
      .bzzk-request-section {
        margin-top: 60px;
      }

      .request-card {
        background: linear-gradient(135deg, rgba(22, 27, 46, 0.9) 0%, rgba(30, 27, 75, 0.6) 100%);
