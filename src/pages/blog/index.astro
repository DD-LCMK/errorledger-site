---
import BaseHead from '../../components/BaseHead.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../../consts';
import { getCollection } from 'astro:content';

const allPosts = await getCollection('blog');

const posts = allPosts.sort((a, b) => {
	const dateA = a.data.pubDate ? new Date(a.data.pubDate).valueOf() : 0;
	const dateB = b.data.pubDate ? new Date(b.data.pubDate).valueOf() : 0;
	return dateB - dateA;
});
---

<html lang="en" class="dark">
	<head>
		<BaseHead title={`The Failure Ledger Archive | ${SITE_TITLE}`} description={SITE_DESCRIPTION} />
		<style>
			main { width: 1000px; max-width: calc(100% - 2rem); margin: 0 auto; padding: 3em 1rem; }

			.archive-header {
				margin-bottom: 2.5rem;
				border-bottom: 1px solid #262626;
				padding-bottom: 1.5rem;
			}
			.archive-header h1 {
				font-size: 2.5rem;
				font-weight: 800;
				color: #f5f5f5;
				margin: 0 0 0.5rem 0;
				letter-spacing: -0.03em;
			}
			.archive-header p {
				color: #a3a3a3;
				font-size: 1.1rem;
				margin: 0;
				line-height: 1.6;
			}

			.filter-controls {
				display: flex;
				flex-wrap: wrap;
				gap: 0.75rem;
				margin-bottom: 2rem;
				align-items: center;
				justify-content: space-between;
			}

			.pill-btn {
				background: #171717;
				border: 1px solid #262626;
				color: #a3a3a3;
				font-size: 0.8rem;
				font-weight: 600;
				padding: 0.45rem 0.9rem;
				border-radius: 9999px;
				cursor: pointer;
				font-family: ui-monospace, monospace;
				transition: all 0.15s ease;
			}
			.pill-btn:hover, .pill-btn.active {
				background: #f43f5e;
				color: #ffffff;
				border-color: #f43f5e;
			}

			.live-filter-input {
				background: #171717;
				border: 1px solid #262626;
				color: #f5f5f5;
				font-size: 0.85rem;
				padding: 0.45rem 0.85rem;
				border-radius: 8px;
				outline: none;
				width: 100%;
				max-width: 260px;
			}
			.live-filter-input:focus {
				border-color: #f43f5e;
			}

			.grid-archive {
				display: grid;
				grid-template-columns: 1fr;
				gap: 1.25rem;
			}

			.archive-card {
				background: #171717;
				border: 1px solid #262626;
				border-radius: 12px;
				padding: 1.5rem;
				transition: transform 0.2s ease, border-color 0.2s ease;
				text-decoration: none;
				display: block;
			}
			.archive-card:hover {
				transform: translateY(-2px);
				border-color: #f43f5e;
			}

			.card-meta {
				display: flex;
				align-items: center;
				gap: 0.75rem;
				margin-bottom: 0.6rem;
				font-size: 0.8rem;
				color: #737373;
				font-family: ui-monospace, monospace;
			}
		</style>
	</head>
	<body class="bg-neutral-950 text-neutral-200 antialiased min-h-screen">
		<Header />
		<main>
			<div class="archive-header">
				<h1>The Failure Ledger Archive</h1>
				<p>Investigative records of human error, corporate negligence, and systemic breakdowns. Filter by financial blast radius or keyword.</p>
			</div>

			<!-- Interactive Feature 6: Blast Radius & Live Filter -->
			<div class="filter-controls">
				<div class="flex items-center gap-2 flex-wrap" id="radius-filter-pills">
					<button class="pill-btn active" data-radius="all">All Blast Radii</button>
					<button class="pill-btn" data-radius="corporate">🏢 Org-Wide ($100k - $10M)</button>
					<button class="pill-btn" data-radius="work">🧑‍💻 Career & Personal</button>
					<button class="pill-btn" data-radius="global">🌋 Global (> $1B)</button>
				</div>
				<input 
					type="text" 
					id="archive-search" 
					class="live-filter-input" 
					placeholder="Instant filter by title..." 
					autocomplete="off"
				/>
			</div>

			<div class="grid-archive" id="archive-grid">
				{posts.map((post) => (
					<a 
						href={`/blog/${post.data.shortenedSlug || post.slug}`} 
						class="archive-card" 
						data-category={post.data.category}
						data-title={post.data.title.toLowerCase()}
					>
						<div class="card-meta">
							<span class="px-2 py-0.5 rounded bg-neutral-900 border border-neutral-800 text-neutral-300 font-bold uppercase text-xs">
								{post.data.category}
							</span>
							<span>•</span>
							<FormattedDate date={post.data.pubDate || new Date()} />
							<span>•</span>
							<span>⏱️ {post.data.read_time_minutes || 6}m</span>
							<span>•</span>
							<span class="text-rose-400">{post.data.provenance_label || "Documented Incident"}</span>
						</div>
						<h3 class="text-xl font-bold text-neutral-100 mb-2 leading-snug hover:text-rose-400 transition-colors">
							{post.data.title}
						</h3>
						<p class="text-sm text-neutral-400 leading-relaxed mb-1 line-clamp-2">
							{post.data.description}
						</p>
					</a>
				))}
			</div>

			<div id="no-results" class="hidden text-center py-16 text-neutral-500 font-mono text-sm">
				No records matched the current blast radius filter.
			</div>
		</main>
		<Footer />

		<script is:inline>
			(function() {
				const pills = document.querySelectorAll('#radius-filter-pills .pill-btn');
				const searchInput = document.getElementById('archive-search');
				const cards = document.querySelectorAll('.archive-card');
				const noResults = document.getElementById('no-results');

				let activeRadius = 'all';
				let searchQuery = '';

				function applyFilters() {
					let visibleCount = 0;
					cards.forEach(card => {
						const cat = card.getAttribute('data-category');
						const title = card.getAttribute('data-title') || '';

						const matchesRadius = (activeRadius === 'all') || 
							(activeRadius === 'corporate' && cat === 'corporate') ||
							(activeRadius === 'work' && cat === 'work') ||
							(activeRadius === 'global' && (cat === 'corporate' || cat === 'money'));

						const matchesSearch = !searchQuery || title.includes(searchQuery.toLowerCase());

						if (matchesRadius && matchesSearch) {
							card.style.display = 'block';
							visibleCount++;
						} else {
							card.style.display = 'none';
						}
					});

					if (noResults) {
						if (visibleCount === 0) noResults.classList.remove('hidden');
						else noResults.classList.add('hidden');
					}
				}

				pills.forEach(pill => {
					pill.addEventListener('click', function() {
						pills.forEach(p => p.classList.remove('active'));
						this.classList.add('active');
						activeRadius = this.getAttribute('data-radius');
						applyFilters();
					});
				});

				searchInput?.addEventListener('input', function() {
					searchQuery = this.value.trim();
					applyFilters();
				});
			})();
		</script>
	</body>
</html>