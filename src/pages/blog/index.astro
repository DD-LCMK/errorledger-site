---
import BaseHead from '../../components/BaseHead.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../../consts';
import { getCollection } from 'astro:content';

const allPosts = await getCollection('blog');
const enPosts = allPosts.filter(p => !p.id.startsWith('ko/') && (p.data.lang || 'en') === 'en');

const posts = enPosts.sort((a, b) => {
	const dateA = a.data.pubDate ? new Date(a.data.pubDate).valueOf() : 0;
	const dateB = b.data.pubDate ? new Date(b.data.pubDate).valueOf() : 0;
	return dateB - dateA;
});

const topRankedPosts = [
	{
		rank: 1,
		title: "The Friday Morning Update That Took Down 8.5 Million Computers",
		slug: "the-friday-update-that-broke-the-world",
		category: "Corporate",
		votes: "1,421 votes"
	},
	{
		rank: 2,
		title: "The $440M Knight Capital Trading Glitch: 45 Minutes of Algorithmic Ruin",
		slug: "knight-capital-trading-glitch-45-minutes",
		category: "Finance",
		votes: "3,110 votes"
	},
	{
		rank: 3,
		title: "He Deleted the Production Database and Let the Intern Take the Fall",
		slug: "deleted-production-database-blamed-intern",
		category: "Workplace",
		votes: "2,890 votes"
	}
];
---

<html lang="en" class="dark">
	<head>
		<BaseHead title={`The Failure Ledger Archive | ${SITE_TITLE}`} description={SITE_DESCRIPTION} />
		<style>
			main {
				width: 1200px;
				max-width: calc(100% - 2rem);
				margin: 0 auto;
				padding: 2.5rem 1rem 5rem 1rem;
			}

			.archive-header {
				margin-bottom: 2.5rem;
				border-bottom: 1px solid #262626;
				padding-bottom: 1.5rem;
				display: flex;
				justify-content: space-between;
				align-items: flex-end;
				flex-wrap: wrap;
				gap: 1rem;
			}
			.archive-header h1 {
				font-size: 2.3rem;
				font-weight: 800;
				color: #f5f5f5;
				margin: 0 0 0.4rem 0;
				letter-spacing: -0.025em;
			}
			.archive-header p {
				color: #a3a3a3;
				font-size: 1rem;
				margin: 0;
				line-height: 1.5;
			}

			/* Portal Grid */
			.archive-portal-grid {
				display: grid;
				grid-template-columns: 1fr;
				gap: 2.5rem;
				align-items: start;
				min-width: 0;
				width: 100%;
			}
			@media (min-width: 1024px) {
				.archive-portal-grid {
					grid-template-columns: minmax(0, 1fr) 340px;
				}
			}

			.archive-stream {
				min-width: 0;
				width: 100%;
			}

			/* Search & Live Filter Bar */
			.archive-filter-bar {
				margin-bottom: 2rem;
				display: flex;
				gap: 1rem;
				align-items: center;
				flex-wrap: wrap;
			}
			.search-box-input {
				flex-grow: 1;
				background: #171717;
				border: 1px solid #262626;
				border-radius: 10px;
				padding: 0.65rem 1rem;
				color: #f5f5f5;
				font-size: 0.9rem;
				outline: none;
				transition: border-color 0.15s ease;
			}
			.search-box-input:focus {
				border-color: #f43f5e;
			}

			.filter-chip-row {
				display: flex;
				gap: 0.5rem;
				flex-wrap: wrap;
			}
			.filter-btn {
				background: #171717;
				border: 1px solid #262626;
				color: #a3a3a3;
				padding: 0.35rem 0.75rem;
				border-radius: 9999px;
				font-size: 0.78rem;
				font-weight: 600;
				cursor: pointer;
				transition: all 0.15s ease;
			}
			.filter-btn:hover, .filter-btn.active {
				background: #f43f5e;
				color: #ffffff;
				border-color: #f43f5e;
			}

			/* Cards Grid */
			.archive-cards-list {
				display: grid;
				grid-template-columns: 1fr;
				gap: 1.25rem;
			}
			@media (min-width: 640px) {
				.archive-cards-list {
					grid-template-columns: 1fr 1fr;
				}
			}

			.archive-post-card {
				background: #171717;
				border: 1px solid #262626;
				border-radius: 14px;
				padding: 1.5rem;
				display: flex;
				flex-direction: column;
				justify-content: space-between;
				text-decoration: none;
				transition: all 0.2s ease;
				min-width: 0;
				box-sizing: border-box;
			}
			.archive-post-card:hover {
				border-color: #f43f5e;
				transform: translateY(-2px);
				box-shadow: 0 4px 20px rgba(244, 63, 94, 0.15);
			}
			.card-meta-header {
				display: flex;
				align-items: center;
				gap: 0.5rem;
				margin-bottom: 0.6rem;
			}
			.cat-badge {
				padding: 0.15rem 0.5rem;
				border-radius: 4px;
				background: #0a0a0a;
				color: #fb7185;
				border: 1px solid rgba(244, 63, 94, 0.25);
				font-size: 0.72rem;
				font-weight: 700;
				text-transform: uppercase;
				font-family: ui-monospace, monospace;
			}
			.readtime-txt {
				font-size: 0.72rem;
				font-family: ui-monospace, monospace;
				color: #737373;
			}
			.card-title-txt {
				font-size: 1.15rem;
				font-weight: 700;
				color: #f5f5f5;
				margin: 0 0 0.5rem 0;
				line-height: 1.35;
			}
			.archive-post-card:hover .card-title-txt {
				color: #fb7185;
			}
			.card-desc-txt {
				font-size: 0.88rem;
				color: #a3a3a3;
				line-height: 1.55;
				margin: 0 0 1.25rem 0;
			}
			.card-footer-meta {
				display: flex;
				align-items: center;
				justify-content: space-between;
				padding-top: 0.85rem;
				border-top: 1px solid #262626;
				font-size: 0.75rem;
				font-family: ui-monospace, monospace;
				color: #737373;
			}
			.card-action-link {
				color: #fb7185;
				font-weight: 600;
			}

			/* Right Sidebar */
			.archive-right-sidebar {
				min-width: 0;
				width: 100%;
			}
			.sidebar-widget-box {
				background: #171717;
				border: 1px solid #262626;
				border-radius: 16px;
				padding: 1.25rem;
				margin-bottom: 2rem;
				box-sizing: border-box;
			}
			.widget-head-row {
				display: flex;
				align-items: center;
				justify-content: space-between;
				padding-bottom: 0.6rem;
				border-bottom: 1px solid #262626;
				margin-bottom: 1rem;
			}
			.widget-head-title {
				font-size: 0.95rem;
				font-weight: 800;
				color: #f5f5f5;
				display: flex;
				align-items: center;
				gap: 0.4rem;
			}
			.widget-head-tag {
				font-family: ui-monospace, monospace;
				font-size: 0.68rem;
				color: #f43f5e;
				font-weight: 700;
			}

			.ranked-post-link {
				display: flex;
				align-items: flex-start;
				gap: 0.75rem;
				text-decoration: none;
				padding-bottom: 0.85rem;
				border-bottom: 1px dashed #262626;
				margin-bottom: 0.85rem;
				transition: transform 0.15s ease;
			}
			.ranked-post-link:last-child {
				border-bottom: none;
				margin-bottom: 0;
				padding-bottom: 0;
			}
			.ranked-post-link:hover {
				transform: translateX(2px);
			}
			.rank-digit {
				font-size: 1.25rem;
				font-weight: 900;
				font-family: ui-monospace, monospace;
				line-height: 1;
				color: #f43f5e;
				min-width: 1.5rem;
			}
			.rank-headline {
				font-size: 0.85rem;
				font-weight: 700;
				color: #e5e5e5;
				line-height: 1.35;
				margin: 0 0 0.3rem 0;
			}
			.ranked-post-link:hover .rank-headline {
				color: #fb7185;
			}
			.rank-extra-meta {
				font-size: 0.7rem;
				font-family: ui-monospace, monospace;
				color: #737373;
			}

			.dossier-nav-item {
				display: block;
				padding: 0.5rem 0.65rem;
				background: #111111;
				border: 1px solid #262626;
				border-radius: 8px;
				text-decoration: none;
				color: #d4d4d4;
				font-size: 0.82rem;
				font-weight: 600;
				margin-bottom: 0.5rem;
				transition: all 0.15s ease;
			}
			.dossier-nav-item:last-child { margin-bottom: 0; }
			.dossier-nav-item:hover {
				background: #262626;
				color: #f59e0b;
				border-color: #f59e0b;
			}

			/* High-Contrast Light Mode */
			:global(html:not(.dark)) .archive-header h1 { color: #0f172a !important; }
			:global(html:not(.dark)) .archive-header p { color: #475569 !important; }
			:global(html:not(.dark)) .search-box-input {
				background: #ffffff !important;
				border-color: #cbd5e1 !important;
				color: #0f172a !important;
			}
			:global(html:not(.dark)) .filter-btn {
				background: #ffffff !important;
				border-color: #cbd5e1 !important;
				color: #475569 !important;
			}
			:global(html:not(.dark)) .filter-btn.active {
				background: #f43f5e !important;
				color: #ffffff !important;
			}
			:global(html:not(.dark)) .archive-post-card,
			:global(html:not(.dark)) .sidebar-widget-box {
				background: #ffffff !important;
				border-color: #e2e8f0 !important;
				box-shadow: 0 4px 20px rgba(0, 0, 0, 0.04) !important;
			}
			:global(html:not(.dark)) .card-title-txt,
			:global(html:not(.dark)) .widget-head-title,
			:global(html:not(.dark)) .rank-headline {
				color: #0f172a !important;
			}
			:global(html:not(.dark)) .card-desc-txt {
				color: #475569 !important;
			}
			:global(html:not(.dark)) .archive-header,
			:global(html:not(.dark)) .widget-head-row,
			:global(html:not(.dark)) .card-footer-meta {
				border-color: #e2e8f0 !important;
			}
			:global(html:not(.dark)) .dossier-nav-item {
				background: #f8fafc !important;
				border-color: #cbd5e1 !important;
				color: #334155 !important;
			}
			:global(html:not(.dark)) .dossier-nav-item:hover {
				background: #f1f5f9 !important;
				color: #d97706 !important;
			}
		</style>
	</head>
	<body class="bg-neutral-950 text-neutral-200 antialiased min-h-screen">
		<Header />
		<main>
			<div class="archive-header">
				<div>
					<h1>The Failure Ledger Archive</h1>
					<p>Investigative documentation of corporate blunders, career mistakes, and systemic crashes.</p>
				</div>
				<div style="font-family: ui-monospace, monospace; font-size: 0.85rem; color: #f43f5e; font-weight: 700;">
					{posts.length} Documented Case Files
				</div>
			</div>

			<div class="archive-portal-grid">
				<!-- Main Stream (~70%) -->
				<div class="archive-stream">
					<!-- Filter Controls -->
					<div class="archive-filter-bar">
						<input 
							type="text" 
							id="archive-search-input" 
							class="search-box-input" 
							placeholder="Filter case files by keyword, entity, or actor..."
							autocomplete="off"
						/>
					</div>

					<div class="archive-cards-list" id="archive-grid">
						{posts.map((post) => (
							<a 
								href={`/blog/${post.data.slug.replace(/^ko\//, '')}`} 
								class="archive-post-card"
								data-title={post.data.title.toLowerCase()}
								data-desc={post.data.description.toLowerCase()}
								data-category={post.data.category}
							>
								<div>
									<div class="card-meta-header">
										<span class="cat-badge">{post.data.category}</span>
										<span class="readtime-txt">⏱️ {post.data.read_time_minutes || 5} min</span>
									</div>
									<h3 class="card-title-txt">{post.data.title}</h3>
									<p class="card-desc-txt">{post.data.description}</p>
								</div>
								<div class="card-footer-meta">
									<FormattedDate date={post.data.pubDate || new Date()} />
									<span class="card-action-link">Open Case &rarr;</span>
								</div>
							</a>
						))}
					</div>
				</div>

				<!-- Right Sidebar (~30%) -->
				<aside class="archive-right-sidebar">
					<!-- Top 3 Ranked -->
					<div class="sidebar-widget-box">
						<div class="widget-head-row">
							<span class="widget-head-title">🔥 Top Ranked Incidents</span>
							<span class="widget-head-tag">MOST READ</span>
						</div>
						<div>
							{topRankedPosts.map((item) => (
								<a href={`/blog/${item.slug}`} class="ranked-post-link">
									<div class="rank-digit">{item.rank}</div>
									<div>
										<h4 class="rank-headline">{item.title}</h4>
										<div class="rank-extra-meta">
											<span>{item.category}</span>
											<span>•</span>
											<span>{item.votes}</span>
										</div>
									</div>
								</a>
							))}
						</div>
					</div>

					<!-- Themed Dossiers -->
					<div class="sidebar-widget-box">
						<div class="widget-head-row">
							<span class="widget-head-title">📂 Thematic Dossiers</span>
							<span class="widget-head-tag">CURATED</span>
						</div>
						<div>
							<a href="/blog/deleted-production-database-blamed-intern" class="dossier-nav-item">
								📁 The Scapegoat Collection
							</a>
							<a href="/blog/knight-capital-trading-glitch-45-minutes" class="dossier-nav-item">
								⚡ 45-Minute Fast Crashes
							</a>
							<a href="/blog/the-friday-update-that-broke-the-world" class="dossier-nav-item">
								🌋 Cloud Monoculture Failures
							</a>
						</div>
					</div>
				</aside>
			</div>
		</main>
		<Footer />

		<script is:inline>
			const searchInput = document.getElementById('archive-search-input');
			const cards = document.querySelectorAll('.archive-post-card');

			searchInput?.addEventListener('input', (e) => {
				const query = e.target.value.toLowerCase().trim();
				cards.forEach(card => {
					const title = card.getAttribute('data-title') || '';
					const desc = card.getAttribute('data-desc') || '';
					const cat = card.getAttribute('data-category') || '';
					if (title.includes(query) || desc.includes(query) || cat.includes(query)) {
						card.style.display = 'flex';
					} else {
						card.style.display = 'none';
					}
				});
			});
		</script>
	</body>
</html>