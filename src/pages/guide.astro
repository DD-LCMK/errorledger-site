---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE } from '../consts';
import { getKoUrl, getEnUrl } from '../i18n';

const siteBase = (Astro.site || 'https://errorledger.com').toString();
const rawPath = Astro.url.pathname.replace(/\/$/, '') || '/guide';
const koUrl = getKoUrl(siteBase, rawPath);
const enUrl = getEnUrl(siteBase, rawPath);

const breadcrumbs = [
  { name: '홈', url: '/' },
  { name: '스트리머 가이드 데이터뱅크' }
];

const schemaArticle = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "TechArticle",
  "headline": "치지직(CHZZK) 스트리머 완벽 가이드 & 방송 데이터뱅크 — 수익화, OBS 멀티트랙, 스튜디오 마스터",
  "description": "네이버 치지직 스트리머를 위한 실전 가이드. 투네이션 vs 치즈 프로 계약 규정, 유튜브 저작권 방어용 OBS 오디오 멀티트랙 분리 녹화, 치지직 스튜디오 리모컨 200% 활용, 위플랩 룰렛 세팅, OSMU 영상 편집 파이프라인 정리.",
  "author": {
    "@type": "Organization",
    "name": "ErrorLedger"
  },
  "inLanguage": "ko-KR",
  "keywords": "치지직 가이드, 치지직 프로 계약, 투네이션 치지직, OBS 멀티트랙 녹화, 치지직 리모컨, 위플랩 룰렛, 치지직 VOD 보관, 치지직 통나무 포인트, 치지직 스트리머 세팅"
});
---

<!doctype html>
<html lang="ko" class="dark">
  <head>
    <BaseHead
      title={`치지직 스트리머 완벽 가이드 & 데이터뱅크 — ${SITE_TITLE}`}
      description="치지직(CHZZK) 생방송 입문부터 수익화, OBS 4트랙 오디오 분리, 스튜디오 리모컨, 위플랩 룰렛, 유튜브 쇼츠 OSMU 편집 파이프라인까지 검증된 실전 방송 노하우 총정리."
      lang="ko"
      hreflangKo={koUrl}
      hreflangEn={enUrl}
      breadcrumb={breadcrumbs}
      keywords="치지직 스트리머 가이드, 치지직 프로 조건, 투네이션 치즈 비교, OBS 오디오 트랙 분리, 유튜브 저작권 노딱 방어, 치지직 리모컨, 위플랩 치즈 룰렛, OSMU 숏폼 편집, 치지직 다시보기 다운로드, 치지직 통나무 포인트"
    />
    <script type="application/ld+json" set:html={schemaArticle}></script>
  </head>

  <body class="guide-body">
    <Header />

    <!-- Top Reading Progress Indicator -->
    <div class="reading-progress-track" aria-hidden="true">
      <div class="reading-progress-bar" id="reading-progress-bar"></div>
    </div>

    <!-- Mobile Table of Contents Toggle Floating Bar -->
    <aside class="mobile-toc-bar" id="mobile-toc-bar">
      <button type="button" class="mobile-toc-trigger" id="mobile-toc-trigger" aria-expanded="false" aria-controls="guide-sidebar">
        <span class="toc-icon">📑</span>
        <span class="toc-label">목차 펼치기 (가이드 목차)</span>
        <span class="toc-chevron">▾</span>
      </button>
    </aside>

    <div class="guide-wrapper">
      <!-- ====================================================================
           LEFT STICKY SIDEBAR (GitBook / Technical Docs Style)
           ==================================================================== -->
      <aside class="guide-sidebar" id="guide-sidebar" aria-label="가이드 목차 탐색">
        <div class="sidebar-inner">
          <div class="sidebar-header">
            <div class="sidebar-brand-badge">
              <span class="badge-icon">⚡</span>
              <span class="badge-text">CHZZK STREAM LAB</span>
            </div>
            <h2 class="sidebar-title">치지직 가이드 데이터뱅크</h2>
            <p class="sidebar-desc">검증된 실전 방송 워크플로우</p>
          </div>

          <!-- Quick Filter Input -->
          <div class="sidebar-search-box">
            <input 
              type="text" 
              id="sidebar-filter-input" 
              class="sidebar-filter-input" 
              placeholder="챕터 또는 키워드 검색..." 
              aria-label="가이드 목차 필터링"
            />
          </div>

          <!-- Table of Contents Nav Links -->
          <nav class="sidebar-nav" id="sidebar-nav">
            <div class="nav-section-title">GUIDE DIRECTORY</div>

            <!-- Intro Section -->
            <a href="#intro" class="nav-link active" data-target="intro">
              <span class="nav-num">00</span>
              <span class="nav-name">가이드 개요 & 핵심 철학</span>
            </a>

            <!-- Chapter 1 -->
            <div class="nav-chapter-group">
              <a href="#chapter-1" class="nav-link nav-chapter-header" data-target="chapter-1">
                <span class="nav-num">01</span>
                <span class="nav-name">수익화 기초: 투네이션 vs 치즈</span>
              </a>
              <div class="nav-sub-list">
                <a href="#ch1-toonation" class="nav-sub-link" data-target="ch1-toonation">투네이션이란 무엇인가?</a>
                <a href="#ch1-rookie-reason" class="nav-sub-link" data-target="ch1-rookie-reason">루키가 초기에 쓰는 이유</a>
                <a href="#ch1-pro-policy" class="nav-sub-link" data-target="ch1-pro-policy">프로 계약 & 서드파티 배너 금지</a>
                <a href="#ch1-pro-reasons" class="nav-sub-link" data-target="ch1-pro-reasons">프로 전환을 권장하는 이유</a>
                <a href="#ch1-comparison-table" class="nav-sub-link" data-target="ch1-comparison-table">투네이션 vs 치즈 비교표</a>
              </div>
            </div>

            <!-- Chapter 2 -->
            <div class="nav-chapter-group">
              <a href="#chapter-2" class="nav-link nav-chapter-header" data-target="chapter-2">
                <span class="nav-num">02</span>
                <span class="nav-name">OBS 오디오 멀티트랙 분리 녹화</span>
              </a>
              <div class="nav-sub-list">
                <a href="#ch2-chzzk-truth" class="nav-sub-link" data-target="ch2-chzzk-truth">치지직 서버와 OBS의 진실</a>
                <a href="#ch2-three-benefits" class="nav-sub-link" data-target="ch2-three-benefits">로컬 분리의 3대 이득</a>
                <a href="#ch2-step-by-step" class="nav-sub-link" data-target="ch2-step-by-step">Windows 내장 캡처 설정법</a>
                <a href="#ch2-track-matrix" class="nav-sub-link" data-target="ch2-track-matrix">OBS 고급 오디오 매핑 표</a>
              </div>
            </div>

            <!-- Chapter 3 -->
            <div class="nav-chapter-group">
              <a href="#chapter-3" class="nav-link nav-chapter-header" data-target="chapter-3">
                <span class="nav-num">03</span>
                <span class="nav-name">치지직 스튜디오 마스터</span>
              </a>
              <div class="nav-sub-list">
                <a href="#ch3-remote-control" class="nav-sub-link" data-target="ch3-remote-control">실시간 '리모컨' 200% 활용</a>
                <a href="#ch3-anonymous-donor" class="nav-sub-link" data-target="ch3-anonymous-donor">익명 후원자 실명 확인 위치</a>
                <a href="#ch3-weflab-roulette" class="nav-sub-link" data-target="ch3-weflab-roulette">위플랩 치즈 룰렛 완벽 연동</a>
              </div>
            </div>

            <!-- Chapter 4 -->
            <div class="nav-chapter-group">
              <a href="#chapter-4" class="nav-link nav-chapter-header" data-target="chapter-4">
                <span class="nav-num">04</span>
                <span class="nav-name">OSMU 영상 편집 & 방송 생존학</span>
              </a>
              <div class="nav-sub-list">
                <a href="#ch4-editor-comparison" class="nav-sub-link" data-target="ch4-editor-comparison">영상 편집 프로그램 3대장 비교</a>
                <a href="#ch4-five-step-pipeline" class="nav-sub-link" data-target="ch4-five-step-pipeline">추천 OSMU 워크플로우 예시</a>
                <a href="#ch4-vod-retention" class="nav-sub-link" data-target="ch4-vod-retention">치지직 VOD 공식 보관 기한 규정</a>
                <a href="#ch4-log-theory" class="nav-sub-link" data-target="ch4-log-theory">치지직 통나무 파워 & 팬덤 랭킹</a>
              </div>
            </div>
          </nav>

          <!-- Sidebar Footer Quick Tools Widget -->
          <div class="sidebar-tools-box">
            <span class="st-label">에러레저 방송 도구 바로가기</span>
            <div class="st-list">
              <a href="/games/soundboard" class="st-item">🔊 효과음 키패드</a>
              <a href="/chzzk-downloader" class="st-item">📥 치지직·유튜브 다운로더</a>
              <a href="/schedule" class="st-item">📅 방송 편성표 메이커</a>
              <a href="/bzzk" class="st-item">🛡️ 검지직 보안 레이더</a>
            </div>
          </div>
        </div>
      </aside>

      <!-- ====================================================================
           MAIN READING AREA (Prose, Comparison Tables, Callouts, Code Blocks)
           ==================================================================== -->
      <main class="guide-main" id="guide-main">
        <!-- Top Breadcrumbs -->
        <nav class="guide-breadcrumbs" aria-label="Breadcrumb">
          <ol>
            <li><a href="/">에러레저 홈</a></li>
            <li><span class="bc-sep">/</span></li>
            <li><span class="bc-current">가이드 데이터뱅크</span></li>
          </ol>
        </nav>

        <!-- Document Hero Header -->
        <header class="doc-hero" id="intro">
          <div class="hero-tag-row">
            <span class="hero-badge emerald">CHZZK BROADCASTING FIELD MANUAL</span>
            <span class="hero-meta-item">⏱️ 완독 12분</span>
            <span class="hero-meta-item">업데이트: 2026년 최신 개정판</span>
          </div>
          <h1 class="doc-title">치지직 스트리머 실전 가이드 & 데이터뱅크</h1>
          <p class="doc-lead">
            네이버 치지직(CHZZK) 루키 스트리머부터 중견 파트너까지, 방송 현장에서 직면하는 <strong>수익화 규정 분쟁, 유튜브 저작권 노딱 방어, OBS 오디오 세팅, 스튜디오 리모컨 및 OSMU 쇼츠 편집 파이프라인</strong>의 정답만을 명쾌하게 정리한 무설치 방송 지식 베이스입니다.
          </p>

          <div class="doc-stat-strip">
            <div class="stat-pill">
              <span class="stat-num">4개</span>
              <span class="stat-lbl">핵심 챕터</span>
            </div>
            <div class="stat-pill">
              <span class="stat-num">0%</span>
              <span class="stat-lbl">외주 비용 절약</span>
            </div>
            <div class="stat-pill">
              <span class="stat-num">100%</span>
              <span class="stat-lbl">클라이언트 사이드 검증</span>
            </div>
          </div>
        </header>

        <hr class="doc-divider" />

        <!-- ==================================================================
             CHAPTER 1
             ================================================================== -->
        <section class="doc-section" id="chapter-1">
          <div class="section-badge-row">
            <span class="section-num-tag">CHAPTER 01</span>
            <span class="section-topic-tag">MONETIZATION & POLICY</span>
          </div>
          <h2 class="section-title">치지직 수익화 기초: 투네이션 vs 네이버 치즈 & 프로 계약 완벽 정리</h2>
          <p class="section-desc">
            방송 초기 많은 스트리머가 "투네이션을 달아야 할까, 치즈만 받아야 할까?"라는 고민에 빠집니다. 각 시스템의 본질적인 작동 방식과 치지직 프로(Pro) 계약 시 반드시 숙지해야 할 운영 정책을 정리합니다.
          </p>

          <!-- 1.1 투네이션이란 무엇인가? -->
          <article class="doc-card" id="ch1-toonation">
            <h3 class="card-heading">1. 투네이션(Toonation)이란 무엇인가?</h3>
            <p>
              <strong>투네이션(Toonation)</strong>은 네이버 치지직 공식 시스템이 아닌 <em>제3자 외부 서드파티 후원 중개 플랫폼</em>입니다. 스트리머가 투네이션 웹사이트에서 고유한 위젯 URL을 발급받아 OBS 브라우저 소스로 등록하면, 시청자가 투네이션 캐시를 충전하여 전송한 <strong>TTS(음성 메시지), 영상 도네이션, 음성 녹음, 미션/룰렛</strong>이 방송 화면에 실시간으로 출력되는 구조입니다.
            </p>
          </article>

          <!-- 1.2 루키가 초기에 투네이션을 쓰는 현실적 이유 -->
          <article class="doc-card" id="ch1-rookie-reason">
            <h3 class="card-heading">2. 루키 스트리머가 초기에 투네이션을 쓰는 현실적 이유</h3>
            <p>
              치지직 공식 후원 수단인 '치즈'가 있음에도 불구하고, 갓 방송을 시작한 루키(Rookie) 등급 스트리머들이 투네이션을 병행하는 데에는 명확한 이유가 있습니다:
            </p>
            <div class="feature-grid">
              <div class="feature-item">
                <div class="fi-icon">💰</div>
                <div class="fi-title">매우 저렴한 수수료 (정산 효율 극대화)</div>
                <div class="fi-desc">
                  투네이션은 플랫폼 수수료가 매우 저렴하여 스트리머가 실제로 손에 쥐는 실수령 정산 효율이 매우 높습니다. 초반 후원 금액이 적더라도 수수료로 많이 깎이지 않고 온전하게 내 몫으로 챙길 수 있습니다.
                </div>
              </div>
              <div class="feature-item">
                <div class="fi-icon">💵</div>
                <div class="fi-title">소액 정산 가능 (초기 장비 충당)</div>
                <div class="fi-desc">
                  치지직 공식 치즈 정산은 사업자/개인 세무 검증 및 최소 정산 기준 금액이 설정되어 있지만, 투네이션은 소액 후원금도 비교적 빠른 주기로 스트리머 계좌로 출금할 수 있어 마이크나 조명 등 초기 장비 업그레이드 비용을 빠르게 충당할 수 있습니다.
                </div>
              </div>
              <div class="feature-item">
                <div class="fi-icon">🎙️</div>
                <div class="fi-title">다양한 AI 보이스 & 영상 도네 위젯</div>
                <div class="fi-desc">
                  수백 가지의 개성 넘치는 AI 캐릭터 TTS 음성과 시청자 참여형 미션, 룰렛 등 서드파티 특유의 풍부한 리액션 위젯을 활용해 초반 시청자와의 오디오 티키타카를 극대화할 수 있습니다.
                </div>
              </div>
              <div class="feature-item">
                <div class="fi-icon">🔄</div>
                <div class="fi-title">타 플랫폼 동시송출 시 후원 창구 단일화</div>
                <div class="fi-desc">
                  루키 등급에서는 치지직과 유튜브 동시송출이 자유롭기 때문에, 두 플랫폼 시청자의 도네이션 알림 창구를 투네이션 화면 하나로 통일할 수 있다는 강점이 있습니다.
                </div>
              </div>
            </div>
          </article>

          <!-- 1.3 프로 계약 & 서드파티 배너 전면 금지 규정 -->
          <article class="doc-card" id="ch1-pro-policy">
            <h3 class="card-heading">3. 치지직 프로(Pro) 계약 조건과 서드파티 배너 금지 규정</h3>

            <div class="callout-box warning">
              <div class="callout-icon">⚠️</div>
              <div class="callout-body">
                <strong>[중요] 치지직 운영 정책 위반 주의:</strong>
                <p>
                  치지직 프로(Pro) 계약을 체결한 스트리머는 공식 운영 정책상 <strong>투네이션/트윕 등 외부 서드파티 후원 서비스의 사용 및 방송 화면/채널 하단 소개란 배너 등록이 전면 금지</strong>됩니다. 이를 어기고 외부 배너 링크를 남겨둘 경우, 운영 정책 위반으로 경고 조치를 받게 되며, 위반이 지속되거나 심할 경우 수익 창출 권한 박탈 및 계정이 정지될 수 있습니다.
                </p>
              </div>
            </div>

            <h4 class="sub-heading">치지직 프로(Pro) 계약 달성 조건</h4>
            <ul class="styled-list">
              <li><strong>팔로워 수:</strong> 150명 이상</li>
              <li><strong>총 시청자 수:</strong> 최근 1년간 총 시청자 수 500명 이상</li>
              <li><strong>총 방송 시간:</strong> 최근 1년간 총 방송 시간 20시간 이상 생방송 진행</li>
              <li><strong>신청 경로:</strong> 치지직 스튜디오 > 수익 관리 > 수익 창출에서 프로 전환 신청</li>
            </ul>
          </article>

          <!-- 1.4 프로 전환을 권장하는 이유 -->
          <article class="doc-card" id="ch1-pro-reasons">
            <h3 class="card-heading">4. 외부 후원을 포기하고 프로(Pro)로 전환해야 하는 이유</h3>
            <p>
              서드파티 후원 배너가 금지됨에도 불구하고 상위 스트리머들이 프로 계약을 필수적으로 체결하는 이유는 다음과 같습니다:
            </p>
            <ol class="step-list">
              <li>
