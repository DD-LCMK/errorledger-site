---
import BaseHead from '../../components/BaseHead.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { SITE_TITLE } from '../../consts';
import { getKoUrl, getEnUrl } from '../../i18n';
import artistsData from '../../data/chzzk_artists.json';

const siteBase = (Astro.site || 'https://errorledger.com').toString();
const rawPath = Astro.url.pathname.replace(/\/$/, '') || '/en/creators';
const koUrl = getKoUrl(siteBase, rawPath);
const enUrl = getEnUrl(siteBase, rawPath);

const PAGE_TITLE = `Chzzk Broadcast Artists Showcase (Coming Soon) — ${SITE_TITLE}`;
const PAGE_DESCRIPTION = "Curated directory supporting active live broadcasting artists on Chzzk. Zero brokerage fees, zero strings attached — direct live channel outlinks to discover and enjoy incredible creative streams.";
const PAGE_KEYWORDS = "Chzzk artists, stream design, VTuber Live2D rigging, Twitch emote artist, stream overlay designer, waiting screen illustration, livestream artists directory";

const schemaArticle = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "WebPage",
  "name": "Chzzk Broadcasting Artists Showcase",
  "description": PAGE_DESCRIPTION,
  "publisher": {
    "@type": "Organization",
    "name": "ErrorLedger"
  }
});
---

<!doctype html>
<html lang="en" class="dark">
  <head>
    <BaseHead
      title={PAGE_TITLE}
      description={PAGE_DESCRIPTION}
      lang="en"
      hreflangKo={koUrl}
      hreflangEn={enUrl}
      keywords={PAGE_KEYWORDS}
    />
    <script type="application/ld+json" set:html={schemaArticle}></script>
  </head>

  <body class="creators-body">
    <Header />

    <main class="creators-container">
      <!-- Breadcrumb -->
      <nav class="creators-breadcrumb" aria-label="Breadcrumb">
        <ol>
          <li><a href="/en">Home</a></li>
          <li><span class="bc-sep">/</span></li>
          <li><span class="bc-current">Creators Showcase</span></li>
        </ol>
      </nav>

      <!-- Coming Soon Hero Banner -->
      <section class="creators-hero">
        <div class="hero-glow-sphere"></div>
        <div class="hero-status-pill">
          <span class="status-pulse-dot"></span>
          <span class="status-text">💖 Pure Creator Support Project | COMING SOON</span>
        </div>

        <h1 class="hero-title">
          Chzzk Broadcast Artists <span class="gradient-text">Showcase</span>
        </h1>

        <p class="hero-slogan">
          "Zero fees, zero strings attached. Proudly supporting incredible artists streaming live on Chzzk."
        </p>

        <p class="hero-desc">
          This platform was not built for commercial profit, commissions, or transactional gains.<br/>
          It was born from a simple, sincere wish: <strong>to genuinely support artists who stream their creative process live on Chzzk</strong>, while allowing streamers and viewers to <strong>discover great streams, admire inspiring art, and relax together</strong>.
        </p>

        <!-- Core Value Proposition Badges -->
        <div class="value-prop-strip">
          <div class="vp-item">
            <span class="vp-icon">💖</span>
            <div class="vp-text">
              <strong>Zero Expectations (0% Fees)</strong>
              <span>100% free pure community support</span>
            </div>
          </div>
          <div class="vp-item">
            <span class="vp-icon">📺</span>
            <div class="vp-text">
              <strong>Active Chzzk Streamers Only</strong>
              <span>Dedicated strictly to artists who broadcast live</span>
            </div>
          </div>
          <div class="vp-item">
            <span class="vp-icon">🤝</span>
            <div class="vp-text">
              <strong>A Warm Haven for Great Streams</strong>
              <span>Viewers discover gems, artists receive love</span>
            </div>
          </div>
        </div>
      </section>

      <!-- Warm Manifesto Card: Why We Made This -->
      <section class="manifesto-card">
        <div class="manifesto-header">
          <span class="manifesto-tag">FOUNDER'S LETTER</span>
          <h2 class="manifesto-title">"We simply wanted to genuinely support the incredible artists on Chzzk."</h2>
        </div>
        <div class="manifesto-content">
          <p>
            Browsing through live streams on Chzzk, we often encounter extraordinary artists filling their canvases with breathtaking skill and devotion — yet broadcasting quietly to just a few viewers in the corner of the platform.
          </p>
          <p>
            <em>'Wouldn't it be wonderful if more people could gather and watch these mesmerizing creative sessions together?'</em><br/>
            <em>'Wouldn't streamers preparing their broadcasts feel so much more confident commissioning an artist after witnessing their authentic craft live?'</em>
          </p>
          <p>
            ErrorLedger seeks zero brokerage fees and asks for nothing in return from artists.<br/>
            Our sole wish is that <strong>artists who quietly turn on their streams and craft wonders receive the appreciation they deserve</strong>, fostering a warmer culture where <strong>everyone can gather, enjoy quality streams, and admire fantastic artists together</strong>.
          </p>
        </div>

        <div class="manifesto-rule-box">
          <div class="rule-badge">THE SINGLE ESSENTIAL PRINCIPLE</div>
          <div class="rule-body">
            <strong>This showcase is strictly reserved for "Artists who broadcast live on Chzzk":</strong>
            <p>
              This is not a generic freelance agency that merely posts portfolio thumbnails. It is a dedicated sanctuary exclusively for <strong>active creative streamers on Chzzk</strong> who share their real-time painting, rigging, and design journeys with their audience.
            </p>
          </div>
        </div>
      </section>

      <!-- Pre-registration Artist Callout Box -->
      <section class="artist-apply-card">
        <div class="apply-header">
          <div class="apply-tag">ARTIST & VIEWER REGISTRATION</div>
          <h2 class="apply-title">🎨 Stream your creative work on Chzzk? Let us spotlight your channel!</h2>
          <p class="apply-desc">
            No strings attached and zero complicated requirements. If you stream art, Live2D, or stream design on Chzzk, simply share your channel link.<br/>
            We will proudly present your live channel to countless streamers and art lovers visiting ErrorLedger. <em>(Recommendations from enthusiastic viewers are also warmly welcomed!)</em>
          </p>
        </div>

        <div class="apply-criteria-grid">
          <div class="criteria-box">
            <span class="cb-icon">📺</span>
            <strong>Essential: Chzzk Streamer</strong>
            <p>Must have an active Chzzk channel with creative livestream history (Art/Design) within the last 1~2 months</p>
          </div>
          <div class="criteria-box">
            <span class="cb-icon">💖</span>
            <strong>100% Free Listing</strong>
            <p>Zero commissions or platform fees. Includes prominent <strong>[🟢 Watch Chzzk Live Channel]</strong> buttons.</p>
          </div>
          <div class="criteria-box">
            <span class="cb-icon">✉️</span>
            <strong>Artist & Fan Submissions</strong>
            <p>Direct applications by artists as well as fan recommendations ("You have to see this artist's stream!") are welcome.</p>
          </div>
        </div>

        <div class="apply-action-bar">
          <button type="button" class="apply-btn primary" id="open-apply-modal-btn">
            📝 Register Artist / Recommend a Channel →
          </button>
          <a href="/en/contact" class="apply-btn secondary">
            ✉️ Cheer & Inquiries
          </a>
        </div>
      </section>

      <!-- Interactive Preview Showcase -->
      <section class="preview-showcase-section">
        <div class="preview-section-header">
          <div class="preview-badge">SHOWCASE PREVIEW</div>
          <h2 class="section-title">Directory Mockup & Layout Preview</h2>
          <p class="section-desc">
            Upon official launch, creators will be organized by category with direct live stream and portfolio outlinks.
          </p>
        </div>

        <!-- Filter Category Tabs -->
        <div class="category-tabs" role="tablist" aria-label="Category Filters">
          <button class="cat-tab active" data-cat="all">All (4)</button>
          <button class="cat-tab" data-cat="emotes">#Emotes/Badges</button>
          <button class="cat-tab" data-cat="live2d">#Live2D/Rigging</button>
          <button class="cat-tab" data-cat="illustration">#Illustrations/Screens</button>
          <button class="cat-tab" data-cat="overlay">#Overlays/Logos</button>
        </div>

        <!-- Artists Card Grid -->
        <div class="artists-grid" id="artists-grid">
          {artistsData.map((artist) => (
            <article class="artist-card" data-category={artist.category}>
              <div class="preview-watermark">PREVIEW SAMPLE</div>

              <!-- Card Header -->
              <div class="ac-header">
                <div class="ac-avatar" style={`background: ${artist.avatarBg};`}>
                  <span>{artist.avatar}</span>
                </div>
                <div class="ac-info">
                  <div class="ac-name-row">
                    <h3 class="ac-name">{artist.name}</h3>
                    <span class="ac-live-badge">CHZZK CREATOR</span>
                  </div>
                  <div class="ac-category-tag">{artist.categoryLabel}</div>
                </div>
              </div>

              <!-- Tags -->
              <div class="ac-tags">
                {artist.tags.map((tag) => (
                  <span class="tag-pill">{tag}</span>
                ))}
              </div>

              <!-- Bio -->
              <p class="ac-bio">{artist.bioEn || artist.bio}</p>

              <!-- Thumbnails Gallery Preview -->
              <div class="ac-gallery">
                {artist.previewThumbnails.map((thumb) => (
                  <div 
                    class="gallery-item" 
                    style={`background: ${thumb.gradient};`}
                    data-title={thumb.title}
                    data-artist={artist.name}
                  >
                    <span class="thumb-badge">{thumb.badge}</span>
                    <span class="thumb-title">{thumb.title}</span>
                    <span class="thumb-zoom-icon">🔍 Zoom</span>
                  </div>
                ))}
              </div>

              <!-- Action Outlink Buttons -->
              <div class="ac-actions">
                <a 
                  href={artist.chzzkUrl} 
                  target="_blank" 
                  rel="noopener noreferrer" 
                  class="ac-btn chzzk-btn"
                >
                  <span class="btn-dot"></span>
                  🟢 Chzzk Live Channel
                </a>
                <a 
                  href={artist.portfolioUrl} 
                  target="_blank" 
                  rel="noopener noreferrer" 
                  class="ac-btn portfolio-btn"
                >
                  🎨 {artist.portfolioLabelEn || artist.portfolioLabel} ↗
                </a>
              </div>
            </article>
          ))}
        </div>
      </section>

      <!-- Why Choose Chzzk Artists Section -->
      <section class="why-us-section">
        <h2 class="why-title">Why Commission Active Livestreaming Artists?</h2>
        <div class="why-grid">
          <div class="why-card">
            <div class="wc-num">01</div>
            <h3>Deep Understanding of Stream Specs</h3>
            <p>
              Standard freelance platforms often overlook dark-mode chat contrast, 112px emote legibility, and transparency alpha channels. Active livestreaming artists understand these native specifications by heart.
            </p>
          </div>
          <div class="why-card">
            <div class="wc-num">02</div>
            <h3>Real-time Interaction & Transparent Craft</h3>
            <p>
              Artists streaming live on Chzzk actively chat with their viewers, sharing thoughts on creative problem-solving and artistry in real time. Streamers can observe the artist's authentic communication style and working ethic directly with genuine confidence.
            </p>
          </div>
          <div class="why-card">
            <div class="wc-num">03</div>
            <h3>Win-Win Streamer Ecosystem</h3>
            <p>
              ErrorLedger never takes a cut. Streamers discover top-tier talent, and artists earn authentic viewer engagement and community respect.
            </p>
          </div>
        </div>
      </section>

      <!-- FAQ Section -->
      <section class="creators-faq-section">
        <h2 class="faq-headline">Showcase FAQ & Operations</h2>
        <div class="faq-list">
          <details class="faq-item" open>
            <summary class="faq-question">
              <span>Q. Why does ErrorLedger run this showcase for free without expecting anything?</span>
              <span class="faq-chevron">▾</span>
            </summary>
            <div class="faq-answer">
              <p>
                Because we love watching creators! It was founded on a simple desire to help artists and foster a warm ecosystem where streamers and viewers can discover great broadcasts and admire talented artists. We do not intermediate contracts, take cuts, or ask for any payment whatsoever.
              </p>
            </div>
          </details>

          <details class="faq-item">
            <summary class="faq-question">
              <span>Q. Can artists who do not stream on Chzzk register?</span>
              <span class="faq-chevron">▾</span>
            </summary>
            <div class="faq-answer">
              <p>
                <strong>No, they cannot.</strong> The core philosophy of this showcase is "watching live creative broadcasts together". Artists must stream their creative process live on Chzzk so viewers can witness their authentic craft in real time.
              </p>
            </div>
          </details>

          <details class="faq-item">
            <summary class="faq-question">
              <span>Q. What is ErrorLedger's stance on artists utilizing AI tools?</span>
              <span class="faq-chevron">▾</span>
            </summary>
            <div class="faq-answer">
              <p>
                <strong>ErrorLedger does not oppose or discriminate against artists leveraging AI tools.</strong> Utilizing new technologies to work efficiently is a smart and valid creative choice. How and when tools are used is entirely up to open, mutual communication between each artist and their client.<br/>
                Our reason for spotlighting live streamers is not to police tool usage, but to celebrate <strong>genuine real-time communication where creators and viewers discuss art and share creative journeys together</strong>.
              </p>
            </div>
          </details>

          <details class="faq-item">
            <summary class="faq-question">
              <span>Q. Can viewers recommend an artist they love?</span>
              <span class="faq-chevron">▾</span>
            </summary>
            <div class="faq-answer">
              <p>
                Absolutely! If there is an artist whose Chzzk broadcast you enjoy watching, simply click [Register Artist / Recommend a Channel] and share their Chzzk channel link. We will review their broadcast history and proudly list them.
              </p>
            </div>
          </details>

          <details class="faq-item">
            <summary class="faq-question">
              <span>Q. How do streamers commission an artist?</span>
              <span class="faq-chevron">▾</span>
            </summary>
            <div class="faq-answer">
              <p>
                Click <strong>[🟢 Chzzk Live Channel]</strong> to visit the artist's live broadcast and say hello in chat, or use the <strong>[🎨 Portfolio / Inquiry]</strong> button to reach their official commission portal (X, Artmug, etc.).
              </p>
            </div>
          </details>
        </div>
      </section>
    </main>

    <!-- Pre-registration Modal -->
    <div id="apply-modal" class="modal-backdrop" aria-hidden="true">
      <div class="modal-card" role="dialog" aria-modal="true" aria-labelledby="modal-title">
        <button type="button" class="modal-close-btn" id="close-apply-modal-btn" aria-label="Close">✕</button>
        <div class="modal-header">
          <div class="modal-badge">COMMUNITY SPOTLIGHT</div>
          <h3 id="modal-title" class="modal-headline">Register Artist / Recommend a Channel</h3>
          <p class="modal-sub">
            Let us know about an artist who streams live on Chzzk! Both artists and viewer recommendations are welcome.
          </p>
        </div>

        <div class="modal-body">
          <div class="modal-info-box">
            <strong>📌 Information to share:</strong>
            <ul>
              <li><strong>Chzzk Channel URL (Required)</strong> — Must be an artist broadcasting live on Chzzk</li>
              <li><strong>Artist Handle / Nickname</strong></li>
              <li><strong>Category</strong> (Live2D, Emotes, Waiting Screens, Overlays, Illustrations)</li>
              <li><strong>Optional:</strong> Recommendation note or link to portfolio/X</li>
            </ul>
          </div>

          <div class="modal-action-buttons">
            <a 
              href="/en/contact?subject=artist_apply" 
              class="modal-btn primary"
            >
              ✉️ Send Channel Info via Contact Page
            </a>
            <button type="button" class="modal-btn secondary" id="modal-close-btn-bottom">
              Close
            </button>
          </div>
          <p class="modal-notice">
            * 100% free pure community spotlight. No fees, no contracts, zero strings attached.
          </p>
        </div>
      </div>
    </div>

    <!-- Artwork Lightbox Modal -->
    <div id="lightbox-modal" class="modal-backdrop" aria-hidden="true">
      <div class="lightbox-card" role="dialog" aria-modal="true">
        <button type="button" class="modal-close-btn" id="close-lightbox-btn" aria-label="Close">✕</button>
        <div class="lightbox-preview-box" id="lightbox-box">
          <div class="lightbox-content">
            <span class="lightbox-tag">PREVIEW SAMPLE</span>
            <h3 id="lightbox-title">Artwork Title</h3>
            <p id="lightbox-artist">Artist Nickname</p>
            <div class="lightbox-visual" id="lightbox-visual"></div>
          </div>
        </div>
      </div>
    </div>

    <Footer />

    <script is:inline>
      const tabs = document.querySelectorAll('.cat-tab');
      const cards = document.querySelectorAll('.artist-card');

      tabs.forEach(tab => {
        tab.addEventListener('click', () => {
          tabs.forEach(t => t.classList.remove('active'));
          tab.classList.add('active');

          const category = tab.getAttribute('data-cat');
          cards.forEach(card => {
            if (category === 'all' || card.getAttribute('data-category') === category) {
              card.style.display = 'flex';
            } else {
              card.style.display = 'none';
            }
          });
        });
      });

      const openModalBtn = document.getElementById('open-apply-modal-btn');
      const closeModalBtn = document.getElementById('close-apply-modal-btn');
      const closeModalBtnBottom = document.getElementById('modal-close-btn-bottom');
      const applyModal = document.getElementById('apply-modal');

      function openModal() {
        applyModal.classList.add('active');
        applyModal.setAttribute('aria-hidden', 'false');
      }

      function closeModal() {
        applyModal.classList.remove('active');
        applyModal.setAttribute('aria-hidden', 'true');
      }

      if (openModalBtn) openModalBtn.addEventListener('click', openModal);
      if (closeModalBtn) closeModalBtn.addEventListener('click', closeModal);
      if (closeModalBtnBottom) closeModalBtnBottom.addEventListener('click', closeModal);
      if (applyModal) {
        applyModal.addEventListener('click', (e) => {
          if (e.target === applyModal) closeModal();
        });
      }

      const galleryItems = document.querySelectorAll('.gallery-item');
      const lightboxModal = document.getElementById('lightbox-modal');
      const closeLightboxBtn = document.getElementById('close-lightbox-btn');
      const lightboxTitle = document.getElementById('lightbox-title');
      const lightboxArtist = document.getElementById('lightbox-artist');
      const lightboxVisual = document.getElementById('lightbox-visual');

      galleryItems.forEach(item => {
        item.addEventListener('click', () => {
          const title = item.getAttribute('data-title');
          const artist = item.getAttribute('data-artist');
          const bg = item.style.background;

          if (lightboxTitle) lightboxTitle.textContent = title || 'Artwork Preview';
          if (lightboxArtist) lightboxArtist.textContent = `Creator: ${artist || 'Chzzk Artist'}`;
          if (lightboxVisual) lightboxVisual.style.background = bg;

          if (lightboxModal) {
            lightboxModal.classList.add('active');
            lightboxModal.setAttribute('aria-hidden', 'false');
          }
        });
      });

      if (closeLightboxBtn) {
        closeLightboxBtn.addEventListener('click', () => {
          lightboxModal.classList.remove('active');
          lightboxModal.setAttribute('aria-hidden', 'true');
        });
      }
      if (lightboxModal) {
        lightboxModal.addEventListener('click', (e) => {
          if (e.target === lightboxModal) {
            lightboxModal.classList.remove('active');
            lightboxModal.setAttribute('aria-hidden', 'true');
          }
        });
      }
    </script>
  </body>
</html>

<style>
  :root {
    --cr-bg: #090d16;
    --cr-card: #121824;
    --cr-card-inner: #0d121c;
    --cr-border: #233147;
    --cr-border-hover: #3b4e73;
    --cr-cyan: #00ffcc;
    --cr-violet: #7928ca;
    --cr-pink: #ff007a;
    --cr-yellow: #fbbf24;
    --text-primary: #f1f5f9;
    --text-secondary: #94a3b8;
    --text-muted: #64748b;
  }

  body.creators-body {
    background-color: var(--cr-bg);
    color: var(--text-primary);
    font-family: 'Inter', -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
    margin: 0;
    padding: 0;
    line-height: 1.6;
    overflow-x: hidden;
  }

  .creators-container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 1.5rem 1.5rem 5rem;
  }

  /* Breadcrumb */
  .creators-breadcrumb ol {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    list-style: none;
    padding: 0;
    margin: 0 0 1.5rem;
    font-size: 0.85rem;
    color: var(--text-muted);
  }

  .creators-breadcrumb a {
    color: var(--text-secondary);
    text-decoration: none;
    transition: color 0.15s ease;
  }

  .creators-breadcrumb a:hover {
    color: var(--cr-cyan);
  }

  .creators-breadcrumb .bc-sep {
    color: var(--cr-border);
  }

  .creators-breadcrumb .bc-current {
    color: var(--cr-cyan);
    font-weight: 600;
  }

  /* Hero Section */
  .creators-hero {
    position: relative;
    text-align: center;
    padding: 3rem 1.5rem 2.5rem;
    background: linear-gradient(180deg, rgba(18, 24, 36, 0.7) 0%, rgba(9, 13, 22, 0.4) 100%);
    border: 1px solid var(--cr-border);
    border-radius: 16px;
    margin-bottom: 2.5rem;
    overflow: hidden;
  }

  .hero-glow-sphere {
    position: absolute;
    top: -120px;
    left: 50%;
    transform: translateX(-50%);
    width: 450px;
    height: 250px;
    background: radial-gradient(circle, rgba(0, 255, 204, 0.15) 0%, rgba(121, 40, 202, 0.1) 60%, transparent 80%);
    filter: blur(50px);
    pointer-events: none;
  }

  .hero-status-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    background: rgba(251, 191, 36, 0.12);
    border: 1px solid rgba(251, 191, 36, 0.35);
    padding: 0.35rem 0.9rem;
    border-radius: 9999px;
    font-size: 0.78rem;
    font-weight: 700;
    color: var(--cr-yellow);
    margin-bottom: 1.25rem;
  }

  .status-pulse-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--cr-yellow);
    box-shadow: 0 0 8px var(--cr-yellow);
    animation: statusPulse 1.8s infinite;
  }

  @keyframes statusPulse {
    0%, 100% { opacity: 1; transform: scale(1); }
    50% { opacity: 0.4; transform: scale(0.85); }
  }

  .hero-title {
    font-size: 2.35rem;
    font-weight: 800;
    margin: 0 0 0.75rem;
    letter-spacing: -0.02em;
  }

  .gradient-text {
    background: linear-gradient(135deg, var(--cr-cyan) 0%, #38bdf8 50%, var(--cr-violet) 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .hero-slogan {
    font-size: 1.2rem;
    font-weight: 700;
    color: #e2e8f0;
    margin: 0 0 1rem;
  }

  .hero-desc {
    max-width: 720px;
    margin: 0 auto 2rem;
    color: var(--text-secondary);
    font-size: 0.95rem;
    line-height: 1.7;
  }

  /* Value Proposition Strip */
  .value-prop-strip {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1rem;
    max-width: 900px;
    margin: 0 auto;
    text-align: left;
  }

  .vp-item {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    background: rgba(13, 18, 28, 0.8);
    border: 1px solid var(--cr-border);
    padding: 0.85rem 1.15rem;
    border-radius: 12px;
  }

  .vp-icon {
    font-size: 1.6rem;
  }

  .vp-text strong {
    display: block;
    font-size: 0.9rem;
    color: var(--text-primary);
  }

  .vp-text span {
    font-size: 0.75rem;
    color: var(--text-muted);
  }

  /* Founder Manifesto Card */
  .manifesto-card {
    background: linear-gradient(135deg, rgba(121, 40, 202, 0.1) 0%, rgba(18, 24, 36, 0.95) 100%);
    border: 1px solid rgba(121, 40, 202, 0.35);
    border-radius: 16px;
    padding: 2.25rem;
    margin-bottom: 2.5rem;
    position: relative;
    overflow: hidden;
  }

