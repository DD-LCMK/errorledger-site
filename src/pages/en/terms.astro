---
import BaseHead from '../../components/BaseHead.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { SITE_TITLE } from '../../consts';
import { getKoUrl, getEnUrl } from '../../i18n';

const siteBase = Astro.site?.toString() || 'https://errorledger.com';
const rawPath = Astro.url.pathname.replace(/\/$/, '');
const koUrl = getKoUrl(siteBase, rawPath);
const enUrl = getEnUrl(siteBase, rawPath);
---

<!doctype html>
<html lang="en" class="dark">
  <head>
    <BaseHead 
      title={`Terms of Service | StreamArcade`} 
      description="StreamArcade's Terms of Service for free browser-based stream games and interactive broadcast tools." 
      lang="en"
      hreflangKo={koUrl}
      hreflangEn={enUrl}
    />
  </head>
  <body class="static-page-body">
    <Header />

    <main class="static-page-main">
      <div class="content-container">
        <span class="pill-label">Legal & Policy</span>
        <h1>Terms of Service</h1>
        <p class="updated-date"><em>Last updated: September 2026</em></p>

        <p>
          Welcome to <strong>StreamArcade</strong>. By accessing or using our website, interactive tools, and stream games, you agree to comply with and be bound by the following Terms of Service.
        </p>

        <hr class="divider" />

        <h2>1. Purpose & Permitted Use</h2>
        <p>
          StreamArcade provides free, no-install browser-based web games and interactive tools for live content creators, streamers, and viewers across platforms including Twitch, YouTube Live, CHZZK, and SOOP. You may freely use our games for personal entertainment, community events, and commercial or non-commercial live broadcasts (including OBS Studio integration).
        </p>

        <h2>2. Intellectual Property</h2>
        <p>
          The original UI design, website layout, frontend source code, custom 2D physics engine implementations, logos, and brand assets of StreamArcade are the intellectual property of StreamArcade. Traditional game rules and mathematical principles (such as Amidakuji / Ghost Leg, Roulette wheels, and marble gravity tracks) belong to the public domain.
        </p>

        <h2>3. Disclaimer of Warranties</h2>
        <p>
          All features and tools on StreamArcade are provided on an "AS-IS" and "AS-AVAILABLE" basis without warranties of any kind. While we strive for maximum stability and fairness in all random-generation algorithms, we are not liable for any disruptions or perceived inaccuracies caused by client hardware limitations, browser incompatibilities, or network latency.
        </p>

        <h2>4. Changes to Terms</h2>
        <p>
          We reserve the right to update or modify these Terms of Service at any time as new tools or features are introduced. Continued use of StreamArcade following any revisions constitutes your acceptance of the updated terms.
        </p>

        <h2>5. Contact Information</h2>
        <p>
          If you have questions regarding these Terms of Service or our platform, please reach out via our <a href="/en/contact">Contact Page</a> or by email at <code>contact@errorledger.com</code>.
        </p>
      </div>
    </main>

    <Footer />
  </body>
</html>

<style>
  .static-page-body {
    background: #090d16;
    color: #cbd5e1;
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    margin: 0;
    font-family: var(--font-atkinson, -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif);
  }

  .static-page-main {
    flex: 1;
    padding: 3rem 1.5rem;
    max-width: 860px;
    margin: 0 auto;
    width: 100%;
    box-sizing: border-box;
  }

  .content-container {
    background: rgba(15, 23, 42, 0.6);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 16px;
    padding: 2.5rem 2rem;
    backdrop-filter: blur(10px);
  }

  .pill-label {
    display: inline-block;
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: #38bdf8;
    background: rgba(56, 189, 248, 0.1);
    border: 1px solid rgba(56, 189, 248, 0.2);
    padding: 0.2rem 0.6rem;
    border-radius: 999px;
    margin-bottom: 0.75rem;
  }

  h1 {
    color: #f8fafc;
    font-size: 2rem;
    font-weight: 800;
    margin: 0 0 0.5rem;
  }

  .updated-date {
    color: #64748b;
    font-size: 0.85rem;
    margin: 0 0 1.5rem;
  }

  .divider {
    border: none;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
    margin: 1.5rem 0;
  }

  h2 {
    color: #f1f5f9;
    font-size: 1.25rem;
    font-weight: 700;
    margin: 1.75rem 0 0.6rem;
  }

  p {
    line-height: 1.7;
    color: #94a3b8;
    margin: 0 0 1rem;
    font-size: 0.95rem;
  }

  a {
    color: #38bdf8;
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  a:hover {
    color: #7dd3fc;
  }

  code {
    background: rgba(255, 255, 255, 0.08);
    padding: 0.15rem 0.4rem;
    border-radius: 4px;
    font-size: 0.88rem;
    color: #e2e8f0;
  }
</style>
