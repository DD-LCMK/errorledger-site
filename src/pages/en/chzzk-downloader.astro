---
import BaseHead from '../../components/BaseHead.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { SITE_TITLE } from '../../consts';
import { getKoUrl, getEnUrl } from '../../i18n';

const PAGE_TITLE = `Chzzk & YouTube Downloader - Lossless Naver CHZZK & YouTube (4K/FHD/Shorts) Video Downloader | ${SITE_TITLE}`;
const PAGE_DESCRIPTION = "Download Naver CHZZK VODs & clips and YouTube videos & Shorts in original 4K and 1080p FHD quality directly with zero re-encoding loss. Batch queue processing, bundled FFmpeg, 100% free local web app.";
const PAGE_KEYWORDS = "Chzzk Downloader, YouTube Downloader, YouTube Shorts Download, CHZZK VOD Download, Chzzk Clip Download, Naver Chzzk Video Downloader, Chzzk 1080p MP4, YouTube 4K download, Download Chzzk Stream, Naver Video Extractor, Free Video Downloader";

const breadcrumbItems = [
  { name: "Home", url: "/en" },
  { name: "Streamer Tools", url: "/en/tools" },
  { name: "Chzzk & YouTube Downloader" }
];

const fileHash = "007F51936190318FC32602021D8DE0B1A51471B6C161FD6190DCFA1B009D8099";
const fileSize = "53.8 MB";
const appVersion = "v2.0.0";
const downloadUrl = "https://github.com/DD-LCMK/errorledger-engine/releases/latest/download/Chzzk_Downloader.exe";
const githubReleasesUrl = "https://github.com/DD-LCMK/errorledger-engine/releases";
const virusTotalUrl = "https://www.virustotal.com/gui/file/007f51936190318fc32602021d8de0b1a51471b6c161fd6190dcfa1b009d8099";

const softwareSchema = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  "name": "Chzzk & YouTube Downloader",
  "operatingSystem": "Windows 10, Windows 11 (64-bit)",
  "applicationCategory": "MultimediaApplication",
  "offers": {
    "@type": "Offer",
    "price": "0",
    "priceCurrency": "USD"
  },
  "description": PAGE_DESCRIPTION,
  "softwareVersion": appVersion,
  "downloadUrl": downloadUrl
});

const faqSchema = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "Does it support YouTube videos and YouTube Shorts?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes! The latest v2.0.0 update fully supports standard YouTube videos, YouTube Shorts, and shortlinks (youtu.be) alongside Naver Chzzk VODs and clips. Resolutions up to 4K / 1080p FHD as well as standalone audio extraction (.m4a) are supported."
      }
    },
    {
      "@type": "Question",
      "name": "Can I download multiple URLs at once (Batch Queue)?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes! Simply paste multiple video URLs on separate lines in the auto-expanding textarea and click [Add to Queue] (or press Ctrl + Enter). The sequential queue worker processes each job in the background while you continue browsing."
      }
    },
    {
      "@type": "Question",
      "name": "Do I need to install FFmpeg separately?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "No, not at all! FFmpeg is automatically bundled and configured via imageio-ffmpeg inside the executable. High-resolution stream merging and audio extraction work out-of-the-box."
      }
    },
    {
      "@type": "Question",
      "name": "Is Chzzk & YouTube Downloader really 100% free with no limits?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes, it is 100% free with zero costs or download limits. Unlike web services that charge fees or restrict daily downloads, this app runs locally on your PC so there are no remote server hosting costs."
      }
    },
    {
      "@type": "Question",
      "name": "Windows SmartScreen warns about an 'Unknown Publisher'. Is it safe?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes, it is completely safe. Windows shows this dialog for independent software releases that do not bundle expensive commercial EV code-signing certificates. Our builds are distributed transparently via GitHub Releases with public SHA-256 hashes and VirusTotal scan reports. You can verify the checksum and click [More info] → [Run anyway]."
      }
    },
    {
      "@type": "Question",
      "name": "How can I download 19+ age-restricted streams?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Open Settings in the web downloader UI and provide your verified Naver login cookies (NID_AUT, NID_SES). The cookies remain strictly stored on your local machine."
      }
    },
    {
      "@type": "Question",
      "name": "How do I exit the downloader?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Press Ctrl + C in the running terminal window, or simply click the close (X) button on the console window."
      }
    }
  ]
});
---

<!doctype html>
<html lang="en" class="dark">
  <head>
    <BaseHead 
      title={PAGE_TITLE} 
      description={PAGE_DESCRIPTION}
      lang="en"
      hreflangKo={getKoUrl((Astro.site || 'https://errorledger.com').toString(), Astro.url.pathname)}
      hreflangEn={getEnUrl((Astro.site || 'https://errorledger.com').toString(), Astro.url.pathname)}
      keywords={PAGE_KEYWORDS}
    />
    <script type="application/ld+json" set:html={softwareSchema}></script>
    <script type="application/ld+json" set:html={faqSchema}></script>
  </head>
  <body class="chzzk-page-body">
    <Header />

    <main class="chzzk-page-main">
      <!-- 1. Hero Section -->
      <section class="chzzk-hero">
        <div class="hero-backdrop"></div>
        <div class="hero-container">
          <Breadcrumbs items={breadcrumbItems} />

          <div class="hero-pill">
            <span class="pulse-dot"></span>
            <span>🎮 Chzzk & YouTube Support • Continuous Session Queue • 100% Free Utility</span>
          </div>

          <h1 class="hero-headline">
            Chzzk <span class="chzzk-gradient">(CHZZK)</span> & <span class="yt-gradient">YouTube</span><br />
            Lossless High-Speed Downloader
          </h1>

          <p class="hero-subtext">
            Simply paste your Naver CHZZK (<strong>VOD/Clip</strong>) or YouTube (<strong>Video/Shorts</strong>) URL,<br class="hide-mobile" />
            and download pristine 4K & 1080p FHD MP4 files and audio (.m4a) with zero re-encoding loss.
          </p>

          <!-- Download Action Area -->
          <div class="hero-download-box">
            <div class="download-primary-row">
              <a 
                href={downloadUrl} 
                class="btn-chzzk-download"
                id="main-download-btn"
                target="_blank"
                rel="noopener noreferrer"
              >
                <span class="btn-icon">⚡</span>
                <span class="btn-text-group">
                  <span class="btn-main-label">Download Chzzk & YouTube Downloader {appVersion}</span>
                  <span class="btn-sub-label">Windows 64-bit • Official GitHub Release (.exe)</span>
                </span>
                <span class="btn-badge">{fileSize}</span>
              </a>

              <a href={githubReleasesUrl} target="_blank" rel="noopener noreferrer" class="btn-chzzk-github">
                <span>📦 GitHub Releases</span>
              </a>

              <a href="#how-to-use" class="btn-chzzk-guide">
                <span>📖 User Guide</span>
              </a>
            </div>

            <!-- Specs Chips -->
            <div class="hero-specs-row">
              <div class="spec-chip">
                <span class="spec-label">Version:</span>
                <span class="spec-val">{appVersion}</span>
              </div>
              <div class="spec-chip">
                <span class="spec-label">Size:</span>
                <span class="spec-val">{fileSize}</span>
              </div>
              <div class="spec-chip">
                <span class="spec-label">Distribution:</span>
                <span class="spec-val">GitHub Releases</span>
              </div>
              <div class="spec-chip">
                <span class="spec-label">OS:</span>
                <span class="spec-val">Windows 10 / 11 (64-bit)</span>
              </div>
              <div class="spec-chip highlight">
                <span class="spec-label">Price:</span>
                <span class="spec-val">100% Free Forever (No Ads/Paywalls)</span>
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- 2. CRITICAL Security & Safe Download Notice -->
      <section class="chzzk-security-section" id="security-notice">
        <div class="security-card">
          <div class="security-header">
            <div class="security-badge">
              <span class="shield-icon">🛡️</span>
              <span>Official Release Integrity Verification</span>
            </div>
            <h2>"Distributed officially via GitHub Releases. Verify binary integrity with cryptographic SHA-256."</h2>
            <p class="security-lead">
              Downloading modified or re-uploaded files from third-party mirrors, forums, or Discord is risky.<br />
              ErrorLedger distributes official builds via GitHub Releases alongside published SHA-256 checksums and multi-engine VirusTotal scan reports.
            </p>
          </div>

          <div class="security-grid">
            <div class="sec-item">
              <div class="sec-icon">🔒</div>
              <div class="sec-content">
                <h3>Native Stream Downloader (Direct Official CDN)</h3>
                <p>
                  This application simply retrieves the public progressive MP4 media stream URL served by Naver CHZZK's official CDN for standard web playback, and saves it locally. It performs zero exploit techniques, zero privilege escalation, and zero modifications to your operating system.
                </p>
              </div>
            </div>

            <div class="sec-item">
              <div class="sec-icon">💻</div>
              <div class="sec-content">
                <h3>Isolated Local Web Server (Runs on your PC)</h3>
                <p>
                  The utility launches an ultra-lightweight web server strictly inside your own computer (<code>http://localhost:5000</code>). No sensitive account tokens or private telemetry are ever sent to unknown external servers.
                </p>
              </div>
            </div>

            <div class="sec-item">
              <div class="sec-icon">⚠️</div>
              <div class="sec-content">
                <h3>Windows SmartScreen "Unknown Publisher" Notice</h3>
                <p>
                  Because this is an independent, free open tool without a multi-thousand dollar commercial EV code-signing certificate, Windows Defender SmartScreen may display an <em>"Unknown Publisher / Windows protected your PC"</em> prompt on first run.<br />
                  This is standard for independently published software. Verify the SHA-256 hash if desired, then click <strong>[More info] → [Run anyway]</strong>.
                </p>
              </div>
            </div>

            <div class="sec-item">
              <div class="sec-icon">🔑</div>
              <div class="sec-content">
                <h3>Cryptographic Verification (SHA-256 & VirusTotal)</h3>
                <p class="hash-desc">
                  You can verify the authenticity and integrity of your downloaded binary using Windows PowerShell or inspect the VirusTotal report:
                </p>
                <div class="hash-box">
                  <code>{fileHash}</code>
                  <button class="btn-copy-hash" id="copy-hash-btn" title="Copy Hash">Copy</button>
                </div>
                <div class="security-verify-links">
                  <a href={virusTotalUrl} target="_blank" rel="noopener noreferrer" class="link-virustotal">
                    🛡️ View VirusTotal Scan Results ↗
                  </a>
                  <a href={githubReleasesUrl} target="_blank" rel="noopener noreferrer" class="link-github-release">
                    📦 View GitHub Release Notes ↗
                  </a>
                </div>
                <span class="hash-tip">PowerShell verification: <code>Get-FileHash Chzzk_Downloader.exe</code></span>
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- 3. Visual Screenshots Showcase -->
      <section class="chzzk-screenshots-section">
        <div class="section-title-wrap">
          <span class="section-pill">LIVE PREVIEW</span>
          <h2>Intuitive & Modern User Interface</h2>
          <p>Designed with CHZZK's authentic dark aesthetic and neon green accents for a seamless experience.</p>
        </div>

        <div class="screenshots-grid">
          <!-- Web UI Screenshot -->
          <div class="screenshot-card">
            <div class="screenshot-card-header">
              <div class="window-dots">
                <span class="dot red"></span>
                <span class="dot yellow"></span>
                <span class="dot green"></span>
              </div>
              <span class="window-title">Chzzk Downloader Web UI (http://localhost:5000)</span>
            </div>
            <div class="screenshot-img-wrap">
              <img 
                src="/images/chzzk/chzzk-downloader-preview.png" 
                alt="Chzzk Downloader Web UI Screenshot" 
                loading="lazy" 
                class="screenshot-img"
              />
            </div>
            <div class="screenshot-caption">
              <strong>✨ One-Click URL Fetch & Multi-Link Queue Management</strong>: Paste single or multiple links at once! The background engine resolves titles in parallel and tracks live speed, ETA, and progress.
            </div>
          </div>

          <!-- Console Terminal Screenshot -->
          <div class="screenshot-card">
            <div class="screenshot-card-header">
              <div class="window-dots">
                <span class="dot red"></span>
                <span class="dot yellow"></span>
                <span class="dot green"></span>
              </div>
              <span class="window-title">Chzzk_Downloader.exe Background Console</span>
            </div>
            <div class="screenshot-img-wrap">
              <img 
                src="/images/chzzk/chzzk-downloader-terminal.png" 
                alt="Chzzk Downloader Terminal Console Screenshot" 
                loading="lazy" 
                class="screenshot-img terminal-img"
              />
            </div>
            <div class="screenshot-caption">
              <strong>⚡ Bundled FFmpeg & Lightweight Server</strong>: <code>imageio-ffmpeg</code> is bundled automatically for seamless 4K/FHD merging. Double-click launches the server, and <code>Ctrl + C</code> safely shuts it down.
            </div>
          </div>
        </div>
      </section>

      <!-- 4. Key Features Grid -->
      <section class="chzzk-features-section">
        <div class="section-title-wrap">
          <span class="section-pill">KEY FEATURES</span>
          <h2>6 Key Advantages Over Other Sites</h2>
          <p>No paywalls, no download quotas, and zero quality compression.</p>
        </div>

        <div class="features-grid">
          <div class="feature-card">
            <div class="feature-icon">🎥</div>
            <h3>1. Chzzk & YouTube Multi-Platform</h3>
            <p>
              Download standard YouTube videos, YouTube Shorts, and shortlinks (<code>youtu.be</code>) alongside Naver CHZZK VODs and clips.
            </p>
            <ul class="feature-list">
              <li>CHZZK VODs (<code>chzzk.naver.com/video/...</code>) & Clips</li>
              <li>YouTube standard videos & YouTube Shorts</li>
              <li>Resolutions up to 4K / 1080p FHD plus audio extraction (<code>.m4a</code>)</li>
            </ul>
          </div>

          <div class="feature-card">
            <div class="feature-icon">⚙️</div>
            <h3>2. Automated Bundled FFmpeg Engine</h3>
            <p>
              Zero manual setup required. <code>imageio-ffmpeg</code> is bundled directly within the executable.
            </p>
            <ul class="feature-list">
              <li>Automatically multiplexes video and audio streams seamlessly</li>
              <li>No external dependencies, Python runtimes, or system PATH editing needed</li>
              <li>Lossless stream preservation with zero sync drift</li>
            </ul>
          </div>

          <div class="feature-card">
            <div class="feature-icon">📋</div>
            <h3>3. Session Download Queue & Background Worker</h3>
            <p>
              Non-blocking downloads allow you to search and inspect new videos while active jobs download sequentially in the background.
            </p>
            <ul class="feature-list">
              <li>Sequential queue worker prevents network bandwidth and CPU bottlenecks</li>
              <li>Consistent session order numbers (<code>#1</code>, <code>#2</code>, <code>#3</code>...)</li>
              <li>Live metrics: progress bar, speed (MB/s), ETA countdown, and status badges</li>
              <li>Cancel individual jobs, cancel all remaining items, or clear completed items</li>
            </ul>
          </div>

          <div class="feature-card">
            <div class="feature-icon">🚀</div>
            <h3>4. Multi-URL Batch Input & Real-Time Title Resolution</h3>
            <p>
              Paste multiple links separated by newlines to queue dozens of videos at once.
            </p>
            <ul class="feature-list">
              <li>Auto-expanding multi-line textarea with intuitive <kbd>Ctrl</kbd> + <kbd>Enter</kbd> submit</li>
              <li>Dynamic action button: switches from Single Fetch to <strong>[🚀 Add N Videos to Queue]</strong></li>
              <li>Parallel thread pool (<code>ThreadPoolExecutor</code>) resolves video titles in 1–2s</li>
              <li>Collision-safe filenames save directly to <code>[Title].mp4</code> with <code>(1)</code>, <code>(2)</code> fallbacks</li>
            </ul>
          </div>

          <div class="feature-card">
            <div class="feature-icon">📁</div>
            <h3>5. Live Telemetry & One-Click Folder Reveal</h3>
            <p>
              Monitor download throughput in real time and access files immediately upon completion.
            </p>
            <ul class="feature-list">
              <li>One-click <strong>[Open Saved Folder]</strong> reveals downloaded MP4 files in Windows Explorer</li>
              <li>Custom download directory selector in Settings (store to external drives, etc.)</li>
              <li>19+ adult broadcast cookie authentication (<code>NID_AUT</code>, <code>NID_SES</code>)</li>
            </ul>
          </div>

          <div class="feature-card highlight-card">
            <div class="feature-icon">🎁</div>
            <h3>6. 100% Free Forever • Unlimited</h3>
            <p>
              Unlike commercial downloader websites, there are no artificial throttles, subscriptions, or predatory popups.
            </p>
            <ul class="feature-list">
              <li>No account registration or login required</li>
              <li>Unlimited downloads with no file-size caps</li>
              <li>Clean, ad-free local user interface</li>
            </ul>
          </div>
        </div>
      </section>

      <!-- 5. Step-by-Step Guide -->
      <section class="chzzk-guide-section" id="how-to-use">
        <div class="section-title-wrap">
          <span class="section-pill">HOW TO RUN</span>
          <h2>Quick 1-Minute Getting Started Guide</h2>
          <p>No installer required. Simply download and double-click to launch.</p>
        </div>

        <div class="steps-container">
          <div class="step-card">
            <div class="step-number">1</div>
            <div class="step-body">
              <h3>Download the Executable</h3>
              <p>
                Click the <strong>[Download Chzzk & YouTube Downloader]</strong> button above to download <code>Chzzk_Downloader.exe</code> to your computer.
              </p>
            </div>
          </div>

          <div class="step-card">
            <div class="step-number">2</div>
            <div class="step-body">
              <h3>Double-Click to Launch (Recommended)</h3>
              <p>
                Double-click <code>Chzzk_Downloader.exe</code>. The terminal will start the server and automatically open <code>http://localhost:5000</code> in your default browser.
              </p>
              <div class="step-subtip">
                * If the browser doesn't open automatically, open your browser and navigate to <code>http://localhost:5000</code> manually.
              </div>
            </div>
          </div>

          <div class="step-card">
            <div class="step-number">3</div>
            <div class="step-body">
              <h3>Paste Chzzk or YouTube URLs</h3>
              <p>
                Copy your CHZZK (VOD/Clip) or YouTube (Video/Shorts) URL. For batch downloading, simply paste multiple links separated by newlines into the input box.
              </p>
            </div>
          </div>

          <div class="step-card">
            <div class="step-number">4</div>
            <div class="step-body">
              <h3>Select Quality or Batch Add to Queue</h3>
              <p>
                For a single video, select your preferred resolution (4K, 1080p, audio) and download. For multiple URLs, click <strong>[🚀 Batch Add to Queue]</strong> to download in sequence.
              </p>
            </div>
          </div>

          <div class="step-card">
            <div class="step-number">5</div>
            <div class="step-body">
              <h3>Open Saved Folder</h3>
              <p>
                When download finishes, click <strong>[저장된 폴더 열기 (Open Folder)]</strong> to view your pristine video file in Windows File Explorer!
              </p>
            </div>
          </div>
        </div>

        <!-- Terminal Run Alternative -->
        <div class="cli-method-box">
          <div class="cli-title">
            <span class="terminal-icon">⌨️</span>
            <h4>For Developers & Python Users: Run from Source</h4>
          </div>
          <p>
            You can also run the application directly from source on Python 3.9+:
          </p>
          <pre><code>python app.py</code></pre>
          <p class="cli-subtext">After starting, open <code>http://localhost:5000</code> in your browser for the same graphical UI.</p>
        </div>
      </section>

      <!-- 6. Save Location & Settings -->
      <section class="chzzk-settings-section">
        <div class="settings-box">
          <div class="settings-left">
            <span class="settings-icon">📁</span>
            <div>
              <h3>Default Save Location & Custom Folders</h3>
              <p>
                Downloaded files are stored by default at:<br />
                <code>This PC &gt; Downloads &gt; Chzzk_Downloads</code>
              </p>
              <p class="settings-hint">
                To save to an external hard drive or custom workspace, click the <strong>[Settings (Gear)]</strong> icon in the top right corner of the web interface anytime.
              </p>
            </div>
          </div>
        </div>
      </section>

      <!-- 7. Precautions & Copyright -->
      <section class="chzzk-notice-section">
        <div class="notice-card">
          <div class="notice-header">
            <span class="notice-icon">📌</span>
            <h3>Copyright & Usage Disclaimer</h3>
          </div>
          <ul class="notice-list">
            <li>This program is an unofficial open utility developed for <strong>personal archival, educational, and research purposes</strong>.</li>
            <li>All copyrights, trademarks, and intellectual property rights in downloaded video content belong to <strong>the respective streamers and original copyright holders (Naver CHZZK)</strong>.</li>
            <li>Redistributing, commercially broadcasting, or re-uploading protected content without the copyright holder's authorization may infringe applicable copyright laws. The user bears full legal responsibility for how downloaded content is used.</li>
          </ul>
        </div>
      </section>

      <!-- 8. FAQ Section -->
      <section class="chzzk-faq-section">
        <div class="section-title-wrap">
          <span class="section-pill">FAQ</span>
          <h2>Frequently Asked Questions</h2>
        </div>

        <div class="faq-accordion">
          <details class="faq-item" open>
            <summary class="faq-question">
              <span>Q. Does it support YouTube videos and YouTube Shorts?</span>
              <span class="faq-arrow">▾</span>
            </summary>
            <div class="faq-answer">
              <p>
                Yes! The v2.0.0 update introduces full support for standard YouTube videos, YouTube Shorts, and shortlinks (<code>youtu.be</code>) alongside Naver CHZZK VODs and clips. Resolutions up to 4K / 1080p FHD as well as audio extraction (<code>.m4a</code>) are supported.
              </p>
            </div>
          </details>

          <details class="faq-item">
            <summary class="faq-question">
              <span>Q. Can I batch download multiple video URLs simultaneously?</span>
              <span class="faq-arrow">▾</span>
            </summary>
            <div class="faq-answer">
              <p>
                Yes! Paste multiple URLs on separate lines in the multi-line input box and click <strong>[🚀 Batch Add to Queue]</strong> (<kbd>Ctrl</kbd> + <kbd>Enter</kbd>). The sequential queue worker processes each download safely in the background while you inspect or add more videos.
              </p>
            </div>
          </details>

          <details class="faq-item">
            <summary class="faq-question">
              <span>Q. Do I need to install FFmpeg manually?</span>
              <span class="faq-arrow">▾</span>
            </summary>
            <div class="faq-answer">
              <p>
                No! The <code>imageio-ffmpeg</code> engine is pre-bundled inside the single executable. High-quality video merging and audio extractions are completely automated with zero configuration.
              </p>
            </div>
          </details>

          <details class="faq-item">
            <summary class="faq-question">
              <span>Q. Is it truly 100% free with no hidden fees or download limits?</span>
              <span class="faq-arrow">▾</span>
            </summary>
            <div class="faq-answer">
              <p>
                Yes, completely free! Unlike commercial web downloaders that charge recurring fees or restrict downloads to 3–5 videos per day, this utility runs <strong>locally on your own PC</strong> as a standalone micro-server. Because we incur zero central server hosting bandwidth costs, you enjoy unlimited high-speed downloads forever.
              </p>
            </div>
          </details>

          <details class="faq-item">
            <summary class="faq-question">
              <span>Q. Why does Windows show an "Unknown Publisher" warning? Is it safe?</span>
              <span class="faq-arrow">▾</span>
            </summary>
            <div class="faq-answer">
              <p>
                It is 100% safe. Microsoft Windows displays SmartScreen warnings for newly built executables that do not have expensive enterprise Extended Validation (EV) code-signing certificates. Simply click <strong>[More info] → [Run anyway]</strong>. You can verify the file integrity against our published SHA-256 hash (<code>{fileHash}</code>) anytime.
