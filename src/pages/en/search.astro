---
import BaseHead from '../../components/BaseHead.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { SITE_TITLE } from '../../consts';
import { getCollection } from 'astro:content';
import { getKoUrl, getEnUrl } from '../../i18n';

const allGames = await getCollection('games');

const CATEGORY_MAP: Record<string, string> = {
  stream: 'Stream / Giveaway',
  arcade: 'Arcade',
  puzzle: 'Puzzle',
  word: 'Word / Brain',
  card: 'Card / Board',
  strategy: 'Strategy'
};

const EN_TITLES: Record<string, string> = {
  'marble-roulette': 'Marble Race Roulette',
  'roulette': 'Random Spin Wheel',
  'ladder': 'Ghost Leg Ladder Game (Amidakuji)',
  'drinking-marble': 'Blossom Board (Party Dice Game)',
  'stream-doodle': 'Stream Doodle (Animated GIF Studio)',
  'stream-emoji': 'Stream Emoji (Animated Emote Maker)',
  'ai-music-quiz': 'AI Music Quiz (Guess The Song)',
  'soundboard': 'Broadcast Keypad Soundboard',
  'fortune': 'Daily Fortune & Horoscope',
};

const EN_DESCS: Record<string, string> = {
  'marble-roulette': 'Real-time 2D physics simulation marble race with 7,200px long track and bouncy obstacles.',
  'roulette': 'Ratchet-click custom prize wheel with winner confetti and one-click quick presets.',
  'ladder': 'Bijective 1-to-1 ghost leg ladder game for 2 to 20 players with neon footstep trail animation.',
  'drinking-marble': 'Monopoly-style board game with 3D rolling dice, custom tiles, and streamer mini-penalties.',
  'stream-doodle': 'Draw animated GIFs with live line boil, color palettes, and transparent OBS browser source overlay.',
  'stream-emoji': 'Create 16-frame pixel & animated emote spritesheets for Twitch, YouTube, and Discord.',
  'ai-music-quiz': 'Listen to AI rearranged song previews and guess the title with side-by-side video reveals.',
  'soundboard': 'Instant zero-latency web soundboard with 9 numpad shortcuts, hold mode, and custom audio upload slots.',
  'fortune': 'Daily auto-updated zodiac and horoscope fortune cookie for stream openers and viewer chat.',
};

const siteBase = (Astro.site || 'https://errorledger.com').toString();
const koUrl = getKoUrl(siteBase, '/search');
const enUrl = getEnUrl(siteBase, '/search');
---

<!doctype html>
<html lang="en" class="dark">
  <head>
    <BaseHead 
      title={`Search Stream Tools & Games | ErrorLedger`} 
      description="Search free browser-based interactive stream games, spin wheel roulette, marble race, ladder, soundboard, and stream tools on ErrorLedger." 
      lang="en"
      hreflangKo={koUrl}
      hreflangEn={enUrl}
    />
  </head>
  <body class="search-page-body">
    <Header />

    <main class="search-main">
      <div class="search-header">
        <h1>Search Stream Tools & Games</h1>
        <p>Find no-install interactive browser games, giveaways, and stream utilities for live broadcasters.</p>
        <div class="search-input-wrapper">
          <input 
            type="text" 
            id="game-search-input" 
            placeholder="Search by name, category, or keywords (e.g. wheel, marble, ladder, soundboard...)" 
            autocomplete="off" 
            autofocus 
          />
        </div>
      </div>

      <div class="games-results-grid" id="results-grid">
        {allGames.map(game => {
          const title = EN_TITLES[game.id] || game.data.title;
          const desc = EN_DESCS[game.id] || game.data.description;
          const href = game.id === 'fortune' ? '/en/fortune' : `/en/games/${game.id}`;
          const cat = CATEGORY_MAP[game.data.category] || game.data.category;

          return (
            <article 
              class="search-game-card" 
              data-title={`${title} ${game.data.title}`.toLowerCase()} 
              data-cat={`${cat} ${game.data.category}`.toLowerCase()} 
              data-desc={`${desc} ${game.data.description}`.toLowerCase()}
            >
              <div class="card-icon">{game.data.icon}</div>
              <div class="card-text">
                <h3><a href={href}>{title}</a></h3>
                <p class="tagline">{game.data.tagline}</p>
                <p class="desc">{desc}</p>
                <div class="badge-row">
                  <span class="pill">{cat}</span>
                  <span class="pill">{game.data.playTime}</span>
                </div>
              </div>
            </article>
          );
        })}
      </div>
    </main>

    <Footer />
  </body>
</html>

<style>
  .search-page-body {
    background: #090d16 !important;
    color: #f1f5f9 !important;
    min-height: 100vh;
    display: flex;
    flex-direction: column;
  }

  .search-main {
    flex: 1;
    max-width: 900px;
    margin: 0 auto;
    padding: 3rem 1.5rem 5rem;
    width: 100%;
  }

  .search-header {
    text-align: center;
    margin-bottom: 2.5rem;
  }

  h1 {
    font-size: 2.2rem;
    font-weight: 900;
    color: #f8fafc;
    margin: 0 0 0.5rem;
  }

  .search-header p {
    color: #94a3b8;
    margin: 0 0 1.5rem;
  }

  .search-input-wrapper {
    max-width: 540px;
    margin: 0 auto;
  }

  #game-search-input {
    width: 100%;
    padding: 0.85rem 1.25rem;
    background: #0f172a;
    border: 2px solid rgba(168, 85, 247, 0.35);
    border-radius: 12px;
    color: #ffffff;
    font-size: 1rem;
    outline: none;
    transition: border-color 0.2s ease, box-shadow 0.2s ease;
  }

  #game-search-input:focus {
    border-color: #38bdf8;
    box-shadow: 0 0 20px rgba(56, 189, 248, 0.3);
  }

  .games-results-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.25rem;
  }

  .search-game-card {
    background: #0f172a;
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 14px;
    padding: 1.5rem;
    display: flex;
    align-items: center;
    gap: 1.5rem;
    transition: transform 0.15s ease, border-color 0.15s ease;
  }

  .search-game-card:hover {
    transform: translateY(-2px);
    border-color: rgba(56, 189, 248, 0.4);
  }

  .card-icon {
    font-size: 3rem;
    background: rgba(255, 255, 255, 0.04);
    border-radius: 12px;
    width: 70px;
    height: 70px;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .card-text {
    flex: 1;
  }

  .card-text h3 {
    font-size: 1.3rem;
    font-weight: 800;
    margin: 0 0 0.2rem;
  }

  .card-text h3 a {
    color: #f8fafc;
    text-decoration: none;
  }

  .card-text h3 a:hover {
    color: #38bdf8;
  }

  .tagline {
    font-size: 0.85rem;
    color: #38bdf8;
    margin: 0 0 0.4rem;
  }

  .desc {
    font-size: 0.88rem;
    color: #94a3b8;
    line-height: 1.5;
    margin: 0 0 0.75rem;
  }

  .badge-row {
    display: flex;
    gap: 0.5rem;
  }

  .pill {
    background: rgba(255, 255, 255, 0.06);
    color: #cbd5e1;
    font-size: 0.75rem;
    font-weight: 700;
    padding: 0.2rem 0.55rem;
    border-radius: 6px;
    text-transform: uppercase;
  }

  .hidden {
    display: none !important;
  }

  @media (max-width: 640px) {
    .search-game-card {
      flex-direction: column;
      text-align: center;
    }
    .badge-row {
      justify-content: center;
    }
  }
</style>

<script>
  const searchInput = document.getElementById('game-search-input') as HTMLInputElement;
  const cards = document.querySelectorAll('.search-game-card');

  function filterCards(query: string) {
    const q = query.toLowerCase().trim();
    cards.forEach(card => {
      const title = card.getAttribute('data-title') || '';
      const cat = card.getAttribute('data-cat') || '';
      const desc = card.getAttribute('data-desc') || '';
      const match = !q || title.includes(q) || cat.includes(q) || desc.includes(q);
      if (match) {
        card.classList.remove('hidden');
      } else {
        card.classList.add('hidden');
      }
    });
  }

  if (searchInput) {
    searchInput.addEventListener('input', (e) => {
      filterCards((e.target as HTMLInputElement).value);
    });

    // Check URL ?q= query param on load
    const urlParams = new URLSearchParams(window.location.search);
    const initialQuery = urlParams.get('q');
    if (initialQuery) {
      searchInput.value = initialQuery;
      filterCards(initialQuery);
    }
  }
</script>
