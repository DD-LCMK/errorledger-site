const koUrl = getKoUrl(siteBase, rawPath);
const enUrl = getEnUrl(siteBase, rawPath);

const breadcrumbs = [
  { name: 'Home', url: '/en' },
  { name: 'Streamer Guide & Data Bank' }
];

const schemaArticle = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "TechArticle",
  "headline": "Chzzk (치지직) Streamer Master Guide & Data Bank — OBS Multi-track, Monetization & Studio Workflows",
  "description": "Essential field manual for live streamers on Naver Chzzk, YouTube Live, and Twitch. Toonation vs Cheese Pro policy, OBS 4-track audio separation for YouTube copyright defense, Chzzk Studio remote controller, and OSMU editing pipeline.",
  "author": {
    "@type": "Organization",
    "name": "ErrorLedger"
  },
  "inLanguage": "en-US",
  "keywords": "Chzzk Guide, Chzzk Pro Partner, OBS Audio Multi-track, YouTube Copyright Defense, Chzzk Remote Controller, Weflab Roulette, Chzzk VOD Download, OSMU Shorts Editing, Chzzk Tongnamu Log Points"
});
