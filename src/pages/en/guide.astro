  @media (max-width: 1024px) {
    .guide-wrapper {
      grid-template-columns: 1fr;
      padding: 1rem 1rem 3rem;
    }

    .mobile-toc-bar {
      display: block;
    }

    .guide-sidebar {
      display: none;
      position: fixed;
      top: 108px;
      left: 0;
      right: 0;
      bottom: 0;
      width: 100%;
      height: calc(100vh - 108px);
      background: rgba(10, 13, 20, 0.98);
      backdrop-filter: blur(14px);
      z-index: 998;
      padding: 1.5rem;
