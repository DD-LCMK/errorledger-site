  .doc-end-card {
    background: radial-gradient(circle at 50% 20%, #1c273c 0%, #101726 100%);
    border: 1.5px solid var(--doc-border);
    border-radius: 16px;
    padding: 2.25rem 1.5rem;
    text-align: center;
    display: flex;
