---
import BaseHead from '../../components/BaseHead.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { getCollection } from 'astro:content';
import { getKoUrl, getEnUrl } from '../../i18n';

const urlParams = Astro.url.searchParams;
const streamerMode = urlParams.has('stream') || urlParams.has('obs');

const games = await getCollection('games');
const priorityOrder = ['marble-roulette', 'roulette', 'ladder', 'drinking-marble', 'ai-music-quiz', 'stream-doodle', 'stream-emoji', 'fortune'];
const sortedGames = games.sort((a, b) => {
  const idxA = priorityOrder.indexOf(a.id);
  const idxB = priorityOrder.indexOf(b.id);
  return (idxA !== -1 ? idxA : 99) - (idxB !== -1 ? idxB : 99);
});

const siteBase = Astro.site?.toString() || 'https://errorledger.com';
const rawPath = Astro.url.pathname.replace(/\/$/, '') || '/en';
const koUrl = getKoUrl(siteBase, rawPath);
const enUrl = getEnUrl(siteBase, rawPath);

const homeFaqSchema = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "Can I use ErrorLedger on stream or in monetized YouTube videos?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes, absolutely! All games and interactive tools on ErrorLedger are 100% free to use for live broadcasting on Twitch, YouTube Live, CHZZK, SOOP, and for monetized video creation and viewer donations."
      }
    },
    {
      "@type": "Question",
      "name": "How do I use fullscreen or focus mode?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Click the [⛶ Fullscreen] or [📺 Focus Mode] button in any game to fill your screen cleanly without any browser chrome for a distraction-free experience."
      }
    },
    {
      "@type": "Question",
      "name": "Is ErrorLedger free? Do I need to sign up?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes — 100% free, forever. No login, no account, no download required. Every tool is ready to use in your browser within seconds."
      }
    },
    {
      "@type": "Question",
      "name": "Does it work on Twitch, YouTube Live, and other platforms?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes. ErrorLedger is a standard web app that works in any browser, making it compatible with Twitch, YouTube Live, CHZZK, SOOP (AfreecaTV), Kick, and any other streaming platform."
      }
    },
    {
      "@type": "Question",
      "name": "Are the results fair? Can results be manipulated?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "The Wheel and Ladder games use cryptographically seeded pseudo-random algorithms and mathematical bijective mapping. No one can predict or manipulate the outcome."
      }
    },
    {
      "@type": "Question",
      "name": "What is ErrorLedger?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "ErrorLedger provides 100% free, client-side interactive web games, tests (MBTI), and broadcast utility tools (Chzzk Downloader, Stream Schedule Studio, Bzzk Security Radar) for global livestreamers, creators, and viewers."
      }
    },
    {
      "@type": "Question",
      "name": "How does Chzzk Downloader work and is it free?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes, it is completely free with no limits or subscriptions. Paste any Naver CHZZK VOD replay or clip URL to download original 1080p FHD MP4 videos directly from official CDN streams to your PC."
      }
    },
    {
      "@type": "Question",
      "name": "Can I design stream schedules and share them on Discord or Twitter?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes! Stream Schedule Studio offers 7 aesthetic broadcast themes. Export high-res PNG calendar images or copy formatted Discord / X announcements with a single click, and save templates locally."
      }
    },
    {
      "@type": "Question",
      "name": "What is Bzzk Radar?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Bzzk is a real-time stream protection radar that correlates multi-banned raid accounts across Naver CHZZK channels to help streamers safeguard their chat before raids happen."
      }
    }
  ]
});
---

<!doctype html>
<html lang="en" class="dark">
  <head>
    <BaseHead
      title="ErrorLedger — Free Marble Roulette, Spin Wheel & Ladder Game for Streamers"
      description="Free browser-based stream tools for Twitch, YouTube, CHZZK & SOOP streamers. Marble Race Roulette, Random Wheel Picker, Ghost Leg Ladder Game — no install, no login."
      lang="en"
      hreflangKo={koUrl}
      hreflangEn={enUrl}
      keywords="Marble Roulette, Marble Race, ErrorLedger, 에러레저, Error Ledger, Random Wheel Picker, Ghost Leg Ladder, Amidakuji, Streamer Tools, Twitch Tools, YouTube Live Games, Free Stream Overlay, Fullscreen Browser Games"
    />
    <script type="application/ld+json" set:html={homeFaqSchema}></script>
  </head>
  <body class="arcade-home-body">
    <Header />

    <main class="arcade-home-main">
      <!-- Hero Section -->
      <section class="hero-showcase">
