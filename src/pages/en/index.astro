      <!-- MBTI Personality Test Highlight Banner (Tests) -->
      <section class="mbti-home-banner">
        <div class="mbti-banner-card">
          <div class="mbti-banner-glow"></div>
          <div class="mbti-banner-left">
            <div class="mbti-badge">
              <span class="pulse-dot-mbti"></span>
              <span>🧠 EMPIRICAL 60-ITEM COGNITIVE FUNCTION TEST</span>
            </div>
            <h3>Scientific MBTI <span class="gradient-text">(Personality & Cognition)</span></h3>
            <p>
              Beyond superficial 4-letter labels. Discover your 4-axis spectrum %, 8-layer Jungian cognitive function stack, career blueprint, love compatibility, and creator persona!
            </p>
          </div>
          <div class="mbti-banner-right">
            <a href="/en/mbti" class="btn-mbti-banner">
              <span>Start Assessment →</span>
            </a>
          </div>
        </div>
      </section>

      <!-- Platform Overview -->
      <section class="seo-overview-section">
        <div class="overview-container">
          <div class="overview-header">
            <span class="overview-pill">ERRORLEDGER PLATFORM</span>
            <h2>Free Interactive Web Games & Random Draw Tools for Streamers</h2>
            <p class="overview-sub">
              ErrorLedger is a no-install, no-login platform delivering broadcast-ready interactive games for Twitch, YouTube Live, CHZZK, SOOP (AfreecaTV), and Kick streamers.
            </p>
          </div>

          <div class="overview-grid">
            <div class="overview-card">
              <span class="overview-icon">🔮</span>
              <h3>Marble Race Roulette</h3>
              <p>
                More thrilling than a plain spin wheel — a real-time physics marble race with Galton pin boards, twin windmills, pinball bumpers, vortex bowls, and a giant finale propeller that bats marbles back for dramatic reversals.
              </p>
            </div>

            <div class="overview-card">
              <span class="overview-icon">🎡</span>
