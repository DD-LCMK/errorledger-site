    <script is:inline>
      (function () {
        const tabs = document.querySelectorAll('#home-game-filters .filter-btn');
        const searchInput = document.getElementById('arcade-quick-search');
        const cards = document.querySelectorAll('#arcade-cards-grid .game-card');
        const emptyMsg = document.getElementById('arcade-empty-msg');
        if (!cards.length) return;

        let activeFilter = 'all';

        function applyFilters() {
          const q = (searchInput ? searchInput.value : '').trim().toLowerCase();
          let visibleCount = 0;

          cards.forEach((card) => {
            const group = card.getAttribute('data-group');
            const hay = card.getAttribute('data-search') || '';
            const matchCat = activeFilter === 'all' || group === activeFilter;
            const matchQuery = !q || hay.includes(q);
            const show = matchCat && matchQuery;
            card.style.display = show ? 'flex' : 'none';
            if (show) visibleCount++;
          });

          if (emptyMsg) {
            emptyMsg.hidden = visibleCount > 0;
          }
        }

        tabs.forEach((tab) => {
          tab.addEventListener('click', () => {
            tabs.forEach((t) => t.classList.remove('active'));
            tab.classList.add('active');
            activeFilter = tab.getAttribute('data-filter') || 'all';
            applyFilters();
          });
        });

        if (searchInput) {
          searchInput.addEventListener('input', applyFilters);
        }

        const weatherEl = document.getElementById('home-ticker-weather');
        const statsEl = document.getElementById('home-ticker-stats');
        if (weatherEl && statsEl) {
          fetch('https://gist.githubusercontent.com/DD-LCMK/d329b23c0b99dc33e412512ee34bbf04/raw/bzzk_48h_stats.json?t=' + Date.now(), { cache: 'no-store' })
            .then(function (r) { return r.ok ? r.json() : null; })
            .then(function (d) {
              if (!d || typeof d !== 'object') return;
              const w = d.weather_status || {};
              const m = d.meta || {};
              const s = d.summary_48h || {};
              const icons = { calm: '☀️', normal: '⛅', elevated: '🌧️', surge: '⛈️' };
              const labels = { calm: 'Calm', normal: 'Normal', elevated: 'Elevated', surge: 'Surge' };
              const lvl = w.level || 'normal';
              weatherEl.className = 'ticker-weather weather-' + lvl;
              weatherEl.textContent = (icons[lvl] || '⛅') + ' Chat Weather: ' + (labels[lvl] || 'Normal');
              const hrs = Number(m.hours_collected) || 0;
              if (hrs === 0) {
                statsEl.textContent = 'Warming up initial 48h snapshot · 100% anonymous live metrics';
              } else {
                const chats = Number(s.total_chats) || 0;
                const chatTxt = chats >= 1000000 ? (chats / 1000000).toFixed(2) + 'M' : chats >= 1000 ? (chats / 1000).toFixed(1) + 'K' : String(chats);
                statsEl.textContent =
                  hrs + 'h window · Peak ' + (Number(m.monitored_streams_peak) || 0) +
                  ' streams · ' + chatTxt + ' chats · ' + (Number(s.mod_per_10k_chats) || 0).toFixed(1) + ' mods/10k';
              }
            })
            .catch(function () {
              weatherEl.textContent = '📡 Live 48h Moderation Radar';
              statsEl.textContent = 'View live Chzzk chat weather, category intensity & troll funnel';
            });
        }
      })();
    </script>
  </body>
