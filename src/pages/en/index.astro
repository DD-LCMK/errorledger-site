---
import BaseHead from '../../components/BaseHead.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { getCollection } from 'astro:content';
import { getKoUrl, getEnUrl } from '../../i18n';

const urlParams = Astro.url.searchParams;
const streamerMode = urlParams.has('stream') || urlParams.has('obs');

const games = await getCollection('games');
const priorityOrder = ['marble-roulette', 'roulette', 'ladder', 'drinking-marble', 'ai-music-quiz', 'stream-doodle', 'stream-emoji', 'fortune'];
const sortedGames = games.sort((a, b) => {
  const idxA = priorityOrder.indexOf(a.id);
  const idxB = priorityOrder.indexOf(b.id);
  return (idxA !== -1 ? idxA : 99) - (idxB !== -1 ? idxB : 99);
});

const siteBase = Astro.site?.toString() || 'https://errorledger.com';
const rawPath = Astro.url.pathname.replace(/\/$/, '') || '/en';
const koUrl = getKoUrl(siteBase, rawPath);
const enUrl = getEnUrl(siteBase, rawPath);

const homeFaqSchema = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "Can I use ErrorLedger on stream or in monetized YouTube videos?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes, absolutely! All games and interactive tools on ErrorLedger are 100% free to use for live broadcasting on Twitch, YouTube Live, CHZZK, SOOP, and for monetized video creation and viewer donations."
      }
    },
    {
      "@type": "Question",
      "name": "How do I use fullscreen or focus mode?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Click the [⛶ Fullscreen] or [📺 Focus Mode] button in any game to fill your screen cleanly without any browser chrome for a distraction-free experience."
      }
    },
    {
      "@type": "Question",
      "name": "Is ErrorLedger free? Do I need to sign up?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes — 100% free, forever. No login, no account, no download required. Every tool is ready to use in your browser within seconds."
      }
    },
    {
      "@type": "Question",
      "name": "Does it work on Twitch, YouTube Live, and other platforms?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes. ErrorLedger is a standard web app that works in any browser, making it compatible with Twitch, YouTube Live, CHZZK, SOOP (AfreecaTV), Kick, and any other streaming platform."
      }
    },
    {
      "@type": "Question",
      "name": "Are the results fair? Can results be manipulated?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "The Wheel and Ladder games use cryptographically seeded pseudo-random algorithms and mathematical bijective mapping. No one can predict or manipulate the outcome."
      }
    },
    {
      "@type": "Question",
      "name": "What is ErrorLedger?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "ErrorLedger provides 100% free, client-side interactive web games, tests (MBTI), and stream utility tools for global livestreamers, creators, and viewers."
      }
    }
  ]
});
---

<!doctype html>
<html lang="en" class="dark">
  <head>
    <BaseHead
      title="ErrorLedger — Free Marble Roulette, Spin Wheel & Ladder Game for Streamers"
      description="Free browser-based stream tools for Twitch, YouTube, CHZZK & SOOP streamers. Marble Race Roulette, Random Wheel Picker, Ghost Leg Ladder Game — no install, no login."
      lang="en"
      hreflangKo={koUrl}
      hreflangEn={enUrl}
      keywords="Marble Roulette, Marble Race, ErrorLedger, 에러레저, Error Ledger, Random Wheel Picker, Ghost Leg Ladder, Amidakuji, Streamer Tools, Twitch Tools, YouTube Live Games, Free Stream Overlay, Fullscreen Browser Games"
    />
    <script type="application/ld+json" set:html={homeFaqSchema}></script>
  </head>
  <body class="arcade-home-body">
    <Header />

    <main class="arcade-home-main">
      <!-- Hero Section -->
      <section class="hero-showcase">
        <div class="hero-backdrop"></div>
        <div class="hero-content">
          <div class="hero-pill">
            <span>🎥</span>
            <span>100% Free for Streaming, YouTube & Monetization</span>
          </div>
          <h1 class="hero-headline">
            Free <span class="gradient-text">Stream Tools</span> for Live Creators
          </h1>

          <p class="hero-subtext">
            Launch in 1 second — no install, no login. Marble race, spin wheel, and ladder game built for streamers.
          </p>

          <!-- Featured Game Hero Banner -->
          <div class="featured-hero-card">
            <div class="featured-main-row">
              <div class="featured-icon-box">🔮</div>
              <div class="featured-text">
                <span class="flagship-label">🔥 #1 Featured Tool</span>
                <h2>Marble Race Roulette</h2>
                <p>A 7,200px long track with physics pins, spinners, and a finale propeller — the most exciting way to pick a winner live.</p>
              </div>
              <div class="featured-action">
                <a href="/en/games/marble-roulette" class="btn-play-hero">
                  <span>Start Marble Race →</span>
                </a>
              </div>
            </div>
          </div>

          <!-- Hero Quick Utilities Bar -->
          <div class="hero-quick-tools-bar">
            <span class="quick-tools-label">🛠️ Creator Tool Suite:</span>
            <div class="quick-tools-pills">
              <a href="/en/chzzk-downloader" class="quick-tool-pill chzzk">
                <span class="pill-dot green"></span>
                <span>Chzzk Downloader</span>
                <span class="pill-tag new">NEW</span>
              </a>
              <a href="/en/schedule" class="quick-tool-pill schedule">
                <span class="pill-dot cyan"></span>
                <span>Schedule Studio</span>
              </a>
              <a href="/en/bzzk" class="quick-tool-pill bzzk">
                <span class="pill-dot purple"></span>
                <span>Bzzk Radar</span>
              </a>
            </div>
          </div>
        </div>
      </section>

      <!-- Games Grid -->
      <section class="games-directory-section">
        <div class="section-header">
          <h2>Stream Tool Lineup</h2>
        </div>

        <div class="games-grid">
          {sortedGames.map(game => {
            const href = game.id === 'fortune' ? '/en/fortune' : `/en/games/${game.id}`;
            const btnText = game.id === 'fortune' ? 'View Fortune →' : 'Launch →';
            const enTitle: Record<string, string> = {
              'marble-roulette': 'Marble Race Roulette',
              'roulette': 'Random Spin Wheel',
              'ladder': 'Ghost Leg Ladder Game',
              'drinking-marble': 'Blossom Board (Drinking & Penalty)',
              'stream-doodle': 'Stream Doodle (Animated GIF Studio)',
              'stream-emoji': 'Stream Emoji (Animated Emotes)',
              'ai-music-quiz': 'AI Music Quiz (Guess The Song)',
              'fortune': 'Daily Fortune',
            };
            const enTagline: Record<string, string> = {
              'marble-roulette': 'Physics-based marble race with live track, pins & spinners',
              'roulette': 'Ratchet-click spin wheel with confetti winner reveal',
              'ladder': 'Real-time animated ghost-leg (Amidakuji) for 2–20 players',
              'drinking-marble': 'Monopoly-style drinking & penalty board with 3D rolling dice',
              'stream-doodle': 'Interactive animated GIF doodle studio with 12 FPS line boil and OBS mode',
              'stream-emoji': 'Create retro 16-frame pixel & animated emotes for Twitch, Discord & YouTube',
              'ai-music-quiz': 'Listen to AI rearranged songs and guess the original title with side-by-side YouTube reveals',
              'fortune': 'Daily auto-updated horoscope & zodiac fortune for stream openers',
            };
            const enBadge: Record<string, string> = {
              'marble-roulette': 'Marble Race',
              'roulette': 'Featured Tool',
              'ladder': 'Bets & Penalties',
              'drinking-marble': '🌸 New Game',
              'stream-doodle': '✨ New Studio',
              'stream-emoji': '🎬 Emote Maker',
              'ai-music-quiz': '🎧 New Game',
              'fortune': 'Daily Free',
            };
            return (
              <article class="game-card">
                <div class="card-top-row">
                  <span class="card-icon">{game.data.icon}</span>
                  <span class="badge-accent">{enBadge[game.id] ?? game.data.badge}</span>
                </div>

                <div class="card-body">
                  <h3 class="card-title">
                    <a href={href}>{enTitle[game.id] ?? game.data.title}</a>
                  </h3>
                  <p class="card-tagline">{enTagline[game.id] ?? game.data.tagline}</p>
                </div>

                <div class="card-footer">
                  <span class="meta-item">⏱️ {game.data.playTime}</span>
                  <a href={href} class="btn-play-card">
                    <span>{btnText}</span>
                  </a>
                </div>
              </article>
            );
          })}
        </div>
      </section>

      <!-- Streamer Utilities Showcase Section (HIGH-IMPACT SHOWCASE) -->
      <section class="utilities-showcase-section" id="stream-utilities">
        <div class="utilities-showcase-container">
          <div class="utilities-showcase-header">
            <div class="util-section-pill">
              <span class="util-pulse-dot"></span>
              <span>STREAMER TOOLKIT • 100% FREE</span>
            </div>
            <h2 class="util-section-title">
              Essential Broadcast <span class="gradient-text-tools">Utility Studio for Streamers</span>
            </h2>
            <p class="util-section-desc">
              From Photoshop-free weekly schedule creation to multi-channel raid defense radar and 1080p lossless video downloader —<br class="hide-mobile" />
              a dedicated suite of free web utilities engineered to streamline your channel workflow.
            </p>
          </div>

          <div class="utilities-cards-grid">
            <!-- 1. Chzzk Downloader Card (NEW & HIGHLIGHTED) -->
            <article class="utility-showcase-card card-chzzk">
              <div class="util-card-glow chzzk-glow"></div>
              <div class="util-card-top">
                <div class="util-card-badge-row">
                  <span class="util-badge chzzk-badge">⚡ NEW RELEASE</span>
                  <span class="util-tag">1080p FHD Lossless</span>
                </div>
                <div class="util-card-icon-wrap chzzk-icon-wrap">
                  <span class="util-card-icon">📥</span>
                </div>
              </div>
              <div class="util-card-body">
                <h3 class="util-card-title">Chzzk Downloader</h3>
                <p class="util-card-tagline">VOD Replay & Clip Lossless Downloader</p>
                <p class="util-card-desc">
                  100% free with no subscription or rate limits! Download Naver CHZZK VODs and highlights in original 1080p FHD direct from official CDN streams directly to your PC with zero quality loss.
                </p>
                <ul class="util-card-features">
                  <li><span class="check-icon">✓</span> Lossless 1080p progressive MP4 direct stream download</li>
                  <li><span class="check-icon">✓</span> Built-in multi-thread acceleration & pause/resume</li>
                  <li><span class="check-icon">✓</span> 100% local, safe & open verification (No spyware)</li>
                </ul>
              </div>
              <div class="util-card-footer">
                <a href="/en/chzzk-downloader" class="btn-util-card chzzk-btn">
                  <span>Get Downloader & Guide →</span>
                </a>
              </div>
            </article>

            <!-- 2. Broadcast Schedule Studio Card -->
            <article class="utility-showcase-card card-schedule">
              <div class="util-card-glow schedule-glow"></div>
              <div class="util-card-top">
                <div class="util-card-badge-row">
                  <span class="util-badge schedule-badge">🔥 POPULAR</span>
                  <span class="util-tag">7 Themes • No PS</span>
                </div>
                <div class="util-card-icon-wrap schedule-icon-wrap">
                  <span class="util-card-icon">📅</span>
                </div>
              </div>
              <div class="util-card-body">
                <h3 class="util-card-title">Stream Schedule Studio</h3>
                <p class="util-card-tagline">Photoshop-Free Weekly Timetable Generator</p>
                <p class="util-card-desc">
                  Design aesthetic weekly and monthly broadcast schedules in 10 seconds. Features Neon Cyber, Retro Arcade, and Pastel themes with one-click PNG export, Discord Markdown copy, and template saves.
                </p>
                <ul class="util-card-features">
                  <li><span class="check-icon">✓</span> 7 customizable broadcast themes with instant PNG export</li>
                  <li><span class="check-icon">✓</span> One-click formatted Discord & X (Twitter) notice copy</li>
                  <li><span class="check-icon">✓</span> Local JSON template save & load (privacy preserved)</li>
                </ul>
              </div>
              <div class="util-card-footer">
                <a href="/en/schedule" class="btn-util-card schedule-btn">
                  <span>Create Schedule Now →</span>
                </a>
              </div>
            </article>

            <!-- 3. Bzzk Radar Card -->
            <article class="utility-showcase-card card-bzzk">
              <div class="util-card-glow bzzk-glow"></div>
              <div class="util-card-top">
                <div class="util-card-badge-row">
                  <span class="util-badge bzzk-badge">🛡️ LIVE RADAR</span>
                  <span class="util-tag">Chzzk Stream Guard</span>
                </div>
                <div class="util-card-icon-wrap bzzk-icon-wrap">
                  <span class="util-card-icon">🚨</span>
                </div>
              </div>
              <div class="util-card-body">
                <h3 class="util-card-title">Bzzk (검지직)</h3>
                <p class="util-card-tagline">Real-time Cross-Channel Raid Defense Radar</p>
                <p class="util-card-desc">
                  Detects serial malicious chatters and bad actors multi-banned across Naver CHZZK channels in real time. Pre-emptively safeguard your chat room and community before raids happen.
                </p>
                <ul class="util-card-features">
                  <li><span class="check-icon">✓</span> Real-time tracking of multi-banned bad accounts</li>
                  <li><span class="check-icon">✓</span> Cross-channel raid correlation & suspicion scoring</li>
                  <li><span class="check-icon">✓</span> One-click auto ban list export for chat managers</li>
                </ul>
              </div>
              <div class="util-card-footer">
                <a href="/en/bzzk" class="btn-util-card bzzk-btn">
                  <span>Open Security Radar →</span>
                </a>
              </div>
            </article>
          </div>
        </div>
      </section>

      <!-- MBTI Personality Test Highlight Banner (Tests) -->
      <section class="mbti-home-banner">
        <div class="mbti-banner-card">
          <div class="mbti-banner-glow"></div>
          <div class="mbti-banner-left">
            <div class="mbti-badge">
              <span class="pulse-dot-mbti"></span>
              <span>🧠 EMPIRICAL 60-ITEM COGNITIVE FUNCTION TEST</span>
            </div>
            <h3>Scientific MBTI <span class="gradient-text">(Personality & Cognition)</span></h3>
            <p>
              Beyond superficial 4-letter labels. Discover your 4-axis spectrum %, 8-layer Jungian cognitive function stack, career blueprint, love compatibility, and creator persona!
            </p>
          </div>
          <div class="mbti-banner-right">
            <a href="/en/mbti" class="btn-mbti-banner">
              <span>Start Assessment →</span>
            </a>
          </div>
        </div>
      </section>

      <!-- Platform Overview -->
      <section class="seo-overview-section">
        <div class="overview-container">
          <div class="overview-header">
            <span class="overview-pill">ERRORLEDGER PLATFORM</span>
            <h2>Free Interactive Web Games & Random Draw Tools for Streamers</h2>
            <p class="overview-sub">
              ErrorLedger is a no-install, no-login platform delivering broadcast-ready interactive games for Twitch, YouTube Live, CHZZK, SOOP (AfreecaTV), and Kick streamers.
            </p>
          </div>

          <div class="overview-grid">
            <div class="overview-card">
              <span class="overview-icon">🔮</span>
              <h3>Marble Race Roulette</h3>
              <p>
                More thrilling than a plain spin wheel — a real-time physics marble race with Galton pin boards, twin windmills, pinball bumpers, vortex bowls, and a giant finale propeller that bats marbles back for dramatic reversals.
              </p>
            </div>

            <div class="overview-card">
              <span class="overview-icon">🎡</span>
              <h3>Random Spin Wheel (Roulette)</h3>
              <p>
                Satisfying ratchet-click audio, winner confetti explosion, automatic removal of picked items, and one-click presets for food, penalties, and giveaways. Built for broadcast.
              </p>
            </div>

            <div class="overview-card">
              <span class="overview-icon">🪜</span>
              <h3>Ghost Leg Ladder Game (Amidakuji)</h3>
              <p>
                Animated neon footstep trail through a real-time Amidakuji ladder for 2–20 players. Fair, one-to-one bijective mapping ensures nobody can predict or rig the result.
              </p>
            </div>

            <div class="overview-card">
              <span class="overview-icon">✨</span>
              <h3>Daily Fortune & Horoscope</h3>
              <p>
                Auto-refreshed at midnight: 12 Eastern zodiac animal fortunes and 12 Western star sign readings, each with lucky numbers, colors, and daily DO/DON'T tips for stream openers.
              </p>
            </div>

            <div class="overview-card">
              <span class="overview-icon">🛡️</span>
              <h3>Bzzk (Chzzk Stream Security Radar)</h3>
              <p>
                Real-time cross-channel intelligence network detecting high-risk malicious actors across Chzzk streams, shielding your chatroom with automatic pre-emptive restrictions.
              </p>
            </div>

            <div class="overview-card">
              <span class="overview-icon">🧠</span>
              <h3>Scientific MBTI & 8 Cognitive Functions Test</h3>
              <p>
                Empirical 60-item instrument with balanced reverse scoring. Dissect your 8 Jungian cognitive functions, stress loops, workplace superpowers, real-time chemistry calculator, and creator streaming persona.
              </p>
            </div>

            <div class="overview-card">
              <span class="overview-icon">📅</span>
              <h3>Stream Schedule Studio (Broadcast Timetable Maker)</h3>
              <p>
                Design polished stream schedules without graphic design software. Features weekly and monthly grid layouts, versatile visual themes (Neon, Retro, Travel Ticket, Pastel), and one-click Discord text formatting and local template saving.
              </p>
            </div>

            <div class="overview-card">
              <span class="overview-icon">🎨</span>
              <h3>Stream Doodle (Animated GIF & Emote Studio)</h3>
              <p>
                Every stroke springs to life with real-time 12 FPS boiling line animation! Tailored canvas presets for Twitch, Discord, and Chzzk emotes, infinite looping GIF and transparent PNG export, and alpha cutout brushes for instant live stream stickers and memes.
              </p>
            </div>

            <div class="overview-card">
              <span class="overview-icon">🎬</span>
              <h3>Stream Emoji (Multi-Frame Animated Emote Studio)</h3>
              <p>
                Create custom frame-by-frame animated emotes for Twitch, Discord, and Chzzk! Features 2–16 frame timeline, onion skinning, 1x live chat scale preview widget, and optimized looping GIF & spritesheet export.
              </p>
            </div>
          </div>
        </div>
      </section>

      <!-- FAQ -->
      <section class="home-faq-section">
        <div class="faq-container">
          <h2>Frequently Asked Questions</h2>
          <div class="faq-grid">
            <div class="faq-box">
              <h3>Can I use ErrorLedger on stream or in monetized videos?</h3>
              <p>Yes, 100% permitted and free! You are fully allowed to broadcast our tools live on Twitch, YouTube, CHZZK, SOOP, and upload edited videos with monetization and donations enabled.</p>
            </div>
            <div class="faq-box">
              <h3>How do I use fullscreen or focus mode?</h3>
              <p>Click the [⛶ Fullscreen] or [📺 Focus Mode] button in the top-right of any game to go borderless for clean, distraction-free play.</p>
            </div>
            <div class="faq-box">
              <h3>Is it free? Do I need to sign up?</h3>
              <p>100% free, forever. No account, no login, no download. Open the link and it works instantly in any browser.</p>
            </div>
            <div class="faq-box">
              <h3>Does it work on Twitch, YouTube, and CHZZK?</h3>
              <p>Yes. It runs in any standard web browser, so it works with Twitch, YouTube Live, CHZZK, SOOP, Kick, and any other platform.</p>
            </div>
            <div class="faq-box">
              <h3>Are results fair? Can anyone manipulate them?</h3>
              <p>The Spin Wheel and Ghost Leg Ladder use cryptographically seeded PRNG with mathematical bijective mapping — fully random and tamper-proof.</p>
            </div>
            <div class="faq-box">
              <h3>What is ErrorLedger?</h3>
              <p>ErrorLedger provides 100% free, client-side interactive web games, tests (MBTI), and stream utility tools for global livestreamers, creators, and communities.</p>
            </div>
          </div>
        </div>
      </section>
    </main>

    {!streamerMode && <Footer />}
  </body>
</html>

<style>
  .arcade-home-body {
    background: #090d16 !important;
    color: #f1f5f9 !important;
    min-height: 100vh;
    display: flex;
    flex-direction: column;
  }

  .arcade-home-main {
    flex: 1;
    max-width: 1200px;
    margin: 0 auto;
    padding: 2rem 1.5rem 7rem;
    width: 100%;
    box-sizing: border-box;
  }

  .hero-showcase {
    position: relative;
    padding: 3rem 1rem 2.5rem;
    text-align: center;
    overflow: hidden;
  }

  .hero-backdrop {
    position: absolute;
    top: -30%;
    left: 50%;
    transform: translateX(-50%);
    width: 650px;
    height: 450px;
    background: radial-gradient(circle, rgba(168, 85, 247, 0.22) 0%, rgba(56, 189, 248, 0.1) 50%, transparent 80%);
    filter: blur(60px);
    pointer-events: none;
    z-index: 0;
  }

  .hero-content {
    position: relative;
    z-index: 1;
    max-width: 850px;
    margin: 0 auto;
  }

  .hero-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    background: rgba(168, 85, 247, 0.15);
    border: 1px solid rgba(168, 85, 247, 0.35);
    color: #e9d5ff;
    font-size: 0.8rem;
    font-weight: 700;
    padding: 0.3rem 0.85rem;
    border-radius: 999px;
    margin-bottom: 1.25rem;
  }

  .hero-headline {
    font-size: clamp(1.9rem, 5vw, 3.2rem);
    font-weight: 900;
    line-height: 1.15;
    margin-bottom: 1rem;
    color: #f8fafc;
    letter-spacing: -0.03em;
  }

  .gradient-text {
    background: linear-gradient(135deg, #a855f7 0%, #38bdf8 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .hero-subtext {
    font-size: 1.05rem;
    color: #94a3b8;
    margin-bottom: 2rem;
    max-width: 560px;
    margin-left: auto;
    margin-right: auto;
  }

  .featured-hero-card {
    background: linear-gradient(135deg, rgba(168, 85, 247, 0.12) 0%, rgba(56, 189, 248, 0.08) 100%);
    border: 1px solid rgba(168, 85, 247, 0.25);
    border-radius: 16px;
    padding: 1.5rem;
    text-align: left;
  }

  .featured-main-row {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    flex-wrap: wrap;
  }

  .featured-icon-box {
    font-size: 2.8rem;
    flex-shrink: 0;
  }

  .featured-text {
    flex: 1;
    min-width: 200px;
  }

  .flagship-label {
    display: inline-block;
    font-size: 0.72rem;
    font-weight: 800;
    color: #fb923c;
    background: rgba(251, 146, 60, 0.12);
    border: 1px solid rgba(251, 146, 60, 0.3);
    padding: 0.2rem 0.55rem;
    border-radius: 999px;
    margin-bottom: 0.4rem;
    letter-spacing: 0.04em;
  }

  .featured-text h2 {
    font-size: 1.35rem;
    font-weight: 900;
    color: #f8fafc;
    margin: 0 0 0.35rem;
  }

  .featured-text p {
    font-size: 0.88rem;
    color: #94a3b8;
    margin: 0;
    line-height: 1.55;
  }

  .featured-action {
    flex-shrink: 0;
  }

  .btn-play-hero {
    display: inline-flex;
