            };
            const enBadge: Record<string, string> = {
              'marble-roulette': 'Marble Race',
              'roulette': 'Featured Tool',
              'ladder': 'Bets & Penalties',
              'drinking-marble': '🌸 New Game',
              'stream-doodle': '✨ New Studio',
              'stream-emoji': '🎬 Emote Maker',
              'ai-music-quiz': '🎧 New Game',
              'fortune': 'Daily Free',
            };
