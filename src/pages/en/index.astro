---
import BaseHead from '../../components/BaseHead.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import GameThumb from '../../components/GameThumb.astro';
import { getCollection } from 'astro:content';
import { getKoUrl, getEnUrl } from '../../i18n';

const urlParams = Astro.url.searchParams;
const streamerMode = urlParams.has('stream') || urlParams.has('obs');

const games = await getCollection('games');
const priorityOrder = [
  'three-sec-quiz', 'spot-odd', 'blind-timer', 'mine-gems', 'reaction-test',
  'sword-enhance', 'marble-roulette', 'block-blast', 'arrow-jump', 'sand-drop',
  'roulette', 'ladder', 'drinking-marble', 'ai-music-quiz', 'soundboard',
  'stream-doodle', 'stream-emoji', 'fortune'
];
const sortedGames = games.sort((a, b) => {
  const idxA = priorityOrder.indexOf(a.id);
  const idxB = priorityOrder.indexOf(b.id);
  return (idxA !== -1 ? idxA : 99) - (idxB !== -1 ? idxB : 99);
});

const arcadeIds = ['three-sec-quiz', 'spot-odd', 'blind-timer', 'mine-gems', 'reaction-test', 'sword-enhance', 'block-blast', 'arrow-jump', 'sand-drop'];
const drawIds = ['marble-roulette', 'roulette', 'ladder', 'drinking-marble'];
const arcadeCount = sortedGames.filter(g => arcadeIds.includes(g.id)).length;
const drawCount = sortedGames.filter(g => drawIds.includes(g.id)).length;
const studioCount = sortedGames.length - arcadeCount - drawCount;

const enTitle: Record<string, string> = {
  'three-sec-quiz': '3-Second Reflex & Word Quiz',
  'spot-odd': 'Eagle-Eye: Spot the Odd & Color Vision',
  'blind-timer': 'Human Stopwatch: 7.77s Blind Timer',
  'mine-gems': 'Mine Gems: Cash Out or Bust',
  'reaction-test': 'Streamer Physical Age Test',
  'sword-enhance': 'Legendary +20 Sword Enhancer',
  'block-blast': 'Block Blast!',
  'arrow-jump': 'Arrow Climber',
  'sand-drop': 'Sand Drop',
  'marble-roulette': 'Marble Race Roulette',
  'roulette': 'Random Spin Wheel',
  'ladder': 'Ghost Leg Ladder Game',
  'drinking-marble': 'Blossom Board (Party Dice)',
  'stream-doodle': 'Stream Doodle (Animated GIF)',
  'stream-emoji': 'Stream Emoji (Animated Emotes)',
  'ai-music-quiz': 'AI Music Quiz (Guess The Song)',
  'soundboard': 'Broadcast Keypad Soundboard',
  'fortune': 'Daily Fortune',
};

const enTagline: Record<string, string> = {
  'three-sec-quiz': 'Variety-show 3.00s reflex quiz across Idioms, Proverbs, Theme Words & World Capitals.',
  'spot-odd': 'Spot lookalike characters & subtle color deltas on an A1–J10 coordinate grid with chat.',
  'blind-timer': '1.5s blind stopwatch challenge (3.33s–10.00s) with 1ms precision & collab leaderboard.',
  'mine-gems': '5x5 diamond mining game with exponential cash-out multipliers & SHA-256 fairness.',
  'reaction-test': '3-stage Reaction Speed (ms), 12s Aim Tracking & 5s CPS burst test with Age Receipt.',
  'sword-enhance': 'Forge +0 to +20 with 6-slot Inventory, +7 Sword of Greed jackpot & fail stacks.',
  'block-blast': '8x8 combo line blast block puzzle with endless & 2-min time attack modes.',
  'arrow-jump': 'Slingshot archery physics climber with precision platform landings.',
  'sand-drop': 'Falling kinetic sand physics & merge puzzle up to the Aurora crown.',
  'marble-roulette': '3D physics marble race with 7,200px long track, pins & reversal spinners.',
  'roulette': 'Ratchet-click weighted spin wheel with confetti winner reveal & quick presets.',
  'ladder': 'Real-time animated ghost-leg (Amidakuji) for 2–20 players.',
  'drinking-marble': 'Monopoly-style party & penalty board with 3D rolling dice.',
  'stream-doodle': 'Animated 12 FPS GIF doodle studio with transparent OBS overlay support.',
  'stream-emoji': 'Create 16-frame animated emotes for Twitch, Discord & YouTube.',
  'ai-music-quiz': 'Listen to AI rearranged songs and guess the title with side-by-side reveals.',
  'soundboard': 'Zero-latency broadcast soundboard with 9 numpad shortcuts & custom slots.',
  'fortune': 'Daily auto-updated zodiac & horoscope fortune for stream openers.',
};

const enTagsMap: Record<string, string[]> = {
  'three-sec-quiz': ['3s Reflex', '4-Choice & Host'],
  'spot-odd': ['Odd Char & Color', 'A1–J10 Grid'],
  'blind-timer': ['1.5s Blind Clock', '1ms Precision'],
  'mine-gems': ['5x5 A1–E5', 'SHA-256 Fair'],
  'reaction-test': ['Reflex · Aim · CPS', 'Age Receipt'],
  'sword-enhance': ['+20 Forging', '6-Slot Vault'],
  'block-blast': ['8x8 Line Blast', 'Endless Combo'],
  'arrow-jump': ['Slingshot Aim', 'Daily 300m'],
  'sand-drop': ['Sand Physics', '11 Merge Tiers'],
  'marble-roulette': ['3D Physics', 'Up to 40'],
  'roulette': ['Weighted Odds', '1-Click Presets'],
  'ladder': ['2–20 Players', '1:1 Fair Match'],
  'drinking-marble': ['3D Dice', 'Custom Tiles'],
  'ai-music-quiz': ['AI Covers', 'Chat Guess'],
  'soundboard': ['0ms Latency', 'Numpad Keys'],
  'stream-doodle': ['12 FPS Boil', 'OBS Overlay'],
  'stream-emoji': ['16 Frames', 'Onion Skin'],
  'fortune': ['12 Zodiacs', 'Daily Auto']
};

const siteBase = Astro.site?.toString() || 'https://errorledger.com';
const rawPath = Astro.url.pathname.replace(/\/$/, '') || '/en';
const koUrl = getKoUrl(siteBase, rawPath);
const enUrl = getEnUrl(siteBase, rawPath);

const homeFaqSchema = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "Can I use ErrorLedger on stream or in monetized YouTube videos?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes, absolutely! All games and interactive tools on ErrorLedger are 100% free to use for live broadcasting on Twitch, YouTube Live, CHZZK, SOOP, and for monetized video creation and viewer donations."
      }
    },
    {
      "@type": "Question",
      "name": "How do I add a game to OBS Studio as a Browser Source?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Click the [🎥 Copy OBS URL] button at the top of any game page to get a clean ?stream=true URL without headers or chrome, then add it as a 1920x1080 Browser Source in OBS."
      }
    },
    {
      "@type": "Question",
      "name": "Is ErrorLedger free? Do I need to sign up?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes — 100% free forever. No login, no account, and no download required. Every tool launches instantly in your browser."
      }
    },
    {
      "@type": "Question",
      "name": "Does it work on Twitch, YouTube Live, CHZZK, and SOOP?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes. All mini-games run 100% locally in any standard browser with zero external API dependencies, ensuring reliable compatibility on every streaming platform."
      }
    },
    {
      "@type": "Question",
      "name": "Are the giveaway and game results provably fair?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes. Spin Wheel, Ghost Leg Ladder, and Mine Gems use cryptographically seeded randomness, bijective mapping, and pre-committed SHA-256 seed hashes so outcomes cannot be rigged."
      }
    },
    {
      "@type": "Question",
      "name": "Are Stream Schedule Studio and Chzzk Downloader also free?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes — 100% free with zero watermarks or usage caps. Design PNG broadcast schedules, back up JSON templates locally, and download lossless MP4 VODs and clips."
      }
    }
  ]
});
---

<!doctype html>
<html lang="en" class="dark">
  <head>
    <BaseHead
      title="ErrorLedger — Free Streamer Arcade, Marble Roulette & Broadcast Studio"
      description="Free browser-based arcade games & broadcast utilities for Twitch, YouTube, CHZZK & SOOP streamers. Marble Race Roulette, Spin Wheel, Ladder, Blind Timer, Mine Gems & more — no install, no login."
      lang="en"
      hreflangKo={koUrl}
      hreflangEn={enUrl}
      keywords="Marble Roulette, Marble Race, ErrorLedger, Random Wheel Picker, Ghost Leg Ladder, Streamer Tools, Twitch Party Games, YouTube Live Games, OBS Browser Source Games"
    />
    <script type="application/ld+json" set:html={homeFaqSchema}></script>
  </head>
  <body class="studio-home-body">
    <Header />

    <main class="studio-home-main">
      <!-- 0. LIVE 48H CHZZK MODERATION RADAR TICKER BAR -->
      <a href="/bzzk#moderation-radar-48h" class="live-radar-ticker" id="home-bzzk-ticker">
        <div class="ticker-left">
          <span class="ticker-new-pill">NEW</span>
          <span class="ticker-title">🛡️ Live 48h Chzzk Moderation Radar</span>
          <span class="ticker-weather weather-normal" id="home-ticker-weather">⛅ Weather: Checking</span>
        </div>
        <div class="ticker-right">
          <span class="ticker-stats" id="home-ticker-stats">Loading live 48h anonymous snapshot...</span>
          <span class="ticker-cta">Open Radar →</span>
        </div>
      </a>

      <!-- 1. STUDIO CONTROL DECK HERO -->
      <section class="studio-hero">
        <div class="hero-top-aura" aria-hidden="true"></div>
        <div class="hero-dot-matrix" aria-hidden="true"></div>

        <div class="hero-grid">
          <div class="hero-copy">
            <div class="status-pill">
              <span class="status-dot"></span>
              <span>LIVE STREAM READY · 100% FREE FOR MONETIZATION</span>
            </div>

            <h1 class="hero-title">
              The Live Arcade Deck<br />
              <span class="title-accent">Built for Streamers</span>
            </h1>

            <p class="hero-lead">
              Launch in 1 second with zero install, zero login, and zero external API downtime. Interactive stream games, giveaways, and creator utilities for Twitch, YouTube, CHZZK & SOOP.
            </p>

            <div class="hero-actions">
              <a href="#games-arcade" class="btn-primary">
                <span>🎮 Browse All Games</span>
                <span class="btn-arrow">↓</span>
              </a>
              <a href="/en/tools" class="btn-secondary">
                <span>🛠️ Creator Utilities</span>
              </a>
            </div>

            <div class="hero-metrics" aria-label="Platform highlights">
              <div class="metric-cell">
                <strong class="metric-val">{sortedGames.length}</strong>
                <span class="metric-lbl">Free Stream Games</span>
              </div>
              <div class="metric-sep"></div>
              <div class="metric-cell">
                <strong class="metric-val">6</strong>
                <span class="metric-lbl">Creator Utilities</span>
              </div>
              <div class="metric-sep"></div>
              <div class="metric-cell">
                <strong class="metric-val">OBS</strong>
                <span class="metric-lbl">1-Click Source Mode</span>
              </div>
            </div>
          </div>

          <!-- Right: 2x2 Flagship Control Deck -->
          <div class="flagship-deck">
            <a href="/en/games/marble-roulette" class="deck-tile accent-emerald">
              <div class="tile-top">
                <span class="tile-icon">🔮</span>
                <span class="tile-tag tag-amber">🔥 #1 FLAGSHIP</span>
              </div>
              <div class="tile-body">
                <h2>Marble Race Roulette</h2>
                <p>7,200px physics track with pins, spinners & bouncers for live giveaways</p>
              </div>
              <div class="tile-foot">
                <span>Launch Race</span>
                <span class="arrow">→</span>
              </div>
            </a>

            <a href="/en/chzzk-downloader" class="deck-tile accent-cyan">
              <div class="tile-top">
                <span class="tile-icon">📥</span>
                <span class="tile-tag tag-emerald">4K / FHD</span>
              </div>
              <div class="tile-body">
                <h2>Chzzk & YT Downloader</h2>
                <p>Batch download VODs, clips & YouTube Shorts in lossless original MP4</p>
              </div>
              <div class="tile-foot">
                <span>Open Downloader</span>
                <span class="arrow">→</span>
              </div>
            </a>

            <a href="/bzzk#moderation-radar-48h" class="deck-tile accent-rose">
              <div class="tile-top">
                <span class="tile-icon">🛡️</span>
                <span class="tile-tag tag-emerald">NEW · 48H RADAR</span>
              </div>
              <div class="tile-body">
                <h2>Bzzk 48h Moderation Radar</h2>
                <p>Live Chzzk chat weather, 48h moderation analytics & cross-channel troll detection</p>
              </div>
              <div class="tile-foot">
                <span>Open 48h Radar</span>
                <span class="arrow">→</span>
              </div>
            </a>

            <a href="/en/guide" class="deck-tile accent-amber">
              <div class="tile-top">
                <span class="tile-icon">🎨</span>
                <span class="tile-tag tag-slate">GUIDE & ARTISTS</span>
              </div>
              <div class="tile-body">
                <h2>OBS Guide & Creators</h2>
                <p>1080p60 OBS setup handbook and curated live-streaming artists showcase</p>
              </div>
              <div class="tile-foot">
                <span>Explore Guide</span>
                <span class="arrow">→</span>
              </div>
            </a>
          </div>
        </div>
      </section>

      <!-- 2. INTERACTIVE GAMES ARCADE GRID -->
      <section class="arcade-section" id="games-arcade">
        <div class="arcade-header">
          <div class="arcade-title-wrap">
            <span class="eyebrow">ARCADE & STREAM GAMES</span>
            <h2>Interactive Stream Game Lineup</h2>
          </div>

          <div class="arcade-controls">
            <div class="filter-bar" id="home-game-filters" role="tablist" aria-label="Game Category Filter">
              <button type="button" class="filter-btn active" data-filter="all">
                <span>All</span>
                <span class="f-cnt">{sortedGames.length}</span>
              </button>
              <button type="button" class="filter-btn" data-filter="arcade">
                <span>🔥 Arcade</span>
                <span class="f-cnt">{arcadeCount}</span>
              </button>
              <button type="button" class="filter-btn" data-filter="draw">
                <span>🎲 Draws & Party</span>
                <span class="f-cnt">{drawCount}</span>
              </button>
              <button type="button" class="filter-btn" data-filter="studio">
                <span>🎨 Studio & Quiz</span>
                <span class="f-cnt">{studioCount}</span>
              </button>
            </div>

            <label class="quick-filter-box" aria-label="Quick filter games">
              <span class="qf-icon">🔍</span>
              <input
                type="search"
                id="arcade-quick-search"
                placeholder="Quick filter (e.g. quiz, roulette, timer)..."
                autocomplete="off"
              />
            </label>
          </div>
        </div>

        <div class="arcade-grid" id="arcade-cards-grid">
          {sortedGames.map(game => {
            const href = game.id === 'fortune' ? '/en/fortune' : `/en/games/${game.id}`;
            const group = arcadeIds.includes(game.id) ? 'arcade' : drawIds.includes(game.id) ? 'draw' : 'studio';
            const isNewest = game.id === 'three-sec-quiz' || game.id === 'spot-odd';
            const isPopular = game.id === 'marble-roulette';
            const titleText = enTitle[game.id] ?? game.data.title;
            const taglineText = enTagline[game.id] ?? game.data.tagline;
            const cardTags = enTagsMap[game.id] || [];
            const searchBlob = `${titleText} ${taglineText} ${cardTags.join(' ')} ${game.id}`.toLowerCase();

            return (
              <a
                href={href}
                class={`game-card group-${group}`}
                data-group={group}
                data-search={searchBlob}
              >
                <div class="card-thumb-wrap">
                  <GameThumb id={game.id} lang="en" />
                  {isNewest && <span class="thumb-pill pill-new">NEW</span>}
                  {isPopular && <span class="thumb-pill pill-hot">HOT #1</span>}
                  <span class="thumb-play-chip">▶ PLAY</span>
                </div>

                <div class="card-content">
                  <div class="card-head-line">
                    <h3 class="card-title">{titleText}</h3>
                  </div>
                  <p class="card-tagline">{taglineText}</p>

                  <div class="card-meta-foot">
                    <div class="card-tags">
                      {cardTags.map(tag => <span class="mini-tag">{tag}</span>)}
                    </div>
                    <span class="card-time">⏱ {game.data.playTime}</span>
                  </div>
                </div>
              </a>
            );
          })}
        </div>

        <div id="arcade-empty-msg" class="arcade-empty" hidden>
          No matching games found. Try a different keyword or select the <strong>All</strong> tab.
        </div>

        <div class="section-cta-row">
          <a href="/en/games" class="btn-outline-hub">
            <span>🎮 Explore Full Games Directory ({sortedGames.length} Free Games)</span>
            <span class="arrow">→</span>
          </a>
        </div>
      </section>

      <!-- 3. STREAMER UTILITIES STUDIO -->
      <section class="studio-utils-section" id="stream-utilities">
        <div class="section-head-center">
          <span class="eyebrow">CREATOR TOOLKIT · 100% FREE</span>
          <h2>Essential <span class="title-accent">Broadcast Utilities Studio</span></h2>
          <p>Zero watermarks, zero paywalls, zero logins — built to cut your stream prep time in half.</p>
        </div>

        <div class="utils-grid">
          <a href="/en/chzzk-downloader" class="util-card util-emerald">
            <div class="util-top">
              <span class="util-ico">📥</span>
              <span class="util-badge">4K · 1080p Lossless</span>
            </div>
            <h3>Chzzk & YouTube Downloader</h3>
            <p class="util-desc">Batch-queue VODs, clips & YouTube Shorts into lossless MP4/M4A with bundled FFmpeg.</p>
            <ul class="util-list">
              <li>Supports CHZZK VODs, clips & YouTube Shorts</li>
              <li>Multi-URL sequential background download queue</li>
              <li>Built-in section clipper timestamp command builder</li>
            </ul>
            <span class="util-action">Open Downloader →</span>
          </a>

          <a href="/en/schedule" class="util-card util-cyan">
            <div class="util-top">
              <span class="util-ico">📅</span>
              <span class="util-badge">PNG · JSON Templates</span>
            </div>
            <h3>Stream Schedule Studio</h3>
            <p class="util-desc">Create crisp weekly & monthly timetables across 7 studio themes without Photoshop.</p>
            <ul class="util-list">
              <li>7 broadcast-ready visual themes & custom colors</li>
              <li>Save & reload local .json templates in seconds</li>
              <li>One-click Discord & X/Twitter schedule text copy</li>
            </ul>
            <span class="util-action">Design Schedule →</span>
          </a>

          <a href="/en/bzzk" class="util-card util-amber">
            <div class="util-top">
              <span class="util-ico">🛡️</span>
              <span class="util-badge">Cross-Channel Radar</span>
            </div>
            <h3>Bzzk Protection Radar</h3>
            <p class="util-desc">Identify coordinated ban evaders and multi-channel raid accounts in real time.</p>
            <ul class="util-list">
              <li>Cross-channel ban correlation & risk signals</li>
              <li>100% pseudonymized account safety handling</li>
              <li>Pre-stream safety lookup for moderators</li>
            </ul>
            <span class="util-action">Open Live Radar →</span>
          </a>
        </div>

        <!-- Compact MBTI Studio Strip -->
        <a href="/en/mbti" class="mbti-strip">
          <div class="mbti-strip-left">
            <span class="mbti-ico">🧠</span>
            <div>
              <div class="mbti-title-row">
                <strong>60-Question Deep MBTI & Cognitive Function Test</strong>
                <span class="mbti-chip">Chat Content</span>
              </div>
              <p>Analyze 4 trait spectra, 8 cognitive functions, stress loops, and streamer-viewer compatibility for free.</p>
            </div>
          </div>
          <span class="mbti-go">Start Assessment →</span>
        </a>

        <div class="section-cta-row">
          <a href="/en/tools" class="btn-outline-hub">
            <span>🛠️ View All Creator Utilities (6 Free Tools)</span>
            <span class="arrow">→</span>
          </a>
        </div>
      </section>

      <!-- 4. LATEST RELEASES STRIP -->
      <section class="releases-section">
        <div class="releases-box">
          <div class="releases-head">
            <div class="releases-title-group">
              <span class="rel-dot"></span>
              <h3>Latest Releases</h3>
            </div>
            <a href="/en/changelog" class="rel-all-link">Full Changelog →</a>
          </div>
          <div class="releases-grid">
            <a href="/en/games/three-sec-quiz" class="rel-item">
              <span class="rel-ver ver-new">v2.5</span>
              <div>
                <strong>🗣️ 3-Second Quiz & 🔍 Eagle-Eye Spot the Odd</strong>
                <p>Dual-mode variety show 3s reflex quiz + A1–J10 character & color vision challenge</p>
              </div>
            </a>
            <a href="/en/games/blind-timer" class="rel-item">
              <span class="rel-ver">v2.4</span>
              <div>
                <strong>⏱️ 7.77s Blind Timer & 💣 Mine Gems Cash-Out</strong>
                <p>1ms blind stopwatch precision test + provably fair SHA-256 5x5 diamond mining</p>
              </div>
            </a>
            <a href="/en/games/sword-enhance" class="rel-item">
              <span class="rel-ver">v2.2</span>
              <div>
                <strong>⚡ Physical Age Test & 🗡️ +20 Sword Enhancer</strong>
                <p>Reflex, Aim & CPS benchmark receipt + 6-slot forging vault & Sword of Greed</p>
              </div>
            </a>
          </div>
        </div>
      </section>

      <!-- 5. PLATFORM PILLARS & FAQ ACCORDION -->
      <section class="faq-platform-section">
        <div class="platform-pillars">
          <div class="pillar-card">
            <span>⚡</span>
            <strong>100% Free & Monetizable</strong>
            <p>Cleared for live streams, VODs, YouTube ads, and viewer donations forever.</p>
          </div>
          <div class="pillar-card">
            <span>🔒</span>
            <strong>Zero API · Zero Login</strong>
            <p>Every game runs locally in your browser—no accounts and no third-party outages.</p>
          </div>
          <div class="pillar-card">
            <span>🎥</span>
            <strong>OBS Ready (?stream=true)</strong>
            <p>One-click clean Browser Source URL strips headers and footers for crisp overlays.</p>
          </div>
          <div class="pillar-card">
            <span>⚖️</span>
            <strong>Provably Fair Logic</strong>
            <p>Cryptographic PRNG, bijective ladders, and SHA-256 hashes guarantee zero rigging.</p>
          </div>
        </div>

        <div class="faq-wrap">
          <div class="section-head-center compact">
            <span class="eyebrow">FREQUENTLY ASKED QUESTIONS</span>
            <h2>Frequently Asked Questions</h2>
          </div>

          <div class="faq-accordion-grid">
            <details class="faq-item" open>
              <summary>Can I use ErrorLedger on stream or in monetized YouTube videos?</summary>
              <p>Yes, 100% allowed! Every game and broadcast utility on ErrorLedger is completely free for live broadcasting on Twitch, YouTube Live, CHZZK, SOOP, and monetized content creation.</p>
            </details>
            <details class="faq-item" open>
              <summary>How do I add a game to OBS Studio as a Browser Source?</summary>
              <p>Click the <strong>[🎥 Copy OBS URL]</strong> button on any game page and paste it into an OBS Browser Source (1920×1080 recommended). The <code>?stream=true</code> flag automatically hides site chrome.</p>
            </details>
            <details class="faq-item">
              <summary>Is ErrorLedger free? Do I need an account?</summary>
              <p>Yes — 100% free forever with no login, no account, and no software installation required.</p>
            </details>
            <details class="faq-item">
              <summary>Does it work on Twitch, YouTube Live, CHZZK & SOOP?</summary>
              <p>Yes. All games run standalone in modern browsers with no external chat API dependencies, working seamlessly across every platform.</p>
            </details>
            <details class="faq-item">
              <summary>Are the giveaways and game odds fair?</summary>
