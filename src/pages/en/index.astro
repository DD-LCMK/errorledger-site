---
import BaseHead from '../../components/BaseHead.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import RectangleAd from '../../components/ads/RectangleAd.astro';
import NativeAd from '../../components/ads/NativeAd.astro';
import ReferralBanner from '../../components/ads/ReferralBanner.astro';
import { getCollection } from 'astro:content';
import { getKoUrl, getEnUrl } from '../../i18n';

const urlParams = Astro.url.searchParams;
const streamerMode = urlParams.has('stream') || urlParams.has('obs');

const games = await getCollection('games');
const priorityOrder = ['marble-roulette', 'roulette', 'ladder', 'drinking-marble', 'fortune'];
const sortedGames = games.sort((a, b) => {
  const idxA = priorityOrder.indexOf(a.id);
  const idxB = priorityOrder.indexOf(b.id);
  return (idxA !== -1 ? idxA : 99) - (idxB !== -1 ? idxB : 99);
});

const siteBase = Astro.site?.toString() || 'https://errorledger.com';
const rawPath = Astro.url.pathname.replace(/\/$/, '') || '/en';
const koUrl = getKoUrl(siteBase, rawPath);
const enUrl = getEnUrl(siteBase, rawPath);

const homeFaqSchema = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "How do I use fullscreen or focus mode?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Click the [⛶ Fullscreen] or [📺 Focus Mode] button in any game to fill your screen cleanly without any browser chrome for a distraction-free experience."
      }
    },
    {
      "@type": "Question",
      "name": "Is StreamArcade free? Do I need to sign up?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes — 100% free, forever. No login, no account, no download required. Every tool is ready to use in your browser within seconds."
      }
    },
    {
      "@type": "Question",
      "name": "Does it work on Twitch, YouTube Live, and other platforms?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes. StreamArcade is a standard web app that works in any browser, making it compatible with Twitch, YouTube Live, CHZZK, SOOP (AfreecaTV), Kick, and any other streaming platform."
      }
    },
    {
      "@type": "Question",
      "name": "Are the results fair? Can results be manipulated?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "The Wheel and Ladder games use cryptographically seeded pseudo-random algorithms and mathematical bijective mapping. No one can predict or manipulate the outcome."
      }
    },
    {
      "@type": "Question",
      "name": "What is StreamArcade?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "StreamArcade provides 100% free, client-side interactive web games, tests (MBTI), and stream utility tools for global livestreamers, creators, and viewers."
      }
    }
  ]
});
---

<!doctype html>
<html lang="en" class="dark">
  <head>
    <BaseHead
      title="StreamArcade — Free Marble Roulette, Spin Wheel & Ladder Game for Streamers"
      description="Free browser-based stream tools for Twitch, YouTube, CHZZK & SOOP streamers. Marble Race Roulette, Random Wheel Picker, Ghost Leg Ladder Game — no install, no login."
      lang="en"
      hreflangKo={koUrl}
      hreflangEn={enUrl}
      keywords="Marble Roulette, Marble Race, Stream Arcade, StreamArcade, Random Wheel Picker, Ghost Leg Ladder, Amidakuji, Streamer Tools, Twitch Tools, YouTube Live Games, Free Stream Overlay, Fullscreen Browser Games"
    />
    <script type="application/ld+json" set:html={homeFaqSchema}></script>
  </head>
  <body class="arcade-home-body">
    <Header />

    <main class="arcade-home-main">
      <!-- Hero Section -->
      <section class="hero-showcase">
        <div class="hero-backdrop"></div>
        <div class="hero-content">
          <h1 class="hero-headline">
            Free <span class="gradient-text">Stream Tools</span> for Live Creators
          </h1>

          <p class="hero-subtext">
            Launch in 1 second — no install, no login. Marble race, spin wheel, and ladder game built for streamers.
          </p>

          <!-- Featured Game Hero Banner -->
          <div class="featured-hero-card">
            <div class="featured-main-row">
              <div class="featured-icon-box">🔮</div>
              <div class="featured-text">
                <span class="flagship-label">🔥 #1 Featured Tool</span>
                <h2>Marble Race Roulette</h2>
                <p>A 7,200px long track with physics pins, spinners, and a finale propeller — the most exciting way to pick a winner live.</p>
              </div>
              <div class="featured-action">
                <a href="/en/games/marble-roulette" class="btn-play-hero">
                  <span>Start Marble Race →</span>
                </a>
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- Games Grid -->
      <section class="games-directory-section">
        <div class="section-header">
          <h2>Stream Tool Lineup</h2>
        </div>

        <div class="games-grid">
          {sortedGames.map(game => {
            const href = game.id === 'fortune' ? '/en/fortune' : `/en/games/${game.id}`;
            const btnText = game.id === 'fortune' ? 'View Fortune →' : 'Launch →';
            const enTitle: Record<string, string> = {
              'marble-roulette': 'Marble Race Roulette',
              'roulette': 'Random Spin Wheel',
              'ladder': 'Ghost Leg Ladder Game',
              'drinking-marble': 'Blossom Board (Drinking & Penalty)',
              'fortune': 'Daily Fortune',
            };
            const enTagline: Record<string, string> = {
              'marble-roulette': 'Physics-based marble race with live track, pins & spinners',
              'roulette': 'Ratchet-click spin wheel with confetti winner reveal',
              'ladder': 'Real-time animated ghost-leg (Amidakuji) for 2–20 players',
              'drinking-marble': 'Monopoly-style drinking & penalty board with 3D rolling dice',
              'fortune': 'Daily auto-updated horoscope & zodiac fortune for stream openers',
            };
            const enBadge: Record<string, string> = {
              'marble-roulette': 'Marble Race',
              'roulette': 'Featured Tool',
              'ladder': 'Bets & Penalties',
              'drinking-marble': '🌸 New Game',
              'fortune': 'Daily Free',
            };
            return (
              <article class="game-card">
                <div class="card-top-row">
                  <span class="card-icon">{game.data.icon}</span>
                  <span class="badge-accent">{enBadge[game.id] ?? game.data.badge}</span>
                </div>

                <div class="card-body">
                  <h3 class="card-title">
                    <a href={href}>{enTitle[game.id] ?? game.data.title}</a>
                  </h3>
                  <p class="card-tagline">{enTagline[game.id] ?? game.data.tagline}</p>
                </div>

                <div class="card-footer">
                  <span class="meta-item">⏱️ {game.data.playTime}</span>
                  <a href={href} class="btn-play-card">
                    <span>{btnText}</span>
                  </a>
                </div>
              </article>
            );
          })}
        </div>
      </section>

      <!-- Bzzk Clean Radar Highlight Banner -->
      <section class="bzzk-home-banner">
        <div class="bzzk-banner-card">
          <div class="bzzk-banner-glow"></div>
          <div class="bzzk-banner-left">
            <div class="bzzk-badge">
              <span class="pulse-dot"></span>
              <span>NEW CHZZK STREAM SECURITY RADAR</span>
            </div>
            <h3>Bzzk <span class="gradient-text">(검지직)</span></h3>
            <p>
              Real-time cross-channel analysis of multi-banned raid accounts on Naver Chzzk. Protect your stream chat before malicious actors arrive!
            </p>
          </div>
          <div class="bzzk-banner-right">
            <a href="/en/bzzk" class="btn-bzzk-banner">
              <span>View Live Radar →</span>
            </a>
          </div>
        </div>
      </section>

      <!-- MBTI Personality Test Highlight Banner -->
      <section class="mbti-home-banner">
        <div class="mbti-banner-card">
          <div class="mbti-banner-glow"></div>
          <div class="mbti-banner-left">
            <div class="mbti-badge">
              <span class="pulse-dot-mbti"></span>
              <span>🧠 EMPIRICAL 60-ITEM COGNITIVE FUNCTION TEST</span>
            </div>
            <h3>Scientific MBTI <span class="gradient-text">(Personality & Cognition)</span></h3>
            <p>
              Beyond superficial 4-letter labels. Discover your 4-axis spectrum %, 8-layer Jungian cognitive function stack, career blueprint, love compatibility, and creator persona!
            </p>
          </div>
          <div class="mbti-banner-right">
            <a href="/en/mbti" class="btn-mbti-banner">
              <span>Start Assessment →</span>
            </a>
          </div>
        </div>
      </section>

      <!-- Content Rectangle Ad -->
      <RectangleAd streamerMode={streamerMode} />

      <!-- Platform Overview -->
      <section class="seo-overview-section">
        <div class="overview-container">
          <div class="overview-header">
            <span class="overview-pill">STREAM ARCADE PLATFORM</span>
            <h2>Free Interactive Web Games & Random Draw Tools for Streamers</h2>
            <p class="overview-sub">
              StreamArcade is a no-install, no-login platform delivering broadcast-ready interactive games for Twitch, YouTube Live, CHZZK, SOOP (AfreecaTV), and Kick streamers.
            </p>
          </div>

          <div class="overview-grid">
            <div class="overview-card">
              <span class="overview-icon">🔮</span>
              <h3>Marble Race Roulette</h3>
              <p>
                More thrilling than a plain spin wheel — a real-time physics marble race with Galton pin boards, twin windmills, pinball bumpers, vortex bowls, and a giant finale propeller that bats marbles back for dramatic reversals.
              </p>
            </div>

            <div class="overview-card">
              <span class="overview-icon">🎡</span>
              <h3>Random Spin Wheel (Roulette)</h3>
              <p>
                Satisfying ratchet-click audio, winner confetti explosion, automatic removal of picked items, and one-click presets for food, penalties, and giveaways. Built for broadcast.
              </p>
            </div>

            <div class="overview-card">
              <span class="overview-icon">🪜</span>
              <h3>Ghost Leg Ladder Game (Amidakuji)</h3>
              <p>
                Animated neon footstep trail through a real-time Amidakuji ladder for 2–20 players. Fair, one-to-one bijective mapping ensures nobody can predict or rig the result.
              </p>
            </div>

            <div class="overview-card">
              <span class="overview-icon">✨</span>
              <h3>Daily Fortune & Horoscope</h3>
              <p>
                Auto-refreshed at midnight: 12 Eastern zodiac animal fortunes and 12 Western star sign readings, each with lucky numbers, colors, and daily DO/DON'T tips for stream openers.
              </p>
            </div>

            <div class="overview-card">
              <span class="overview-icon">🛡️</span>
              <h3>Bzzk (Chzzk Stream Security Radar)</h3>
              <p>
                Real-time cross-channel intelligence network detecting high-risk malicious actors across Chzzk streams, shielding your chatroom with automatic pre-emptive restrictions.
              </p>
            </div>

            <div class="overview-card">
              <span class="overview-icon">🧠</span>
              <h3>Scientific MBTI & 8 Cognitive Functions Test</h3>
              <p>
                Empirical 60-item instrument with balanced reverse scoring. Dissect your 8 Jungian cognitive functions, stress loops, workplace superpowers, real-time chemistry calculator, and creator streaming persona.
              </p>
            </div>
          </div>
        </div>
      </section>

      <!-- Native Recommendation Widget -->
      <NativeAd streamerMode={streamerMode} />

      <!-- FAQ -->
      <section class="home-faq-section">
        <div class="faq-container">
          <h2>Frequently Asked Questions</h2>
          <div class="faq-grid">
            <div class="faq-box">
              <h3>How do I use fullscreen or focus mode?</h3>
              <p>Click the [⛶ Fullscreen] or [📺 Focus Mode] button in the top-right of any game to go borderless for clean, distraction-free play.</p>
            </div>
            <div class="faq-box">
              <h3>Is it free? Do I need to sign up?</h3>
              <p>100% free, forever. No account, no login, no download. Open the link and it works instantly in any browser.</p>
            </div>
            <div class="faq-box">
              <h3>Does it work on Twitch, YouTube, and CHZZK?</h3>
              <p>Yes. It runs in any standard web browser, so it works with Twitch, YouTube Live, CHZZK, SOOP, Kick, and any other platform.</p>
            </div>
            <div class="faq-box">
              <h3>Are results fair? Can anyone manipulate them?</h3>
              <p>The Spin Wheel and Ghost Leg Ladder use cryptographically seeded PRNG with mathematical bijective mapping — fully random and tamper-proof.</p>
            </div>
            <div class="faq-box">
              <h3>What is StreamArcade?</h3>
              <p>StreamArcade provides 100% free, client-side interactive web games, tests (MBTI), and stream utility tools for global livestreamers, creators, and communities.</p>
            </div>
          </div>
        </div>
      </section>

      <!-- Adsterra Publisher Referral Banner -->
      <ReferralBanner streamerMode={streamerMode} />
    </main>

    {!streamerMode && <Footer />}
  </body>
</html>

<style>
  .arcade-home-body {
    background: #090d16 !important;
    color: #f1f5f9 !important;
    min-height: 100vh;
    display: flex;
    flex-direction: column;
  }

  .arcade-home-main {
    flex: 1;
    max-width: 1200px;
    margin: 0 auto;
    padding: 2rem 1.5rem 7rem;
    width: 100%;
    box-sizing: border-box;
  }

  .hero-showcase {
    position: relative;
    padding: 3rem 1rem 2.5rem;
    text-align: center;
    overflow: hidden;
  }

  .hero-backdrop {
    position: absolute;
    top: -30%;
    left: 50%;
    transform: translateX(-50%);
    width: 650px;
    height: 450px;
    background: radial-gradient(circle, rgba(168, 85, 247, 0.22) 0%, rgba(56, 189, 248, 0.1) 50%, transparent 80%);
    filter: blur(60px);
    pointer-events: none;
    z-index: 0;
  }

  .hero-content {
    position: relative;
    z-index: 1;
    max-width: 850px;
    margin: 0 auto;
  }

  .hero-headline {
    font-size: clamp(1.9rem, 5vw, 3.2rem);
    font-weight: 900;
    line-height: 1.15;
    margin-bottom: 1rem;
    color: #f8fafc;
    letter-spacing: -0.03em;
  }

  .gradient-text {
    background: linear-gradient(135deg, #a855f7 0%, #38bdf8 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .hero-subtext {
    font-size: 1.05rem;
    color: #94a3b8;
    margin-bottom: 2rem;
    max-width: 560px;
    margin-left: auto;
    margin-right: auto;
  }

  .featured-hero-card {
    background: linear-gradient(135deg, rgba(168, 85, 247, 0.12) 0%, rgba(56, 189, 248, 0.08) 100%);
    border: 1px solid rgba(168, 85, 247, 0.25);
    border-radius: 16px;
    padding: 1.5rem;
    text-align: left;
  }

  .featured-main-row {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    flex-wrap: wrap;
  }

  .featured-icon-box {
    font-size: 2.8rem;
    flex-shrink: 0;
  }

  .featured-text {
    flex: 1;
    min-width: 200px;
  }

  .flagship-label {
    display: inline-block;
    font-size: 0.72rem;
    font-weight: 800;
    color: #fb923c;
    background: rgba(251, 146, 60, 0.12);
    border: 1px solid rgba(251, 146, 60, 0.3);
    padding: 0.2rem 0.55rem;
    border-radius: 999px;
    margin-bottom: 0.4rem;
    letter-spacing: 0.04em;
  }

  .featured-text h2 {
    font-size: 1.35rem;
    font-weight: 900;
    color: #f8fafc;
    margin: 0 0 0.35rem;
  }

  .featured-text p {
    font-size: 0.88rem;
    color: #94a3b8;
    margin: 0;
    line-height: 1.55;
  }

  .featured-action {
    flex-shrink: 0;
  }

  .btn-play-hero {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    background: linear-gradient(135deg, #a855f7 0%, #38bdf8 100%);
    color: #ffffff;
    text-decoration: none;
    font-size: 0.92rem;
    font-weight: 800;
    padding: 0.65rem 1.3rem;
    border-radius: 10px;
    transition: all 0.15s ease;
    white-space: nowrap;
  }

  .btn-play-hero:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 24px rgba(168, 85, 247, 0.35);
  }

  .games-directory-section {
    margin-top: 3.5rem;
  }

  .section-header {
    margin-bottom: 1.5rem;
    text-align: center;
  }

  .section-header h2 {
    font-size: 1.6rem;
    font-weight: 900;
    color: #f8fafc;
    margin: 0;
    letter-spacing: -0.02em;
  }

  .games-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(210px, 1fr));
    gap: 1.25rem;
  }

  @media (max-width: 1080px) {
    .games-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 600px) {
    .games-grid {
      grid-template-columns: 1fr;
    }
  }

  .game-card {
    background: rgba(15, 23, 42, 0.8);
    border: 1px solid rgba(255, 255, 255, 0.07);
    border-radius: 14px;
    padding: 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
    transition: all 0.2s ease;
  }

  .game-card:hover {
    border-color: rgba(168, 85, 247, 0.3);
    transform: translateY(-3px);
    box-shadow: 0 12px 32px rgba(0, 0, 0, 0.25);
  }

  .card-top-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .card-icon {
    font-size: 2rem;
  }

  .badge-accent {
    font-size: 0.7rem;
    font-weight: 700;
    background: rgba(168, 85, 247, 0.15);
    color: #c084fc;
    border: 1px solid rgba(168, 85, 247, 0.25);
    padding: 0.2rem 0.5rem;
    border-radius: 999px;
  }

  .card-title a {
    font-size: 1.05rem;
    font-weight: 800;
    color: #f8fafc;
    text-decoration: none;
  }

  .card-title a:hover {
    color: #a855f7;
  }

  .card-tagline {
    font-size: 0.82rem;
    color: #64748b;
    line-height: 1.5;
    margin: 0;
  }

  .card-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-top: auto;
  }

  .meta-item {
    font-size: 0.76rem;
    color: #64748b;
  }

  .btn-play-card {
    display: inline-flex;
    align-items: center;
    font-size: 0.78rem;
    font-weight: 700;
    color: #a855f7;
    text-decoration: none;
    border: 1px solid rgba(168, 85, 247, 0.3);
    padding: 0.3rem 0.7rem;
    border-radius: 7px;
    background: rgba(168, 85, 247, 0.08);
    transition: all 0.15s ease;
  }

  .btn-play-card:hover {
    background: rgba(168, 85, 247, 0.18);
    border-color: rgba(168, 85, 247, 0.5);
    color: #d8b4fe;
  }

  .seo-overview-section {
    margin-top: 4rem;
    padding: 3rem 1.5rem;
    background: rgba(15, 23, 42, 0.5);
    border: 1px solid rgba(255, 255, 255, 0.05);
    border-radius: 16px;
  }

  .overview-header {
    text-align: center;
    margin-bottom: 2.5rem;
  }

  .overview-pill {
    display: inline-block;
    font-size: 0.68rem;
    font-weight: 800;
    letter-spacing: 0.1em;
    color: #38bdf8;
    background: rgba(56, 189, 248, 0.1);
    border: 1px solid rgba(56, 189, 248, 0.2);
    padding: 0.25rem 0.7rem;
    border-radius: 999px;
    margin-bottom: 0.75rem;
  }

  .overview-header h2 {
    font-size: 1.55rem;
    font-weight: 900;
    color: #f8fafc;
    margin: 0 0 0.75rem;
    letter-spacing: -0.02em;
  }

  .overview-sub {
    font-size: 0.93rem;
    color: #64748b;
    max-width: 680px;
    margin: 0 auto;
    line-height: 1.65;
  }

  .overview-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
    gap: 1.25rem;
  }

  .overview-card {
    background: rgba(9, 13, 22, 0.7);
    border: 1px solid rgba(255, 255, 255, 0.06);
    border-radius: 12px;
    padding: 1.25rem;
  }

  .overview-icon {
    font-size: 1.8rem;
    display: block;
    margin-bottom: 0.65rem;
  }

  .overview-card h3 {
    font-size: 0.97rem;
    font-weight: 800;
    color: #f1f5f9;
    margin: 0 0 0.5rem;
  }

  .overview-card p {
    font-size: 0.82rem;
    color: #64748b;
    line-height: 1.65;
    margin: 0;
  }

  .home-faq-section {
    margin-top: 4rem;
  }

  .faq-container h2 {
    font-size: 1.55rem;
    font-weight: 900;
    color: #f8fafc;
    text-align: center;
    margin-bottom: 1.75rem;
    letter-spacing: -0.02em;
  }

  .faq-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 1rem;
  }

  .faq-box {
    background: rgba(15, 23, 42, 0.7);
    border: 1px solid rgba(255, 255, 255, 0.06);
    border-radius: 12px;
    padding: 1.25rem;
  }

  .faq-box h3 {
    font-size: 0.93rem;
    font-weight: 800;
    color: #e2e8f0;
    margin: 0 0 0.5rem;
  }

  .faq-box p {
    font-size: 0.83rem;
    color: #64748b;
    line-height: 1.65;
    margin: 0;
  }

  .faq-box code {
    background: rgba(255, 255, 255, 0.1);
    padding: 0.1rem 0.3rem;
    border-radius: 4px;
    font-size: 0.8rem;
    color: #38bdf8;
  }

  /* Bzzk Home Banner Styles */
  .bzzk-home-banner {
    margin: 2.5rem 0 1.5rem;
  }

  .bzzk-banner-card {
    position: relative;
    background: linear-gradient(135deg, rgba(22, 27, 46, 0.95) 0%, rgba(30, 27, 75, 0.75) 100%);
    border: 1px solid rgba(99, 102, 241, 0.35);
    border-radius: 20px;
    padding: 28px 36px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    overflow: hidden;
    box-shadow: 0 12px 30px -10px rgba(99, 102, 241, 0.25);
  }

  .bzzk-banner-glow {
    position: absolute;
    top: -40%;
    left: 20%;
    width: 300px;
    height: 200px;
    background: radial-gradient(circle, rgba(99, 102, 241, 0.25) 0%, transparent 70%);
    filter: blur(40px);
    pointer-events: none;
  }

  .bzzk-banner-left {
    position: relative;
    z-index: 1;
    max-width: 680px;
  }

  .bzzk-badge {
    display: inline-flex;
    align-items: center;
