---
import BaseHead from '../../components/BaseHead.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { SITE_TITLE } from '../../consts';
import { getKoUrl, getEnUrl } from '../../i18n';

const siteBase = Astro.site?.toString() || 'https://errorledger.com';
const rawPath = Astro.url.pathname.replace(/\/$/, '');
const koUrl = getKoUrl(siteBase, rawPath);
const enUrl = getEnUrl(siteBase, rawPath);
---

<!doctype html>
<html lang="en" class="dark">
  <head>
    <BaseHead
      title={`About ErrorLedger — Free Stream Tools & Interactive Creator Suite`}
      description="Learn about ErrorLedger: an all-in-one free platform providing interactive stream games, broadcast utilities, and psychological assessments for creators on Twitch, YouTube, CHZZK, and SOOP."
      lang="en"
      hreflangKo={koUrl}
      hreflangEn={enUrl}
    />
  </head>
  <body class="static-page-body">
    <Header />

    <main class="static-page-main">
      <div class="content-container">
        <span class="pill-label">About ErrorLedger</span>
        <h1>All-in-One Broadcast Utility & Interactive Games Studio</h1>

        <p class="lead-text">
          <strong>ErrorLedger</strong> is a 100% free creator platform delivering essential broadcast utilities, interactive web games, and psychometric tools tailored for live streamers and viewers across <em>CHZZK, YouTube Live, SOOP (AfreecaTV), and Twitch</em>.
        </p>

        <hr class="divider" />

        <h2>Our 4 Core Values</h2>
        <p>
          We built ErrorLedger to eliminate the friction of heavy program installations, complex logins, and expensive subscriptions during live broadcasts.
        </p>
        <ul>
          <li><strong>Zero Install & Instant Launch:</strong> Every web tool loads in under half a second via a single URL and runs immediately in full-screen broadcast mode.</li>
          <li><strong>Privacy First (Zero-Log & Local-First):</strong> No sign-up, registration, or cloud tracking required. All user preferences, schedules, and downloaded stream data stay strictly on your local PC.</li>
          <li><strong>Stream-Friendly Dark UI & 100% Free Monetization:</strong> Built with high-contrast dark themes, large on-screen typography, and real-time audio effects. Full live broadcasting, OBS screen capture, and YouTube monetization are completely permitted and free.</li>
          <li><strong>Perpetually Free (Non-Profit Creator Project):</strong> Operated entirely free of charge for the global creator community with no subscriptions, premium tiers, or hidden paywalls.</li>
        </ul>

        <h2>Representative Service Lineup</h2>

        <h3>🛠️ Essential Streamer Broadcast Utilities</h3>
        <ul>
          <li><strong>Chzzk Downloader:</strong> High-speed, lossless VOD replay & clip downloader for Naver CHZZK supporting original 1080p FHD 60fps quality.</li>
          <li><strong>Stream Schedule Studio:</strong> 10-second weekly/monthly broadcast timetable generator with 7 curated visual themes, PNG/Discord markdown one-click export, and local JSON preset backups.</li>
          <li><strong>Bzzk Clean Radar (검지직):</strong> Cross-channel moderation radar that tracks real-time chat restrictions across multiple CHZZK channels to prevent coordinated trolling.</li>
        </ul>

        <h3>🎮 Interactive Stream Games</h3>
        <ul>
          <li><strong>Marble Race Roulette:</strong> Real-time physics marble simulation featuring a 7,200px vertical track, pin obstacles, twin windmills, and turnaround spring bouncers.</li>
          <li><strong>Random Spin Wheel:</strong> Satisfying ratchet click sound, winner confetti, custom weights, and 1-click food/penalty presets.</li>
          <li><strong>Ghost Leg Ladder Game (Amidakuji):</strong> Interactive neon footstep animated ladder game for 2 to 20 players with strictly fair one-to-one bijective results.</li>
          <li><strong>Blossom Board:</strong> 3D dice-rolling drinking board game with embedded interactive mini-challenges designed for collaborative streams.</li>
          <li><strong>AI Music Quiz:</strong> Real-time blind listening game where players guess famous songs reimagined across various genres by AI.</li>
          <li><strong>Stream Doodle & Stream Emoji:</strong> 12 FPS procedural line-boil animated GIF doodle studio and retro 16-frame pixel emote maker with Twitch/Discord export presets.</li>
        </ul>

        <h3>🧠 Psychological & Daily Fortune</h3>
        <ul>
          <li><strong>Scientific MBTI Cognitive Function Assessment:</strong> In-depth 60-question psychometric test evaluating 4 dimensional scales, Jungian 8 cognitive function stacks, and custom streamer persona archetypes.</li>
          <li><strong>Daily Horoscope & Zodiac:</strong> Midnight auto-refreshed daily fortunes for 12 Eastern Zodiac animals and 12 Western astrology signs with lucky colors and numbers.</li>
        </ul>

        <h2>Feedback & Contact</h2>
        <p>
          Feedback, suggestions for new broadcast tools, bug reports, and collaboration inquiries are always welcome. Visit our <a href="/en/contact">Contact Page</a> or reach out directly at <code>contact@errorledger.com</code>.
        </p>
      </div>
    </main>

    <Footer />
  </body>
</html>

<style>
  .static-page-body {
    background: #090d16 !important;
    color: #f1f5f9 !important;
    min-height: 100vh;
    display: flex;
    flex-direction: column;
  }

  .static-page-main {
    flex: 1;
    max-width: 800px;
    margin: 0 auto;
    padding: 3rem 1.5rem 5rem;
    width: 100%;
  }

  .content-container {
    background: #0f172a;
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 16px;
    padding: 2.5rem;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.4);
    line-height: 1.75;
  }

  .pill-label {
    display: inline-block;
    font-size: 0.75rem;
    font-weight: 800;
    color: #38bdf8;
    background: rgba(56, 189, 248, 0.12);
    border: 1px solid rgba(56, 189, 248, 0.25);
    padding: 0.25rem 0.65rem;
    border-radius: 999px;
    margin-bottom: 1rem;
    letter-spacing: 0.05em;
  }

  h1 {
    font-size: 2.2rem;
    font-weight: 900;
    color: #f8fafc;
    letter-spacing: -0.03em;
    margin: 0 0 1rem;
    line-height: 1.25;
  }

  .lead-text {
    font-size: 1.1rem;
    color: #cbd5e1;
    margin-bottom: 1.5rem;
  }

  .divider {
    border: none;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
    margin: 2rem 0;
  }

  h2 {
    font-size: 1.4rem;
    font-weight: 800;
    color: #f8fafc;
    margin: 2rem 0 0.75rem;
  }

  h3 {
    font-size: 1.1rem;
    font-weight: 700;
    color: #38bdf8;
    margin: 1.5rem 0 0.5rem;
  }

  p {
    color: #94a3b8;
    font-size: 0.95rem;
    margin: 0 0 1rem;
  }

  ul {
    color: #cbd5e1;
    font-size: 0.95rem;
    padding-left: 1.5rem;
    margin-bottom: 1.5rem;
  }

  li {
    margin-bottom: 0.5rem;
  }

  a {
    color: #38bdf8;
    text-decoration: underline;
  }

  code {
    background: rgba(255, 255, 255, 0.06);
    padding: 0.2rem 0.4rem;
    border-radius: 4px;
    font-size: 0.88rem;
    color: #e2e8f0;
  }

  @media (max-width: 640px) {
    .content-container {
      padding: 1.5rem;
    }
    h1 {
      font-size: 1.75rem;
    }
  }
</style>
