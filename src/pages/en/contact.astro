---
import BaseHead from '../../components/BaseHead.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { getKoUrl, getEnUrl } from '../../i18n';

const siteBase = Astro.site?.toString() || 'https://errorledger.com';
const rawPath = Astro.url.pathname.replace(/\/$/, '');
const koUrl = getKoUrl(siteBase, rawPath);
const enUrl = getEnUrl(siteBase, rawPath);
---

<!doctype html>
<html lang="en" class="dark">
  <head>
    <BaseHead
      title="Contact StreamArcade — Feedback, Bug Reports & Feature Requests"
      description="Reach the StreamArcade team with feedback, bug reports, or feature ideas for Marble Roulette, Spin Wheel, Ladder Game, and other stream tools."
      lang="en"
      hreflangKo={koUrl}
      hreflangEn={enUrl}
    />
  </head>
  <body class="static-page-body">
    <Header />

    <main class="static-page-main">
      <div class="content-container">
        <span class="pill-label">Contact & Support</span>
        <h1>Get in Touch</h1>
        <p class="lead-text">
          Got an idea for a new stream tool or game? Found a bug in <em>Marble Roulette</em>, <em>Spin Wheel</em>, or <em>Ladder Game</em>? We'd love to hear from you.
        </p>

        <hr class="divider" />

        <div class="contact-channels">
          <div class="channel-card">
            <span class="channel-icon">📧</span>
            <div>
              <h3>Email</h3>
              <p>For bug reports, feature requests, or general questions:</p>
              <a href="mailto:contact@errorledger.com" class="contact-link">contact@errorledger.com</a>
            </div>
          </div>

          <div class="channel-card">
            <span class="channel-icon">💡</span>
            <div>
              <h3>Feature Suggestions</h3>
              <p>Have an idea for a new draw format, game mechanic, or stream integration? We read every message and prioritize based on community demand.</p>
            </div>
          </div>

          <div class="channel-card">
            <span class="channel-icon">🐛</span>
            <div>
              <h3>Bug Reports</h3>
              <p>Please describe your browser (Chrome/Firefox/Edge/Safari), device type (desktop/mobile), and steps to reproduce. Screenshots are very helpful.</p>
            </div>
          </div>
        </div>

        <hr class="divider" />

        <h2>Frequently Contacted Topics</h2>
        <ul>
          <li><strong>OBS Browser Source setup</strong> — add a Browser Source, open the game, click Fullscreen.</li>
          <li><strong>Multiple marbles per person</strong> — type <code>Name * 3</code> in the participant list.</li>
          <li><strong>Saving participant lists</strong> — paste your list before starting; the browser retains it during the session.</li>
          <li><strong>Ads / Streamer Mode</strong> — append <code>?stream=true</code> to any game URL to disable all ads for OBS capture.</li>
        </ul>
      </div>
    </main>

    <Footer />
  </body>
</html>

<style>
  .static-page-body {
    background: #090d16;
    color: #e2e8f0;
    min-height: 100vh;
    display: flex;
    flex-direction: column;
  }

  .static-page-main {
    flex: 1;
    max-width: 900px;
    margin: 0 auto;
    padding: 3rem 1.5rem 6rem;
    width: 100%;
  }

  .content-container {
    max-width: 720px;
  }

  .pill-label {
    display: inline-block;
    font-size: 0.72rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    color: #a855f7;
    background: rgba(168, 85, 247, 0.12);
    border: 1px solid rgba(168, 85, 247, 0.25);
    padding: 0.25rem 0.7rem;
    border-radius: 999px;
    margin-bottom: 1rem;
  }

  h1 {
    font-size: 2rem;
    font-weight: 900;
    color: #f8fafc;
    margin: 0 0 1.25rem;
    letter-spacing: -0.03em;
  }

  .lead-text {
    font-size: 1.05rem;
    color: #94a3b8;
    line-height: 1.7;
    margin-bottom: 2rem;
  }

  .divider {
    border: none;
    border-top: 1px solid rgba(255, 255, 255, 0.07);
    margin: 2rem 0;
  }

  h2 {
    font-size: 1.2rem;
    font-weight: 800;
    color: #f1f5f9;
    margin: 1.5rem 0 0.75rem;
  }

  h3 {
    font-size: 1rem;
    font-weight: 700;
    color: #e2e8f0;
    margin: 0 0 0.35rem;
  }

  p, li {
    font-size: 0.92rem;
    color: #94a3b8;
    line-height: 1.7;
    margin: 0;
  }

  ul {
    padding-left: 1.4rem;
    margin: 0.5rem 0;
  }

  li { margin-bottom: 0.5rem; }

  .contact-channels {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .channel-card {
    display: flex;
    gap: 1rem;
    background: rgba(15, 23, 42, 0.7);
    border: 1px solid rgba(255, 255, 255, 0.07);
    border-radius: 12px;
    padding: 1.25rem;
    align-items: flex-start;
  }

  .channel-icon {
    font-size: 1.6rem;
    flex-shrink: 0;
  }

  .contact-link {
    display: inline-block;
    margin-top: 0.35rem;
    color: #38bdf8;
    font-weight: 700;
    text-decoration: none;
    font-size: 0.92rem;
  }

  .contact-link:hover {
    text-decoration: underline;
  }

  code {
    background: rgba(255, 255, 255, 0.1);
    padding: 0.1rem 0.3rem;
    border-radius: 4px;
    font-size: 0.8rem;
    color: #38bdf8;
  }
</style>
