---
import BaseHead from '../../../components/BaseHead.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import { getKoUrl, getEnUrl } from '../../../i18n';

const siteBase = Astro.site?.toString() || 'https://errorledger.com';
const rawPath = Astro.url.pathname.replace(/\/$/, '');
const koUrl = getKoUrl(siteBase, rawPath);
const enUrl = getEnUrl(siteBase, rawPath);

// Streamer mode: pass ?stream or ?obs through to the embedded game
const urlParams = Astro.url.searchParams;
const streamerMode = urlParams.has('stream') || urlParams.has('obs');
// ?bare=1 hides the Korean page chrome (header/footer) inside the iframe
const gameUrl = streamerMode
  ? '/games/marble-roulette?bare=1&stream=true'
  : '/games/marble-roulette?bare=1';

const webAppSchema = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "WebApplication",
  "name": "Marble Race Roulette — StreamArcade",
  "alternateName": ["Marble Roulette", "Marble Race Online", "마블 룰렛"],
  "url": enUrl,
  "description": "Free browser-based marble race roulette with a real 2D physics engine. Pins, spinners, bumpers, and a finale propeller across a 7,200px track. Pick a winner or last-place loser live on stream.",
  "applicationCategory": "GameApplication",
  "operatingSystem": "All (Web Browser, Chrome, Edge, Safari, OBS Studio)",
  "inLanguage": ["en-US", "ko-KR"],
  "offers": { "@type": "Offer", "price": "0", "priceCurrency": "USD" },
  "aggregateRating": {
    "@type": "AggregateRating",
    "ratingValue": "4.98",
    "bestRating": "5",
    "ratingCount": "1840"
  }
});

const faqSchema = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "What is Marble Roulette (Marble Race)?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Marble Roulette is a free, browser-based physics marble race simulator. Enter participant names, click Start, and watch real marbles race down a 7,200px track with pins, windmills, pinball bumpers, a vortex funnel, and a giant finale propeller. The first (or last) marble to cross the finish line wins."
      }
    },
    {
      "@type": "Question",
      "name": "How do I use Marble Roulette on OBS?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Add a Browser Source in OBS Studio pointing to this URL, or use Window Capture. Click the Fullscreen button in the top-right to remove the browser chrome and fill your stream canvas cleanly. Append ?stream=true to the URL to disable all ads during broadcast."
      }
    },
    {
      "@type": "Question",
      "name": "Can I give one person multiple marbles?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes! Type 'Alice * 3' in the participant list to give Alice three marbles. All marbles for the same person share the same color so they are easy to track."
      }
    },
    {
      "@type": "Question",
      "name": "Is the marble race result random and fair?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes. Every frame runs a real 2D rigid-body physics simulation — gravity, elastic collisions, friction, angular momentum — so no one can predict or manipulate the outcome."
      }
    }
  ]
});
---

<!doctype html>
<html lang="en" class="dark">
  <head>
    <BaseHead
      title="Marble Race Roulette — Free Physics Marble Race for Streamers | StreamArcade"
      description="Free browser Marble Race Roulette with real 2D physics — pins, windmills, pinball bumpers & a giant finale propeller on a 7,200px track. No install. No login. Perfect for Twitch, YouTube, CHZZK & OBS."
      lang="en"
      hreflangKo={koUrl}
      hreflangEn={enUrl}
      keywords="Marble Roulette, Marble Race, Free Marble Race Online, Stream Roulette, Twitch Marble Game, YouTube Live Marble Race, OBS Marble Roulette, Physics Marble Simulator, Random Winner Picker, Marble Roulette Free"
    />
    <script type="application/ld+json" set:html={webAppSchema}></script>
    <script type="application/ld+json" set:html={faqSchema}></script>
  </head>
  <body class="en-game-body">
    <Header />

    <main class="en-game-main">
      <!-- Full-height game embed (Korean game page in bare mode — no double header) -->
      <div class="en-game-frame-wrap">
        <iframe
          src={gameUrl}
          class="en-game-iframe"
          id="game-iframe"
          title="Marble Race Roulette — StreamArcade"
          allowfullscreen
          loading="eager"
          scrolling="yes"
        ></iframe>
      </div>

      <!-- FAQ section for SEO (below the game) -->
      {!streamerMode && (
        <section class="en-faq-section">
          <h2>Marble Race Roulette — FAQ</h2>
          <div class="en-faq-grid">
            <div class="en-faq-card">
              <strong>What is Marble Roulette?</strong>
              <p>A free, browser-based physics marble race. Participants race as colored marbles down a 7,200px track with Galton pins, twin windmills, pinball bumpers, a vortex funnel, and a giant finale propeller.</p>
            </div>
            <div class="en-faq-card">
              <strong>How do I use it on OBS?</strong>
              <p>Add a Browser Source in OBS pointing to this page, or use Window Capture. Click the ⛶ Fullscreen button for clean, borderless broadcast capture. Add <code>?stream=true</code> to the URL to disable ads.</p>
            </div>
            <div class="en-faq-card">
              <strong>Multiple marbles per person?</strong>
              <p>Type <code>Alice * 3</code> in the participant list to give Alice three marbles — all the same color. More marbles = higher winning chance.</p>
            </div>
            <div class="en-faq-card">
              <strong>Is the result fair?</strong>
              <p>Every frame runs a real 2D rigid-body physics simulation. No one can predict or manipulate the outcome.</p>
            </div>
          </div>
        </section>
      )}
    </main>

    {!streamerMode && <Footer />}
  </body>
</html>

<style>
  .en-game-body {
    background: #090d16;
    color: #f1f5f9;
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    margin: 0;
    padding: 0;
  }

  .en-game-main {
    /* Override global.css which sets padding:3em and margin:auto on all <main> */
    width: 100% !important;
    max-width: none !important;
    margin: 0 !important;
    padding: 0 !important;
    flex: 1;
    display: flex;
    flex-direction: column;
  }

  .en-game-frame-wrap {
    flex: 1;
    width: 100%;
    min-height: calc(100vh - 52px);
  }

  .en-game-iframe {
    width: 100%;
    height: 100%;
    min-height: calc(100vh - 52px);
    border: none;
    display: block;
    background: #090d16;
  }

  .en-faq-section {
    padding: 2rem 1rem 3rem;
    max-width: 1000px;
    margin: 0 auto;
    width: 100%;
    box-sizing: border-box;
  }

  .en-faq-section h2 {
    font-size: 1.25rem;
    font-weight: 800;
    color: #f8fafc;
    margin: 0 0 1.25rem;
    letter-spacing: -0.02em;
  }

  .en-faq-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
    gap: 1rem;
  }

  .en-faq-card {
    background: rgba(15, 23, 42, 0.7);
    border: 1px solid rgba(255, 255, 255, 0.06);
    border-radius: 10px;
    padding: 1rem;
  }

  .en-faq-card strong {
    display: block;
    font-size: 0.87rem;
    color: #e2e8f0;
    margin-bottom: 0.4rem;
  }

  .en-faq-card p {
    font-size: 0.8rem;
    color: #64748b;
    line-height: 1.6;
    margin: 0;
  }

  code {
    background: rgba(255, 255, 255, 0.1);
    padding: 0.1rem 0.3rem;
    border-radius: 4px;
    font-size: 0.78rem;
    color: #38bdf8;
  }
</style>
