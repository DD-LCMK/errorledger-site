---
import BaseHead from '../../../components/BaseHead.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import { getKoUrl, getEnUrl } from '../../../i18n';

const siteBase = Astro.site?.toString() || 'https://errorledger.com';
const rawPath = Astro.url.pathname.replace(/\/$/, '');
const koUrl = getKoUrl(siteBase, rawPath);
const enUrl = getEnUrl(siteBase, rawPath);

const urlParams = Astro.url.searchParams;
const streamerMode = urlParams.has('stream') || urlParams.has('obs');
const gameUrl = streamerMode
  ? '/games/sword-enhance?bare=1&stream=true&lang=en'
  : '/games/sword-enhance?bare=1&lang=en';

const webAppSchema = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "WebApplication",
  "name": "Legendary +20 Sword Enhancer — ErrorLedger",
  "alternateName": ["Sword Enhancer", "+20 Weapon Enhancement Simulator", "전설의 +20강 무기 강화 시뮬레이터", "검 강화하기"],
  "url": enUrl,
  "description": "Free browser-based +20 weapon enhancement simulator with Star-Catch timing bonus, protection scrolls, memorial portrait on weapon shatter, and streamer pledge mode.",
  "applicationCategory": "GameApplication",
  "operatingSystem": "All (Web Browser, Chrome, Edge, Safari, Mobile)",
  "inLanguage": ["en-US", "ko-KR"],
  "offers": { "@type": "Offer", "price": "0", "priceCurrency": "USD" }
});
---

<!doctype html>
<html lang="en" class="dark">
  <head>
    <BaseHead
      title="Legendary +20 Sword Enhancer — Free Streamer Weapon Forging Game | ErrorLedger"
      description="Forge a Rusty Training Sword (+0) up to the Genesis Mythic Godblade (+20)! Features Star-Catch timing bonus, Protection Scrolls, Memorial Portrait on weapon shatter, and Streamer Pledge banner."
      lang="en"
      hreflangKo={koUrl}
      hreflangEn={enUrl}
      keywords="Sword Enhancer, Weapon Enhancement Simulator, +20 Sword Game, Streamer Mini Game, Twitch Queue Game, Chzzk Mini Game, Starforce Simulator"
    />
    <script type="application/ld+json" set:html={webAppSchema}></script>
  </head>
  <body class="en-game-body">
    <Header />

    <main class="en-game-main">
      <div class="en-game-frame-wrap">
        <iframe
          src={gameUrl}
          class="en-game-iframe"
          id="game-iframe"
          title="Legendary +20 Sword Enhancer — ErrorLedger"
          allowfullscreen
          loading="eager"
          scrolling="yes"
        ></iframe>
      </div>

      {!streamerMode && (
        <details class="stream-bottom-details">
          <summary class="details-summary">
            <span>📖 Detailed Guide & FAQ</span>
            <span class="chevron">▼</span>
          </summary>
          <div class="details-content">
            <div class="details-faq-section">
              <h3>Sword Enhancer FAQ</h3>
              <div class="details-faq-grid">
                <div class="details-faq-card">
                  <strong class="faq-q">Q. How do I earn gold and what is the +7 Sword of Greed?</strong>
                  <p class="faq-a">Reaching +7 forges the special Golden Sword of Greed worth a massive 45,000 G! Sell it immediately to fund your main sword and buy Protection Scrolls—if you enhance it to +8, it turns into a combat blade worth 21,000 G.</p>
                </div>
                <div class="details-faq-card">
                  <strong class="faq-q">Q. How does the Per-Sword Failure Stack (+1%p) work?</strong>
                  <p class="faq-a">Every time a specific sword fails 10 consecutive enhancements without shattering, that sword permanently gains +1%p enhancement chance! Storing the sword in your Inventory preserves its stacked bonus and streak.</p>
                </div>
                <div class="details-faq-card">
                  <strong class="faq-q">Q. Why is Bankruptcy Aid disabled?</strong>
                  <p class="faq-a">Emergency Bankruptcy Aid (+1,000 G) can only be claimed when you are truly broke: Gold under 100 G, current weapon at +0, and an empty Inventory.</p>
                </div>
                <div class="details-faq-card">
                  <strong class="faq-q">Q. How does the Weapon Inventory work?</strong>
                  <p class="faq-a">Click [Store in Inventory] to save your current +1 or higher weapon and start a fresh +0 twig. You can equip any stored sword back onto the anvil or sell it anytime.</p>
                </div>
              </div>
            </div>
          </div>
        </details>
      )}
    </main>

    {!streamerMode && <Footer />}

    <script>
      const iframe = document.getElementById('game-iframe') as HTMLIFrameElement;
      if (iframe) {
        var sp = new URLSearchParams(window.location.search);
        if (sp.has('stream') || sp.has('obs')) {
          var s = document.createElement('style');
          s.textContent = [
            '.leaderboard-ad-wrap { display: none !important; }',
            'footer { display: none !important; }',
            '.stream-bottom-details { display: none !important; }',
            '.arcade-header { display: none !important; }',
            '.en-game-main { padding: 0 !important; margin: 0 !important; max-width: none !important; }',
            '.en-game-frame-wrap { height: 100vh !important; }',
            '.en-game-iframe { height: 100vh !important; }'
          ].join(' ');
          document.head.appendChild(s);

          if (!iframe.src.includes('stream=true')) {
            iframe.src = iframe.src + '&stream=true';
          }
        } else {
          const syncHeight = () => {
            try {
              const doc = iframe.contentDocument || iframe.contentWindow?.document;
              if (doc && doc.documentElement) {
                const h = Math.max(820, doc.documentElement.scrollHeight);
                const wrap = iframe.parentElement;
                if (wrap) wrap.style.minHeight = h + 'px';
              }
            } catch (e) {}
          };
          iframe.addEventListener('load', () => {
            syncHeight();
            try {
              const doc = iframe.contentDocument || iframe.contentWindow?.document;
              if (doc && doc.body && typeof ResizeObserver !== 'undefined') {
                new ResizeObserver(syncHeight).observe(doc.body);
              }
            } catch (e) {}
          });
        }
      }
    </script>
  </body>
</html>

<style>
  .en-game-body {
    background: #090d16;
    color: #f1f5f9;
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    margin: 0;
    padding: 0;
  }

  .en-game-main {
    width: 100% !important;
    max-width: 100% !important;
    margin: 0 !important;
    padding: 0.5rem 0.75rem 2rem !important;
    flex: 1;
    display: flex;
    flex-direction: column;
    box-sizing: border-box;
  }

  .en-game-frame-wrap {
    width: 100%;
    height: 820px;
  }

  .en-game-iframe {
    width: 100%;
    height: 100%;
    border: none;
    display: block;
    background: transparent;
  }

  @media (min-width: 1400px) {
    .en-game-frame-wrap {
      height: max(800px, calc(100vh - 110px));
    }
  }

  .stream-bottom-details {
    margin-top: 1.5rem;
    background: #0f172a;
    border: 1px solid rgba(255, 255, 255, 0.06);
    border-radius: 10px;
    overflow: hidden;
    transition: border-color 0.15s ease;
  }

  .stream-bottom-details[open] {
    border-color: rgba(168, 85, 247, 0.3);
  }

  .details-summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.75rem 1.25rem;
    font-size: 0.84rem;
    font-weight: 700;
    color: #94a3b8;
    cursor: pointer;
    user-select: none;
    list-style: none;
    transition: color 0.15s ease;
  }

  .details-summary:hover {
    color: #e2e8f0;
  }

  .details-summary::-webkit-details-marker {
    display: none;
  }

  .chevron {
    font-size: 0.65rem;
    color: #a855f7;
    transition: transform 0.2s ease;
  }

  .stream-bottom-details[open] .chevron {
    transform: rotate(180deg);
  }

  .details-content {
    padding: 1.25rem;
    border-top: 1px solid rgba(255, 255, 255, 0.05);
    color: #cbd5e1;
    font-size: 0.85rem;
    line-height: 1.7;
  }

  .details-faq-section h3 {
    font-size: 0.95rem;
    color: #f8fafc;
    margin: 0 0 0.75rem;
  }

  .details-faq-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.75rem;
  }

  .details-faq-card {
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid rgba(255, 255, 255, 0.05);
    border-radius: 8px;
    padding: 0.75rem 1rem;
  }

  .faq-q {
    display: block;
    font-size: 0.82rem;
    color: #e2e8f0;
    margin-bottom: 0.35rem;
  }

  .faq-a {
    margin: 0;
    font-size: 0.78rem;
    color: #94a3b8;
    line-height: 1.55;
  }

  @media (max-width: 900px) {
    .details-faq-grid {
      grid-template-columns: 1fr;
    }
  }
</style>

