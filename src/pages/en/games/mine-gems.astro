---
import BaseHead from '../../../components/BaseHead.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import { getKoUrl, getEnUrl } from '../../../i18n';

const siteBase = Astro.site?.toString() || 'https://errorledger.com';
const rawPath = Astro.url.pathname.replace(/\/$/, '');
const koUrl = getKoUrl(siteBase, rawPath);
const enUrl = getEnUrl(siteBase, rawPath);

const urlParams = Astro.url.searchParams;
const streamerMode = urlParams.has('stream') || urlParams.has('obs');
const gameUrl = streamerMode
  ? '/games/mine-gems?bare=1&stream=true&lang=en'
  : '/games/mine-gems?bare=1&lang=en';

const webAppSchema = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "WebApplication",
  "name": "Mine Gems: Cash Out or Bust — ErrorLedger",
  "alternateName": ["Mine Gems", "Diamond Minesweeper Cash Out", "지뢰 보석 캐기", "익절 vs 손절 보석 캐기"],
  "url": enUrl,
  "description": "5x5 coordinate grid diamond mining game with 1, 3, 5, or 10 hidden mines, exponential cash-out multipliers, and Provably Fair SHA-256 pre-committed seed hashes.",
  "applicationCategory": "GameApplication",
  "operatingSystem": "All (Web Browser, Chrome, Edge, Safari, Mobile)",
  "inLanguage": ["en-US", "ko-KR"],
  "offers": { "@type": "Offer", "price": "0", "priceCurrency": "USD" }
});
---

<!doctype html>
<html lang="en" class="dark">
  <head>
    <BaseHead
      title="Mine Gems: Cash Out or Bust — Provably Fair 5x5 Diamond Mining Game | ErrorLedger"
      description="Excavate diamonds on a 5x5 coordinate grid (A1–E5) and cash out your multiplier before hitting a mine! Features 1/3/5/10 mine modes and Provably Fair SHA-256 seed verification."
      lang="en"
      hreflangKo={koUrl}
      hreflangEn={enUrl}
      keywords="Mine Gems, Diamond Mine Game, Cash Out Minesweeper, Streamer Chat Game, Provably Fair SHA-256 Game, Interactive Twitch Game"
    />
    <script type="application/ld+json" set:html={webAppSchema}></script>
  </head>
  <body class="en-game-body">
    <Header />

    <main class="en-game-main">
      <div class="en-game-frame-wrap">
        <iframe
          src={gameUrl}
          class="en-game-iframe"
          id="game-iframe"
          title="Mine Gems: Cash Out or Bust — ErrorLedger"
          allowfullscreen
          loading="eager"
          scrolling="yes"
        ></iframe>
      </div>

      {!streamerMode && (
        <details class="stream-bottom-details">
          <summary class="details-summary">
            <span>📖 Detailed Guide & FAQ</span>
            <span class="chevron">▼</span>
          </summary>
          <div class="details-content">
            <div class="details-faq-section">
              <h3>Mine Gems: Cash Out or Bust FAQ</h3>
              <div class="details-faq-grid">
                <div class="details-faq-card">
                  <strong class="faq-q">Q. Are the mine positions fixed before I click?</strong>
                  <p class="faq-a">Yes! At the start of every round, the exact mine coordinates (e.g., B2, D4, E1) and a random nonce are hashed with SHA-256 and shown below the board. When the round ends, the raw seed is revealed so you can verify zero manipulation.</p>
                </div>
                <div class="details-faq-card">
                  <strong class="faq-q">Q. How can stream viewers participate?</strong>
                  <p class="faq-a">Every tile on the 5x5 board is labeled from A1 to E5. Viewers in chat can call out coordinates ("Open C3!", "Cash out now!") or you can press [R] for a lucky random pick.</p>
                </div>
                <div class="details-faq-card">
                  <strong class="faq-q">Q. What is the difference between 1, 3, 5, and 10 mines?</strong>
                  <p class="faq-a">More mines mean higher risk on each click, but your multiplier skyrockets much faster—in 10-Mine Beast Mode, just 3 consecutive gems yield x5.04 and 5 gems yield x17.77!</p>
                </div>
                <div class="details-faq-card">
                  <strong class="faq-q">Q. What happens if I lose all my points?</strong>
                  <p class="faq-a">Whenever your balance drops below the 100 P minimum stake, the [+1,000 P Bankruptcy Relief] button on the left panel unlocks for free.</p>
                </div>
              </div>
            </div>
          </div>
        </details>
      )}
    </main>

    {!streamerMode && <Footer />}

    <script>
      const iframe = document.getElementById('game-iframe') as HTMLIFrameElement;
      if (iframe) {
        var sp = new URLSearchParams(window.location.search);
        if (sp.has('stream') || sp.has('obs')) {
          var s = document.createElement('style');
          s.textContent = [
            '.leaderboard-ad-wrap { display: none !important; }',
            'footer { display: none !important; }',
            '.stream-bottom-details { display: none !important; }',
            '.arcade-header { display: none !important; }',
            '.en-game-main { padding: 0 !important; margin: 0 !important; max-width: none !important; }',
            '.en-game-frame-wrap { height: 100vh !important; }',
            '.en-game-iframe { height: 100vh !important; }'
          ].join(' ');
          document.head.appendChild(s);

          if (!iframe.src.includes('stream=true')) {
            iframe.src = iframe.src + '&stream=true';
          }
        } else {
          const syncHeight = () => {
            try {
              const doc = iframe.contentDocument || iframe.contentWindow?.document;
              if (doc && doc.documentElement) {
                const h = Math.max(820, doc.documentElement.scrollHeight);
                const wrap = iframe.parentElement;
                if (wrap) wrap.style.minHeight = h + 'px';
              }
            } catch (e) {}
          };
          iframe.addEventListener('load', () => {
            syncHeight();
            try {
              const doc = iframe.contentDocument || iframe.contentWindow?.document;
              if (doc && doc.body && typeof ResizeObserver !== 'undefined') {
                new ResizeObserver(syncHeight).observe(doc.body);
              }
            } catch (e) {}
          });
        }
      }
    </script>
  </body>
</html>

<style>
  .en-game-body {
    background: #090d16;
    color: #f1f5f9;
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    margin: 0;
    padding: 0;
  }

  .en-game-main {
    width: 100% !important;
    max-width: 100% !important;
    margin: 0 !important;
    padding: 0.5rem 0.75rem 2rem !important;
    flex: 1;
    display: flex;
    flex-direction: column;
    box-sizing: border-box;
  }

  .en-game-frame-wrap {
    width: 100%;
    height: 820px;
  }

  .en-game-iframe {
    width: 100%;
    height: 100%;
    border: none;
    display: block;
    background: transparent;
  }

  @media (min-width: 1400px) {
    .en-game-frame-wrap {
      height: max(800px, calc(100vh - 110px));
    }
  }

  .stream-bottom-details {
    max-width: 1400px;
    width: 100%;
    margin: 2rem auto 0;
    background: rgba(15, 23, 42, 0.5);
    border: 1px solid rgba(255, 255, 255, 0.07);
    border-radius: 12px;
    overflow: hidden;
  }

  .details-summary {
    padding: 0.9rem 1.4rem;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: space-between;
    font-size: 0.9rem;
    font-weight: 700;
    color: #94a3b8;
    list-style: none;
    user-select: none;
  }

  .details-summary::-webkit-details-marker {
    display: none;
  }

  .details-content {
    padding: 1.5rem;
    border-top: 1px solid rgba(255, 255, 255, 0.06);
  }

  .details-faq-section h3 {
    font-size: 1rem;
    font-weight: 700;
    color: #e2e8f0;
    margin: 0 0 1rem;
  }

  .details-faq-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 1rem;
  }

  .details-faq-card {
    background: rgba(30, 41, 59, 0.45);
    border: 1px solid rgba(255, 255, 255, 0.06);
    border-radius: 10px;
    padding: 1rem;
  }

  .faq-q {
    display: block;
    font-size: 0.9rem;
    color: #f8fafc;
    margin-bottom: 0.45rem;
  }

  .faq-a {
    font-size: 0.84rem;
    color: #94a3b8;
    margin: 0;
    line-height: 1.55;
  }
</style>

