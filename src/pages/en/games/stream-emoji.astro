---
import BaseHead from '../../../components/BaseHead.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import LeaderboardAd from '../../../components/ads/LeaderboardAd.astro';
import { getKoUrl, getEnUrl } from '../../../i18n';

const siteBase = Astro.site?.toString() || 'https://errorledger.com';
const rawPath = Astro.url.pathname.replace(/\/$/, '');
const koUrl = getKoUrl(siteBase, rawPath);
const enUrl = getEnUrl(siteBase, rawPath);

const urlParams = Astro.url.searchParams;
const streamerMode = urlParams.has('stream') || urlParams.has('obs');
const gameUrl = streamerMode
  ? '/games/stream-emoji?bare=1&stream=true&lang=en'
  : '/games/stream-emoji?bare=1&lang=en';

const webAppSchema = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "WebApplication",
  "name": "Stream Emoji — ErrorLedger",
  "alternateName": ["Stream Emoji", "Animated Emoji Studio", "Twitch Emote Maker", "Discord Emoji Creator", "스트림 이모지"],
  "url": enUrl,
  "description": "Free browser-based multi-frame animated emoji studio for Twitch, Discord, and Chzzk streamers. Create custom frame-by-frame looping emotes with timeline controls, onion skinning, 1x chat scale live preview, and optimized GIF/spritesheet export.",
  "applicationCategory": "DrawingApplication",
  "operatingSystem": "All (Web Browser, Chrome, Edge, Safari, Mobile)",
  "inLanguage": ["en-US", "ko-KR"],
  "offers": { "@type": "Offer", "price": "0", "priceCurrency": "USD" }
});
---

<!doctype html>
<html lang="en" class="dark">
  <head>
    <BaseHead
      title="Stream Emoji — Free Multi-Frame Animated Emote Studio | ErrorLedger"
      description="Create custom frame-by-frame looping animated emotes for Twitch, Discord, and Chzzk! Features multi-frame timeline, onion skinning, 1x live chat preview widget, pixel square tip, paint bucket, and one-click GIF/spritesheet export."
      lang="en"
      hreflangKo={koUrl}
      hreflangEn={enUrl}
      keywords="Stream Emoji, Animated Emote Maker, Twitch Emote Maker, Discord Animated Emoji, Make GIF Emote Online, Frame by Frame Animation Tool, Pixel Art Emote Studio, Free Emote Creator"
    />
    <script type="application/ld+json" set:html={webAppSchema}></script>
  </head>
  <body class="en-game-body">
    <Header />

    <main class="en-game-main">
      <div class="en-game-frame-wrap">
        <iframe
          src={gameUrl}
          class="en-game-iframe"
          id="game-iframe"
          title="Stream Emoji — ErrorLedger"
          allowfullscreen
          loading="eager"
          scrolling="no"
        ></iframe>
      </div>

      <!-- Unobtrusive Expandable Information Drawer (for Guide & FAQ) -->
      {!streamerMode && (
        <details class="stream-bottom-details">
          <summary class="details-summary">
            <span>📖 Detailed Guide & FAQ</span>
            <span class="chevron">▼</span>
          </summary>
          <div class="details-content">
            <div class="details-faq-section">
              <h3>Stream Emoji FAQ</h3>
              <div class="details-faq-grid">
                <div class="details-faq-card">
                  <strong class="faq-q">Q. Can I upload the exported GIF directly to Discord or Twitch?</strong>
                  <p class="faq-a">Yes! Select 112×112 (Twitch/Chzzk Emote) or 128×128 (Discord Animated Emoji) from the top size menu. The exported GIF is automatically optimized with transparency and small file sizes to fit within Discord and Twitch upload limits.</p>
                </div>
                <div class="details-faq-card">
                  <strong class="faq-q">Q. What is Onion Skinning?</strong>
                  <p class="faq-a">Onion skinning displays faint ghost silhouettes of your previous frame (in warm red) and next frame (in cool blue). This makes drawing smooth motion in-betweens (like waving hands, bouncing slimes, or blinking eyes) super easy.</p>
                </div>
                <div class="details-faq-card">
                  <strong class="faq-q">Q. How do I duplicate a frame?</strong>
                  <p class="faq-a">In the bottom timeline bar, click the [❐ Duplicate] button. It copies your current drawing into a new frame so you only need to tweak slight movements instead of redrawing from scratch.</p>
                </div>
                <div class="details-faq-card">
                  <strong class="faq-q">Q. What is the 1x Chat Scale Preview Widget?</strong>
                  <p class="faq-a">When drawing on a zoomed-in canvas, it can be hard to tell how your emote will look when shrunken to actual chat size. The floating preview widget shows your animation looping inside a simulated Discord/Twitch chat bubble at 32px, 48px, or 112px in real time.</p>
                </div>
                <div class="details-faq-card">
                  <strong class="faq-q">Q. Can I export a Spritesheet for game dev or web animation?</strong>
                  <p class="faq-a">Yes! Click the [🎞️ Spritesheet] button in the top bar to download all animation frames lined up horizontally in a single transparent PNG image, ready for Unity, Godot, or CSS keyframe animations.</p>
                </div>
                <div class="details-faq-card">
                  <strong class="faq-q">Q. Are my drawings stored or uploaded to any server?</strong>
                  <p class="faq-a">No. Everything runs 100% locally in your web browser. No accounts, no cloud uploads, and complete creative privacy.</p>
                </div>
              </div>
            </div>
          </div>
        </details>
      )}

      <!-- Horizontal single-line ad below detail guide & FAQ -->
      <LeaderboardAd streamerMode={streamerMode} />
    </main>

    {!streamerMode && <Footer />}

    <script>
      const iframe = document.getElementById('game-iframe') as HTMLIFrameElement;
      if (iframe) {
        var sp = new URLSearchParams(window.location.search);
        if (sp.has('stream') || sp.has('obs')) {
          var s = document.createElement('style');
          s.textContent = [
            'header.arcade-header, footer.arcade-footer, .stream-bottom-details { display: none !important; }',
            'main.en-game-main { padding: 0 !important; margin: 0 !important; max-width: 100vw !important; }',
            '.en-game-frame-wrap { height: 100vh !important; border: none !important; border-radius: 0 !important; }',
            'body.en-game-body { background: transparent !important; overflow: hidden !important; }'
          ].join(' ');
          document.head.appendChild(s);
        }
      }
    </script>
  </body>
</html>

<style>
  .en-game-body {
    display: flex;
    flex-direction: column;
    min-height: 100vh;
    background-color: #060911;
    color: #f8fafc;
    margin: 0;
  }

  .en-game-main {
    flex: 1;
    display: flex;
    flex-direction: column;
    width: 100%;
    max-width: 1600px;
    margin: 0 auto;
    padding: 0.5rem 1rem 2rem;
    box-sizing: border-box;
    gap: 1rem;
  }

  .en-game-frame-wrap {
    width: 100%;
    height: calc(100vh - 120px);
    min-height: 640px;
    border-radius: 16px;
    overflow: hidden;
    background: #090d16;
    border: 1px solid rgba(255, 255, 255, 0.08);
    box-shadow: 0 16px 40px rgba(0, 0, 0, 0.6);
  }

  .en-game-iframe {
    width: 100%;
    height: 100%;
    border: none;
    display: block;
  }

  /* ── Collapsible Guide & FAQ Drawer ── */
  .stream-bottom-details {
    background: rgba(15, 23, 42, 0.7);
    backdrop-filter: blur(10px);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 12px;
    padding: 0.75rem 1.25rem;
    transition: all 0.2s ease;
  }

  .stream-bottom-details[open] {
    border-color: rgba(99, 102, 241, 0.3);
    background: rgba(15, 23, 42, 0.95);
  }

  .details-summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    cursor: pointer;
    font-size: 0.95rem;
    font-weight: 700;
    color: #cbd5e1;
    list-style: none;
    user-select: none;
  }
  .details-summary::-webkit-details-marker {
    display: none;
  }
  .details-summary:hover {
    color: #f8fafc;
  }

  .chevron {
    font-size: 0.75rem;
    transition: transform 0.2s ease;
    color: #64748b;
  }
  .stream-bottom-details[open] .chevron {
    transform: rotate(180deg);
    color: #818cf8;
  }

  .details-content {
    margin-top: 1rem;
    padding-top: 1rem;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
  }

  .details-faq-section h3 {
    font-size: 1.05rem;
    font-weight: 800;
    color: #f8fafc;
    margin-bottom: 0.85rem;
  }

  .details-faq-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    gap: 0.85rem;
  }

  .details-faq-card {
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid rgba(255, 255, 255, 0.06);
    border-radius: 10px;
    padding: 0.85rem 1rem;
  }

  .faq-q {
    display: block;
    font-size: 0.85rem;
    font-weight: 700;
    color: #38bdf8;
    margin-bottom: 0.35rem;
  }

  .faq-a {
    font-size: 0.8rem;
    color: #94a3b8;
    line-height: 1.5;
    margin: 0;
  }
</style>
