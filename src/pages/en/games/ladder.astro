---
import BaseHead from '../../../components/BaseHead.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import LeaderboardAd from '../../../components/ads/LeaderboardAd.astro';
import { getKoUrl, getEnUrl } from '../../../i18n';

const siteBase = Astro.site?.toString() || 'https://errorledger.com';
const rawPath = Astro.url.pathname.replace(/\/$/, '');
const koUrl = getKoUrl(siteBase, rawPath);
const enUrl = getEnUrl(siteBase, rawPath);

const urlParams = Astro.url.searchParams;
const streamerMode = urlParams.has('stream') || urlParams.has('obs');
const gameUrl = streamerMode
  ? '/games/ladder?bare=1&stream=true&lang=en'
  : '/games/ladder?bare=1&lang=en';

const webAppSchema = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "WebApplication",
  "name": "Ghost Leg Ladder Game (Amidakuji) — StreamArcade",
  "alternateName": ["Ghost Leg", "Amidakuji", "Ladder Game Online", "사다리타기"],
  "url": enUrl,
  "description": "Free browser-based Ghost Leg Ladder Game (Amidakuji) for 2–20 players. Real-time animated neon footstep trail for a fair, one-to-one result. Perfect for stream challenges, giveaways, and penalties.",
  "applicationCategory": "GameApplication",
  "operatingSystem": "All (Web Browser, Chrome, Edge, Safari, OBS Studio)",
  "inLanguage": ["en-US", "ko-KR"],
  "offers": { "@type": "Offer", "price": "0", "priceCurrency": "USD" }
});
---

<!doctype html>
<html lang="en" class="dark">
  <head>
    <BaseHead
      title="Ghost Leg Ladder Game (Amidakuji) — Free Stream Ladder for 2-20 Players | StreamArcade"
      description="Free browser Ghost Leg Ladder Game (Amidakuji) for 2–20 players. Animated neon footstep trail, fair bijective result, instant OBS capture. No install. No login."
      lang="en"
      hreflangKo={koUrl}
      hreflangEn={enUrl}
      keywords="Ghost Leg Ladder Game, Amidakuji Online, Free Ladder Game, Stream Ladder Game, Twitch Ladder, Random Ladder Picker, Amidakuji Simulator, Ghost Leg Online Free"
    />
    <script type="application/ld+json" set:html={webAppSchema}></script>
  </head>
  <body class="en-game-body">
    <Header />

    <main class="en-game-main">
      <div class="en-game-frame-wrap">
        <iframe
          src={gameUrl}
          class="en-game-iframe"
          id="game-iframe"
          title="Ghost Leg Ladder Game — StreamArcade"
          allowfullscreen
          loading="eager"
          scrolling="no"
        ></iframe>
      </div>

      <!-- Horizontal single-line ad directly beneath game -->
      <LeaderboardAd streamerMode={streamerMode} />

      <!-- Unobtrusive Expandable Information Drawer (for Guide & FAQ) -->
      {!streamerMode && (
        <details class="stream-bottom-details">
          <summary class="details-summary">
            <span>📖 Detailed Guide & FAQ</span>
            <span class="chevron">▼</span>
          </summary>
          <div class="details-content">
            <div class="details-faq-section">
              <h3>Ghost Leg Ladder FAQ</h3>
              <div class="details-faq-grid">
                <div class="details-faq-card">
                  <strong class="faq-q">Q. What is Ghost Leg / Amidakuji?</strong>
                  <p class="faq-a">Ghost Leg (Amidakuji) is a traditional Japanese lottery where players follow vertical lines connected by random horizontal rungs. Each player maps to exactly one result — completely fair and tamper-proof.</p>
                </div>
                <div class="details-faq-card">
                  <strong class="faq-q">Q. How many players can join?</strong>
                  <p class="faq-a">2 to 20 players per round. Enter names on the left and outcomes on the right, then reveal each path one by one or all at once.</p>
                </div>
                <div class="details-faq-card">
                  <strong class="faq-q">Q. How do I use it on OBS?</strong>
                  <p class="faq-a">Add a Browser Source in OBS pointing to this page, then click ⛶ Fullscreen. Append <code>?stream=true</code> to disable ads for broadcast.</p>
                </div>
                <div class="details-faq-card">
                  <strong class="faq-q">Q. Is the result fair?</strong>
                  <p class="faq-a">Yes. The ladder uses a bijective (one-to-one) mapping — every player maps to exactly one outcome and no two players can share a result.</p>
                </div>
              </div>
            </div>
          </div>
        </details>
      )}
    </main>

    {!streamerMode && <Footer />}

    <script>
      const iframe = document.getElementById('game-iframe') as HTMLIFrameElement;
      if (iframe) {
        // Streamer / OBS mode client-side check
        var sp = new URLSearchParams(window.location.search);
        if (sp.has('stream') || sp.has('obs')) {
          var s = document.createElement('style');
          s.textContent = [
            '.leaderboard-ad-wrap { display: none !important; }',
            'footer { display: none !important; }',
            '.stream-bottom-details { display: none !important; }',
            '.arcade-header { display: none !important; }',
            '.en-game-main { padding: 0 !important; margin: 0 !important; max-width: none !important; }',
            '.en-game-frame-wrap { height: 100vh !important; }',
            '.en-game-iframe { height: 100vh !important; }'
          ].join(' ');
          document.head.appendChild(s);

          if (!iframe.src.includes('stream=true')) {
            iframe.src = iframe.src + '&stream=true';
          }
        }
      }
    </script>
  </body>
</html>

<style>
  .en-game-body {
    background: #090d16;
    color: #f1f5f9;
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    margin: 0;
    padding: 0;
  }

  .en-game-main {
    /* Override global.css which sets padding:3em and margin:auto on all <main> */
    width: 100% !important;
    max-width: 1440px !important;
    margin: 0 auto !important;
    padding: 0.5rem 0.5rem 2rem !important;
    flex: 1;
    display: flex;
    flex-direction: column;
    box-sizing: border-box;
  }

  .en-game-frame-wrap {
    width: 100%;
    height: 850px;
  }

  .en-game-iframe {
    width: 100%;
    height: 100%;
    border: none;
    display: block;
    background: #090d16;
  }

  @media (min-width: 1400px) {
    .en-game-frame-wrap {
      height: max(840px, calc(100vh - 110px));
    }
  }

  /* Unobtrusive Bottom Drawer matching GameLayout */
  .stream-bottom-details {
    margin-top: 1.5rem;
    background: #0f172a;
    border: 1px solid rgba(255, 255, 255, 0.06);
    border-radius: 10px;
    overflow: hidden;
    transition: border-color 0.15s ease;
  }

  .stream-bottom-details[open] {
    border-color: rgba(168, 85, 247, 0.3);
  }

  .details-summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.75rem 1.25rem;
    font-size: 0.84rem;
    font-weight: 700;
    color: #94a3b8;
    cursor: pointer;
    user-select: none;
    list-style: none;
    transition: color 0.15s ease;
  }

  .details-summary:hover {
    color: #e2e8f0;
  }

  .details-summary::-webkit-details-marker {
    display: none;
  }

  .chevron {
    font-size: 0.65rem;
    color: #a855f7;
    transition: transform 0.2s ease;
  }

  .stream-bottom-details[open] .chevron {
    transform: rotate(180deg);
  }

  .details-content {
    padding: 1.25rem;
    border-top: 1px solid rgba(255, 255, 255, 0.05);
    color: #cbd5e1;
    font-size: 0.85rem;
    line-height: 1.7;
  }

  .details-faq-section h3 {
    font-size: 0.95rem;
    color: #f8fafc;
    margin: 0 0 0.75rem;
  }

  .details-faq-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.75rem;
  }

  .details-faq-card {
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid rgba(255, 255, 255, 0.05);
    border-radius: 8px;
    padding: 0.75rem 1rem;
  }

  .faq-q {
    display: block;
    font-size: 0.82rem;
    color: #e2e8f0;
    margin-bottom: 0.35rem;
  }

  .faq-a {
    margin: 0;
    font-size: 0.78rem;
    color: #94a3b8;
    line-height: 1.55;
  }

  code {
    background: rgba(255, 255, 255, 0.1);
    padding: 0.1rem 0.3rem;
    border-radius: 4px;
    font-size: 0.78rem;
    color: #38bdf8;
  }

  @media (max-width: 900px) {
    .details-faq-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
