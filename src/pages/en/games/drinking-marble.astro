---
import BaseHead from '../../../components/BaseHead.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import LeaderboardAd from '../../../components/ads/LeaderboardAd.astro';
import { getKoUrl, getEnUrl } from '../../../i18n';

const siteBase = Astro.site?.toString() || 'https://errorledger.com';
const rawPath = Astro.url.pathname.replace(/\/$/, '');
const koUrl = getKoUrl(siteBase, rawPath);
const enUrl = getEnUrl(siteBase, rawPath);

const urlParams = Astro.url.searchParams;
const streamerMode = urlParams.has('stream') || urlParams.has('obs');
const gameUrl = streamerMode
  ? '/games/drinking-marble?bare=1&stream=true&lang=en'
  : '/games/drinking-marble?bare=1&lang=en';

const webAppSchema = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "WebApplication",
  "name": "Blossom Board — StreamArcade",
  "alternateName": ["Drinking Board Game", "Monopoly Drinking Game", "Streamer Penalty Dice Game", "주루마블"],
  "url": enUrl,
  "description": "Free browser-based Monopoly-style drinking and penalty dice board game for live streamers. 3D animated rolling dice, customizable 24-tile board, cherry blossom theme, and one-click presets for drinking, penalties, or streamer talk.",
  "applicationCategory": "GameApplication",
  "operatingSystem": "All (Web Browser, Chrome, Edge, Safari, Mobile)",
  "inLanguage": ["en-US", "ko-KR"],
  "offers": { "@type": "Offer", "price": "0", "priceCurrency": "USD" }
});
---

<!doctype html>
<html lang="en" class="dark">
  <head>
    <BaseHead
      title="Blossom Board — Free Online Streamer Drinking & Penalty Dice Game | StreamArcade"
      description="Interactive Monopoly-style dice board game with 3D rolling dice, customizable 24-tile board, cherry blossom theme, and one-click presets for drinking, streamer penalties, or stream talk. 100% free, no install."
      lang="en"
      hreflangKo={koUrl}
      hreflangEn={enUrl}
      keywords="Drinking Board Game, Monopoly Drinking Game, Streamer Penalty Board, Blossom Board, Dice Game Online, Twitch Drinking Game, YouTube Stream Game, Virtual Board Game"
    />
    <script type="application/ld+json" set:html={webAppSchema}></script>
  </head>
  <body class="en-game-body">
    <Header />

    <main class="en-game-main">
      <div class="en-game-frame-wrap">
        <iframe
          src={gameUrl}
          class="en-game-iframe"
          id="game-iframe"
          title="Blossom Board — StreamArcade"
          allowfullscreen
          loading="eager"
          scrolling="no"
        ></iframe>
      </div>

      <!-- Unobtrusive Expandable Information Drawer (for Guide & FAQ) -->
      {!streamerMode && (
        <details class="stream-bottom-details">
          <summary class="details-summary">
            <span>📖 Detailed Guide & FAQ</span>
            <span class="chevron">▼</span>
          </summary>
          <div class="details-content">
            <div class="details-faq-section">
              <h3>Blossom Board FAQ</h3>
              <div class="details-faq-grid">
                <div class="details-faq-card">
                  <strong class="faq-q">Q. Can I play without alcohol?</strong>
                  <p class="faq-a">Absolutely! Select the "🌶️ Penalty Challenge" or "☕ Coffee & Chat" presets for clean, non-alcoholic streaming fun, workout challenges, or chill talk sessions.</p>
                </div>
                <div class="details-faq-card">
                  <strong class="faq-q">Q. How do I customize tiles?</strong>
                  <p class="faq-a">Click any tile directly on the board or click "✏️ Edit Board" in the top-right to customize penalties, icons, and text. Your edits are saved to your browser automatically.</p>
                </div>
                <div class="details-faq-card">
                  <strong class="faq-q">Q. How do I use fullscreen mode?</strong>
                  <p class="faq-a">Click the [⛶ Fullscreen] button in the top bar to expand the game across your entire screen for clean, distraction-free play.</p>
                </div>
                <div class="details-faq-card">
                  <strong class="faq-q">Q. Can multiple streamers or friends play together?</strong>
                  <p class="faq-a">Yes! Switch to 2P, 3P, or 4P mode at the top. Each player gets a distinct colored token and the turn automatically passes after each roll.</p>
                </div>
              </div>
            </div>
          </div>
        </details>
      )}

      <!-- Horizontal single-line ad below detail guide & FAQ -->
      <LeaderboardAd streamerMode={streamerMode} />
    </main>

    {!streamerMode && <Footer />}

    <script>
      const iframe = document.getElementById('game-iframe') as HTMLIFrameElement;
      if (iframe) {
        // Streamer / OBS mode client-side check
        var sp = new URLSearchParams(window.location.search);
        if (sp.has('stream') || sp.has('obs')) {
          var s = document.createElement('style');
          s.textContent = [
            '.leaderboard-ad-wrap { display: none !important; }',
            'footer { display: none !important; }',
            '.stream-bottom-details { display: none !important; }',
            '.arcade-header { display: none !important; }',
            '.en-game-main { padding: 0 !important; margin: 0 !important; max-width: none !important; }',
            '.en-game-frame-wrap { height: 100vh !important; }',
            '.en-game-iframe { height: 100vh !important; }'
          ].join(' ');
          document.head.appendChild(s);

          if (!iframe.src.includes('stream=true')) {
            iframe.src = iframe.src + '&stream=true';
          }
        }
      }
    </script>
  </body>
</html>

<style>
  .en-game-body {
    background: #090d16;
    color: #f1f5f9;
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    margin: 0;
    padding: 0;
  }

  .en-game-main {
    width: 100% !important;
    max-width: 100% !important;
    margin: 0 !important;
    padding: 0.5rem 0.75rem 2rem !important;
    flex: 1;
    display: flex;
    flex-direction: column;
    box-sizing: border-box;
  }

  .en-game-frame-wrap {
    width: 100%;
    height: 770px;
  }

  .en-game-iframe {
    width: 100%;
    height: 100%;
    border: none;
    display: block;
    background: #090d16;
  }

  @media (min-width: 1400px) {
    .en-game-frame-wrap {
      height: 770px;
    }
  }

  /* Bottom Drawer matching GameLayout */
  .stream-bottom-details {
    margin-top: 1.5rem;
    background: #0f172a;
    border: 1px solid rgba(255, 255, 255, 0.06);
    border-radius: 10px;
    overflow: hidden;
    transition: border-color 0.15s ease;
  }

  .stream-bottom-details[open] {
    border-color: rgba(244, 114, 182, 0.4);
  }

  .details-summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.75rem 1.25rem;
    font-size: 0.84rem;
    font-weight: 700;
    color: #94a3b8;
    cursor: pointer;
    user-select: none;
    list-style: none;
    transition: color 0.15s ease;
  }

  .details-summary:hover {
    color: #e2e8f0;
  }

  .details-summary::-webkit-details-marker {
    display: none;
  }

  .chevron {
    font-size: 0.65rem;
    color: #f472b6;
    transition: transform 0.2s ease;
  }

  .stream-bottom-details[open] .chevron {
    transform: rotate(180deg);
  }

  .details-content {
    padding: 1.25rem;
    border-top: 1px solid rgba(255, 255, 255, 0.05);
    color: #cbd5e1;
    font-size: 0.85rem;
  }

  .details-faq-section h3 {
    font-size: 1.05rem;
    font-weight: 800;
    color: #f8fafc;
    margin: 0 0 1rem;
  }

  .details-faq-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 1rem;
  }

  .details-faq-card {
    background: rgba(15, 23, 42, 0.6);
    border: 1px solid rgba(255, 255, 255, 0.05);
    border-radius: 8px;
    padding: 1rem;
  }

  .faq-q {
    display: block;
    font-size: 0.86rem;
    font-weight: 800;
    color: #e2e8f0;
    margin-bottom: 0.35rem;
  }

  .faq-a {
    font-size: 0.8rem;
    color: #94a3b8;
    line-height: 1.5;
    margin: 0;
  }

  .faq-a code {
    background: rgba(255, 255, 255, 0.1);
    padding: 0.1rem 0.3rem;
    border-radius: 4px;
    font-size: 0.78rem;
    color: #f472b6;
  }
</style>
