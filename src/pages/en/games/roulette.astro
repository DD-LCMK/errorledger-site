---
import BaseHead from '../../../components/BaseHead.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import LeaderboardAd from '../../../components/ads/LeaderboardAd.astro';
import { getKoUrl, getEnUrl } from '../../../i18n';

const siteBase = Astro.site?.toString() || 'https://errorledger.com';
const rawPath = Astro.url.pathname.replace(/\/$/, '');
const koUrl = getKoUrl(siteBase, rawPath);
const enUrl = getEnUrl(siteBase, rawPath);

const urlParams = Astro.url.searchParams;
const streamerMode = urlParams.has('stream') || urlParams.has('obs');
const gameUrl = streamerMode
  ? '/games/roulette?bare=1&stream=true&lang=en'
  : '/games/roulette?bare=1&lang=en';

const webAppSchema = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "WebApplication",
  "name": "Random Spin Wheel — StreamArcade",
  "alternateName": ["Spin Wheel", "Random Wheel Picker", "Roulette Spinner", "돌림판 룰렛"],
  "url": enUrl,
  "description": "Free browser spin wheel with ratchet-click audio, winner confetti, and one-click presets for food, penalties, and giveaways. No install. No login.",
  "applicationCategory": "GameApplication",
  "operatingSystem": "All (Web Browser, Chrome, Edge, Safari, Mobile)",
  "inLanguage": ["en-US", "ko-KR"],
  "offers": { "@type": "Offer", "price": "0", "priceCurrency": "USD" }
});
---

<!doctype html>
<html lang="en" class="dark">
  <head>
    <BaseHead
      title="Random Spin Wheel — Free Online Roulette Picker for Streamers | StreamArcade"
      description="Free browser spin wheel with satisfying ratchet-click audio, winner confetti, automatic item removal, and one-click presets. Perfect for Twitch & YouTube giveaways. No install."
      lang="en"
      hreflangKo={koUrl}
      hreflangEn={enUrl}
      keywords="Random Spin Wheel, Free Spin Wheel, Wheel Picker Online, Twitch Roulette, YouTube Giveaway Wheel, Random Name Picker, Random Wheel Spinner, Stream Roulette Tool"
    />
    <script type="application/ld+json" set:html={webAppSchema}></script>
  </head>
  <body class="en-game-body">
    <Header />

    <main class="en-game-main">
      <div class="en-game-frame-wrap">
        <iframe
          src={gameUrl}
          class="en-game-iframe"
          id="game-iframe"
          title="Random Spin Wheel — StreamArcade"
          allowfullscreen
          loading="eager"
          scrolling="no"
        ></iframe>
      </div>

      <!-- Unobtrusive Expandable Information Drawer (for Guide & FAQ) -->
      {!streamerMode && (
        <details class="stream-bottom-details">
          <summary class="details-summary">
            <span>📖 Detailed Guide & FAQ</span>
            <span class="chevron">▼</span>
          </summary>
          <div class="details-content">
            <div class="details-faq-section">
              <h3>Spin Wheel FAQ</h3>
              <div class="details-faq-grid">
                <div class="details-faq-card">
                  <strong class="faq-q">Q. How do I use fullscreen mode?</strong>
                  <p class="faq-a">Click the [⛶ Fullscreen] button in the top bar or [📺 Focus Mode] below the wheel to expand the spin wheel across your screen for clean presentation.</p>
                </div>
                <div class="details-faq-card">
                  <strong class="faq-q">Q. Can items be removed after picking?</strong>
                  <p class="faq-a">Yes. Enable "Remove winner after pick" in the settings panel to automatically exclude the picked item from the next spin.</p>
                </div>
                <div class="details-faq-card">
                  <strong class="faq-q">Q. Can I save my list?</strong>
                  <p class="faq-a">Paste your item list before spinning. The list stays in the session. Copy it to a text file to save permanently.</p>
                </div>
                <div class="details-faq-card">
                  <strong class="faq-q">Q. Is the result random?</strong>
                  <p class="faq-a">Yes. The spinner uses a cryptographically seeded PRNG for the stop angle, so no one can predict or manipulate the result.</p>
                </div>
              </div>
            </div>
          </div>
        </details>
      )}

      <!-- Horizontal single-line ad below detail guide & FAQ -->
      <LeaderboardAd streamerMode={streamerMode} />
    </main>

    {!streamerMode && <Footer />}

    <script>
      const iframe = document.getElementById('game-iframe') as HTMLIFrameElement;
      if (iframe) {
        // Streamer / OBS mode client-side check
        var sp = new URLSearchParams(window.location.search);
        if (sp.has('stream') || sp.has('obs')) {
          var s = document.createElement('style');
          s.textContent = [
            '.leaderboard-ad-wrap { display: none !important; }',
            'footer { display: none !important; }',
            '.stream-bottom-details { display: none !important; }',
            '.arcade-header { display: none !important; }',
            '.en-game-main { padding: 0 !important; margin: 0 !important; max-width: none !important; }',
            '.en-game-frame-wrap { height: 100vh !important; }',
            '.en-game-iframe { height: 100vh !important; }'
          ].join(' ');
          document.head.appendChild(s);

          if (!iframe.src.includes('stream=true')) {
            iframe.src = iframe.src + '&stream=true';
          }
        }
      }
    </script>
  </body>
</html>

<style>
  .en-game-body {
    background: #090d16;
    color: #f1f5f9;
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    margin: 0;
    padding: 0;
  }

  .en-game-main {
    /* Override global.css which sets padding:3em and margin:auto on all <main> */
    width: 100% !important;
    max-width: 100% !important;
    margin: 0 !important;
    padding: 0.5rem 0.75rem 2rem !important;
    flex: 1;
    display: flex;
    flex-direction: column;
    box-sizing: border-box;
  }

  .en-game-frame-wrap {
    width: 100%;
    height: 820px;
  }

  .en-game-iframe {
    width: 100%;
    height: 100%;
    border: none;
    display: block;
    background: transparent;
  }

  @media (min-width: 1400px) {
    .en-game-frame-wrap {
      height: max(800px, calc(100vh - 110px));
    }
  }

  /* Unobtrusive Bottom Drawer matching GameLayout */
  .stream-bottom-details {
    margin-top: 1.5rem;
    background: #0f172a;
    border: 1px solid rgba(255, 255, 255, 0.06);
    border-radius: 10px;
    overflow: hidden;
    transition: border-color 0.15s ease;
  }

  .stream-bottom-details[open] {
    border-color: rgba(168, 85, 247, 0.3);
  }

  .details-summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.75rem 1.25rem;
    font-size: 0.84rem;
    font-weight: 700;
    color: #94a3b8;
    cursor: pointer;
    user-select: none;
    list-style: none;
    transition: color 0.15s ease;
  }

  .details-summary:hover {
    color: #e2e8f0;
  }

  .details-summary::-webkit-details-marker {
    display: none;
  }

  .chevron {
    font-size: 0.65rem;
    color: #a855f7;
    transition: transform 0.2s ease;
  }

  .stream-bottom-details[open] .chevron {
    transform: rotate(180deg);
  }

  .details-content {
    padding: 1.25rem;
    border-top: 1px solid rgba(255, 255, 255, 0.05);
    color: #cbd5e1;
    font-size: 0.85rem;
    line-height: 1.7;
  }

  .details-faq-section h3 {
    font-size: 0.95rem;
    color: #f8fafc;
    margin: 0 0 0.75rem;
  }

  .details-faq-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.75rem;
  }

  .details-faq-card {
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid rgba(255, 255, 255, 0.05);
    border-radius: 8px;
    padding: 0.75rem 1rem;
  }

  .faq-q {
    display: block;
    font-size: 0.82rem;
    color: #e2e8f0;
    margin-bottom: 0.35rem;
  }

  .faq-a {
    margin: 0;
    font-size: 0.78rem;
    color: #94a3b8;
    line-height: 1.55;
  }

  code {
    background: rgba(255, 255, 255, 0.1);
    padding: 0.1rem 0.3rem;
    border-radius: 4px;
    font-size: 0.78rem;
    color: #38bdf8;
  }

  @media (max-width: 900px) {
    .details-faq-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
