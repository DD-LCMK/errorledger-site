---
import BaseHead from '../../components/BaseHead.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { getKoUrl, getEnUrl } from '../../i18n';

const siteBase = Astro.site?.toString() || 'https://errorledger.com';
const rawPath = Astro.url.pathname.replace(/\/$/, '');
const koUrl = getKoUrl(siteBase, rawPath);
const enUrl = getEnUrl(siteBase, rawPath);

const urlParams = Astro.url.searchParams;
const streamerMode = urlParams.has('stream') || urlParams.has('obs');
const gameUrl = streamerMode ? '/fortune?stream=true' : '/fortune';
---

<!doctype html>
<html lang="en" class="dark">
  <head>
    <BaseHead
      title="Daily Fortune & Horoscope — Free Stream Opener Tool | StreamArcade"
      description="Free daily fortune widget for streamers — 12 Eastern zodiac animals and 12 Western star signs with lucky numbers, colors, and DO/DON'T tips. Auto-updated at midnight."
      lang="en"
      hreflangKo={koUrl}
      hreflangEn={enUrl}
      keywords="Daily Fortune, Daily Horoscope, Eastern Zodiac Fortune, Western Horoscope, Stream Fortune Tool, Twitch Fortune, Lucky Number Generator, Daily Lucky Color"
    />
  </head>
  <body class="en-game-body">
    <Header />

    <main class="en-game-main">
      <div class="en-game-intro">
        <h1 class="en-game-title">✨ Daily Fortune & Horoscope</h1>
        <p class="en-game-desc">Auto-updated at midnight — Eastern zodiac & Western star sign fortunes for your stream opener.</p>
      </div>

      <div class="en-game-frame-wrap">
        <iframe
          src={gameUrl}
          class="en-game-iframe"
          title="Daily Fortune — StreamArcade"
          allowfullscreen
          loading="eager"
          scrolling="no"
        ></iframe>
      </div>
    </main>

    {!streamerMode && <Footer />}
  </body>
</html>

<style>
  .en-game-body {
    background: #090d16;
    color: #f1f5f9;
    min-height: 100vh;
    display: flex;
    flex-direction: column;
  }

  .en-game-main {
    flex: 1;
    display: flex;
    flex-direction: column;
  }

  .en-game-intro {
    padding: 0.6rem 1rem 0.4rem;
    max-width: 1440px;
    margin: 0 auto;
    width: 100%;
    box-sizing: border-box;
  }

  .en-game-title {
    font-size: 1.1rem;
    font-weight: 800;
    color: #f8fafc;
    margin: 0 0 0.2rem;
  }

  .en-game-desc {
    font-size: 0.82rem;
    color: #64748b;
    margin: 0;
  }

  .en-game-frame-wrap {
    flex: 1;
    width: 100%;
    min-height: 85vh;
  }

  .en-game-iframe {
    width: 100%;
    height: 100%;
    min-height: 85vh;
    border: none;
    display: block;
    background: #090d16;
  }
</style>
