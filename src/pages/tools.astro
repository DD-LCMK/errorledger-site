---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import { SITE_TITLE } from '../consts';
import { getKoUrl, getEnUrl } from '../i18n';

const PAGE_TITLE = `방송 유틸리티 & 크리에이터 도구 모음 | ${SITE_TITLE}`;
const PAGE_DESCRIPTION = "치지직·유튜브 다운로더, 주간 방송 편성표 스튜디오, Bzzk 실시간 밴 레이더, 방송용 사운드보드 등 스트리머와 크리에이터를 위한 무료 방송 웹 유틸리티 컬렉션.";
const PAGE_KEYWORDS = "방송 도구, 스트리머 유틸리티, 치지직 다운로더, 방송 편성표 만들기, Bzzk, 검지직, 방송용 사운드보드, 이모티콘 메이커, 스트림 두들, 치지직 방송 프로그램";

const breadcrumbItems = [
  { name: "홈", url: "/" },
  { name: "방송 유틸리티" }
];

const toolsList = [
  {
    category: "다운로드 & 아카이브",
    categoryDesc: "방송 다시보기와 클립, 유튜브 영상을 내 컴퓨터에 안전하게 영구 소장하세요.",
    items: [
      {
        id: "chzzk-downloader",
        title: "치지직 & 유튜브 다운로더",
        desc: "네이버 치지직 VOD·클립 및 유튜브 영상·쇼츠를 재인코딩 손실 없이 최고 화질(4K·1080p FHD)로 다운로드하는 무설치 로컬 유틸리티입니다.",
        badge: "v2.0.0 4K/FHD",
        badgeType: "hot",
        icon: "📥",
        link: "/chzzk-downloader",
        tags: ["Windows 64-bit", "FFmpeg 내장", "순차 대기열", "무설치"],
        statusText: "공식 릴리즈"
      }
    ]
  },
  {
    category: "방송 운영 & 스케줄링",
    categoryDesc: "일정 공지와 커뮤니티 소통, 시청자 관리를 편리하게 도와주는 스튜디오 도구입니다.",
    items: [
      {
        id: "schedule-studio",
        title: "주간 방송 편성표 스튜디오",
        desc: "7가지 세련된 테마 템플릿으로 주간·월간 방송 일정을 쉽고 빠르게 제작하고, 고화질 PNG 이미지 및 디스코드/팬카페 공지 텍스트로 내보냅니다.",
        badge: "HOT STUDIO",
        badgeType: "popular",
        icon: "📅",
        link: "/schedule",
        tags: ["웹 전용", "PNG 내보내기", "템플릿 저장", "디스코드 연동"],
        statusText: "무료 이용"
      },
      {
        id: "bzzk-radar",
        title: "Bzzk (검지직) 실시간 밴 레이더",
        desc: "치지직 방송 채널의 블랙리스트 유저 및 악성 채팅 이용자 이력을 실시간 모니터링하여 방송 안전을 보호하는 스트리머 인텔리전스 레이더입니다.",
        badge: "LIVE RADAR",
        badgeType: "live",
        icon: "🛡️",
        link: "/bzzk",
        tags: ["실시간 감지", "블랙리스트 조회", "채팅 모니터링"],
        statusText: "정상 가동"
      }
    ]
  },
  {
    category: "라이브 연출 & 크리에이터 에셋",
    categoryDesc: "생방송 중 실시간 오디오 리액션과 맞춤형 채널 그래픽 에셋을 제작하세요.",
    items: [
      {
        id: "soundboard",
        title: "방송용 키패드 사운드보드",
        desc: "방송 중 리액션 효과음, 밈 사운드, 징글을 숫자 키패드 및 단축키로 지연 없이 즉각 재생하는 브라우저 기반 초경량 사운드보드입니다.",
        badge: "HOTKEY SFX",
        badgeType: "new",
        icon: "🔊",
        link: "/games/soundboard",
        tags: ["단축키 지원", "OBS 오디오 라우팅", "커스텀 사운드"],
        statusText: "무료 이용"
      },
      {
        id: "stream-emoji",
        title: "움직이는 이모티콘 메이커",
        desc: "치지직 구독 이모티콘 및 팬카페용 움직이는 GIF/WebP 이모티콘을 프레임 단위로 손쉽게 편집하고 애니메이션으로 내보내는 스튜디오입니다.",
        badge: "ANIMATED",
        badgeType: "popular",
        icon: "🎬",
        link: "/games/stream-emoji",
        tags: ["GIF/WebP", "프레임 편집", "구독 이모티콘"],
        statusText: "무료 이용"
      },
      {
        id: "stream-doodle",
        title: "실시간 방송 낙서장 (Stream Doodle)",
        desc: "방송 화면에 실시간으로 움직이는 손글씨와 네온 드로잉 낙서를 연출할 수 있는 OBS 브라우저 소스 연동 실시간 스케치북 도구입니다.",
        badge: "OBS SOURCE",
        badgeType: "new",
        icon: "🎨",
        link: "/games/stream-doodle",
        tags: ["OBS 브라우저 소스", "네온 펜", "애니메이션 획"],
        statusText: "무료 이용"
      }
    ]
  }
];

const itemListSchema = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "ItemList",
  "name": "에러레저 방송 유틸리티 모음",
  "description": PAGE_DESCRIPTION,
  "itemListElement": toolsList.flatMap((cat, catIdx) => 
    cat.items.map((tool, toolIdx) => ({
      "@type": "ListItem",
      "position": catIdx * 10 + toolIdx + 1,
      "name": tool.title,
      "description": tool.desc,
      "url": `https://errorledger.com${tool.link}`
    }))
  )
});
---

<!doctype html>
<html lang="ko" class="dark">
  <head>
    <BaseHead 
      title={PAGE_TITLE} 
      description={PAGE_DESCRIPTION}
      lang="ko"
      hreflangKo={getKoUrl((Astro.site || 'https://errorledger.com').toString(), Astro.url.pathname)}
      hreflangEn={getEnUrl((Astro.site || 'https://errorledger.com').toString(), Astro.url.pathname)}
      keywords={PAGE_KEYWORDS}
    />
    <script type="application/ld+json" set:html={itemListSchema}></script>
  </head>
  <body class="tools-page-body">
    <Header />

    <main class="tools-main">
      <div class="tools-container">
        <!-- Breadcrumbs Navigation -->
        <Breadcrumbs items={breadcrumbItems} />

        <!-- Hero Section -->
        <header class="tools-hero">
          <div class="tools-hero-badge">
            <span class="badge-icon">🛠️</span>
            <span>STREAMER & CREATOR UTILITIES</span>
          </div>
          <h1 class="tools-title">
            스트리머와 크리에이터를 위한 <span class="accent-text">무료 방송 도구 모음</span>
          </h1>
          <p class="tools-subtitle">
            고화질 영상 아카이브부터 방송 일정표 제작, 실시간 분탕 유저 모니터링, 단축키 사운드보드까지 —<br />
            복잡한 유료 소프트웨어 없이 브라우저에서 바로 사용하는 실용적인 제작 도구들을 만나보세요.
          </p>

          <div class="tools-stats-bar">
            <div class="stat-item">
              <span class="stat-number">6+</span>
              <span class="stat-label">무료 유틸리티</span>
            </div>
            <div class="stat-divider"></div>
            <div class="stat-item">
              <span class="stat-number">100%</span>
              <span class="stat-label">평생 무료 이용</span>
            </div>
            <div class="stat-divider"></div>
            <div class="stat-item">
              <span class="stat-number">OBS</span>
              <span class="stat-label">완벽 연동 지원</span>
            </div>
          </div>
        </header>

        <!-- Categories and Tool Cards -->
        {toolsList.map((group) => (
          <section class="tools-group-section">
            <div class="group-header">
              <h2 class="group-title">{group.category}</h2>
              <p class="group-desc">{group.categoryDesc}</p>
            </div>

            <div class="tools-grid">
              {group.items.map((tool) => (
                <article class="tool-card" id={tool.id}>
                  <div class="tool-card-glow"></div>
                  <div class="tool-card-header">
                    <div class="tool-icon-wrap">
                      <span class="tool-icon">{tool.icon}</span>
                    </div>
                    <div class="tool-badges">
                      <span class={`pill-badge ${tool.badgeType}`}>{tool.badge}</span>
                      <span class="status-indicator">{tool.statusText}</span>
                    </div>
                  </div>

                  <h3 class="tool-name">
                    <a href={tool.link}>{tool.title}</a>
                  </h3>
                  <p class="tool-desc">{tool.desc}</p>

                  <div class="tool-tags">
                    {tool.tags.map((tag) => (
                      <span class="tag-chip">#{tag}</span>
                    ))}
                  </div>

                  <div class="tool-card-footer">
                    <a href={tool.link} class="btn-open-tool">
                      <span>도구 실행하기</span>
                      <span class="arrow-icon">→</span>
                    </a>
                  </div>
                </article>
              ))}
            </div>
          </section>
        ))}

        <!-- Streamer Workflow Callout -->
        <section class="obs-callout-card">
          <div class="callout-content">
            <span class="callout-pill">OBS TIP</span>
            <h3>OBS 스튜디오와 함께 200% 활용하는 팁</h3>
            <p>
              에러레저의 방송 도구와 인터랙티브 게임은 OBS 스튜디오의 <strong>[브라우저 소스]</strong>에 URL을 추가하는 것만으로 손쉽게 송출 화면에 띄울 수 있습니다. 해상도 1920x1080 권장 설정을 통해 깨끗한 그래픽과 투명 배경 오버레이를 경험해 보세요.
            </p>
          </div>
          <div class="callout-actions">
            <a href="/guide" class="btn-callout-guide">📖 치지직 & OBS 가이드 읽기</a>
            <a href="/games" class="btn-callout-games">🎮 인터랙티브 게임 둘러보기</a>
          </div>
        </section>
      </div>
    </main>

    <Footer />
  </body>
</html>

<style>
  .tools-page-body {
    background: #090d16;
    color: #f1f5f9;
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    font-family: inherit;
    overflow-x: hidden;
  }

  .tools-main {
    flex: 1;
    width: 100%;
    padding: 1rem 1.5rem 5rem;
  }

  .tools-container {
    max-width: 1180px;
    margin: 0 auto;
  }

  /* Hero Section */
  .tools-hero {
    text-align: center;
    padding: 2.5rem 1rem 3.5rem;
    position: relative;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    margin-bottom: 3.5rem;
  }

  .tools-hero-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    background: rgba(0, 255, 163, 0.1);
    border: 1px solid rgba(0, 255, 163, 0.3);
    color: #00ffa3;
    padding: 0.4rem 1.1rem;
    border-radius: 9999px;
    font-size: 0.82rem;
    font-weight: 700;
    margin-bottom: 1.5rem;
    letter-spacing: 0.05em;
  }

  .tools-title {
    font-size: clamp(2rem, 4.2vw, 3rem);
    font-weight: 800;
    line-height: 1.3;
    color: #ffffff;
    margin: 0 0 1.25rem;
    letter-spacing: -0.02em;
  }

  .accent-text {
    background: linear-gradient(135deg, #00ffa3 0%, #38bdf8 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .tools-subtitle {
    font-size: clamp(1rem, 1.8vw, 1.12rem);
    line-height: 1.7;
    color: #94a3b8;
    max-width: 780px;
    margin: 0 auto 2.5rem;
  }

  .tools-stats-bar {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: #0f1627;
    border: 1px solid rgba(255, 255, 255, 0.08);
    padding: 0.85rem 2rem;
    border-radius: 16px;
    gap: 2rem;
  }

  .stat-item {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.2rem;
  }

  .stat-number {
    font-size: 1.4rem;
    font-weight: 800;
    color: #00ffa3;
  }

  .stat-label {
    font-size: 0.78rem;
    color: #94a3b8;
  }

  .stat-divider {
    width: 1px;
    height: 28px;
    background: rgba(255, 255, 255, 0.1);
  }

  /* Groups & Cards */
  .tools-group-section {
    margin-bottom: 4rem;
  }

  .group-header {
    margin-bottom: 1.75rem;
  }

  .group-title {
    font-size: 1.55rem;
    font-weight: 800;
    color: #ffffff;
    margin: 0 0 0.5rem;
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }

  .group-desc {
    font-size: 0.95rem;
    color: #94a3b8;
    margin: 0;
  }

  .tools-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(340px, 1fr));
    gap: 1.5rem;
  }

  .tool-card {
    position: relative;
    background: #0e1526;
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 18px;
    padding: 1.85rem;
    display: flex;
    flex-direction: column;
    transition: all 0.25s ease;
    overflow: hidden;
  }

  .tool-card:hover {
    transform: translateY(-4px);
    border-color: rgba(0, 255, 163, 0.35);
    box-shadow: 0 12px 35px rgba(0, 0, 0, 0.5), 0 0 20px rgba(0, 255, 163, 0.12);
  }

  .tool-card-header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    margin-bottom: 1.25rem;
  }

  .tool-icon-wrap {
    width: 52px;
    height: 52px;
    border-radius: 14px;
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.1);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.8rem;
    transition: transform 0.2s ease;
  }

  .tool-card:hover .tool-icon-wrap {
    transform: scale(1.08);
  }

  .tool-badges {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 0.35rem;
  }

  .pill-badge {
    font-size: 0.72rem;
    font-weight: 700;
    padding: 0.25rem 0.6rem;
    border-radius: 6px;
    text-transform: uppercase;
    letter-spacing: 0.02em;
  }

  .pill-badge.hot {
    background: rgba(255, 75, 75, 0.15);
    border: 1px solid rgba(255, 75, 75, 0.35);
    color: #ff6b6b;
  }

  .pill-badge.popular {
    background: rgba(0, 255, 163, 0.15);
    border: 1px solid rgba(0, 255, 163, 0.35);
    color: #00ffa3;
  }

  .pill-badge.live {
    background: rgba(56, 189, 248, 0.15);
    border: 1px solid rgba(56, 189, 248, 0.35);
    color: #38bdf8;
  }

  .pill-badge.new {
    background: rgba(168, 85, 247, 0.15);
    border: 1px solid rgba(168, 85, 247, 0.35);
    color: #c084fc;
  }

  .status-indicator {
    font-size: 0.74rem;
    color: #64748b;
  }

  .tool-name {
    font-size: 1.28rem;
    font-weight: 700;
    margin: 0 0 0.65rem;
    line-height: 1.4;
  }

  .tool-name a {
    color: #ffffff;
    text-decoration: none;
    transition: color 0.15s ease;
  }

  .tool-name a:hover {
    color: #00ffa3;
  }

  .tool-desc {
    font-size: 0.92rem;
    color: #94a3b8;
    line-height: 1.6;
    margin: 0 0 1.25rem;
    flex: 1;
  }

  .tool-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
    margin-bottom: 1.5rem;
  }

  .tag-chip {
    font-size: 0.76rem;
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid rgba(255, 255, 255, 0.08);
    color: #cbd5e1;
    padding: 0.2rem 0.55rem;
    border-radius: 6px;
  }

  .tool-card-footer {
    padding-top: 1rem;
    border-top: 1px solid rgba(255, 255, 255, 0.06);
  }

  .btn-open-tool {
    display: flex;
    align-items: center;
    justify-content: space-between;
    background: #141d33;
    color: #f1f5f9;
    padding: 0.75rem 1.15rem;
    border-radius: 12px;
    font-weight: 600;
    font-size: 0.92rem;
    text-decoration: none;
    border: 1px solid rgba(255, 255, 255, 0.08);
    transition: all 0.2s ease;
  }

  .btn-open-tool:hover {
    background: linear-gradient(135deg, #00ffa3 0%, #00c760 100%);
    color: #090d16;
    border-color: transparent;
    font-weight: 700;
    box-shadow: 0 4px 18px rgba(0, 255, 163, 0.3);
  }

  .arrow-icon {
    font-size: 1.1rem;
    transition: transform 0.2s ease;
  }

  .btn-open-tool:hover .arrow-icon {
    transform: translateX(4px);
  }

  /* Callout Card */
  .obs-callout-card {
    background: linear-gradient(135deg, #0e1526 0%, #151e36 100%);
    border: 1px solid rgba(0, 255, 163, 0.25);
    border-radius: 20px;
    padding: 2.5rem;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.4);
    margin-top: 2rem;
  }

  .callout-content {
    flex: 1 1 500px;
  }

  .callout-pill {
    display: inline-block;
    background: rgba(0, 255, 163, 0.15);
    border: 1px solid rgba(0, 255, 163, 0.3);
    color: #00ffa3;
    font-size: 0.75rem;
    font-weight: 700;
    padding: 0.25rem 0.65rem;
    border-radius: 6px;
    margin-bottom: 0.75rem;
  }

  .callout-content h3 {
    font-size: 1.35rem;
    font-weight: 800;
    color: #ffffff;
    margin: 0 0 0.65rem;
  }

  .callout-content p {
    font-size: 0.95rem;
    color: #94a3b8;
    line-height: 1.6;
    margin: 0;
  }

  .callout-content strong {
    color: #f1f5f9;
  }

  .callout-actions {
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
    flex: 0 0 auto;
  }

  .btn-callout-guide,
  .btn-callout-games {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.85rem 1.4rem;
    border-radius: 12px;
    font-size: 0.92rem;
    font-weight: 600;
    text-decoration: none;
    transition: all 0.2s ease;
    white-space: nowrap;
  }

  .btn-callout-guide {
    background: #00ffa3;
    color: #090d16;
    font-weight: 700;
  }

  .btn-callout-guide:hover {
    background: #1effb0;
    transform: translateY(-2px);
    box-shadow: 0 6px 20px rgba(0, 255, 163, 0.3);
  }

  .btn-callout-games {
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.1);
    color: #e2e8f0;
  }

