---
import BaseHead from '../../components/BaseHead.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
---

<html lang="en">
	<head>
		<BaseHead title="Cron Expression Parser & Translator | ErrorLedger" description="Free, client-side tool to translate complex Cron schedule expressions into human-readable text." />
		<!-- Import cronstrue from CDN for client-side translation -->
		<script src="https://cdn.jsdelivr.net/npm/cronstrue@2.48.0/dist/cronstrue.min.js"></script>
		<style>
			main { width: 960px; max-width: calc(100% - 2rem); margin: 0 auto; padding: 3em 1rem; min-height: 65vh; }
			h1 { font-size: 2.25rem; margin-bottom: 0.5rem; color: #1a202c; }
			p.subtitle { color: #475569; margin-bottom: 2.5rem; font-size: 1.1rem; }
			
			.tool-container {
				background: #ffffff;
				border: 1px solid #e2e8f0;
				border-radius: 8px;
				padding: 2rem;
				box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.05);
			}

			.input-group { margin-bottom: 1.5rem; }
			label { display: block; font-weight: 700; color: #334155; margin-bottom: 0.5rem; font-size: 0.95rem; text-transform: uppercase; letter-spacing: 0.05em; }
			
			input[type="text"] {
				width: 100%;
				padding: 1rem;
				font-family: ui-monospace, monospace;
				font-size: 1.5rem;
				color: #0f172a;
				background: #f8fafc;
				border: 1px solid #cbd5e1;
				border-radius: 6px;
				outline: none;
				text-align: center;
				transition: border-color 0.2s ease;
			}
			input[type="text"]:focus { border-color: #3b82f6; box-shadow: 0 0 0 3px rgba(59, 130, 246, 0.1); }

			.result-box {
				background: #f1f5f9;
				border: 1px solid #cbd5e1;
				border-left: 4px solid #10b981;
				border-radius: 6px;
				padding: 1.5rem;
				margin-top: 1.5rem;
				text-align: center;
				display: none;
			}
			.result-box.error { border-left-color: #ef4444; }
			.result-text { font-size: 1.25rem; font-weight: 600; color: #0f172a; margin: 0; }
			.error-text { font-size: 1.1rem; color: #ef4444; margin: 0; }

			.examples { margin-top: 2rem; font-size: 0.9rem; color: #64748b; }
			.example-btn {
				background: none;
				border: 1px solid #cbd5e1;
				padding: 0.25rem 0.5rem;
				border-radius: 4px;
				cursor: pointer;
				font-family: ui-monospace, monospace;
				color: #334155;
				margin: 0.25rem;
				transition: all 0.2s ease;
			}
			.example-btn:hover { background: #f1f5f9; color: #0f172a; }

			/* Dark Mode */
			:global(html.dark) h1 { color: #f8fafc; }
			:global(html.dark) .subtitle { color: #cbd5e1; }
			:global(html.dark) .tool-container { background: #1e293b; border-color: #334155; }
			:global(html.dark) label { color: #94a3b8; }
			:global(html.dark) input[type="text"] { background: #0f172a; border-color: #334155; color: #f8fafc; }
			:global(html.dark) input[type="text"]:focus { border-color: #3b82f6; }
			:global(html.dark) .result-box { background: #0f172a; border-color: #334155; }
			:global(html.dark) .result-text { color: #f8fafc; }
			:global(html.dark) .example-btn { border-color: #475569; color: #cbd5e1; }
			:global(html.dark) .example-btn:hover { background: #334155; color: #f8fafc; }
		</style>
	</head>
	<body>
		<Header />
		<main>
			<h1>Cron Expression Parser</h1>
			<p class="subtitle">Instantly translate Unix cron schedule strings into plain English. 100% client-side execution.</p>

			<div class="tool-container">
				<div class="input-group">
					<label for="cron-input">Enter Cron Expression</label>
					<input type="text" id="cron-input" placeholder="* * * * *" value="0 22 * * 1-5" />
				</div>

				<div id="result-container" class="result-box">
					<p id="result-text" class="result-text"></p>
				</div>

				<div class="examples">
					<strong>Try Examples:</strong>
					<button class="example-btn">*/15 * * * *</button>
					<button class="example-btn">0 0 1 1 *</button>
					<button class="example-btn">0 12 * * MON</button>
					<button class="example-btn">0 0/2 * * *</button>
				</div>
			</div>
		</main>
		<Footer />

		<script>
			const cronInput = document.getElementById('cron-input') as HTMLInputElement;
			const resultContainer = document.getElementById('result-container');
			const resultText = document.getElementById('result-text');
			const exampleBtns = document.querySelectorAll('.example-btn');

			function parseCron() {
				const val = cronInput.value.trim();
				if (!val) {
					if (resultContainer && resultText) {
						resultContainer.style.display = 'none';
					}
					return;
				}

				if (resultContainer && resultText) {
					try {
						// @ts-ignore
						const readable = cronstrue.toString(val, { use24HourTimeFormat: true });
						resultContainer.className = 'result-box';
						resultContainer.style.display = 'block';
						resultText.className = 'result-text';
						resultText.innerText = `"${readable}"`;
					} catch (e) {
						resultContainer.className = 'result-box error';
						resultContainer.style.display = 'block';
						resultText.className = 'error-text';
						resultText.innerText = "Invalid Cron Expression";
					}
				}
			}

			if (cronInput) {
				cronInput.addEventListener('input', parseCron);
			}

			exampleBtns.forEach(btn => {
				btn.addEventListener('click', (e) => {
					const target = e.target as HTMLButtonElement;
					if (cronInput) {
						cronInput.value = target.innerText;
						parseCron();
					}
				});
			});

			// Initial parse on load
			window.addEventListener('DOMContentLoaded', () => {
				if (typeof (window as any).cronstrue !== 'undefined') {
					parseCron();
				} else {
					setTimeout(parseCron, 500); // fallback if CDN is slow
				}
			});
		</script>
	</body>
</html>