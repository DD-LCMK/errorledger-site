---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE } from '../consts';
import { getKoUrl, getEnUrl } from '../i18n';
import artistsData from '../data/chzzk_artists.json';

const siteBase = (Astro.site || 'https://errorledger.com').toString();
const rawPath = Astro.url.pathname.replace(/\/$/, '') || '/creators';
const koUrl = getKoUrl(siteBase, rawPath);
const enUrl = getEnUrl(siteBase, rawPath);

const PAGE_TITLE = `치지직 방송 아티스트 쇼케이스 (준비 중) — ${SITE_TITLE}`;
const PAGE_DESCRIPTION = "치지직 감성을 가장 잘 아는 현역 방송 작가 큐레이션 디렉토리. 중개 수수료 0원, 작가 치지직 채널 직통 연결! Live2D, 구독 이모티콘, 대기화면, 방송 오버레이 작가 사전 등록 접수 중.";
const PAGE_KEYWORDS = "치지직 작가, 치지직 크리에이터, 치지직 외주, 치지직 이모티콘 작가, 치지직 Live2D 리깅, 방송 대기화면 일러스트, 방송 오버레이 디자인, 치지직 아트머그, 치지직 그림방송";

const schemaArticle = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "WebPage",
  "name": "치지직 방송 아티스트 쇼케이스",
  "description": PAGE_DESCRIPTION,
  "publisher": {
    "@type": "Organization",
    "name": "ErrorLedger"
  }
});
---

<!doctype html>
<html lang="ko" class="dark">
  <head>
    <BaseHead
      title={PAGE_TITLE}
      description={PAGE_DESCRIPTION}
      lang="ko"
      hreflangKo={koUrl}
      hreflangEn={enUrl}
      keywords={PAGE_KEYWORDS}
    />
    <script type="application/ld+json" set:html={schemaArticle}></script>
  </head>

  <body class="creators-body">
    <Header />

    <main class="creators-container">
      <!-- Breadcrumb -->
      <nav class="creators-breadcrumb" aria-label="Breadcrumb">
        <ol>
          <li><a href="/">홈</a></li>
          <li><span class="bc-sep">/</span></li>
          <li><span class="bc-current">크리에이터 쇼케이스</span></li>
        </ol>
      </nav>

      <!-- Coming Soon Hero Banner -->
      <section class="creators-hero">
        <div class="hero-glow-sphere"></div>
        <div class="hero-status-pill">
          <span class="status-pulse-dot"></span>
          <span class="status-text">💖 순수 창작 응원 프로젝트 | COMING SOON</span>
        </div>

        <h1 class="hero-title">
          치지직 방송 아티스트 <span class="gradient-text">쇼케이스</span>
        </h1>

        <p class="hero-slogan">
          "대가 없이, 수수료 없이. 치지직에서 라이브로 창작하는 멋진 작가님들을 응원합니다."
        </p>

        <p class="hero-desc">
          이 공간은 어떤 상업적 이익이나 대가를 바라고 만든 플랫폼이 아닙니다.<br/>
          그저 <strong>치지직에서 직접 작업 방송을 켜는 멋진 작가님들을 진심으로 돕고</strong>, 스트리머와 시청자들이 <strong>다 함께 좋은 창작 방송을 보며 아티스트를 구경하고 힐링할 수 있기를 바라는 순수한 마음</strong>으로 시작했습니다.
        </p>

        <!-- Core Value Proposition Badges -->
        <div class="value-prop-strip">
          <div class="vp-item">
            <span class="vp-icon">💖</span>
            <div class="vp-text">
              <strong>바라는 것 0% (수수료 0원)</strong>
              <span>어떤 대가도 없는 100% 무료 순수 응원</span>
            </div>
          </div>
          <div class="vp-item">
            <span class="vp-icon">📺</span>
            <div class="vp-text">
              <strong>오직 "치지직 방송 작가"만</strong>
              <span>실시간 라이브로 작업하는 현역 작가님 전용</span>
            </div>
          </div>
          <div class="vp-item">
            <span class="vp-icon">🤝</span>
            <div class="vp-text">
              <strong>다 함께 좋은 방송을 보는 쉼터</strong>
              <span>시청자는 좋은 방송 발견, 작가는 따뜻한 응원</span>
            </div>
          </div>
        </div>
      </section>

      <!-- Warm Manifesto Card: Why We Made This -->
      <section class="manifesto-card">
        <div class="manifesto-header">
          <span class="manifesto-tag">FOUNDER'S LETTER</span>
          <h2 class="manifesto-title">"그냥, 치지직의 멋진 작가님들을 진심으로 돕고 싶었습니다."</h2>
        </div>
        <div class="manifesto-content">
          <p>
            치지직 방송을 둘러보다 보면 감탄이 절로 나올 만큼 뛰어난 실력과 정성으로 캔버스를 채워가시는데도, 아직 널리 알려지지 않아 소수의 시청자들과 조용히 펜을 잡고 계신 작가님들을 종종 마주하게 됩니다.
          </p>
          <p>
            <em>'혼자 보기 아까운 이 아름다운 작업 과정들을 더 많은 사람들이 함께 본다면 얼마나 좋을까?'</em><br/>
            <em>'방송을 준비하는 스트리머들도 실제 실시간으로 그리는 라이브를 보며 믿고 의뢰할 수 있다면 얼마나 든든할까?'</em>
          </p>
          <p>
            에러레저는 중개 수수료를 1원도 원하지 않으며, 작가님들께 그 어떤 것도 바라지 않습니다.<br/>
            그저 <strong>치지직에서 묵묵히 방송을 켜고 멋진 작품을 만드시는 작가님들이 더 많은 사랑을 받고</strong>, 시청자들도 <strong>다 같이 좋은 방송을 보고 뛰어난 아티스트들을 함께 구경할 수 있는 따뜻한 치지직 문화</strong>가 만들어지기를 바랄 뿐입니다.
          </p>
        </div>

        <div class="manifesto-rule-box">
          <div class="rule-badge">중요한 단 하나의 원칙</div>
          <div class="rule-body">
            <strong>이 쇼케이스는 반드시 "치지직에서 직접 생방송을 켜는 작가님"만 등록됩니다:</strong>
            <p>
              단순히 포트폴리오 이미지만 올려두는 일반 외주 사이트가 아닙니다. 캔버스 위에서 실시간으로 작업 과정을 보여주며 시청자와 온기를 나누는 <strong>치지직 현역 창작 방송 스트리머</strong> 분들을 위한 전용 공간입니다.
            </p>
          </div>
        </div>
      </section>

      <!-- Pre-registration Artist Callout Box -->
      <section class="artist-apply-card">
        <div class="apply-header">
          <div class="apply-tag">ARTIST & VIEWER REGISTRATION</div>
          <h2 class="apply-title">🎨 치지직에서 작업 방송을 켜시는 작가님, 편하게 채널을 알려주세요</h2>
          <p class="apply-desc">
            부담이나 복잡한 조건은 전혀 없습니다. 치지직에서 그림/디자인/Live2D 창작 방송을 하신다면 편하게 링크만 남겨주세요.<br/>
            에러레저를 찾아오는 수많은 스트리머와 시청자 분들에게 작가님의 생방송 채널을 정성껏 소개해 드리겠습니다. <em>(팬 분들의 애정 어린 작가님 추천/제보도 언제나 환영합니다!)</em>
          </p>
        </div>

        <div class="apply-criteria-grid">
          <div class="criteria-box">
            <span class="cb-icon">📺</span>
            <strong>필수 조건: 치지직 방송</strong>
            <p>치지직 채널이 개설되어 있고, 최근 1~2개월 내 <em>그림/디자인/창작</em> 카테고리 라이브 방송 이력이 있는 작가님</p>
          </div>
          <div class="criteria-box">
            <span class="cb-icon">💖</span>
            <strong>순수 100% 무료 등록</strong>
            <p>어떤 대가나 수수료도 없습니다. 메인에 <strong>[치지직 생방송 보러가기]</strong> 직통 버튼을 크게 걸어드립니다.</p>
          </div>
          <div class="criteria-box">
            <span class="cb-icon">✉️</span>
            <strong>작가 본인 & 팬 추천 가능</strong>
            <p>작가님 본인의 등록 신청은 물론, "이 작가님 방송 진짜 좋아요!"라는 시청자 분들의 추천 제보도 받습니다.</p>
          </div>
        </div>

        <div class="apply-action-bar">
          <button type="button" class="apply-btn primary" id="open-apply-modal-btn">
            📝 작가 무료 등록 / 추천 제보하기 →
          </button>
          <a href="/contact" class="apply-btn secondary">
            ✉️ 응원 메시지 및 문의하기
          </a>
        </div>
      </section>

      <!-- Interactive Preview Showcase -->
      <section class="preview-showcase-section">
        <div class="preview-section-header">
          <div class="preview-badge">SHOWCASE PREVIEW</div>
          <h2 class="section-title">카드 구성 & 큐레이션 디렉토리 미리보기</h2>
          <p class="section-desc">
            정식 오픈 시 아래와 같이 카테고리별로 정돈된 작가 카드와 라이브 직통 연결 링크가 제공됩니다.
          </p>
        </div>

        <!-- Filter Category Tabs -->
        <div class="category-tabs" role="tablist" aria-label="작가 카테고리 필터">
          <button class="cat-tab active" data-cat="all">전체 보기 (4)</button>
          <button class="cat-tab" data-cat="emotes">#구독이모티콘/뱃지</button>
          <button class="cat-tab" data-cat="live2d">#Live2D/리깅</button>
          <button class="cat-tab" data-cat="illustration">#일러스트/대기화면</button>
          <button class="cat-tab" data-cat="overlay">#방송오버레이/로고</button>
        </div>

        <!-- Artists Card Grid -->
        <div class="artists-grid" id="artists-grid">
          {artistsData.map((artist) => (
            <article class="artist-card" data-category={artist.category}>
              <!-- Preview Watermark Badge -->
              <div class="preview-watermark">PREVIEW 예시</div>

              <!-- Card Header -->
              <div class="ac-header">
                <div class="ac-avatar" style={`background: ${artist.avatarBg};`}>
                  <span>{artist.avatar}</span>
                </div>
                <div class="ac-info">
                  <div class="ac-name-row">
                    <h3 class="ac-name">{artist.name}</h3>
                    <span class="ac-live-badge">CHZZK CREATOR</span>
                  </div>
                  <div class="ac-category-tag">{artist.categoryLabel}</div>
                </div>
              </div>

              <!-- Tags -->
              <div class="ac-tags">
                {artist.tags.map((tag) => (
                  <span class="tag-pill">{tag}</span>
                ))}
              </div>

              <!-- Bio -->
              <p class="ac-bio">{artist.bio}</p>

              <!-- Thumbnails Gallery Preview -->
              <div class="ac-gallery">
                {artist.previewThumbnails.map((thumb) => (
                  <div 
                    class="gallery-item" 
                    style={`background: ${thumb.gradient};`}
                    data-title={thumb.title}
                    data-artist={artist.name}
                  >
                    <span class="thumb-badge">{thumb.badge}</span>
                    <span class="thumb-title">{thumb.title}</span>
                    <span class="thumb-zoom-icon">🔍 확대보기</span>
                  </div>
                ))}
              </div>

              <!-- Action Outlink Buttons -->
              <div class="ac-actions">
                <a 
                  href={artist.chzzkUrl} 
                  target="_blank" 
                  rel="noopener noreferrer" 
                  class="ac-btn chzzk-btn"
                >
                  <span class="btn-dot"></span>
                  🟢 치지직 생방송 채널
                </a>
                <a 
                  href={artist.portfolioUrl} 
                  target="_blank" 
                  rel="noopener noreferrer" 
                  class="ac-btn portfolio-btn"
                >
                  🎨 {artist.portfolioLabel} ↗
                </a>
              </div>
            </article>
          ))}
        </div>
      </section>

      <!-- Why Choose Chzzk Artists Section -->
      <section class="why-us-section">
        <h2 class="why-title">왜 일반 외주 사이트 대신 치지직 방송 작가인가요?</h2>
        <div class="why-grid">
          <div class="why-card">
            <div class="wc-num">01</div>
            <h3>치지직 시스템 규격 완벽 이해</h3>
            <p>
              일반 외주 사이트 작가들은 치지직의 구독 뱃지 규격, 다크모드 채팅창에서의 112px 이모티콘 가독성, 투명도 배경 세팅을 잘 모르는 경우가 많습니다. 반면 치지직 현역 작가는 플랫폼을 매일 방송하므로 재작업 없이 단번에 완성합니다.
            </p>
          </div>
          <div class="why-card">
            <div class="wc-num">02</div>
            <h3>생방송으로 증명된 작업 과정 (AI & 도용 방어)</h3>
            <p>
              외주 사기나 무단 AI 생성에 대한 불안감이 커진 요즘, 치지직에서 직접 라이브로 작업하는 작가는 스케치부터 완성까지 모든 실력과 과정이 투명하게 증명되므로 믿고 의뢰할 수 있습니다.
            </p>
          </div>
          <div class="why-card">
            <div class="wc-num">03</div>
            <h3>스트리머 & 작가 상생 생태계</h3>
            <p>
              에러레저는 중개 수수료를 전혀 취하지 않습니다. 스트리머는 훌륭한 작가를 만나고, 작가님은 치지직 방송 시청자와 팬을 유입받는 가장 건강한 윈-윈 구조를 지향합니다.
            </p>
          </div>
        </div>
      </section>

      <!-- FAQ Section -->
      <section class="creators-faq-section">
        <h2 class="faq-headline">쇼케이스 운영 및 자주 묻는 질문</h2>
        <div class="faq-list">
          <details class="faq-item" open>
            <summary class="faq-question">
              <span>Q. 에러레저는 왜 아무것도 안 바라고 이 공간을 무료로 운영하나요?</span>
              <span class="faq-chevron">▾</span>
            </summary>
            <div class="faq-answer">
              <p>
                정말로 바라는 것이 전혀 없습니다. 상업적 수익을 내기 위한 사이트가 아니라, 치지직에서 묵묵히 멋진 그림을 그리고 창작하시는 작가님들을 진심으로 돕고 싶어서 만들었습니다. 스트리머와 시청자들이 다 함께 좋은 방송을 보고, 훌륭한 아티스트들을 함께 응원하는 따뜻한 치지직 창작 생태계가 자리 잡기를 바라는 순수한 마음 하나로 영구히 100% 무료 운영됩니다.
              </p>
            </div>
          </details>

          <details class="faq-item">
            <summary class="faq-question">
              <span>Q. 치지직 방송을 하지 않고 포트폴리오만 있는 작가도 등록할 수 있나요?</span>
              <span class="faq-chevron">▾</span>
            </summary>
            <div class="faq-answer">
              <p>
                죄송하지만 등록되지 않습니다. 본 쇼케이스의 가장 중요한 핵심은 <strong>"치지직에서 실시간으로 작업 과정을 보여주며 시청자와 소통하는 작가님의 생방송 채널로 놀러 가는 것"</strong>입니다. 따라서 반드시 치지직 채널에서 최근 그림/디자인/Live2D 창작 라이브 방송을 진행하신 이력이 있어야 합니다.
              </p>
            </div>
          </details>

          <details class="faq-item">
            <summary class="faq-question">
              <span>Q. 시청자도 자기가 좋아하는 치지직 창작 작가님을 추천할 수 있나요?</span>
              <span class="faq-chevron">▾</span>
            </summary>
            <div class="faq-answer">
              <p>
                네, 언제든지 환영합니다! "치지직에서 이 작가님 그림 방송 정말 좋고 힐링되는데 더 많은 분들이 아셨으면 좋겠어요" 하시는 작가님이 계시다면, 상단의 등록 신청 버튼을 눌러 해당 작가님의 치지직 채널 링크를 알려주세요. 확인 후 정성껏 소개해 드리겠습니다.
              </p>
            </div>
          </details>

          <details class="faq-item">
            <summary class="faq-question">
              <span>Q. 스트리머는 작가님께 어떻게 외주를 의뢰하나요?</span>
              <span class="faq-chevron">▾</span>
            </summary>
            <div class="faq-answer">
              <p>
                각 작가 카드의 <strong>[치지직 생방송 채널]</strong>을 눌러 작가님의 라이브 방송에 방문해 직접 소통하시거나, <strong>[포트폴리오 / 외주 문의]</strong> 링크를 통해 작가님이 운영하시는 공식 외주 창구(X 트위터, 아트머그, 크레페 등)로 직접 연락하시면 됩니다. (에러레저는 중개 수수료를 1원도 취하지 않습니다.)
              </p>
            </div>
          </details>
        </div>
      </section>
    </main>

    <!-- Pre-registration Modal -->
    <div id="apply-modal" class="modal-backdrop" aria-hidden="true">
      <div class="modal-card" role="dialog" aria-modal="true" aria-labelledby="modal-title">
        <button type="button" class="modal-close-btn" id="close-apply-modal-btn" aria-label="닫기">✕</button>
        <div class="modal-header">
          <div class="modal-badge">ARTIST & FAN REGISTRATION</div>
          <h3 id="modal-title" class="modal-headline">치지직 방송 작가 무료 등록 및 추천 제보</h3>
          <p class="modal-sub">
