---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import GameThumb from '../components/GameThumb.astro';
import { SITE_TITLE, SITE_TAGLINE, SITE_DESCRIPTION } from '../consts';
import { getCollection } from 'astro:content';
import { getKoUrl, getEnUrl } from '../i18n';

const urlParams = Astro.url.searchParams;
const streamerMode = urlParams.has('stream') || urlParams.has('obs');

const games = await getCollection('games');
const priorityOrder = [
  'three-sec-quiz', 'spot-odd', 'blind-timer', 'mine-gems', 'reaction-test',
  'sword-enhance', 'marble-roulette', 'block-blast', 'arrow-jump', 'sand-drop',
  'roulette', 'ladder', 'drinking-marble', 'ai-music-quiz', 'soundboard',
  'stream-doodle', 'stream-emoji', 'fortune'
];
const sortedGames = games.sort((a, b) => {
  const idxA = priorityOrder.indexOf(a.id);
  const idxB = priorityOrder.indexOf(b.id);
  return (idxA !== -1 ? idxA : 99) - (idxB !== -1 ? idxB : 99);
});

const arcadeIds = ['three-sec-quiz', 'spot-odd', 'blind-timer', 'mine-gems', 'reaction-test', 'sword-enhance', 'block-blast', 'arrow-jump', 'sand-drop'];
const drawIds = ['marble-roulette', 'roulette', 'ladder', 'drinking-marble'];
const arcadeCount = sortedGames.filter(g => arcadeIds.includes(g.id)).length;
const drawCount = sortedGames.filter(g => drawIds.includes(g.id)).length;
const studioCount = sortedGames.length - arcadeCount - drawCount;

const koTagsMap: Record<string, string[]> = {
  'three-sec-quiz': ['사자성어·속담 3초컷', '4지선다 & 호스트'],
  'spot-odd': ['틀린글자·절대색감', 'A1~J10 좌표훈수'],
  'blind-timer': ['1.5초 후 암전', '1ms 정밀판정'],
  'mine-gems': ['5×5 좌표훈수', 'SHA-256 공정'],
  'reaction-test': ['반응·에임·CPS', '피지컬 나이 진단서'],
  'sword-enhance': ['+20강 도전', '6슬롯 보관함'],
  'block-blast': ['8×8 라인폭파', '무한 콤보'],
  'arrow-jump': ['슬링샷 조준', '일일 시드 300m'],
  'sand-drop': ['모래 물리엔진', '11단계 융합'],
  'marble-roulette': ['3D 물리엔진', '최대 40명'],
  'roulette': ['확률 가중치', '1초 프리셋'],
  'ladder': ['최대 20명', '1:1 공정매칭'],
  'drinking-marble': ['3D 주사위', '커스텀 벌칙칸'],
  'ai-music-quiz': ['AI 편곡 퀴즈', '원곡 비교재생'],
  'soundboard': ['0ms 무지연', '넘버패드 단축키'],
  'stream-doodle': ['12FPS 낙서장', '투명 GIF 저장'],
  'stream-emoji': ['16프레임 타임라인', '어니언 스킨'],
  'fortune': ['12띠 & 별자리', '매일 자정 갱신']
};

const homeFaqSchema = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "방송 송출이나 유튜브 영상 제작으로 수익 창출(상업적 이용)을 해도 되나요?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "네, 전면 허용됩니다! 에러레저(ErrorLedger)의 모든 게임과 방송 도구는 치지직, 유튜브, SOOP 등 모든 플랫폼에서의 실시간 라이브 방송 송출, 녹화 영상 업로드, 유튜브 광고 및 후원(도네이션) 수익 창출에 제한 없이 100% 무료로 자유롭게 이용하실 수 있습니다."
      }
    },
    {
      "@type": "Question",
      "name": "전체화면이나 OBS 브라우저 소스 모드는 어떻게 사용하나요?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "각 게임 상단의 [🎥 OBS 소스 복사] 또는 [⛶ 전체화면] 버튼을 누르면 헤더와 여백 없는 깔끔한 방송 전용 화면(?stream=true)으로 즉시 띄워 플레이할 수 있습니다."
      }
    },
    {
      "@type": "Question",
      "name": "비용이나 회원가입이 필요한가요?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "아닙니다. 로그인이나 회원가입 없이 모든 방송용 웹게임과 유틸리티를 평생 100% 무료로 사용할 수 있습니다."
      }
    },
    {
      "@type": "Question",
      "name": "치지직, SOOP(아프리카TV), 유튜브 라이브 모두 지원하나요?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "네. 표준 웹 브라우저 기반으로 외부 API 의존성 없이 100% 로컬 동작하므로 치지직(CHZZK), SOOP, 유튜브, 트위치 등 모든 플랫폼에서 끊김 없이 호환됩니다."
      }
    },
    {
      "@type": "Question",
      "name": "추첨 및 게임 결과는 공정한가요?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "돌림판, 사다리타기, 지뢰 보석 캐기 등 모든 추첨과 게임은 암호학적 의사 난수(PRNG) 및 SHA-256 시드 해시 검증 알고리즘으로 설계되어 임의 조작이 불가능합니다."
      }
    },
    {
      "@type": "Question",
      "name": "치지직 다운로더와 방송 편성표 스튜디오도 무료인가요?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "네, 횟수 제한이나 워터마크 없는 100% 무료 도구입니다. 치지직·유튜브 무손실 MP4 다운로드와 고화질 PNG 방송 편성표 제작을 바로 이용하실 수 있습니다."
      }
    }
  ]
});
---

<!doctype html>
<html lang="ko" class="dark">
  <head>
    <BaseHead
      title={`${SITE_TITLE} - ${SITE_TAGLINE}`}
      description={SITE_DESCRIPTION}
      lang="ko"
      hreflangKo={getKoUrl((Astro.site || 'https://errorledger.com').toString(), Astro.url.pathname)}
      hreflangEn={getEnUrl((Astro.site || 'https://errorledger.com').toString(), Astro.url.pathname)}
    />
    <script type="application/ld+json" set:html={homeFaqSchema}></script>
  </head>
  <body class="studio-home-body">
    <Header />

    <main class="studio-home-main">
      <!-- 1. STUDIO CONTROL DECK HERO -->
      <section class="studio-hero">
        <div class="hero-top-aura" aria-hidden="true"></div>
        <div class="hero-dot-matrix" aria-hidden="true"></div>

        <div class="hero-grid">
          <div class="hero-copy">
            <div class="status-pill">
              <span class="status-dot"></span>
              <span>LIVE STREAM READY · 상업적 송출 100% 무료</span>
            </div>

            <h1 class="hero-title">
              생방송 텐션을 깨우는<br />
              <span class="title-accent">스트리머 아케이드 스튜디오</span>
            </h1>

            <p class="hero-lead">
              설치·로그인·외부 API 없이 브라우저에서 1초 만에 실행하는 치지직·유튜브·SOOP 전용 웹게임과 방송 필수 유틸리티.
            </p>

            <div class="hero-actions">
              <a href="#games-arcade" class="btn-primary">
                <span>🎮 바로 게임 고르기</span>
                <span class="btn-arrow">↓</span>
              </a>
              <a href="/tools" class="btn-secondary">
                <span>🛠️ 방송 도구 스튜디오</span>
              </a>
            </div>

            <div class="hero-metrics" aria-label="플랫폼 요약">
              <div class="metric-cell">
                <strong class="metric-val">{sortedGames.length}종</strong>
                <span class="metric-lbl">무료 인터랙티브 게임</span>
              </div>
              <div class="metric-sep"></div>
              <div class="metric-cell">
                <strong class="metric-val">6종</strong>
                <span class="metric-lbl">스트리머 유틸리티</span>
              </div>
              <div class="metric-sep"></div>
              <div class="metric-cell">
                <strong class="metric-val">OBS</strong>
                <span class="metric-lbl">브라우저 소스 1초 연동</span>
              </div>
            </div>
          </div>

          <!-- Right: 2x2 Flagship Control Deck -->
          <div class="flagship-deck">
            <a href="/games/marble-roulette" class="deck-tile accent-emerald">
              <div class="tile-top">
                <span class="tile-icon">🔮</span>
                <span class="tile-tag tag-amber">🔥 #1 FLAGSHIP</span>
              </div>
              <div class="tile-body">
                <h2>구슬 레이스 룰렛</h2>
                <p>7,200px 롱코스 트랙과 반전 기믹의 실시간 3D 물리 추첨 레이스</p>
              </div>
              <div class="tile-foot">
                <span>레이스 시작</span>
                <span class="arrow">→</span>
              </div>
            </a>

            <a href="/chzzk-downloader" class="deck-tile accent-cyan">
              <div class="tile-top">
                <span class="tile-icon">📥</span>
                <span class="tile-tag tag-emerald">4K / FHD</span>
              </div>
              <div class="tile-body">
                <h2>치지직·유튜브 다운로더</h2>
                <p>다시보기 VOD·클립·쇼츠를 무손실 MP4로 일괄 초고속 저장</p>
              </div>
              <div class="tile-foot">
                <span>다운로더 열기</span>
                <span class="arrow">→</span>
              </div>
            </a>

            <a href="/bzzk" class="deck-tile accent-rose">
              <div class="tile-top">
                <span class="tile-icon">🛡️</span>
                <span class="tile-tag tag-slate">LIVE RADAR</span>
              </div>
              <div class="tile-body">
                <h2>검지직 악성 계정 레이더</h2>
                <p>다중 채널 밴·분탕 의심 계정을 방송 전 실시간으로 교차 감지</p>
              </div>
              <div class="tile-foot">
                <span>레이더 조회</span>
                <span class="arrow">→</span>
              </div>
            </a>

            <a href="/guide" class="deck-tile accent-amber">
              <div class="tile-top">
                <span class="tile-icon">🎨</span>
                <span class="tile-tag tag-slate">GUIDE & ARTISTS</span>
              </div>
              <div class="tile-body">
                <h2>치지직 가이드 & 작가</h2>
                <p>OBS 방송 세팅 바이블과 라이브 작업 증명 치지직 작가 쇼케이스</p>
              </div>
              <div class="tile-foot">
                <span>가이드 보기</span>
                <span class="arrow">→</span>
              </div>
            </a>
          </div>
        </div>
      </section>

      <!-- 2. INTERACTIVE GAMES ARCADE GRID (VISUAL COVERS + INSTANT FILTER) -->
      <section class="arcade-section" id="games-arcade">
        <div class="arcade-header">
          <div class="arcade-title-wrap">
            <span class="eyebrow">ARCADE & STREAM GAMES</span>
            <h2>방송 인터랙티브 게임 라인업</h2>
          </div>

          <div class="arcade-controls">
            <div class="filter-bar" id="home-game-filters" role="tablist" aria-label="게임 카테고리 필터">
              <button type="button" class="filter-btn active" data-filter="all">
                <span>전체</span>
                <span class="f-cnt">{sortedGames.length}</span>
              </button>
              <button type="button" class="filter-btn" data-filter="arcade">
                <span>🔥 아케이드</span>
                <span class="f-cnt">{arcadeCount}</span>
              </button>
              <button type="button" class="filter-btn" data-filter="draw">
                <span>🎲 추첨·파티</span>
                <span class="f-cnt">{drawCount}</span>
              </button>
              <button type="button" class="filter-btn" data-filter="studio">
                <span>🎨 스튜디오·퀴즈</span>
                <span class="f-cnt">{studioCount}</span>
              </button>
            </div>

            <label class="quick-filter-box" aria-label="게임 빠른 검색">
              <span class="qf-icon">🔍</span>
              <input
                type="search"
                id="arcade-quick-search"
                placeholder="게임 빠른 검색 (예: 퀴즈, 룰렛, 강화)..."
                autocomplete="off"
              />
            </label>
          </div>
        </div>

        <div class="arcade-grid" id="arcade-cards-grid">
          {sortedGames.map(game => {
            const href = game.id === 'fortune' ? '/fortune' : `/games/${game.id}`;
            const group = arcadeIds.includes(game.id) ? 'arcade' : drawIds.includes(game.id) ? 'draw' : 'studio';
            const isNewest = game.id === 'three-sec-quiz' || game.id === 'spot-odd';
            const isPopular = game.id === 'marble-roulette';
            const cardTags = koTagsMap[game.id] || [];
            const searchBlob = `${game.data.title} ${game.data.tagline} ${cardTags.join(' ')} ${game.id}`.toLowerCase();

            return (
              <a
                href={href}
                class={`game-card group-${group}`}
                data-group={group}
                data-search={searchBlob}
              >
                <div class="card-thumb-wrap">
                  <GameThumb id={game.id} lang="ko" />
                  {isNewest && <span class="thumb-pill pill-new">NEW</span>}
                  {isPopular && <span class="thumb-pill pill-hot">HOT #1</span>}
                  <span class="thumb-play-chip">▶ PLAY</span>
                </div>

                <div class="card-content">
                  <div class="card-head-line">
                    <h3 class="card-title">{game.data.title}</h3>
                  </div>
                  <p class="card-tagline">{game.data.tagline}</p>

                  <div class="card-meta-foot">
                    <div class="card-tags">
                      {cardTags.map(tag => <span class="mini-tag">{tag}</span>)}
                    </div>
                    <span class="card-time">⏱ {game.data.playTime}</span>
                  </div>
                </div>
              </a>
            );
          })}
        </div>

        <div id="arcade-empty-msg" class="arcade-empty" hidden>
          검색 결과가 없습니다. 다른 키워드를 입력하거나 <strong>전체</strong> 탭을 선택해 주세요.
        </div>

        <div class="section-cta-row">
          <a href="/games" class="btn-outline-hub">
            <span>🎮 전체 게임 디렉토리 자세히 보기 ({sortedGames.length}종 무료)</span>
            <span class="arrow">→</span>
          </a>
        </div>
      </section>

      <!-- 3. STREAMER UTILITIES STUDIO -->
      <section class="studio-utils-section" id="stream-utilities">
        <div class="section-head-center">
          <span class="eyebrow">CREATOR TOOLKIT · 100% FREE</span>
          <h2>방송 준비 시간을 줄여주는 <span class="title-accent">유틸리티 스튜디오</span></h2>
          <p>워터마크·결제·로그인 없이 바로 쓰는 치지직·유튜브 스트리머 전용 작업실입니다.</p>
        </div>

        <div class="utils-grid">
          <a href="/chzzk-downloader" class="util-card util-emerald">
            <div class="util-top">
              <span class="util-ico">📥</span>
              <span class="util-badge">4K · 1080p 무손실</span>
            </div>
            <h3>치지직 & 유튜브 다운로더</h3>
            <p class="util-desc">VOD·클립·유튜브 쇼츠 URL을 일괄 큐로 처리해 번들 FFmpeg로 무손실 MP4·M4A 저장.</p>
            <ul class="util-list">
              <li>치지직 다시보기·클립 & 유튜브 쇼츠 동시 지원</li>
              <li>멀티 URL 대기열 백그라운드 일괄 다운로드</li>
              <li>구간 클리퍼 타임스탬프 커맨드 자동 생성</li>
            </ul>
            <span class="util-action">다운로더 바로가기 →</span>
          </a>

          <a href="/schedule" class="util-card util-cyan">
            <div class="util-top">
              <span class="util-ico">📅</span>
              <span class="util-badge">PNG · 템플릿 저장</span>
            </div>
            <h3>방송 편성표 스튜디오</h3>
            <p class="util-desc">포토샵 없이 7가지 감성 테마로 주간·월간 방송 시간표를 제작하고 고화질 PNG로 저장.</p>
            <ul class="util-list">
              <li>치지직 네온·레트로 등 7종 방송 전용 테마</li>
              <li>템플릿(.json) 로컬 저장으로 매주 30초 완성</li>
              <li>디스코드·팬카페 공지 텍스트 원클릭 복사</li>
            </ul>
            <span class="util-action">편성표 만들기 →</span>
          </a>

          <a href="/bzzk" class="util-card util-amber">
            <div class="util-top">
              <span class="util-ico">🛡️</span>
              <span class="util-badge">실시간 교차 레이더</span>
            </div>
            <h3>검지직 (Bzzk) 보호 레이더</h3>
            <p class="util-desc">다중 채널에서 동시다발적으로 제재된 악성 분탕 계정을 사전 감지해 내 방송을 보호.</p>
            <ul class="util-list">
              <li>다중 방송 제재 패턴 실시간 교차 분석</li>
              <li>계정 식별자 100% 가명화 안전 처리</li>
              <li>스트리머 전용 사전 방어 확인 피드</li>
            </ul>
            <span class="util-action">레이더 확인하기 →</span>
          </a>
        </div>

        <!-- Compact MBTI Studio Strip -->
        <a href="/mbti" class="mbti-strip">
          <div class="mbti-strip-left">
            <span class="mbti-ico">🧠</span>
            <div>
              <div class="mbti-title-row">
                <strong>정밀 60문항 MBTI & 8대 인지기능 검사</strong>
                <span class="mbti-chip">방송 소통 콘텐츠</span>
              </div>
              <p>4대 심리 축 정밀 % 스펙트럼, 스트레스 루프, 시청자 궁합 및 스트리머 방송 성향 무료 분석</p>
            </div>
          </div>
          <span class="mbti-go">검사 시작하기 →</span>
        </a>

        <div class="section-cta-row">
          <a href="/tools" class="btn-outline-hub">
            <span>🛠️ 방송 유틸리티 전체 디렉토리 보기 (6종 무료)</span>
            <span class="arrow">→</span>
          </a>
        </div>
      </section>

      <!-- 4. LATEST RELEASES STRIP -->
      <section class="releases-section">
        <div class="releases-box">
          <div class="releases-head">
            <div class="releases-title-group">
              <span class="rel-dot"></span>
