---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';
import { getCollection } from 'astro:content';

const games = await getCollection('games');

// Sort so flagship god-duel is first
const sortedGames = games.sort((a, b) => (b.data.featured ? 1 : 0) - (a.data.featured ? 1 : 0));
---

<!doctype html>
<html lang="en" class="dark">
  <head>
    <BaseHead title={`${SITE_TITLE} - Free Instant Browser Games & Tactical Puzzles`} description={SITE_DESCRIPTION} />
  </head>
  <body class="arcade-home-body">
    <Header />

    <main class="arcade-home-main">
      <!-- Hero Section -->
      <section class="hero-showcase">
        <div class="hero-backdrop"></div>
        <div class="hero-content">
          <div class="hero-pill">
            <span class="pill-spark">✨</span>
            <span>100% Free Client-Side Gaming • Zero Downloads</span>
          </div>

          <h1 class="hero-headline">
            Instant Web Games.<br />
            <span class="gradient-text">Zero Waiting. Endless Fun.</span>
          </h1>

          <p class="hero-subtext">
            Play tactical turn card battles, satisfying tile mergers, and 60-second speed puzzles directly in your web browser. Free forever on mobile and desktop.
          </p>

          <!-- Featured Game Hero Banner -->
          <div class="featured-hero-card">
            <div class="featured-glow"></div>
            <div class="featured-inner">
              <div class="featured-badge-row">
                <span class="flagship-badge">🔥 FLAGSHIP RELEASE</span>
                <span class="rating-badge">★ 4.95 (24.8K plays)</span>
              </div>
              <div class="featured-main-row">
                <div class="featured-icon-box">⚔️</div>
                <div class="featured-text">
                  <h2>God Duel</h2>
                  <p>Inspired by the legendary <em>God Field (갓필드)</em>. Duel chaos deities with swords, shields, divine miracles, and clutch comebacks.</p>
                </div>
                <div class="featured-action">
                  <a href="/games/god-duel" class="btn-play-hero">
                    <span>⚔️ Play God Duel</span>
                  </a>
                </div>
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- Ad Banner Top Area -->
      <div class="home-ad-zone">
        <div class="ad-card-placeholder">
          <span class="ad-tag">ADVERTISEMENT</span>
          <span class="ad-msg">Support free indie web games • 100% client-side</span>
        </div>
      </div>

      <!-- Games Showcase Grid -->
      <section class="games-directory-section">
        <div class="section-header">
          <div class="title-group">
            <span class="sec-label">ALL TITLES</span>
            <h2>Choose Your Challenge</h2>
          </div>
          <p class="sec-desc">Every game runs directly on your device CPU with zero lag, instant loading, and zero installations.</p>
        </div>

        <div class="games-grid">
          {sortedGames.map(game => (
            <article class={`game-card ${game.data.featured ? 'featured-card' : ''}`}>
              <div class="card-top-row">
                <span class="card-icon">{game.data.icon}</span>
                <div class="card-badges">
                  <span class="category-pill">{game.data.category}</span>
                  <span class="badge-accent">{game.data.badge}</span>
                </div>
              </div>

              <div class="card-body">
                <h3 class="card-title">
                  <a href={`/games/${game.id}`}>{game.data.title}</a>
                </h3>
                <p class="card-tagline">{game.data.tagline}</p>
                <p class="card-description">{game.data.description.substring(0, 130)}...</p>
              </div>

              <div class="card-footer">
                <div class="meta-row">
                  <span class="meta-item">⏱️ {game.data.playTime}</span>
                  <span class="meta-item">👥 {game.data.players}</span>
                </div>
                <a href={`/games/${game.id}`} class="btn-play-card">
                  <span>Play Now →</span>
                </a>
              </div>
            </article>
          ))}
        </div>
      </section>

      <!-- Why AetherArcade Section -->
      <section class="value-props-section">
        <div class="props-grid">
          <div class="prop-card">
            <div class="prop-icon">⚡</div>
            <h3>Zero Download Required</h3>
            <p>Runs 100% client-side via lightweight HTML5 and JavaScript. No apps to install, no storage eaten, instant play in seconds.</p>
          </div>
          <div class="prop-card">
            <div class="prop-icon">📱</div>
            <h3>Mobile & Desktop Ready</h3>
            <p>Fully responsive with touch controls for smartphones and keyboard hotkeys for desktop. Pick up and play anywhere.</p>
          </div>
          <div class="prop-card">
            <div class="prop-icon">🧠</div>
            <h3>Quick Mental Refresh</h3>
            <p>Designed for 2–5 minute tactical breaks during work, study, or commuting. Instant dopamine with zero predatory paywalls.</p>
          </div>
        </div>
      </section>

      <!-- FAQ Section for Search Optimization -->
      <section class="home-faq-section">
        <div class="faq-inner">
          <h2>Frequently Asked Questions</h2>
          <div class="faq-grid">
            <div class="faq-box">
              <h3>Are all games on AetherArcade completely free?</h3>
              <p>Yes, 100% free forever. We do not have micro-transactions, pay-to-win cards, or paywalls. All games are funded by non-intrusive web display advertisements.</p>
            </div>
            <div class="faq-box">
              <h3>Do I need an account or login to play?</h3>
              <p>No account required! Your high scores and preferences are securely saved in your browser's local storage so you can jump in and play instantly as a guest.</p>
            </div>
            <div class="faq-box">
              <h3>What is God Duel?</h3>
              <p>God Duel is our flagship turn-based card duel game inspired by the legendary web classic <em>God Field (갓필드)</em>. You manage Health and Miracle Points while bluffing, attacking, and guarding against an intelligent deity AI opponent.</p>
            </div>
            <div class="faq-box">
              <h3>Can I play these games unblocked at school or work?</h3>
              <p>Yes. AetherArcade is a lightweight, standard HTTPS website without external heavyweight game launchers, making it accessible on almost any standard modern browser.</p>
            </div>
          </div>
        </div>
      </section>
    </main>

    <Footer />
  </body>
</html>

<style>
  .arcade-home-body {
    background: #090d16 !important;
    color: #f1f5f9 !important;
    min-height: 100vh;
    display: flex;
    flex-direction: column;
  }

  .arcade-home-main {
    flex: 1;
    max-width: 1200px;
    margin: 0 auto;
    padding: 2rem 1rem 5rem;
    width: 100%;
  }

  /* Hero Section */
  .hero-showcase {
    position: relative;
    padding: 3rem 1rem 2.5rem;
    text-align: center;
    overflow: hidden;
  }

  .hero-backdrop {
    position: absolute;
    top: -30%;
    left: 50%;
    transform: translateX(-50%);
    width: 650px;
    height: 450px;
    background: radial-gradient(circle, rgba(168, 85, 247, 0.22) 0%, rgba(56, 189, 248, 0.1) 50%, transparent 80%);
    filter: blur(60px);
    pointer-events: none;
    z-index: 0;
  }

  .hero-content {
    position: relative;
    z-index: 1;
    max-width: 850px;
    margin: 0 auto;
  }

  .hero-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    background: rgba(168, 85, 247, 0.15);
    border: 1px solid rgba(168, 85, 247, 0.35);
    color: #e9d5ff;
    font-size: 0.8rem;
    font-weight: 700;
    padding: 0.3rem 0.85rem;
    border-radius: 999px;
    margin-bottom: 1.25rem;
  }

  .hero-headline {
    font-size: 3rem;
    font-weight: 900;
    line-height: 1.15;
    letter-spacing: -0.03em;
    color: #ffffff;
    margin: 0 0 1rem;
  }

  .gradient-text {
    background: linear-gradient(135deg, #a855f7 0%, #38bdf8 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .hero-subtext {
    font-size: 1.1rem;
    color: #94a3b8;
    line-height: 1.6;
    margin: 0 auto 2.5rem;
    max-width: 620px;
  }

  /* Featured Hero Card */
  .featured-hero-card {
    position: relative;
    background: #0f172a;
    border: 2px solid rgba(168, 85, 247, 0.4);
    border-radius: 16px;
    padding: 1.5rem 2rem;
    text-align: left;
    box-shadow: 0 12px 35px rgba(168, 85, 247, 0.2);
  }

  .featured-badge-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 1rem;
  }

  .flagship-badge {
    background: linear-gradient(135deg, #ef4444, #f97316);
    color: #ffffff;
    font-size: 0.7rem;
    font-weight: 800;
    padding: 0.2rem 0.6rem;
    border-radius: 6px;
  }

  .rating-badge {
    font-size: 0.75rem;
    color: #facc15;
    font-weight: 700;
  }

  .featured-main-row {
    display: flex;
    align-items: center;
    gap: 1.5rem;
  }

  .featured-icon-box {
    font-size: 3rem;
    background: rgba(168, 85, 247, 0.15);
    border: 1px solid rgba(168, 85, 247, 0.3);
    border-radius: 14px;
    width: 72px;
    height: 72px;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .featured-text {
    flex: 1;
  }

  .featured-text h2 {
    font-size: 1.4rem;
    font-weight: 800;
    color: #f8fafc;
    margin: 0 0 0.25rem;
  }

  .featured-text p {
    font-size: 0.9rem;
    color: #94a3b8;
    line-height: 1.5;
    margin: 0;
  }

  .btn-play-hero {
    background: linear-gradient(135deg, #a855f7 0%, #38bdf8 100%);
    color: #ffffff;
    text-decoration: none;
    font-weight: 800;
    font-size: 1.05rem;
    padding: 0.85rem 1.75rem;
    border-radius: 12px;
    display: inline-flex;
    align-items: center;
    white-space: nowrap;
    transition: transform 0.15s ease, box-shadow 0.15s ease;
  }

  .btn-play-hero:hover {
    transform: scale(1.04);
    box-shadow: 0 0 25px rgba(168, 85, 247, 0.5);
  }

  /* Ad Zone */
  .home-ad-zone {
    margin: 2rem 0;
    display: flex;
    justify-content: center;
  }

  .ad-card-placeholder {
    width: 100%;
    max-width: 728px;
    background: rgba(255, 255, 255, 0.02);
    border: 1px dashed rgba(255, 255, 255, 0.08);
    border-radius: 8px;
    padding: 0.6rem 1.25rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    font-size: 0.75rem;
    color: #64748b;
  }

  /* Games Grid */
  .games-directory-section {
    margin: 3rem 0;
  }

  .section-header {
    margin-bottom: 2rem;
  }

  .sec-label {
    font-size: 0.75rem;
    font-weight: 800;
    color: #38bdf8;
    letter-spacing: 0.05em;
  }

  .section-header h2 {
    font-size: 2rem;
    font-weight: 900;
    color: #f8fafc;
    margin: 0.2rem 0 0.5rem;
    letter-spacing: -0.02em;
  }

  .sec-desc {
    color: #94a3b8;
    font-size: 0.95rem;
    margin: 0;
  }

  .games-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 1.5rem;
  }

  .game-card {
    background: #0f172a;
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 14px;
    padding: 1.25rem;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    transition: transform 0.2s ease, border-color 0.2s ease, box-shadow 0.2s ease;
  }

  .game-card:hover {
    transform: translateY(-4px);
    border-color: rgba(56, 189, 248, 0.4);
    box-shadow: 0 10px 25px rgba(0, 0, 0, 0.4);
  }

  .game-card.featured-card {
    border-color: rgba(168, 85, 247, 0.35);
  }

  .card-top-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 1rem;
  }

  .card-icon {
    font-size: 2.2rem;
  }

  .card-badges {
    display: flex;
    gap: 0.35rem;
  }

  .category-pill {
    font-size: 0.65rem;
    font-weight: 700;
    text-transform: uppercase;
    background: rgba(255, 255, 255, 0.06);
    color: #94a3b8;
    padding: 0.2rem 0.5rem;
    border-radius: 6px;
  }

  .badge-accent {
    font-size: 0.65rem;
    font-weight: 700;
    background: rgba(56, 189, 248, 0.15);
    color: #38bdf8;
    padding: 0.2rem 0.5rem;
    border-radius: 6px;
  }

  .card-title {
    font-size: 1.25rem;
    font-weight: 800;
    margin: 0 0 0.2rem;
  }

  .card-title a {
    color: #f8fafc;
    text-decoration: none;
    transition: color 0.15s ease;
  }

  .card-title a:hover {
    color: #38bdf8;
  }

  .card-tagline {
    font-size: 0.8rem;
    color: #38bdf8;
    font-weight: 600;
    margin: 0 0 0.6rem;
  }

  .card-description {
    font-size: 0.85rem;
    color: #94a3b8;
    line-height: 1.5;
    margin: 0;
  }

  .card-footer {
    margin-top: 1.5rem;
    padding-top: 0.85rem;
    border-top: 1px solid rgba(255, 255, 255, 0.05);
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .meta-row {
    display: flex;
    gap: 0.5rem;
    font-size: 0.72rem;
    color: #64748b;
  }

  .btn-play-card {
    background: rgba(255, 255, 255, 0.08);
    color: #ffffff;
    text-decoration: none;
    font-size: 0.8rem;
    font-weight: 700;
    padding: 0.4rem 0.8rem;
    border-radius: 6px;
    transition: all 0.15s ease;
  }

  .btn-play-card:hover {
    background: #38bdf8;
    color: #020617;
  }

  /* Value Props */
  .value-props-section {
    margin: 4rem 0;
    padding: 3rem 1.5rem;
    background: #0f172a;
    border-radius: 16px;
    border: 1px solid rgba(255, 255, 255, 0.06);
  }

  .props-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2rem;
  }

  .prop-card {
    text-align: center;
  }

  .prop-icon {
    font-size: 2.5rem;
    margin-bottom: 0.75rem;
  }

  .prop-card h3 {
    font-size: 1.15rem;
    font-weight: 800;
    color: #f8fafc;
    margin: 0 0 0.5rem;
  }

  .prop-card p {
    font-size: 0.88rem;
    color: #94a3b8;
    line-height: 1.6;
    margin: 0;
  }

  /* FAQ */
  .home-faq-section {
    margin: 4rem 0 2rem;
  }

  .faq-inner {
    max-width: 900px;
    margin: 0 auto;
  }

  .home-faq-section h2 {
    font-size: 1.8rem;
    font-weight: 900;
    color: #f8fafc;
    text-align: center;
    margin-bottom: 2rem;
  }

  .faq-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.5rem;
  }

  .faq-box {
    background: #0f172a;
    border: 1px solid rgba(255, 255, 255, 0.06);
    border-radius: 12px;
    padding: 1.5rem;
  }

  .faq-box h3 {
    font-size: 1rem;
    font-weight: 800;
    color: #f8fafc;
    margin: 0 0 0.5rem;
  }

  .faq-box p {
    font-size: 0.88rem;
    color: #94a3b8;
    line-height: 1.6;
    margin: 0;
  }

  @media (max-width: 768px) {
    .hero-headline {
      font-size: 2.2rem;
    }
    .featured-main-row {
      flex-direction: column;
      text-align: center;
      gap: 1rem;
    }
    .props-grid, .faq-grid {
      grid-template-columns: 1fr;
    }
    .btn-play-hero {
      width: 100%;
      justify-content: center;
    }
  }
</style>