---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE, SITE_TAGLINE, SITE_DESCRIPTION } from '../consts';
import { getCollection } from 'astro:content';
import { getKoUrl, getEnUrl } from '../i18n';

const urlParams = Astro.url.searchParams;
const streamerMode = urlParams.has('stream') || urlParams.has('obs');

const games = await getCollection('games');
const priorityOrder = ['marble-roulette', 'roulette', 'ladder', 'drinking-marble', 'ai-music-quiz', 'stream-doodle', 'stream-emoji', 'fortune'];
const sortedGames = games.sort((a, b) => {
  const idxA = priorityOrder.indexOf(a.id);
  const idxB = priorityOrder.indexOf(b.id);
  return (idxA !== -1 ? idxA : 99) - (idxB !== -1 ? idxB : 99);
});

const CATEGORY_MAP: Record<string, string> = {
  stream: '방송/추첨',
  arcade: '아케이드',
  puzzle: '퍼즐',
  word: '단어/두뇌',
  card: '카드/보드',
  strategy: '전략'
};
const homeFaqSchema = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "방송 송출이나 유튜브 영상 제작으로 수익 창출(상업적 이용)을 해도 되나요?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "네, 전면 허용됩니다! 에러레저(ErrorLedger)의 모든 게임과 방송 도구는 치지직, 유튜브, SOOP 등 모든 플랫폼에서의 실시간 라이브 방송 송출, 녹화 영상 업로드, 유튜브 광고 및 후원(도네이션) 수익 창출에 제한 없이 100% 무료로 자유롭게 이용하실 수 있습니다."
      }
    },
    {
      "@type": "Question",
      "name": "전체화면이나 집중 모드는 어떻게 사용하나요?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "각 게임 상단의 [⛶ 전체화면] 또는 [📺 집중 모드] 버튼을 누르면 불필요한 브라우저 여백 없이 화면 가득 띄워 시원하게 플레이할 수 있습니다."
      }
    },
    {
      "@type": "Question",
      "name": "비용이나 회원가입이 필요한가요?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "아닙니다. 로그인이나 회원가입 없이 돌림판, 사다리타기, MBTI 검사 등 모든 방송 도구를 평생 100% 무료로 사용할 수 있습니다."
      }
    },
    {
      "@type": "Question",
      "name": "치지직, SOOP(아프리카TV), 유튜브 라이브 모두 지원하나요?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "네. 표준 웹 브라우저 기반으로 동작하므로 치지직(CHZZK), SOOP, 유튜브, 트위치 등 모든 1인 미디어 및 스트리밍 플랫폼에서 완벽하게 호환됩니다."
      }
    },
    {
      "@type": "Question",
      "name": "추첨 결과는 공정한가요? (조작 방지)",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "돌림판, 사다리타기 등 모든 추첨과 게임은 암호학적 의사 난수(PRNG) 및 일대일 전단사 알고리즘으로 설계되어 누구도 결과를 임의 조작할 수 없습니다."
      }
    },
    {
      "@type": "Question",
      "name": "에러레저(ErrorLedger)는 어떤 서비스인가요?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "에러레저(ErrorLedger)는 트위치, 유튜브, 치지직, SOOP 등 전 세계 라이브 스트리머와 크리에이터, 시청자를 위한 100% 무료 인터랙티브 웹 게임, 심리 검사(정밀 MBTI), 방송 보조 도구(치지직 다운로더, 방송 편성표 제작기, 검지직 분탕 방어 레이더) 플랫폼입니다. 별도 설치나 로그인 없이 브라우저에서 즉시 이용하실 수 있습니다."
      }
    },
    {
      "@type": "Question",
      "name": "치지직 다운로더는 어떻게 사용하며 정말 무료인가요?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "네, 에러레저 치지직 다운로더는 결제나 횟수 제한 없는 100% 무료 유틸리티입니다. 네이버 치지직의 다시보기(VOD)나 클립 주소를 넣으면 네이버 CDN 공식 최고 화질(1080p FHD 60fps) 무손실 MP4 파일로 내 PC에 초고속 다운로드됩니다."
      }
    },
    {
      "@type": "Question",
      "name": "방송 주간 편성표를 만들어 팬카페나 디스코드에 공유할 수 있나요?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "네, 방송 편성표 스튜디오에서 7가지 감성 디자인 테마로 주간/월간 방송 시간표를 10초 만에 제작하고 고화질 PNG 이미지로 저장하거나, 디스코드 및 X(트위터) 공지용 텍스트를 원클릭 복사할 수 있습니다. 템플릿(JSON)을 내 PC에 저장해 매주 재사용할 수도 있습니다."
      }
    },
    {
      "@type": "Question",
      "name": "검지직(Bzzk)은 어떤 도구인가요?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "검지직은 네이버 치지직 다중 채널에서 동시다발적으로 제재를 일으키는 악성 분탕 계정을 실시간으로 교차 분석하여 내 방송에 피해가 발생하기 전 사전에 파악하고 대처할 수 있도록 돕는 실시간 방송 보호 레이더입니다."
      }
    }
  ]
});
---

<!doctype html>
<html lang="ko" class="dark">
  <head>
    <BaseHead title={`${SITE_TITLE} - ${SITE_TAGLINE}`} description={SITE_DESCRIPTION} lang="ko"
      hreflangKo={getKoUrl((Astro.site || 'https://errorledger.com').toString(), Astro.url.pathname)}
      hreflangEn={getEnUrl((Astro.site || 'https://errorledger.com').toString(), Astro.url.pathname)}
    />
    <script type="application/ld+json" set:html={homeFaqSchema}></script>
  </head>
  <body class="arcade-home-body">
    <Header />

    <main class="arcade-home-main">
      <!-- Hero Section -->
      <section class="hero-showcase">
        <div class="hero-ambient-glow glow-left"></div>
        <div class="hero-ambient-glow glow-right"></div>
        <div class="hero-cyber-grid"></div>

        <div class="hero-split-container">
          <!-- Left Column: Value Prop & Actions -->
          <div class="hero-col-content">
            <div class="hero-pill">
              <span class="live-indicator"></span>
              <span>치지직 · 유튜브 · SOOP 방송 송출 & 상업적 이용 100% 무료</span>
            </div>

            <h1 class="hero-headline">
              생방송을 위한<br />
              <span class="gradient-text">무료 방송 도구 스튜디오</span>
            </h1>

            <p class="hero-subtext">
              설치와 로그인 없이 브라우저에서 1초 만에 실행하는 치지직 방송 필수 유틸리티, 인터랙티브 추첨 룰렛 및 스트리머 편의 도구 모음.
            </p>

            <div class="hero-cta-group">
              <a href="/tools" class="hero-btn-primary">
                <span class="btn-icon">🛠️</span>
                <span class="btn-text">방송 도구 모아보기</span>
                <span class="btn-arrow">→</span>
              </a>
              <a href="/games" class="hero-btn-secondary">
                <span class="btn-icon">🎮</span>
                <span class="btn-text">인터랙티브 게임</span>
              </a>
            </div>

            <div class="hero-trust-bar">
              <div class="trust-item">
                <span class="trust-icon">⚡</span>
                <span class="trust-text">100% 완전 무료</span>
              </div>
              <div class="trust-item">
                <span class="trust-icon">🔒</span>
                <span class="trust-text">무설치 · 무로그인</span>
              </div>
              <div class="trust-item">
                <span class="trust-icon">🎙️</span>
                <span class="trust-text">치지직 스트리머 특화</span>
              </div>
            </div>
          </div>

          <!-- Right Column: 4-Card Flagship Deck -->
          <div class="hero-col-deck">
            <div class="hero-deck-grid">
              <!-- Card 1: Marble Race Roulette -->
              <a href="/games/marble-roulette" class="deck-card card-marble">
                <div class="deck-card-glow"></div>
                <div class="deck-card-header">
                  <div class="deck-icon-badge marble-icon">🔮</div>
                  <span class="deck-badge badge-hot">🔥 추천 1위 플래그십</span>
                </div>
                <div class="deck-card-body">
                  <h2 class="deck-card-title">구슬 레이스 룰렛</h2>
                  <p class="deck-card-desc">7,200px 롱코스 트랙과 스프링 바운서 역전 기믹의 실시간 3D 물리 구슬 추첨기</p>
                </div>
                <div class="deck-card-footer">
                  <span class="deck-action-text">레이스 시작하기</span>
                  <span class="deck-action-arrow">→</span>
                </div>
              </a>

              <!-- Card 2: Chzzk & YouTube Downloader -->
              <a href="/chzzk-downloader" class="deck-card card-downloader">
                <div class="deck-card-glow"></div>
                <div class="deck-card-header">
                  <div class="deck-icon-badge downloader-icon">📥</div>
                  <span class="deck-badge badge-green">⚡ 4K·1080p & 쇼츠</span>
                </div>
                <div class="deck-card-body">
                  <h2 class="deck-card-title">치지직 & 유튜브 다운로더</h2>
                  <p class="deck-card-desc">치지직 다시보기 VOD·클립 & 유튜브 영상·쇼츠 링크만 넣으면 대기열 일괄 무손실 초고속 다운로드</p>
                </div>
                <div class="deck-card-footer">
                  <span class="deck-action-text">무료 다운로드</span>
                  <span class="deck-action-arrow">→</span>
                </div>
              </a>

              <!-- Card 3: Bzzk Radar -->
              <a href="/bzzk" class="deck-card card-radar">
                <div class="deck-card-glow"></div>
                <div class="deck-card-header">
                  <div class="deck-icon-badge radar-icon">🛡️</div>
                  <span class="deck-badge badge-purple">🛡️ 실시간 레이더</span>
                </div>
                <div class="deck-card-body">
                  <h2 class="deck-card-title">검지직 악성 계정 방어</h2>
                  <p class="deck-card-desc">치지직 방송 전 분탕·다중 밴 의심 유저 및 악성 계정을 사전에 감지하고 차단</p>
                </div>
                <div class="deck-card-footer">
                  <span class="deck-action-text">레이더 조회하기</span>
                  <span class="deck-action-arrow">→</span>
                </div>
              </a>

              <!-- Card 4: Chzzk Guide & Creator Showcase -->
              <a href="/guide" class="deck-card card-guide">
                <div class="deck-card-glow"></div>
                <div class="deck-card-header">
                  <div class="deck-icon-badge guide-icon">🎨</div>
                  <span class="deck-badge badge-cyan">📖 가이드 & 작가</span>
                </div>
                <div class="deck-card-body">
                  <h2 class="deck-card-title">치지직 가이드 & 작가</h2>
                  <p class="deck-card-desc">OBS 세팅 팁과 라이브 방송으로 작업 과정을 투명하게 증명하는 치지직 공식 등록 작가 쇼케이스</p>
                </div>
                <div class="deck-card-footer">
                  <span class="deck-action-text">가이드 둘러보기</span>
                  <span class="deck-action-arrow">→</span>
                </div>
              </a>
            </div>
          </div>
        </div>
      </section>

      <!-- Games Showcase Grid -->
      <section class="games-directory-section">
        <div class="section-header">
          <h2>방송 도구 라인업</h2>
        </div>

        <div class="games-grid">
          {sortedGames.map(game => {
            const href = game.id === 'fortune' ? '/fortune' : `/games/${game.id}`;
            const btnText = game.id === 'fortune' ? '운세 보기 →' : '시작하기 →';
            return (
              <article class="game-card">
                <div class="card-top-row">
                  <span class="card-icon">{game.data.icon}</span>
                  <span class="badge-accent">{game.data.badge}</span>
                </div>

                <div class="card-body">
                  <h3 class="card-title">
                    <a href={href}>{game.data.title}</a>
                  </h3>
                  <p class="card-tagline">{game.data.tagline}</p>
                </div>

                <div class="card-footer">
                  <span class="meta-item">⏱️ {game.data.playTime}</span>
                  <a href={href} class="btn-play-card">
                    <span>{btnText}</span>
                  </a>
                </div>
              </article>
            );
          })}
        </div>

        <div class="section-hub-footer">
          <a href="/games" class="btn-hub-cta games-accent">
            <span class="btn-hub-icon">🎮</span>
            <span>인터랙티브 웹게임 전체 디렉토리 둘러보기 (7종 무료)</span>
            <span class="btn-hub-arrow">→</span>
          </a>
        </div>
      </section>

      <!-- Streamer Utilities Showcase Section (HIGH-IMPACT SHOWCASE) -->
      <section class="utilities-showcase-section" id="stream-utilities">
        <div class="utilities-showcase-container">
          <div class="utilities-showcase-header">
            <div class="util-section-pill">
              <span class="util-pulse-dot"></span>
              <span>STREAMER TOOLKIT • 100% FREE</span>
            </div>
            <h2 class="util-section-title">
              스트리머를 위한 <span class="gradient-text-tools">필수 방송 유틸리티 스튜디오</span>
            </h2>
            <p class="util-section-desc">
              포토샵 없는 감성 편성표 제작부터 다중 방송 분탕 방어 레이더, 1080p 무손실 영상 다운로더까지 —<br class="hide-mobile" />
              방송 준비와 채널 운영 시간을 획기적으로 줄여주는 무료 스튜디오 라인업입니다.
            </p>
          </div>

          <div class="utilities-cards-grid">
            <!-- 1. Chzzk Downloader Card (NEW & HIGHLIGHTED) -->
            <article class="utility-showcase-card card-chzzk">
              <div class="util-card-glow chzzk-glow"></div>
              <div class="util-card-top">
                <div class="util-card-badge-row">
                  <span class="util-badge chzzk-badge">⚡ NEW RELEASE</span>
                  <span class="util-tag">1080p FHD 무손실</span>
                </div>
                <div class="util-card-icon-wrap chzzk-icon-wrap">
                  <span class="util-card-icon">📥</span>
                </div>
              </div>
              <div class="util-card-body">
                <h3 class="util-card-title">치지직 & 유튜브 고속 다운로더</h3>
                <p class="util-card-tagline">VOD·클립 & 유튜브 영상·쇼츠 일괄 무손실 다운로더</p>
                <p class="util-card-desc">
                  유료 결제나 횟수 제한 없는 100% 무료 유틸리티! 네이버 치지직 원본과 유튜브 4K/FHD 고화질 영상을 번들 FFmpeg로 손실 없이 내 PC에 일괄 다운로드합니다.
                </p>
                <ul class="util-card-features">
                  <li><span class="check-icon">✓</span> 치지직 & 유튜브(동영상/쇼츠/단축링크) 완벽 지원</li>
                  <li><span class="check-icon">✓</span> 세션 다운로드 대기열 & 순차 큐 백그라운드 처리</li>
                  <li><span class="check-icon">✓</span> 멀티 URL 일괄 입력 & 백그라운드 실시간 제목 변환</li>
                  <li><span class="check-icon">✓</span> 자동 내장 FFmpeg로 무손실 MP4 & 오디오(.m4a) 추출</li>
                </ul>
              </div>
              <div class="util-card-footer">
                <a href="/chzzk-downloader" class="btn-util-card chzzk-btn">
                  <span>다운로더 바로가기 →</span>
                </a>
              </div>
            </article>

            <!-- 2. Stream Schedule Studio Card -->
            <article class="utility-showcase-card card-schedule">
              <div class="util-card-glow schedule-glow"></div>
              <div class="util-card-top">
                <div class="util-card-badge-row">
                  <span class="util-badge schedule-badge">🔥 POPULAR</span>
                  <span class="util-tag">7가지 감성 테마</span>
                </div>
                <div class="util-card-icon-wrap schedule-icon-wrap">
                  <span class="util-card-icon">📅</span>
                </div>
              </div>
              <div class="util-card-body">
                <h3 class="util-card-title">방송 편성표 스튜디오</h3>
                <p class="util-card-tagline">주간 & 월간 방송 일정표 & 템플릿 메이커</p>
                <p class="util-card-desc">
                  포토샵 없이 클릭 몇 번으로 완성하는 고화질 방송 일정표! 내 PC 영구 템플릿 저장(.json)과 디스코드/팬카페 원클릭 텍스트 복사를 지원합니다.
                </p>
                <ul class="util-card-features">
                  <li><span class="check-icon">✓</span> 치지직 네온, 트위치 보라 등 7가지 테마</li>
                  <li><span class="check-icon">✓</span> 내 PC에 템플릿 저장 & 다음 주 30초 완성</li>
                  <li><span class="check-icon">✓</span> 디스코드·치지직 라운지·팬카페 텍스트 복사</li>
                  <li><span class="check-icon">✓</span> 워터마크 없는 선명한 PNG 이미지 즉시 저장</li>
                </ul>
              </div>
              <div class="util-card-footer">
                <a href="/schedule" class="btn-util-card schedule-btn">
                  <span>편성표 만들기 →</span>
                </a>
              </div>
            </article>

            <!-- 3. Bzzk Stream Radar Card -->
            <article class="utility-showcase-card card-bzzk">
              <div class="util-card-glow bzzk-glow"></div>
              <div class="util-card-top">
