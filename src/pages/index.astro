---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE, SITE_TAGLINE, SITE_DESCRIPTION } from '../consts';
import { getCollection } from 'astro:content';

const games = await getCollection('games');
const priorityOrder = ['marble-roulette', 'roulette', 'ladder', 'fortune'];
const sortedGames = games.sort((a, b) => {
  const idxA = priorityOrder.indexOf(a.id);
  const idxB = priorityOrder.indexOf(b.id);
  return (idxA !== -1 ? idxA : 99) - (idxB !== -1 ? idxB : 99);
});

const CATEGORY_MAP: Record<string, string> = {
  stream: '방송/추첨',
  arcade: '아케이드',
  puzzle: '퍼즐',
  word: '단어/두뇌',
  card: '카드/보드',
  strategy: '전략'
};
const homeFaqSchema = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "방송 화면(OBS/프리즘)에 어떻게 띄우나요?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "OBS Studio나 프리즘 라이브 스튜디오에서 [브라우저 소스] 또는 [윈도우 캡처]를 추가하고, 우측 상단의 [⛶ 전체화면] 버튼을 누르면 군더더기 없이 방송 화면 가득 띄워 송출할 수 있습니다."
      }
    },
    {
      "@type": "Question",
      "name": "비용이나 회원가입이 필요한가요?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "아닙니다. 로그인이나 회원가입 없이 마블 룰렛, 돌림판, 사다리타기 등 모든 방송 도구를 평생 100% 무료로 사용할 수 있습니다."
      }
    },
    {
      "@type": "Question",
      "name": "치지직, SOOP(아프리카TV), 유튜브 라이브 모두 지원하나요?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "네. 표준 웹 브라우저 기반으로 동작하므로 치지직(CHZZK), SOOP, 유튜브, 트위치 등 모든 1인 미디어 및 스트리밍 플랫폼에서 완벽하게 호환됩니다."
      }
    },
    {
      "@type": "Question",
      "name": "추첨 결과는 공정한가요? (조작 방지)",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "구슬 룰렛은 매 프레임 정밀 2D 강체 물리 엔진(중력, 마찰, 탄성 충돌)으로 계산되며, 사다리타기와 돌림판은 암호학적 의사 난수(PRNG) 및 일대일 전단사 알고리즘으로 설계되어 누구도 결과를 조작할 수 없습니다."
      }
    },
    {
      "@type": "Question",
      "name": "StreamArcade (마블 룰렛 & 방송 도구)는 어떤 서비스인가요?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "StreamArcade는 트위치, 유튜브, 치지직, SOOP 등 전 세계 라이브 스트리머와 크리에이터를 위한 100% 무료 클라이언트 기반 인터랙티브 웹 게임 및 방송 도구입니다. 2D 물리 기반 마블 룰렛(구슬 레이스 시뮬레이터), 무작위 돌림판, 사다리타기 게임 등을 설치 없이 브라우저에서 즉시 제공합니다."
      }
    }
  ]
});
---

<!doctype html>
<html lang="ko" class="dark">
  <head>
    <BaseHead title={`${SITE_TITLE} - ${SITE_TAGLINE}`} description={SITE_DESCRIPTION} />
    <script type="application/ld+json" set:html={homeFaqSchema}></script>
  </head>
  <body class="arcade-home-body">
    <Header />

    <main class="arcade-home-main">
      <!-- Hero Section -->
      <section class="hero-showcase">
        <div class="hero-backdrop"></div>
        <div class="hero-content">
          <h1 class="hero-headline">
            생방송을 위한 <span class="gradient-text">무료 방송 도구 모음</span>
          </h1>

          <p class="hero-subtext">
            설치와 로그인 없이 브라우저에서 1초 만에 실행하는 방송용 룰렛, 사다리타기, 구슬 레이스.
          </p>

          <!-- Featured Game Hero Banner -->
          <div class="featured-hero-card">
            <div class="featured-main-row">
              <div class="featured-icon-box">🔮</div>
              <div class="featured-text">
                <span class="flagship-label">🔥 추천 1위 플래그십</span>
                <h2>방송용 구슬 레이스 룰렛</h2>
                <p>7,200px 롱코스 트랙과 스프링 바운서 역전 기믹을 갖춘 실시간 구슬 추첨기</p>
              </div>
              <div class="featured-action">
                <a href="/games/marble-roulette" class="btn-play-hero">
                  <span>구슬 레이스 시작하기 →</span>
                </a>
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- Games Showcase Grid -->
      <section class="games-directory-section">
        <div class="section-header">
          <h2>방송 도구 라인업</h2>
        </div>

        <div class="games-grid">
          {sortedGames.map(game => {
            const href = game.id === 'fortune' ? '/fortune' : `/games/${game.id}`;
            const btnText = game.id === 'fortune' ? '운세 보기 →' : '시작하기 →';
            return (
              <article class="game-card">
                <div class="card-top-row">
                  <span class="card-icon">{game.data.icon}</span>
                  <span class="badge-accent">{game.data.badge}</span>
                </div>

                <div class="card-body">
                  <h3 class="card-title">
                    <a href={href}>{game.data.title}</a>
                  </h3>
                  <p class="card-tagline">{game.data.tagline}</p>
                </div>

                <div class="card-footer">
                  <span class="meta-item">⏱️ {game.data.playTime}</span>
                  <a href={href} class="btn-play-card">
                    <span>{btnText}</span>
                  </a>
                </div>
              </article>
            );
          })}
        </div>
      </section>

      <!-- SEO Overview & Platform Features Section -->
      <section class="seo-overview-section">
        <div class="overview-container">
          <div class="overview-header">
            <span class="overview-pill">STREAM ARCADE PLATFORM</span>
            <h2>방송인을 위한 무료 웹게임 & 인터랙티브 추첨 도구 모음</h2>
            <p class="overview-sub">
              스트림아케이드(StreamArcade)는 치지직(CHZZK), SOOP(숲/아프리카TV), 유튜브 라이브(YouTube Live) 스트리머와 크리에이터를 위한 설치 없는 무료 방송 도구 플랫폼입니다.
            </p>
          </div>

          <div class="overview-grid">
            <div class="overview-card">
              <span class="overview-icon">🔮</span>
              <h3>구슬 레이스 마블 룰렛 (Marble Roulette)</h3>
              <p>
                단순한 원판 돌림판을 뛰어넘는 초대형 물리 엔진 기반 구슬 굴리기 레이스! 핀볼 범퍼, 지름길 터널, 역회전 프로펠러 등 다양한 반전 기믹으로 1등 당첨부터 꼴찌 벌칙 뽑기까지 생방송의 텐션을 극대화합니다.
              </p>
            </div>

            <div class="overview-card">
              <span class="overview-icon">🎡</span>
              <h3>돌림판 룰렛 (Random Wheel Picker)</h3>
              <p>
                찰진 래칫 눈금 회전음, 승자 축하 폭죽 이펙트, 당첨 항목 자동 제외 기능과 야식·벌칙·이벤트 1초 프리셋을 갖춘 방송 맞춤형 룰렛 추첨기입니다.
              </p>
            </div>

            <div class="overview-card">
              <span class="overview-icon">🪜</span>
              <h3>실시간 사다리타기 (Ghost Leg Ladder Game)</h3>
              <p>
                네온 발자국을 따라 실시간으로 내려가는 2~20인 인터랙티브 사다리타기. 커피 쏘기, 치킨 내기, 방송 벌칙 등 모든 내기 결과를 1:1로 정직하고 공정하게 결정합니다.
              </p>
            </div>

            <div class="overview-card">
              <span class="overview-icon">✨</span>
              <h3>오늘의 운세 & 행운 가이드 (Daily Fortune)</h3>
              <p>
                매일 자정 자동으로 갱신되는 십이지간 12띠 운세와 12 서양 별자리 운세. 오늘의 추천 행동(DO/DON'T)과 행운의 번호, 색상을 확인하고 방송 오프닝 토크로 활용해 보세요.
              </p>
            </div>
          </div>
        </div>
      </section>

      <!-- FAQ Section (Rich Search Snippets for Google & Naver) -->
      <section class="home-faq-section">
        <div class="faq-container">
          <h2>자주 묻는 질문 (FAQ)</h2>
          <div class="faq-grid">
            <div class="faq-box">
              <h3>방송 화면(OBS/프리즘)에 어떻게 띄우나요?</h3>
              <p>OBS Studio나 프리즘 라이브 스튜디오에서 [브라우저 소스] 또는 [윈도우 캡처]를 추가하고, 우측 상단의 [⛶ 전체화면] 버튼을 누르면 군더더기 없이 방송 화면 가득 띄워 송출할 수 있습니다.</p>
            </div>
            <div class="faq-box">
              <h3>비용이나 회원가입이 필요한가요?</h3>
              <p>아닙니다. 로그인이나 회원가입 없이 마블 룰렛, 돌림판, 사다리타기 등 모든 방송 도구를 평생 100% 무료로 사용할 수 있습니다.</p>
            </div>
            <div class="faq-box">
              <h3>치지직, SOOP, 유튜브 모두 지원하나요?</h3>
              <p>네. 웹 브라우저 표준 기술로 동작하므로 치지직(CHZZK), SOOP, 유튜브 라이브, 트위치 등 모든 생방송 플랫폼에서 자유롭게 호환됩니다.</p>
            </div>
            <div class="faq-box">
              <h3>추첨 결과는 공정한가요? (조작 방지)</h3>
              <p>구슬 룰렛은 매 프레임 순수 2D 물리 엔진(중력, 마찰, 탄성 충돌)에 의해 연산되며, 돌림판과 사다리타기는 수학적 전단사 매핑과 의사 난수(PRNG) 알고리즘으로 설계되어 누구도 결과를 임의 조작할 수 없습니다.</p>
            </div>
            <div class="faq-box">
              <h3>한 명에게 여러 개의 구슬을 줄 수 있나요?</h3>
              <p>네! 구슬 룰렛 참가자 목록 입력 시 이름 뒤에 <code>* 3</code> 또는 <code>* 5</code>를 적으면 해당 인원에게 여러 개의 구슬이 배정되어 당첨 확률을 손쉽게 조절할 수 있습니다.</p>
            </div>
            <div class="faq-box">
              <h3>StreamArcade (마블 룰렛 & 방송 도구)는 어떤 서비스인가요?</h3>
              <p>StreamArcade는 트위치, 유튜브, 치지직(CHZZK), SOOP 등 전 세계 라이브 스트리머와 크리에이터를 위한 100% 무료 클라이언트 기반 인터랙티브 웹 게임 및 방송 도구입니다. 정밀 물리 엔진 기반 마블 룰렛(구슬 레이스 시뮬레이터), 무작위 돌림판(룰렛), 사다리타기 게임 등을 별도 설치나 로그인 없이 브라우저에서 즉시 이용하실 수 있습니다.</p>
            </div>
          </div>
        </div>
      </section>
    </main>

    <Footer />
  </body>
</html>

<style>
  .arcade-home-body {
    background: #090d16 !important;
    color: #f1f5f9 !important;
    min-height: 100vh;
    display: flex;
    flex-direction: column;
  }

  .arcade-home-main {
    flex: 1;
    max-width: 1200px;
    margin: 0 auto;
    padding: 2rem 1rem 5rem;
    width: 100%;
  }

  /* Hero Section */
  .hero-showcase {
    position: relative;
    padding: 3rem 1rem 2.5rem;
    text-align: center;
    overflow: hidden;
  }

  .hero-backdrop {
    position: absolute;
    top: -30%;
    left: 50%;
    transform: translateX(-50%);
    width: 650px;
    height: 450px;
    background: radial-gradient(circle, rgba(168, 85, 247, 0.22) 0%, rgba(56, 189, 248, 0.1) 50%, transparent 80%);
    filter: blur(60px);
    pointer-events: none;
    z-index: 0;
  }

  .hero-content {
    position: relative;
    z-index: 1;
    max-width: 850px;
    margin: 0 auto;
  }

  .hero-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    background: rgba(168, 85, 247, 0.15);
    border: 1px solid rgba(168, 85, 247, 0.35);
    color: #e9d5ff;
    font-size: 0.8rem;
    font-weight: 700;
    padding: 0.3rem 0.85rem;
    border-radius: 999px;
    margin-bottom: 1.25rem;
  }

  .hero-headline {
    font-size: 3rem;
    font-weight: 900;
    line-height: 1.15;
    letter-spacing: -0.03em;
    color: #ffffff;
    margin: 0 0 1rem;
  }

  .gradient-text {
    background: linear-gradient(135deg, #a855f7 0%, #38bdf8 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .hero-subtext {
    font-size: 1.1rem;
    color: #94a3b8;
    line-height: 1.6;
    margin: 0 auto 2.5rem;
    max-width: 620px;
  }

  /* Featured Hero Card */
  .featured-hero-card {
    position: relative;
    background: #0f172a;
    border: 2px solid rgba(168, 85, 247, 0.4);
    border-radius: 16px;
    padding: 1.5rem 2rem;
    text-align: left;
    box-shadow: 0 12px 35px rgba(168, 85, 247, 0.2);
  }

  .flagship-label {
    display: inline-block;
    background: linear-gradient(135deg, #ef4444, #f97316);
    color: #ffffff;
    font-size: 0.7rem;
    font-weight: 800;
    padding: 0.2rem 0.55rem;
    border-radius: 6px;
    margin-bottom: 0.35rem;
  }

  .featured-main-row {
    display: flex;
    align-items: center;
    gap: 1.5rem;
  }

  .featured-icon-box {
    font-size: 3rem;
    background: rgba(168, 85, 247, 0.15);
    border: 1px solid rgba(168, 85, 247, 0.3);
    border-radius: 14px;
    width: 72px;
    height: 72px;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .featured-text {
    flex: 1;
  }

  .featured-text h2 {
    font-size: 1.4rem;
    font-weight: 800;
    color: #f8fafc;
    margin: 0 0 0.25rem;
  }

  .featured-text p {
    font-size: 0.9rem;
    color: #94a3b8;
    line-height: 1.5;
    margin: 0;
  }

  .btn-play-hero {
    background: linear-gradient(135deg, #a855f7 0%, #38bdf8 100%);
    color: #ffffff;
    text-decoration: none;
    font-weight: 800;
    font-size: 1.05rem;
    padding: 0.85rem 1.75rem;
    border-radius: 12px;
    display: inline-flex;
    align-items: center;
    white-space: nowrap;
    transition: transform 0.15s ease, box-shadow 0.15s ease;
  }

  .btn-play-hero:hover {
    transform: scale(1.04);
    box-shadow: 0 0 25px rgba(168, 85, 247, 0.5);
  }

  /* Games Grid */
  .games-directory-section {
    margin: 3rem 0;
  }

  .section-header {
    margin-bottom: 2rem;
  }

  .sec-label {
    font-size: 0.75rem;
    font-weight: 800;
    color: #38bdf8;
    letter-spacing: 0.05em;
  }

  .section-header h2 {
    font-size: 2rem;
    font-weight: 900;
    color: #f8fafc;
    margin: 0.2rem 0 0.5rem;
    letter-spacing: -0.02em;
  }

  .sec-desc {
    color: #94a3b8;
    font-size: 0.95rem;
    margin: 0;
  }

  .games-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 1.5rem;
  }

  .game-card {
    background: #0f172a;
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 14px;
    padding: 1.25rem;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    transition: transform 0.2s ease, border-color 0.2s ease, box-shadow 0.2s ease;
  }

  .game-card:hover {
    transform: translateY(-4px);
    border-color: rgba(56, 189, 248, 0.4);
    box-shadow: 0 10px 25px rgba(0, 0, 0, 0.4);
  }

  .game-card.featured-card {
    border-color: rgba(168, 85, 247, 0.35);
  }

  .card-top-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 1rem;
  }

  .card-icon {
    font-size: 2.2rem;
  }

  .card-badges {
    display: flex;
    gap: 0.35rem;
  }

  .category-pill {
    font-size: 0.65rem;
    font-weight: 700;
    text-transform: uppercase;
    background: rgba(255, 255, 255, 0.06);
    color: #94a3b8;
    padding: 0.2rem 0.5rem;
    border-radius: 6px;
  }

  .badge-accent {
    font-size: 0.65rem;
    font-weight: 700;
    background: rgba(56, 189, 248, 0.15);
    color: #38bdf8;
    padding: 0.2rem 0.5rem;
    border-radius: 6px;
  }

  .card-title {
    font-size: 1.25rem;
    font-weight: 800;
    margin: 0 0 0.2rem;
  }

  .card-title a {
    color: #f8fafc;
    text-decoration: none;
    transition: color 0.15s ease;
  }

  .card-title a:hover {
    color: #38bdf8;
  }

  .card-tagline {
    font-size: 0.8rem;
    color: #38bdf8;
    font-weight: 600;
    margin: 0 0 0.6rem;
  }

  .card-description {
    font-size: 0.85rem;
    color: #94a3b8;
    line-height: 1.5;
    margin: 0;
  }

  .card-footer {
    margin-top: 1.5rem;
    padding-top: 0.85rem;
    border-top: 1px solid rgba(255, 255, 255, 0.05);
    display: flex;
    align-items: center;
    justify-content: space-between;
