---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE, SITE_TAGLINE, SITE_DESCRIPTION } from '../consts';
import { getCollection } from 'astro:content';

const games = await getCollection('games');
const priorityOrder = ['marble-roulette', 'roulette', 'ladder', 'cosmic-drop', 'word-sprint'];
const sortedGames = games.sort((a, b) => {
  const idxA = priorityOrder.indexOf(a.id);
  const idxB = priorityOrder.indexOf(b.id);
  return (idxA !== -1 ? idxA : 99) - (idxB !== -1 ? idxB : 99);
});

const CATEGORY_MAP: Record<string, string> = {
  stream: '방송/추첨',
  arcade: '아케이드',
  puzzle: '퍼즐',
  word: '단어/두뇌',
  card: '카드/보드',
  strategy: '전략'
};
---

<!doctype html>
<html lang="ko" class="dark">
  <head>
    <BaseHead title={`${SITE_TITLE} - ${SITE_TAGLINE}`} description={SITE_DESCRIPTION} />
  </head>
  <body class="arcade-home-body">
    <Header />

    <main class="arcade-home-main">
      <!-- Hero Section -->
      <section class="hero-showcase">
        <div class="hero-backdrop"></div>
        <div class="hero-content">
          <h1 class="hero-headline">
            생방송을 위한 <span class="gradient-text">무료 방송 도구 모음</span>
          </h1>

          <p class="hero-subtext">
            설치와 로그인 없이 브라우저에서 1초 만에 실행하는 방송용 룰렛, 사다리타기, 구슬 레이스.
          </p>

          <!-- Featured Game Hero Banner -->
          <div class="featured-hero-card">
            <div class="featured-main-row">
              <div class="featured-icon-box">🔮</div>
              <div class="featured-text">
                <span class="flagship-label">🔥 추천 1위 플래그십</span>
                <h2>방송용 구슬 레이스 룰렛</h2>
                <p>7,200px 롱코스 트랙과 스프링 바운서 역전 기믹을 갖춘 실시간 구슬 추첨기</p>
              </div>
              <div class="featured-action">
                <a href="/games/marble-roulette" class="btn-play-hero">
                  <span>구슬 레이스 시작하기 →</span>
                </a>
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- Games Showcase Grid -->
      <section class="games-directory-section">
        <div class="section-header">
          <h2>방송 도구 라인업</h2>
        </div>

        <div class="games-grid">
          {sortedGames.map(game => (
            <article class="game-card">
              <div class="card-top-row">
                <span class="card-icon">{game.data.icon}</span>
                <span class="badge-accent">{game.data.badge}</span>
              </div>

              <div class="card-body">
                <h3 class="card-title">
                  <a href={`/games/${game.id}`}>{game.data.title}</a>
                </h3>
                <p class="card-tagline">{game.data.tagline}</p>
              </div>

              <div class="card-footer">
                <span class="meta-item">⏱️ {game.data.playTime}</span>
                <a href={`/games/${game.id}`} class="btn-play-card">
                  <span>시작하기 →</span>
                </a>
              </div>
            </article>
          ))}
        </div>
      </section>

      <!-- FAQ Section -->
      <section class="home-faq-section">
        <div class="faq-container">
          <h2>자주 묻는 질문</h2>
          <div class="faq-grid">
            <div class="faq-box">
              <h3>방송 화면에 어떻게 띄우나요?</h3>
              <p>브라우저 창 캡처 또는 우측 상단의 [전체화면] 버튼으로 OBS에 깔끔하게 송출할 수 있습니다.</p>
            </div>
            <div class="faq-box">
              <h3>비용이나 회원가입이 필요한가요?</h3>
              <p>아닙니다. 로그인이나 회원가입 없이 모든 기능을 평생 100% 무료로 사용할 수 있습니다.</p>
            </div>
            <div class="faq-box">
              <h3>치지직, SOOP, 유튜브 모두 지원하나요?</h3>
              <p>네. 웹 브라우저 기반으로 동작하므로 모든 생방송 플랫폼에서 자유롭게 사용 가능합니다.</p>
            </div>
            <div class="faq-box">
              <h3>추첨 결과는 공정한가요?</h3>
              <p>실시간 물리 엔진 및 난수 알고리즘에 의해 연산되므로 조작 없이 100% 공정합니다.</p>
            </div>
          </div>
        </div>
      </section>
    </main>

    <Footer />
  </body>
</html>

<style>
  .arcade-home-body {
    background: #090d16 !important;
    color: #f1f5f9 !important;
    min-height: 100vh;
    display: flex;
    flex-direction: column;
  }

  .arcade-home-main {
    flex: 1;
    max-width: 1200px;
    margin: 0 auto;
    padding: 2rem 1rem 5rem;
    width: 100%;
  }

  /* Hero Section */
  .hero-showcase {
    position: relative;
    padding: 3rem 1rem 2.5rem;
    text-align: center;
    overflow: hidden;
  }

  .hero-backdrop {
    position: absolute;
    top: -30%;
    left: 50%;
    transform: translateX(-50%);
    width: 650px;
    height: 450px;
    background: radial-gradient(circle, rgba(168, 85, 247, 0.22) 0%, rgba(56, 189, 248, 0.1) 50%, transparent 80%);
    filter: blur(60px);
    pointer-events: none;
    z-index: 0;
  }

  .hero-content {
    position: relative;
    z-index: 1;
    max-width: 850px;
    margin: 0 auto;
  }

  .hero-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    background: rgba(168, 85, 247, 0.15);
    border: 1px solid rgba(168, 85, 247, 0.35);
    color: #e9d5ff;
    font-size: 0.8rem;
    font-weight: 700;
    padding: 0.3rem 0.85rem;
    border-radius: 999px;
    margin-bottom: 1.25rem;
  }

  .hero-headline {
    font-size: 3rem;
    font-weight: 900;
    line-height: 1.15;
    letter-spacing: -0.03em;
    color: #ffffff;
    margin: 0 0 1rem;
  }

  .gradient-text {
    background: linear-gradient(135deg, #a855f7 0%, #38bdf8 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .hero-subtext {
    font-size: 1.1rem;
    color: #94a3b8;
    line-height: 1.6;
    margin: 0 auto 2.5rem;
    max-width: 620px;
  }

  /* Featured Hero Card */
  .featured-hero-card {
    position: relative;
    background: #0f172a;
    border: 2px solid rgba(168, 85, 247, 0.4);
    border-radius: 16px;
    padding: 1.5rem 2rem;
    text-align: left;
    box-shadow: 0 12px 35px rgba(168, 85, 247, 0.2);
  }

  .flagship-label {
    display: inline-block;
    background: linear-gradient(135deg, #ef4444, #f97316);
    color: #ffffff;
    font-size: 0.7rem;
    font-weight: 800;
    padding: 0.2rem 0.55rem;
    border-radius: 6px;
    margin-bottom: 0.35rem;
  }

  .featured-main-row {
    display: flex;
    align-items: center;
    gap: 1.5rem;
  }

  .featured-icon-box {
    font-size: 3rem;
    background: rgba(168, 85, 247, 0.15);
    border: 1px solid rgba(168, 85, 247, 0.3);
    border-radius: 14px;
    width: 72px;
    height: 72px;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .featured-text {
    flex: 1;
  }

  .featured-text h2 {
    font-size: 1.4rem;
    font-weight: 800;
    color: #f8fafc;
    margin: 0 0 0.25rem;
  }

  .featured-text p {
    font-size: 0.9rem;
    color: #94a3b8;
    line-height: 1.5;
    margin: 0;
  }

  .btn-play-hero {
    background: linear-gradient(135deg, #a855f7 0%, #38bdf8 100%);
    color: #ffffff;
    text-decoration: none;
    font-weight: 800;
    font-size: 1.05rem;
    padding: 0.85rem 1.75rem;
    border-radius: 12px;
    display: inline-flex;
    align-items: center;
    white-space: nowrap;
    transition: transform 0.15s ease, box-shadow 0.15s ease;
  }

  .btn-play-hero:hover {
    transform: scale(1.04);
    box-shadow: 0 0 25px rgba(168, 85, 247, 0.5);
  }

  /* Games Grid */
  .games-directory-section {
    margin: 3rem 0;
  }

  .section-header {
    margin-bottom: 2rem;
  }

  .sec-label {
    font-size: 0.75rem;
    font-weight: 800;
    color: #38bdf8;
    letter-spacing: 0.05em;
  }

  .section-header h2 {
    font-size: 2rem;
    font-weight: 900;
    color: #f8fafc;
    margin: 0.2rem 0 0.5rem;
    letter-spacing: -0.02em;
  }

  .sec-desc {
    color: #94a3b8;
    font-size: 0.95rem;
    margin: 0;
  }

  .games-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 1.5rem;
  }

  .game-card {
    background: #0f172a;
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 14px;
    padding: 1.25rem;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    transition: transform 0.2s ease, border-color 0.2s ease, box-shadow 0.2s ease;
  }

  .game-card:hover {
    transform: translateY(-4px);
    border-color: rgba(56, 189, 248, 0.4);
    box-shadow: 0 10px 25px rgba(0, 0, 0, 0.4);
  }

  .game-card.featured-card {
    border-color: rgba(168, 85, 247, 0.35);
  }

  .card-top-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 1rem;
  }

  .card-icon {
    font-size: 2.2rem;
  }

  .card-badges {
    display: flex;
    gap: 0.35rem;
  }

  .category-pill {
    font-size: 0.65rem;
    font-weight: 700;
    text-transform: uppercase;
    background: rgba(255, 255, 255, 0.06);
    color: #94a3b8;
    padding: 0.2rem 0.5rem;
    border-radius: 6px;
  }

  .badge-accent {
    font-size: 0.65rem;
    font-weight: 700;
    background: rgba(56, 189, 248, 0.15);
    color: #38bdf8;
    padding: 0.2rem 0.5rem;
    border-radius: 6px;
  }

  .card-title {
    font-size: 1.25rem;
    font-weight: 800;
    margin: 0 0 0.2rem;
  }

  .card-title a {
    color: #f8fafc;
    text-decoration: none;
    transition: color 0.15s ease;
  }

  .card-title a:hover {
    color: #38bdf8;
  }

  .card-tagline {
    font-size: 0.8rem;
    color: #38bdf8;
    font-weight: 600;
    margin: 0 0 0.6rem;
  }

  .card-description {
    font-size: 0.85rem;
    color: #94a3b8;
    line-height: 1.5;
    margin: 0;
  }

  .card-footer {
    margin-top: 1.5rem;
    padding-top: 0.85rem;
    border-top: 1px solid rgba(255, 255, 255, 0.05);
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .meta-row {
    display: flex;
    gap: 0.5rem;
    font-size: 0.72rem;
    color: #64748b;
  }

  .btn-play-card {
    background: rgba(255, 255, 255, 0.08);
    color: #ffffff;
    text-decoration: none;
    font-size: 0.8rem;
    font-weight: 700;
    padding: 0.4rem 0.8rem;
    border-radius: 6px;
    transition: all 0.15s ease;
  }

  .btn-play-card:hover {
    background: #38bdf8;
    color: #020617;
  }

  /* Value Props */
  .value-props-section {
    margin: 4rem 0;
    padding: 3rem 1.5rem;
    background: #0f172a;
    border-radius: 16px;
    border: 1px solid rgba(255, 255, 255, 0.06);
  }

  .props-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2rem;
  }

  .prop-card {
    text-align: center;
  }

  .prop-icon {
    font-size: 2.5rem;
    margin-bottom: 0.75rem;
  }

  .prop-card h3 {
    font-size: 1.15rem;
    font-weight: 800;
    color: #f8fafc;
    margin: 0 0 0.5rem;
  }

  .prop-card p {
    font-size: 0.88rem;
    color: #94a3b8;
    line-height: 1.6;
    margin: 0;
  }

  /* FAQ */
  .home-faq-section {
    margin: 4rem 0 2rem;
  }

  .faq-inner {
    max-width: 900px;
    margin: 0 auto;
  }

  .home-faq-section h2 {
    font-size: 1.8rem;
    font-weight: 900;
    color: #f8fafc;
    text-align: center;
    margin-bottom: 2rem;
  }

  .faq-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.5rem;
  }

  .faq-box {
    background: #0f172a;
    border: 1px solid rgba(255, 255, 255, 0.06);
    border-radius: 12px;
    padding: 1.5rem;
  }

  .faq-box h3 {
    font-size: 1rem;
    font-weight: 800;
    color: #f8fafc;
    margin: 0 0 0.5rem;
  }

  .faq-box p {
    font-size: 0.88rem;
    color: #94a3b8;
    line-height: 1.6;
    margin: 0;
  }

  @media (max-width: 768px) {
    .hero-headline {
      font-size: 2.2rem;
    }
    .featured-main-row {
      flex-direction: column;
      text-align: center;
      gap: 1rem;
    }
    .props-grid, .faq-grid {
      grid-template-columns: 1fr;
    }
    .btn-play-hero {
      width: 100%;
      justify-content: center;
    }
  }
</style>