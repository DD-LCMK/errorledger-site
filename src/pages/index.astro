---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';
import { getCollection } from 'astro:content';

const allPosts = await getCollection('blog');

// Sort by date (newest first)
const posts = allPosts.sort((a, b) => {
	const dateA = a.data.pubDate ? new Date(a.data.pubDate).valueOf() : 0;
	const dateB = b.data.pubDate ? new Date(b.data.pubDate).valueOf() : 0;
	return dateB - dateA;
});

const featuredPost = posts[0];
const recentPosts = posts.slice(1);

const categoryIcons: Record<string, string> = {
	work: "🧑‍💻 Work",
	money: "💰 Money",
	corporate: "🏢 Corporate",
	ai: "🤖 AI",
	internet: "🌐 Internet",
	relationships: "❤️ Relationships",
	human: "🧠 Human"
};

const topDebates = [
	{
		title: "The Friday Morning Update That Took Down 8.5 Million Computers",
		slug: "the-friday-update-that-broke-the-world",
		split: "48% CrowdStrike vs 32% Microsoft Architecture",
		votes: "1,421 votes",
		category: "corporate"
	},
	{
		title: "He Deleted the Production Database and Let the Intern Take the Fall",
		slug: "deleted-production-database-blamed-intern",
		split: "54% Malicious Sabotage vs 46% Toxic Management",
		votes: "2,890 votes",
		category: "work"
	},
	{
		title: "The $440M Knight Capital Trading Glitch: 45 Minutes of Algorithmic Ruin",
		slug: "knight-capital-trading-glitch-45-minutes",
		split: "61% QA Oversight vs 39% Rogue Legacy Dead Code",
		votes: "3,110 votes",
		category: "money"
	}
];
---

<html lang="en" class="dark">
	<head>
		<BaseHead title={`${SITE_TITLE} — Every Mistake Leaves a Story`} description={SITE_DESCRIPTION} />
		<script type="application/ld+json" set:html={JSON.stringify({
			"@context": "https://schema.org",
			"@type": "WebSite",
			"name": "ErrorLedger",
			"url": "https://errorledger.com",
			"description": "An archive of human, corporate, and technological failures. Real disasters, strange decisions, and unbelievable consequences.",
			"potentialAction": {
				"@type": "SearchAction",
				"target": {
					"@type": "EntryPoint",
					"urlTemplate": "https://errorledger.com/search?q={search_term_string}"
				},
				"query-input": "required name=search_term_string"
			}
		})} />
		<style>
			main { width: 1000px; max-width: calc(100% - 2rem); margin: 0 auto; padding: 2em 1rem; }
			
			.hero { text-align: center; margin-bottom: 3.5rem; padding: 2rem 0; }
			.hero h1 { font-size: 3rem; margin-bottom: 0.75rem; letter-spacing: -0.03em; color: #f5f5f5; font-weight: 800; line-height: 1.15; }
			.hero h1 span { background: linear-gradient(135deg, #f43f5e, #fb7185); -webkit-background-clip: text; -webkit-text-fill-color: transparent; }
			.hero p { font-size: 1.25rem; color: #a3a3a3; max-width: 680px; margin: 0 auto 2rem auto; line-height: 1.6; }

			.featured-box {
				background: #171717;
				border: 1px solid #262626;
				border-radius: 16px;
				padding: 2rem;
				margin-bottom: 3.5rem;
				box-shadow: 0 10px 30px rgba(0, 0, 0, 0.4);
				transition: border-color 0.2s ease, transform 0.2s ease;
			}
			.featured-box:hover {
				border-color: #f43f5e;
				transform: translateY(-2px);
			}

			.section-header {
				display: flex;
				justify-content: space-between;
				align-items: center;
				margin-bottom: 1.75rem;
				padding-bottom: 0.75rem;
				border-bottom: 1px solid #262626;
			}
			.section-title {
				font-size: 1.25rem;
				font-weight: 800;
				color: #f5f5f5;
				text-transform: uppercase;
				letter-spacing: 0.05em;
				font-family: ui-monospace, monospace;
			}

			.grid-posts {
				display: grid;
				grid-template-columns: 1fr;
				gap: 1.5rem;
			}
			@media (min-width: 768px) {
				.grid-posts {
					grid-template-columns: 1fr 1fr;
				}
			}

			.card-post {
				background: #171717;
				border: 1px solid #262626;
				border-radius: 12px;
				padding: 1.5rem;
				display: flex;
				flex-direction: column;
				justify-content: space-between;
				text-decoration: none;
				transition: all 0.2s ease;
			}
			.card-post:hover {
				border-color: #f43f5e;
				transform: translateY(-2px);
				box-shadow: 0 4px 20px rgba(244, 63, 94, 0.1);
			}

			.debates-grid {
				display: grid;
				grid-template-columns: 1fr;
				gap: 1rem;
				margin-bottom: 3.5rem;
			}
			@media (min-width: 768px) {
				.debates-grid {
					grid-template-columns: 1fr 1fr 1fr;
				}
			}
			.debate-card {
				background: #171717;
				border: 1px solid #262626;
				border-radius: 12px;
				padding: 1.25rem;
				display: flex;
				flex-direction: column;
				justify-content: space-between;
				text-decoration: none;
				transition: all 0.2s ease;
			}
			.debate-card:hover {
				border-color: #f59e0b;
				transform: translateY(-2px);
			}

			.manifesto-box {
				background: #171717;
				border: 1px solid #262626;
				border-left: 4px solid #f43f5e;
				border-radius: 12px;
				padding: 2rem;
				margin-top: 4rem;
			}
		</style>
	</head>
	<body class="bg-neutral-950 text-neutral-200 antialiased min-h-screen">
		<Header />
		<main>
			<section class="hero">
				<div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-red-500/10 border border-red-500/20 text-red-400 text-xs font-mono font-bold uppercase tracking-wider mb-4">
					The Human Failure Engine
				</div>
				<h1>Every Mistake<br/><span>Leaves a Story.</span></h1>
				<p>Real failures. Strange decisions. Unbelievable consequences. An investigative archive exploring what happens when human psychology and complex systems collide.</p>
				
				<div class="flex items-center justify-center gap-3 flex-wrap">
					<button class="px-5 py-2.5 rounded-xl bg-rose-600 hover:bg-rose-500 text-white font-bold text-sm shadow-lg shadow-rose-600/30 transition-all cursor-pointer" data-open-submit-modal>
						+ Submit an Incident
					</button>
					<a href="/blog" class="px-5 py-2.5 rounded-xl bg-neutral-900 hover:bg-neutral-800 border border-neutral-800 text-neutral-300 font-bold text-sm transition-all no-underline">
						Explore Full Archive →
					</a>
				</div>
			</section>

			<!-- Lead Incident Hero Card -->
			{featuredPost && (
				<section>
					<div class="section-header">
						<span class="section-title">⚡ The Lead Investigation</span>
						<span class="text-xs font-mono text-neutral-400">Featured Case File</span>
					</div>
					<a href={`/blog/${featuredPost.data.shortenedSlug || featuredPost.slug}`} class="block no-underline">
						<div class="featured-box">
							<div class="flex items-center gap-2 mb-3">
								<span class="px-2.5 py-0.5 rounded bg-red-500/10 text-red-400 border border-red-500/20 text-xs font-mono font-bold uppercase">
									{categoryIcons[featuredPost.data.category] || featuredPost.data.category}
								</span>
								<span class="text-neutral-500 text-xs font-mono">•</span>
								<span class="text-xs font-mono text-neutral-400">⏱️ {featuredPost.data.read_time_minutes || 6} min read</span>
							</div>
							<h2 class="text-2xl md:text-3xl font-extrabold text-neutral-100 mb-3 hover:text-rose-400 transition-colors">
								{featuredPost.data.title}
							</h2>
							{featuredPost.data.subtitle && (
								<p class="text-neutral-400 text-base mb-4 font-normal">
									{featuredPost.data.subtitle}
								</p>
							)}
							<p class="text-neutral-300 text-sm leading-relaxed mb-6">
								{featuredPost.data.description}
							</p>
							<div class="flex items-center justify-between pt-4 border-t border-neutral-800 text-xs font-mono text-neutral-400">
								<span>Verified: {featuredPost.data.provenance_label || "Documented Incident"}</span>
								<span class="text-rose-400 font-bold">Open Incident File →</span>
							</div>
						</div>
					</a>
				</section>
			)}

			<!-- Interactive Feature 2: Most Debated Failures Leaderboard -->
			<section>
				<div class="section-header">
					<span class="section-title">⚖️ Most Debated Verdicts</span>
					<span class="text-xs font-mono text-amber-400">Divided Community Consensus</span>
				</div>
				<div class="debates-grid">
					{topDebates.map((item) => (
						<a href={`/blog/${item.slug}`} class="debate-card">
							<div>
								<div class="flex items-center justify-between text-xs font-mono text-neutral-500 mb-2">
									<span class="uppercase font-bold text-amber-400">{item.category}</span>
									<span>{item.votes}</span>
								</div>
								<h4 class="text-sm font-bold text-neutral-100 mb-3 leading-snug hover:text-amber-400 transition-colors">
									{item.title}
								</h4>
							</div>
							<div class="pt-3 border-t border-neutral-800 text-xs font-mono text-neutral-400">
								<div class="text-[11px] text-neutral-500 mb-1">Current Split:</div>
								<div class="text-neutral-300 font-semibold truncate">{item.split}</div>
							</div>
						</a>
					))}
				</div>
			</section>

			<!-- The Ledger Grid -->
			{recentPosts.length > 0 && (
				<section class="mb-16">
					<div class="section-header">
						<span class="section-title">📂 The Ledger Archive</span>
						<span class="text-xs font-mono text-neutral-400">{posts.length} Documented Records</span>
					</div>
					<div class="grid-posts">
						{recentPosts.map((post) => (
							<a href={`/blog/${post.data.shortenedSlug || post.slug}`} class="card-post">
								<div>
									<div class="flex items-center gap-2 mb-2">
										<span class="px-2 py-0.5 rounded bg-neutral-900 text-neutral-300 border border-neutral-800 text-xs font-mono font-medium">
											{categoryIcons[post.data.category] || post.data.category}
										</span>
										<span class="text-xs font-mono text-neutral-500">⏱️ {post.data.read_time_minutes || 5}m</span>
									</div>
									<h3 class="text-lg font-bold text-neutral-100 mb-2 leading-snug hover:text-rose-400 transition-colors">
										{post.data.title}
									</h3>
									<p class="text-xs text-neutral-400 line-clamp-3 mb-4 leading-relaxed">
										{post.data.description}
									</p>
								</div>
								<div class="flex items-center justify-between pt-3 border-t border-neutral-800/80 text-xs font-mono text-neutral-500">
									<FormattedDate date={post.data.pubDate || new Date()} />
									<span class="text-rose-400">Read Story →</span>
								</div>
							</a>
						))}
					</div>
				</section>
			)}

			<section class="manifesto-box">
				<div class="flex items-center gap-2 text-xs font-mono text-rose-400 font-bold uppercase tracking-wider mb-2">
					<span>The ErrorLedger Ethos</span>
				</div>
				<h3 class="text-xl font-bold text-neutral-100 mb-3">AI answers questions. We tell you what happened.</h3>
				<p class="text-sm text-neutral-400 leading-relaxed mb-4">
					Every entry in the Ledger is an investigation into the real mechanics of failure. We deconstruct the psychology of bad decisions, the systemic traps of corporate bureaucracy, and the moments where human rationalization met catastrophic reality.
				</p>
				<div class="grid grid-cols-1 md:grid-cols-3 gap-4 pt-4 border-t border-neutral-800 text-xs font-mono text-neutral-300">
					<div>✓ <strong>Strict Provenance:</strong> Clear demarcation between documented records and reconstructions.</div>
					<div>✓ <strong>The Archivist’s Verdict:</strong> Systemic root-cause analysis beyond superficial blame.</div>
					<div>✓ <strong>Reader Judgment:</strong> Real community voting on moral and operational responsibility.</div>
				</div>
			</section>
		</main>
		<Footer />
	</body>
</html>