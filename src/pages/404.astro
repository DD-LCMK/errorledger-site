---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';
---

<!doctype html>
<html lang="en" class="dark">
  <head>
    <BaseHead title={`404 - Level Not Found | ${SITE_TITLE}`} description={SITE_DESCRIPTION} />
  </head>
  <body class="arcade-404-body">
    <Header />

    <main class="arcade-404-main">
      <div class="box-404">
        <div class="icon-404">👾</div>
        <h1>GAME OVER (404)</h1>
        <p class="msg-404">Target stage not found. The level you are trying to load does not exist or has been warped to another dimension.</p>
        
        <div class="recommendations">
          <span>RECOMMENDED WARP DESTINATIONS:</span>
          <div class="links-row">
            <a href="/games/marble-roulette" class="btn-warp">🔮 Marble Roulette</a>
            <a href="/games/roulette" class="btn-warp">🎡 Roulette</a>
            <a href="/" class="btn-home">🏠 Arcade Lobby</a>
          </div>
        </div>
      </div>
    </main>

    <Footer />
  </body>
</html>

<style>
  .arcade-404-body {
    background: #090d16 !important;
    color: #f1f5f9 !important;
    min-height: 100vh;
    display: flex;
    flex-direction: column;
  }

  .arcade-404-main {
    flex: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 3rem 1.5rem;
  }

  .box-404 {
    background: #0f172a;
    border: 2px solid rgba(239, 68, 68, 0.4);
    border-radius: 16px;
    padding: 3rem 2rem;
    text-align: center;
    max-width: 520px;
    box-shadow: 0 0 35px rgba(239, 68, 68, 0.2);
  }

  .icon-404 {
    font-size: 3.5rem;
    margin-bottom: 0.5rem;
  }

  h1 {
    font-size: 2rem;
    font-weight: 900;
    color: #ef4444;
    letter-spacing: 0.05em;
    margin: 0 0 0.75rem;
  }

  .msg-404 {
    color: #94a3b8;
    font-size: 0.95rem;
    line-height: 1.6;
    margin: 0 0 2rem;
  }

  .recommendations span {
    display: block;
    font-size: 0.75rem;
    font-weight: 800;
    color: #64748b;
    letter-spacing: 0.05em;
    margin-bottom: 0.75rem;
  }

  .links-row {
    display: flex;
    gap: 0.6rem;
    justify-content: center;
    flex-wrap: wrap;
  }

  .btn-warp {
    background: rgba(168, 85, 247, 0.18);
    color: #e9d5ff;
    border: 1px solid rgba(168, 85, 247, 0.35);
    padding: 0.5rem 1rem;
    border-radius: 8px;
    text-decoration: none;
    font-weight: 700;
    font-size: 0.85rem;
    transition: all 0.15s ease;
  }

  .btn-warp:hover {
    background: rgba(168, 85, 247, 0.35);
    color: #ffffff;
    transform: scale(1.05);
  }

  .btn-home {
    background: rgba(56, 189, 248, 0.18);
    color: #38bdf8;
    border: 1px solid rgba(56, 189, 248, 0.35);
    padding: 0.5rem 1rem;
    border-radius: 8px;
    text-decoration: none;
    font-weight: 700;
    font-size: 0.85rem;
    transition: all 0.15s ease;
  }

  .btn-home:hover {
    background: rgba(56, 189, 248, 0.35);
    color: #ffffff;
    transform: scale(1.05);
  }
</style>