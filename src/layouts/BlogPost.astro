---
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import ProvenanceBadge from '../components/ProvenanceBadge.astro';
import ReaderVerdict from '../components/ReaderVerdict.astro';
import AudioDispatch from '../components/AudioDispatch.astro';
import ThematicDossier from '../components/ThematicDossier.astro';
import { getCollection } from 'astro:content';

type Props = CollectionEntry<'blog'>['data'] & { body?: string };

const {
	title,
	subtitle,
	meta_title,
	description,
	pubDate,
	incidentDate,
	tags = [],
	category = 'corporate',
	archetype = 'the-incident',
	provenance_tier = 1,
	provenance_label,
	provenance_source,
	archivist_summary,
	verdict_question,
	verdict_options,
	read_time_minutes,
	heroImage,
	slug = "entry"
} = Astro.props;

const rawContent = Astro.props.body || '';
const wordCount = rawContent.split(/\s+/).filter(Boolean).length;
const calculatedReadTime = Math.max(1, Math.ceil(wordCount / 200));
const displayReadTime = read_time_minutes || calculatedReadTime;

const seoTitle = meta_title || title;
const cleanPathname = Astro.url.pathname.replace(/\.html$/, '').replace(/\/$/, '');
const cleanUrl = new URL(cleanPathname || '/', Astro.site).href;

const schemaData = {
	"@context": "https://schema.org",
	"@type": "NewsArticle",
	"headline": title,
	"description": description,
	"datePublished": pubDate ? new Date(pubDate).toISOString() : new Date().toISOString(),
	"dateModified": pubDate ? new Date(pubDate).toISOString() : new Date().toISOString(),
	"url": cleanUrl,
	"wordCount": wordCount,
	"timeRequired": `PT${displayReadTime}M`,
	"articleSection": category,
	"image": [
		new URL(heroImage || '/images/default-social-card.png', Astro.site).href
	],
	"author": {
		"@type": "Person",
		"name": "The Archivist",
		"url": "https://errorledger.com/about"
	},
	"publisher": {
		"@type": "Organization",
		"name": "ErrorLedger",
		"url": "https://errorledger.com",
		"logo": {
			"@type": "ImageObject",
			"url": "https://errorledger.com/favicon.svg"
		}
	}
};

const postBreadcrumb = [
	{ name: 'Home', url: 'https://errorledger.com' },
	{ name: 'Ledger', url: 'https://errorledger.com/blog' },
	{ name: seoTitle }
];

const allPosts = await getCollection('blog');
const sortedPosts = allPosts.sort((a, b) => {
	const dateA = a.data.pubDate ? new Date(a.data.pubDate).valueOf() : 0;
	const dateB = b.data.pubDate ? new Date(b.data.pubDate).valueOf() : 0;
	return dateB - dateA;
});

const currentIndex = sortedPosts.findIndex(post => post.data.title === title);
const nextPost = currentIndex > 0 ? sortedPosts[currentIndex - 1] : null;
const prevPost = currentIndex < sortedPosts.length - 1 ? sortedPosts[currentIndex + 1] : null;

const lowercaseTags = tags.map((tag: string) => tag.toLowerCase());
const isStaticPage = 
	lowercaseTags.includes('meta') || 
	lowercaseTags.includes('contact') || 
	lowercaseTags.includes('privacy') || 
	lowercaseTags.includes('about') ||
	title.toLowerCase().includes('privacy') ||
	title.toLowerCase().includes('about') ||
	title.toLowerCase().includes('contact');

const showSidebar = !isStaticPage && (nextPost || prevPost);
---

<html lang="en" class="dark">
	<head>
		<BaseHead title={seoTitle} description={description} image={heroImage} type="article" breadcrumb={postBreadcrumb} />
		<script type="application/ld+json" set:html={JSON.stringify(schemaData)} />
		<style>
			main { width: calc(100% - 2rem); max-width: 900px; margin: 0 auto; padding: 2em 1rem 6rem 1rem; }
			
			.post-layout-grid {
				display: grid;
				grid-template-columns: 1fr;
				gap: 3rem;
				align-items: start;
			}

			@media (min-width: 1024px) {
				.post-layout-grid.has-sidebar {
					grid-template-columns: 1fr 260px;
				}
				.post-layout-grid.has-sidebar > article {
					min-width: 0;
				}
			}

			.sidebar-wrapper {
				display: none;
			}
			@media (min-width: 1024px) {
				.post-layout-grid.has-sidebar .sidebar-wrapper {
					display: block;
					position: sticky;
					top: 5.5rem;
					height: fit-content;
					max-height: calc(100vh - 7rem);
					overflow-y: auto;
					background: #171717;
					border: 1px solid #262626;
					border-radius: 12px;
					padding: 1.25rem;
				}
			}

			.nav-node-link {
				display: block;
				text-decoration: none;
			}
			.nav-node-link:not(:last-child) {
				margin-bottom: 1.25rem;
			}
			.nav-node-label {
				display: block;
				font-family: ui-monospace, monospace;
				font-size: 0.68rem;
				font-weight: 700;
				color: #a3a3a3;
				text-transform: uppercase;
				margin-bottom: 0.25rem;
				letter-spacing: 0.025em;
			}
			.nav-node-title {
				display: block;
				font-size: 0.85rem;
				color: #e5e5e5;
				line-height: 1.4;
				font-weight: 600;
				transition: color 0.15s ease;
			}
			.nav-node-link:hover .nav-node-title { color: #f43f5e !important; }

			.prose { color: #d4d4d4; line-height: 1.85; font-size: 1.15rem; font-family: ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif; }
			.prose h1 { font-size: 2.3em; margin-top: 0; margin-bottom: 0.4em; color: #f5f5f5; line-height: 1.2; font-weight: 800; letter-spacing: -0.025em; }
			.article-subtitle { font-size: 1.25rem; color: #a3a3a3; line-height: 1.5; margin-bottom: 1.5rem; font-weight: 400; }
			.prose h2 { font-size: 1.6em; margin-top: 2em; margin-bottom: 0.75em; color: #fafafa; font-weight: 700; border-bottom: 1px solid #262626; padding-bottom: 0.4em; letter-spacing: -0.015em; }
			.prose :global(h3) { font-size: 1.3em; margin-top: 1.5em; margin-bottom: 0.5em; color: #f5f5f5; font-weight: 700; }
			.prose :global(p) { margin-bottom: 1.5rem; }
			
			.prose :global(blockquote) {
				background: #171717;
				border-left: 4px solid #f43f5e;
				border-radius: 8px;
				padding: 1.5rem;
				margin: 2rem 0;
				color: #e5e5e5;
				font-style: normal;
			}

			.meta-wrapper { display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.5rem; padding-bottom: 1rem; border-bottom: 1px dashed #262626; flex-wrap: wrap; gap: 1rem; }
			.date-info { color: #a3a3a3; font-size: 0.85rem; display: flex; align-items: center; gap: 0.5rem; flex-wrap: wrap; }
			.share-actions { display: flex; gap: 0.5rem; }
			.share-btn { background: #171717; border: 1px solid #262626; padding: 0.4rem 0.75rem; border-radius: 6px; font-size: 0.85rem; cursor: pointer; display: inline-flex; align-items: center; gap: 0.25rem; color: #d4d4d4; text-decoration: none; font-weight: 500; }
			.share-btn:hover { background: #262626; color: #ffffff; }

			.tag-container { display: flex; gap: 0.5rem; margin-bottom: 2rem; flex-wrap: wrap; }
			.badge-tag { background: #171717; border: 1px solid #262626; color: #a3a3a3; font-size: 0.75rem; padding: 0.25rem 0.65rem; border-radius: 6px; text-decoration: none; font-family: ui-monospace, monospace; }
			.badge-tag:hover { color: #f43f5e; border-color: #f43f5e; }

			/* Floating Action Bar */
			.floating-action-bar {
				position: fixed;
				bottom: 1.5rem;
				left: 50%;
				transform: translateX(-50%) translateY(100px);
				z-index: 40;
				background: rgba(23, 23, 23, 0.9);
				backdrop-filter: blur(16px);
				-webkit-backdrop-filter: blur(16px);
				border: 1px solid #333333;
				box-shadow: 0 10px 35px rgba(0, 0, 0, 0.6);
				border-radius: 9999px;
				padding: 0.4rem 0.75rem;
				display: flex;
				align-items: center;
				gap: 0.5rem;
				transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1);
			}
			.floating-action-bar.visible {
				transform: translateX(-50%) translateY(0);
			}
			.float-btn {
				background: transparent;
				border: none;
				color: #e5e5e5;
				font-size: 0.82rem;
				font-weight: 600;
				padding: 0.4rem 0.85rem;
				border-radius: 9999px;
				cursor: pointer;
				display: inline-flex;
				align-items: center;
				gap: 0.35rem;
				transition: all 0.15s ease;
				text-decoration: none;
			}
			.float-btn:hover {
				background: #262626;
				color: #ffffff;
			}
			.float-btn-primary {
				background: #f43f5e;
				color: #ffffff;
			}
			.float-btn-primary:hover {
				background: #fb7185;
			}
		</style>
	</head>

	<body class="bg-neutral-950 text-neutral-200 antialiased min-h-screen">
		<Header />
		<main>
			<div class={showSidebar ? "post-layout-grid has-sidebar" : "post-layout-grid"}>
				<article>
					<div class="prose">
						{!isStaticPage && (
							<>
								<div class="meta-wrapper">
									<div class="date-info font-mono">
										<span class="px-2 py-0.5 rounded bg-red-500/10 text-red-400 border border-red-500/20 uppercase text-xs font-bold">
											{category}
										</span>
										<span>•</span>
										{pubDate && (
											<span><FormattedDate date={pubDate} /></span>
										)}
										<span>•</span>
										<span>⏱️ {displayReadTime} min read</span>
									</div>

									<div class="share-actions">
										<a href={`https://x.com/intent/tweet?url=${encodeURIComponent(cleanUrl)}&text=${encodeURIComponent(title)}`} target="_blank" rel="noopener noreferrer" class="share-btn">
											Share on X
										</a>
										<button id="copy-link-btn" class="share-btn">
											Copy Link
										</button>
									</div>
								</div>

								<h1>{title}</h1>
								{subtitle && <p class="article-subtitle">{subtitle}</p>}

								<ProvenanceBadge
									tier={provenance_tier}
									label={provenance_label}
									source={provenance_source}
								/>

								<!-- Interactive Feature 3: Simulated Audio Dispatch Player -->
								<AudioDispatch title={title} duration={`${displayReadTime - 2 || 3}:45`} />
							</>
						)}

						<slot />

						{!isStaticPage && (
							<>
								<!-- Interactive Feature 7: Reader Verdict Poll -->
								<div id="verdict-anchor">
									<ReaderVerdict
										question={verdict_question}
										options={verdict_options}
										slug={slug}
									/>
								</div>

								<!-- Interactive Feature 4: Thematic Dossier Clusters -->
								<ThematicDossier />

								{tags.length > 0 && (
									<div class="tag-container mt-8 pt-6 border-t border-neutral-800">
										{tags.map((tag) => (
											<a href={`/search?q=${encodeURIComponent(tag.toLowerCase())}`} class="badge-tag">
												#{tag}
											</a>
										))}
									</div>
								)}
							</>
						)}
					</div>
				</article>

				{showSidebar && (
					<aside class="sidebar-wrapper">
						<div class="text-xs font-mono font-bold uppercase text-neutral-400 mb-4 pb-2 border-b border-neutral-800">
							Archive Trajectory
						</div>
						{nextPost && (
							<a href={`/blog/${nextPost.data.shortenedSlug || nextPost.slug}`} class="nav-node-link">
								<span class="nav-node-label">← Next Record</span>
								<span class="nav-node-title">{nextPost.data.title}</span>
							</a>
						)}
						
						{prevPost && (
							<a href={`/blog/${prevPost.data.shortenedSlug || prevPost.slug}`} class="nav-node-link">
								<span class="nav-node-label">Previous Record →</span>
								<span class="nav-node-title">{prevPost.data.title}</span>
							</a>
						)}
					</aside>
				)}
			</div>
		</main>

		<!-- Interactive Feature 7: Floating Smart Action Bar -->
		{!isStaticPage && (
			<div id="floating-bar" class="floating-action-bar">
				<a href="#verdict-anchor" class="float-btn float-btn-primary">
					<span>🗳️</span> Cast Vote
				</a>
				<button id="float-random-btn" class="float-btn">
					<span>🎲</span> Next Case
				</button>
				<button id="float-share-btn" class="float-btn">
					<span>🔗</span> Share
				</button>
			</div>
		)}

		<Footer />

		<script>
			const copyBtn = document.getElementById('copy-link-btn');
			const floatShareBtn = document.getElementById('float-share-btn');
			const floatBar = document.getElementById('floating-bar');
			const floatRandomBtn = document.getElementById('float-random-btn');

			function copyCurrentUrl() {
				navigator.clipboard.writeText(window.location.href);
				alert('Receipt link copied to clipboard!');
			}

			copyBtn?.addEventListener('click', copyCurrentUrl);
			floatShareBtn?.addEventListener('click', copyCurrentUrl);

			floatRandomBtn?.addEventListener('click', () => {
				window.location.href = '/blog';
			});

			window.addEventListener('scroll', () => {
				const scrollY = window.scrollY;
				const docHeight = document.documentElement.scrollHeight - window.innerHeight;
				if (docHeight > 0 && scrollY / docHeight > 0.25) {
					floatBar?.classList.add('visible');
				} else {
					floatBar?.classList.remove('visible');
				}
			});
		</script>
	</body>
</html>