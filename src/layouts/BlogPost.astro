---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import ProvenanceBadge from '../components/ProvenanceBadge.astro';
import AudioDispatch from '../components/AudioDispatch.astro';
import ThematicDossier from '../components/ThematicDossier.astro';
import ReaderVerdict from '../components/ReaderVerdict.astro';
import { SITE_TITLE } from '../consts';
import { getCollection } from 'astro:content';

interface Props {
	title: string;
	subtitle?: string;
	description: string;
	pubDate?: Date;
	updatedDate?: Date;
	heroImage?: string;
	category?: string;
	lang?: string;
	slug?: string;
	tags?: string[];
	read_time_minutes?: number;
	meta_title?: string;
	provenance_tier?: number;
	provenance_label?: string;
	provenance_source?: string;
	archivist_summary?: string;
	verdict_question?: string;
	verdict_options?: Array<{ id: string; label: string }>;
	archetype?: string;
}

const {
	title,
	subtitle,
	description,
	pubDate,
	heroImage = "/blog-placeholder-about.jpg",
	category = "corporate",
	lang = "en",
	slug = "",
	tags = [],
	read_time_minutes = 6,
	meta_title,
	provenance_tier = 1,
	provenance_label = "Documented Incident",
	provenance_source = "Court Filings & Public Records",
	verdict_question = "Who was primarily responsible for this disaster?",
	verdict_options = [
		{ id: "option_a", label: "Executive Leadership (Flawed Culture & Cost-Cutting)" },
		{ id: "option_b", label: "Engineering & QA (Inadequate Testing & Oversight)" },
		{ id: "option_c", label: "Systemic Complexity (No Single Actor to Blame)" },
		{ id: "option_d", label: "Shared Responsibility Across the Entire Organization" }
	]
} = Astro.props;

const isKorean = lang === 'ko';
const seoTitle = meta_title || `${title} | ${SITE_TITLE}`;
const cleanSlug = slug.replace(/^ko\//, '');
const displayReadTime = read_time_minutes || 6;

const cleanUrl = isKorean ? `https://errorledger.com/ko/blog/${cleanSlug}` : `https://errorledger.com/blog/${cleanSlug}`;
const alternateUrl = isKorean ? `/blog/${cleanSlug}` : `/ko/blog/${cleanSlug}`;
const alternateLabel = isKorean ? '🇺🇸 English' : '🇰🇷 한국어';

const schemaData = {
	"@context": "https://schema.org",
	"@type": "NewsArticle",
	"headline": title,
	"description": description,
	"image": [heroImage],
	"datePublished": pubDate ? pubDate.toISOString() : new Date().toISOString(),
	"author": [{
		"@type": "Person",
		"name": "The Archivist",
		"jobTitle": "Lead Investigative Editor",
		"url": "https://errorledger.com/about"
	}],
	"publisher": {
		"@type": "Organization",
		"name": "ErrorLedger",
		"logo": {
			"@type": "ImageObject",
			"url": "https://errorledger.com/favicon.svg"
		}
	}
};

const postBreadcrumb = [
	{ name: 'Home', url: isKorean ? 'https://errorledger.com/ko' : 'https://errorledger.com' },
	{ name: 'Ledger', url: isKorean ? 'https://errorledger.com/ko/blog' : 'https://errorledger.com/blog' },
	{ name: seoTitle }
];

const allPosts = await getCollection('blog');
const sameLangPosts = allPosts
	.filter(p => (p.data.lang || 'en') === lang)
	.sort((a, b) => {
		const dateA = a.data.pubDate ? new Date(a.data.pubDate).valueOf() : 0;
		const dateB = b.data.pubDate ? new Date(b.data.pubDate).valueOf() : 0;
		return dateB - dateA;
	});

const currentIndex = sameLangPosts.findIndex(post => post.data.title === title);
const nextPost = currentIndex > 0 ? sameLangPosts[currentIndex - 1] : null;
const prevPost = currentIndex < sameLangPosts.length - 1 ? sameLangPosts[currentIndex + 1] : null;

const lowercaseTags = tags.map((tag: string) => tag.toLowerCase());
const isStaticPage = 
	lowercaseTags.includes('meta') || 
	lowercaseTags.includes('contact') || 
	lowercaseTags.includes('privacy') || 
	lowercaseTags.includes('about') ||
	title.toLowerCase().includes('privacy') ||
	title.toLowerCase().includes('about') ||
	title.toLowerCase().includes('contact');

const showSidebar = !isStaticPage;

const categoryCounts: Record<string, number> = {
	all: sameLangPosts.length,
	corporate: sameLangPosts.filter(p => p.data.category === 'corporate').length,
	money: sameLangPosts.filter(p => p.data.category === 'money').length,
	work: sameLangPosts.filter(p => p.data.category === 'work').length,
	ai: sameLangPosts.filter(p => p.data.category === 'ai').length,
	internet: sameLangPosts.filter(p => p.data.category === 'internet').length,
	relationships: sameLangPosts.filter(p => p.data.category === 'relationships').length,
	human: sameLangPosts.filter(p => p.data.category === 'human').length,
};

const categories = [
	{ id: "all", label: isKorean ? "전체 사건 목록" : "All Incidents", icon: "⚡" },
	{ id: "corporate", label: isKorean ? "기업 & 인프라" : "Corporate & Systems", icon: "🏢" },
	{ id: "money", label: isKorean ? "금융 & 경제" : "Money & Finance", icon: "💰" },
	{ id: "work", label: isKorean ? "직장 & 커리어" : "Work & Career", icon: "🧑‍💻" },
	{ id: "ai", label: isKorean ? "AI & 자동화" : "AI & Automation", icon: "🤖" },
	{ id: "internet", label: isKorean ? "인터넷 & 사회" : "Internet & Social", icon: "🌐" },
	{ id: "relationships", label: isKorean ? "인간관계" : "Relationships", icon: "❤️" },
	{ id: "human", label: isKorean ? "심리 & 인지 편향" : "Human Psychology", icon: "🧠" },
];
---

<html lang={lang} class="dark">
	<head>
		<BaseHead title={seoTitle} description={description} image={heroImage} type="article" breadcrumb={postBreadcrumb} />
		<script type="application/ld+json" set:html={JSON.stringify(schemaData)} />
		<style>
			main { width: 1180px; max-width: calc(100% - 2rem); margin: 0 auto; padding: 2em 1rem 6rem 1rem; }
			
			.post-layout-grid {
				display: grid;
				grid-template-columns: 1fr;
				gap: 2.5rem;
				align-items: start;
				width: 100%;
				min-width: 0;
			}

			@media (min-width: 1024px) {
				.post-layout-grid.has-sidebar {
					grid-template-columns: 250px minmax(0, 1fr);
				}
			}

			/* Left Sticky Navigation Rail */
			.sidebar-wrapper {
				display: none;
			}
			@media (min-width: 1024px) {
				.post-layout-grid.has-sidebar .sidebar-wrapper {
					display: block;
					position: sticky;
					top: 5.5rem;
					height: fit-content;
					max-height: calc(100vh - 7rem);
					overflow-y: auto;
					background: #171717;
					border: 1px solid #262626;
					border-radius: 16px;
					padding: 1.25rem;
					min-width: 0;
					box-sizing: border-box;
				}
			}

			.sidebar-heading {
				font-family: ui-monospace, monospace;
				font-size: 0.75rem;
				font-weight: 700;
				text-transform: uppercase;
				color: #a3a3a3;
				letter-spacing: 0.05em;
				margin-bottom: 0.85rem;
				padding-bottom: 0.4rem;
				border-bottom: 1px solid #262626;
				display: flex;
				justify-content: space-between;
				align-items: center;
			}

			.trajectory-box {
				margin-bottom: 1.5rem;
				display: flex;
				flex-direction: column;
				gap: 0.75rem;
			}

			.nav-node-link {
				display: block;
				text-decoration: none;
				padding: 0.5rem 0.65rem;
				border-radius: 8px;
				background: #0a0a0a;
				border: 1px solid #262626;
				transition: all 0.15s ease;
			}
			.nav-node-link:hover {
				border-color: #f43f5e;
				background: #262626;
			}

			.nav-node-label {
				display: block;
				font-family: ui-monospace, monospace;
				font-size: 0.68rem;
				font-weight: 700;
				color: #f43f5e;
				text-transform: uppercase;
				margin-bottom: 0.2rem;
				letter-spacing: 0.025em;
			}
			.nav-node-title {
				display: block;
				font-size: 0.82rem;
				color: #e5e5e5;
				line-height: 1.35;
				font-weight: 600;
				transition: color 0.15s ease;
			}
			.nav-node-link:hover .nav-node-title { color: #ffffff; }

			.sidebar-cat-list {
				display: flex;
				flex-direction: column;
				gap: 0.3rem;
				margin-bottom: 1.5rem;
			}

			.sidebar-cat-link {
				display: flex;
				align-items: center;
				justify-content: space-between;
				padding: 0.4rem 0.6rem;
				border-radius: 6px;
				font-size: 0.82rem;
				font-weight: 600;
				color: #d4d4d4;
				text-decoration: none;
				transition: all 0.15s ease;
			}
			.sidebar-cat-link:hover {
				background: #262626;
				color: #ffffff;
			}
			.sidebar-cat-link.active-cat {
				background: rgba(244, 63, 94, 0.12);
				color: #fb7185;
			}

			.sidebar-cat-count {
				font-family: ui-monospace, monospace;
				font-size: 0.7rem;
				background: #0a0a0a;
				color: #737373;
				padding: 0.05rem 0.4rem;
				border-radius: 9999px;
				border: 1px solid #262626;
			}

			.sidebar-dossiers {
				padding-top: 1rem;
				border-top: 1px solid #262626;
			}
			.dossier-rail-link {
				display: block;
				font-size: 0.8rem;
				color: #a3a3a3;
				text-decoration: none;
				padding: 0.3rem 0;
				transition: color 0.15s ease;
			}
			.dossier-rail-link:hover {
				color: #f59e0b;
			}

			/* Right Article Column */
			.article-container {
				min-width: 0;
				width: 100%;
			}

			.prose { color: #d4d4d4; line-height: 1.85; font-size: 1.15rem; font-family: ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Noto Sans KR", sans-serif; min-width: 0; }
			.prose h1 { font-size: 2.3em; margin-top: 0; margin-bottom: 0.4em; color: #f5f5f5; line-height: 1.25; font-weight: 800; letter-spacing: -0.025em; overflow-wrap: break-word; }
			.article-subtitle { font-size: 1.25rem; color: #a3a3a3; line-height: 1.5; margin-bottom: 1.5rem; font-weight: 400; }
			.prose h2 { font-size: 1.6em; margin-top: 2em; margin-bottom: 0.75em; color: #fafafa; font-weight: 700; border-bottom: 1px solid #262626; padding-bottom: 0.4em; letter-spacing: -0.015em; }
			.prose :global(h3) { font-size: 1.3em; margin-top: 1.5em; margin-bottom: 0.5em; color: #f5f5f5; font-weight: 700; }
			.prose :global(p) { margin-bottom: 1.5rem; }
			
			.prose :global(blockquote) {
				background: #171717;
				border-left: 4px solid #f43f5e;
				border-radius: 8px;
				padding: 1.5rem;
				margin: 2rem 0;
				color: #e5e5e5;
				font-style: normal;
			}

			.meta-wrapper { display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.5rem; padding-bottom: 1rem; border-bottom: 1px dashed #262626; flex-wrap: wrap; gap: 1rem; }
			.date-info { color: #a3a3a3; font-size: 0.85rem; display: flex; align-items: center; gap: 0.5rem; flex-wrap: wrap; font-family: ui-monospace, monospace; }
			.category-badge { padding: 0.15rem 0.5rem; border-radius: 4px; background: rgba(244, 63, 94, 0.1); color: #fb7185; border: 1px solid rgba(244, 63, 94, 0.25); text-transform: uppercase; font-size: 0.75rem; font-weight: 700; }
			
			.share-actions { display: flex; gap: 0.5rem; align-items: center; flex-wrap: wrap; }
			.lang-switch-pill {
				background: rgba(245, 158, 11, 0.12);
				border: 1px solid rgba(245, 158, 11, 0.3);
				color: #f59e0b;
				padding: 0.35rem 0.65rem;
				border-radius: 6px;
				font-size: 0.8rem;
				font-weight: 700;
				text-decoration: none;
				font-family: ui-monospace, monospace;
				transition: all 0.15s ease;
			}
			.lang-switch-pill:hover {
				background: #f59e0b;
				color: #000000;
			}

			.share-btn { background: #171717; border: 1px solid #262626; padding: 0.4rem 0.75rem; border-radius: 6px; font-size: 0.85rem; cursor: pointer; display: inline-flex; align-items: center; gap: 0.25rem; color: #d4d4d4; text-decoration: none; font-weight: 500; transition: all 0.15s ease; }
			.share-btn:hover { background: #262626; color: #ffffff; }

			.tag-container { display: flex; gap: 0.5rem; margin-top: 2rem; margin-bottom: 2rem; padding-top: 1.5rem; border-top: 1px solid #262626; flex-wrap: wrap; }
			.badge-tag { background: #171717; border: 1px solid #262626; color: #a3a3a3; font-size: 0.75rem; padding: 0.25rem 0.65rem; border-radius: 6px; text-decoration: none; font-family: ui-monospace, monospace; transition: all 0.15s ease; }
			.badge-tag:hover { color: #f43f5e; border-color: #f43f5e; }

			/* Bottom Adjacent Incident Navigation */
			.bottom-incident-nav {
				display: grid;
				grid-template-columns: 1fr;
				gap: 1rem;
				margin: 3rem 0;
				padding-top: 2rem;
				border-top: 1px solid #262626;
			}
			@media (min-width: 640px) {
				.bottom-incident-nav {
					grid-template-columns: 1fr 1fr;
				}
			}
			.incident-nav-card {
				background: #171717;
				border: 1px solid #262626;
				border-radius: 12px;
				padding: 1.25rem;
				text-decoration: none;
				display: flex;
				flex-direction: column;
				gap: 0.35rem;
				transition: all 0.15s ease;
				min-width: 0;
				box-sizing: border-box;
			}
			.incident-nav-card:hover {
				border-color: #f43f5e;
				background: #1e1e1e;
				transform: translateY(-2px);
			}
			.incident-nav-dir {
				font-family: ui-monospace, monospace;
				font-size: 0.72rem;
				font-weight: 700;
				text-transform: uppercase;
				color: #fb7185;
			}
			.incident-nav-title {
				font-size: 0.95rem;
				font-weight: 700;
				color: #e5e5e5;
				line-height: 1.35;
			}
			.incident-nav-card:hover .incident-nav-title {
				color: #ffffff;
			}

			/* Floating Action Bar */
			.floating-action-bar {
				position: fixed;
				bottom: 1.5rem;
				left: 50%;
				transform: translateX(-50%) translateY(100px);
				z-index: 40;
				background: rgba(23, 23, 23, 0.9);
				backdrop-filter: blur(16px);
				-webkit-backdrop-filter: blur(16px);
				border: 1px solid #333333;
				box-shadow: 0 10px 35px rgba(0, 0, 0, 0.6);
				border-radius: 9999px;
				padding: 0.4rem 0.75rem;
				display: flex;
				align-items: center;
				gap: 0.5rem;
				transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1);
			}
			.floating-action-bar.visible {
				transform: translateX(-50%) translateY(0);
			}
			.float-btn {
				background: transparent;
				border: none;
				color: #e5e5e5;
				font-size: 0.82rem;
				font-weight: 600;
				padding: 0.4rem 0.85rem;
				border-radius: 9999px;
				cursor: pointer;
				display: inline-flex;
				align-items: center;
				gap: 0.35rem;
				transition: all 0.15s ease;
				text-decoration: none;
			}
			.float-btn:hover {
				background: #262626;
				color: #ffffff;
			}
			.float-btn-primary {
				background: #f43f5e;
				color: #ffffff;
			}
			.float-btn-primary:hover {
				background: #fb7185;
			}

			/* Light Mode Global Styles */
			:global(html:not(.dark)) body {
				background: #ffffff;
				color: #1e293b;
			}
			:global(html:not(.dark)) .prose {
				color: #334155;
			}
			:global(html:not(.dark)) .prose h1,
			:global(html:not(.dark)) .prose h2,
			:global(html:not(.dark)) .prose :global(h3),
			:global(html:not(.dark)) .prose :global(h4) {
				color: #0f172a !important;
			}
			:global(html:not(.dark)) .article-subtitle {
				color: #64748b !important;
			}
			:global(html:not(.dark)) .prose :global(blockquote) {
				background: #f8fafc !important;
				border-left-color: #f43f5e !important;
				color: #1e293b !important;
			}
			:global(html:not(.dark)) .post-layout-grid.has-sidebar .sidebar-wrapper,
			:global(html:not(.dark)) .sidebar-wrapper {
				background: #ffffff !important;
				border-color: #e2e8f0 !important;
				box-shadow: 0 4px 20px rgba(0, 0, 0, 0.05) !important;
			}
			:global(html:not(.dark)) .sidebar-heading {
				color: #64748b !important;
				border-bottom-color: #e2e8f0 !important;
			}
			:global(html:not(.dark)) .nav-node-link {
				background: #f8fafc !important;
				border-color: #e2e8f0 !important;
			}
			:global(html:not(.dark)) .nav-node-link:hover {
				background: #ffffff !important;
			}
			:global(html:not(.dark)) .nav-node-title {
				color: #0f172a !important;
			}
			:global(html:not(.dark)) .nav-node-link:hover .nav-node-title {
				color: #f43f5e !important;
			}
			:global(html:not(.dark)) .sidebar-cat-link {
				color: #334155 !important;
			}
			:global(html:not(.dark)) .sidebar-cat-link:hover {
				background: #f1f5f9 !important;
				color: #0f172a !important;
			}
			:global(html:not(.dark)) .sidebar-cat-count {
				background: #ffffff !important;
				border-color: #cbd5e1 !important;
				color: #475569 !important;
			}
			:global(html:not(.dark)) .dossier-rail-link {
				color: #475569 !important;
			}
			:global(html:not(.dark)) .dossier-rail-link:hover {
				color: #d97706 !important;
			}
			:global(html:not(.dark)) .incident-nav-card {
				background: #ffffff !important;
				border-color: #e2e8f0 !important;
				box-shadow: 0 4px 15px rgba(0, 0, 0, 0.04) !important;
			}
			:global(html:not(.dark)) .incident-nav-title {
				color: #0f172a !important;
			}
			:global(html:not(.dark)) .incident-nav-card:hover {
				background: #f1f5f9 !important;
			}
			:global(html:not(.dark)) .share-btn,
			:global(html:not(.dark)) .badge-tag {
				background: #f8fafc !important;
				border-color: #cbd5e1 !important;
				color: #475569 !important;
			}
			:global(html:not(.dark)) .share-btn:hover,
			:global(html:not(.dark)) .badge-tag:hover {
				background: #e2e8f0 !important;
				color: #0f172a !important;
			}
			:global(html:not(.dark)) .floating-action-bar {
				background: rgba(255, 255, 255, 0.95) !important;
				border-color: #cbd5e1 !important;
				box-shadow: 0 10px 30px rgba(0, 0, 0, 0.15) !important;
			}
			:global(html:not(.dark)) .float-btn {
				color: #334155 !important;
			}
			:global(html:not(.dark)) .float-btn:hover {
				background: #f1f5f9 !important;
				color: #0f172a !important;
			}
		</style>
	</head>

	<body class="bg-neutral-950 text-neutral-200 antialiased min-h-screen">
		<Header />
		<main>
			<div class={showSidebar ? "post-layout-grid has-sidebar" : "post-layout-grid"}>
				<!-- Left Sticky Rail -->
				{showSidebar && (
					<aside class="sidebar-wrapper">
						<!-- Incident Trajectory -->
						<div class="sidebar-heading">
							<span>{isKorean ? "사건 궤적" : "Trajectory"}</span>
						</div>
						<div class="trajectory-box">
							{nextPost && (
								<a href={`/${isKorean ? 'ko/blog' : 'blog'}/${nextPost.data.slug.replace(/^ko\//, '')}`} class="nav-node-link">
									<span class="nav-node-label">&larr; {isKorean ? "다음 사건" : "Next Case"}</span>
									<span class="nav-node-title">{nextPost.data.title}</span>
								</a>
							)}
							{prevPost && (
								<a href={`/${isKorean ? 'ko/blog' : 'blog'}/${prevPost.data.slug.replace(/^ko\//, '')}`} class="nav-node-link">
									<span class="nav-node-label">{isKorean ? "이전 사건" : "Previous Case"} &rarr;</span>
									<span class="nav-node-title">{prevPost.data.title}</span>
								</a>
							)}
						</div>

						<!-- Categories Navigation -->
						<div class="sidebar-heading">
							<span>{isKorean ? "카테고리" : "Categories"}</span>
							<span>{sameLangPosts.length}</span>
						</div>
						<div class="sidebar-cat-list">
							{categories.map((cat) => (
								<a 
									href={`/${isKorean ? 'ko/blog' : 'blog'}`} 
									class={`sidebar-cat-link ${category === cat.id ? 'active-cat' : ''}`}
								>
									<span>{cat.icon} {cat.label}</span>
									<span class="sidebar-cat-count">{categoryCounts[cat.id] || 0}</span>
								</a>
							))}
						</div>

						<!-- Curated Dossiers -->
						<div class="sidebar-dossiers">
							<div class="sidebar-heading" style="border: none; margin-bottom: 0.35rem; padding-bottom: 0;">
								<span>{isKorean ? "테마별 도시에" : "Curated Dossiers"}</span>
							</div>
							<a href={`/${isKorean ? 'ko/blog' : 'blog'}/deleted-production-database-blamed-intern`} class="dossier-rail-link">
								📂 {isKorean ? "사내 희생양 모음집" : "The Scapegoat Collection"}
							</a>
							<a href={`/${isKorean ? 'ko/blog' : 'blog'}/knight-capital-trading-glitch-45-minutes`} class="dossier-rail-link">
								⚡ {isKorean ? "45분 만의 파산" : "45-Minute Fast Crashes"}
							</a>
							<a href={`/${isKorean ? 'ko/blog' : 'blog'}/the-friday-update-that-broke-the-world`} class="dossier-rail-link">
								🌋 {isKorean ? "클라우드 마비 사건" : "Cloud Monoculture Failures"}
							</a>
						</div>
					</aside>
				)}

				<!-- Right Article Column -->
				<article class="article-container">
					<div class="prose">
						{!isStaticPage && (
							<>
								<div class="meta-wrapper">
									<div class="date-info">
										<span class="category-badge">
											{category}
										</span>
										<span>•</span>
										{pubDate && (
											<span><FormattedDate date={pubDate} /></span>
										)}
										<span>•</span>
										<span>⏱️ {isKorean ? `${displayReadTime}분 읽기` : `${displayReadTime} min read`}</span>
									</div>

									<div class="share-actions">
										<a href={alternateUrl} class="lang-switch-pill" title="Toggle language version">
											{alternateLabel}
										</a>
										<a href={`https://x.com/intent/tweet?url=${encodeURIComponent(cleanUrl)}&text=${encodeURIComponent(title)}`} target="_blank" rel="noopener noreferrer" class="share-btn">
											{isKorean ? "공유" : "Share"}
										</a>
										<button id="copy-link-btn" class="share-btn">
											{isKorean ? "링크 복사" : "Copy Link"}
										</button>
									</div>
								</div>

								<h1>{title}</h1>
								{subtitle && <p class="article-subtitle">{subtitle}</p>}

								<ProvenanceBadge
									tier={provenance_tier}
									label={provenance_label}
									source={provenance_source}
									lang={lang}
								/>

								<!-- Interactive Feature 3: Simulated Audio Dispatch Player -->
								<AudioDispatch title={title} duration={`${displayReadTime - 2 || 3}:45`} lang={lang} slug={cleanSlug} audioUrl={`/audio/${lang}/${cleanSlug}.mp3`} />
							</>
						)}

						<slot />

						{!isStaticPage && (
							<>
								<!-- Interactive Feature 7: Reader Verdict Poll -->
								<div id="verdict-anchor">
									<ReaderVerdict
										question={verdict_question}
										options={verdict_options}
										slug={slug}
										lang={lang}
									/>
								</div>

								<!-- Bottom Post Navigation: Previous & Next Incident -->
								<nav class="bottom-incident-nav">
									{prevPost && (
										<a href={`/${isKorean ? 'ko/blog' : 'blog'}/${prevPost.data.slug.replace(/^ko\//, '')}`} class="incident-nav-card">
											<span class="incident-nav-dir">&larr; {isKorean ? "이전 사건 기록" : "Previous Incident"}</span>
											<span class="incident-nav-title">{prevPost.data.title}</span>
										</a>
									)}
									{nextPost && (
										<a href={`/${isKorean ? 'ko/blog' : 'blog'}/${nextPost.data.slug.replace(/^ko\//, '')}`} class="incident-nav-card" style={!prevPost ? "grid-column: 1 / -1;" : ""}>
											<span class="incident-nav-dir">{isKorean ? "다음 사건 기록" : "Next Incident"} &rarr;</span>
											<span class="incident-nav-title">{nextPost.data.title}</span>
										</a>
									)}
								</nav>

								<!-- Interactive Feature 4: Thematic Dossier Clusters -->
								<ThematicDossier lang={lang} />

								{tags.length > 0 && (
									<div class="tag-container">
										{tags.map((tag) => (
											<a href={`/${isKorean ? 'ko/search' : 'search'}?q=${encodeURIComponent(tag.toLowerCase())}`} class="badge-tag">
												#{tag}
											</a>
										))}
									</div>
								)}
							</>
						)}
					</div>
				</article>
			</div>
		</main>

		<!-- Interactive Feature: Focused Floating Smart Action Bar -->
		{!isStaticPage && (
			<div id="floating-bar" class="floating-action-bar">
				<a href="#verdict-anchor" class="float-btn float-btn-primary">
					<span>🗳️</span> {isKorean ? "판결 투표" : "Cast Vote"}
				</a>
				<button id="float-share-btn" class="float-btn">
					<span>🔗</span> {isKorean ? "공유" : "Share"}
				</button>
			</div>
		)}

		<Footer />

		<script is:inline define:vars={{ isKorean }}>
			const copyBtn = document.getElementById('copy-link-btn');
			const floatShareBtn = document.getElementById('float-share-btn');
			const floatBar = document.getElementById('floating-bar');

			function copyCurrentUrl() {
				navigator.clipboard.writeText(window.location.href);
				alert(isKorean ? '사건 링크가 클립보드에 복사되었습니다!' : 'Receipt link copied to clipboard!');
			}

			copyBtn?.addEventListener('click', copyCurrentUrl);
			floatShareBtn?.addEventListener('click', copyCurrentUrl);

			window.addEventListener('scroll', () => {
				const scrollY = window.scrollY;
				const docHeight = document.documentElement.scrollHeight - window.innerHeight;
				if (docHeight > 0 && scrollY / docHeight > 0.25) {
					floatBar?.classList.add('visible');
				} else {
					floatBar?.classList.remove('visible');
				}
			});
		</script>
	</body>
</html>