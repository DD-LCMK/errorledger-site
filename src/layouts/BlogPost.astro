---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import ProvenanceBadge from '../components/ProvenanceBadge.astro';
import AudioDispatch from '../components/AudioDispatch.astro';
import ThematicDossier from '../components/ThematicDossier.astro';
import ReaderVerdict from '../components/ReaderVerdict.astro';
import { SITE_TITLE } from '../consts';
import { getCollection } from 'astro:content';

interface Props {
	title: string;
	subtitle?: string;
	description: string;
	pubDate?: Date;
	updatedDate?: Date;
	heroImage?: string;
	category?: string;
	lang?: string;
	slug?: string;
	tags?: string[];
	read_time_minutes?: number;
	meta_title?: string;
	provenance_tier?: number;
	provenance_label?: string;
	provenance_source?: string;
	archivist_summary?: string;
	verdict_question?: string;
	verdict_source?: string;
	verdict_options?: Array<{ id: string; label: string; votes?: number }>;
	archetype?: string;
}

const {
	title,
	subtitle,
	description,
	pubDate,
	heroImage = "/blog-placeholder-about.jpg",
	category = "corporate",
	lang = "en",
	slug = "",
	tags = [],
	read_time_minutes = 6,
	meta_title,
	provenance_tier = 1,
	provenance_label = "Documented Incident",
	provenance_source = "Court Filings & Public Records",
	archivist_summary,
	verdict_question = "Who was primarily responsible for this disaster?",
	verdict_source,
	verdict_options = [
		{ id: "option_a", label: "Executive Leadership (Flawed Culture & Cost-Cutting)", votes: 682 },
		{ id: "option_b", label: "Engineering & QA (Inadequate Testing & Oversight)", votes: 454 },
		{ id: "option_c", label: "Systemic Complexity (No Single Actor to Blame)", votes: 184 },
		{ id: "option_d", label: "Shared Responsibility Across the Entire Organization", votes: 99 }
	]
} = Astro.props;

const isKorean = lang === 'ko' || slug.startsWith('ko/') || (Astro.url ? Astro.url.pathname.startsWith('/ko') : false);
const seoTitle = meta_title || `${title} | ${SITE_TITLE}`;
const cleanSlug = slug.replace(/^ko\//, '');
const displayReadTime = read_time_minutes || 6;

const categoryMap: Record<string, string> = {
	corporate: isKorean ? "기업 & 인프라" : "Corporate",
	money: isKorean ? "금융 & 경제" : "Finance",
	work: isKorean ? "직장 & 커리어" : "Workplace",
	ai: isKorean ? "AI & 자동화" : "AI Disasters",
	internet: isKorean ? "인터넷 & 사회" : "Internet",
	human: isKorean ? "심리 & 편향" : "Psychology",
	relationships: isKorean ? "인간관계" : "Relationships"
};
const displayCategory = categoryMap[category] || category;

const cleanUrl = isKorean ? `https://errorledger.com/ko/blog/${cleanSlug}` : `https://errorledger.com/blog/${cleanSlug}`;
const alternateUrl = isKorean ? `/blog/${cleanSlug}` : `/ko/blog/${cleanSlug}`;
const alternateLabel = isKorean ? '🇺🇸 English' : '🇰🇷 한국어';

const schemaData = {
	"@context": "https://schema.org",
	"@type": "NewsArticle",
	"headline": title,
	"description": description,
	"image": [heroImage],
	"datePublished": pubDate ? pubDate.toISOString() : new Date().toISOString(),
	"author": [{
		"@type": "Person",
		"name": "The Archivist",
		"jobTitle": "Lead Investigative Editor",
		"url": "https://errorledger.com/about"
	}],
	"publisher": {
		"@type": "Organization",
		"name": "ErrorLedger",
		"logo": {
			"@type": "ImageObject",
			"url": "https://errorledger.com/favicon.svg"
		}
	}
};

const postBreadcrumb = [
	{ name: 'Home', url: isKorean ? 'https://errorledger.com/ko' : 'https://errorledger.com' },
	{ name: 'Ledger', url: isKorean ? 'https://errorledger.com/ko/blog' : 'https://errorledger.com/blog' },
	{ name: seoTitle }
];

const allPosts = await getCollection('blog');
const sameLangPosts = allPosts
	.filter(p => (p.data.lang || 'en') === lang)
	.sort((a, b) => {
		const dateA = a.data.pubDate ? new Date(a.data.pubDate).valueOf() : 0;
		const dateB = b.data.pubDate ? new Date(b.data.pubDate).valueOf() : 0;
		return dateB - dateA;
	});

const currentIndex = sameLangPosts.findIndex(post => post.data.title === title);
const nextPost = currentIndex > 0 ? sameLangPosts[currentIndex - 1] : null;
const prevPost = currentIndex < sameLangPosts.length - 1 ? sameLangPosts[currentIndex + 1] : null;

const lowercaseTags = tags.map((tag: string) => tag.toLowerCase());
const isStaticPage = 
	lowercaseTags.includes('meta') || 
	lowercaseTags.includes('contact') || 
	lowercaseTags.includes('privacy') || 
	lowercaseTags.includes('about') ||
	title.toLowerCase().includes('privacy') ||
	title.toLowerCase().includes('about') ||
	title.toLowerCase().includes('contact');

const showSidebar = !isStaticPage;

// Top Ranked Failures on Right Rail
const rankedCases = isKorean ? [
	{
		rank: 1,
		title: "금요일 아침, 전 세계 850만 대의 컴퓨터를 멈춘 14KB짜리 업데이트",
		slug: "the-friday-update-that-broke-the-world",
		category: "기업재난",
		votes: "1,421표"
	},
	{
		rank: 2,
		title: "나이트 캐피털의 6,000억 원짜리 버그: 45분 만에 끝난 월스트리트의 비극",
		slug: "knight-capital-trading-glitch-45-minutes",
		category: "금융재난",
		votes: "3,110표"
	},
	{
		rank: 3,
		title: "프로덕션 DB를 날리고 인턴에게 뒤집어씌운 시니어 개발자",
		slug: "deleted-production-database-blamed-intern",
		category: "직장참사",
		votes: "2,890표"
	}
] : [
	{
		rank: 1,
		title: "The Friday Morning Update That Took Down 8.5 Million Computers",
		slug: "the-friday-update-that-broke-the-world",
		category: "Corporate",
		votes: "1,421 votes"
	},
	{
		rank: 2,
		title: "The $440M Knight Capital Trading Glitch: 45 Minutes of Algorithmic Ruin",
		slug: "knight-capital-trading-glitch-45-minutes",
		category: "Finance",
		votes: "3,110 votes"
	},
	{
		rank: 3,
		title: "He Deleted the Production Database and Let the Intern Take the Fall",
		slug: "deleted-production-database-blamed-intern",
		category: "Workplace",
		votes: "2,890 votes"
	}
];
---

<html lang={lang} class="dark">
	<head>
		<BaseHead title={seoTitle} description={description} image={heroImage} type="article" breadcrumb={postBreadcrumb} />
		<script type="application/ld+json" set:html={JSON.stringify(schemaData)} />
		<style>
			main {
				width: 1200px;
				max-width: calc(100% - 2rem);
				margin: 0 auto;
				padding: 2rem 1rem 6rem 1rem;
			}
			
			.article-layout-grid {
				display: grid;
				grid-template-columns: 1fr;
				gap: 2.5rem;
				align-items: start;
				width: 100%;
				min-width: 0;
			}

			@media (min-width: 1024px) {
				.article-layout-grid.has-sidebar {
					grid-template-columns: minmax(0, 1fr) 320px;
				}
			}

			/* Left Main Reading Area */
			.article-main-stream {
				min-width: 0;
				width: 100%;
			}

			.prose {
				color: #d4d4d4;
				line-height: 1.85;
				font-size: 1.15rem;
				font-family: ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Noto Sans KR", sans-serif;
				min-width: 0;
			}
			.prose h1 {
				font-size: 2.3em;
				margin-top: 0;
				margin-bottom: 0.4em;
				color: #f5f5f5;
				line-height: 1.25;
				font-weight: 800;
				letter-spacing: -0.025em;
				overflow-wrap: break-word;
			}
			.article-subtitle {
				font-size: 1.2rem;
				color: #a3a3a3;
				line-height: 1.5;
				margin-bottom: 1.5rem;
				font-weight: 400;
			}
			.prose h2 {
				font-size: 1.55em;
				margin-top: 2em;
				margin-bottom: 0.75em;
				color: #fafafa;
				font-weight: 700;
				border-bottom: 1px solid #262626;
				padding-bottom: 0.4em;
				letter-spacing: -0.015em;
			}
			.prose :global(h3) {
				font-size: 1.25em;
				margin-top: 1.5em;
				margin-bottom: 0.5em;
				color: #f5f5f5;
				font-weight: 700;
			}
			.prose :global(p) {
				margin-bottom: 1.5rem;
			}
			
			.prose :global(blockquote) {
				background: #171717;
				border-left: 4px solid #f43f5e;
				border-radius: 8px;
				padding: 1.5rem;
				margin: 2rem 0;
				color: #e5e5e5;
				font-style: normal;
			}

			.meta-wrapper {
				display: flex;
				justify-content: space-between;
				align-items: center;
				margin-bottom: 1.5rem;
				padding-bottom: 1rem;
				border-bottom: 1px dashed #262626;
				flex-wrap: wrap;
				gap: 1rem;
			}
			.date-info {
				color: #a3a3a3;
				font-size: 0.85rem;
				display: flex;
				align-items: center;
				gap: 0.5rem;
				flex-wrap: wrap;
				font-family: ui-monospace, monospace;
			}
			.category-badge {
				padding: 0.15rem 0.5rem;
				border-radius: 4px;
				background: rgba(244, 63, 94, 0.1);
				color: #fb7185;
				border: 1px solid rgba(244, 63, 94, 0.25);
				text-transform: uppercase;
				font-size: 0.75rem;
				font-weight: 700;
			}
			
			.share-actions {
				display: flex;
				gap: 0.5rem;
				align-items: center;
				flex-wrap: wrap;
			}
			.lang-switch-pill {
				background: rgba(245, 158, 11, 0.12);
				border: 1px solid rgba(245, 158, 11, 0.3);
				color: #f59e0b;
				padding: 0.35rem 0.65rem;
				border-radius: 6px;
				font-size: 0.8rem;
				font-weight: 700;
				text-decoration: none;
				font-family: ui-monospace, monospace;
				transition: all 0.15s ease;
			}
			.lang-switch-pill:hover {
				background: #f59e0b;
				color: #000000;
			}

			.share-btn {
				background: #171717;
				border: 1px solid #262626;
				padding: 0.4rem 0.75rem;
				border-radius: 6px;
				font-size: 0.85rem;
				cursor: pointer;
				display: inline-flex;
				align-items: center;
				gap: 0.25rem;
				color: #d4d4d4;
				text-decoration: none;
				font-weight: 500;
				transition: all 0.15s ease;
			}
			.share-btn:hover {
				background: #262626;
				color: #ffffff;
			}

			.tag-container {
				display: flex;
				gap: 0.5rem;
				margin-top: 2rem;
				margin-bottom: 2rem;
				padding-top: 1.5rem;
				border-top: 1px solid #262626;
				flex-wrap: wrap;
			}
			.badge-tag {
				background: #171717;
				border: 1px solid #262626;
				color: #a3a3a3;
				font-size: 0.75rem;
				padding: 0.25rem 0.65rem;
				border-radius: 6px;
				text-decoration: none;
				font-family: ui-monospace, monospace;
				transition: all 0.15s ease;
			}
			.badge-tag:hover {
				color: #f43f5e;
				border-color: #f43f5e;
			}

			/* Bottom Adjacent Incident Navigation */
			.bottom-incident-nav {
				display: grid;
				grid-template-columns: 1fr;
				gap: 1rem;
				margin: 3rem 0;
				padding-top: 2rem;
				border-top: 1px solid #262626;
			}
			@media (min-width: 640px) {
				.bottom-incident-nav {
					grid-template-columns: 1fr 1fr;
				}
			}
			.incident-nav-card {
				background: #171717;
				border: 1px solid #262626;
				border-radius: 12px;
				padding: 1.25rem;
				text-decoration: none;
				display: flex;
				flex-direction: column;
				gap: 0.35rem;
				transition: all 0.15s ease;
				min-width: 0;
				box-sizing: border-box;
			}
			.incident-nav-card:hover {
				border-color: #f43f5e;
				background: #1e1e1e;
				transform: translateY(-2px);
			}
			.incident-nav-dir {
				font-family: ui-monospace, monospace;
				font-size: 0.72rem;
				font-weight: 700;
				text-transform: uppercase;
				color: #fb7185;
			}
			.incident-nav-title {
				font-size: 0.95rem;
				font-weight: 700;
				color: #e5e5e5;
				line-height: 1.35;
			}
			.incident-nav-card:hover .incident-nav-title {
				color: #ffffff;
			}

			/* Right Sticky Sidebar */
			.article-right-sidebar {
				min-width: 0;
				width: 100%;
			}
			@media (min-width: 1024px) {
				.article-right-sidebar {
					position: sticky;
					top: 5.5rem;
					align-self: start;
				}
			}

			.sidebar-card-widget {
				background: #171717;
				border: 1px solid #262626;
				border-radius: 16px;
				padding: 1.25rem;
				margin-bottom: 1.5rem;
				box-sizing: border-box;
			}
			.sidebar-widget-title-row {
				display: flex;
				align-items: center;
				justify-content: space-between;
				padding-bottom: 0.5rem;
				border-bottom: 1px solid #262626;
				margin-bottom: 0.85rem;
			}
			.sidebar-widget-title {
				font-size: 0.88rem;
				font-weight: 800;
				color: #f5f5f5;
				display: flex;
				align-items: center;
				gap: 0.35rem;
			}
			.sidebar-widget-tag {
				font-family: ui-monospace, monospace;
				font-size: 0.68rem;
				color: #f43f5e;
				font-weight: 700;
			}

			/* Right Rail Top 3 Ranked List */
			.side-ranked-list {
				display: flex;
				flex-direction: column;
				gap: 0.75rem;
			}
			.side-ranked-item {
				display: flex;
				align-items: flex-start;
				gap: 0.65rem;
				text-decoration: none;
				padding-bottom: 0.75rem;
				border-bottom: 1px dashed #262626;
				transition: transform 0.15s ease;
			}
			.side-ranked-item:last-child {
				border-bottom: none;
				padding-bottom: 0;
			}
			.side-ranked-item:hover {
				transform: translateX(2px);
			}
			.side-rank-num {
				font-size: 1.15rem;
				font-weight: 900;
				font-family: ui-monospace, monospace;
				line-height: 1;
				color: #f43f5e;
				min-width: 1.25rem;
			}
			.side-rank-body {
				flex-grow: 1;
				min-width: 0;
			}
			.side-rank-title {
				font-size: 0.82rem;
				font-weight: 700;
				color: #e5e5e5;
				line-height: 1.3;
				margin: 0 0 0.25rem 0;
				transition: color 0.15s ease;
			}
			.side-ranked-item:hover .side-rank-title {
				color: #fb7185;
			}
			.side-rank-meta {
				font-size: 0.68rem;
				font-family: ui-monospace, monospace;
				color: #737373;
			}

			/* Adjacent Trajectory Box on Right Rail */
			.trajectory-item-link {
				display: block;
				text-decoration: none;
				padding: 0.5rem 0.65rem;
				border-radius: 8px;
				background: #111111;
				border: 1px solid #262626;
				margin-bottom: 0.5rem;
				transition: all 0.15s ease;
			}
			.trajectory-item-link:last-child {
				margin-bottom: 0;
			}
			.trajectory-item-link:hover {
				border-color: #f43f5e;
				background: #262626;
			}
			.trajectory-dir-tag {
				display: block;
				font-family: ui-monospace, monospace;
				font-size: 0.65rem;
				font-weight: 700;
				color: #f43f5e;
				text-transform: uppercase;
				margin-bottom: 0.15rem;
			}
			.trajectory-item-title {
				display: block;
				font-size: 0.8rem;
				color: #e5e5e5;
				line-height: 1.3;
				font-weight: 600;
			}

			/* Floating Action Bar */
			.floating-action-bar {
				position: fixed;
				bottom: 1.5rem;
				left: 50%;
				transform: translateX(-50%) translateY(100px);
				z-index: 40;
				background: rgba(23, 23, 23, 0.9);
				backdrop-filter: blur(16px);
				-webkit-backdrop-filter: blur(16px);
				border: 1px solid #333333;
				box-shadow: 0 10px 35px rgba(0, 0, 0, 0.6);
				border-radius: 9999px;
				padding: 0.4rem 0.75rem;
				display: flex;
				align-items: center;
				gap: 0.5rem;
				transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1);
			}
			.floating-action-bar.visible {
				transform: translateX(-50%) translateY(0);
			}
			.float-btn {
				background: transparent;
				border: none;
				color: #e5e5e5;
				font-size: 0.82rem;
				font-weight: 600;
				padding: 0.4rem 0.85rem;
				border-radius: 9999px;
				cursor: pointer;
				display: inline-flex;
				align-items: center;
				gap: 0.35rem;
				transition: all 0.15s ease;
				text-decoration: none;
			}
			.float-btn:hover {
				background: #262626;
				color: #ffffff;
			}
			.float-btn-primary {
				background: #f43f5e;
				color: #ffffff;
			}
			.float-btn-primary:hover {
				background: #fb7185;
			}

			/* Executive Summary Card */
			.executive-summary-card {
				background: #141414;
				border: 1px solid #262626;
				border-left: 3px solid #f43f5e;
				border-radius: 10px;
				padding: 1.15rem 1.35rem;
				margin: 1.5rem 0 2rem 0;
			}
			.summary-header-row {
				display: flex;
				align-items: center;
				justify-content: space-between;
				margin-bottom: 0.65rem;
				flex-wrap: wrap;
				gap: 0.5rem;
			}
			.summary-badge {
				font-family: ui-monospace, monospace;
				font-size: 0.72rem;
				font-weight: 700;
				text-transform: uppercase;
				color: #fb7185;
				background: rgba(244, 63, 94, 0.1);
				padding: 0.15rem 0.45rem;
				border-radius: 4px;
				border: 1px solid rgba(244, 63, 94, 0.25);
			}
			.summary-audio-indicator {
				font-size: 0.7rem;
				font-family: ui-monospace, monospace;
				color: #737373;
			}
			.executive-summary-content {
				font-size: 0.95rem;
				line-height: 1.6;
				color: #d4d4d4;
				margin: 0 !important;
				font-style: italic;
			}

			:global(html:not(.dark)) .executive-summary-card {
				background: #f8fafc !important;
				border-color: #e2e8f0 !important;
				border-left-color: #f43f5e !important;
			}
			:global(html:not(.dark)) .executive-summary-content {
				color: #334155 !important;
			}
			:global(html:not(.dark)) .summary-audio-indicator {
				color: #64748b !important;
			}

			/* High-Contrast Light Mode */
			:global(html:not(.dark)) body {
				background: #ffffff;
				color: #1e293b;
			}
			:global(html:not(.dark)) .prose {
				color: #334155;
			}
			:global(html:not(.dark)) .prose h1,
			:global(html:not(.dark)) .prose h2,
			:global(html:not(.dark)) .prose :global(h3) {
				color: #0f172a !important;
			}
			:global(html:not(.dark)) .article-subtitle {
				color: #64748b !important;
			}
			:global(html:not(.dark)) .prose :global(blockquote) {
				background: #f8fafc !important;
				border-left-color: #f43f5e !important;
				color: #1e293b !important;
			}
			:global(html:not(.dark)) .sidebar-card-widget,
			:global(html:not(.dark)) .incident-nav-card {
				background: #ffffff !important;
				border-color: #e2e8f0 !important;
				box-shadow: 0 4px 20px rgba(0, 0, 0, 0.04) !important;
			}
			:global(html:not(.dark)) .sidebar-widget-title,
			:global(html:not(.dark)) .side-rank-title,
			:global(html:not(.dark)) .trajectory-item-title,
			:global(html:not(.dark)) .incident-nav-title {
				color: #0f172a !important;
			}
			:global(html:not(.dark)) .sidebar-widget-title-row,
			:global(html:not(.dark)) .side-ranked-item,
			:global(html:not(.dark)) .bottom-incident-nav {
				border-bottom-color: #e2e8f0 !important;
				border-top-color: #e2e8f0 !important;
			}
			:global(html:not(.dark)) .trajectory-item-link {
				background: #f8fafc !important;
				border-color: #cbd5e1 !important;
			}
			:global(html:not(.dark)) .share-btn,
			:global(html:not(.dark)) .badge-tag {
				background: #f8fafc !important;
				border-color: #cbd5e1 !important;
				color: #475569 !important;
			}
			:global(html:not(.dark)) .floating-action-bar {
				background: rgba(255, 255, 255, 0.95) !important;
				border-color: #cbd5e1 !important;
				box-shadow: 0 10px 30px rgba(0, 0, 0, 0.15) !important;
			}
			:global(html:not(.dark)) .float-btn {
				color: #334155 !important;
			}
		</style>
	</head>

	<body class="bg-neutral-950 text-neutral-200 antialiased min-h-screen">
		<Header />
		<main>
			<div class={showSidebar ? "article-layout-grid has-sidebar" : "article-layout-grid"}>
				<!-- Left Main Reading Area (~72%) -->
				<article class="article-main-stream">
					<div class="prose">
						{!isStaticPage && (
							<>
								<div class="meta-wrapper">
									<div class="date-info">
										<span class="category-badge">
											{displayCategory}
										</span>
										<span>•</span>
										{pubDate && (
											<span><FormattedDate date={pubDate} /></span>
										)}
										<span>•</span>
										<span>⏱️ {isKorean ? `${displayReadTime}분 읽기` : `${displayReadTime} min read`}</span>
									</div>

									<div class="share-actions">
										<a href={alternateUrl} class="lang-switch-pill" title="Toggle language version">
											{alternateLabel}
										</a>
										<a href={`https://x.com/intent/tweet?url=${encodeURIComponent(cleanUrl)}&text=${encodeURIComponent(title)}`} target="_blank" rel="noopener noreferrer" class="share-btn">
											{isKorean ? "공유" : "Share"}
										</a>
										<button id="copy-link-btn" class="share-btn">
											{isKorean ? "링크 복사" : "Copy Link"}
										</button>
									</div>
								</div>

								<h1>{title}</h1>
								{subtitle && <p class="article-subtitle">{subtitle}</p>}

								<ProvenanceBadge
									tier={provenance_tier}
									label={provenance_label}
									source={provenance_source}
									lang={lang}
								/>

								<!-- Simulated Audio Dispatch Player -->
								<AudioDispatch title={title} duration={`${displayReadTime - 2 || 3}:45`} lang={lang} slug={cleanSlug} audioUrl={`/audio/${lang}/${cleanSlug}.mp3`} />

								<!-- 60-Second Incident Executive Summary Box -->
								{(archivist_summary || description) && (
									<div class="executive-summary-card">
										<div class="summary-header-row">
											<span class="summary-badge">⚡ {isKorean ? "60초 사건 핵심 브리핑" : "60-Second Executive Summary"}</span>
											<span class="summary-audio-indicator">🎙️ {isKorean ? "오디오 브리핑 스크립트" : "Audio Dispatch Script"}</span>
										</div>
										<p class="executive-summary-content">
											{archivist_summary || description}
										</p>
									</div>
								)}
							</>
						)}

						<slot />

						{!isStaticPage && (
							<>
								<!-- Interactive Feature 7: Reader Verdict Poll -->
								<div id="verdict-anchor">
									<ReaderVerdict
										question={verdict_question}
										options={verdict_options}
										slug={slug}
										lang={lang}
										source={verdict_source}
									/>
								</div>

								<!-- Bottom Post Navigation: Previous & Next Incident -->
								<nav class="bottom-incident-nav">
									{prevPost && (
										<a href={`/${isKorean ? 'ko/blog' : 'blog'}/${prevPost.data.slug.replace(/^ko\//, '')}`} class="incident-nav-card">
											<span class="incident-nav-dir">&larr; {isKorean ? "이전 사건 기록" : "Previous Incident"}</span>
											<span class="incident-nav-title">{prevPost.data.title}</span>
										</a>
									)}
									{nextPost && (
										<a href={`/${isKorean ? 'ko/blog' : 'blog'}/${nextPost.data.slug.replace(/^ko\//, '')}`} class="incident-nav-card" style={!prevPost ? "grid-column: 1 / -1;" : ""}>
											<span class="incident-nav-dir">{isKorean ? "다음 사건 기록" : "Next Incident"} &rarr;</span>
											<span class="incident-nav-title">{nextPost.data.title}</span>
										</a>
									)}
								</nav>

								<!-- Interactive Feature 4: Thematic Dossier Clusters -->
								<ThematicDossier lang={lang} />

								{tags.length > 0 && (
									<div class="tag-container">
										{tags.map((tag) => (
											<a href={`/${isKorean ? 'ko/search' : 'search'}?q=${encodeURIComponent(tag.toLowerCase())}`} class="badge-tag">
												#{tag}
											</a>
										))}
									</div>
								)}
							</>
						)}
					</div>
				</article>

				<!-- Right Sticky Sidebar (~28%) -->
				{showSidebar && (
					<aside class="article-right-sidebar">
						<!-- Top 3 Most Read Failures -->
						<div class="sidebar-card-widget">
							<div class="sidebar-widget-title-row">
								<span class="sidebar-widget-title">🔥 {isKorean ? "많이 본 사건" : "Most Read"}</span>
								<span class="sidebar-widget-tag">RANKING</span>
							</div>
							<div class="side-ranked-list">
								{rankedCases.map((item) => (
									<a href={`/${isKorean ? 'ko/blog' : 'blog'}/${item.slug}`} class="side-ranked-item">
										<div class="side-rank-num">{item.rank}</div>
										<div class="side-rank-body">
											<h5 class="side-rank-title">{item.title}</h5>
											<div class="side-rank-meta">
												<span>{item.category}</span>
												<span>•</span>
												<span>{item.votes}</span>
											</div>
										</div>
									</a>
								))}
							</div>
						</div>

						<!-- Incident Trajectory -->
						{(nextPost || prevPost) && (
							<div class="sidebar-card-widget">
								<div class="sidebar-widget-title-row">
									<span class="sidebar-widget-title">⚡ {isKorean ? "사건 탐색 궤적" : "Incident Trajectory"}</span>
								</div>
								{nextPost && (
									<a href={`/${isKorean ? 'ko/blog' : 'blog'}/${nextPost.data.slug.replace(/^ko\//, '')}`} class="trajectory-item-link">
										<span class="trajectory-dir-tag">&larr; {isKorean ? "다음 사건" : "Next Incident"}</span>
										<span class="trajectory-item-title">{nextPost.data.title}</span>
									</a>
								)}
								{prevPost && (
									<a href={`/${isKorean ? 'ko/blog' : 'blog'}/${prevPost.data.slug.replace(/^ko\//, '')}`} class="trajectory-item-link">
										<span class="trajectory-dir-tag">{isKorean ? "이전 사건" : "Previous Incident"} &rarr;</span>
										<span class="trajectory-item-title">{prevPost.data.title}</span>
									</a>
								)}
							</div>
						)}

						<!-- Whistleblower Prompt -->
						<div class="sidebar-card-widget" style="background: rgba(244, 63, 94, 0.06); border-color: rgba(244, 63, 94, 0.25);">
							<div class="sidebar-widget-title-row" style="border-bottom-color: rgba(244, 63, 94, 0.2);">
								<span class="sidebar-widget-title" style="color: #fb7185;">✉️ {isKorean ? "익명 제보하기" : "Whistleblower"}</span>
							</div>
							<p style="font-size: 0.78rem; color: #a3a3a3; line-height: 1.45; margin: 0 0 0.85rem 0;">
								{isKorean ? "사내 은폐 사건, 커리어의 실수, 시스템 참사의 전말을 제보하세요." : "Have documentation on an untold corporate disaster or career mistake?"}
							</p>
							<button class="share-btn" data-open-submit-modal style="width: 100%; justify-content: center; background: #f43f5e; color: #ffffff; border: none; font-weight: 700;">
								+ {isKorean ? "사건 제보하기" : "Submit Case"}
							</button>
						</div>
					</aside>
				)}
			</div>
		</main>

		<!-- Focused Floating Smart Action Bar -->
		{!isStaticPage && (
			<div id="floating-bar" class="floating-action-bar">
				<a href="#verdict-anchor" class="float-btn float-btn-primary">
					<span>📊</span> {isKorean ? "여론 합의" : "Consensus"}
				</a>
				<button id="float-share-btn" class="float-btn">
					<span>🔗</span> {isKorean ? "공유" : "Share"}
				</button>
			</div>
		)}

		<Footer />

		<script is:inline define:vars={{ isKorean }}>
			const copyBtn = document.getElementById('copy-link-btn');
			const floatShareBtn = document.getElementById('float-share-btn');
			const floatBar = document.getElementById('floating-bar');

			function copyCurrentUrl() {
				navigator.clipboard.writeText(window.location.href);
				alert(isKorean ? '사건 링크가 클립보드에 복사되었습니다!' : 'Receipt link copied to clipboard!');
			}

			copyBtn?.addEventListener('click', copyCurrentUrl);
			floatShareBtn?.addEventListener('click', copyCurrentUrl);

			window.addEventListener('scroll', () => {
				const scrollY = window.scrollY;
				const docHeight = document.documentElement.scrollHeight - window.innerHeight;
				if (docHeight > 0 && scrollY / docHeight > 0.25) {
					floatBar?.classList.add('visible');
				} else {
					floatBar?.classList.remove('visible');
				}
			});
		</script>
	</body>
</html>