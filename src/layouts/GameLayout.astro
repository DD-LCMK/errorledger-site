---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import LeaderboardAd from '../components/ads/LeaderboardAd.astro';
import { getLang, getKoUrl, getEnUrl, t } from '../i18n';

interface Props {
  title: string;
  description: string;
  tagline?: string;
  icon?: string;
  category?: string;
  badge?: string;
  players?: string;
  playTime?: string;
  controls?: string[];
  rules?: string[];
  faqItems?: { q: string; a: string }[];
  layoutMode?: 'full' | 'split';
  hideStageHeader?: boolean;
  hideFooter?: boolean;
  // hreflang pair (auto-derived if omitted)
  hreflangKo?: string;
  hreflangEn?: string;
}

const {
  title,
  description,
  tagline = '무료 웹게임 & 추첨 도구',
  icon = '🕹️',
  controls = [],
  rules = [],
  faqItems = [],
  layoutMode = 'full',
  hideStageHeader = false,
  hideFooter = false,
  hreflangKo,
  hreflangEn,
} = Astro.props;

// Detect streamer / OBS mode — disable ads when present
const urlParams = Astro.url.searchParams;
const isBare = urlParams.has('bare');
const streamerMode = urlParams.has('stream') || urlParams.has('obs');

// Locale
const lang = getLang(Astro.url);
const rawPathForLang = Astro.url.pathname.replace(/\.html$/, '').replace(/\/$/, '');
const siteBaseStr = (Astro.site || 'https://errorledger.com').toString();
const koUrl = hreflangKo ?? getKoUrl(siteBaseStr, rawPathForLang || '/');
const enUrl = hreflangEn ?? getEnUrl(siteBaseStr, rawPathForLang || '/');

// Combine key controls & rules into 3-4 concise stream-friendly tips
const quickTips = [...controls.slice(0, 3), ...rules.slice(0, 2)];

const rawPath = Astro.url.pathname.replace(/\.html$/, '').replace(/\/$/, '');
const siteBase = Astro.site || 'https://errorledger.com';
const pageUrl = new URL(rawPath || '/', siteBase).href;

// Alternate english names for SEO
let enName = 'Interactive Stream Game';
if (rawPath.includes('marble-roulette')) enName = 'Marble Roulette & Marble Race Online';
else if (rawPath.includes('roulette')) enName = 'Random Wheel Picker & Roulette Spinner';
else if (rawPath.includes('ladder')) enName = 'Ghost Leg Ladder Game (Amidakuji)';
else if (rawPath.includes('fortune')) enName = 'Daily Fortune Cookie & Horoscope';

const webAppSchema = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "WebApplication",
  "name": `${title} - 스트림아케이드`,
  "alternateName": [enName, title],
  "url": pageUrl,
  "description": description,
  "applicationCategory": "GameApplication",
  "operatingSystem": "All (Web Browser, Chrome, Edge, Safari, Mobile, OBS Studio)",
  "inLanguage": ["ko-KR", "en-US"],
  "offers": {
    "@type": "Offer",
    "price": "0",
    "priceCurrency": "KRW"
  },
  "aggregateRating": {
    "@type": "AggregateRating",
    "ratingValue": "4.98",
    "bestRating": "5",
    "ratingCount": "1840"
  },
  "featureList": [...controls, ...rules]
});

const faqSchema = faqItems && faqItems.length > 0 ? JSON.stringify({
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqItems.map(item => ({
    "@type": "Question",
    "name": item.q,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": item.a
    }
  }))
}) : null;
---

<!doctype html>
<html lang={lang} class="dark">
  <head>
    <BaseHead 
      title={lang === 'en'
        ? `${title} - Free Stream Tool | StreamArcade`
        : `${title} - 무료 방송용 웹게임 | 스트림아케이드`}
      description={lang === 'en'
        ? `${description} Free interactive stream tool for Twitch, YouTube, CHZZK & SOOP streamers.`
        : `${description} 스트리머와 시청자를 위한 무료 웹게임 도구. 치지직, 유튜브, SOOP 지원.`}
      lang={lang}
      hreflangKo={koUrl}
      hreflangEn={enUrl}
      breadcrumb={[
        { name: lang === 'en' ? 'Home' : '홈 (Home)', url: lang === 'en' ? '/en' : '/' },
        { name: lang === 'en' ? 'Stream Tools' : '방송 도구 (Tools)', url: lang === 'en' ? '/en' : '/search' },
        { name: title, url: pageUrl }
      ]}
    />
    <script type="application/ld+json" set:html={webAppSchema}></script>
    {faqSchema && <script type="application/ld+json" set:html={faqSchema}></script>}
    <!-- Bare mode or Streamer/OBS mode: suppress ads and chrome client-side when ?bare=1, ?stream=true, or ?obs=true -->
    <script is:inline>
      (function() {
        if (typeof window === 'undefined') return;
        var p = new URLSearchParams(window.location.search);
        var isBare = p.has('bare');
        var isStream = p.has('stream') || p.has('obs');
        if (isBare || isStream) {
          var s = document.createElement('style');
          var rules = [
            '.sticky-banner-ad-wrap { display: none !important; }',
            '.rect-ad-wrap { display: none !important; }',
            '.native-ad-wrap { display: none !important; }',
            '.leaderboard-ad-wrap { display: none !important; }'
          ];
          if (isStream) {
            rules.push('footer { display: none !important; }');
            rules.push('.stream-bottom-details { display: none !important; }');
            rules.push('.arcade-header { display: none !important; }');
          }
          if (isBare) {
            rules.push('html, body { margin: 0 !important; padding: 0 !important; }');
            rules.push('.arcade-header { display: none !important; }');
            rules.push('footer { display: none !important; }');
            rules.push('.stream-bottom-details { display: none !important; }');
            rules.push('.game-top-bar { display: none !important; }');
            rules.push('.game-main-container { padding: 0 !important; margin: 0 !important; max-width: none !important; }');
            rules.push('.game-full-layout { padding: 0 !important; }');
            rules.push('.game-viewport-container { border: none !important; border-radius: 0 !important; background: transparent !important; }');
            rules.push('body.game-page-body { overflow: hidden !important; }');
          }
          s.textContent = rules.join(' ');
          document.head.appendChild(s);
        }
      })();
    </script>
  </head>



  <body class="game-page-body">
    <Header />

    <main class="game-main-container">
      <!-- Sleek Minimal Stage Header Bar -->
      {!hideStageHeader && (
        <div class="game-top-bar">
          <div class="game-bar-title">
            <span class="game-bar-icon">{icon}</span>
            <h1 class="game-bar-h1">{title}</h1>
          </div>
          <div class="game-bar-actions">
            <button id="fullscreen-btn" class="stage-fullscreen-btn" title={lang === 'en' ? 'Toggle Fullscreen' : '전체화면 전환'}>
              <span>{lang === 'en' ? '⛶ Fullscreen' : '⛶ 전체화면'}</span>
            </button>
          </div>
        </div>
      )}

      <!-- Game Arena (Full width for suite tools, Split for arcade puzzles) -->
      {layoutMode === 'split' ? (
        <div class="game-split-layout">
          <div class="game-left-col">
            <div class="game-viewport-container" id="game-viewport">
              <slot />
            </div>
          </div>

          <div class="game-right-col">
            {quickTips.length > 0 && (
              <div class="clean-tips-card">
                <div class="tips-title-row">
                  <span class="tips-icon">💡</span>
                  <h3>{lang === 'en' ? 'How to Play' : '방송 안내 & 조작법'}</h3>
                </div>
                <ul class="clean-tips-list">
                  {quickTips.map(t => <li>{t}</li>)}
                </ul>
              </div>
            )}
          </div>
        </div>
      ) : (
        <div class="game-full-layout">
          <div class="game-viewport-container" id="game-viewport">
            <slot />
          </div>
        </div>
      )}

      <!-- Horizontal single-line ad directly beneath game (suppressed in bare embed) -->
      {!isBare && <LeaderboardAd streamerMode={streamerMode} />}

      <!-- Unobtrusive Expandable Information Drawer (for Guide & FAQ) -->
      {(Astro.slots.has('guide') || (faqItems && faqItems.length > 0)) && (
        <details class="stream-bottom-details">
          <summary class="details-summary">
            <span>{lang === 'en' ? '📖 Detailed Guide & FAQ' : '📖 상세 가이드 및 FAQ 보기'}</span>
            <span class="chevron">▼</span>
          </summary>
          <div class="details-content">
            <slot name="guide" />
            {faqItems && faqItems.length > 0 && (
              <div class="details-faq-section">
                <h3>{lang === 'en' ? 'Frequently Asked Questions (FAQ)' : '자주 묻는 질문 (FAQ)'}</h3>
                <div class="details-faq-grid">
                  {faqItems.map(f => (
                    <div class="details-faq-card">
                      <strong class="faq-q">Q. {f.q}</strong>
                      <p class="faq-a">{f.a}</p>
                    </div>
                  ))}
                </div>
              </div>
            )}
          </div>
        </details>
      )}
    </main>

    {!hideFooter && <Footer />}

    <style>
      .game-page-body {
        background: #090d16 !important;
        color: #f1f5f9 !important;
        min-height: 100vh;
        display: flex;
        flex-direction: column;
      }

      .game-main-container {
        max-width: 100% !important;
        margin: 0 !important;
        padding: 0.5rem 0.75rem 2rem !important;
        width: 100% !important;
        flex: 1;
        box-sizing: border-box;
      }

      /* Slim Minimal Stage Header Bar */
      .game-top-bar {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 0.35rem 0.25rem 0.65rem;
      }

      .game-bar-title {
        display: flex;
        align-items: center;
        gap: 0.5rem;
      }

      .game-bar-icon {
        font-size: 1.35rem;
      }

      .game-bar-h1 {
        font-size: 1.15rem;
        font-weight: 800;
        margin: 0;
        color: #f8fafc;
        letter-spacing: -0.02em;
      }

      .game-bar-actions {
        display: flex;
        align-items: center;
        gap: 0.5rem;
      }

      .stage-fullscreen-btn {
        background: rgba(56, 189, 248, 0.1);
        color: #38bdf8;
        border: 1px solid rgba(56, 189, 248, 0.25);
        padding: 0.25rem 0.65rem;
        border-radius: 6px;
        font-size: 0.76rem;
        font-weight: 700;
        cursor: pointer;
        transition: all 0.15s ease;
      }

      .stage-fullscreen-btn:hover {
        background: rgba(56, 189, 248, 0.22);
        border-color: rgba(56, 189, 248, 0.45);
        color: #ffffff;
      }

      /* Full layout (centered suite tools) */
      .game-full-layout {
        display: flex;
        justify-content: center;
        width: 100%;
      }

      .game-full-layout .game-viewport-container {
        width: 100%;
      }

      /* Split layout (arcade / single canvas) */
      .game-split-layout {
        display: grid;
        grid-template-columns: auto 1fr;
        gap: 1.25rem;
        align-items: start;
      }

      .game-left-col {
        display: flex;
        flex-direction: column;
      }

      .game-right-col {
        display: flex;
        flex-direction: column;
      }

      /* Viewport container — clean, borderless, full-width */
      .game-viewport-container {
        position: relative;
        background: transparent;
        border: none;
        border-radius: 0;
        overflow: visible;
      }

      .game-viewport-container:fullscreen {
        border-radius: 0;
        border: none;
        width: 100vw;
        height: 100vh;
        display: flex;
        align-items: center;
        justify-content: center;
      }

      /* Clean Tips Card in Split Mode */
      .clean-tips-card {
        background: #0f172a;
        border: 1px solid rgba(255, 255, 255, 0.08);
        border-radius: 12px;
        padding: 1rem 1.25rem;
      }

      .tips-title-row {
        display: flex;
        align-items: center;
        gap: 0.4rem;
        margin-bottom: 0.75rem;
      }

      .tips-icon {
        font-size: 1.1rem;
      }

      .tips-title-row h3 {
        font-size: 0.92rem;
        font-weight: 700;
        color: #f8fafc;
        margin: 0;
      }

      .clean-tips-list {
        margin: 0;
        padding-left: 1.1rem;
        color: #cbd5e1;
        font-size: 0.83rem;
        line-height: 1.7;
      }

      .clean-tips-list li {
        margin-bottom: 0.4rem;
      }

      /* Unobtrusive Bottom Drawer */
      .stream-bottom-details {
        margin-top: 2rem;
        background: #0f172a;
        border: 1px solid rgba(255, 255, 255, 0.06);
        border-radius: 10px;
        overflow: hidden;
        transition: border-color 0.15s ease;
      }

      .stream-bottom-details[open] {
        border-color: rgba(168, 85, 247, 0.3);
      }

      .details-summary {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 0.75rem 1.25rem;
        font-size: 0.84rem;
        font-weight: 700;
        color: #94a3b8;
        cursor: pointer;
        user-select: none;
        list-style: none;
        transition: color 0.15s ease;
      }

      .details-summary:hover {
        color: #e2e8f0;
      }

      .details-summary::-webkit-details-marker {
        display: none;
      }

      .chevron {
        font-size: 0.65rem;
        color: #a855f7;
        transition: transform 0.2s ease;
      }

      .stream-bottom-details[open] .chevron {
        transform: rotate(180deg);
      }

      .details-content {
        padding: 1.25rem;
        border-top: 1px solid rgba(255, 255, 255, 0.05);
        color: #cbd5e1;
        font-size: 0.85rem;
        line-height: 1.7;
      }

      .details-content :global(h2) {
        font-size: 1.05rem;
        color: #f8fafc;
        margin-top: 0;
        margin-bottom: 0.5rem;
      }

      .details-content :global(ul) {
        padding-left: 1.2rem;
      }

      .details-faq-section {
        margin-top: 1.5rem;
        padding-top: 1rem;
        border-top: 1px solid rgba(255, 255, 255, 0.06);
      }

      .details-faq-section h3 {
        font-size: 0.95rem;
        color: #f8fafc;
        margin-bottom: 0.75rem;
      }

      .details-faq-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 0.75rem;
      }

      .details-faq-card {
        background: rgba(255, 255, 255, 0.03);
        border: 1px solid rgba(255, 255, 255, 0.05);
        border-radius: 8px;
        padding: 0.75rem 1rem;
      }

      .faq-q {
        display: block;
        font-size: 0.82rem;
        color: #e2e8f0;
        margin-bottom: 0.35rem;
      }

      .faq-a {
        margin: 0;
        font-size: 0.78rem;
        color: #94a3b8;
        line-height: 1.55;
      }

      @media (max-width: 900px) {
        .game-split-layout {
          grid-template-columns: 1fr;
        }
        .details-faq-grid {
          grid-template-columns: 1fr;
        }
      }
    </style>

    <script>
      const fsBtn = document.getElementById('fullscreen-btn');
      const viewport = document.getElementById('game-viewport');

      if (fsBtn && viewport) {
        fsBtn.addEventListener('click', () => {
          if (!document.fullscreenElement) {
            viewport.requestFullscreen().catch(err => {
              console.warn('Fullscreen error:', err);
            });
          } else {
            document.exitFullscreen();
          }
        });
      }
    </script>
  </body>
</html>
